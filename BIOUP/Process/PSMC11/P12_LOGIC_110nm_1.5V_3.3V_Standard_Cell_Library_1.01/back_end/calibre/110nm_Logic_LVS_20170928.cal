/*============================================*/
/*        SPECIFICATION STATEMENTS            */
/*============================================*/

//#define rc_deck            //user select
//#DEFINE ZERO_NRS_NRD
#DEFINE 1P4M               //user select => 1P5M , 1P4M 
#DEFINE SRAM_PTC ON        //user select => turn on SRAM of PTC style 


layout system gdsii
source system  spice

layout path "change_top_cell.gds"
layout primary "change_top_cell"
source path    "source.spi"
source primary "TOP"



lvs write layout netlist netlist.spi
lvs report "lvs.rep"
erc results database "chip_erc.results"
erc summary report "chip_erc.summary" replace hier
drc results database "chip_drc.results" ascii
drc summary report "chip_drc.summary" replace hier
                                                                                                               
  layout error on input no
  flag skew      yes
  flag offgrid   yes
  flag acute     yes
  flag nonsimple yes
                                                                                                               
  unit length U              //(U= 1E-6)
  precision   1000           //(unit / 1000   = 0.001um)
  resolution  1              //(precision * 1 = 0.001um)

#ifdef rc_deck
  //UNIT CAPACITANCE                   FF //FF
#else
  UNIT CAPACITANCE                   FF //FF
#endif
                                                                                                               
#ifdef rc_deck
  //UNIT RESISTANCE                    OHM
#else
  UNIT RESISTANCE                    OHM
#endif

  lvs expand unbalanced cells no
  lvs ignore ports            no
  lvs check port names        yes
  lvs recognize gates         none
                                                                                                               
  //lvs power name  VDD VDDI VDDQ VDDP VDDR VDDL VDDSA VPP VARY VPLT VDDS VPERI VPERD VPERA?
  //                VPPSVT VNW VNWI VNWQ VOD? VBLPE VBLPO VDLP VDRV
                                                                                                               
  //lvs ground name VSS VSSI VSSQ VSSP VSSR VSSDL VSSSA VBB VKK VBBSVT VPW VPWI VPWQ VBBSA
                                                                                                               
  lvs abort on softchk no
  lvs abort on supply error no
                                                                                                               
  virtual connect colon yes  //rc
                                                                                                               
  virtual connect name ?
                                                                                                               
  lvs execute erc yes
  erc maximum results ALL
  erc maximum vertex  4096
  lvs report maximum ALL
  lvs show seed promotions yes
  lvs push devices         no
  virtual connect report yes
                                                                                                               
#ifdef rc_deck
    //mask results database none
#else
    mask results database none
#endif
#ifdef rc_deck
    //mask svdb directory "svdb" query
#else
    mask svdb directory "svdb" query
#endif
                                                                                                               
                                                                                                               
  lvs report option s v //a b c d g n s v
                                                                                                               
  lvs isolate shorts yes by layer cell primary && name "?"
  lvs inject logic no
                                                                                                               
  lvs reduce split    gates yes           //yes same order WITHIN TOLERANCE [tolerance l 0.0]
  lvs reduce series   mos             yes
  lvs reduce parallel mos             yes
  lvs reduce semi series mos          no
  lvs reduce parallel bipolar         yes
  lvs reduce parallel diodes          yes
  lvs reduce series   capacitors      yes
  lvs reduce parallel capacitors      yes
  lvs reduce series   resistors       yes
  lvs reduce parallel resistors       yes
  lvs all capacitor pins swappable    no
  lvs spice prefer pins yes
                                                                                                               
  LVS FILTER UNUSED MOS               NO
  LVS FILTER UNUSED BIPOLAR           NO
  LVS FILTER UNUSED CAPACITORS        NO
  LVS FILTER UNUSED DIODES            NO
  LVS FILTER UNUSED RESISTORS         NO
  LVS FILTER UNUSED OPTION            AB AC AD AE RC RE RG

  lvs reduce C(c3s)  series POS NEG   no
  lvs reduce C(c3s)  parallel  yes 
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c3si) series POS NEG   no
  lvs reduce C(c3si) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c15_npw) series POS NEG   no
  lvs reduce C(c15_npw) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c33_npw) series POS NEG   no
  lvs reduce C(c33_npw) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c15_nnw) series POS NEG   no
  lvs reduce C(c15_nnw) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c33_nnw) series POS NEG   no
  lvs reduce C(c33_nnw) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]
 
  lvs reduce C(c15_pnw) series POS NEG   no
  lvs reduce C(c15_pnw) parallel  yes
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

  lvs reduce C(c33_pnw) series POS NEG   no
  lvs reduce C(c33_pnw) parallel  yes 
      [
      effective w,l
      w = sum(w)
      l = sqrt( sum(l*w) / sum(w/l) )
      ]

#ifdef 1P5M
  lvs reduce C(cmim_3K) series POS NEG   no
  lvs reduce C(cmim_3K) parallel  yes
      [
      effective W,L
      W = sum(W)
      L = sqrt( sum(L*W) / sum(W/L) )
      ]

  lvs reduce C(cmim_4K) series POS NEG   no
  lvs reduce C(cmim_4K) parallel  yes
      [
      effective W,L
      W = sum(W)
      L = sqrt( sum(L*W) / sum(W/L) )
      ]

  lvs reduce C(cmim_3K_sh) series POS NEG   no
  lvs reduce C(cmim_3K_sh) parallel  yes
      [
      effective W,L
      W = sum(W)
      L = sqrt( sum(L*W) / sum(W/L) )
      ]

  lvs reduce C(cmim_4K_sh) series POS NEG   no
  lvs reduce C(cmim_4K_sh) parallel  yes
      [
      effective W,L
      W = sum(W)
      L = sqrt( sum(L*W) / sum(W/L) )
      ]

#else

#ifdef 1P4M
  lvs reduce C(cmim_3K) series POS NEG   no
  lvs reduce C(cmim_3K) parallel  yes
      [
      effective W,L
      W = sum(W)
      L = sqrt( sum(L*W) / sum(W/L) )
      ]
#endif
#endif


  lvs reduce R(rnaa) 		parallel  yes
  lvs reduce R(rpaa) 		parallel  yes
  lvs reduce R(rnpoly) 		parallel  yes
  lvs reduce R(rppoly200) 	parallel  yes
  lvs reduce R(rnp) 		parallel  yes
  lvs reduce R(rpp) 		parallel  yes
  lvs reduce R(rnpolync) 	parallel  yes
  lvs reduce R(rppolync) 	parallel  yes
  lvs reduce R(R1M) 		parallel  yes
  lvs reduce R(R2M) 		parallel  yes

#ifdef 1P5M
  lvs reduce R(R3M) 		parallel  yes
  lvs reduce R(R4M) 		parallel  yes

#else

#ifdef 1P4M
  lvs reduce R(R3M)             parallel  yes
#endif
#endif



/*======================================================*/
/*              INPUT LAYER STATEMENTS                  */
/*======================================================*/

LAYER   T1FL31       31
LAYER   T1FL90       90
LAYER   T5IL45       45  
LAYER   T4IL44       44 
LAYER   T1IL69       69
LAYER   T2IL27       27
LAYER   3I_LDMOS     28
LAYER   LD_BLK       30
//LAYER   T1DL25       25
//LAYER   T2DL10       10
LAYER   T3SL62       62
LAYER   T2EL41       41
LAYER   T1GL33       33
LAYER   T1GL93       93
LAYER   T3PL15       15
LAYER   T3NL16       16
LAYER   T2NL18       18
LAYER   T2PL17       17
LAYER   T3EL13       13
LAYER   T1CL35       35
LAYER   T1ML36       36
LAYER   T1ML94       94
LAYER   T1TL55       55
LAYER   T2ML32       32
LAYER   T2ML95       95
LAYER   T2TL56       56
LAYER   T3KL103      103 
LAYER   T3ML58       58
LAYER   T3ML96       96
LAYER   T3TL57       57
LAYER   T4KL104      104 
LAYER   T4ML59       59
LAYER   T4ML97       97
LAYER   TTVL124      124
LAYER   TTML115      115
LAYER   TTML98       98
LAYER   TTML40       40
LAYER   TPVL7        7
                   
layer   NATIVE       101
layer   MOS_CAP      230
layer   RMDMY_1F     223
layer   RMDMY_1G     224
layer   RMDMY_1M     227
layer   RMDMY_2M     228
layer   RMDMY_3M     234
layer   RMDMY_4M     239
layer   BJTL236      236
layer   DIODE        238
layer   PSUB2        237   //subtract2 ground
layer   SRAM_8T      241   //8T SRAM defined area
layer   SRAM         247   //6T,8T SRAM defined
layer   Shield_3K    83
layer   Shield_4K    84
layer   DLERR        200
layer   LVSERR       60 100
                   
layer   1G_text      210
layer   1M_text      211
layer   2M_text      212
layer   3M_text      213
layer   4M_text      214
layer   TM_text      215

//Text layer definition
  text layer      210 211 212 213 213 214 215
  port layer text 210 211 212 213 213 214 215

  ATTACH  210   1GL33
  ATTACH  211   1ML36
  ATTACH  212   2ML32
  ATTACH  213   3ML58

#ifdef 1P5M
  ATTACH  214   4ML59
  ATTACH  215   TML115

#else

#ifdef 1P4M
  ATTACH  215   TML115
#endif
#endif


///////////////////////////////////
// CAD LAYER DEFINITION 
///////////////////////////////////

NOCHECK = DLERR or LVSERR 

1FL31   = T1FL31   NOT (NOCHECK or RMDMY_1F)
1FL90   = T1FL90   NOT NOCHECK 
4IL44   = T4IL44   NOT NOCHECK 
5IL45   = T5IL45   NOT NOCHECK 
1IL69   = T1IL69   NOT NOCHECK 
2IL27   = T2IL27   NOT NOCHECK 
3IL24   = T2IL27   OR  (NATIVE OR (LD_BLK not 3I_LDMOS)) 
1DL25   = size ( size ( size ((T2PL17 and T2IL27) not T2EL41) by 0.225) by -0.45) by 0.225
2DL10   = size ( size ( size (((T2NL18 not T2IL27) not T2EL41) not NATIVE) by 0.225) by -0.45) by 0.225
1NL106  = size ( size ( size ((T2NL18 not T2IL27) not T2EL41) by 0.225) by -0.45) by 0.225
3SL62   = T3SL62   NOT NOCHECK 
2EL41   = T2EL41   NOT NOCHECK 
6NL19   = (size T2PL17 by 0.12)   NOT NOCHECK    //Dark tone 
1GL33   = T1GL33   NOT (NOCHECK or RMDMY_1G) 
1GL93   = T1GL93   NOT NOCHECK 
3PL15   = T3PL15   NOT NOCHECK
3NL16   = T3NL16   NOT NOCHECK
2NL18   = T2NL18   NOT NOCHECK 
2PL17   = T2PL17   NOT NOCHECK 
3EL13   = T3EL13   NOT NOCHECK   //Dark tone 
1CL35   = T1CL35   NOT NOCHECK 
1ML36   = T1ML36   NOT (NOCHECK or RMDMY_1M)
1ML94   = T1ML94   NOT NOCHECK 
1TL55   = T1TL55   NOT NOCHECK 
2ML32   = T2ML32   NOT (NOCHECK or RMDMY_2M)
2ML95   = T2ML95   NOT NOCHECK 
2TL56   = T2TL56   NOT NOCHECK 
3ML58   = T3ML58   NOT (NOCHECK or RMDMY_3M)
3ML96   = T3ML96   NOT NOCHECK 
3T_MIM  = (T3TL57   AND 3KL103) not NOCHECK    //4M-3T-3K-3M
3TL57   = T3TL57   NOT (NOCHECK or 3T_MIM)
3KL103  = T3KL103  NOT NOCHECK 
4KL104  = T4KL104  NOT NOCHECK 
4ML59   = T4ML59   NOT (NOCHECK or RMDMY_4M)
4ML97   = T4ML97   NOT NOCHECK 
#ifdef 1P5M
TV_MIM  = (TTVL124  AND 4KL104) not NOCHECK    //TM-TV-4K-4M
#else
#ifdef 1P4M
TV_MIM  = (TTVL124  AND 3KL103) not NOCHECK    //TM-TV-3K-3M
#endif
#endif
TVL124  = TTVL124  NOT (NOCHECK or TV_MIM)
TML115  = TTML115  NOT NOCHECK
TML98   = TTML98   NOT NOCHECK
TML40   = TTML40   NOT NOCHECK
PVL7    = TPVL7    NOT NOCHECK 


out_3IL24 { copy 3IL24 }
out_1DL25 { copy 1DL25 }
out_2DL10 { copy 2DL10 }
out_PWELCNT { copy PWELCNT }
out_NWELCNT { copy NWELCNT }
out_4ICNT { copy 4ICNT }
out_5ICNT { copy 5ICNT }
out_PW    { copy PW }
out_NW    { copy NW }


///////////////////////////////////
// FIELD DEFINITION 
///////////////////////////////////

SUBSTRATE_tmp = EXTENT
SUBSTRATE = SUBSTRATE_tmp NOT PSUB2_wall
PSUB2_wall =  (SIZE PSUB2 BY 0.005) NOT PSUB2  //split PW,PSUB2
PW  = SUBSTRATE NOT (3IL24 or PSUB2_wall)
NW  = copy 2IL27 
DNW = copy 1IL69


NFIELD = ((1FL31 AND 2NL18) NOT 2PL17) AND PW
PFIELD = ((1FL31 AND 2PL17) NOT 2NL18) AND NW
NFIELD_NATIVE = ((1FL31 AND 2NL18) NOT 2PL17) AND NATIVE
PWELCNT = (1FL31 AND 2PL17) AND PW
NWELCNT = (1FL31 AND 2NL18) AND NW
4ICNT = ((1FL31 AND 2NL18) AND 4IL44) ENCLOSE 1CL35 
5ICNT = ((1FL31 AND 2PL17) AND 5IL45) ENCLOSE 1CL35 
PWELCNT_noDNW = ((1FL31 AND 2PL17) AND PW) NOT DNW

TR   =  1GL33 AND 1FL31

3.3_NFIELD = NFIELD AND 3NL16
3.3_PFIELD = PFIELD AND 3PL15
3.3_NFIELD_NATIVE = NFIELD_NATIVE AND 3NL16

1.5_NFIELD = NFIELD AND 2DL10
1.5_PFIELD = PFIELD AND 1DL25
1.5_NFIELD_NATIVE = NFIELD_NATIVE AND 2DL10

3.3_NTR = TR AND 3.3_NFIELD 
3.3_PTR = TR AND 3.3_PFIELD 
1.5_NTR = TR AND 1.5_NFIELD 
1.5_PTR = TR AND 1.5_PFIELD 
3.3_NTR_NATIVE = TR AND 3.3_NFIELD_NATIVE
1.5_NTR_NATIVE = TR AND 1.5_NFIELD_NATIVE


3.3_NSD = 3.3_NFIELD NOT TR
3.3_PSD = 3.3_PFIELD NOT TR
1.5_NSD = 1.5_NFIELD NOT TR
1.5_PSD = 1.5_PFIELD NOT TR
NSD = 3.3_NSD  OR  1.5_NSD
PSD = 3.3_PSD  OR  1.5_PSD
3.3_NSD_NATIVE = 3.3_NFIELD_NATIVE NOT TR
1.5_NSD_NATIVE = 1.5_NFIELD_NATIVE NOT TR
NSD_NATIVE = 3.3_NSD_NATIVE  OR  1.5_NSD_NATIVE


CT_DN  =  1CL35 and (NFIELD or NFIELD_NATIVE)
CT_DP  =  1CL35 and PFIELD
CT_G   =  1CL35 and 1GL33

///////////////////////////////////
// Metal Dummy Resistor definition
///////////////////////////////////

R1G = T1GL33  AND RMDMY_1G
R1M = T1ML36  AND RMDMY_1M
R2M = T2ML32  AND RMDMY_2M
R3M = T3ML58  AND RMDMY_3M
R4M = T4ML59  AND RMDMY_4M
                                                                                                                      
R1_T = (SIZE R1M BY 0.01) AND 1ML36
R2_T = (SIZE R2M BY 0.01) AND 2ML32
R3_T = (SIZE R3M BY 0.01) AND 3ML58
R4_T = (SIZE R4M BY 0.01) AND 3ML58


//////////////////////////////////////
// Device definition - 1
/////////////////////////////////////

//////// DIFF ///////////////

mei.#1IL69  = T1FL31 and 1IL69
 an.#1IL69  = T1FL31 not 1IL69
mei.#2IL27  = T1FL31 and 2IL27
 an.#2IL27  = T1FL31 not 2IL27
mei.#PW     = T1FL31 and PW
 an.#PW     = T1FL31 not PW
mei.#4IL44  = T1FL31 and 4IL44
 an.#4IL44  = T1FL31 not 4IL44
mei.#5IL45  = T1FL31 and 5IL45
 an.#5IL45  = T1FL31 not 5IL45
mei.#1DL25  = T1FL31 and 1DL25
 an.#1DL25  = T1FL31 not 1DL25
mei.#2DL10  = T1FL31 and 2DL10
 an.#2DL10  = T1FL31 not 2DL10
mei.#3SL62  = T1FL31 and 3SL62
 an.#3SL62  = T1FL31 not 3SL62
mei.#2EL41  = T1FL31 and 2EL41
 an.#2EL41  = T1FL31 not 2EL41

mei.#6NL19  = T1FL31 not 6NL19   //dark
 an.#6NL19  = T1FL31 and 6NL19   //dark

mei.#3PL15  = T1FL31 and 3PL15
 an.#3PL15  = T1FL31 not 3PL15
mei.#3NL16  = T1FL31 and 3NL16
 an.#3NL16  = T1FL31 not 3NL16
mei.#2NL18  = T1FL31 and 2NL18
 an.#2NL18  = T1FL31 not 2NL18
mei.#2PL17  = T1FL31 and 2PL17
 an.#2PL17  = T1FL31 not 2PL17

mei.#3EL13  = T1FL31 and 3EL13  //dark - follow imp_table,drawing area no CoSi
 an.#3EL13  = T1FL31 not 3EL13  //dark - follow imp_table,no drawing area have CoSi

mei.#RMDMY_1F = T1FL31 and RMDMY_1F
 an.#RMDMY_1F = T1FL31 not RMDMY_1F
mei.#DIO      = T1FL31 and DIODE
 an.#DIO      = T1FL31 not DIODE
mei.#BJT      = T1FL31 and BJTL236
 an.#BJT      = T1FL31 not BJTL236
mei.#NATIVE   = T1FL31 and NATIVE
 an.#NATIVE   = T1FL31 not NATIVE
mei.#MOS_CAP  = T1FL31 and MOS_CAP
 an.#MOS_CAP  = T1FL31 not MOS_CAP



//////// POLY ///////////////

meiPy.#1IL69  = T1GL33 and 1IL69
 anPy.#1IL69  = T1GL33 not 1IL69
meiPy.#2IL27  = T1GL33 and 2IL27
 anPy.#2IL27  = T1GL33 not 2IL27
meiPy.#PW     = T1GL33 and PW
 anPy.#PW     = T1GL33 not PW
meiPy.#4IL44  = T1GL33 and 4IL44
 anPy.#4IL44  = T1GL33 not 4IL44
meiPy.#5IL45  = T1GL33 and 5IL45
 anPy.#5IL45  = T1GL33 not 5IL45
meiPy.#1DL25  = T1GL33 and 1DL25
 anPy.#1DL25  = T1GL33 not 1DL25
meiPy.#2DL10  = T1GL33 and 2DL10
 anPy.#2DL10  = T1GL33 not 2DL10
meiPy.#3SL62  = T1GL33 and 3SL62
 anPy.#3SL62  = T1GL33 not 3SL62
meiPy.#2EL41  = T1GL33 and 2EL41
 anPy.#2EL41  = T1GL33 not 2EL41

meiPy.#6NL19  = T1GL33 not 6NL19   //dark
 anPy.#6NL19  = T1GL33 and 6NL19   //dark

meiPy.#3PL15  = T1GL33 and 3PL15
 anPy.#3PL15  = T1GL33 not 3PL15
meiPy.#3NL16  = T1GL33 and 3NL16
 anPy.#3NL16  = T1GL33 not 3NL16
meiPy.#2NL18  = T1GL33 and 2NL18
 anPy.#2NL18  = T1GL33 not 2NL18
meiPy.#2PL17  = T1GL33 and 2PL17
 anPy.#2PL17  = T1GL33 not 2PL17

meiPy.#3EL13  = T1GL33 and 3EL13  //dark
 anPy.#3EL13  = T1GL33 not 3EL13  //dark

meiPy.#RMDMY_1G = T1GL33 and RMDMY_1G
 anPy.#RMDMY_1G = T1GL33 not RMDMY_1G



//////////////////////////////////////
// Device definition - 2
/////////////////////////////////////

  // +----------------------------------
  // NLVN  1.5V-NMOS
  // +----------------------------------
  dif_NLVN =                 an.#1IL69        and (  an.#2IL27        and ( mei.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and (  an.#1DL25        and ( mei.#2DL10        
                      and (  an.#3SL62        and (  an.#2EL41
                      and ( mei.#6NL19        
                      and (  an.#3PL15        and (  an.#3NL16
                      and ( mei.#2NL18        and (  an.#2PL17
                      and (  an.#3EL13        and (  an.#RMDMY_1F     and (  an.#MOS_CAP 
                      and (  an.#DIO          and (  an.#BJT          and    an.#NATIVE      ))))))))))))))))))

  // +----------------------------------
  // PLVP  1.5V-PMOS
  // +----------------------------------
  dif_PLVP =                                        mei.#2IL27        and (  an.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and ( mei.#1DL25        and (  an.#2DL10
                      and (  an.#3SL62        and (  an.#2EL41
                      and (  an.#6NL19
                      and (  an.#3PL15        and (  an.#3NL16
                      and (  an.#2NL18        and ( mei.#2PL17
                      and (  an.#3EL13        and (  an.#RMDMY_1F     and (  an.#MOS_CAP 
                      and (  an.#DIO          and (  an.#BJT          and    an.#NATIVE      )))))))))))))))))

