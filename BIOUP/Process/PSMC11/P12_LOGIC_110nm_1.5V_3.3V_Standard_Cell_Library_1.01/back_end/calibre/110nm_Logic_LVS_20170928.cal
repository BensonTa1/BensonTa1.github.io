   device q  ( pnp )    dif_PNP    SUBSTRATE NW  PSD  netlist model pnp   [ PROPERTY A A=AREA(dif_PNP) ]
   device q  ( npn )    dif_NPN    DNW       PW  NSD  netlist model npn   [ PROPERTY A A=AREA(dif_NPN) ]
   device q  ( pnp15 )  dif_PNP15  SUBSTRATE NW  PSD  netlist model pnp15 [ PROPERTY A A=AREA(dif_PNP15) ]
   device q  ( npn15 )  dif_NPN15  DNW       PW  NSD  netlist model npn15 [ PROPERTY A A=AREA(dif_NPN15) ]
#ELSE
   device q  ( pnp )    dif_PNP    SUBSTRATE NW  PSD  [ PROPERTY A A=AREA(dif_PNP) ]
   device q  ( npn )    dif_NPN    DNW       PW  NSD  [ PROPERTY A A=AREA(dif_NPN) ]
   device q  ( pnp15 )  dif_PNP15  SUBSTRATE NW  PSD  [ PROPERTY A A=AREA(dif_PNP15) ]
   device q  ( npn15 )  dif_NPN15  DNW       PW  NSD  [ PROPERTY A A=AREA(dif_NPN15) ]
