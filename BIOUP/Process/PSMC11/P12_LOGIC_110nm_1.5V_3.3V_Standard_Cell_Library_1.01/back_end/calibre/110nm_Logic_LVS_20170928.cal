#ifdef 1P5M
device c  ( cmim_3K ) CM3K     3KL103(POS)     3ML58(NEG)   netlist model cmim_3K netlist element "X" [
  property W,L 
  a_cap = area(CM3K)
  p_cap = perimeter(CM3K)
  p_2_cap = p_cap * p_cap
  ac4 = a_cap * 16
  kkk = p_2_cap-ac4
  if(kkk<0) {
  kkk=0
  }
  sq = sqrt(kkk)
  L = (p_cap+sq)/4
  W = (p_cap-sq)/4
        ]

