#ifdef rc_deck
//=============================
//======= Setup for PEX =======
//=============================
MASK SVDB DIRECTORY "svdb" XRC
PEX MAGNIFY 1.0
//PEX DELAY                      none   //PENFIELD 0.7 MASK DIRECT
PEX EXCLUDE DISTRIBUTED        "VDD" "VDDSA" MASK DIRECT
PEX EXCLUDE LUMPED             "VDD" "VDDSA" MASK DIRECT
                                                                                                               
//PEX NETLIST DISTRIBUTED        "net.dist" HSPICE LAYOUT GROUND VSS MASK DIRECT LOCATION RCNAMED
//PEX NETLIST LUMPED             "net.lump" HSPICE LAYOUT GROUND VSS MASK DIRECT LOCATION RCNAMED
PEX NETLIST DISTRIBUTED        "net.dist" HSPICE LAYOUT  MASK DIRECT LOCATION RCNAMED
PEX NETLIST LUMPED             "net.lump" HSPICE LAYOUT  MASK DIRECT LOCATION RCNAMED

PEX NETLIST SIMPLE             "net.simple" HSPICE LAYOUT MASK DIRECT LOCATION RCNAMED
                                                                                                               
PEX REPORT DISTRIBUTED         none  //"report.dist" ASCII LAYOUT MASK DIRECT
PEX REPORT LUMPED              none  //"report.lump" LAYOUT MASK DIRECT
//PEX RESISTANCE LUMPED          YES MASK DIRECT
//PEX REDUCE LUMPED C            < 10000000
PEX IDEAL XCELL                YES
                                                                                                               
// xcalibre capacitance and resistance file
UNIT CAPACITANCE ff
UNIT RESISTANCE OHM
//include ./rules.C
//include ./rules.R
/*  include ./110nm_RC_extraction_1P5M.rules

                                                                                                               
CAPACITANCE INTRINSIC FRINGE 1GL33 INSIDE OF GATE [ PROPERTY C C = 0 ]
CAPACITANCE CROSSOVER PLATE  1GL33 GATE [ PROPERTY C C = 0 ]
CAPACITANCE CROSSOVER FRINGE 1GL33 PSD  [ PROPERTY C C = 0 ]
CAPACITANCE CROSSOVER FRINGE 1GL33 NSD  [ PROPERTY C C = 0 ]
CAPACITANCE ORDER NSD PSD GATE 1GL33 1ML36 2ML32 3ML58 4ML59 TML115
                                                                                                               
RESISTANCE SHEET NSD [res.typ_rs_NAA 0]
RESISTANCE SHEET PSD [res.typ_rs_PAA 0]
RESISTANCE SHEET 1GL33 [res.typ_rs_POLY 0]
RESISTANCE SHEET 1ML36  [res.typ_rs_1M 0]
RESISTANCE SHEET 2ML32  [res.typ_rs_2M 0]
RESISTANCE SHEET 3ML58  [res.typ_rs_3M 0]
RESISTANCE SHEET 4ML59  [res.typ_rs_4M 0]
RESISTANCE CONNECTION 1ML36 NSD [res.typ_rc_NAA 0]
RESISTANCE CONNECTION 1ML36 PSD [res.typ_rc_PAA 0]
RESISTANCE CONNECTION 1ML36 1GL33 [res.typ_rc_POLY 0]
RESISTANCE CONNECTION 2ML32 1ML36  [res.typ_rc_1T 0]
RESISTANCE CONNECTION 3ML58 2ML32  [res.typ_rc_2T 0]
RESISTANCE CONNECTION 4ML59 3ML58  [res.typ_rc_3T 0]
                                                                                                               
*/                                                                                                             
#endif
