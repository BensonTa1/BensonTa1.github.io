                      and ( mei.#6NL19
                      and (  an.#3PL15        and (  an.#3NL16
                      and ( mei.#2NL18        and (  an.#2PL17
                      and (  an.#3EL13        and (  an.#RMDMY_1F     and (  an.#MOS_CAP
                      and ( mei.#DIO          and (  an.#BJT          and    an.#NATIVE      ))))))))))))))))))

  // +----------------------------------
  // Diode P+_NW  1.5v
  // +----------------------------------
  dif_PD_P_NW =                                     mei.#2IL27        and (  an.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and ( mei.#1DL25        and (  an.#2DL10
                      and (  an.#3SL62        and (  an.#2EL41
                      and (  an.#6NL19
                      and (  an.#3PL15        and (  an.#3NL16
                      and (  an.#2NL18        and ( mei.#2PL17
                      and (  an.#3EL13        and (  an.#RMDMY_1F     and (  an.#MOS_CAP
                      and ( mei.#DIO          and (  an.#BJT          and    an.#NATIVE      )))))))))))))))))


  // +----------------------------------
  // Diode N+_PW  3.3v
  // +----------------------------------
  dif_PD_N_PW33 =            an.#1IL69        and (  an.#2IL27        and ( mei.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and (  an.#1DL25        and (  an.#2DL10
                      and (  an.#3SL62        and ( mei.#2EL41
                      and ( mei.#6NL19
                      and (  an.#3PL15        and ( mei.#3NL16
                      and ( mei.#2NL18        and (  an.#2PL17
                      and ( an.#3EL13         and (  an.#RMDMY_1F     and (  an.#MOS_CAP
                      and ( mei.#DIO          and (  an.#BJT          and    an.#NATIVE      ))))))))))))))))))

  // +----------------------------------
  // Diode N+_PW  3.3v in DNW
  // +----------------------------------
  dif_PD_N_PW_DNW33 =       mei.#1IL69        and (  an.#2IL27        and ( mei.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and (  an.#1DL25        and (  an.#2DL10
                      and (  an.#3SL62        and ( mei.#2EL41
                      and ( mei.#6NL19
                      and (  an.#3PL15        and ( mei.#3NL16
                      and ( mei.#2NL18        and (  an.#2PL17
                      and ( an.#3EL13         and (  an.#RMDMY_1F     and (  an.#MOS_CAP
                      and ( mei.#DIO          and (  an.#BJT          and    an.#NATIVE      ))))))))))))))))))

  // +----------------------------------
  // Diode P+_NW  3.3v
  // +----------------------------------
  dif_PD_P_NW33 =                                   mei.#2IL27        and (  an.#PW
                      and (  an.#4IL44        and (  an.#5IL45
                      and (  an.#1DL25        and (  an.#2DL10
                      and (  an.#3SL62        and ( mei.#2EL41
                      and (  an.#6NL19
                      and ( mei.#3PL15        and (  an.#3NL16
                      and (  an.#2NL18        and ( mei.#2PL17
                      and (  an.#3EL13        and (  an.#RMDMY_1F     and (  an.#MOS_CAP
                      and ( mei.#DIO          and (  an.#BJT          and    an.#NATIVE      )))))))))))))))))

  // +----------------------------------
  // LDN LD-NMOS 
  // +----------------------------------
  //Drain Node
  dif_LDN_Drain = (((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        OUTSIDE 1IL69    ) OUTSIDE 2IL27   ) OUTSIDE PW)
        INSIDE  4IL44    ) OUTSIDE 5IL45   )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   ) 
        OUTSIDE 3PL15    ) INSIDE  3NL16   ) 
        INSIDE  2NL18    ) OUTSIDE 2PL17   ) 
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE

  //Source Node
  dif_LDN_Source_NON_BUTTED = (((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        OUTSIDE 1IL69    ) OUTSIDE 2IL27   ) INSIDE PW)
        OUTSIDE 4IL44    ) OUTSIDE 5IL45   )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   )
        OUTSIDE 3PL15    ) INSIDE  3NL16   )
        INSIDE  2NL18    ) OUTSIDE 2PL17   )
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE

  // +----------------------------------
  // LDNI LD-NMOS in DNW
  // +----------------------------------
  //Drain Node
  dif_LDNI_Drain = (((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        INSIDE  1IL69    ) OUTSIDE 2IL27   ) OUTSIDE PW)
        INSIDE  4IL44    ) OUTSIDE 5IL45   )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   )
        OUTSIDE 3PL15    ) INSIDE  3NL16   )
        INSIDE  2NL18    ) OUTSIDE 2PL17   )
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE

  //Source Node
  dif_LDNI_Source_NON_BUTTED = (((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        INSIDE  1IL69    ) OUTSIDE 2IL27   ) INSIDE PW)
        OUTSIDE 4IL44    ) OUTSIDE 5IL45   )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   )
        OUTSIDE 3PL15    ) INSIDE  3NL16   )
        INSIDE  2NL18    ) OUTSIDE 2PL17   )
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE


  // +----------------------------------
  // LDP LD-PMOS
  // +----------------------------------
  //Drain Node
  dif_LDP_Drain = ((((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        INSIDE  1IL69    ) OUTSIDE 2IL27   ) OUTSIDE PW)
        OUTSIDE 4IL44    ) INSIDE 5IL45    )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   )
        INSIDE  6NL19    )
        INSIDE  3PL15    ) OUTSIDE 3NL16   )
        OUTSIDE 2NL18    ) INSIDE  2PL17   ) 
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE

  //Source Node
  dif_LDP_Source_NON_BUTTED = ((((((((((((((((((((1FL31
        NOT     1GL33    ) ENCLOSE 1CL35   )
        INSIDE  1IL69    ) INSIDE  2IL27   ) OUTSIDE PW)
        OUTSIDE 4IL44    ) OUTSIDE 5IL45   )
        OUTSIDE 1DL25    ) OUTSIDE 2DL10   )
        OUTSIDE 3SL62    ) INSIDE  2EL41   )
        INSIDE  6NL19    )
        INSIDE  3PL15    ) OUTSIDE 3NL16   )
        OUTSIDE 2NL18    ) INSIDE  2PL17   )
        OUTSIDE 3EL13    ) OUTSIDE RMDMY_1F)
        OUTSIDE DIODE    ) OUTSIDE BJTL236 )
        OUTSIDE NATIVE




out_dif_NLVN      { copy dif_NLVN }
out_dif_PLVP      { copy dif_PLVP }
out_dif_NMVN      { copy dif_NMVN }
out_dif_PMVP      { copy dif_PMVP }
out_dif_NLVNI     { copy dif_NLVNI }
out_dif_NMVNI     { copy dif_NMVNI }
out_dif_NMVN_ESD  { copy dif_NMVN_ESD }
out_dif_NMVNI_ESD { copy dif_NMVNI_ESD }
out_dif_PMVP_ESD  { copy dif_PMVP_ESD }
out_dif_NLVZ      { copy dif_NLVZ }
out_dif_NMVZ      { copy dif_NMVZ }
out_dif_NCHC      { copy dif_NCHC }
out_dif_NCHCI     { copy dif_NCHCI }
out_dif_NCHCP15   { copy dif_NCHCP15 }
out_dif_NCHCP33   { copy dif_NCHCP33 }
out_dif_NCHC15    { copy dif_NCHC15 }
out_dif_NCHC33    { copy dif_NCHC33 }
out_dif_PCHC15    { copy dif_PCHC15 }
out_dif_PCHC33    { copy dif_PCHC33 }
out_RES_N_AA      { copy RES_N_AA }
out_RES_P_AA      { copy RES_P_AA }
out_RES_N_Poly    { copy RES_N_Poly }
out_RES_P_Poly    { copy RES_P_Poly }
out_RES_N_AA_wo_salicide      { copy RES_N_AA_wo_salicide }
out_RES_P_AA_wo_salicide      { copy RES_P_AA_wo_salicide }
out_RES_N_Poly_wo_salicide    { copy RES_N_Poly_wo_salicide }
out_RES_P_Poly_wo_salicide    { copy RES_P_Poly_wo_salicide }
out_dif_NPN                   { copy dif_NPN }
out_dif_PNP                   { copy dif_PNP }
out_dif_NPN15                 { copy dif_NPN15 }
out_dif_PNP15                 { copy dif_PNP15 }
out_dif_PD_N_PW               { copy dif_PD_N_PW }
out_dif_PD_N_PW_DNW           { copy dif_PD_N_PW_DNW }
out_dif_PD_P_NW               { copy dif_PD_P_NW }
out_dif_PD_N_PW33             { copy dif_PD_N_PW33 }
out_dif_PD_N_PW_DNW33         { copy dif_PD_N_PW_DNW33 }
out_dif_PD_P_NW33             { copy dif_PD_P_NW33 }
out_dif_LDN_Drain             { copy dif_LDN_Drain }
out_dif_LDN_Source_NON_BUTTED { copy dif_LDN_Source_NON_BUTTED }
out_dif_LDNI_Drain             { copy dif_LDNI_Drain }
out_dif_LDNI_Source_NON_BUTTED { copy dif_LDNI_Source_NON_BUTTED }
out_dif_LDP_Drain             { copy dif_LDP_Drain }
out_dif_LDP_Source_NON_BUTTED { copy dif_LDP_Source_NON_BUTTED }
//out_ { copy  }
//out_ { copy  }
//out_ { copy  }


//////////////////////////////////////////
// Transistor Definition
/////////////////////////////////////////
                                                                                                                
  NLVN       = 1.5_NTR and dif_NLVN
  NLVNI      = (1.5_NTR and dif_NLVNI) not SRAM
  PLVP       = (1.5_PTR and dif_PLVP) not SRAM
  NMVN       = 3.3_NTR and dif_NMVN
  NMVNI      = 3.3_NTR and dif_NMVNI
  PMVP       = 3.3_PTR and dif_PMVP
  NCHC       = (3.3_NTR and dif_NCHC)  and 3SL62
  NCHCI      = (3.3_NTR and dif_NCHCI) and 3SL62

  NCHCP15    = (1.5_NTR and dif_NCHCP15)  not 3SL62
  NCHCP33    = (3.3_NTR and dif_NCHCP33)  not 3SL62
  NCHC15     = (TR and dif_NCHC15)  not 3SL62
  NCHC33     = (TR and dif_NCHC33)  not 3SL62
  PCHC15     = (1.5_PTR and dif_PCHC15)  not 3SL62
  PCHC33     = (3.3_PTR and dif_PCHC33)  not 3SL62
  NMVNESD    = 3.3_NTR and dif_NMVN_ESD
  NMVNIESD   = 3.3_NTR and dif_NMVNI_ESD
  PMVPESD    = 3.3_PTR and dif_PMVP_ESD
  NLVZ       = 1.5_NTR_NATIVE and dif_NLVZ
  NMVZ       = 3.3_NTR_NATIVE and dif_NMVZ
  
  NCHC_A     = (dif_NCHC and 3SL62) not NCHC
  NCHC_G     = 1GL33 and NCHC 
  NCHCI_A    = (dif_NCHCI and 3SL62) not NCHCI 
  NCHCI_G    = 1GL33 and NCHCI 
  NCHCP15_A  = (dif_NCHCP15 not 3SL62) not NCHCP15 
  NCHCP15_G  = 1GL33 and NCHCP15
  NCHCP33_A  = (dif_NCHCP33 not 3SL62) not NCHCP33 
  NCHCP33_G  = 1GL33 and NCHCP33
  NCHC15_A   = (dif_NCHC15 not 3SL62) not NCHC15 
  NCHC15_G   = 1GL33 and NCHC15 
  NCHC33_A   = (dif_NCHC33 not 3SL62) not NCHC33 
  NCHC33_G   = 1GL33 and NCHC33 
  PCHC15_A   = (dif_PCHC15 not 3SL62) not PCHC15 
  PCHC15_G   = 1GL33 and PCHC15 
  PCHC33_A   = (dif_PCHC33 not 3SL62) not PCHC33 
  PCHC33_G   = 1GL33 and PCHC33 

  NLDN  = (((1FL31 AND 1GL33)
                                      TOUCH    dif_LDN_Source_NON_BUTTED  == 1)
        INTERACT 2NL18          == 1) INTERACT 4IL44                      == 1
 
  NLDNI = (((1FL31 AND 1GL33)
                                      TOUCH    dif_LDNI_Source_NON_BUTTED == 1)
        INTERACT 2NL18          == 1) INTERACT 4IL44                      == 1

  PLDP  = (((1FL31 AND 1GL33)
                                      TOUCH    dif_LDP_Source_NON_BUTTED  == 1)
        INTERACT 2PL17          == 1) INTERACT 5IL45                      == 1


out_NLDN  { copy NLDN  }
out_NLDNI { copy NLDNI }
out_PLDP  { copy PLDP  }
out_NCHC15    { copy NCHC15  }
out_NCHC15_A  { copy NCHC15_A  }
out_NCHC15_G  { copy NCHC15_G  }
out_NCHC33    { copy NCHC33  }
out_NCHC33_A  { copy NCHC33_A  }
out_NCHC33_G  { copy NCHC33_G  }


////////////////////////////////////////
// Connection
///////////////////////////////////////

GATE = ((((((((((((NLVN or PLVP) or NMVN) or PMVP) or NLVNI) or NMVNI) or NMVNESD) or NMVNIESD) or PMVPESD) or NLVZ) or NMVZ
       ) or NLDN) or NLDNI) or PLDP   

XRC_NSD = (((((NSD or NSDR) or NSD_NATIVE) or dif_LDN_Drain) or dif_LDN_Source_NON_BUTTED) or dif_LDNI_Drain) or dif_LDNI_Source_NON_BUTTED

XRC_PSD = ((PSD or PSDR) or dif_LDP_Drain) or dif_LDP_Source_NON_BUTTED

sconnect  1GL33    NLVN
sconnect  1GL33    NLVNI
sconnect  1GL33    PLVP
sconnect  1GL33    NMVN
sconnect  1GL33    NMVNI
sconnect  1GL33    PMVP
sconnect  1GL33    NMVNESD
sconnect  1GL33    NMVNIESD
sconnect  1GL33    PMVPESD
sconnect  1GL33    NLVZ
sconnect  1GL33    NMVZ
sconnect  1GL33    NLDN
sconnect  1GL33    NLDNI
sconnect  1GL33    PLDP

sconnect  XRC_NSD  NSD
sconnect  XRC_NSD  NSDR
sconnect  XRC_NSD  NSD_NATIVE
sconnect  4IL44 dif_LDN_Drain by 4ICNT 
sconnect  XRC_NSD  dif_LDN_Drain
sconnect  XRC_NSD  dif_LDN_Source_NON_BUTTED
sconnect  4IL44 dif_LDNI_Drain by 4ICNT 
sconnect  XRC_NSD  dif_LDNI_Drain
sconnect  XRC_NSD  dif_LDNI_Source_NON_BUTTED
sconnect  XRC_PSD  PSD
sconnect  XRC_PSD  PSDR
sconnect  5IL45 dif_LDP_Drain by 5ICNT 
sconnect  XRC_PSD  dif_LDP_Drain
sconnect  XRC_PSD  dif_LDP_Source_NON_BUTTED

sconnect  1GL33    NTRMG
sconnect  1GL33    PTRM
sconnect  1GL33    NTRM
sconnect  1GL33    NTRMG.8T
sconnect  1GL33    PTRM.8T
sconnect  1GL33    NTRM.8T

#ifdef 1P5M
connect  3KL103    4ML59      by  3T_MIM
connect  4KL104    TML115     by  TV_MIM

connect  GATE      1GL33
connect  4ML59     TML115     by  TVL124
connect  3ML58     4ML59      by  3TL57
connect  2ML32     3ML58      by  2TL56
connect  1ML36     2ML32      by  1TL55
connect  1ML36     1GL33      by  CT_G
connect  1ML36     XRC_NSD    by  CT_DN
connect  1ML36     XRC_PSD    by  CT_DP
connect  1ML36     NWELCNT    by  1CL35
connect  1ML36     PWELCNT    by  1CL35
connect  1ML36     4ICNT      by  1CL35
connect  1ML36     5ICNT      by  1CL35
connect  XRC_NSD   XRC_PSD

#else

#ifdef 1P4M 
connect  3KL103    TML115     by  TV_MIM

connect  GATE      1GL33
connect  3ML58     TML115     by  TVL124
connect  2ML32     3ML58      by  2TL56
connect  1ML36     2ML32      by  1TL55
connect  1ML36     1GL33      by  CT_G
connect  1ML36     XRC_NSD    by  CT_DN
connect  1ML36     XRC_PSD    by  CT_DP
connect  1ML36     NWELCNT    by  1CL35
connect  1ML36     PWELCNT    by  1CL35
connect  1ML36     4ICNT      by  1CL35
connect  1ML36     5ICNT      by  1CL35
connect  XRC_NSD   XRC_PSD
#endif
#endif


PW_DNW = PW NOT DNW

connect  NWELCNT    NW
connect  PWELCNT    PW
connect  PWELCNT    PW_DNW
connect  4ICNT      4IL44
connect  5ICNT      5IL45 
sconnect  NW         DNW
sconnect  PW_DNW     SUBSTRATE




#ifdef 1P5M
SCONNECT        4ML59              R4_T
SCONNECT        3ML58              R3_T
SCONNECT        2ML32              R2_T
SCONNECT        1ML36              R1_T

#else

#ifdef 1P4M
SCONNECT        3ML58              R3_T
SCONNECT        2ML32              R2_T
SCONNECT        1ML36              R1_T
#endif
#endif

//LVS SOFTCHK   NW          UPPER //ALL
//LVS SOFTCHK   PW          UPPER //ALL
LVS SOFTCHK   DNW         UPPER //ALL
LVS SOFTCHK   SUBSTRATE   UPPER //ALL




  sconnect  1GL33  NCHC_G
  connect   1ML36  NCHC_A    by  1CL35
  sconnect  1GL33  NCHCI_G
  connect   1ML36  NCHCI_A   by  1CL35
  sconnect  1GL33  NCHCP15_G
  connect   1ML36  NCHCP15_A by  1CL35
  sconnect  1GL33  NCHCP33_G
  connect   1ML36  NCHCP33_A by  1CL35
  sconnect  1GL33  NCHC15_G
  connect   1ML36  NCHC15_A  by  1CL35
  sconnect  1GL33  NCHC33_G
  connect   1ML36  NCHC33_A  by  1CL35
  sconnect  1GL33  PCHC15_G
  connect   1ML36  PCHC15_A  by  1CL35
  sconnect  1GL33  PCHC33_G
  connect   1ML36  PCHC33_A  by  1CL35


// ============================================================================================== 
//-- SRAM transistor ---
//6T SRAM Transistor W/L Setting

#ifdef SRAM_PTC ON 

variable pm.w   0.20                    //Pull Load W
variable pm.l   0.19                    //Pull Load L
variable nm.w   0.30                    //Pull Down W
variable nm.l   0.19                    //Pull Down L
variable ng.w   0.20                    //Pass Gate W
variable ng.l   0.195                   //Pass Gate L

#else

variable pm.w   0.16                    //Pull Load W
variable pm.l   0.15                    //Pull Load L
variable nm.w   0.22                    //Pull Down W
variable nm.l   0.13                    //Pull Down L
variable ng.w   0.15                    //Pass Gate W
variable ng.l   0.175                   //Pass Gate L

#endif

SHARE_TR = ((dif_NLVNI OR dif_PLVP) AND 1GL33) INTERACT 1CL35
NTRMG_W = INT (dif_NLVNI   INSIDE EDGE 1GL33)  == ng.w ABUT<90 OPPOSITE REGION
NTRMG_L = INT (1GL33 INSIDE EDGE dif_NLVNI  )  == ng.l ABUT<90 OPPOSITE REGION
NTRMG_A = NTRMG_W AND NTRMG_L
PTRM_W = INT (dif_PLVP   INSIDE EDGE 1GL33)  == pm.w ABUT<90 OPPOSITE REGION
PTRM_L = INT (1GL33 INSIDE EDGE dif_PLVP  )  == pm.l ABUT<90 OPPOSITE REGION
PTRM_A = PTRM_W AND PTRM_L
NTRM_W = INT (dif_NLVNI   INSIDE EDGE 1GL33)  == nm.w ABUT<90 OPPOSITE REGION
NTRM_L = INT (1GL33 INSIDE EDGE dif_NLVNI  )  == nm.l ABUT<90 OPPOSITE REGION
NTRM_A = NTRM_W AND NTRM_L
NTRMG =(((dif_NLVNI INSIDE  (SRAM not SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE NTRMG_A         //6T SRAM NMOS (PG)
PTRM = (((dif_PLVP  INSIDE  (SRAM not SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE PTRM_A          //6T SRAM PMOS (PL)
NTRM = (((dif_NLVNI INSIDE  (SRAM not SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE NTRM_A          //6T SRAM NMOS (PD)

out_NTRMG { copy NTRMG } 
out_PTRM  { copy PTRM }  
out_NTRM  { copy NTRM }  


//8T SRAM Transistor W/L Setting
variable pm.w.8T   0.15                    //Pull Load W
variable pm.l.8T   0.135                   //Pull Load L
variable nm.w.8T   0.60                    //Pull Down W - 8T different
variable nm.l.8T   0.13                    //Pull Down L
variable ng.w.8T   0.15                    //Pass Gate W
variable ng.l.8T   0.15                    //Pass Gate L

//SHARE_TR = ((dif_NLVNI OR dif_PLVP) AND 1GL33) INTERACT 1CL35
NTRMG_W.8T = INT (dif_NLVNI   INSIDE EDGE 1GL33)  == ng.w.8T ABUT<90 OPPOSITE REGION
NTRMG_L.8T = INT (1GL33 INSIDE EDGE dif_NLVNI  )  == ng.l.8T ABUT<90 OPPOSITE REGION
NTRMG_A.8T = NTRMG_W.8T AND NTRMG_L.8T
PTRM_W.8T = INT (dif_PLVP   INSIDE EDGE 1GL33)  == pm.w.8T ABUT<90 OPPOSITE REGION
PTRM_L.8T = INT (1GL33 INSIDE EDGE dif_PLVP  )  == pm.l.8T ABUT<90 OPPOSITE REGION
PTRM_A.8T = PTRM_W.8T AND PTRM_L.8T
NTRM_W.8T = INT (dif_NLVNI   INSIDE EDGE 1GL33)  == nm.w.8T ABUT<90 OPPOSITE REGION
NTRM_L.8T = INT (1GL33 INSIDE EDGE dif_NLVNI  )  == nm.l.8T ABUT<90 OPPOSITE REGION
NTRM_A.8T = NTRM_W.8T AND NTRM_L.8T
NTRMG.8T =(((dif_NLVNI INSIDE  (SRAM AND SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE NTRMG_A.8T      //8T SRAM NMOS (PG)
PTRM.8T = (((dif_PLVP  INSIDE  (SRAM AND SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE PTRM_A.8T       //8T SRAM PMOS (PL)
NTRM.8T = (((dif_NLVNI INSIDE  (SRAM AND SRAM_8T)) AND 1GL33) NOT SHARE_TR) ENCLOSE NTRM_A.8T       //8T SRAM NMOS (PD)

out_NTRMG.8T { copy NTRMG.8T }
out_PTRM.8T  { copy PTRM.8T }
out_NTRM.8T  { copy NTRM.8T }

//-- SRAM transistor END ---
// ============================================================================================== 


//////////////////////////////////////////
// MIM capacitor
//////////////////////////////////////////
//Defining on CAD LAYER DEFINITION
//3T_MIM     = 3TL57  AND 3KL103    //4M-3T-3K-3M
//TV_MIM     = TVL124 AND 4KL104    //TM-TV-4K-4M

#ifdef 1P5M 
CM3K           = (3KL103    INSIDE 4ML59 ) NOT Shield_3K
CM3K_shield    = (3KL103    INSIDE 4ML59 ) AND (3ML58 AND Shield_3K)
CM4K           = (4KL104    INSIDE TML115) NOT Shield_4K
CM4K_shield    = (4KL104    INSIDE TML115) AND (4ML59 AND Shield_4K)

out_CM3K        { copy CM3K }
out_CM3K_shield { copy CM3K_shield }
out_CM4K        { copy CM4K }
out_CM4K_shield { copy CM4K_shield }

#else

#ifdef 1P4M
CM3K           = 3KL103    INSIDE TML115

out_CM3K        { copy CM3K }
#endif
#endif

//////////////////////////////////////////
// Device Extraction
//////////////////////////////////////////
                                                                                                                
// +-------------------------------------------------------------------------
// |          schema        layout     (g)  (s)  (d)  (b)
// +-------------------------------------------------------------------------
   //--- MOS ---------------------------------------
lvs netlist allow inconsistent model yes

1F_REF = ( 1FL31 NOT NWELCNT ) NOT PWELCNT  
1G_REF = ((NLDN AND PW) OR (NLDNI AND PW)) OR(PLDP AND NW) 

#IFDEF rc_deck
dmacro	mosprop	devlay {
[       property        W,L,AS,AD,PD,PS,NRD,NRS
W       =       (perimeter_coincide(devlay,S)+perimeter_coincide(devlay,D))/2
L       =       area(devlay)/W
     
     PI_S_OD = perimeter_inside(S,1F_REF)
     PI_D_OD = perimeter_inside(D,1F_REF)
     IF(PI_S_OD == 0) {                     // Shorted S/D - assign half to each side.
       AD = area(D) * W / PI_D_OD / 2
       AS = AD
       PD = perimeter(D) * W / PI_D_OD / 2
       PS = PD
     }
     ELSE IF(PI_D_OD == 0) {                // Shorted S/D - assign half to each side.
       AS = area(S) * W / PI_S_OD / 2
       AD = AS
       PS = perimeter(S) * W / PI_S_OD / 2
       PD = PS
     }
     ELSE {                                 // Regular case.
      AS = area(S) * W / PI_S_OD
      AD = area(D) * W / PI_D_OD
      PS = perimeter(S) * W / PI_S_OD
      PD = perimeter(D) * W / PI_D_OD
     }
   #IFDEF ZERO_NRS_NRD
     NRS = 0
     NRD = 0
   #ELSE
     NRS = AS / W / W
     NRD = AD / W / W
   #ENDIF
] 
}

dmacro  ldmosprop devlay {
[       property        W,L,AS,AD,PD,PS,NRD,NRS
W       =       perimeter_coincide(1G_REF,S)
L       =       area(1G_REF)/W

     PI_S_OD = perimeter_inside(S,1F_REF)
     PI_D_OD = perimeter_inside(D,1F_REF)
     IF(PI_S_OD == 0) {                     // Shorted S/D - assign half to each side.
       AD = area(D) * W / PI_D_OD / 2
       AS = AD
       PD = perimeter(D) * W / PI_D_OD / 2
       PS = PD
     }
     ELSE IF(PI_D_OD == 0) {                // Shorted S/D - assign half to each side.
       AS = area(S) * W / PI_S_OD / 2
       AD = AS
       PS = perimeter(S) * W / PI_S_OD / 2
       PD = PS
     }
     ELSE {                                 // Regular case.
      AS = area(S) * W / PI_S_OD
      AD = area(D) * W / PI_D_OD
      PS = perimeter(S) * W / PI_S_OD
      PD = perimeter(D) * W / PI_D_OD
     }
   #IFDEF ZERO_NRS_NRD
     NRS = 0
     NRD = 0
   #ELSE
     NRS = AS / W / W
     NRD = AD / W / W
   #ENDIF
]
}


#ELSE
dmacro  mosprop devlay {
[       property        W,L
W       =       (perimeter_coincide(s,devlay)+perimeter_coincide(d,devlay))/2
L       =       area(devlay)/W ]
}

dmacro  ldmosprop devlay {
[       property        W,L
W       =       perimeter_coincide(1G_REF,S)
L       =       area(1G_REF)/W ]
}

#ENDIF

#IFDEF rc_deck
   device m ( lvn       )  NLVN   NLVN(g)    NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model lvn  //
   cmacro mosprop          NLVN		
   device m ( lvni      )  NLVNI  NLVNI(g)   NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model lvn //
   cmacro mosprop          NLVNI		
   device m ( lvp       )  PLVP   PLVP(g)    PSD(s)  PSD(d)  NW(b)  <1F_REF>  netlist model lvp //
   cmacro mosprop          PLVP		
   device m ( hvn       )  NMVN   NMVN(g)    NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model hvn //
   cmacro mosprop          NMVN		
   device m ( hvni      )  NMVNI  NMVNI(g)   NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model hvn //
   cmacro mosprop          NMVNI		
   device m ( hvp       )  PMVP   PMVP(g)    PSD(s)  PSD(d)  NW(b)  <1F_REF>  netlist model hvp //
   cmacro mosprop          PMVP		
   device m ( hvnesd    )  NMVNESD   NMVNESD(g)    NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model hvnesd //
   cmacro mosprop          NMVNESD
   device m ( hvniesd   )  NMVNIESD  NMVNIESD(g)   NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model hvnesd //
   cmacro mosprop          NMVNIESD
   device m ( hvpesd    )  PMVPESD   PMVPESD(g)    PSD(s)  PSD(d)  NW(b)  <1F_REF>  netlist model hvpesd //
   cmacro mosprop          PMVPESD
   device m ( lvz       )  NLVZ   NLVZ(g)    NSD_NATIVE(s)  NSD_NATIVE(d)  SUBSTRATE(b)  <1F_REF>  netlist model lvz //
   cmacro mosprop          NLVZ
   device m ( hvz       )  NMVZ   NMVZ(g)    NSD_NATIVE(s)  NSD_NATIVE(d)  SUBSTRATE(b)  <1F_REF>  netlist model hvz //
   cmacro mosprop          NMVZ
   device m ( ldn       )  NLDN     1GL33(g)   dif_LDN_Source_NON_BUTTED(s)   4IL44(d)  PW(b) <1F_REF> <1G_REF> netlist model ldn //
   cmacro ldmosprop        NLDN
   device m ( ldni      )  NLDNI    1GL33(g)   dif_LDNI_Source_NON_BUTTED(s)  4IL44(d)  PW(b) <1F_REF> <1G_REF> netlist model ldn //
   cmacro ldmosprop        NLDNI
   device m ( ldp       )  PLDP     1GL33(g)   dif_LDP_Source_NON_BUTTED(s)   5IL45(d)  NW(b) <1F_REF> <1G_REF> netlist model ldp //
   cmacro ldmosprop        PLDP 


//-- SRAM transistor ---
//-- 6T SRAM ---
   device m ( lvpgn       )  NTRMG  NTRMG(g)    NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model pgn  //
   cmacro mosprop          NTRMG
   device m ( lvplp       )  PTRM   PTRM(g)     PSD(s)  PSD(d)  NW(b)  <1F_REF>  netlist model plp  //
   cmacro mosprop          PTRM
   device m ( lvpdn       )  NTRM   NTRM(g)     NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model pdn  // 
   cmacro mosprop          NTRM

//-- 8T SRAM ---
   device m ( lvpgn       )  NTRMG.8T  NTRMG.8T(g)    NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model pgn  //
   cmacro mosprop          NTRMG.8T
   device m ( lvplp       )  PTRM.8T   PTRM.8T(g)     PSD(s)  PSD(d)  NW(b)  <1F_REF>  netlist model plp  //
   cmacro mosprop          PTRM.8T
   device m ( lvpdn       )  NTRM.8T   NTRM.8T(g)     NSD(s)  NSD(d)  PW(b)  <1F_REF>  netlist model pdn  //
   cmacro mosprop          NTRM.8T
//-- SRAM transistor END ---

#ELSE
   device m ( lvn       )  NLVN     1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NLVN
   device m ( lvni      )  NLVNI    1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NLVNI
   device m ( lvp       )  PLVP     1GL33(g)   PSD(s)  PSD(d)  NW(b)  //
   cmacro mosprop       PLVP
   device m ( hvn       )  NMVN     1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NMVN
   device m ( hvni      )  NMVNI    1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NMVNI
   device m ( hvp       )  PMVP     1GL33(g)   PSD(s)  PSD(d)  NW(b)  //
   cmacro mosprop       PMVP
   device m ( hvnesd    )  NMVNESD  1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NMVNESD
   device m ( hvniesd   )  NMVNIESD 1GL33(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop       NMVNIESD
   device m ( hvpesd    )  PMVPESD  1GL33(g)   PSD(s)  PSD(d)  NW(b)  //
   cmacro mosprop       PMVPESD
   device m ( lvz       )  NLVZ     1GL33(g)   NSD_NATIVE(s)  NSD_NATIVE(d)  SUBSTRATE(b)  //
   cmacro mosprop       NLVZ
   device m ( hvz       )  NMVZ     1GL33(g)   NSD_NATIVE(s)  NSD_NATIVE(d)  SUBSTRATE(b)  //
   cmacro mosprop       NMVZ
   device m ( ldn       )  NLDN     1GL33(g)   dif_LDN_Source_NON_BUTTED(s)   4IL44(d)  PW(b) <1G_REF> //
   cmacro ldmosprop     NLDN
   device m ( ldni      )  NLDNI    1GL33(g)   dif_LDNI_Source_NON_BUTTED(s)  4IL44(d)  PW(b) <1G_REF> // 
   cmacro ldmosprop     NLDNI
   device m ( ldp       )  PLDP     1GL33(g)   dif_LDP_Source_NON_BUTTED(s)   5IL45(d)  NW(b) <1G_REF> // 
   cmacro ldmosprop     PLDP 


//-- SRAM transistor ---
//-- 6T SRAM ---
   device m ( lvpgn       )  NTRMG   NTRMG(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop  NTRMG
   device m ( lvplp       )  PTRM   PTRM(g)     PSD(s)  PSD(d)  NW(b)  //
   cmacro mosprop  PTRM
   device m ( lvpdn       )  NTRM   NTRM(g)     NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop  NTRM

//-- 8T SRAM ---
   device m ( lvpgn       )  NTRMG.8T   NTRMG.8T(g)   NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop  NTRMG.8T
   device m ( lvplp       )  PTRM.8T   PTRM.8T(g)     PSD(s)  PSD(d)  NW(b)  //
   cmacro mosprop  PTRM.8T
   device m ( lvpdn       )  NTRM.8T   NTRM.8T(g)     NSD(s)  NSD(d)  PW(b)  //
   cmacro mosprop  NTRM.8T
//-- SRAM transistor END ---

#ENDIF

