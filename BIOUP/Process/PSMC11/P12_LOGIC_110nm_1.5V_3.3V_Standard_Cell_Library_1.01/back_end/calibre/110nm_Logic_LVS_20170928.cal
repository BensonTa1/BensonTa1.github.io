// +-------------------------------------------------------------------------
// |          schema            layout         (pos)    (neg)
// +-------------------------------------------------------------------------
//--- C --------------------------------

#IFDEF rc_deck
device c  ( c3s ) NCHC     NCHC_G(POS)     NCHC_A(NEG)   netlist model c3s netlist element "X" [
       property W,L
        NUM = COUNT(NCHC_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHC_A,NCHC_G)
        } ELSE {
          W = PERIMETER_COINCIDE(NCHC_A,NCHC_G)/2
        }
          L = AREA(NCHC_G)/W
        ]

device c  ( c3si ) NCHCI     NCHCI_G(POS)     NCHCI_A(NEG)   netlist model c3si netlist element "X" [
       property W,L
        NUM = COUNT(NCHCI_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHCI_A,NCHCI_G)
        } ELSE {
          W = PERIMETER_COINCIDE(NCHCI_A,NCHCI_G)/2
        }
          L = AREA(NCHCI_G)/W
        ]

device c  ( c15_npw ) NCHCP15     NCHCP15_G(POS)     NCHCP15_A(NEG)   netlist model c15_npw netlist element "X" [
       property W,L
        NUM = COUNT(NCHCP15_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHCP15_A,NCHCP15_G)
        } ELSE {
          W = PERIMETER_COINCIDE(NCHCP15_A,NCHCP15_G)/2
        }
          L = AREA(NCHCP15_G)/W
        ]

device c  ( c33_npw ) NCHCP33     NCHCP33_G(POS)     NCHCP33_A(NEG)   netlist model c33_npw netlist element "X" [
       property W,L
        NUM = COUNT(NCHCP33_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHCP33_A,NCHCP33_G)
        } ELSE {
          W = PERIMETER_COINCIDE(NCHCP33_A,NCHCP33_G)/2
        } 
          L = AREA(NCHCP33_G)/W
        ]

device c  ( c15_nnw ) NCHC15     NCHC15_G(POS)     NCHC15_A(NEG)   netlist model c15_nnw netlist element "X" [
       property W,L
        NUM = COUNT(NCHC15_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHC15_A,NCHC15_G)
        } ELSE {
          W = PERIMETER_COINCIDE(NCHC15_A,NCHC15_G)/2
        } 
          L = AREA(NCHC15_G)/W
        ]

device c  ( c33_nnw ) NCHC33     NCHC33_G(POS)     NCHC33_A(NEG)   netlist model c33_nnw netlist element "X" [
       property W,L
        NUM = COUNT(NCHC33_A)
        IF (NUM == 1) {
          W = PERIMETER_COINCIDE(NCHC33_A,NCHC33_G)
