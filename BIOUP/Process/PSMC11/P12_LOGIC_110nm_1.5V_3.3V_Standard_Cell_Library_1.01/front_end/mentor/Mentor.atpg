  TD, CK)
(
  input (CN) ( )
  input (D) ( )
  input (SEL) ( )
  input (TD) ( )
  input (CK) ( )
  output (Q) ()
  (
    primitive = _and  mlc_and_1 ( delayed_CN, delayed_D, int_fwire__SE_0 );
    primitive = _buf  mlc_buf_1 ( delayed_TD, int_fwire__SE_1 );
    instance = altos_mux2 ( int_fwire_d, int_fwire__SE_0, int_fwire__SE_1, delayed_SEL );
    instance = altos_dff_err ( xcr_0, delayed_CK, int_fwire_d );
    instance = altos_dff ( int_fwire_IQ, notifier, delayed_CK, int_fwire_d, xcr_0 );
    primitive = _buf  mlc_buf_2 ( int_fwire_IQ, Q );
    primitive = _buf  mlc_buf_3 ( CK, delayed_CK );
    primitive = _buf  mlc_buf_4 ( CN, delayed_CN );
    primitive = _buf  mlc_buf_5 ( D, delayed_D );
    primitive = _buf  mlc_buf_6 ( SEL, delayed_SEL );
    primitive = _buf  mlc_buf_7 ( TD, delayed_TD );
  )
  scan_definition (
    type = mux_scan;
    scan_in = TD;
    scan_out = Q;
    scan_enable = SEL;
    non_scan_model = DFFCNQX4(Q, CN, D, CK);
  )
)

