***************************************************************
***************************************************************
*******    Powerchip Semiconductor Corp. SPICE Model     ******
***************************************************************
***************************************************************
*                                                             *
*   Process        : LOGIC 110nm 3.3V   spice model              *
*   Registered date: June  25,2016                             *
*   Version        : 0.51                                     *
*   Creator        : tchsu               *
*   Notice         : 1.All of mos model is fitting to the  measurement data and then skewed to the target.    *              
*                        2.The N/PMOS models were extracted by BSIMPro+ Ver.2009.4.1 or MBP  Ver.2010.3.0.1 and   *               
*                           verified by HSPICE D-2010.03-SP2, respectively.   *
*                       3.If AD,AS,PD,PS are not given,they will be calculate from DMCG,DMCI in Bsim4.      * 
*  
*******************************************************************************
* 1.In  version(v0.50), spice model fully copy from 2110CI1-021  V1.01
********************************************************************************* 
* 1.In this version(v0.51), modify pdiblc2 ( from 4.3E-3 to 0 ) for HV PMOS model.
********************************************************************************* 
*******************************************************************************   
*                                                                             *
* Model Description                                                           *
*                                                                             *
*  1)Mosfet model name --- hvn,hvp                                    *
*                                                                             *                                                                             
*                                                                             *                                                                                                                                                               
*     Device Description                                                      *                                                                          
*                                                                             *                                                                                      
*        device   description               model_name                              geometry                                             typical device      Vt     Ion   *                                
*       HV NMOS : nmos for 3.3V     hvn          0.28um<= W <=20um,  0.35um<= L <=20um              W/L=10/0.35        0.64     5.5mA*
*       HV PMOS : pmos for 3.3V      hvp          0.28um<= W <=20um,  0.3um<= L <=20um              W/L=10/0.3       -0.6      -2.65mA*                                                                    
*
*  2)Bjt model name --- npn,pnp                                      *
*     Lib bjt : Emitter size 5*5um^2 vertical NPN bipolar            *
*               Emitter size 5*5um^2 vertical PNP bipolar            *
*                                                                    *
*
*                                                                    *
*  3)MOScap model name --- c3s                                                      *
*                                                                                                                                           *
*     Model_name        Description                                               geometry                                  C0                                            *
*                                                                                                                                                                                                       *
*        c3s	                    MOScap (3.3V on Pwell with 3S)           Area=unit size*mf                  4.3E-3  F/m^2  at Vg =3.3V                        *
*                                                                                                   unit size=W*L =16u*16u        mf : Number of unit                  
*
*
*  *) Temperature range :
*      T=-40C ~ 125C
*
*  *)To use these models by using this command:                      *
*     .lib 'lib_path/lib_name' model_name                            *
*                                                                    *
*     EX: .lib '/home/user/psc/logic11_3p3v.lib' TT                         *
*           for typical MOS model                                    *
*     EX: .lib '/home/user/psc/logic11_3p3v.lib' bjt                         *
*           for BJT model                                    *
*     EX: .lib '/home/user/psc/logic11_3p3v.lib' VAR_TT                 
*           for typical MOScap model                                    		*
*******************************************************************************                                              
*******************************************************************************
**************** CORNER_LIB OF TYPICAL MODEL ******************
* Typical  n-channel and p-channel 
.LIB TT
.param



+vth0_hvn=0.664                  vth0_hvp=-0.6667           
+tox_hvn=8.24e-009           tox_hvp=8.72e-009         
+xl_hvn=0                           xl_hvp=0	             
+xw_hvn=0                         xw_hvp=0                         
+vsat_hvn=8.93e4              vsat_hvp=114800              
 	
.lib 'logic11_3p3v.lib' mos

.ENDL TT

**************** CORNER_LIB OF FNFP MODEL ********************************************
* Fast n and p 
.LIB FF
.param



+vth0_hvn=0.578                 vth0_hvp=-0.594       
+tox_hvn=7.94e-009            tox_hvp=8.42e-009           
+xl_hvn=-1.3e-8                   xl_hvp=-1.3e-8	
+xw_hvn=2.8e-8                  xw_hvp=2.8e-8
+vsat_hvn=9.75e4                vsat_hvp=132600

.lib 'logic11_3p3v.lib' mos


.ENDL FF

**************** CORNER_LIB OF SNSP MODEL ******************************************************
