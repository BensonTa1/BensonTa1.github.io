*******************************************************************************

**************************************************************************
*                                                                        *
*                MOScap SPICE Model Sub-Circuit                                        *
*                                                                        *
**************************************************************************
.lib var

***c3s******-3.3<=Vg<=3.3V***
.subckt c3s ng nds l = 16e-6   w = 16e-6    mf = 1          
.param
+Cgmax =cgmax_3s          dCg =   1.088699E-4                          dVgs = -2.710577 
+Vgnorm =  3.029598                 
.param ptc1=2.48E-5 ptc2=0 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'             
c1 ng nds 'mf*l*w*(Cgmax+dCg*(-1.0+tanh((v(ng,nds)-dVgs)/Vgnorm)))*tfac*c3sfac'

.ends c3s

.endl var
***************************************************************************



