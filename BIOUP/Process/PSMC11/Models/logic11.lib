*******    Powerchip Semiconductor Corp. SPICE Model     ******
***************************************************************
***************************************************************
*                                                             *
*   Process        : LOGIC 110nm 1.5V   spice model              *
*   Registered date: Dec  26,2016                             *
*   Version        : 0.51                                     *
*   Creator        : tchsu, ML               *
*   Notice         : 1.All of mos model is fitting to the  measurement data and then skewed to the target.    *              
*                        2.The N/PMOS models were extracted by BSIMPro+ Ver.2009.4.1 or MBP  Ver.2010.3.0.1 and   *               
*                           verified by HSPICE D-2010.03-SP2, respectively.   *
*                       3.If AD,AS,PD,PS are not given,they will be calculate from DMCG,DMCI in Bsim4.      * 
*  
*******************************************************************************
* 1.In  version(v0.50), spice model fully copy from 2110CI1-021  V1.01
********************************************************************************* 
* 1.In this version(v0.51), Skew 1.5V PMOS models ( lvp ) by WAT trend si data in L=Lmin sizes.
********************************************************************************* 
*******************************************************************************   
*                                                                             *
* Model Description                                                           *
*                                                                             *
*  1)Mosfet model name --- lvn,lvp                                  *
*                                                                             *                                                                             
*                                                                             *                                                                                                                                                               
*     Device Description                                                      *                                                                          
*                                                                             *                                                                                      
*        device   description               model_name                              geometry                                             typical device      Vt     Ion   *                                
*       LV NMOS : nmos for 1.5V      lvn           0.28um<= W <=200um, 0.13um<= L <=20um            W/L=10/0.13       0.57    5.2mA*
*       LV PMOS : pmos for 1.5V       lvp          0.28um<= W <=200um, 0.13um<= L <=20um            W/L=10/0.13       -0.59    -2.2mA*                                                               
*
*  2)Diode model name ---nppw,ppnw                                 *
*        device   description               model_name 
*     Lib diode : N+/PW                  nppw                            *
*                      P+/NW                   ppnw                          *
*                                                                    *
*                                                                    *
*  3)Res model name --- rnpoly, rnaa,  rpaa,  rnp,  rpp   	                                        *
*
*      Model_name  	Description                          Bias range  				fitting size geometry		                *
*      rnaa  	N+_AA     	            0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.28/50   	                         *
*      rpaa  	P+_AA     	            0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.28/50   	                         *
*      rnp  	                N+_AA-w/o CoSi               0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.28/50   	                         *
*      rpp  	                P+_AA-w/o CoSi               0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.28/50   	                         *
*
*      rnpoly	N+_Poly     	                 0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.13/50 , 2/50   	                         *  
*      rppoly200	P+_Poly(for W=2u only)        0<=Vf<=3.3V  -40C<=T<=125C	W/L= 2/50   	                         *  
*      rppoly013	P+_Poly(for W=0.13u only)   0<=Vf<=3.3V  -40C<=T<=125C	W/L= 0.13/50   	                         *  
*      rnpolync	N+_Poly-w/o CoSi	                 0<=Vf<=3.3V  -40C<=T<=125C	W/L= 2/50   	                         *  
*      rppolync	P+_Poly-w/o CoSi	                 0<=Vf<=3.3V  -40C<=T<=125C	W/L= 2/50   	                         *  
*
*                                                                    *
*
*
*  *) Temperature range :
*      T=-40C ~ 125C
*
*  *)To use these models by using this command:                      *
*     .lib 'lib_path/lib_name' model_name                            *
*                                                                    *
*     EX: .lib '/home/user/psc/logic11.lib' TT                         *
*           for typical MOS model                                    *
*     EX: .lib '/home/user/psc/logic11.lib' diode                         *
*           for diode model                                    *
*     EX: .lib '/home/user/psc/logic11.lib' RES_TT                         *
*           for typical resistor model                                    *
*******************************************************************************                                              
*******************************************************************************
**************** CORNER_LIB OF TYPICAL MODEL ******************
* Typical  n-channel and p-channel 
.LIB TT
.param

+vth0_lvn=0.4907                  vth0_lvp=-0.55164
+tox_lvn=3.154E-9               tox_lvp=3.62e-009
+xl_lvn=0	             xl_lvp=0
+xw_lvn=0                          xw_lvp=0

            
 	
.lib 'logic11.lib' mos

.ENDL TT

**************** CORNER_LIB OF FNFP MODEL ********************************************
* Fast n and p 
.LIB FF
.param

+vth0_lvn=0.4321                  vth0_lvp=-0.4732  
+tox_lvn=2.954E-9               tox_lvp=3.420e-009
+xl_lvn=-1.3e-8	             xl_lvp=-1.3e-8
+xw_lvn=2.8e-8                  xw_lvp=2.8e-8



.lib 'logic11.lib' mos


.ENDL FF

**************** CORNER_LIB OF SNSP MODEL ******************************************************
* Slow n and p 
.LIB SS
.param

+vth0_lvn=0.5511                 vth0_lvp=-0.6276   
+tox_lvn=3.354E-9             tox_lvp=3.82e-009
+xl_lvn=1.3e-8	             xl_lvp=1.3e-8
+xw_lvn=-2.8e-8                 xw_lvp=-2.8e-8



.lib 'logic11.lib' mos



.ENDL SS

**************** CORNER_LIB OF FNSP MODEL *********************
* Fast N Slow P   
.LIB FS
.param

+vth0_lvn=4.354E-1                vth0_lvp=-0.62485   
+tox_lvn=3.154E-9              tox_lvp=3.620e-009
+xl_lvn=-6.5e-9	              xl_lvp=6.5e-9
+xw_lvn=1.4e-8                   xw_lvp=-1.4e-8

	

.lib 'logic11.lib' mos


.ENDL FS

**************** CORNER_LIB OF SNFP MODEL *********************
* Slow N Fast P    
.LIB SF
.param

+vth0_lvn=0.5472                 vth0_lvp=-0.4776   
+tox_lvn=3.154E-9              tox_lvp=3.620e-009
+xl_lvn=6.5e-9	             xl_lvp=-6.5e-9
+xw_lvn=-1.4e-8                 xw_lvp=1.4e-8



.lib 'logic11.lib' mos

.ENDL SF

