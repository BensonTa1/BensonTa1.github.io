.lib RES_SS
.param
+r_naa = 12.47
+r_paa = 13.47
+r_np = 109.91
+r_pp = 229.5342
+r_npoly = 14.74
+r_ppoly200 = 17.6749
+r_ppoly013=42.6472
+r_npolync= 93.0127
+r_ppolync = 494.7161

.lib 'logic11.lib' RES  
.endl RES_SS

*******************************************************************************

***************************************************************
*                                                             *
*   Resistance SPICE Model Sub-Circuit                        *
*                                                             *
***************************************************************

.lib RES

**N+_AA
.subckt rnaa n1 n2 l=length w=width mf=1
.param rsh=r_naa ptc1=3.2e-3 ptc2=2.0e-6 pvc1=-4.82e-4 pvc2=1.69e-3 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rnaa

**P+_AA
.subckt rpaa n1 n2 l=length w=width mf=1
.param rsh=r_paa ptc1=3.0e-3 ptc2=1.0e-6 pvc1=9.63e-4 pvc2=8.41e-4 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rpaa

**N+_AA-w/o CoSi
.subckt rnp n1 n2 l=length w=width mf=1
.param rsh=r_np ptc1=1.4e-3 ptc2=4.0e-7 pvc1=4.83e-4 pvc2=1.47e-4 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rnp

**P+_AA-w/o CoSi
.subckt rpp n1 n2 l=length w=width mf=1
.param rsh=r_pp ptc1=1.4e-3 ptc2=4.0e-7 pvc1=2.69e-3 pvc2=-4.83e-4 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rpp

**N+_Poly
.subckt rnpoly  n1 n2 l=length w=width mf=1
.param rsh=r_npoly ptc1=2.5E-3 ptc2=7E-7 pvc1= 3.56E-3 pvc2=8.65E-3 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rnpoly

**P+_Poly(for W=2u only) 
.subckt rppoly200 n1 n2 l=length w=width mf=1
.param rsh=r_ppoly200 ptc1=2.4E-3 ptc2=9.0e-6 pvc1= 3.14E-3 pvc2= 9.31E-3 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rppoly200

**P+_Poly(for W=0.13u only)
.subckt rppoly013 n1 n2 l=length w=width mf=1
.param rsh=r_ppoly013 ptc1=2E-3 ptc2=6.0e-7 pvc1= -2.191E-2 pvc2= 1.56E-3 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rppoly013 

**N+_Poly-w/o CoSi
.subckt rnpolync n1 n2 l=length w=width mf=1
.param rsh=r_npolync ptc1=1E-4 ptc2=3E-7 pvc1= -5.25E-4 pvc2= 2.64E-4 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rnpolync 

**P+_Poly-w/o CoSi
.subckt rppolync n1 n2 l=length w=width mf=1
.param rsh=r_ppolync ptc1=-3E-04 ptc2=1E-06 pvc1= 9.41E-04 pvc2= -3.02E-4 pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 '1/mf*l/(w)*(rsh*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1)))*tfac'
.ends rppolync 


.endl RES
*******************************************************************




