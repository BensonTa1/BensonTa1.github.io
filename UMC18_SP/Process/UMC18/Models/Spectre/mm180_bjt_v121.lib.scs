parameters dcjc_pnp_v100x100_mm=1.0000000e+000 
parameters dcje_pnp_v100x100_mm=1.0000000e+000 
//     
include "mm180_bjt_v121.mdl.scs" 
//     
endsection tt_bip 
//     
section ff_bip 
