//  ******************************************************************************  
//  TT: Typical n-ch MOSFET and Typical p-ch MOSFET   
//  FF: Fast n-ch MOSFET and Fast p-ch MOSFET   
//  SS: Slow n-ch MOSFET and Slow p-ch MOSFET   
//  FNSP: Fast n-ch MOSFET and Slow p-ch MOSFET   
//  SNFP: Slow n-ch MOSFET and Fast p-ch MOSFET   
//  ******************************************************************************  
simulator lang=spectre insensitive=yes 
//     
library mylib 
 
section tt_bip 
parameters dis_pnp_v50x50_mm=1.0000000e+000 
parameters dbf_pnp_v50x50_mm=1.0000000e+000 
parameters dnf_pnp_v50x50_mm=1.0000000e+000 
parameters dre_pnp_v50x50_mm=1.0000000e+000 
parameters drc_pnp_v50x50_mm=1.0000000e+000 
