parameters dbf_pnp_v100x100_mm=1.1500000e+000 
parameters dnf_pnp_v100x100_mm=0.9950000e+000 
parameters dre_pnp_v100x100_mm=0.8000000e+000 
parameters drc_pnp_v100x100_mm=0.8000000e+000 
parameters dcjc_pnp_v100x100_mm=0.9000000e+000 
parameters dcje_pnp_v100x100_mm=0.9000000e+000 
//     
include "mm180_bjt_v121.mdl.scs" 
