rsub2 ( 12 40 ) resistor r=p_rsub2
rsub3 ( 31 40 ) resistor r=p_rsub3
rsub1 ( 40 4 ) resistor r=p_rsub1
// 
//  --------- Ideal mos transistor ----------------------
main ( 11 21 30 40 ) bsim_mos_transistor_mos l=3.4e-07 w=5e-06 ad=0 as=0 pd=0 ps=0 m=nf
//  
model bsim_diode_area diode 
+ cj0=0.0007673 *(1+dcj_n_33_rf )           vj=0.7131                 m=0.3299    is=1e-05             n=1                       
// 
model bsim_diode_perim diode 
+ cj0=1.089e-10*(1+ dcjsw_n_33_rf)            vj=0.7131                 m=0.1037    is=5.1e-11           n=1                       
// 
model bsim_diode_swg diode 
+ cj0=2.9e-10 *(1+dcjgate_n_33_rf)            vj=0.7131                 m=0.1037    is=5.1e-11           n=1                       
//
model bsim_mos_transistor_mos bsim3v3 type=n 
+ version=3.2               mobmod=1                  binunit=2
