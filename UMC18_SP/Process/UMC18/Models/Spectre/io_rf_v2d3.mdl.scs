subckt n_l34w500_33_rf ( 1 2 3 4 ) 
parameters nf=21  p_rg= - 7.0913 + 216.04 / nf - 411.06 / (nf * nf) 
+ p_cd=(0.306 +0.1838 * nf + 0.0049 * (nf * nf)) * 1e-15 
+ p_cgs=2e-15 p_ld=1e-11 p_ls=6e-11
+ p_djdb_a=(4.25 * ((nf + 1) / 2)) * 1e-12 
+ p_djdb_p=(1.7 * ((nf + 1) / 2)+5) * 1e-6 
+ p_djdb_g=(5* nf + 5 * nf) * 1e-6 
+ p_djsb_a=(4.25 * ((nf + 1) / 2)) * 1e-12 
+ p_djsb_p=(1.7 * ((nf + 1) / 2)+5) * 1e-6 
+ p_djsb_g=(5* nf + 5 * nf) * 1e-6 
+ p_rsub1=70.9 + 224.53 / nf - 396.9 / (nf * nf) 
+ p_rsub2=2 p_rsub3=2 
// 
//  #### define RF Extension Model Varable #####
// 
// 
//  --------- Gate network ------------------------------
cgs_ext ( 21 30 ) capacitor c=p_cgs*(1+dcgs_n_33_rf)
rgate ( 2 21 ) resistor r=p_rg*(1+drgate_n_33_rf)
// 
//  --------- Drain network -----------------------------
ldrain ( 1 11 ) inductor l=p_ld
lsource ( 30 3 ) inductor l=p_ls
cd ( 11 30 ) capacitor c=p_cd*(1+dcd_n_33_rf)
// 
//  --------- Substrate network -------------------------
// 
djdb_area ( 12 11 ) bsim_diode_area area=p_djdb_a
