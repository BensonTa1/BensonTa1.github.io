+ wwl=-1.502e-21            ldif=0                    lmin=3.4e-07
+ lmax=3.405e-07              wmin=5e-06              wmax=1.05e-04
+ hdif=3.2e-07              lnfactor=1e-07            lu0=0
+ lvsat=-0.0045             lua=0                     lub=0
+ pbsw=0.4347               cta=0.001082              ctp=0.0007482
+ pta=0.001822              ptp=0.002009              elm=5
