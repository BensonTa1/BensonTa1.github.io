+ js=1e-05                  jsw=5.1e-11               tnom=25
+ kt1=-0.3166               kt2=-0.04461              at=500
+ ute=-1.601                ua1=4.203e-11             ub1=3.8e-19
+ uc1=2.8e-11               kt1l=0                    prt=-271.3
+ lln=1                     lwn=1                     wln=1
+ wwn=1                     ll=1.214e-14              lw=0
