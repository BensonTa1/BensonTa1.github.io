simulator lang=spectre insensitive=yes
inline subckt n_18_mm ( d g s b )
parameters w=0u l=0u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ poly_to_cont=0.15e-06 cont_size=0.24e-06 cont_to_diff=0.1e-06
+ a_unit=2*(poly_to_cont+cont_size/2)*w
+ p_unit=2*(2*(poly_to_cont+cont_size/2)+w)
+ a_edge=(poly_to_cont+cont_size+cont_to_diff)*w
+ p_edge=2*((poly_to_cont+cont_size+cont_to_diff)+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_edge) + nf_even*(a_unit*(nf/2-1)+2*a_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_edge) + nf_even*(p_unit*(nf/2-1)+2*p_edge))/nf

parameters beta  = 1.15
parameters compl1	= 2.82842712473244
parameters compl2	= 1.66600046865803e-08
parameters compl3	= 1.92748955350312e-14
parameters compl4	= 2.23942925077789e-19
parameters compl5	= 8.88009231589043e-22
parameters l_factor_n=1/sqrt(2*w*l*mf*1e+12)

parameters  b1_np_18_mm = b1_np_18_mm_xx
parameters  b2_np_18_mm = b2_np_18_mm_xx
parameters  b3_np_18_mm = b3_np_18_mm_xx
parameters  b4_np_18_mm = b4_np_18_mm_xx
parameters  b5_np_18_mm = b5_np_18_mm_xx


parameters  dtox_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dxl_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dxw_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dvth0_n_18_mm_l = beta*(-1.50934588481969e-03*b1_np_18_mm*compl1+-2.2464904079445e-09*b2_np_18_mm*compl2+1.50934588406201e-03*b3_np_18_mm*compl3+4.75535553466563e-08*b4_np_18_mm*compl4+5.35999110421674e-11*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  du0_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dlvth0_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dwvth0_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dwu0_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dpvth0_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dpvsat_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dcgdo_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dcgso_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dcj_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dcjsw_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dcjgate_n_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_n
parameters  dtox_n_18_mm = (global_flag_n_18_mm*dtox_n_18_mm_g  + local_flag_n_18_mm*dtox_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dtox_n_18_mm_t
parameters  dxl_n_18_mm = (global_flag_n_18_mm*dxl_n_18_mm_g  + local_flag_n_18_mm*dxl_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dxl_n_18_mm_t
parameters  dxw_n_18_mm = (global_flag_n_18_mm*dxw_n_18_mm_g  + local_flag_n_18_mm*dxw_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dxw_n_18_mm_t
parameters  dvth0_n_18_mm = (global_flag_n_18_mm*dvth0_n_18_mm_g  + local_flag_n_18_mm*dvth0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dvth0_n_18_mm_t
parameters  du0_n_18_mm = (global_flag_n_18_mm*du0_n_18_mm_g  + local_flag_n_18_mm*du0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*du0_n_18_mm_t
parameters  dlvth0_n_18_mm = (global_flag_n_18_mm*dlvth0_n_18_mm_g  + local_flag_n_18_mm*dlvth0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dlvth0_n_18_mm_t
parameters  dwvth0_n_18_mm = (global_flag_n_18_mm*dwvth0_n_18_mm_g  + local_flag_n_18_mm*dwvth0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dwvth0_n_18_mm_t
parameters  dwu0_n_18_mm = (global_flag_n_18_mm*dwu0_n_18_mm_g  + local_flag_n_18_mm*dwu0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dwu0_n_18_mm_t
parameters  dpvth0_n_18_mm = (global_flag_n_18_mm*dpvth0_n_18_mm_g  + local_flag_n_18_mm*dpvth0_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dpvth0_n_18_mm_t
parameters  dpvsat_n_18_mm = (global_flag_n_18_mm*dpvsat_n_18_mm_g  + local_flag_n_18_mm*dpvsat_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dpvsat_n_18_mm_t
parameters  dcgdo_n_18_mm = (global_flag_n_18_mm*dcgdo_n_18_mm_g  + local_flag_n_18_mm*dcgdo_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dcgdo_n_18_mm_t
parameters  dcgso_n_18_mm = (global_flag_n_18_mm*dcgso_n_18_mm_g  + local_flag_n_18_mm*dcgso_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dcgso_n_18_mm_t
parameters  dcj_n_18_mm = (global_flag_n_18_mm*dcj_n_18_mm_g  + local_flag_n_18_mm*dcj_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dcj_n_18_mm_t
parameters  dcjsw_n_18_mm = (global_flag_n_18_mm*dcjsw_n_18_mm_g  + local_flag_n_18_mm*dcjsw_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dcjsw_n_18_mm_t
parameters  dcjgate_n_18_mm = (global_flag_n_18_mm*dcjgate_n_18_mm_g  + local_flag_n_18_mm*dcjgate_n_18_mm_l)*(1-total_flag_n_18_mm)+ total_flag_n_18_mm*dcjgate_n_18_mm_t
