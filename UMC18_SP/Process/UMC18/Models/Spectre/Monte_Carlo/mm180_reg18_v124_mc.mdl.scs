//
//
//
inline subckt p_18_mm ( d g s b )
parameters w=0u l=0u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ poly_to_cont=0.15e-06 cont_size=0.24e-06 cont_to_diff=0.1e-06
+ a_unit=2*(poly_to_cont+cont_size/2)*w
+ p_unit=2*(2*(poly_to_cont+cont_size/2)+w)
+ a_edge=(poly_to_cont+cont_size+cont_to_diff)*w
+ p_edge=2*((poly_to_cont+cont_size+cont_to_diff)+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_edge) + nf_even*(a_unit*(nf/2-1)+2*a_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_edge) + nf_even*(p_unit*(nf/2-1)+2*p_edge))/nf
//
parameters beta  = 1.15
parameters compl1	= 2.82842712473244
parameters compl2	= 1.66600046865803e-08
parameters compl3	= 1.92748955350312e-14
parameters compl4	= 2.23942925077789e-19
parameters compl5	= 8.88009231589043e-22
parameters l_factor_p=1/sqrt(2*w*l*mf*1e+12)

parameters  b1_np_18_mm = b1_np_18_mm_xx
parameters  b2_np_18_mm = b2_np_18_mm_xx
parameters  b3_np_18_mm = b3_np_18_mm_xx
parameters  b4_np_18_mm = b4_np_18_mm_xx
parameters  b5_np_18_mm = b5_np_18_mm_xx


parameters  dtox_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  du0_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dxl_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dxw_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dvth0_p_18_mm_l = beta*(1.5093458848197e-03*b1_np_18_mm*compl1+-2.24649040796502e-09*b2_np_18_mm*compl2+1.5093458840758e-03*b3_np_18_mm*compl3+4.75535553462514e-08*b4_np_18_mm*compl4+5.35999110422921e-11*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dlvth0_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dwvth0_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dpvth0_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dpvsat_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
parameters  dcgdo_p_18_mm_l = beta*(0*b1_np_18_mm*compl1+0*b2_np_18_mm*compl2+0*b3_np_18_mm*compl3+0*b4_np_18_mm*compl4+0*b5_np_18_mm*compl5)* mis_flag*l_factor_p
