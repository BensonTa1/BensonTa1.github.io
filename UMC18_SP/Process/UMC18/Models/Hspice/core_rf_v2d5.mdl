+ lnfactor = 0.03 pvth0 = '0.0031+ dpvth0_p_18_rf' lnlx = -1.584e-08 wrdsw = 10.07
+ weta0 = 0 wetab = 0 wpclm = 0 wua = 2.7e-09
+ lua = -2.37e-10 pua = 5.855e-11 wub = 0 lub = 0
