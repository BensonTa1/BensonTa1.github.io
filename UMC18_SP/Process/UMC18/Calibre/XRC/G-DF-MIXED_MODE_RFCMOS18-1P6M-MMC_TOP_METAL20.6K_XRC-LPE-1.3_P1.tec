//----- [#USER CONTROL OPTIONS] -----
//   for v2007.3 and later version
//
//1. [#DEFINE $EXCLUDE_PLY_CONT_MODEL]: exclude Cctg
//   [//#DEFINE $EXCLUDE_PLY_CONT_MODEL]: include Cctg
//   Include the source/drain contact to poly gate coupling capacitance. 
//   Note that if users set CCTGFLAG = 1 in MOS SPICE models , the contact to poly gate capacitances have been considered in models , 
//   please adopt this option : #DEFINE $EXCLUDE_PLY_CONT_MODEL. 
//   If users set CCTGFLAG = 0 in MOS SPICE models , the contact to poly gate capacitance haven't been considered in models, 
//   please adopt this option : // #DEFINE $EXCLUDE_PLY_CONT_MODEL
//
//2. [#DEFINE $VIA_COUPLING_MODEL]: turn it on to use new via model which include via/cont coupling capacitance 
//   [//#DEFINE $VIA_COUPLING_MODEL]: turn it off to use old via model which only include via/cont lumped capacitance
//   Define to use old via model (via model of 2006.3 and earlier version) or new via model (via model of 2006.4 and later version ), 
//   the new via model can only be run in 2007.3 and later version   
//
//3. [#DEFINE $RUN_VIA_REDUCTION]:  turn on via reduction model
//   [//#DEFINE $RUN_VIA_REDUCTION]: turn off via reduction model
//   To turn on/off via reduction model and via control command. This is only acceptable 2007.3 and later version.
//
//4. [//#DEFINE $XCAL_EXCL_PROF_diffcap]: turn on diff_cap profile.
//   [#DEFINE $XCAL_EXCL_PROF_diffcap]: turn off diff_cap profile.
//   diffcap profile include the capacitance model for coupling capacitance between
//   diffusion sidewall to other diffusion sidewall and to another conductors.
//   The capcitance between two diffusion under gate region is not included.
//
//5. [//#DEFINE XCAL_EXCL_INDIE]: turn on indie(WEE) model
//   [#DEFINE XCAL_EXCL_INDIE]: turn off indie(WEE) model
//   Turn off Width/Rsh indie(WEE) variation to classic or no-indie(WEE) model is only for
//   speeding up performance before the final design.
//
//6. [#DEFINE $XCAL_MAXD_MODE classic ]: set max_distance as "classic" type
//   [#DEFINE $XCAL_MAXD_MODE maximum ]: set max_distance as "maximum" type
//   [#DEFINE $XCAL_MAXD_MODE smart   ]: set max_distance as "smart" type
//   For ASIC extraction user, use "smart" mode to speed the extraction performance.
//   For IP and circuit design user, use "classic" mode to get more accurate extraction result.
//   This mode option control how far distance will look forward during extraction.   
//   This is for 2007.3 and later. For the rule file created from 2006.4 to 2007.3, the control option should be
//   #define $XCALIBRATE_MAXD_MODE smart [classic] 
//7. [#DEFINE $RUN_XL]: turn on inductance extraction
//   [//#DEFINE $RUN_XL]: turn off inductance extraction
//
    
//********************************************************************
//Via Model control section
//********************************************************************
#DEFINE $EXCLUDE_PLY_CONT_MODEL 
//PEX VIA CAPACITANCE NO 
#DEFINE $VIA_COUPLING_MODEL 
#DEFINE $RUN_VIA_REDUCTION 


//********************************************************************
//General control section
//********************************************************************
#DEFINE $XCAL_EXCL_PROF_diffcap 
//#DEFINE XCAL_EXCL_INDIE  
#define $XCAL_MAXD_MODE classic 
//#DEFINE $RUN_XL

/////////////////////////
// Setup Defaults for PEX
/////////////////////////
//PEX FDB allnets GLOBAL 5000  EXCLUDE SOURCE VCC GND
//PEX BACKANNOTATION DISTRIBUTED NONE
//PEX BACKANNOTATION LUMPED      NONE
//PEX BACKANNOTATION SIMPLE      none
//PEX COUPLED DISTRIBUTED        NO // MASK DIRECT
//PEX DELAY                      none   //PENFIELD 0.7 MASK DIRECT
PEX EXCLUDE DISTRIBUTED        VDD GND VSS VCC VBB MASK DIRECT
PEX EXCLUDE LUMPED             VDD GND VSS VCC VBB MASK DIRECT

PEX INDUCTANCE FREQUENCY 2.6E9 //global frequency setting
PEX INDUCTANCE  RETURNPATH GROUND  //define return path  

//PEX INDUCTANCE LAYOUT net_name FREQUENCY 2E9 //specific nets frequenct setting 
//PEX GROUND LAYOUT VSS //defined the ground node name if the name was not defined in lvs ground
//PEX POWER LAYOUT VDD //dfeined the power node name if the name was not defined in lvs power
//PEX INDUCTANCE DOPROCESS ME1_C ME2_C ME3_C // Defined the only metal layers you want to extract for parasitic inductance


//PEX NETLIST DISTRIBUTED        "net.dist" HSPICE LAYOUT MASK DIRECT LOCATION LOOP
#ifdef $RUN_XL
PEX NETLIST DISTRIBUTED        "net.dist" HSPICE LAYOUT MASK DIRECT LOCATION LOOP RLOCATION RWIDTH RLAYER
#else
PEX NETLIST DISTRIBUTED        "net.dist" HSPICE LAYOUT MASK DIRECT LOCATION LOOP RLOCATION RWIDTH RLAYER
#endif


PEX NETLIST LUMPED             "net.lump" HSPICE LAYOUT MASK DIRECT LOCATION
PEX NETLIST SIMPLE             "net.simple" HSPICE LAYOUT MASK DIRECT LOCATION
PEX REPORT DISTRIBUTED         none  //"report.dist" ASCII LAYOUT MASK DIRECT
PEX REPORT LUMPED              none  //"report.lump" LAYOUT MASK DIRECT
//PEX REDUCE LUMPED C            < 10000000

PEX VIA REDUCTION RESISTANCE FLEXIBLE   // The netlist file size will large if turn on this option .

PEX TEMPERATURE 25 NOMINAL 25 //PEX TEMPERATURE (ELEMENT TEMP.) NOMINAL(ROOM TEMP.)

// =================================================
// ===  Resistance Sheet  [Prop_Cnst, Max_Dist]  ===
// =================================================

RESISTANCE SHEET NSD_C 	        [8.0    0 3.321E-3  3.486E-7]  MASK
RESISTANCE SHEET PSD_C 	        [8.0    0 3.150E-3  2.758E-7]  MASK
RESISTANCE SHEET PLY_C          [8.0    0 3.118E-3 -1.325E-7]  MASK
RESISTANCE SHEET ME1_C          [0.077	0 3.388E-3 -6.295E-7]  MASK
RESISTANCE SHEET ME2_C          [0.062  0 3.407E-3 -5.023E-7]  MASK
RESISTANCE SHEET ME3_C          [0.062  0 3.407E-3 -5.023E-7]  MASK
RESISTANCE SHEET ME4_C          [0.062  0 3.407E-3 -5.023E-7]  MASK
RESISTANCE SHEET SEC_LAST_MET_C [0.062  0 3.407E-3 -5.023E-7]  MASK
RESISTANCE SHEET TOP_M_C        [0.020  0 3.447E-3 -4.051E-7]  MASK
RESISTANCE SHEET MMC_C          [11.5   0 5.000E-4  1.000E-6]  MASK


// ==============================================
// ===  Resistance Connections  [Area, Edge]  ===
// ==============================================
 
RESISTANCE CONNECTION ME1_C          NSD_C          [0.864  0] MASK   // Contact
RESISTANCE CONNECTION ME1_C          PSD_C          [0.864  0] MASK   // Contact
RESISTANCE CONNECTION ME1_C          PLY_C          [0.6912 0] MASK   // Contact
RESISTANCE CONNECTION ME2_C          ME1_C          [0.5096 0] MASK   // Via-1
RESISTANCE CONNECTION ME3_C          ME2_C          [0.5096 0] MASK   // Via-2
RESISTANCE CONNECTION ME4_C          ME3_C          [0.5096 0] MASK   // Via-3
RESISTANCE CONNECTION SEC_LAST_MET_C ME4_C          [0.5096 0] MASK   // Via-4
RESISTANCE CONNECTION TOP_M_C        SEC_LAST_MET_C [0.5096 0] MASK   // Via-5
RESISTANCE CONNECTION TOP_M_C        MMC_C          [0.784  0] MASK   // MMC-Via

CAPACITANCE ORDER NSD_C PSD_C ALLGATES PLY_C ME1_C ME2_C ME3_C ME4_C SEC_LAST_MET_C MMC_DUMMY MMC_C TOP_M_C

#DEFINE $XCAL_INCL_PROF_diffcap_nb1
#DEFINE $XCAL_INCL_PROF_diffcap_nb2

