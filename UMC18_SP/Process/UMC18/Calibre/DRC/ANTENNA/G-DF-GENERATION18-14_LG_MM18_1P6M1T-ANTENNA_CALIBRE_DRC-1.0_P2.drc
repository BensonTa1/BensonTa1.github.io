                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME5 and ME6
     NET AREA RATIO ME6 MMC56_UNBALANCE_CTM_6 > 100
     [PERIMETER(ME6)*MET_TOP_THICK/AREA(MMC56_UNBALANCE_CTM_6)]
     RDB MMC56_CTM_ME6_unbalance.rdb BY LAYER ME6 MMC56_UNBALANCE_CTM_6
}

MMC56_BALANCE_CBM_6 = (MMC56_FLOAT_CBM_6 INTERACT MMC56_FLOAT_CTM_6) OR (MMC56_GROUND_CBM_6 INTERACT MMC56_GROUND_CTM_6)
MMC56_UNBALANCE_CBM_6 = MMC56_FLOAT_CBM_6 INTERACT MMC56_GROUND_CTM_6
CONNECT MMC56_BALANCE_CBM_6 ME5
CONNECT MMC56_UNBALANCE_CBM_6 ME5

MMC56_BALANCE_ME6_6 = NET AREA RATIO ME6 MMC56_BALANCE_CBM_6 > 0
MMC56_UNBALANCE_ME6_6 = NET AREA RATIO ME6 MMC56_UNBALANCE_CBM_6 > 0

M56_MMC_ANT.3.2.1A_CBM_ME6{ @ Maximum Ratio of Metal_6 (M6 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
