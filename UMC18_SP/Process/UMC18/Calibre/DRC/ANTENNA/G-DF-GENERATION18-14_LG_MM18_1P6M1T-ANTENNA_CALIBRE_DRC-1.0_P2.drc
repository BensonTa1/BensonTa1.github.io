/////////////////////////
// ME6 Antenna check   //
/////////////////////////
CONNECT ME6 M56_MMC ME5 BY VI5
DIODE_ME6 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME6 BY CONT

ME6_WITHOUT_DIODE    =  NET AREA RATIO ME6 DIODE_ME6 == 0 // ME6 DO NOT CONNECT WITH DIODE
ME6_WITH_DIODE       =  NET AREA RATIO ME6 DIODE_ME6 > 0   // ME6 CONNECT WITH DIODE

ANT.3.1.1D.ME6 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME6_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME6_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME6.sum   
   
     NET AREA RATIO ME6_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME6_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)]
     RDB ANT.3.1.1D.ME6.rdb BY LAYER ME6_WITHOUT_DIODE GATE
}

ANT.3.1.2B.ME6 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 1
               [PERIMETER(ME6_WITH_DIODE)*MET_TOP_THICK / (AREA(GATE)*(20000+400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.2B.ME6.sum
   
     NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 1
           [PERIMETER(ME6_WITH_DIODE)*MET_TOP_THICK / (AREA(GATE)*(20000+400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA  
     RDB ANT.3.1.2B.ME6.rdb BY LAYER ME6_WITH_DIODE GATE DIODE_ME6  

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
}

ME6_CA = NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 0
         [PERIMETER(ME6_WITH_DIODE)*MET_TOP_THICK / (AREA(GATE)*(20000+ 400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA // GATE ME1 to ME6 ACCUMULATE


// Start the ME6 Ratio rule of MMC between ME5 and ME6 //

MMC56_FLOAT_CBM_6 = NET AREA RATIO ME5 SUB == 0
MMC56_FLOAT_CTM_6 = NET AREA RATIO M56_MMC SUB == 0
MMC56_GROUND_CBM_6 = NET AREA RATIO ME5 SUB > 0
MMC56_GROUND_CTM_6 = NET AREA RATIO M56_MMC SUB > 0

MMC56_BALANCE_CTM_6 = (MMC56_FLOAT_CTM_6 AND MMC56_FLOAT_CBM_6) OR (MMC56_GROUND_CTM_6 AND MMC56_GROUND_CBM_6)
MMC56_UNBALANCE_CTM_6 = MMC56_FLOAT_CTM_6 AND MMC56_GROUND_CBM_6
CONNECT MMC56_BALANCE_CTM_6 M56_MMC
CONNECT MMC56_UNBALANCE_CTM_6 M56_MMC

M56_MMC_ANT.3.2.1A_CTM_ME6{ @ Maximum Ratio of Metal_6 (M6 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME5 and ME6
     NET AREA RATIO ME6 MMC56_BALANCE_CTM_6 > 6000
     [PERIMETER(ME6)*MET_TOP_THICK/AREA(MMC56_BALANCE_CTM_6)]
     RDB MMC56_CTM_ME6_balance.rdb BY LAYER ME6 MMC56_BALANCE_CTM_6
}

