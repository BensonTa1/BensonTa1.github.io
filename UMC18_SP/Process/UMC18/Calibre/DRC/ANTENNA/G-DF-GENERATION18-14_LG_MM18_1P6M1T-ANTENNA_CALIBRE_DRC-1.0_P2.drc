     [PERIMETER(MMC56_BALANCE_ME6_6)*MET_TOP_THICK/AREA(f_M56_MMC)]
     RDB MMC56_CBM_ME6_balance.rdb BY LAYER MMC56_BALANCE_ME6_6 f_M56_MMC
}

