//NOTES ( Important, Read Me First )
//   DRC command file aims to help users detect layout error. 
//   Please study TLR rules in detail and follow them in advance before drawing these layouts.
//   Finally, please use DRC command file to reconfirm whole layouts.
// =========================================================================================
// 1. Please set correct value for RESOLUTION, LAYOUT SYSTEM, 
//    LAYOUT PATH, LAYOUT PRIMARY, make sure layer numbers in LAYER 
//    DECLARATIONS section are correct before run drc.
// 2. Increment Connection is used in this antenna check, it can be run flat or 
//    hierarchical(Calibre July,99 release or late version for hierarchical run), 
//    but do NOT inlude or integrate it into basic drc command file that has normal 
//    CONNECT commands.
// 3. It should be avoided if the different nets connected to the same diode
// 4. This document includes the following file.
//    G-DF-GENERATION18-14_LG_MM18_1P6M1T-ANTENNA_CALIBRE_DRC-1.0_P2
//    Application_Note_GENERATION18_14-ANTENNA-CALIBRE-DRC-1.0_P2.pdf
//    Release_Note_GENERATION18_14-ANTENNA-CALIBRE-DRC-1.0_P2.pdf
//==================================================================================
// revision           date             who               changes                             
//=============  =============  =================  =================================================
// 1.0_P1         2020/06/05     Charlene/Yu Ming    1.New creation
// 1.0_P2         2020/10/16     Charlene            1.Add: M12_MMC_ANT.3.2.1?_CTM_ME7,
//                                                          M12_MMC_ANT.3.2.1?_CBM_ME7,
//                                                          M12_MMC_ANT.3.2.1?_CTM_ME6,
//                                                          M12_MMC_ANT.3.2.1?_CTM_VI6,
//                                                          M12_MMC_ANT.3.2.1?_CBM_ME6,
//                                                          M12_MMC_ANT.3.2.1?_CBM_VI6  
//
// ===============================================================================
//===========================
//===  Setup Environment  ===
//===========================
LAYOUT DEPTH  ALL
LAYOUT SYSTEM GDSII
RESOLUTION 1
PRECISION  1000
UNIT CAPACITANCE FF
UNIT LENGTH      U
UNIT RESISTANCE  OHM
UNIT TIME        US
FLAG ACUTE   YES
FLAG OFFGRID YES
FLAG SKEW    YES

//================================
//===  Setup Defaults for DRC  ===
//================================
LAYOUT PATH "test.gds"
LAYOUT PRIMARY "*"
DRC SUMMARY REPORT "test.sum"
DRC RESULTS DATABASE "test.db" ASCII
DRC CHECK TEXT       COMMENTS RFI
DRC KEEP EMPTY       NO
DRC MAXIMUM RESULTS  1000
DRC MAXIMUM VERTEX   4096
DRC TOLERANCE FACTOR .0005
DRC TOLERANCE FACTOR NAR 0

//=========================================================
// The related variables.
// Please change the related items to your requirement.
// e.g. If you want to change the thickness of Top Metal.
//      Please prefix  "//" to Top_Metal_0.8 and then 
//      remove "//" from Top_Metal_1.2.
//   From:
//    #DEFINE Top_Metal_0.8    //Default - Top Metal thickness
//    //#DEFINE Top_Metal_1.2
//    //#DEFINE Top_Metal_4
//   To:
//    //#DEFINE Top_Metal_0.8    //Default - Top Metal thickness
//    #DEFINE Top_Metal_1.2
//    //#DEFINE Top_Metal_4
//=========================================================
VARIABLE POLY_THICK 0.2    //Poly1 thickness
VARIABLE ME1_THICK 0.4    //ME1 thickness
VARIABLE MET_IN_THIN 0.5    //Thin Metal thickness
VARIABLE MET_IN_THICK 0.5    //Thick Metal thickness

//#DEFINE Top_Metal_0.8    //Default - Top Metal thickness
//#DEFINE Top_Metal_1.2
#DEFINE Top_Metal_2

VARIABLE DIO_AREA       0.1936  // Diode Area


// ** OUTPUT TYPE OPTION: Show whole net / show gate only
 #DEFINE SHOW_WHOLE_NET   // This option for showing whole net metal if any violations are found.

#IFDEF SHOW_WHOLE_NET
OUTPUT_MARKER = COPY BULK
#ELSE 
OUTPUT_MARKER = COPY NULL
#ENDIF

//=================================================================
// Please do not modify the following configuration of Thickness.
//=================================================================

#IFDEF Top_Metal_0.8
#UNDEFINE Top_Metal_1.2
#UNDEFINE Top_Metal_2
VARIABLE MET_TOP_THICK 0.8
#ELSE
#IFDEF Top_Metal_1.2
#UNDEFINE Top_Metal_0.8
#UNDEFINE Top_Metal_2
VARIABLE MET_TOP_THICK 1.2
#ELSE
#IFDEF Top_Metal_2
#UNDEFINE Top_Metal_0.8
#UNDEFINE Top_Metal_1.2
VARIABLE MET_TOP_THICK 2
#ELSE
#DEFINE Top_Metal_0.8
VARIABLE MET_TOP_THICK 0.8
#ENDIF
#ENDIF
#ENDIF

//===========================
// MMC variable 
//===========================
NULL = NWEL NOT BULK
#DEFINE M56_MMC    //Default
//#DEFINE M45_MMC
//#DEFINE M34_MMC
//#DEFINE M23_MMC
//#DEFINE M12_MMC


GROUP M56_MMC_rule  M56_MMC_?
GROUP M45_MMC_rule  M45_MMC_?
GROUP M34_MMC_rule  M34_MMC_?
GROUP M23_MMC_rule  M23_MMC_?
GROUP M12_MMC_rule  M12_MMC_?
#IFDEF M56_MMC
M56_MMC = COPY MMC
M45_MMC = COPY NULL
M34_MMC = COPY NULL
M23_MMC = COPY NULL
M12_MMC = COPY NULL
#UNDEFINE M45_MMC
#UNDEFINE M34_MMC
#UNDEFINE M23_MMC
#UNDEFINE M12_MMC
DRC UNSELECT CHECK M45_MMC_rule
DRC UNSELECT CHECK M34_MMC_rule
DRC UNSELECT CHECK M23_MMC_rule
DRC UNSELECT CHECK M12_MMC_rule
#ELSE
#IFDEF M45_MMC
M45_MMC = COPY MMC
M34_MMC = COPY NULL
M23_MMC = COPY NULL
M12_MMC = COPY NULL
M56_MMC = COPY NULL
#UNDEFINE M34_MMC
#UNDEFINE M23_MMC
#UNDEFINE M12_MMC
#UNDEFINE M56_MMC
DRC UNSELECT CHECK M34_MMC_rule
DRC UNSELECT CHECK M23_MMC_rule
DRC UNSELECT CHECK M12_MMC_rule
DRC UNSELECT CHECK M56_MMC_rule
#ELSE
#IFDEF M34_MMC
M34_MMC = COPY MMC
M23_MMC = COPY NULL
M12_MMC = COPY NULL
M56_MMC = COPY NULL
M45_MMC = COPY NULL
#UNDEFINE M23_MMC
#UNDEFINE M12_MMC
#UNDEFINE M56_MMC
#UNDEFINE M45_MMC
DRC UNSELECT CHECK M23_MMC_rule
DRC UNSELECT CHECK M12_MMC_rule
DRC UNSELECT CHECK M56_MMC_rule
DRC UNSELECT CHECK M45_MMC_rule
#ELSE
#IFDEF M23_MMC
M23_MMC = COPY MMC
M12_MMC = COPY NULL
M56_MMC = COPY NULL
M45_MMC = COPY NULL
M34_MMC = COPY NULL
#UNDEFINE M12_MMC
#UNDEFINE M56_MMC
#UNDEFINE M45_MMC
#UNDEFINE M34_MMC
DRC UNSELECT CHECK M12_MMC_rule
DRC UNSELECT CHECK M56_MMC_rule
DRC UNSELECT CHECK M45_MMC_rule
DRC UNSELECT CHECK M34_MMC_rule
#ELSE
#IFDEF M12_MMC
M12_MMC = COPY MMC
M56_MMC = COPY NULL
M45_MMC = COPY NULL
M34_MMC = COPY NULL
M23_MMC = COPY NULL
#UNDEFINE M56_MMC
#UNDEFINE M45_MMC
#UNDEFINE M34_MMC
#UNDEFINE M23_MMC
DRC UNSELECT CHECK M56_MMC_rule
DRC UNSELECT CHECK M45_MMC_rule
DRC UNSELECT CHECK M34_MMC_rule
DRC UNSELECT CHECK M23_MMC_rule
#ELSE
#DEFINE M56_MMC    //Default
M56_MMC = COPY MMC
M45_MMC = COPY NULL
M34_MMC = COPY NULL
M23_MMC = COPY NULL
M12_MMC = COPY NULL
DRC UNSELECT CHECK M45_MMC_rule
DRC UNSELECT CHECK M34_MMC_rule
DRC UNSELECT CHECK M23_MMC_rule
DRC UNSELECT CHECK M12_MMC_rule
#ENDIF
#ENDIF
#ENDIF
#ENDIF
#ENDIF

//////////////////////////////////////////////
// INPUT LAYER STATEMENTS
//////////////////////////////////////////////

LAYER MAP 1 DATATYPE 0 1001
LAYER DIFF  1001  // Diffusion

LAYER MAP 3 DATATYPE 0 1002
LAYER NWEL  1002  // N-well

LAYER MAP 11 DATATYPE 0 1003
LAYER PPLUS  1003  // P+ Imp

LAYER MAP 12 DATATYPE 0 1004
LAYER NPLUS  1004  // N+ Imp

LAYER MAP 39 DATATYPE 0 1005
LAYER CONT  1005  // Contact

LAYER MAP 41 DATATYPE 0 1006
LAYER PO1  1006  // Poly1

LAYER MAP 46 DATATYPE 0 1007
LAYER ME1  1007  // Metal1

LAYER MAP 47 DATATYPE 0 1008
LAYER VI1  1008  // Mvia1

LAYER MAP 48 DATATYPE 0 1009
LAYER ME2  1009  // Metal2

LAYER MAP 49 DATATYPE 0 1010
LAYER VI2  1010  // Mvia2

LAYER MAP 50 DATATYPE 0 1011
LAYER ME3  1011  // Metal3

LAYER MAP 51 DATATYPE 0 1012
LAYER VI3  1012  // Mvia3

LAYER MAP 52 DATATYPE 0 1013
LAYER ME4  1013  // Metal4

LAYER MAP 53 DATATYPE 0 1014
LAYER VI4  1014  // Mvia4

LAYER MAP 54 DATATYPE 0 1015
LAYER ME5  1015  // Metal5

LAYER MAP 55 DATATYPE 0 1016
LAYER VI5  1016  // Mvia5

LAYER MAP 56 DATATYPE 0 1017
LAYER ME6  1017  // Metal6

LAYER MAP 57 DATATYPE 0 1018
LAYER VI6  1018  // Mvia6

LAYER MAP 58 DATATYPE 0 1019
LAYER ME7  1019  // Metal7

LAYER MAP 65 DATATYPE 0 1020
LAYER MMCTP  1020  // Metal Cap (top Plate)

MMC = COPY MMCTP

// define well regions

DRC:1     =  EXTENT DRAWN ORIGINAL
BULK      =  SIZE DRC:1 BY 1.0

// define diffusion regions

GATE      =  PO1           AND         DIFF

// Define Diode region
// These definations are commented by EHV18 TLR owner: Wen Feng/Lee.

DIODE = ((DIFF AND PPLUS) OR (DIFF AND NPLUS)) NOT GATE

SUB = (BULK AND DIFF) NOT PO1


/////////////////////////
//  Poly Antenna check //
////////////////////////

// Antenna check //

DRC INCREMENTAL CONNECT YES

CONNECT PO1 GATE

ANT.3.1.1A { @ Maximum Ratio of POLY1 sidewall area to gate atea is 100, without protection diode
    PO1_RATIO = NET AREA RATIO PO1 GATE > 100
                [PERIMETER(PO1)*POLY_THICK/AREA(GATE)]
    E = NET AREA RATIO PO1 GATE > 100 ACCUMULATE
        [PERIMETER(PO1)*POLY_THICK/AREA(GATE)]
    COPY E   
    NET AREA RATIO PRINT E ANT.3.1.1A.sum
      
    NET AREA RATIO PO1 GATE > 100
    [PERIMETER(PO1)*POLY_THICK/AREA(GATE)]  
    RDB ANT.3.1.1A.rdb BY LAYER PO1 GATE     

    PO1_RATIO AND OUTPUT_MARKER
}

f_CONT = BULK AND CONT
CONNECT PO1 f_CONT

ANT.3.1.1B { @ Maximum ratio of Contact area to gate area is 10.
                  @ Without protection diode
     CT_RATIO = NET AREA RATIO f_CONT GATE > 10
     E = NET AREA RATIO f_CONT GATE > 10 ACCUMULATE 
     COPY E            
     NET AREA RATIO PRINT E ANT.3.1.1B.sum    
      
     NET AREA RATIO f_CONT GATE > 10    
     RDB ANT.3.1.1B.rdb BY LAYER f_CONT GATE  

     CT_RATIO AND OUTPUT_MARKER   
}


/////////////////////////
// ME1 Antenna check   //
/////////////////////////

CONNECT ME1 PO1 BY CONT
CONNECT ME1 DIODE BY CONT
CONNECT ME1 SUB BY CONT
DIODE_ME1 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME1 BY CONT

ME1_WITHOUT_DIODE      = NET AREA RATIO ME1 DIODE_ME1 == 0   // ME1 NOT CONNECT WITH DIODE 
ME1_WITH_DIODE         = NET AREA RATIO ME1 DIODE_ME1 > 0    // ME1 CONNECT WITH DIODE 

ANT.3.1.1D.ME1 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME1_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME1_WITHOUT_DIODE)*ME1_THICK/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME1.sum   
   
     NET AREA RATIO ME1_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME1_WITHOUT_DIODE)*ME1_THICK/AREA(GATE)]
     RDB ANT.3.1.1D.ME1.rdb BY LAYER ME1_WITHOUT_DIODE GATE
}


ANT.3.1.2B.ME1 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME1_WITH_DIODE OVER GATE DIODE_ME1 > 1
               [PERIMETER(ME1_WITH_DIODE)*ME1_THICK / (AREA(GATE)*(20000+400*AREA(DIODE_ME1)))]  ACCUMULATE   
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.2B.ME1.sum
 
     NET AREA RATIO ME1_WITH_DIODE OVER GATE DIODE_ME1 > 1
           [PERIMETER(ME1_WITH_DIODE)*ME1_THICK / (AREA(GATE)*(20000+400*AREA(DIODE_ME1)))]   
     RDB ANT.3.1.2B.ME1.rdb BY LAYER ME1_WITH_DIODE GATE DIODE_ME1    

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1 
     NET AREA RATIO ME1 E_STAMP > 0
}

ME1_CA = NET AREA RATIO ME1_WITH_DIODE OVER GATE DIODE_ME1 > 0
         [PERIMETER(ME1_WITH_DIODE)*ME1_THICK / (AREA(GATE)*(20000+400*AREA(DIODE_ME1)))] ACCUMULATE // GATE ME1 ACCUMULATE


/////////////////////////
// VI1 Antenna check   //
/////////////////////////

f_VI1 = BULK AND VI1
CONNECT ME1 f_VI1

VI1_WITHOUT_DIODE = NET AREA RATIO f_VI1 DIODE_ME1 ==0	// VIA1 DO NOT CONNECT WITH DIODE_ME1
VI1_WITH_DIODE    = f_VI1 INTERACT ( NET AREA RATIO f_VI1 DIODE_ME1 > 0 )   // f_VI1 CONNECT WITH DIODE
CONNECT f_VI1 VI1_WITHOUT_DIODE
CONNECT f_VI1 VI1_WITH_DIODE 

ANT.3.1.1C.VI1 { @ Maximum ratio of VIA1 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI1_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1C.VI1.sum
   
     NET AREA RATIO VI1_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.3.1.1C.VI1.rdb BY LAYER VI1_WITHOUT_DIODE GATE   
}

ANT.3.1.1E.VI1 { @ Maximum ratio of cumulative VIA1 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI1_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1E.VI1.sum
   
     NET AREA RATIO VI1_WITHOUT_DIODE OVER GATE > 30 
     RDB ONLY ANT.3.1.1E.VI1.rdb BY LAYER VI1_WITHOUT_DIODE GATE   

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP > 0
}


ANT.3.1.2A.VI1 { @ Maximum ratio of VIA1 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
     E = NET AREA RATIO VI1_WITH_DIODE OVER GATE DIODE_ME1 > 1 ACCUMULATE
             [AREA(VI1_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME1)))] 
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.2A.VI1.sum
   
     NET AREA RATIO VI1_WITH_DIODE OVER GATE DIODE_ME1 > 1 
         [AREA(VI1_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME1)))] 
     RDB ANT.3.1.2A.VI1.rdb BY LAYER VI1_WITH_DIODE GATE DIODE_ME1   

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1 
     NET AREA RATIO f_VI1 E_STAMP >0  
}

ANT.3.1.2.Note2.VI1 { @ Maximum ratio of VIA1 area (cumulative) to gate area is 1200 area.
     E = NET AREA RATIO f_VI1 OVER GATE  > 1200 ACCUMULATE
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.2.Note2.VI1.sum
   
     NET AREA RATIO f_VI1 OVER GATE > 1200 
     RDB ONLY ANT.3.1.2.Note2.VI1.rdb BY LAYER f_VI1 GATE    

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1 
     NET AREA RATIO f_VI1 E_STAMP >0  
}

VI1_all_CA =  NET AREA RATIO f_VI1 OVER GATE > 0 ACCUMULATE
VI1_CA = NET AREA RATIO VI1_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE // GATE VI1 ACCUMULATE without diode
VI1_CA_WD = NET AREA RATIO VI1_WITH_DIODE OVER GATE DIODE_ME1 > 0
            [AREA(VI1_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME1)))] ACCUMULATE // GATE VI1 ACCUMULATE with diode

// Start the VI1 Ratio rule of MMC between ME1 and ME2

M12_MMC_ANT.3.2.1D_CBM_VI1{ @ Maximum Ratio of MVIA_1 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME1 and ME2
MMC12_FLOAT_ME1 = NET AREA RATIO ME1 SUB == 0
MMC12_ON_FLOAT_ME1 = DFM PROPERTY MMC12_FLOAT_ME1 M12_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M12_MMC)] > 0
MMC12_VI1 = (NET AREA RATIO f_VI1 MMC12_FLOAT_ME1 > 0) NOT M12_MMC
MMC12_FLOAT_VI1 = DFM PROPERTY MMC12_FLOAT_ME1 MMC12_VI1 MMC12_ON_FLOAT_ME1 NODAL MULTI
                               [VI1_AREA = AREA(MMC12_VI1)] > 0
                               [MMC_AREA = PROPERTY(MMC12_ON_FLOAT_ME1,MMC_AREA)] > 0

  P = DFM PROPERTY MMC12_FLOAT_ME1 M12_MMC MMC12_FLOAT_VI1 OVERLAP MULTI
      [check = AREA(M12_MMC)] > 0
      [CBM_VI1_AREA = PROPERTY(MMC12_FLOAT_VI1,VI1_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC12_FLOAT_VI1,MMC_AREA)] > 0
      [VI1_RATIO = PROPERTY(MMC12_FLOAT_VI1,VI1_AREA)/PROPERTY(MMC12_FLOAT_VI1,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC12_CBM_VI1_balance.rdb
}
/////////////////////////
// ME2 Antenna check   //
/////////////////////////
CONNECT ME2 M12_MMC ME1 BY VI1
DIODE_ME2 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME2 BY CONT

ME2_WITHOUT_DIODE    =  NET AREA RATIO ME2 DIODE_ME2 == 0 // ME2 DO NOT CONNECT WITH DIODE
ME2_WITH_DIODE       =  NET AREA RATIO ME2 DIODE_ME2 > 0   // ME2 CONNECT WITH DIODE

ANT.3.1.1D.ME2 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME2_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME2_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME2.sum   
   
     NET AREA RATIO ME2_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME2_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     RDB ANT.3.1.1D.ME2.rdb BY LAYER ME2_WITHOUT_DIODE GATE
}

ANT.3.1.2B.ME2 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME2_WITH_DIODE OVER GATE DIODE_ME2 > 1
               [PERIMETER(ME2_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME2)))] ACCUMULATE ME1_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.2B.ME2.sum
   
     NET AREA RATIO ME2_WITH_DIODE OVER GATE DIODE_ME2 > 1
           [PERIMETER(ME2_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME2)))] ACCUMULATE ME1_CA  
     RDB ANT.3.1.2B.ME2.rdb BY LAYER ME2_WITH_DIODE GATE DIODE_ME2
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
}

ME2_CA = NET AREA RATIO ME2_WITH_DIODE OVER GATE DIODE_ME2 > 0
         [PERIMETER(ME2_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+ 400*AREA(DIODE_ME2)))] ACCUMULATE ME1_CA // GATE ME1 to ME2 ACCUMULATE


/////////////////////////
// VI2 Antenna check   //
/////////////////////////

f_VI2 = BULK AND VI2
CONNECT ME2 f_VI2

VI2_WITHOUT_DIODE = NET AREA RATIO f_VI2 DIODE_ME2 ==0	// VIA2 DO NOT CONNECT WITH DIODE
VI2_WITH_DIODE    = NET AREA RATIO f_VI2 DIODE_ME2 > 0  // VIA2 CONNECT WITH DIODE

ANT.3.1.1C.VI2 { @ Maximum ratio of VIA2 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI2_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1C.VI2.sum
   
     NET AREA RATIO VI2_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.3.1.1C.VI2.rdb BY LAYER VI2_WITHOUT_DIODE GATE   
}

ANT.3.1.1E.VI2 { @ Maximum ratio of cumulative VIA2 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI2_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI1_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.1E.VI2.sum
   
     NET AREA RATIO VI2_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI1_CA 
     RDB ANT.3.1.1E.VI2.rdb BY LAYER VI2_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
}

ANT.3.1.2A.VI2 { @ Maximum ratio of VIA2 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI2_WITH_DIODE OVER GATE DIODE_ME2 >1
             [AREA(VI2_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME2)))]  ACCUMULATE VI1_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2A.VI2.sum
   
   NET AREA RATIO VI2_WITH_DIODE OVER GATE DIODE_ME2 >1
         [AREA(VI2_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME2)))]  ACCUMULATE VI1_CA_WD   
   RDB  ANT.3.1.2A.VI2.rdb  BY LAYER  VI2_WITH_DIODE  GATE DIODE_ME2 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
}

ANT.3.1.2.Note2.VI2 { @ Maximum ratio of VIA2 area (cumulative) to gate area is 1200 area.
   E = NET AREA RATIO f_VI2 OVER GATE  > 1200 ACCUMULATE VI1_all_CA
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2.Note2.VI2.sum
   
   NET AREA RATIO f_VI2 OVER GATE > 1200 ACCUMULATE VI1_all_CA   
   RDB ONLY ANT.3.1.2.Note2.VI2.rdb  BY LAYER  f_VI2  GATE  

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
}

VI2_all_CA = NET AREA RATIO f_VI2 OVER GATE > 0 ACCUMULATE VI1_all_CA
VI2_CA = NET AREA RATIO VI2_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI1_CA // GATE VI1 to VI2 ACCUMULATE without diode
VI2_CA_WD = NET AREA RATIO VI2_WITH_DIODE OVER GATE DIODE_ME2 > 0
            [AREA(VI2_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME2)))] ACCUMULATE VI1_CA_WD // GATE VI1 to VI2 ACCUMULATE with diode

// Start the VI2 Ratio rule of MMC between ME2 and ME3

M23_MMC_ANT.3.2.1D_CBM_VI2{ @ Maximum Ratio of MVIA_2 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME2 and ME3
MMC23_FLOAT_ME2 = NET AREA RATIO ME2 SUB == 0
MMC23_ON_FLOAT_ME2 = DFM PROPERTY MMC23_FLOAT_ME2 M23_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M23_MMC)] > 0
MMC23_VI2 = (NET AREA RATIO f_VI2 MMC23_FLOAT_ME2 > 0) NOT M23_MMC
MMC23_FLOAT_VI2 = DFM PROPERTY MMC23_FLOAT_ME2 MMC23_VI2 MMC23_ON_FLOAT_ME2 NODAL MULTI
                               [VI2_AREA = AREA(MMC23_VI2)] > 0
                               [MMC_AREA = PROPERTY(MMC23_ON_FLOAT_ME2,MMC_AREA)] > 0

  P = DFM PROPERTY MMC23_FLOAT_ME2 M23_MMC MMC23_FLOAT_VI2 OVERLAP MULTI
      [check = AREA(M23_MMC)] > 0
      [CBM_VI2_AREA = PROPERTY(MMC23_FLOAT_VI2,VI2_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC23_FLOAT_VI2,MMC_AREA)] > 0
      [VI2_RATIO = PROPERTY(MMC23_FLOAT_VI2,VI2_AREA)/PROPERTY(MMC23_FLOAT_VI2,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC23_CBM_VI2_balance.rdb
}

// Start the ME2 & VIA2 Ratio rule of MMC between ME1 and ME2 //

MMC12_FLOAT_CBM_2 = NET AREA RATIO ME1 SUB == 0
MMC12_FLOAT_CTM_2 = NET AREA RATIO M12_MMC SUB == 0
MMC12_GROUND_CBM_2 = NET AREA RATIO ME1 SUB > 0
MMC12_GROUND_CTM_2 = NET AREA RATIO M12_MMC SUB > 0

MMC12_BALANCE_CTM_2 = (MMC12_FLOAT_CTM_2 AND MMC12_FLOAT_CBM_2) OR (MMC12_GROUND_CTM_2 AND MMC12_GROUND_CBM_2)
MMC12_UNBALANCE_CTM_2 = MMC12_FLOAT_CTM_2 AND MMC12_GROUND_CBM_2
CONNECT MMC12_BALANCE_CTM_2 M12_MMC
CONNECT MMC12_UNBALANCE_CTM_2 M12_MMC

M12_MMC_ANT.3.2.1A_CTM_ME2{ @ Maximum Ratio of Metal_2 (M2 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME2 MMC12_BALANCE_CTM_2 > 6000
     [PERIMETER(ME2)*MET_IN_THIN/AREA(MMC12_BALANCE_CTM_2)]
     RDB MMC12_CTM_ME2_balance.rdb BY LAYER ME2 MMC12_BALANCE_CTM_2
}

M12_MMC_ANT.3.2.1C_CTM_ME2{ @ Maximum Ratio of Metal_2 (M2 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME2 MMC12_UNBALANCE_CTM_2 > 100
     [PERIMETER(ME2)*MET_IN_THIN/AREA(MMC12_UNBALANCE_CTM_2)]
     RDB MMC12_CTM_ME2_unbalance.rdb BY LAYER ME2 MMC12_UNBALANCE_CTM_2
}

M12_MMC_ANT.3.2.1D_CTM_VI2{ @ Maximum Ratio of MVIA_2 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI2 MMC12_BALANCE_CTM_2 > 20
     RDB MMC12_CTM_VI2_balance.rdb BY LAYER f_VI2 MMC12_BALANCE_CTM_2
}

M12_MMC_ANT.3.2.1F_CTM_VI2{ @ Maximum Ratio of MVIA_2 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI2 MMC12_UNBALANCE_CTM_2 > 10
     RDB MMC12_CTM_VI2_unbalance.rdb BY LAYER f_VI2 MMC12_UNBALANCE_CTM_2
}

MMC12_BALANCE_CBM_2 = (MMC12_FLOAT_CBM_2 INTERACT MMC12_FLOAT_CTM_2) OR (MMC12_GROUND_CBM_2 INTERACT MMC12_GROUND_CTM_2) 
MMC12_UNBALANCE_CBM_2 = MMC12_FLOAT_CBM_2 INTERACT MMC12_GROUND_CTM_2                                                                      
CONNECT MMC12_BALANCE_CBM_2 ME1                                                                                                                           
CONNECT MMC12_UNBALANCE_CBM_2 ME1                                                                                                                         
                                                                                                                                                                      
MMC12_BALANCE_ME2_2 = NET AREA RATIO ME2 MMC12_BALANCE_CBM_2 > 0                                                                              
MMC12_UNBALANCE_ME2_2 = NET AREA RATIO ME2 MMC12_UNBALANCE_CBM_2 > 0
MMC12_BALANCE_VI2_2 = NET AREA RATIO f_VI2 MMC12_BALANCE_CBM_2 > 0
MMC12_UNBALANCE_VI2_2 = NET AREA RATIO f_VI2 MMC12_UNBALANCE_CBM_2 > 0

M12_MMC_ANT.3.2.1A_CBM_ME2{ @ Maximum Ratio of Metal_2 (M2 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_ME2_2 f_M12_MMC > 6000
     [PERIMETER(MMC12_BALANCE_ME2_2)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME2_balance.rdb BY LAYER MMC12_BALANCE_ME2_2 f_M12_MMC
}

M12_MMC_ANT.3.2.1B_CBM_ME2{ @ Maximum Ratio of Metal_2 (M2 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_ME2_2 f_M12_MMC > 100
     [PERIMETER(MMC12_UNBALANCE_ME2_2)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME2_unbalance.rdb BY LAYER MMC12_UNBALANCE_ME2_2 f_M12_MMC
}

M12_MMC_ANT.3.2.1D_CBM_VI2{ @ Maximum Ratio of MVIA_2 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_VI2_2 f_M12_MMC > 20
     RDB MMC12_CBM_VI2_balance.rdb BY LAYER MMC12_BALANCE_VI2_2 f_M12_MMC
}

M12_MMC_ANT.3.2.1E_CBM_VI2{ @ Maximum Ratio of MVIA_2 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_VI2_2 f_M12_MMC > 10
     RDB MMC12_CBM_VI2_unbalance.rdb BY LAYER MMC12_UNBALANCE_VI2_2 f_M12_MMC
}
/////////////////////////
// ME3 Antenna check   //
/////////////////////////
CONNECT ME3 M23_MMC ME2 BY VI2
DIODE_ME3 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME3 BY CONT

ME3_WITHOUT_DIODE    =  NET AREA RATIO ME3 DIODE_ME3 == 0 // ME3 DO NOT CONNECT WITH DIODE
ME3_WITH_DIODE       =  NET AREA RATIO ME3 DIODE_ME3 > 0   // ME3 CONNECT WITH DIODE

ANT.3.1.1D.ME3 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME3_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME3_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME3.sum   
   
     NET AREA RATIO ME3_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME3_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     RDB ANT.3.1.1D.ME3.rdb BY LAYER ME3_WITHOUT_DIODE GATE
}

ANT.3.1.2B.ME3 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME3_WITH_DIODE OVER GATE DIODE_ME3 > 1
               [PERIMETER(ME3_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME3)))] ACCUMULATE ME2_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.2B.ME3.sum
   
     NET AREA RATIO ME3_WITH_DIODE OVER GATE DIODE_ME3 > 1
           [PERIMETER(ME3_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME3)))] ACCUMULATE ME2_CA  
     RDB ANT.3.1.2B.ME3.rdb BY LAYER ME3_WITH_DIODE GATE DIODE_ME3
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
}

ME3_CA = NET AREA RATIO ME3_WITH_DIODE OVER GATE DIODE_ME3 > 0
         [PERIMETER(ME3_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+ 400*AREA(DIODE_ME3)))] ACCUMULATE ME2_CA // GATE ME1 to ME3 ACCUMULATE


/////////////////////////
// VI3 Antenna check   //
/////////////////////////

f_VI3 = BULK AND VI3
CONNECT ME3 f_VI3

VI3_WITHOUT_DIODE = NET AREA RATIO f_VI3 DIODE_ME3 ==0	// VIA3 DO NOT CONNECT WITH DIODE
VI3_WITH_DIODE    = NET AREA RATIO f_VI3 DIODE_ME3 > 0  // VIA3 CONNECT WITH DIODE

ANT.3.1.1C.VI3 { @ Maximum ratio of VIA3 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI3_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1C.VI3.sum
   
     NET AREA RATIO VI3_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.3.1.1C.VI3.rdb BY LAYER VI3_WITHOUT_DIODE GATE   
}

ANT.3.1.1E.VI3 { @ Maximum ratio of cumulative VIA3 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI3_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI2_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.1E.VI3.sum
   
     NET AREA RATIO VI3_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI2_CA 
     RDB ANT.3.1.1E.VI3.rdb BY LAYER VI3_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
}

ANT.3.1.2A.VI3 { @ Maximum ratio of VIA3 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI3_WITH_DIODE OVER GATE DIODE_ME3 >1
             [AREA(VI3_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME3)))]  ACCUMULATE VI2_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2A.VI3.sum
   
   NET AREA RATIO VI3_WITH_DIODE OVER GATE DIODE_ME3 >1
         [AREA(VI3_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME3)))]  ACCUMULATE VI2_CA_WD   
   RDB  ANT.3.1.2A.VI3.rdb  BY LAYER  VI3_WITH_DIODE  GATE DIODE_ME3 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
}

ANT.3.1.2.Note2.VI3 { @ Maximum ratio of VIA3 area (cumulative) to gate area is 1200 area.
   E = NET AREA RATIO f_VI3 OVER GATE  > 1200 ACCUMULATE VI2_all_CA
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2.Note2.VI3.sum
   
   NET AREA RATIO f_VI3 OVER GATE > 1200 ACCUMULATE VI2_all_CA   
   RDB ONLY ANT.3.1.2.Note2.VI3.rdb  BY LAYER  f_VI3  GATE  

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
}

VI3_all_CA = NET AREA RATIO f_VI3 OVER GATE > 0 ACCUMULATE VI2_all_CA
VI3_CA = NET AREA RATIO VI3_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI2_CA // GATE VI1 to VI3 ACCUMULATE without diode
VI3_CA_WD = NET AREA RATIO VI3_WITH_DIODE OVER GATE DIODE_ME3 > 0
            [AREA(VI3_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME3)))] ACCUMULATE VI2_CA_WD // GATE VI1 to VI3 ACCUMULATE with diode

// Start the VI3 Ratio rule of MMC between ME3 and ME4

M34_MMC_ANT.3.2.1D_CBM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME3 and ME4
MMC34_FLOAT_ME3 = NET AREA RATIO ME3 SUB == 0
MMC34_ON_FLOAT_ME3 = DFM PROPERTY MMC34_FLOAT_ME3 M34_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M34_MMC)] > 0
MMC34_VI3 = (NET AREA RATIO f_VI3 MMC34_FLOAT_ME3 > 0) NOT M34_MMC
MMC34_FLOAT_VI3 = DFM PROPERTY MMC34_FLOAT_ME3 MMC34_VI3 MMC34_ON_FLOAT_ME3 NODAL MULTI
                               [VI3_AREA = AREA(MMC34_VI3)] > 0
                               [MMC_AREA = PROPERTY(MMC34_ON_FLOAT_ME3,MMC_AREA)] > 0

  P = DFM PROPERTY MMC34_FLOAT_ME3 M34_MMC MMC34_FLOAT_VI3 OVERLAP MULTI
      [check = AREA(M34_MMC)] > 0
      [CBM_VI3_AREA = PROPERTY(MMC34_FLOAT_VI3,VI3_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC34_FLOAT_VI3,MMC_AREA)] > 0
      [VI3_RATIO = PROPERTY(MMC34_FLOAT_VI3,VI3_AREA)/PROPERTY(MMC34_FLOAT_VI3,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC34_CBM_VI3_balance.rdb
}

// Start the ME3 & VIA3 Ratio rule of MMC between ME2 and ME3 //

MMC23_FLOAT_CBM_3 = NET AREA RATIO ME2 SUB == 0
MMC23_FLOAT_CTM_3 = NET AREA RATIO M23_MMC SUB == 0
MMC23_GROUND_CBM_3 = NET AREA RATIO ME2 SUB > 0
MMC23_GROUND_CTM_3 = NET AREA RATIO M23_MMC SUB > 0

MMC23_BALANCE_CTM_3 = (MMC23_FLOAT_CTM_3 AND MMC23_FLOAT_CBM_3) OR (MMC23_GROUND_CTM_3 AND MMC23_GROUND_CBM_3)
MMC23_UNBALANCE_CTM_3 = MMC23_FLOAT_CTM_3 AND MMC23_GROUND_CBM_3
CONNECT MMC23_BALANCE_CTM_3 M23_MMC
CONNECT MMC23_UNBALANCE_CTM_3 M23_MMC

M23_MMC_ANT.3.2.1A_CTM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO ME3 MMC23_BALANCE_CTM_3 > 6000
     [PERIMETER(ME3)*MET_IN_THIN/AREA(MMC23_BALANCE_CTM_3)]
     RDB MMC23_CTM_ME3_balance.rdb BY LAYER ME3 MMC23_BALANCE_CTM_3
}

M23_MMC_ANT.3.2.1C_CTM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO ME3 MMC23_UNBALANCE_CTM_3 > 100
     [PERIMETER(ME3)*MET_IN_THIN/AREA(MMC23_UNBALANCE_CTM_3)]
     RDB MMC23_CTM_ME3_unbalance.rdb BY LAYER ME3 MMC23_UNBALANCE_CTM_3
}

M23_MMC_ANT.3.2.1D_CTM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO f_VI3 MMC23_BALANCE_CTM_3 > 20
     RDB MMC23_CTM_VI3_balance.rdb BY LAYER f_VI3 MMC23_BALANCE_CTM_3
}

M23_MMC_ANT.3.2.1F_CTM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO f_VI3 MMC23_UNBALANCE_CTM_3 > 10
     RDB MMC23_CTM_VI3_unbalance.rdb BY LAYER f_VI3 MMC23_UNBALANCE_CTM_3
}

MMC23_BALANCE_CBM_3 = (MMC23_FLOAT_CBM_3 INTERACT MMC23_FLOAT_CTM_3) OR (MMC23_GROUND_CBM_3 INTERACT MMC23_GROUND_CTM_3) 
MMC23_UNBALANCE_CBM_3 = MMC23_FLOAT_CBM_3 INTERACT MMC23_GROUND_CTM_3                                                                      
CONNECT MMC23_BALANCE_CBM_3 ME2                                                                                                                           
CONNECT MMC23_UNBALANCE_CBM_3 ME2                                                                                                                         
                                                                                                                                                                      
MMC23_BALANCE_ME3_3 = NET AREA RATIO ME3 MMC23_BALANCE_CBM_3 > 0                                                                              
MMC23_UNBALANCE_ME3_3 = NET AREA RATIO ME3 MMC23_UNBALANCE_CBM_3 > 0
MMC23_BALANCE_VI3_3 = NET AREA RATIO f_VI3 MMC23_BALANCE_CBM_3 > 0
MMC23_UNBALANCE_VI3_3 = NET AREA RATIO f_VI3 MMC23_UNBALANCE_CBM_3 > 0

M23_MMC_ANT.3.2.1A_CBM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_BALANCE_ME3_3 f_M23_MMC > 6000
     [PERIMETER(MMC23_BALANCE_ME3_3)*MET_IN_THIN/AREA(f_M23_MMC)]
     RDB MMC23_CBM_ME3_balance.rdb BY LAYER MMC23_BALANCE_ME3_3 f_M23_MMC
}

M23_MMC_ANT.3.2.1B_CBM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_UNBALANCE_ME3_3 f_M23_MMC > 100
     [PERIMETER(MMC23_UNBALANCE_ME3_3)*MET_IN_THIN/AREA(f_M23_MMC)]
     RDB MMC23_CBM_ME3_unbalance.rdb BY LAYER MMC23_UNBALANCE_ME3_3 f_M23_MMC
}

M23_MMC_ANT.3.2.1D_CBM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_BALANCE_VI3_3 f_M23_MMC > 20
     RDB MMC23_CBM_VI3_balance.rdb BY LAYER MMC23_BALANCE_VI3_3 f_M23_MMC
}

M23_MMC_ANT.3.2.1E_CBM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_UNBALANCE_VI3_3 f_M23_MMC > 10
     RDB MMC23_CBM_VI3_unbalance.rdb BY LAYER MMC23_UNBALANCE_VI3_3 f_M23_MMC
}

// Start the ME3 & VIA3 Ratio rule of MMC between ME1 and ME2 //

MMC12_FLOAT_CBM_3 = NET AREA RATIO ME1 SUB == 0
MMC12_FLOAT_CTM_3 = NET AREA RATIO M12_MMC SUB == 0
MMC12_GROUND_CBM_3 = NET AREA RATIO ME1 SUB > 0
MMC12_GROUND_CTM_3 = NET AREA RATIO M12_MMC SUB > 0

MMC12_BALANCE_CTM_3 = (MMC12_FLOAT_CTM_3 AND MMC12_FLOAT_CBM_3) OR (MMC12_GROUND_CTM_3 AND MMC12_GROUND_CBM_3)
MMC12_UNBALANCE_CTM_3 = MMC12_FLOAT_CTM_3 AND MMC12_GROUND_CBM_3
CONNECT MMC12_BALANCE_CTM_3 M12_MMC
CONNECT MMC12_UNBALANCE_CTM_3 M12_MMC

M12_MMC_ANT.3.2.1A_CTM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME3 MMC12_BALANCE_CTM_3 > 6000
     [PERIMETER(ME3)*MET_IN_THIN/AREA(MMC12_BALANCE_CTM_3)]
     RDB MMC12_CTM_ME3_balance.rdb BY LAYER ME3 MMC12_BALANCE_CTM_3
}

M12_MMC_ANT.3.2.1C_CTM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME3 MMC12_UNBALANCE_CTM_3 > 100
     [PERIMETER(ME3)*MET_IN_THIN/AREA(MMC12_UNBALANCE_CTM_3)]
     RDB MMC12_CTM_ME3_unbalance.rdb BY LAYER ME3 MMC12_UNBALANCE_CTM_3
}

M12_MMC_ANT.3.2.1D_CTM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI3 MMC12_BALANCE_CTM_3 > 20
     RDB MMC12_CTM_VI3_balance.rdb BY LAYER f_VI3 MMC12_BALANCE_CTM_3
}

M12_MMC_ANT.3.2.1F_CTM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI3 MMC12_UNBALANCE_CTM_3 > 10
     RDB MMC12_CTM_VI3_unbalance.rdb BY LAYER f_VI3 MMC12_UNBALANCE_CTM_3
}

MMC12_BALANCE_CBM_3 = (MMC12_FLOAT_CBM_3 INTERACT MMC12_FLOAT_CTM_3) OR (MMC12_GROUND_CBM_3 INTERACT MMC12_GROUND_CTM_3) 
MMC12_UNBALANCE_CBM_3 = MMC12_FLOAT_CBM_3 INTERACT MMC12_GROUND_CTM_3                                                                      
CONNECT MMC12_BALANCE_CBM_3 ME1                                                                                                                           
CONNECT MMC12_UNBALANCE_CBM_3 ME1                                                                                                                         
                                                                                                                                                                      
MMC12_BALANCE_ME3_3 = NET AREA RATIO ME3 MMC12_BALANCE_CBM_3 > 0                                                                              
MMC12_UNBALANCE_ME3_3 = NET AREA RATIO ME3 MMC12_UNBALANCE_CBM_3 > 0
MMC12_BALANCE_VI3_3 = NET AREA RATIO f_VI3 MMC12_BALANCE_CBM_3 > 0
MMC12_UNBALANCE_VI3_3 = NET AREA RATIO f_VI3 MMC12_UNBALANCE_CBM_3 > 0

M12_MMC_ANT.3.2.1A_CBM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_ME3_3 f_M12_MMC > 6000
     [PERIMETER(MMC12_BALANCE_ME3_3)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME3_balance.rdb BY LAYER MMC12_BALANCE_ME3_3 f_M12_MMC
}

M12_MMC_ANT.3.2.1B_CBM_ME3{ @ Maximum Ratio of Metal_3 (M3 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_ME3_3 f_M12_MMC > 100
     [PERIMETER(MMC12_UNBALANCE_ME3_3)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME3_unbalance.rdb BY LAYER MMC12_UNBALANCE_ME3_3 f_M12_MMC
}

M12_MMC_ANT.3.2.1D_CBM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_VI3_3 f_M12_MMC > 20
     RDB MMC12_CBM_VI3_balance.rdb BY LAYER MMC12_BALANCE_VI3_3 f_M12_MMC
}

M12_MMC_ANT.3.2.1E_CBM_VI3{ @ Maximum Ratio of MVIA_3 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_VI3_3 f_M12_MMC > 10
     RDB MMC12_CBM_VI3_unbalance.rdb BY LAYER MMC12_UNBALANCE_VI3_3 f_M12_MMC
}
/////////////////////////
// ME4 Antenna check   //
/////////////////////////
CONNECT ME4 M34_MMC ME3 BY VI3
DIODE_ME4 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME4 BY CONT

ME4_WITHOUT_DIODE    =  NET AREA RATIO ME4 DIODE_ME4 == 0 // ME4 DO NOT CONNECT WITH DIODE
ME4_WITH_DIODE       =  NET AREA RATIO ME4 DIODE_ME4 > 0   // ME4 CONNECT WITH DIODE

ANT.3.1.1D.ME4 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME4_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME4_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME4.sum   
   
     NET AREA RATIO ME4_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME4_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     RDB ANT.3.1.1D.ME4.rdb BY LAYER ME4_WITHOUT_DIODE GATE
}

ANT.3.1.2B.ME4 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME4_WITH_DIODE OVER GATE DIODE_ME4 > 1
               [PERIMETER(ME4_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME4)))] ACCUMULATE ME3_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.2B.ME4.sum
   
     NET AREA RATIO ME4_WITH_DIODE OVER GATE DIODE_ME4 > 1
           [PERIMETER(ME4_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME4)))] ACCUMULATE ME3_CA  
     RDB ANT.3.1.2B.ME4.rdb BY LAYER ME4_WITH_DIODE GATE DIODE_ME4
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
}

ME4_CA = NET AREA RATIO ME4_WITH_DIODE OVER GATE DIODE_ME4 > 0
         [PERIMETER(ME4_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+ 400*AREA(DIODE_ME4)))] ACCUMULATE ME3_CA // GATE ME1 to ME4 ACCUMULATE


/////////////////////////
// VI4 Antenna check   //
/////////////////////////

f_VI4 = BULK AND VI4
CONNECT ME4 f_VI4

VI4_WITHOUT_DIODE = NET AREA RATIO f_VI4 DIODE_ME4 ==0	// VIA4 DO NOT CONNECT WITH DIODE
VI4_WITH_DIODE    = NET AREA RATIO f_VI4 DIODE_ME4 > 0  // VIA4 CONNECT WITH DIODE

ANT.3.1.1C.VI4 { @ Maximum ratio of VIA4 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI4_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1C.VI4.sum
   
     NET AREA RATIO VI4_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.3.1.1C.VI4.rdb BY LAYER VI4_WITHOUT_DIODE GATE   
}

ANT.3.1.1E.VI4 { @ Maximum ratio of cumulative VIA4 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI4_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI3_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.1E.VI4.sum
   
     NET AREA RATIO VI4_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI3_CA 
     RDB ANT.3.1.1E.VI4.rdb BY LAYER VI4_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
       NET AREA RATIO f_VI4 E_STAMP >0
}

ANT.3.1.2A.VI4 { @ Maximum ratio of VIA4 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI4_WITH_DIODE OVER GATE DIODE_ME4 >1
             [AREA(VI4_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME4)))]  ACCUMULATE VI3_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2A.VI4.sum
   
   NET AREA RATIO VI4_WITH_DIODE OVER GATE DIODE_ME4 >1
         [AREA(VI4_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME4)))]  ACCUMULATE VI3_CA_WD   
   RDB  ANT.3.1.2A.VI4.rdb  BY LAYER  VI4_WITH_DIODE  GATE DIODE_ME4 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
}

ANT.3.1.2.Note2.VI4 { @ Maximum ratio of VIA4 area (cumulative) to gate area is 1200 area.
   E = NET AREA RATIO f_VI4 OVER GATE  > 1200 ACCUMULATE VI3_all_CA
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2.Note2.VI4.sum
   
   NET AREA RATIO f_VI4 OVER GATE > 1200 ACCUMULATE VI3_all_CA   
   RDB ONLY ANT.3.1.2.Note2.VI4.rdb  BY LAYER  f_VI4  GATE  

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
}

VI4_all_CA = NET AREA RATIO f_VI4 OVER GATE > 0 ACCUMULATE VI3_all_CA
VI4_CA = NET AREA RATIO VI4_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI3_CA // GATE VI1 to VI4 ACCUMULATE without diode
VI4_CA_WD = NET AREA RATIO VI4_WITH_DIODE OVER GATE DIODE_ME4 > 0
            [AREA(VI4_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME4)))] ACCUMULATE VI3_CA_WD // GATE VI1 to VI4 ACCUMULATE with diode

// Start the VI4 Ratio rule of MMC between ME4 and ME5

M45_MMC_ANT.3.2.1D_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME4 and ME5
MMC45_FLOAT_ME4 = NET AREA RATIO ME4 SUB == 0
MMC45_ON_FLOAT_ME4 = DFM PROPERTY MMC45_FLOAT_ME4 M45_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M45_MMC)] > 0
MMC45_VI4 = (NET AREA RATIO f_VI4 MMC45_FLOAT_ME4 > 0) NOT M45_MMC
MMC45_FLOAT_VI4 = DFM PROPERTY MMC45_FLOAT_ME4 MMC45_VI4 MMC45_ON_FLOAT_ME4 NODAL MULTI
                               [VI4_AREA = AREA(MMC45_VI4)] > 0
                               [MMC_AREA = PROPERTY(MMC45_ON_FLOAT_ME4,MMC_AREA)] > 0

  P = DFM PROPERTY MMC45_FLOAT_ME4 M45_MMC MMC45_FLOAT_VI4 OVERLAP MULTI
      [check = AREA(M45_MMC)] > 0
      [CBM_VI4_AREA = PROPERTY(MMC45_FLOAT_VI4,VI4_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC45_FLOAT_VI4,MMC_AREA)] > 0
      [VI4_RATIO = PROPERTY(MMC45_FLOAT_VI4,VI4_AREA)/PROPERTY(MMC45_FLOAT_VI4,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC45_CBM_VI4_balance.rdb
}

// Start the ME4 & VIA4 Ratio rule of MMC between ME3 and ME4 //

MMC34_FLOAT_CBM_4 = NET AREA RATIO ME3 SUB == 0
MMC34_FLOAT_CTM_4 = NET AREA RATIO M34_MMC SUB == 0
MMC34_GROUND_CBM_4 = NET AREA RATIO ME3 SUB > 0
MMC34_GROUND_CTM_4 = NET AREA RATIO M34_MMC SUB > 0

MMC34_BALANCE_CTM_4 = (MMC34_FLOAT_CTM_4 AND MMC34_FLOAT_CBM_4) OR (MMC34_GROUND_CTM_4 AND MMC34_GROUND_CBM_4)
MMC34_UNBALANCE_CTM_4 = MMC34_FLOAT_CTM_4 AND MMC34_GROUND_CBM_4
CONNECT MMC34_BALANCE_CTM_4 M34_MMC
CONNECT MMC34_UNBALANCE_CTM_4 M34_MMC

M34_MMC_ANT.3.2.1A_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME3 and ME4
     NET AREA RATIO ME4 MMC34_BALANCE_CTM_4 > 6000
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC34_BALANCE_CTM_4)]
     RDB MMC34_CTM_ME4_balance.rdb BY LAYER ME4 MMC34_BALANCE_CTM_4
}

M34_MMC_ANT.3.2.1C_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME3 and ME4
     NET AREA RATIO ME4 MMC34_UNBALANCE_CTM_4 > 100
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC34_UNBALANCE_CTM_4)]
     RDB MMC34_CTM_ME4_unbalance.rdb BY LAYER ME4 MMC34_UNBALANCE_CTM_4
}

M34_MMC_ANT.3.2.1D_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME3 and ME4
     NET AREA RATIO f_VI4 MMC34_BALANCE_CTM_4 > 20
     RDB MMC34_CTM_VI4_balance.rdb BY LAYER f_VI4 MMC34_BALANCE_CTM_4
}

M34_MMC_ANT.3.2.1F_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME3 and ME4
     NET AREA RATIO f_VI4 MMC34_UNBALANCE_CTM_4 > 10
     RDB MMC34_CTM_VI4_unbalance.rdb BY LAYER f_VI4 MMC34_UNBALANCE_CTM_4
}

MMC34_BALANCE_CBM_4 = (MMC34_FLOAT_CBM_4 INTERACT MMC34_FLOAT_CTM_4) OR (MMC34_GROUND_CBM_4 INTERACT MMC34_GROUND_CTM_4) 
MMC34_UNBALANCE_CBM_4 = MMC34_FLOAT_CBM_4 INTERACT MMC34_GROUND_CTM_4                                                                      
CONNECT MMC34_BALANCE_CBM_4 ME3                                                                                                                           
CONNECT MMC34_UNBALANCE_CBM_4 ME3                                                                                                                         
                                                                                                                                                                      
MMC34_BALANCE_ME4_4 = NET AREA RATIO ME4 MMC34_BALANCE_CBM_4 > 0                                                                              
MMC34_UNBALANCE_ME4_4 = NET AREA RATIO ME4 MMC34_UNBALANCE_CBM_4 > 0
MMC34_BALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC34_BALANCE_CBM_4 > 0
MMC34_UNBALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC34_UNBALANCE_CBM_4 > 0

M34_MMC_ANT.3.2.1A_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME3 and ME4
     f_M34_MMC = STAMP M34_MMC BY ME3   
     NET AREA RATIO MMC34_BALANCE_ME4_4 f_M34_MMC > 6000
     [PERIMETER(MMC34_BALANCE_ME4_4)*MET_IN_THIN/AREA(f_M34_MMC)]
     RDB MMC34_CBM_ME4_balance.rdb BY LAYER MMC34_BALANCE_ME4_4 f_M34_MMC
}

M34_MMC_ANT.3.2.1B_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME3 and ME4
     f_M34_MMC = STAMP M34_MMC BY ME3   
     NET AREA RATIO MMC34_UNBALANCE_ME4_4 f_M34_MMC > 100
     [PERIMETER(MMC34_UNBALANCE_ME4_4)*MET_IN_THIN/AREA(f_M34_MMC)]
     RDB MMC34_CBM_ME4_unbalance.rdb BY LAYER MMC34_UNBALANCE_ME4_4 f_M34_MMC
}

M34_MMC_ANT.3.2.1D_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME3 and ME4
     f_M34_MMC = STAMP M34_MMC BY ME3   
     NET AREA RATIO MMC34_BALANCE_VI4_4 f_M34_MMC > 20
     RDB MMC34_CBM_VI4_balance.rdb BY LAYER MMC34_BALANCE_VI4_4 f_M34_MMC
}

M34_MMC_ANT.3.2.1E_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME3 and ME4
     f_M34_MMC = STAMP M34_MMC BY ME3   
     NET AREA RATIO MMC34_UNBALANCE_VI4_4 f_M34_MMC > 10
     RDB MMC34_CBM_VI4_unbalance.rdb BY LAYER MMC34_UNBALANCE_VI4_4 f_M34_MMC
}

// Start the ME4 & VIA4 Ratio rule of MMC between ME2 and ME3 //

MMC23_FLOAT_CBM_4 = NET AREA RATIO ME2 SUB == 0
MMC23_FLOAT_CTM_4 = NET AREA RATIO M23_MMC SUB == 0
MMC23_GROUND_CBM_4 = NET AREA RATIO ME2 SUB > 0
MMC23_GROUND_CTM_4 = NET AREA RATIO M23_MMC SUB > 0

MMC23_BALANCE_CTM_4 = (MMC23_FLOAT_CTM_4 AND MMC23_FLOAT_CBM_4) OR (MMC23_GROUND_CTM_4 AND MMC23_GROUND_CBM_4)
MMC23_UNBALANCE_CTM_4 = MMC23_FLOAT_CTM_4 AND MMC23_GROUND_CBM_4
CONNECT MMC23_BALANCE_CTM_4 M23_MMC
CONNECT MMC23_UNBALANCE_CTM_4 M23_MMC

M23_MMC_ANT.3.2.1A_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO ME4 MMC23_BALANCE_CTM_4 > 6000
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC23_BALANCE_CTM_4)]
     RDB MMC23_CTM_ME4_balance.rdb BY LAYER ME4 MMC23_BALANCE_CTM_4
}

M23_MMC_ANT.3.2.1C_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO ME4 MMC23_UNBALANCE_CTM_4 > 100
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC23_UNBALANCE_CTM_4)]
     RDB MMC23_CTM_ME4_unbalance.rdb BY LAYER ME4 MMC23_UNBALANCE_CTM_4
}

M23_MMC_ANT.3.2.1D_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO f_VI4 MMC23_BALANCE_CTM_4 > 20
     RDB MMC23_CTM_VI4_balance.rdb BY LAYER f_VI4 MMC23_BALANCE_CTM_4
}

M23_MMC_ANT.3.2.1F_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME2 and ME3
     NET AREA RATIO f_VI4 MMC23_UNBALANCE_CTM_4 > 10
     RDB MMC23_CTM_VI4_unbalance.rdb BY LAYER f_VI4 MMC23_UNBALANCE_CTM_4
}

MMC23_BALANCE_CBM_4 = (MMC23_FLOAT_CBM_4 INTERACT MMC23_FLOAT_CTM_4) OR (MMC23_GROUND_CBM_4 INTERACT MMC23_GROUND_CTM_4) 
MMC23_UNBALANCE_CBM_4 = MMC23_FLOAT_CBM_4 INTERACT MMC23_GROUND_CTM_4                                                                      
CONNECT MMC23_BALANCE_CBM_4 ME2                                                                                                                           
CONNECT MMC23_UNBALANCE_CBM_4 ME2                                                                                                                         
                                                                                                                                                                      
MMC23_BALANCE_ME4_4 = NET AREA RATIO ME4 MMC23_BALANCE_CBM_4 > 0                                                                              
MMC23_UNBALANCE_ME4_4 = NET AREA RATIO ME4 MMC23_UNBALANCE_CBM_4 > 0
MMC23_BALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC23_BALANCE_CBM_4 > 0
MMC23_UNBALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC23_UNBALANCE_CBM_4 > 0

M23_MMC_ANT.3.2.1A_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_BALANCE_ME4_4 f_M23_MMC > 6000
     [PERIMETER(MMC23_BALANCE_ME4_4)*MET_IN_THIN/AREA(f_M23_MMC)]
     RDB MMC23_CBM_ME4_balance.rdb BY LAYER MMC23_BALANCE_ME4_4 f_M23_MMC
}

M23_MMC_ANT.3.2.1B_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_UNBALANCE_ME4_4 f_M23_MMC > 100
     [PERIMETER(MMC23_UNBALANCE_ME4_4)*MET_IN_THIN/AREA(f_M23_MMC)]
     RDB MMC23_CBM_ME4_unbalance.rdb BY LAYER MMC23_UNBALANCE_ME4_4 f_M23_MMC
}

M23_MMC_ANT.3.2.1D_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_BALANCE_VI4_4 f_M23_MMC > 20
     RDB MMC23_CBM_VI4_balance.rdb BY LAYER MMC23_BALANCE_VI4_4 f_M23_MMC
}

M23_MMC_ANT.3.2.1E_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME2 and ME3
     f_M23_MMC = STAMP M23_MMC BY ME2   
     NET AREA RATIO MMC23_UNBALANCE_VI4_4 f_M23_MMC > 10
     RDB MMC23_CBM_VI4_unbalance.rdb BY LAYER MMC23_UNBALANCE_VI4_4 f_M23_MMC
}

// Start the ME4 & VIA4 Ratio rule of MMC between ME1 and ME2 //

MMC12_FLOAT_CBM_4 = NET AREA RATIO ME1 SUB == 0
MMC12_FLOAT_CTM_4 = NET AREA RATIO M12_MMC SUB == 0
MMC12_GROUND_CBM_4 = NET AREA RATIO ME1 SUB > 0
MMC12_GROUND_CTM_4 = NET AREA RATIO M12_MMC SUB > 0

MMC12_BALANCE_CTM_4 = (MMC12_FLOAT_CTM_4 AND MMC12_FLOAT_CBM_4) OR (MMC12_GROUND_CTM_4 AND MMC12_GROUND_CBM_4)
MMC12_UNBALANCE_CTM_4 = MMC12_FLOAT_CTM_4 AND MMC12_GROUND_CBM_4
CONNECT MMC12_BALANCE_CTM_4 M12_MMC
CONNECT MMC12_UNBALANCE_CTM_4 M12_MMC

M12_MMC_ANT.3.2.1A_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME4 MMC12_BALANCE_CTM_4 > 6000
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC12_BALANCE_CTM_4)]
     RDB MMC12_CTM_ME4_balance.rdb BY LAYER ME4 MMC12_BALANCE_CTM_4
}

M12_MMC_ANT.3.2.1C_CTM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO ME4 MMC12_UNBALANCE_CTM_4 > 100
     [PERIMETER(ME4)*MET_IN_THIN/AREA(MMC12_UNBALANCE_CTM_4)]
     RDB MMC12_CTM_ME4_unbalance.rdb BY LAYER ME4 MMC12_UNBALANCE_CTM_4
}

M12_MMC_ANT.3.2.1D_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI4 MMC12_BALANCE_CTM_4 > 20
     RDB MMC12_CTM_VI4_balance.rdb BY LAYER f_VI4 MMC12_BALANCE_CTM_4
}

M12_MMC_ANT.3.2.1F_CTM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME1 and ME2
     NET AREA RATIO f_VI4 MMC12_UNBALANCE_CTM_4 > 10
     RDB MMC12_CTM_VI4_unbalance.rdb BY LAYER f_VI4 MMC12_UNBALANCE_CTM_4
}

MMC12_BALANCE_CBM_4 = (MMC12_FLOAT_CBM_4 INTERACT MMC12_FLOAT_CTM_4) OR (MMC12_GROUND_CBM_4 INTERACT MMC12_GROUND_CTM_4) 
MMC12_UNBALANCE_CBM_4 = MMC12_FLOAT_CBM_4 INTERACT MMC12_GROUND_CTM_4                                                                      
CONNECT MMC12_BALANCE_CBM_4 ME1                                                                                                                           
CONNECT MMC12_UNBALANCE_CBM_4 ME1                                                                                                                         
                                                                                                                                                                      
MMC12_BALANCE_ME4_4 = NET AREA RATIO ME4 MMC12_BALANCE_CBM_4 > 0                                                                              
MMC12_UNBALANCE_ME4_4 = NET AREA RATIO ME4 MMC12_UNBALANCE_CBM_4 > 0
MMC12_BALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC12_BALANCE_CBM_4 > 0
MMC12_UNBALANCE_VI4_4 = NET AREA RATIO f_VI4 MMC12_UNBALANCE_CBM_4 > 0

M12_MMC_ANT.3.2.1A_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_ME4_4 f_M12_MMC > 6000
     [PERIMETER(MMC12_BALANCE_ME4_4)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME4_balance.rdb BY LAYER MMC12_BALANCE_ME4_4 f_M12_MMC
}

M12_MMC_ANT.3.2.1B_CBM_ME4{ @ Maximum Ratio of Metal_4 (M4 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_ME4_4 f_M12_MMC > 100
     [PERIMETER(MMC12_UNBALANCE_ME4_4)*MET_IN_THIN/AREA(f_M12_MMC)]
     RDB MMC12_CBM_ME4_unbalance.rdb BY LAYER MMC12_UNBALANCE_ME4_4 f_M12_MMC
}

M12_MMC_ANT.3.2.1D_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_BALANCE_VI4_4 f_M12_MMC > 20
     RDB MMC12_CBM_VI4_balance.rdb BY LAYER MMC12_BALANCE_VI4_4 f_M12_MMC
}

M12_MMC_ANT.3.2.1E_CBM_VI4{ @ Maximum Ratio of MVIA_4 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME1 and ME2
     f_M12_MMC = STAMP M12_MMC BY ME1   
     NET AREA RATIO MMC12_UNBALANCE_VI4_4 f_M12_MMC > 10
     RDB MMC12_CBM_VI4_unbalance.rdb BY LAYER MMC12_UNBALANCE_VI4_4 f_M12_MMC
}
/////////////////////////
// ME5 Antenna check   //
/////////////////////////
CONNECT ME5 M45_MMC ME4 BY VI4
DIODE_ME5 = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME5 BY CONT

ME5_WITHOUT_DIODE    =  NET AREA RATIO ME5 DIODE_ME5 == 0 // ME5 DO NOT CONNECT WITH DIODE
ME5_WITH_DIODE       =  NET AREA RATIO ME5 DIODE_ME5 > 0   // ME5 CONNECT WITH DIODE

ANT.3.1.1D.ME5 { @ Maximum ratio of Metal sidewall area (each layer) to gate area is 1200.
                 @ Without protection diode
     E = NET AREA RATIO ME5_WITHOUT_DIODE GATE > 1200 ACCUMULATE
         [PERIMETER(ME5_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.3.1.1D.ME5.sum   
   
     NET AREA RATIO ME5_WITHOUT_DIODE GATE > 1200
     [PERIMETER(ME5_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     RDB ANT.3.1.1D.ME5.rdb BY LAYER ME5_WITHOUT_DIODE GATE
}

ANT.3.1.2B.ME5 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 20000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 1
               [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.2B.ME5.sum
   
     NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 1
           [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA  
     RDB ANT.3.1.2B.ME5.rdb BY LAYER ME5_WITH_DIODE GATE DIODE_ME5
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
}

ME5_CA = NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 0
         [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN / (AREA(GATE)*(20000+ 400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA // GATE ME1 to ME5 ACCUMULATE


/////////////////////////
// VI5 Antenna check   //
/////////////////////////

f_VI5 = BULK AND VI5
CONNECT ME5 f_VI5

VI5_WITHOUT_DIODE = NET AREA RATIO f_VI5 DIODE_ME5 ==0	// VIA5 DO NOT CONNECT WITH DIODE
VI5_WITH_DIODE    = NET AREA RATIO f_VI5 DIODE_ME5 > 0  // VIA5 CONNECT WITH DIODE

ANT.3.1.1C.VI5 { @ Maximum ratio of VIA5 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.3.1.1C.VI5.sum
   
     NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.3.1.1C.VI5.rdb BY LAYER VI5_WITHOUT_DIODE GATE   
}

ANT.3.1.1E.VI5 { @ Maximum ratio of cumulative VIA5 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI4_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.3.1.1E.VI5.sum
   
     NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI4_CA 
     RDB ANT.3.1.1E.VI5.rdb BY LAYER VI5_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
       NET AREA RATIO f_VI4 E_STAMP >0
       NET AREA RATIO f_VI5 E_STAMP >0
}

ANT.3.1.2A.VI5 { @ Maximum ratio of VIA5 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 >1
             [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))]  ACCUMULATE VI4_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2A.VI5.sum
   
   NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 >1
         [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))]  ACCUMULATE VI4_CA_WD   
   RDB  ANT.3.1.2A.VI5.rdb  BY LAYER  VI5_WITH_DIODE  GATE DIODE_ME5 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
     NET AREA RATIO f_VI5 E_STAMP >0
}

ANT.3.1.2.Note2.VI5 { @ Maximum ratio of VIA5 area (cumulative) to gate area is 1200 area.
   E = NET AREA RATIO f_VI5 OVER GATE  > 1200 ACCUMULATE VI4_all_CA
   COPY E  
   NET AREA RATIO PRINT E  ANT.3.1.2.Note2.VI5.sum
   
   NET AREA RATIO f_VI5 OVER GATE > 1200 ACCUMULATE VI4_all_CA   
   RDB ONLY ANT.3.1.2.Note2.VI5.rdb  BY LAYER  f_VI5  GATE  

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
     NET AREA RATIO f_VI5 E_STAMP >0
}

VI5_all_CA = NET AREA RATIO f_VI5 OVER GATE > 0 ACCUMULATE VI4_all_CA
VI5_CA = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI4_CA // GATE VI1 to VI5 ACCUMULATE without diode
VI5_CA_WD = NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 > 0
            [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))] ACCUMULATE VI4_CA_WD // GATE VI1 to VI5 ACCUMULATE with diode

// Start the VI5 Ratio rule of MMC between ME5 and ME6

M56_MMC_ANT.3.2.1D_CBM_VI5{ @ Maximum Ratio of MVIA_5 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME5 and ME6
MMC56_FLOAT_ME5 = NET AREA RATIO ME5 SUB == 0
MMC56_ON_FLOAT_ME5 = DFM PROPERTY MMC56_FLOAT_ME5 M56_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M56_MMC)] > 0
MMC56_VI5 = (NET AREA RATIO f_VI5 MMC56_FLOAT_ME5 > 0) NOT M56_MMC
MMC56_FLOAT_VI5 = DFM PROPERTY MMC56_FLOAT_ME5 MMC56_VI5 MMC56_ON_FLOAT_ME5 NODAL MULTI
                               [VI5_AREA = AREA(MMC56_VI5)] > 0
                               [MMC_AREA = PROPERTY(MMC56_ON_FLOAT_ME5,MMC_AREA)] > 0

  P = DFM PROPERTY MMC56_FLOAT_ME5 M56_MMC MMC56_FLOAT_VI5 OVERLAP MULTI
      [check = AREA(M56_MMC)] > 0
      [CBM_VI5_AREA = PROPERTY(MMC56_FLOAT_VI5,VI5_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC56_FLOAT_VI5,MMC_AREA)] > 0
      [VI5_RATIO = PROPERTY(MMC56_FLOAT_VI5,VI5_AREA)/PROPERTY(MMC56_FLOAT_VI5,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC56_CBM_VI5_balance.rdb
}

// Start the ME5 & VIA5 Ratio rule of MMC between ME4 and ME5 //

MMC45_FLOAT_CBM_5 = NET AREA RATIO ME4 SUB == 0
MMC45_FLOAT_CTM_5 = NET AREA RATIO M45_MMC SUB == 0
MMC45_GROUND_CBM_5 = NET AREA RATIO ME4 SUB > 0
MMC45_GROUND_CTM_5 = NET AREA RATIO M45_MMC SUB > 0

MMC45_BALANCE_CTM_5 = (MMC45_FLOAT_CTM_5 AND MMC45_FLOAT_CBM_5) OR (MMC45_GROUND_CTM_5 AND MMC45_GROUND_CBM_5)
MMC45_UNBALANCE_CTM_5 = MMC45_FLOAT_CTM_5 AND MMC45_GROUND_CBM_5
CONNECT MMC45_BALANCE_CTM_5 M45_MMC
CONNECT MMC45_UNBALANCE_CTM_5 M45_MMC

M45_MMC_ANT.3.2.1A_CTM_ME5{ @ Maximum Ratio of Metal_5 (M5 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME4 and ME5
     NET AREA RATIO ME5 MMC45_BALANCE_CTM_5 > 6000
     [PERIMETER(ME5)*MET_IN_THIN/AREA(MMC45_BALANCE_CTM_5)]
     RDB MMC45_CTM_ME5_balance.rdb BY LAYER ME5 MMC45_BALANCE_CTM_5
}

M45_MMC_ANT.3.2.1C_CTM_ME5{ @ Maximum Ratio of Metal_5 (M5 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME4 and ME5
     NET AREA RATIO ME5 MMC45_UNBALANCE_CTM_5 > 100
     [PERIMETER(ME5)*MET_IN_THIN/AREA(MMC45_UNBALANCE_CTM_5)]
     RDB MMC45_CTM_ME5_unbalance.rdb BY LAYER ME5 MMC45_UNBALANCE_CTM_5
}

M45_MMC_ANT.3.2.1D_CTM_VI5{ @ Maximum Ratio of MVIA_5 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME4 and ME5
     NET AREA RATIO f_VI5 MMC45_BALANCE_CTM_5 > 20
     RDB MMC45_CTM_VI5_balance.rdb BY LAYER f_VI5 MMC45_BALANCE_CTM_5
}

M45_MMC_ANT.3.2.1F_CTM_VI5{ @ Maximum Ratio of MVIA_5 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME4 and ME5
     NET AREA RATIO f_VI5 MMC45_UNBALANCE_CTM_5 > 10
     RDB MMC45_CTM_VI5_unbalance.rdb BY LAYER f_VI5 MMC45_UNBALANCE_CTM_5
}

MMC45_BALANCE_CBM_5 = (MMC45_FLOAT_CBM_5 INTERACT MMC45_FLOAT_CTM_5) OR (MMC45_GROUND_CBM_5 INTERACT MMC45_GROUND_CTM_5) 
MMC45_UNBALANCE_CBM_5 = MMC45_FLOAT_CBM_5 INTERACT MMC45_GROUND_CTM_5                                                                      
CONNECT MMC45_BALANCE_CBM_5 ME4                                                                                                                           
CONNECT MMC45_UNBALANCE_CBM_5 ME4                                                                                                                         
                                                                                                                                                                      
MMC45_BALANCE_ME5_5 = NET AREA RATIO ME5 MMC45_BALANCE_CBM_5 > 0                                                                              
MMC45_UNBALANCE_ME5_5 = NET AREA RATIO ME5 MMC45_UNBALANCE_CBM_5 > 0
MMC45_BALANCE_VI5_5 = NET AREA RATIO f_VI5 MMC45_BALANCE_CBM_5 > 0
MMC45_UNBALANCE_VI5_5 = NET AREA RATIO f_VI5 MMC45_UNBALANCE_CBM_5 > 0

M45_MMC_ANT.3.2.1A_CBM_ME5{ @ Maximum Ratio of Metal_5 (M5 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME4 and ME5
     f_M45_MMC = STAMP M45_MMC BY ME4   
     NET AREA RATIO MMC45_BALANCE_ME5_5 f_M45_MMC > 6000
     [PERIMETER(MMC45_BALANCE_ME5_5)*MET_IN_THIN/AREA(f_M45_MMC)]
     RDB MMC45_CBM_ME5_balance.rdb BY LAYER MMC45_BALANCE_ME5_5 f_M45_MMC
}

M45_MMC_ANT.3.2.1B_CBM_ME5{ @ Maximum Ratio of Metal_5 (M5 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME4 and ME5
     f_M45_MMC = STAMP M45_MMC BY ME4   
     NET AREA RATIO MMC45_UNBALANCE_ME5_5 f_M45_MMC > 100
     [PERIMETER(MMC45_UNBALANCE_ME5_5)*MET_IN_THIN/AREA(f_M45_MMC)]
     RDB MMC45_CBM_ME5_unbalance.rdb BY LAYER MMC45_UNBALANCE_ME5_5 f_M45_MMC
}

M45_MMC_ANT.3.2.1D_CBM_VI5{ @ Maximum Ratio of MVIA_5 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME4 and ME5
     f_M45_MMC = STAMP M45_MMC BY ME4   
     NET AREA RATIO MMC45_BALANCE_VI5_5 f_M45_MMC > 20
