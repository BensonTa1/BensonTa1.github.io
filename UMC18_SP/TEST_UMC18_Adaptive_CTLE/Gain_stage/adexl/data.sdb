		<extensions>
			<extension>Parasitics
				<callback>_parSetupDBExtensionCB</callback>
				<iconvalue></iconvalue>
				<icontype></icontype>
				<active>
					<mode>No Parasitics/LDE</mode>
					<parameters>
						<device>
							<enabled>0</enabled>
						</device>
						<parasitic>
							<enabled>0</enabled>
						</parasitic>
					</parameters>
				</active>
				<modes>
					<mode>No Parasitics/LDE
						<schematic>
							<lib>TEST_Adaptive_CTLE</lib>
							<cell>Gain_stage</cell>
							<view>schematic</view>
						</schematic>
					</mode>
					<mode>Schematic Estimates (Parasitics)
						<schematic>
							<lib>TEST_Adaptive_CTLE</lib>
							<cell>Gain_stage</cell>
							<view>schematic</view>
						</schematic>
						<parasitic>
							<lib>TEST_Adaptive_CTLE</lib>
							<cell>Gain_stage</cell>
							<view>estimated</view>
						</parasitic>
					</mode>
					<mode>Layout (Parasitics/LDE)</mode>
					<mode>Extracted (Parasitics/LDE)</mode>
				</modes>
			</extension>
		</extensions>
		<currentmode>Monte Carlo Sampling</currentmode>
		<overwritehistory>0</overwritehistory>
		<tests>
			<test enabled="1">TEST_Adaptive_CTLE:CTLE_GAIN:1
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>CTLE_GAIN</value>
					</option>
					<option>lib
						<value>TEST_Adaptive_CTLE</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>TEST_Adaptive_CTLE:CTLE_GAIN:1_active</value>
					</option>
				</tooloptions>
				<origoptions>
					<option>cell
						<value>CTLE_GAIN</value>
					</option>
					<option>lib
						<value>TEST_Adaptive_CTLE</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR/test_states</value>
					</option>
					<option>state
						<value>state1</value>
					</option>
				</origoptions>
			</test>
		</tests>
		<vars>
			<var>VCTLE
				<value>1</value>
				<dependentTests>
					<dependentTest omitted="0">TEST_Adaptive_CTLE:Gain_stage:1</dependentTest>
				</dependentTests>
			</var>
			<var>sigma
				<value>3</value>
			</var>
			<var>temperature
				<value>{Inclusion List}30{Inclusion List}</value>
			</var>
			<var>VDD
				<value>{Inclusion List}1.8{Inclusion List}</value>
				<dependentTests>
					<dependentTest omitted="0">TEST_Adaptive_CTLE:Gain_stage:1</dependentTest>
				</dependentTests>
			</var>
		</vars>
		<overwritehistoryname>Interactive.0</overwritehistoryname>
		<plottingoptions>
			<plottingoption>plottingmode
				<value>Replace</value>
			</plottingoption>
			<plottingoption>plottype
				<value>None</value>
			</plottingoption>
			<plottingoption>usewaveformtemplate
				<value>no</value>
			</plottingoption>
			<plottingoption>useMaestroPlottingTemplate
				<value>yes</value>
			</plottingoption>
			<plottingoption>waveformtemplate
				<value></value>
			</plottingoption>
			<plottingoption>allplottingtemplates
				<value></value>
			</plottingoption>
			<plottingoption>defaultplottingtemplate
				<value></value>
			</plottingoption>
		</plottingoptions>
		<runoptions>
			<mode>Monte Carlo Sampling
				<runoption>mcmethod
					<value>all</value>
				</runoption>
				<runoption>mcnumpoints
					<value>200</value>
				</runoption>
				<runoption>mcnumbins
					<value></value>
				</runoption>
				<runoption>mcStopEarly
					<value>0</value>
				</runoption>
				<runoption>mcStopMethod
					<value>Significance Test</value>
				</runoption>
				<runoption>samplingmode
					<value>lds</value>
				</runoption>
				<runoption>saveprocess
					<value>1</value>
				</runoption>
				<runoption>savemismatch
					<value>1</value>
				</runoption>
