// VerilogA for CDR, BER_Dector, veriloga

`include "constants.vams"
`include "disciplines.vams"

module BER_Dector(PRBSIN,DIN,Total_bit,Error_bit);
	input PRBSIN,DIN;
	output Total_bit,Error_bit;

	electrical PRBSIN,DIN,Total_bit,Error_bit;

	real cnt_times=0;
	real error_times=0;
	real status_flag=0;

	parameter real VTH=1.5;


	analog begin 
		@(cross(V(PRBSIN)-VTH,1))begin

			if(status_flag==1)begin
				error_times=error_times+1;
			end

			cnt_times=cnt_times+1;
			status_flag=1;
			

		end

		@(cross(V(DIN)-VTH,1))begin

			status_flag=0;

		end

		@(cross(V(PRBSIN)-VTH,-1))begin

			if(status_flag==1)begin
				error_times=error_times+1;
				status_flag=0;
			end
			

		end


		V(Error_bit)<+transition(error_times/1000000,0,1p,1p);
		V(Total_bit)<+transition(cnt_times/1000000,0,1p,1p);
	end

endmodule

