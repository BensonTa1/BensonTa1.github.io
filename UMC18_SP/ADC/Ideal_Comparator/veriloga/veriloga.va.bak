// VerilogA for ADC, Ideal_Comparator, veriloga

`include "constants.vams"
`include "disciplines.vams"

module Ideal_Comparator(VINP,VINN,CLK,VOUTP,VOUTN);
	electrical VINP,VINN,CLK,VOUTP,VOUTN;
	input VINP,VINN,CLK;
	output VOUTP,VOUTN;
	

	real state=0;

	analog begin
		@(cross(V(CLK)-0.1,-1))begin
			if(V(VINP)>V(VINN))begin
				state=1;
			end

			if(V(VINP)<=V(VINN))begin
				state=0;
			end
		end

	V(VOUTP)<+state;
	V(VOUTN)<+(1-state);
	end

endmodule
