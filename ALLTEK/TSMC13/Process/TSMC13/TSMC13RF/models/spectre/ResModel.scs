//
simulator lang=spectre insensitive=yes
library tsmclib
 

section res_t
parameters rnw=409.0
parameters rnl=6.65
parameters rns=6.65
parameters rnwo=72.75
parameters rpl=7.25
parameters rps=7.25
parameters rpwo=145.87
include "ResModel.scs" section=res_macro
endsection res_t
 
//  ************ Library of best corner *********************************
 
section res_b
parameters rnw=334.0
parameters rnl=5.05
parameters rns=4.95
parameters rnwo=59.42
parameters rpl=5.37
parameters rps=4.66
parameters rpwo=116.7
include "ResModel.scs" section=res_macro
endsection res_b
 
//  ************ Library of worst corner ********************************
 
section res_w
parameters rnw=484.0
parameters rnl=8.25
parameters rns=8.35
parameters rnwo=86.08
parameters rpl=9.13
parameters rps=9.84
parameters rpwo=175.04
include "ResModel.scs" section=res_macro
endsection res_w
 
//  *********************************************************************
 
section res_macro
subckt rnwod_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rnw dw=0.224u ptc1=2.33e-3 ptc2=8.76e-6 pvc1=1.45e-2 pvc2=-6.27e-4 
+ pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25.0) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) nwdio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
d2 ( body nm ) nwdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d3 ( body nn ) nwdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( body nx ) nwdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( body n1 ) nwdio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rnwod_m
 
subckt rnodl_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rnl dw=-0.057u ptc1=2.97e-3 ptc2=2.89e-7 pvc1=-9.44e-5 
+ pvc2=1.42e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt 
+ - 25) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
d2 ( body nm ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d3 ( body nn ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( body nx ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( body n1 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rnodl_m
 
subckt rnods_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rns dw=-0.057u ptc1=3.34e-3 ptc2=3.79e-7 pvc1=-1.67e-4 
+ pvc2=6.88e-4 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt 
+ - 25) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
d2 ( body nm ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d3 ( body nn ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( body nx ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( body n1 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rnods_m
 
subckt rnodwo_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rnwo dw=0.011u ptc1=1.32e-3 ptc2=5.53e-7 pvc1=2.99e-4 pvc2=5.56e-5 
+ pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
d2 ( body nm ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d3 ( body nn ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( body nx ) ndio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( body n1 ) ndio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rnodwo_m
 
subckt rpodl_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rpl dw=-0.07u ptc1=2.89e-3 ptc2=1.03e-6 pvc1=-1.94e-4 pvc2=1.2e-3 
+ pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( n2 body ) pdio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
d2 ( nm body ) pdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d3 ( nn body ) pdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( nx body ) pdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( n1 body ) pdio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rpodl_m
 
subckt rpods_m ( n2 n1 body ) 
parameters l=1u w=1u rsh=rps dw=-0.07u ptc1=3.45e-3 ptc2=4.16e-7 pvc1=-1.57e-4 pvc2=5.77e-4 
+ pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt - 25) 
 
 
r1 ( n2 nm ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) bsource r=rsh * l / (4.0 * (w - dw)) * (1 + pvc1 * abs(v(n2,n1)) 
