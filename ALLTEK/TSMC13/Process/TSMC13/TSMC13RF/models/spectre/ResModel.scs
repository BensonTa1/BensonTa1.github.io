d3 ( nn body ) pdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d4 ( nx body ) pdio area=(w - dw) * l / 5.0 pj=2.0 * l / 5.0
d5 ( n1 body ) pdio area=(w - dw) * l / 5.0 pj=(w - dw) + 2.0 * l / 5.0
 
ends rpodwo_m
 
endsection res_macro

//*******************************************************************************
//                                                                              *
//      1. Distributed Resistor corner model                                    *
//                                                                              *
//          a.LIB TT_DISRES:Typical model                                       *
//                                                                              *
//          b.LIB FF_DISRES:Fast corner model                                   *
//                                                                              *
//          c.LIB SS_DISRES:Slow corner model                                   *
//                                                                              *
//*******************************************************************************

section stat_disres
statistics {
    mismatch {
        vary par_disres dist=gauss std=1/1
        }
    }
endsection stat_disres

section tt_disres
parameters 
+ par_disres=0
+ disr_rppolyl=7.67
+ disr_rppolys=7.67
+ disr_rnpolyl=7.31
+ disr_rnpolys=7.31
+ disr_rnpolywo=260.09
+ disr_rppolywo=319.55
+ disr_rppolyhri=950
include "ResModel.scs" section=dis_res
endsection tt_disres
 
section ss_disres
parameters 
+ par_disres=0
+ disr_rppolyl=7.67 + 1.92
+ disr_rppolys=7.67 + 2.32
+ disr_rnpolyl=7.31 + 1.90
+ disr_rnpolys=7.31 + 2.36
+ disr_rnpolywo=260.09 + 43.52
+ disr_rppolywo=319.55 + 63.91
+ disr_rppolyhri=950 + 190
include "ResModel.scs" section=dis_res
endsection ss_disres
 
section ff_disres
parameters 
+ par_disres=0
+ disr_rppolyl=7.67 - 1.92
+ disr_rppolys=7.67 - 2.32
+ disr_rnpolyl=7.31 - 1.90
+ disr_rnpolys=7.31 - 2.36
+ disr_rnpolywo=260.09 - 43.52
+ disr_rppolywo=319.55 - 63.91
+ disr_rppolyhri=950 - 190
include "ResModel.scs" section=dis_res
endsection ff_disres


//  *************************************************************************************
// 	DISTRIBUTED RESISTOR MODEL                                                      *
//                                                                                      *
//               Model name      structure                                              *
//               -----------------------------------------                              *
//               rppolyl_dis    Distributed P+ Poly w/i Silicide w>=2um                 *
//               rppolys_dis    Distributed P+ Poly w/i Silicide 0.13um<=w<2um          *
//               rnpolyl_dis    Distributed N+ Poly w/i Silicide w>=2um                 *
//               rnpolys_dis    Distributed N+ Poly w/i Silicide 0.13um<=w<2um          *
//               rppolywo_dis   Distributed P+ Poly w/o Silicide w>1um,sqr>2            *
//               rnpolywo_dis   Distributed N+ Poly w/o Silicide w>1um,sqr>2            *
//               rppolyhri_dis  Distributed P- Poly w/o Silicide w>1um,sqr>2            *
//               rppolyl_dis_mis    Distributed P+ Poly w/i Silicide w>=2um     
//               rppolys_dis_mis    Distributed P+ Poly w/i Silicide 0.13um<=w<2um 
//               rnpolyl_dis_mis    Distributed N+ Poly w/i Silicide w>=2um     
//               rnpolys_dis_mis    Distributed N+ Poly w/i Silicide 0.13um<=w<2um 
//               rppolywo_dis_mis   Distributed P+ Poly w/o Silicide w>1um,sqr>2        *
//               rnpolywo_dis_mis   Distributed N+ Poly w/o Silicide w>1um,sqr>2        *
//               rppolyhri_dis_mis  Distributed P- Poly w/o Silicide w>1um,sqr>2        *
//  *************************************************************************************
 
 
section dis_res
subckt rppolyl_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rsh=disr_rppolyl dw=-0.035u ptc1=2.64e-03 ptc2=1.92e-06 
+ pvc1=3.14e-03 pvc2=6.18e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) bsource r=rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(n2,n1)) + pvc2 
+ * v(n2,n1) * v(n2,n1)) * tfac
cox1 ( n1 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
cox2 ( n2 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
 
ends rppolyl_dis
 
subckt rppolys_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rsh=disr_rppolys dw=-0.035u ptc1=2.88e-03 ptc2=4.47e-07 
+ pvc1=1.93e-04 pvc2=1.99e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) bsource r=rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(n2,n1)) + pvc2 
+ * v(n2,n1) * v(n2,n1)) * tfac
cox1 ( n1 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
cox2 ( n2 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
ends rppolys_dis
 
subckt rnpolyl_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rsh=disr_rnpolyl dw=-0.055u ptc1=2.77e-03 ptc2=1.51e-06 
+ pvc1=3.37e-03 pvc2=6.34e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) bsource r=rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(n2,n1)) + pvc2 
+ * v(n2,n1) * v(n2,n1)) * tfac
cox1 ( n1 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
cox2 ( n2 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
 
ends rnpolyl_dis
 
subckt rnpolys_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rsh=disr_rnpolys dw=-0.055u ptc1=3.29e-03 ptc2=1.67e-07 
+ pvc1=3.56e-04 pvc2=2.66e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) bsource r=rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(n2,n1)) + pvc2 
+ * v(n2,n1) * v(n2,n1)) * tfac
cox1 ( n1 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
cox2 ( n2 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
ends rnpolys_dis
 
subckt rnpolywo_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rend0=3.91e-05 rsh=disr_rnpolywo dl=0.02051u dw=0.07157u 
+ pt=temp pvce1=9.19e-01 pvce2=1.86e+01 pvce3=-1.64e+00 ptce1=2.75e-04 ptce2=-4.10e-06 
+ pvcp1=-2.73e-02 pvcp2=1.23e-05 pvcp3=-1.70e+00 ptcp1=-1.11e-03 ptcp2=1.51e-06 
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) bsource r=rsh / mf * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(3,4) / (l - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
cox1 ( 3 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
cox2 ( 4 gnode ) capacitor c=1 / 2 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 
+ * 2 * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * mf
ends rnpolywo_dis
 
subckt rppolywo_dis ( n1 n2 gnode ) 
parameters l=1u w=1u mf=1 rend0=1.01e-04 rsh=disr_rppolywo dl=0.04698u dw=0.07953u 
+ pt=temp pvce1=-9.40e-02 pvce2=6.39e+01 pvce3=-2.71e+00 ptce1=-1.71e-03 ptce2=1.06e-06 
+ pvcp1=-1.99e-01 pvcp2=6.05e-06 pvcp3=-3.23e+00 ptcp1=-1.19e-04 ptcp2=6.54e-07 
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
