// 
 
section dio_dnw
// 
//  *************************************************************
//                    MODEL OF DNW_PSUB DIODE                   *
//                                                              *
//  *************************************************************
//                                                                              
//   
model dnwpsub diode 
+ level=1                   is=9.76e-7*is_d_dnw       rs=1.00e-10*rs_d_dnw
+ n=1.02*n_d_dnw            bv=13.8                   ibv=0.03
+ isw=4.13e-12*jsw_d_dnw    area=3.92e-8              pj=8.4e-4
+ cj=1.322062e-4*cj_d_dnw   vj=0.6012182              mj=0.3431207
+ cjsw=1.136579e-9*cjsw_d_dnw                         vjsw=0.6012182
+ mjsw=0.3037134            tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-7.1e-4           trs=2.65e-3
+ tlevc=1                   cta=2.572685e-3           ctp=2.05458e-3
+ pta=3.145801e-3           ptp=3.145801e-3           tnom=25
+ fc=0                      fcs=0                     ns=1.02*n_d_dnw
+ nz=1.02*n_d_dnw           imax=1e40                 minr=1e-10
+ allow_scaling=1
//     
//  *************************************************************
//                     MODEL OF PW_DNW DIODE                    *
//                                                              *
//  *************************************************************
//                                                                              
//   
model pwdnw diode 
+ level=1                   is=2.55e-6*is_d_dnw       rs=1.00e-10*rs_d_dnw
+ n=1.02*n_d_dnw            bv=13.7                   ibv=0.03
+ isw=5.44e-12*jsw_d_dnw    area=3.92e-8              pj=8.4e-4
+ cj=6.476416e-4*cj_d_dnw   vj=0.6258547              mj=0.3352525
+ cjsw=2.148838e-9*cjsw_d_dnw                         vjsw=0.6258547
+ mjsw=0.3516833            tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-7.1e-4           trs=2.65e-3
+ tlevc=1                   cta=9.800653e-4           ctp=1.067032e-3
+ pta=1.857987e-3           ptp=1.857987e-3           tnom=25
+ fc=0                      fcs=0                     ns=1.02*n_d_dnw
+ nz=1.02*n_d_dnw           imax=1e40                 minr=1e-10
+ allow_scaling=1
// 
endsection dio_dnw
