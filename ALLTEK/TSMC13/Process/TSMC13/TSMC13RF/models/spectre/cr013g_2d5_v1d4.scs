+ - 1) * (2 * num_sidebranch - 1) / 6 / num_sidebranch * lph_end + r_strip * 0.16 
+ / 0.09 / num_sidebranch - int((nf + 1) / 2 - int(nf / 2)) * lph_end / 2 lph_sidex2=lph_sidex1 
+ / 2 lph_center=leng_strip * 1.8 a1_eff=(l - 0.18u) * (w - 0.18u) * nf p1_eff=((l 
+ - 0.18u) + (w - 0.18u)) * 2 * nf a2_eff=l * w * nf - a1_eff p2_eff=(l + w) * 2 
+ * nf + p1_eff ldnw_eff=0.3u * (nf + 1) + (0.36u * 2 + l) * nf + 1.41u * 2 wdnw_eff=w 
+ + 1.41u * 2 adnw_eff=ldnw_eff * wdnw_eff pdnw_eff=(ldnw_eff + wdnw_eff) * 2 r_s1=(0.275397) 
+ / nf + (0.040389) / lum + (0.476984) / wum + (80.52809) / lum / wum / nf + (1.84136) 
+ / lum / wum + (2.915102) / lum / nf + (21.89838) / wum / nf + (0.206569) - 0.2 
+ r_s2=(3.38) / nf + (0.40944) / lum + (2.338413) / wum + (127.1533) / lum / wum 
+ / nf + (4.11991) / lum / wum + (3.99565) / lum / nf + (31.32444) / wum / nf + 
+ ( - 0.17944) r_1=r_strip / num_strip / nf l_1=leng_strip * 2 / num_strip / nf 
+ * 1e-12 r_2=r_strip / (nf + 1) / 0.46 * 0.16 l_2=(lph_sidex2 * lph_center / (lph_sidex2 
+ + lph_center) * (1 - int((nf + 1) / 2 - int(nf / 2))) + lph_sidex2 * int((nf + 
+ 1) / 2 - int(nf / 2))) * 1e-12 r_nwell=((10.68095) / nf + (0.793813) * lum + (7.825079) 
+ / wum + (50.65912) * lum / wum / nf + ( - 2.16331) * lum / wum + ( - 1.60032) 
