+ xti=3                     tbv1=-1*-1.4e-3           trs=2.65e-3
+ tlevc=1                   cta=3.449993e-3           ctp=1.348721e-3
+ pta=2.69401e-3            ptp=2.69401e-3            tnom=25
+ fc=0                      fcs=0                     ns=1.02*n_d_na
+ nz=1.02*n_d_na            imax=1e40                 minr=1e-10
+ allow_scaling=1
// 
endsection dio_na
