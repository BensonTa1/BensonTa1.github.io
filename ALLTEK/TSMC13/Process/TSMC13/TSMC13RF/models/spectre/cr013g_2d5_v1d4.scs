//*************************************************************************************************
// MIM CAPACITOR MODEL :
//
//     HF model:
//          1.0fF MiM_Cap w/i underground metal for 1PXM 4<=X<=8
//          1.0fF MiM_Cap w/o underground metal for 1PXM 4<=X<=8
//          1.5fF MiM_Cap w/i underground metal for 1PXM 4<=X<=8
//          1.5fF MiM_Cap w/o underground metal for 1PXM 4<=X<=8
//
//     ## library files:
//     
//     1. The 1.0fF MIM capacitors with underground metal are modeled with sub-circuit 'mimcap_um_1p0_sin_rf'
//     2. The 1.0fF MIM capacitors without underground metal are modeled with sub-circuit 'mimcap_woum_1p0_sin_rf'
//     3. The 1.5fF MIM capacitors with underground metal are modeled with sub-circuit 'mimcap_um_1p5_sin_rf'
//     4. The 1.5fF MIM capacitors without underground metal are modeled with sub-circuit 'mimcap_woum_1p5_sin_rf'
//      
//            Model name           lt(um)            wt(um)            lay
//                              low    high       low    high       low    high
//     -------------------------------------------------------------------------
//     mimcap_um_1p0_sin_rf      4     100         4     100       
//     mimcap_woum_1p0_sin_rf    4     100         4     100         4       8
//     mimcap_um_1p5_sin_rf      4     100         4     100       
//     mimcap_woum_1p5_sin_rf    4     100         4     100         4       8
//     -------------------------------------------------------------------------
//            End Model
//            **lt: length dimension of top metal
//            **wt: width dimension of top metal
//            **lt >= wt
//            **lay: Metal layer option (4,5,6,7,8)
//
//*************************************************************************************************
section rf_mim
subckt mimcap_um_1p0_sin_rf ( top bottom um )
parameters lt=10u wt=10u ltop_para=((0.14 * (wt * 1e6) * (log((wt * 1e6) / (lt *
+ 1e6 + 0.05)) + 1.19 + 0.022 * (lt * 1e6 + 0.05) / (wt * 1e6)) / 1 + 1.5) / 3 +
+ 1.78) * 1e-12 lbot_cbm=((0.14 * (wt * 1e6 + 4.04) * (log((wt * 1e6 + 4.04) / ((lt
+ * 1e6 + 4.04) + 0.2)) + 1.19 + 0.022 * ((lt * 1e6 + 4.04) + 0.2) / (wt * 1e6 +
+ 4.04)) / 1 + 1.5) / 3) * 1e-12 lbot_lead=((0.606 + 0.14 * ((lt * 1e6 + 4.04) /
+ 2) * (log(((lt * 1e6 + 4.04) / 2) / (1 + 0.9)) + 1.19 + 0.022 * (1 + 0.9) / ((lt
+ * 1e6 + 4.04) / 2)) / 1 + 1.5) / 2) * 1e-12 lbot_para=(lbot_cbm + lbot_lead) via_v=int((lt
+ * 1e6 / 2 - 1.46) / (1.19) + 1) res_v=(via_v - 1) * (2 * via_v - 1) / (6 * via_v)
+ * 0.0083 + 20.15 / via_v via_h=int((wt * 1e6 - 3.64) / (2.925) + 1) rtop_para=(0.040508475
+ + (via_h - 1) * (2 * via_h - 1) / (6 * via_h) * 0.010169492 + res_v / 2 / via_h
+ + 0.15) r1=(lt * 1e6 + 0.2) / 2 / (wt * 1e6 + 0.2) * 0.293 / 3 r3=(wt * 1e6 +
+ 0.2) / 2 / (lt * 1e6 + 0.2) * 0.293 / 3 rcbm=(1 / (2 / r1 + 2 / r3)) via_left=int((((wt
+ * 1e6 + 4.04) - 0.96 + ((lt * 1e6 + 4.04) / 2 - 3.06)) - 0.76) / (1.21) + 1) res_left=0.002083333
+ + (via_left - 1) * (2 * via_left - 1) / (6 * via_left) * 0.008854167 + 0.54 /
+ via_left via_vert=int((((lt * 1e6 + 4.04) / 2 - 3.06) - 0.76) / (1.21) + 1) res_vert=0.002083333
+ + (via_vert - 1) * (2 * via_vert - 1) / (6 * via_vert) * 0.008854167 + 0.54 /
+ via_vert res_cbm=1 / (1 / res_left + 1 / res_vert) res_lead=(2 / 1.92 + (lt *
+ 1e6 + 4.04) / 2 / 1) * 0.02 res_upper=res_cbm + res_lead rbot_para=(res_upper
+ / 2 + rcbm + 0.15) cmim_para=(((wt - 0.108e-6) * (lt - 0.108e-6) * 1e12 * 1.0274) + 2 * ((wt - 0.108e-6) + (lt - 0.108e-6)) * 1e6
+ * 0.1686 + 0.1468) * 1e-15 * (1 + (temp - 25) *  - 4.13e-5 + (temp - 25)
+ * (temp - 25) *  - 8e-8) cox_para=((lt * 1e6 + 4.04) * (wt * 1e6 + 4.04) * 0.045917
+ + 0.05472 + (lt * 1e6 + 4.04) * 0.007125) * 1e-15
//
ltop ( top n1 ) inductor l=ltop_para * l_mimfac
rtop ( n1 n2 ) resistor r=rtop_para * rctm_mimfac * (0.003 * (temp - 25) + 1)
//cmim ( n2 n3 ) bsource c=cmim_para * (1 + v(n2,n3) * 2.96e-5 + (abs(v(n2,n3))
//+ ** 2) *  - 2.44e-5) * cmim_mimfac
cmim ( n2 n3 ) bsource q=cmim_para * (v(n2,n3) + 0.5*v(n2,n3)**(2) * 2.96e-5 + 1/3*v(n2,n3)
+ ** 3 *  - 2.44e-5) * cmim_mimfac
rbot ( n3 n4 ) resistor r=rbot_para * rctm_mimfac * (0.003 * (temp - 25) + 1)
lbot ( n4 bottom ) inductor l=lbot_para * l_mimfac
cox ( n3 um ) capacitor c=cox_para * cm6_mimfac
//
ends mimcap_um_1p0_sin_rf


subckt mimcap_woum_1p0_sin_rf ( top bottom gnode ) 
parameters lt=10u wt=10u lay=8 ltop_para=((0.14 * (wt * 1e6) * (log((wt * 1e6) / (lt * 
+ 1e6 + 0.05)) + 1.19 + 0.022 * (lt * 1e6 + 0.05) / (wt * 1e6)) / 1 + 1.5) / 3 + 
+ 1.78) * 1e-12 lbot_cbm=((0.14 * (wt * 1e6 + 4.04) * (log((wt * 1e6 + 4.04) / ((lt 
+ * 1e6 + 4.04) + 0.2)) + 1.19 + 0.022 * ((lt * 1e6 + 4.04) + 0.2) / (wt * 1e6 + 
+ 4.04)) / 1 + 1.5) / 3) * 1e-12 lbot_lead=((0.606 + 0.14 * ((lt * 1e6 + 4.04) / 
+ 2) * (log(((lt * 1e6 + 4.04) / 2) / (1 + 0.9)) + 1.19 + 0.022 * (1 + 0.9) / ((lt 
+ * 1e6 + 4.04) / 2)) / 1 + 1.5) / 2) * 1e-12 lbot_para=(lbot_cbm + lbot_lead) via_v=int((lt 
+ * 1e6 / 2 - 1.46) / (1.19) + 1) res_v=(via_v - 1) * (2 * via_v - 1) / (6 * via_v) 
+ * 0.0083 + 20.15 / via_v via_h=int((wt * 1e6 - 3.64) / (2.925) + 1) rtop_para=(0.040508475 
+ + (via_h - 1) * (2 * via_h - 1) / (6 * via_h) * 0.010169492 + res_v / 2 / via_h 
+ + 0.15) r1=(lt * 1e6 + 0.2) / 2 / (wt * 1e6 + 0.2) * 0.293 / 3 r3=(wt * 1e6 + 
+ 0.2) / 2 / (lt * 1e6 + 0.2) * 0.293 / 3 rcbm=(1 / (2 / r1 + 2 / r3)) via_left=int((((wt 
+ * 1e6 + 4.04) - 0.96 + ((lt * 1e6 + 4.04) / 2 - 3.06)) - 0.76) / (1.21) + 1) res_left=0.002083333 
+ + (via_left - 1) * (2 * via_left - 1) / (6 * via_left) * 0.008854167 + 0.54 / 
+ via_left via_vert=int((((lt * 1e6 + 4.04) / 2 - 3.06) - 0.76) / (1.21) + 1) res_vert=0.002083333 
+ + (via_vert - 1) * (2 * via_vert - 1) / (6 * via_vert) * 0.008854167 + 0.54 / 
+ via_vert res_cbm=1 / (1 / res_left + 1 / res_vert) res_lead=(2 / 1.92 + (lt * 
+ 1e6 + 4.04) / 2 / 1) * 0.02 res_upper=res_cbm + res_lead rbot_para=(res_upper 
+ / 2 + rcbm + 0.15) cmim_para=(((wt - 0.108e-6) * (lt - 0.108e-6) * 1e12 * 1.0274) 
+ + 2 * ((wt - 0.108e-6) + (lt - 0.108e-6)) * 1e6 * 0.1686 + 0.1468) * 1e-15 * (1 
+ + (temp - 25) *  - 4.13e-5 + (temp - 25) * (temp - 25) *  - 8e-8) cox_para=((lt 
+ * 1e6 + 4.04) * (wt * 1e6 + 4.04) * 0.00908 + 0.05472 + (lt * 1e6 + 4.04) * 0.007125) 
+ * 1e-15 rsub_para=(1 / (2 / ((lt * 1e6 + 4.04) / 2 / (wt * 1e6 + 4.04) * 1921 
+ / 3) + 2 / ((wt * 1e6 + 4.04) / 2 / (lt * 1e6 + 4.04) * 1921 / 3))) * ( - 0.0000114365 
+ * (temp - 25) * (temp - 25) + 0.0045985091 * (temp - 25) + 1) csub_para=(312 
+ / rsub_para) * 1e-15 
// 
ltop ( top n1 ) inductor l=ltop_para * l_mimfac
rtop ( n1 n2 ) resistor r=rtop_para * rctm_mimfac * (0.003 * (temp - 25) + 1)
//cmim ( n2 n3 ) bsource c=cmim_para * (1 + v(n2,n3) * 2.96e-5 + (abs(v(n2,n3)) ** 
//+ 2) *  - 2.44e-5) * cmim_mimfac
cmim ( n2 n3 ) bsource q=cmim_para * (v(n2,n3) + 0.5*v(n2,n3)**(2) * 2.96e-5 + 1/3*v(n2,n3) 
+ ** 3 *  - 2.44e-5) * cmim_mimfac
rbot ( n3 n4 ) resistor r=rbot_para * rctm_mimfac * (0.003 * (temp - 25) + 1)
lbot ( n4 bottom ) inductor l=lbot_para * l_mimfac
cox ( n3 n5 ) capacitor c=cox_para*((1/(5.64085+(2.37149)*(lay-4)))/0.0661078) * cm5_mimfac
csub ( n5 gnode ) capacitor c=csub_para * csub_mimfac
rsub ( n5 gnode ) resistor r=rsub_para * rsub_mimfac
// 
ends mimcap_woum_1p0_sin_rf
//
//
subckt mimcap_um_1p5_sin_rf ( top bottom um ) 
parameters lt=10u wt=10u ltop_para=((0.14 * (wt * 1e6) * (log((wt * 1e6) / (lt * 
+ 1e6 + 0.05)) + 1.19 + 0.022 * (lt * 1e6 + 0.05) / (wt * 1e6)) / 1 + 1.5) / 3 + 
+ 1.78) * 1e-12 lbot_cbm=((0.14 * (wt * 1e6 + 4.04) * (log((wt * 1e6 + 4.04) / ((lt 
+ * 1e6 + 4.04) + 0.2)) + 1.19 + 0.022 * ((lt * 1e6 + 4.04) + 0.2) / (wt * 1e6 + 
+ 4.04)) / 1 + 1.5) / 3) * 1e-12 lbot_lead=((0.606 + 0.14 * ((lt * 1e6 + 4.04) / 
+ 2) * (log(((lt * 1e6 + 4.04) / 2) / (1 + 0.9)) + 1.19 + 0.022 * (1 + 0.9) / ((lt 
+ * 1e6 + 4.04) / 2)) / 1 + 1.5) / 2) * 1e-12 lbot_para=(lbot_cbm + lbot_lead) via_v=int((lt 
+ * 1e6 / 2 - 1.46) / (1.19) + 1) res_v=(via_v - 1) * (2 * via_v - 1) / (6 * via_v) 
+ * 0.0083 + 20.15 / via_v via_h=int((wt * 1e6 - 3.64) / (2.925) + 1) rtop_para=(0.040508475 
+ + (via_h - 1) * (2 * via_h - 1) / (6 * via_h) * 0.010169492 + res_v / 2 / via_h 
+ + 0.15) r1=(lt * 1e6 + 0.2) / 2 / (wt * 1e6 + 0.2) * 0.293 / 3 r3=(wt * 1e6 + 
+ 0.2) / 2 / (lt * 1e6 + 0.2) * 0.293 / 3 rcbm=(1 / (2 / r1 + 2 / r3)) via_left=int((((wt 
+ * 1e6 + 4.04) - 0.96 + ((lt * 1e6 + 4.04) / 2 - 3.06)) - 0.76) / (1.21) + 1) res_left=0.002083333 
+ + (via_left - 1) * (2 * via_left - 1) / (6 * via_left) * 0.008854167 + 0.54 / 
+ via_left via_vert=int((((lt * 1e6 + 4.04) / 2 - 3.06) - 0.76) / (1.21) + 1) res_vert=0.002083333 
+ + (via_vert - 1) * (2 * via_vert - 1) / (6 * via_vert) * 0.008854167 + 0.54 / 
+ via_vert res_cbm=1 / (1 / res_left + 1 / res_vert) res_lead=(2 / 1.92 + (lt * 
+ 1e6 + 4.04) / 2 / 1) * 0.02 res_upper=res_cbm + res_lead rbot_para=(res_upper 
+ / 2 + rcbm + 0.15) cmim_para=(((wt - 0.092e-6) * (lt - 0.092e-6) * 1e12 * 1.547) 
+ + 2 * ((wt - 0.092e-6) + (lt - 0.092e-6)) * 1e6 * 0.164 + 0.172) * 1e-15 * (1 
+ + (temp - 25) *  - 5.016e-5 + (temp - 25) * (temp - 25) * 6.5e-9) cox_para=((lt 
+ * 1e6 + 4.04) * (wt * 1e6 + 4.04) * 0.045917 + 0.05472 + (lt * 1e6 + 4.04) * 0.007125) 
+ * 1e-15 
// 
ltop ( top n1 ) inductor l=ltop_para * l_mimfac
rtop ( n1 n2 ) resistor r=rtop_para * rctm_mimfac * (0.003 * (temp - 25) + 1)
//cmim ( n2 n3 ) bsource c=cmim_para * (1 + v(n2,n3) *  - 3.043e-5 + (abs(v(n2,n3)) 
//+ ** 2) *  - 4.6125e-5) * cmim_mimfac
cmim ( n2 n3 ) bsource q=cmim_para * (v(n2,n3) + 0.5*v(n2,n3)**(2) * - 3.043e-5 + 1/3*v(n2,n3) 
