+ 2e-7) rrrg=0.52 + (gr + 1 - 1) * (2 * (gr + 1) - 1) / (6 * (gr + 1)) * rgm11 +
+ (rpo / 2 + 10.95169) / (gr + 1) avrrrg=rrrg / (int(abs((lr - 0.3e-6) / 0.34e-6)
+ + 1.00001)) rgviaarray=0.75 * 0.79983 / ((2 * 1.36e-6 + (br - 1) * 5.6e-7 + br
+ * 2e-7) / 0.48e-6 / br * 2) rrg=avrrrg + rgviaarray rgm1=0.10482 * (lr + 5.6e-7)
+ / 1e-06 rgm2=0.05967 * (lr + 5.6e-7) / 2.63e-06 rgmhead=1 / (1 / rgm1 + 1 / rgm2)
+ rgg=(rgmhead / 2 + (br / 2 - 1) * (br - 1) / (6 * (br / 2)) * rgmhead + rrg /
+ (br / 2)) / 2 ww=wr * gr + 4.40e-07 * (gr - 1) ll=lr * br + (br - 1) * 4.2e-7
