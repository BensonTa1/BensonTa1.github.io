inline subckt nmos_rf25_mis ( d g s b ) 
parameters lr=35.0e-08 nr=1 wr=2.5e-6 temp1=parnrf1_25 temp2=parnrf2_25 fac1=0.427 
+ * temp1 + 0.904 * temp2 fac2=0.427 * temp1 - 0.904 * temp2 lef=lr - 4.0e-8 wef=wr 
+ + 1.0e-8 geo_fac=1 / sqrt(nr * lef * wef * 1e12) vthmis=0.006243 * geo_fac * fac1 
+ dlmis=0.002279 * geo_fac * lef * fac2 dwmis= - 0.002279 * geo_fac * wef * fac2 
+ toxmis=0.002279 * geo_fac * toxnrf_25 * fac2 lspace=0.42u ledge=2.0u ledgeeff=0.73u 
+ lsti=1.0u wsti=2.0u rod=2015 rsti=3364 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+ nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge + dummyflag * (ledgeeff - 
+ ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) ldios=(ns - 2) * lspace + 
+ sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 1) * lspace + nodd * sleff 
+ sdiofa=wr * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr 
+ * ldiod ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) 
+ * wr * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag rsx=(0.0158 * (lr * 1e6 
+ + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6) rdx=0.0053 
+ * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd + 0.0867 
+ / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96) / (lr * 
+ 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138 * wr * 
+ 1e6 + 0.718 * lr * 1e6 + 349 * lr / nr / wr + 2.389) lod=nr * (lr + lspace) + 
+ 2 * ledge - lspace rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 + rsti 
+ * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr / 12 
+ + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr * 1e6 + 
+ 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19 * nr 
+ * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6 / (lr 
+ * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15 sax=1 
+ / (log((ledge + lr / 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr 
+ + lspace)) / (ledge + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr 
+ + lspace)) + 1 / (nr * (ledge + lr / 2))) - lr / 2 
// ********************
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
// ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
// **** Diodes  ****************
dss ( sb si ) ndio_rf25_f area=sdiofa pj=sdiofp
ddd ( db di ) ndio_rf25_f area=ddiofa pj=ddiofp
dsg ( sb si ) ndio_rf25_g area=1e-15 pj=sdiogp
ddg ( db di ) ndio_rf25_g area=1e-15 pj=ddiogp
// ****************************************************************************
rb ( b bi ) resistor r=rbx tc1=0.0037 tc2=9.64e-6
cb ( b bi ) capacitor c=162f / rbx
rdb ( db bi ) resistor r=rdbx tc1=0.0037 tc2=9.64e-6
cdb ( db bi ) capacitor c=162f / rdbx
rsb ( sb bi ) resistor r=rdbx tc1=0.0037 tc2=9.64e-6
csb ( sb bi ) capacitor c=162f / rdbx
// ****** MOSFET *******
nmos_rf25_mis ( di gi si bi ) nch_rf25 l=lr w=wr m=nr ad=0 as=0 pd=0 ps=0 sa=sax sb=sax
model nch_rf25 bsim3v3  { 
     1: type=n 
+ lmin=2.8e-007             lmax=5.01e-007            wmin=1.2e-006
