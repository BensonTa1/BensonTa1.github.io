section mac_uhvt
 
 
inline subckt nch_uhvt_g ( n11 n2 n33 n4 ) 
parameters l=1u w=1u multi=1 factor=1 sa=0.35u sb=0.35u ad=2 * hdifn_uhvt 
+ / factor * w as=2 * hdifn_uhvt / factor * w pd=2 * (2 * hdifn_uhvt / factor + 
+ w) ps=2 * (2 * hdifn_uhvt / factor + w) nrd=hdifn_uhvt / factor / w nrs=hdifn_uhvt 
+ / factor / w w1=(w * factor + 0.015e-6 + dxw_uhvt) * multi l1=l * factor - 0.02e-6 
+ + dxl_uhvt tcc=1 + 1.7e-3 * (temp - 25) area=w1 * 2.5e-9 * 1e4 * tcc tox=(toxn_uhvt 
+ - 8.3e-10) * 1e2 jf=2.704e-08 ef=2.623e+07 varaf= - 0.18955 * log(l1) + 0.99251 
+ varbf=0.54 * ef * tox jr=5.065e-7 er=7.43e6 varar= - 0.072266 * log(l1) + 16.394 
+ varbr=0.52 * er * tox forward_eff=0.5 * area * jf * exp( - ef * tox * varaf) / 
+ pow(tox,2.5) reverse_eff=0.5 * area * jr * exp( - er * tox * varar) / pow(tox,2.5) 
+ tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
nch_uhvt_g ( n1 n2 n3 n4 ) nch_uhvt w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ sa=sa sb=sb
 
gdf1 ( n2 n1 ) bsource i =forward_eff * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,tmp2) + 1e-18 * v(n2,n1)
 
gdf2 ( n2 n3 ) bsource i =forward_eff * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,tmp2) + 1e-18 * v(n2,n3)
 
rdn ( n1 n11 ) resistor r=6.6 * nrd / multi
rsn ( n3 n33 ) resistor r=6.6 * nrs / multi
ends nch_uhvt_g
 
 
inline subckt pch_uhvt_g ( p11 p2 p33 p4 ) 
parameters l=1u w=1u multi=1 factor=1 sa=0.35u sb=0.35u ad=2 * hdifp_uhvt 
+ / factor * w as=2 * hdifp_uhvt / factor * w pd=2 * (2 * hdifp_uhvt / factor + 
+ w) ps=2 * (2 * hdifp_uhvt / factor + w) nrd=hdifp_uhvt / factor / w nrs=hdifp_uhvt 
+ / factor / w jf=1.1575e-07 ef=7.127e+06 jr=2.8e-8 er=4.373e6 w1=(w * factor + 
+ 0.015e-6 + dxw_uhvt) * multi l1=l * factor + dxl_uhvt - 0.02e-6 tox=(toxp_uhvt 
+ - 8e-10) * 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 * 1e4 * tcc varaf= 
+ - 0.70902 * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 * er * tox varar= 
+ - 0.31121 * log(l1) + 24.530 forward_eff=area * jf * exp( - ef * tox * varaf) 
+ / pow(tox,2.5) reverse_eff=4.5 * area * jr * exp( - er * tox * varar) / pow(tox,2.5) 
+ tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
pch_uhvt_g ( p1 p2 p3 p4 ) pch_uhvt w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ sa=sa sb=sb
 
 
 
gdf1 ( p1 p2 ) bsource i =forward_eff * pow((abs(v(p1,p2)) + v(p1,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p1,p2)) - v(p1,p2)) / 2,tmp2) + 1e-18 * v(p1,p2)
 
gdf2 ( p3 p2 ) bsource i =forward_eff * pow((abs(v(p3,p2)) + v(p3,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p3,p2)) - v(p3,p2)) / 2,tmp2) + 1e-18 * v(p3,p2)
 
 
rdp ( p1 p11 ) resistor r=7.2 * nrd / multi
rsp ( p3 p33 ) resistor r=7.2 * nrs / multi
ends pch_uhvt_g
 
 
endsection mac_uhvt
