c12 ( top bottom ) capacitor c=(c12_a * nr + c12_b * nr * da + c12_c * nr * nr + 
+ c12_d * da * da + c12_e) * 1e-15 * c12_indfac
 
r1 ( top n1 ) resistor r=(r1_a * nr * da * da + r1_b * nr + r1_c * da + r1_d * nr 
+ * nr + r1_e) * (0.0026 * (temp - 25) + 1) * rm8_indfac
l1 ( n1 n3 ) inductor l=(l1_a * nr ** (l1_b) * da ** (l1_c) * do ** (l1_d) + l1_e 
+ * nr ** (l1_f) + l1_g) * 1.0e-9 * l_indfac
l2 ( n3 n2 ) inductor l=(l1_a * nr ** (l1_b) * da ** (l1_c) * do ** (l1_d) + l1_e 
+ * nr ** (l1_f) + l1_g) * 1.0e-9 * l_indfac
r2 ( n2 bottom ) resistor r=(r1_a * nr * da * da + r1_b * nr + r1_c * da + r1_d 
+ * nr * nr + r1_e) * (0.0026 * (temp - 25) + 1) * rm8_indfac
 
k12 mutual_inductor ind1=l1 ind2=l2 coupling=(m_a * nr ** (m_b) * da ** (m_c) * 
+ do ** (m_d) + m_e * nr ** (m_f) + m_g) * l_indfac
 
rs1 ( top n11 ) resistor r=(rs_a * nr * da * da + rs_b * nr + rs_c * da + rs_dd * 
+ nr * nr + rs_e) * ((0.0026 * (temp - 25) + 1) ** (0.5))
ls1 ( n11 n1 ) inductor l=(ls_a * nr ** (ls_b) * da ** (ls_c) * do ** (ls_d) + ls_e 
+ * nr ** (ls_f) + ls_g) * 1e-9
ls2 ( n22 n2 ) inductor l=(ls_a * nr ** (ls_b) * da ** (ls_c) * do ** (ls_d) + ls_e 
+ * nr ** (ls_f) + ls_g) * 1e-9
rs2 ( n22 bottom ) resistor r=(rs_a * nr * da * da + rs_b * nr + rs_c * da + rs_dd 
+ * nr * nr + rs_e) * ((0.0026 * (temp - 25) + 1) ** (0.5))
 
cox1 ( top sub1 ) capacitor c=(cox_1) * ((1 / (11.4174 + (2.37149) * (lay - 4))) 
+ / (0.0478392)) * 1e-15 * cm8_indfac
cox2 ( bottom sub2 ) capacitor c=(cox_2) * ((1 / (11.4174 + (2.37149) * (lay - 4))) 
+ / (0.0478392)) * 1e-15 * cm8_indfac
cox3 ( n3 sub3 ) capacitor c=(cox_1 + cox_2) * ((1 / (11.4174 + (2.37149) * (lay 
+ - 4))) / (0.0478392)) * 1e-15 * cm8_indfac
 
csub1 ( sub1 gnode ) capacitor c=(csub_1) * csub_indfac
csub2 ( sub2 gnode ) capacitor c=(csub_2) * csub_indfac
csub3 ( sub3 gnode ) capacitor c=(csub_1 + csub_2) * csub_indfac
rsub1 ( sub1 gnode ) resistor r=(rsub_1) * rsub_indfac
rsub2 ( sub2 gnode ) resistor r=(rsub_2) * rsub_indfac
rsub3 ( sub3 gnode ) resistor r=(rsub_1 * rsub_2 / (rsub_1 + rsub_2)) * rsub_indfac
 
rct ( n3 n4 ) resistor r=(rct_a * nr + rct_b) * (0.0026 * (temp - 25) + 1) * rm8_indfac
lct ( n4 tap ) inductor l=(lct_a * nr * nr + lct_b * nr + lct_c) * 1e-9 * l_indfac
 
ends spiral_sym_ct


