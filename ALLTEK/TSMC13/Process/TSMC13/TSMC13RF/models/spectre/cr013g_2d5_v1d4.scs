inline subckt pmos_rf25_nw_mis ( d g s b ) 
parameters lr=30.0e-08 nr=1 wr=2.5e-6 temp1=parprf1_25 temp2=parprf2_25 fac1=0.887 
+ * temp1 + 0.461 * temp2 fac2=0.887 * temp1 - 0.461 * temp2 lef=lr - 4.0e-8 wef=wr 
+ + 1.0e-8 geo_fac=1 / sqrt(nr * lef * wef * 1e12) vthmis=0.003463 * geo_fac * fac1 
+ dlmis=0.002070 * geo_fac * lef * fac2 dwmis= - 0.002070 * geo_fac * wef * fac2 
+ toxmis=0.002070 * geo_fac * toxprf_25 * fac2 lspace=0.42u ledge=2.0u ledgeeff=0.73u 
+ lsti=1.0u wsti=2.0u rod=805 rsti=2148 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+ nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge + dummyflag * (ledgeeff - 
+ ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) ldios=(ns - 2) * lspace + 
+ sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 1) * lspace + nodd * sleff 
+ sdiofa=wr * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr 
+ * ldiod ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) 
+ * wr * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag rsx=(0.0158 * (lr * 1e6 
+ + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6) rdx=0.0053 
+ * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd + 0.0867 
+ / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96) / (lr * 
+ 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138 * wr * 
+ 1e6 + 0.718 * lr * 1e6 + 808 * lr / nr / wr + 1.589) lod=nr * (lr + lspace) + 
+ 2 * ledge - lspace rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 + rsti 
+ * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr / 12 
+ + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr * 1e6 + 
+ 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19 * nr 
+ * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6 / (lr 
+ * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15 sax=1 
+ / (log((ledge + lr / 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr 
+ + lspace)) / (ledge + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr 
+ + lspace)) + 1 / (nr * (ledge + lr / 2))) - lr / 2 
 
