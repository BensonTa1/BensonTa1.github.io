section rf_res_rpo
subckt rppolywo_rf ( hi lo gnode )
parameters l=10u w=5u mf=1 rsh=rppolywo rend0=1.01e-04 dl=0.04698u dw=0.07953u pt=temp
+ pvce1=-9.40e-02 pvce2=6.39e+01 pvce3=-2.71e+00 ptce1=-1.71e-03 ptce2=1.06e-06
+ pvcp1=-1.99e-01 pvcp2=6.05e-06 pvcp3=-3.23e+00 ptcp1=-1.19e-04 ptcp2=6.54e-07
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) rsubtfac=1.0 + 3.74m
+ * (pt - 25.0) + 9.1u * (pt - 25.0) * (pt - 25.0) rsubx=607.2 / ((1 / (1u + (l
+ - dl + 0.9u) / 6) * (w - dw)) + (1 / (3u + (w - dw) / 6) * (l - dl + 0.9u))) *
+ rsubtfac
rend1 ( hi 1 ) bsource r=rend0 / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(hi,1))
+ + pvce3) - tanh(pvce3))) / mf
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * rpol_fac / mf
r1 ( 12 2 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/6 w=(w-dw) kf=1.25E-22 af=2 fexp=1.08 wdexp=1 ldexp=1
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * rpol_fac / mf
r2 ( 23 3 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/3 w=(w-dw) kf=1.25E-22 af=2 fexp=1.08 wdexp=1 ldexp=1
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * rpol_fac / mf
r3 ( 34 4 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/3 w=(w-dw) kf=1.25E-22 af=2 fexp=1.08 wdexp=1 ldexp=1
r4 ( 4 45 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/6 w=(w-dw) kf=1.25E-22 af=2 fexp=1.08 wdexp=1 ldexp=1
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * rpol_fac / mf
rend2 ( 5 lo ) bsource r=rend0 / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(5,lo))
+ + pvce3) - tanh(pvce3))) / mf
cox1 ( 2 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * rpocox_fac * mf
cox2 ( 3 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * rpocox_fac * mf
cox3 ( 4 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * rpocox_fac * mf
rsub ( 6 gnode ) resistor r=rsubx * rporsub_fac / mf
csub ( 6 gnode ) capacitor c=197f / rsubx * rpocsub_fac * mf
ends rppolywo_rf

