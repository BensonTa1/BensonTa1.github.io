+ mj=0.3952264              fc=0                      cjsw=7.7e-11*cjsw_d_25
+ area=3.92e-8              mjsw=0.0450429            tlevc=1
+ tlev=1                    xti=3                     eg=1.17
+ vjsw=0.854899             vj=0.854899               pta=1.603538e-3
+ tnom=25                   ptp=1.603538e-3           tbv1=-1*-8.1e-4
+ trs=2.89e-3               cta=9.016089e-4           ctp=1.793034e-4
+ ns=1.05*n_d_25            nz=1.05*n_d_25            imax=1e40
+ minr=1e-3                 allow_scaling=1
// 
//  *************************************************************
