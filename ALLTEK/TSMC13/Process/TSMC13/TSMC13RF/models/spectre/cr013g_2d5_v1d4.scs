subckt moscap_rf ( gate bulk gnode ) 
parameters wr=2u lr=0.4u gr=2 br=32 cmin_p=1.0e-16 l_eff=(lr - 2 * dlcrf) * gr * 
+ br w_eff=(wr - 2 * dwcrf) * gr * br a_eff=(l_eff * w_eff) / gr / br dt=temp 
+ - 25 dvgs= - 0.05 * (1 + 3.6e-03 * dt) vgnorm=0.35 * (1 + 2.03e-03 * dt) forward_eff=a_eff 
+ * 6e2 gtmp=50e-12 varbf=2.2 rev_eff=a_eff * 1.5e1 varbr=0 ld2d=lr + 2 * 1.1e-7 
+ rdm11=0.10482 * (wr + 4.40e-07) / 2e-7 rdcont=12.4911 / int(abs((wr - 0.3e-6) 
+ / 0.34e-6 + 1.00001)) rwell=413.69 * (lr / 4 + 1.1e-7 + 2e-7 / 2) / wr rrrd=0.718 
+ + (gr - 1) * (2 * gr - 1) / (6 * gr) * rdm11 + (rwell / 2 + rdcont) / gr rdvia_array=0.75 
+ * 0.79983 / ((2 * 9.8e-7 + br * ld2d + (br + 1) * 2e-7) / 0.48e-6 / (br + 1) * 
+ 2) rrd=rrrd + rdvia_array rdm1=0.10482 * (2e-7 + ld2d) / 1e-06 rdm2=0.05967 * 
+ (2e-7 + ld2d) / 2.63e-06 rdmhead=1 / (1 / rdm1 + 1 / rdm2) rd=(rdmhead / 2 + ((br 
+ + 1) / 2 - 1) * br / (6 * ((br + 1) / 2)) * rdmhead + rrd / ((br + 1) / 2)) / 
+ 2 rgm11=0.10482 * wr / 2e-7 rpo=6.80368 * (wr / 2) / (2 * 2e-7) rrrg=0.52 + (gr 
+ + 1 - 1) * (2 * (gr + 1) - 1) / (6 * (gr + 1)) * rgm11 + (rpo / 2 + 10.95169) 
+ / (gr + 1) avrrrg=rrrg / (int(abs((lr - 0.3e-6) / 0.34e-6) + 1.00001)) rgviaarray=0.75 
+ * 0.79983 / ((2 * 1.36e-6 + (br - 1) * 5.6e-7 + br * 2e-7) / 0.48e-6 / br * 2) 
+ rrg=avrrrg + rgviaarray rgm1=0.10482 * (lr + 5.6e-7) / 1e-06 rgm2=0.05967 * (lr 
+ + 5.6e-7) / 2.63e-06 rgmhead=1 / (1 / rgm1 + 1 / rgm2) rgg=(rgmhead / 2 + (br 
+ / 2 - 1) * (br - 1) / (6 * (br / 2)) * rgmhead + rrg / (br / 2)) / 2 ww=wr * gr 
+ + 4.40e-07 * (gr - 1) ll=lr * br + (br - 1) * 4.2e-7 + 2 * 3.6e-7 wtub=ww + 2 
+ * 1.41e-6 ltub=ll + 2 * 1.41e-6 area_dio=wtub * ltub pj_dio=2 * (wtub + ltub) 
+ rwsti=873.4 * 3e-6 / ll rwod=513.2 * ww / 6 / ll rlsti=873.4 * 3e-6 / ww rlod=513.2 
+ * ll / 6 / ww rrsub=1 / (2 / (rwsti + rwod) + 2 / (rlsti + rlod)) rsub=(rrsub 
+ + 27.32) * (1 + 3.74m * dt + 9.1u * dt * dt) 
 
 
 
lgate ( gate 1 ) inductor l=l_mvfacrf * (2.393 * ((wr * 1e6) ** 1.6319) * ((lr * 
+ 1e6) ** ( - 1.5765)) * (gr ** ( - 3.4796)) * (br ** ( - 0.8654)) - 0.0273 * (wr 
+ * 1e6) - 0.2596 / (lr * 1e6) + 0.7668 * gr + 5.1437 / br - 0.2041) * 1e-12
rgate ( 1 2 ) resistor r=rm_mvfacrf * (rgg + 30.7549 / (wr * 1e6) / (lr * 1e6) / 
+ br / gr + 0.4142 * (wr * 1e6) * (lr * 1e6) + 0.0079 / gr * br - 0.632248) * (1 
+ + 2.6m * dt + 8.94u * dt * dt)
//cgate ( 2 3 ) bsource c=((cmin_arf * a_eff + 2 * cmin_lrf * l_eff + 2 * cmin_wrf * w_eff 
//+ + cmin_p) + (dcgarf * a_eff + 2 * dcgwrf * w_eff) * (1.0 + tanh((v(2,3) - dvgs) / 
//+ vgnorm)))
cgate ( 2 3 ) bsource q=((cmin_arf * a_eff + 2 * cmin_lrf * l_eff + 2 * cmin_wrf * w_eff 
+ + cmin_p + (dcgarf * a_eff + 2 * dcgwrf * w_eff))*v(2,3) + vgnorm*(dcgarf * a_eff + 2 * dcgwrf * w_eff) * log(cosh((v(2,3) - dvgs) / 
+ vgnorm)))
gdf1 ( 2 3 ) bsource i =fac_varrf * (forward_eff * pow((abs(v(2,3)) + v(2,3)) / 
+ 2,varbf + 2) + gtmp * (abs(v(2,3)) + v(2,3)) - rev_eff * pow((abs(v(2,3)) - v(2,3)) 
+ / 2,varbr + 2))
rsd ( 3 4 ) resistor r=rm_mvfacrf * rd * (1 + 2.93m * dt)
lsd ( 4 bulk ) inductor l=l_mvfacrf * (2.393 * ((wr * 1e6) ** 1.6319) * ((lr * 1e6) 
+ ** ( - 1.5765)) * (gr ** ( - 3.4796)) * (br ** ( - 0.8654)) - 0.0273 * (wr * 1e6) 
+ - 0.2596 / (lr * 1e6) + 0.7668 * gr + 5.1437 / br - 0.2041) * 1e-12
dio ( 5 3 ) mvdnwpsub area=area_dio pj=pj_dio
r_sub ( 5 gnode ) resistor r=rsub_mvfacrf * rsub
c_sub ( 5 gnode ) capacitor c=csub_mvfacrf * 197f / rsub
ends moscap_rf
 
