// 
// **************************************************************
//                                                              *
//  Junction DIODE MODELS for 1.2V Ultra High Vt device process *
//                                                              *
// **************************************************************
// 

section dio_uhvt
// 
// **************************************************************
//                       MODEL OF N+/PW DIODE                   *
// **************************************************************
model ndio_uhvt diode 
+ level=1                   n=1.01*n_d_uhvt           is=2.000e-07*is_d_uhvt
+ isw=7.500e-13*jsw_d_uhvt  rs=1.000e-10*rs_d_uhvt    bv=10.5
+ ibv=0.03                  fc=0                      cj=1.323e-03*cj_d_uhvt
+ vj=0.8                    mj=0.48                   cjsw=1.439e-10*cjsw_d_uhvt
+ vjsw=0.74                 mjsw=0.35                 cta=9.500e-04
+ ctp=4.800e-04             pta=1.500e-03             ptp=9.000e-04
+ tlev=1                    eg=1.170                  xti=3
+ tlevc=1                   trs=2.500e-03             tbv1=-1*-0.00085
+ tnom=25                   ns=1.01*n_d_uhvt          nz=1.01*n_d_uhvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// **************************************************************
//                       MODEL OF P+/NW DIODE                   *
// **************************************************************
model pdio_uhvt diode 
+ level=1                   n=1.01*n_d_uhvt           is=1.300e-07*is_d_uhvt
+ isw=4.500e-13*jsw_d_uhvt  rs=1.000e-10*rs_d_uhvt    bv=8.4
+ ibv=0.03                  fc=0                      cj=1.458e-03*cj_d_uhvt
+ vj=0.8                    mj=0.41                   cjsw=7.533e-11*cjsw_d_uhvt
+ vjsw=0.74                 mjsw=0.049                cta=8.466e-04
+ ctp=1.509e-04             pta=1.500e-03             ptp=2.300e-03
+ tlev=1                    eg=1.170                  xti=3
+ tlevc=1                   trs=2.500e-03             tbv1=-1*-0.0009
+ tnom=25                   ns=1.01*n_d_uhvt          nz=1.01*n_d_uhvt
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
endsection dio_uhvt
