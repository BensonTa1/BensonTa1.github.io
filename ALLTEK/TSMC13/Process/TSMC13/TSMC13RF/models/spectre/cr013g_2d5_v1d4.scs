rsb ( sb bi ) resistor r=rdbx tc1=0.00374 tc2=9.10e-6
csb ( sb bi ) capacitor c=169f / rdbx
pmos_rf_nw ( di gi si bi ) pch_rf l=lr w=wr m=nr ad=0 as=0 pd=0 ps=0 sa=sax sb=sax
gdf1 ( di gi ) bsource i =forward_eff * pow((abs(v(di,gi)) + v(di,gi)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(di,gi)) - v(di,gi)) / 2,tmp2) + 1e-18 * v(di,gi)
gdf2 ( si gi ) bsource i =forward_eff * pow((abs(v(si,gi)) + v(si,gi)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(si,gi)) - v(si,gi)) / 2,tmp2) + 1e-18 * v(si,gi)
ends pmos_rf_nw
