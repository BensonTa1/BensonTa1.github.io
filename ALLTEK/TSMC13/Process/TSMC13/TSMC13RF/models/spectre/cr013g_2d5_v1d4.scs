+ + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr * dummyflag ddiogp=wr 
+ * nr + nodd * wr * dummyflag rsx=(0.0158 * (lr * 1e6 + 0.42) * (2 * ns + 1 / ns 
+ - 3) + 0.771 / ns + 0.232) / (wr * 1e6) rdx=0.0053 * (lr * 1e6 + 0.42) * (nd + 
+ 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd + 0.0867 / (1.2 + (nd - 1) * (lr * 1e6 
+ + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96) / (lr * 1e6 - 0.02) + 6.46) / nr + nr 
+ * (0.000286 * wr * 1e6 + 0.0139) + 0.0138 * wr * 1e6 + 0.718 * lr * 1e6 + 808 
+ * lr / nr / wr + 1.589) lod=nr * (lr + lspace) + 2 * ledge - lspace rbx=(rod * 
+ lod / 12 + rsti * lsti / 2) * (rod * wr / 12 + rsti * wsti / 2) / (lod * (rod 
+ * lod / 12 + rsti * lsti / 2) + wr * (rod * wr / 12 + rsti * wsti / 2)) rdbx=rod 
+ * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr * 1e6 + 0.42) / (0.1 * wr * 1e6 + 2.9) 
+ + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19 * nr * lr * 1e6 + 0.07 * nr + 0.282) 
+ * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6 / (lr * 1e6 + 0.6) + 1.8 * nr * (lr 
+ * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15 sax=1 / (log((ledge + lr / 2 + nr * 
+ (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge + lspace 
+ + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr * (ledge 
+ + lr / 2))) - lr / 2 
 
// ********************
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
// ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
// **** Diodes  ****************
dss ( si sb ) pdio_rf25_f area=sdiofa pj=sdiofp
ddd ( di db ) pdio_rf25_f area=ddiofa pj=ddiofp
dsg ( si sb ) pdio_rf25_g area=1e-15 pj=sdiogp
ddg ( di db ) pdio_rf25_g area=1e-15 pj=ddiogp
