+ * sqrt(lum * wum) + ( - 0.030696) * sqrt(lum * wum) * nf + 2.742608) * 1e-15 c_sti=(( 
+ - 0.112288) * nf + ( - 0.013586) * lum + (0.130999) * wum + (0.031009) * lum * 
+ wum * nf + (0.006041) * lum * wum + (0.023377) * lum * nf + (0.120170) * wum * 
+ nf + ( - 0.033538) * sqrt(wum * lum) + ( - 0.112984)) * 1e-15 c_pp=(( - 0.282619) 
+ * nf + ( - 1.328147) * lum + ( - 0.115162) * wum + (0.017999) * lum * wum * nf 
+ + ( - 0.043202) * lum * wum + (0.412528) * lum * nf + (0.011854) * wum * nf + 
+ (0.751030) * sqrt(wum * lum) + (2.692831)) * 1e-15 is_fdiode1_wi=(( - 30.7221) 
+ * lum + ( - 41.6847) * wum + ( - 665.5646) / nf + ( - 7.0269) * lum * wum + ( 
+ - 183.3680) * lum / nf + ( - 120.9697) * wum / nf + ( - 47.1611) * lum * wum / 
+ nf + (978.5453) * sqrt(wum * lum) / nf + 261.7520 * sqrt(wum * lum) + ( - 78.4284)) 
+ * factor_isf_wi n_fdiode1_wi=(0.088201) / lum + (0.028120) / wum + ( - 0.027211) 
+ / lum / wum + (0.007037) * lum + ( - 0.000642) * wum + 0.884969 cj_fdiode1_wi=(( 
+ - 0.001644) / lum + ( - 0.001983) / wum + (0.001299) / lum / wum + ( - 0.000017) 
+ * lum + (4.125926e-06) * wum + (0.004069)) * factor_cjf_wi mj_fdiode1_wi=(0.036552) 
+ / lum + (0.104677) / wum + ( - 0.451701) / lum / wum + (0.0128) * lum + (0.000296) 
