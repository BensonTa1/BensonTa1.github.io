inline subckt pmos_rf_nw_mis ( d g s b ) 
parameters lr=13.e-08 nr=1 wr=2.5e-6 lspace=0.42u ledge=2.0u ledgeeff=0.73u lsti=1.0u 
+ wsti=2.0u rod=805 rsti=2148 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+ nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge 
+ + dummyflag * (ledgeeff - ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) 
+ ldios=(ns - 2) * lspace + sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 
+ 1) * lspace + nodd * sleff lod=nr * (lr + lspace) + 2 * ledge - lspace sdiofa=wr 
+ * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr * ldiod 
+ ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr 
+ * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag sax=1 / (log((ledge + lr / 
+ 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge 
+ + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr 
+ * (ledge + lr / 2))) - lr / 2 rsx=(0.0158 
+ * (lr * 1e6 + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6) 
+ rdx=0.0053 * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd 
+ + 0.0867 / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96) 
+ / (lr * 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138 
+ * wr * 1e6 + 0.718 * lr * 1e6 + 1223 * lr / nr / wr + 4.689) 
+ rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 + 
+ rsti * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr 
+ / 12 + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr * 
+ 1e6 + 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19 
+ * nr * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6 
+ / (lr * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15 
+ jf=1.1575e-07 ef=7.127e+06 jr=2.8e-8 er=4.373e6 
+ w1=(wr + 0.015e-6 + dxwrf) * nr l1=lr + dxlrf - 0.02e-6 tox=(toxprf - 8e-10) * 
+ 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 * 1e4 * tcc varaf= - 0.70902 
+ * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 * er * tox varar= - 0.31121 
+ * log(l1) + 24.530 forward_eff=area * jf * exp( - ef * tox * varaf) / pow(tox,2.5) 
+ reverse_eff=area * jr * exp( - er * tox * varar) / pow(tox,2.5) tmp1=varbf + 2.0 
+ tmp2=varbr + 2.0 temp1=parprf1 temp2=parprf2 fac1=0.778 
+ * temp1 + 0.629 * temp2 fac2=0.778 * temp1 - 0.629 * temp2 lef=lr - 2.0e-8 wef=wr 
+ + 1.5e-8 geo_fac=1 / sqrt(nr * lef * wef * 1e12) vthmis=0.002585 * geo_fac 
+ * fac1 dlmis=0.001932 * geo_fac * lef * fac2 dwmis= - 0.001932 * geo_fac * wef 
+ * fac2 toxmis=0.001932 * geo_fac * toxprf * fac2 
 
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
//  ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
//  *** Diodes  ****************
dss ( si sb ) pdio_rf_f area=sdiofa pj=sdiofp
ddd ( di db ) pdio_rf_f area=ddiofa pj=ddiofp
dsg ( si sb ) pdio_rf_g area=1e-15 pj=sdiogp
ddg ( di db ) pdio_rf_g area=1e-15 pj=ddiogp
