parameters l=1u w=1u factor=1 multi=1 sa=0.35u sb=0.35u ad=2 * hdifp_lvt25 / factor 
+ * w as=2 * hdifp_lvt25 / factor * w pd=2 * (2 * hdifp_lvt25 / factor + w) ps=2 * 
+ (2 * hdifp_lvt25 / factor + w) nrd=hdifp_lvt25 / factor / w nrs=hdifp_lvt25 / factor 
