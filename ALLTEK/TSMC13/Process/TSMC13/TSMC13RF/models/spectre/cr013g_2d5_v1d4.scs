//  *********************************************************************
//              	              RTMOM                                   *
//  *********************************************************************
//  *********** Library of typical corner *******************************
section tt_rtmom
parameters rtmom_fac=1
include "cr013g_2d5_v1d4.scs" section=rtmom
endsection tt_rtmom




 
//  *********** Library of slow corner **********************************
 
section ss_rtmom
parameters rtmom_fac=1.25
include "cr013g_2d5_v1d4.scs" section=rtmom
endsection ss_rtmom




 
//  *********** Library of fast corner **********************************
 
section ff_rtmom
parameters rtmom_fac=0.75
include "cr013g_2d5_v1d4.scs" section=rtmom
endsection ff_rtmom




 
//  **********************************************************************
 
section rtmom
 
//  **************************************************************************************
//                                                                              
//          *                                                         *
//                         RTMOM with  Width = 0.2um                            
//          *
//                                                                              
//          *
//                         parameter range: nv : 8~288, nh : 8~288              
//          *
//                                          nv and nh should be even fingers    
//          *
//                                          s(spacing):0.21u ~0.4u              
//          *
//                                          lay(MOM layer number): 3~6          
//          *
//                                                                              
//          *
//                                                                              
//          *                                                      *
//  **************************************************************************************
subckt crtmom ( a b p ) 
parameters nv=32 nh=32 s=0.21u lay=6 edg=((int((lay - 1) / 2) + 2600 / 3700) * (nv 
+ - 1) * (nh * (0.2u + s) - s) + int(lay / 2) * (nh - 1) * (nv * (0.2u + s) - s)) 
+ area=(nv * nh / 2 * 0.2u * 0.2u * (lay - 1)) fri2=((int((lay + 1) / 2) * nv * 
+ 0.2u + int(lay / 2) * nh * 0.2u) + 0.21u * 2 * lay + int(lay / 2) * (nv * (0.2u 
+ + s) - s + 0.5u) * 2 + int((lay + 1) / 2) * (nh * (0.2u + s) - s ) * 2) 
+ fri1=((nh * nv / 2 * 0.2u * 4) * (lay - 1)) abm=(((nv * (0.2u + s) - s + 0.71u 
+ * 2) + (nh * (0.2u + s) - s + 0.5u)) * 0.21u) afm=(nv * 0.2u * (nh * (0.2u + s) 
+ - s + 0.5u) / 2) pf=((nh * (0.2u + s) - s + 0.5u) * (nv) + 2 * ((nv * (0.2u + 
+ s) - s + 1.42u) + (nh * (0.2u + s) - s + 0.71u)))  
+ cc1=0.42 * s ** 2 * 1e12 - 0.4714 * s * 1e6 + 0.1865 cc2=0.0532 cf= - 0.001 * s 
+ * s * 1e12 + 0.0277 * s * 1e6 + 0.004 ca=( - 0.0333 * s * s * 1e12 + 0.0373 * 
+ s * 1e6 + 0.0106) / 0.2 ca_p=( - 0.0931 * s * s * 1e12 + 0.0767 * s * 1e6 + 0.0152) 
+ / 0.2 cf_p=0.014 * s * s * 1e12 + 0.0298 * s * 1e6 + 0.0063 
// 
cab ( a b ) bsource q=(cc1 * edg * 1e-9 + cf * 1e-9 * fri1 + ca * 1e-3 * area 
+ + cc2 * 1e-9 * fri2) * (1 + (temp - 25) * 30.36 * 1e-6 + (temp - 25) * (temp 
+ - 25) * 1e-8) * (v(a,b) - 2.65 * 1e-6 /2 * v(a,b) **2 - 0.1 * 1e-6 /3 * v(a,b) **3) * 
+ rtmom_fac
cpa ( a p ) bsource q=(ca_p * (abm + afm) * 1e-3 + cf_p * pf * 1e-9)  * (1 + 
+ (temp - 25) * 30.36 * 1e-6 + (temp - 25) * (temp - 25) * 1e-8) * (v(a,p) - 2.65 
+ * 1e-6 /2 * v(a,p) **2 - 0.1 * 1e-6 /3 * v(a,p) **3 ) * rtmom_fac
cpb ( b p ) bsource q=(ca_p * (abm + afm) * 1e-3 + cf_p * pf * 1e-9)  * (1 + 
+ (temp - 25) * 30.36 * 1e-6 + (temp - 25) * (temp - 25) * 1e-8) * (v(b,p) - 2.65 
+ * 1e-6 /2 * v(b,p) **2 - 0.1 * 1e-6 /3 * v(b,p) **3 ) * rtmom_fac
 
ends crtmom
 
endsection rtmom




endlibrary tsmclib
