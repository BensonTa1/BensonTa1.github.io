section tt_dio
parameters is_d=1
parameters jsw_d=1
parameters n_d=1
parameters rs_d=1
parameters cj_d=1
parameters cjsw_d=1
include "cr013g_2d5_v1d4.scs" section=dio
endsection tt_dio
//  ****************** CORNER_LIB OF SLOW MODEL ****************************
section ss_dio
parameters is_d=0.7
parameters jsw_d=0.5
parameters n_d=1.0025
parameters rs_d=1.2
parameters cj_d=1.05
parameters cjsw_d=1.1
include "cr013g_2d5_v1d4.scs" section=dio
endsection ss_dio
//  ****************** CORNER_LIB OF FAST MODEL ****************************
section ff_dio
parameters is_d=1.3
parameters jsw_d=2
parameters n_d=0.9975
parameters rs_d=0.8
parameters cj_d=0.95
parameters cjsw_d=0.9
include "cr013g_2d5_v1d4.scs" section=dio
endsection ff_dio
// 
//  *************************************************************
//                                                              *
//        Junction DIODE MODELS  for 1.2V device process        *
//                                                              *
//  *************************************************************
// 
section dio
// 
//  *************************************************************
//                       MODEL OF N+/PW DIODE                   *
//                                                              *
//  *************************************************************
//                                                                              
//   
model ndio diode 
+ level=1                   is=8.00e-7*is_d           rs=1.00e-10*rs_d
+ n=1.02*n_d                bv=10.6                   ibv=0.05
+ isw=1.55e-13*jsw_d        cj=0.001376*cj_d          vj=0.7956
+ mj=0.4528                 cjsw=2.06e-10*cjsw_d      vjsw=0.7956
+ mjsw=0.2323               tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-0.000888         trs=0.00277
+ tlevc=1                   cta=0.0009067             ctp=0.0002781
+ pta=0.001427              ptp=0.001427              tnom=25
+ fc=0                      fcs=0                     area=3.92e-08
+ pj=0.00084                ns=1.02*n_d               nz=1.02*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
//                                                                              
//       
//  *************************************************************
//                       MODEL OF P+/NW DIODE                   *
//                                                              *
//  *************************************************************
//                                                                              
//   
model pdio diode 
+ level=1                   is=1.80e-7*is_d           rs=1.00e-10*rs_d
+ n=1.02*n_d                bv=8.4                    ibv=0.02
+ isw=6.60e-14*jsw_d        cj=0.001369*cj_d          vj=0.9
+ mj=0.4234                 cjsw=9.8e-11*cjsw_d       vjsw=0.9
+ mjsw=0.1716               tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-0.000845         trs=0.00289
+ tlevc=1                   cta=0.000887              ctp=0.000298
+ pta=0.001643              ptp=0.001643              tnom=25
+ fc=0                      fcs=0                     area=3.92e-08
+ pj=0.00084                ns=1.02*n_d               nz=1.02*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
//  
//  *************************************************************
//                       MODEL OF NW/PSUB DIODE                 *
//                                                              *
//  *************************************************************
//  
model nwdio diode 
+ level=1                   is=6.20e-7*is_d           rs=1.00e-10*rs_d
+ n=1.02*n_d                bv=13.6                   ibv=0.01
+ isw=3.17e-12*jsw_d        cj=0.0001291*cj_d         vj=0.8122
+ mj=0.4897                 cjsw=5.35e-10*cjsw_d      vjsw=0.8122
+ mjsw=0.2822               tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-1.29e-3          trs=0.00204
+ tlevc=1                   cta=0.002483              ctp=0.001238
+ pta=0.003184              ptp=0.003184              tnom=25
+ fc=0                      fcs=0                     area=3.92e-08
+ pj=0.00084                ns=1.02*n_d               nz=1.02*n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
//                                         
endsection dio
// 
// 
//  *************************************************************
//                                                              *
//                DNW Junction DIODE Corner MODELS              *
//                                                              *
//  *************************************************************
//  ****************** CORNER_LIB OF TYPICAL MODEL *************************
section tt_dio_dnw
parameters is_d_dnw=1
parameters jsw_d_dnw=1
