section mac
 
inline subckt nch_g ( n11 n2 n33 n4 ) 
parameters l=1u w=1u multi=1 factor=1 sa=0.35u sb=0.35u ad=2 * hdifn / factor 
+ * w as=2 * hdifn / factor * w pd=2 * (2 * hdifn / factor + w) ps=2 * (2 * hdifn 
+ / factor + w) nrd=hdifn / factor / w nrs=hdifn / factor / w w1=(w * factor + 0.015e-6 
+ + dxw) * multi l1=l * factor - 0.02e-6 + dxl tcc=1 + 1.7e-3 * (temp - 25) area=w1 
+ * 2.5e-9 * 1e4 * tcc tox=(toxn - 8.3e-10) * 1e2 jf=2.704e-08 ef=2.623e+07 varaf= 
+ - 0.18955 * log(l1) + 0.99251 varbf=0.54 * ef * tox jr=5.065e-7 er=7.43e6 varar= 
+ - 0.072266 * log(l1) + 16.394 varbr=0.52 * er * tox forward_eff=area * jf * exp( 
+ - ef * tox * varaf) / pow(tox,2.5) reverse_eff=area * jr * exp( - er * tox * varar) 
+ / pow(tox,2.5) tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
nch_g ( n1 n2 n3 n4 ) nch w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ sa=sa sb=sb
 
gdf1 ( n2 n1 ) bsource i =forward_eff * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,tmp2) + 1e-18 * v(n2,n1)
 
gdf2 ( n2 n3 ) bsource i =forward_eff * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,tmp2) + 1e-18 * v(n2,n3)
 
rdn ( n1 n11 ) resistor r=6.6 * nrd / multi
rsn ( n3 n33 ) resistor r=6.6 * nrs / multi
ends nch_g
 
inline subckt pch_g ( p11 p2 p33 p4 ) 
parameters l=1u w=1u multi=1 factor=1 sa=0.35u sb=0.35u ad=2 * hdifp / factor 
+ * w as=2 * hdifp / factor * w pd=2 * (2 * hdifp / factor + w) ps=2 * (2 * hdifp 
+ / factor + w) nrd=hdifp / factor / w nrs=hdifp / factor / w jf=1.1575e-07 ef=7.127e+06 
+ jr=2.8e-8 er=4.373e6 w1=(w * factor + 0.015e-6 + dxw) * multi l1=l * factor + dxl 
+ - 0.02e-6 tox=(toxp - 8e-10) * 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 
+ * 1e4 * tcc varaf= - 0.70902 * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 
+ * er * tox varar= - 0.31121 * log(l1) + 24.530 forward_eff=area * jf * exp( - 
+ ef * tox * varaf) / pow(tox,2.5) reverse_eff=area * jr * exp( - er * tox * varar) 
+ / pow(tox,2.5) tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
pch_g ( p1 p2 p3 p4 ) pch w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ sa=sa sb=sb
 
 
 
gdf1 ( p1 p2 ) bsource i =forward_eff * pow((abs(v(p1,p2)) + v(p1,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p1,p2)) - v(p1,p2)) / 2,tmp2) + 1e-18 * v(p1,p2)
 
gdf2 ( p3 p2 ) bsource i =forward_eff * pow((abs(v(p3,p2)) + v(p3,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p3,p2)) - v(p3,p2)) / 2,tmp2) + 1e-18 * v(p3,p2)
 
 
rdp ( p1 p11 ) resistor r=7.2 * nrd / multi
rsp ( p3 p33 ) resistor r=7.2 * nrs / multi
ends pch_g
// 
inline subckt nch_g_mis ( n11 n2 n33 n4 ) 
parameters l=1u w=1u factor=1 multi=1 sa=0.35u sb=0.35u ad=2 * hdifn / factor * w as=2 
+ * hdifn / factor * w pd=2 * (2 * hdifn / factor + w) ps=2 * (2 * hdifn / factor + 
+ w) nrd=hdifn / factor / w nrs=hdifn / factor / w w1=(w * factor + 0.015e-6 + dxw) 
+ * multi l1=l * factor - 0.02e-6 + dxl tcc=1 + 1.7e-3 * (temp - 25) area=w1 * 
+ 2.5e-9 * 1e4 * tcc tox=(toxn - 8.3e-10) * 1e2 jf=2.704e-08 ef=2.623e+07 varaf= 
+ - 0.18955 * log(l1) + 0.99251 varbf=0.54 * ef * tox jr=5.065e-7 er=7.43e6 varar= 
+ - 0.072266 * log(l1) + 16.394 varbr=0.52 * er * tox forward_eff=area * jf * exp( 
+ - ef * tox * varaf) / pow(tox,2.5) reverse_eff=area * jr * exp( - er * tox * varar) 
+ / pow(tox,2.5) 
 
xmain ( n1 n2 n3 n4 ) nch_mis  w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs multi=multi 
+ sa=sa sb=sb
 
parameters tmp1=varbf + 2.0
parameters tmp2=varbr + 2.0
gdf1 ( n2 n1 ) bsource i =forward_eff * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,tmp2) + 1e-18 * v(n2,n1)
 
gdf2 ( n2 n3 ) bsource i =forward_eff * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,tmp2) + 1e-18 * v(n2,n3)
 
rdn ( n1 n11 ) resistor r=6.6 * nrd / multi
rsn ( n3 n33 ) resistor r=6.6 * nrs / multi
ends nch_g_mis
 
inline subckt pch_g_mis ( p11 p2 p33 p4 ) 
parameters l=1u w=1u factor=1 multi=1 sa=0.35u sb=0.35u ad=2 * hdifp / factor * w as=2 
+ * hdifp / factor * w pd=2 * (2 * hdifp / factor + w) ps=2 * (2 * hdifp / factor + 
+ w) nrd=hdifp / factor / w nrs=hdifp / factor / w jf=1.1575e-07 ef=7.127e+06 jr=2.8e-8 
+ er=4.373e6 w1=(w * factor + 0.015e-6 + dxw) * multi l1=l * factor + dxl - 0.02e-6 
+ tox=(toxp - 8e-10) * 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 * 1e4 
+ * tcc varaf= - 0.70902 * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 * er 
+ * tox varar= - 0.31121 * log(l1) + 24.530 forward_eff=area * jf * exp( - ef * 
+ tox * varaf) / pow(tox,2.5) reverse_eff=area * jr * exp( - er * tox * varar) / 
+ pow(tox,2.5) tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
xmain ( p1 p2 p3 p4 ) pch_mis  w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs multi=multi 
+ sa=sa sb=sb
 
 
 
gdf1 ( p1 p2 ) bsource i =forward_eff * pow((abs(v(p1,p2)) + v(p1,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p1,p2)) - v(p1,p2)) / 2,tmp2) + 1e-18 * v(p1,p2)
 
gdf2 ( p3 p2 ) bsource i =forward_eff * pow((abs(v(p3,p2)) + v(p3,p2)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(p3,p2)) - v(p3,p2)) / 2,tmp2) + 1e-18 * v(p3,p2)
 
 
