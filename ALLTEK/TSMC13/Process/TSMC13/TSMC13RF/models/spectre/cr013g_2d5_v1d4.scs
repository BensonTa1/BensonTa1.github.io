+ cox_1=cox_a * nr * da + cox_b cox_2=cox_a * nr * da + cox_b rsub_1=(rsub_a / (nr 
+ * da) + rsub_b / da + rsub_c / nr + rsub_d) * ( - 0.0000114365 * (temp - 25) 
