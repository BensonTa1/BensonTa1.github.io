section rf_sbd
 
// ****************************************************************************
// ****                 Schottky Diode with Deep N-Well                   *****
// ****************************************************************************
 
subckt sbd_rf ( 1 2 3 ) 
parameters l=2e-006 w=16e-006 nf=16 lum=l * 1e6 wum=w * 1e6 num_strip=int(6 + (lum 
