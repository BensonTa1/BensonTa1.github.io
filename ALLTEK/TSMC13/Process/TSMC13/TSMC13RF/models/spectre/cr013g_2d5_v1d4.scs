//
//  **********************************************
simulator lang=spectre insensitive=yes
library tsmclib

// **********************************************
//             TSMC RF SPICE MODEL            *
// **********************************************
// This model has been modified for RF purpose.
//  
//    PROCESS :  0.13um Mixed-Signal SALICIDE(1P8M, 1.2V/2.5V)
//    MODEL   :  BSIM3 ( V3.24 )
//    DOC. NO.:  T-013-MM-SP-001  
//    VERSION :  1.4 
//    DATE    :  April. 30, 2009
//    SPECTRE VERSION : 6.2.1.170
//
//*********************************************************************************************
//   UPDATE HISTORY :
//
//      V0.1Z: Created 1.2V/2.5V NMOS and MOS varactor models.
//
//      V0.1p2: 
//           1. Created MIM capacitor models.
//           2. Created spiral inductor models.
//           3. Model for Mentor Graphic Eldo v5.4_1.1 and/or later version is added.
//
//      V0.1:   The same version as V0.1p2.
//
//      V0.2p1: Created 1.2V PMOS models.
//
//      V0.2p2: 
//           1. Created 2.5V PMOS models.
//           2. Created 2.5V MOS varactor model.
//           3. Updated 1.2V MOS varactor model.
//           4. Created P+/Nwell junction varactor model.
//           5. Added ADS V1.5 model.
//           6. Added interconnect model.
//
//      V0.2:
//           1. Correct typo in the document:
//              a. Correct the number of branches(B) of 1.2V/2.5V MOS varactor form B=15 to B=30.
//              b. Correct Fig. 6.1 and Fig. 6.5 from schematic layout to real layout.
//              c. Correct Fig. 8.20 to Fig 8.27 for the updated MOS varactor.
//           2. Modified node names in the model card for consistancy with the layout:
//              a. Changed node names of "nd ng ns nb" to "D G S B" respectively in the subcuit 1.2V/2.5V N/P MOS.
//              b. Changed node names of "n1 n2" to "Gate Bulk" respectively in the subcircuit MOS varactor.
//              c. Changed node names of "p1 p2" to "Top Bottom" respectively in the subcircuit MIM and spiral inductors.
//              d. Changed node names of "p1 p2" to "Anode Cathode" respectively in the subcircuit junction varactor.
//           3. Simplified the model cards by including the library RF_MACRO in TT_RFMOS.
//           4. Added VCR and TCR of M8T in the interconnect resistor table. 
//      
//      V0.3:
//           a. Revised MIMCAP model.
//           b. Revised Inductor model.
//           c. Revised Interconnect model.
// 
//      V1.0:
//           a. Updated MOS model
//           b. Updated MIM capacitor model.
//           c. Updated inductor model.
//           d. Updated MOS varactor model.
//           e. Updated Junction varactor model.
//           f. Add resistor model.
//           g. Updated interconnect model.
//
//      V1.1:
//           a. Updated spectre model card of MIM for convergency issue.
//              Updated MIM target and tightened corner.
//           b. Updated leakage current of 1.2V MOS Varactor 
//           c. Updated corner model of 1.2V and 2.5V MOS Varactor.	
//           d. Updated distributed resistor model
//           e. Added HRI resistor rf model
//
//      V1.2:
//	    a. Added 1.2 CMOS statistical model
//	    b. Revised 1.2 CMOS corner model
//	    c. Added 1.2 CMOS mismatch model
//	    d. Added Resistor mismatch model
//	    e. Added 1.2/2.5V PMOS model without DNW
// 	    f. Added 1.0fF MiM_Cap without underground metal and 1.5fF MiM_Cap wi/wo underground metal 
//	    g. Added Center-tapped inductor
//	    h. Added Xj varactor without DNW
//	    i. Updated 1.2/2.5V MOS Varactor W/L/G/B 4D scalable model
//	    j. Added 1.2/2.5V MOS Varactor without DNW
//	    k. Updated interconnect model
//          l. Revised the MOS model format from subckt to inline subckt in SPECTRE
//          m. Rename the parameter "scale" to "scale1" to avoid using ".option nokwscale" in netlist in ELDO
//          n. Add ResModel.eldo in ELDO 
//
//      V1.3: 
//           a. Added 1.2V hvt, 1.2V lvt, 2.5V svt and 2.5V lvt CMOS mismatch model
//           b. Added RTMOM Baseband capacitor model
//           c. Added mismatch model of 1.0fF/um^2 and 1.5fF/um^2 MIM
//           d. updated 1.2V svt mismatch model from 3 wafer data to 3 lot data
//
//      V1.4p1: Correct the SPECTRE model card by adding the missed "stat_res" section for mismatch simuation of resistors  
//
//      V1.4: (April. 30, 2009)
//           a. Update rmu corner values
//           b. Update BB based on cm013g_fsg v2.4 (Apr-03-08)
//           c. Update RFCMOS Lod equation about 'sax' and diodes 'AREA' and 'PJ' equations
//           d. Add schottky barrier diode model
//           e. Corner tighten of RF model (nmos_rf & nmos_rf25)
//           f. Modified the inductor equation in rf_jvar to avoid the negative inductance issue.
//           g. Adding flicker noise model for n+ & p+ poly w/o silicide and HRI resistor.
//           h. Updated the BJT model, aligning with current Design Rule to better reflect silicon.
//           i. Adding flicker noise model for 1.2 and 2.5V native devices
//           j. Gate current equation in Spectre format
//	     k. Remove guess statistical model(BB & RF)(wait for Si data validation)
//           l. Remove ADS model card version
//           m. Rename model card name rf013(1.2/2.5V 0.13um RF model card) as cr013g_2d5_v1d4
//
//*******************************************************************************************
//  THIS MODEL LIB CONTAINS RF MODEL                                                          *
//   A. RF model contains:                                                                  *
//                                                                                          *
//       1. 1.2V nominal Vt N/PMOS corner                                                   *
//                                                                                          *
//          a.LIB TT_RFMOS:Typical RF model                                                 *
//                                                                                          *
//          b.LIB FF_RFMOS:Fast N Fast P corner RF model                                    *
//                                                                                          *
//          c.LIB SS_RFMOS:Slow N Slow P corner RF model                                    *
//                                                                                          *
//          d.LIB SF_RFMOS:Slow N Fast P corner RF model                                    *
//                                                                                          *
//          e.LIB FS_RFMOS:Fast N Slow P corner RF model                                    *
//                                                                                          *
//       2. 2.5V nominal Vt N/PMOS corner                                                   *
//                                                                                          *
//          a.LIB TT_RFMOS25:Typical RF model                                               *
//                                                                                          *
//          b.LIB FF_RFMOS25:Fast N Fast P corner RF model                                  *
//                                                                                          *
//          c.LIB SS_RFMOS25:Slow N Slow P corner RF model                                  *
//                                                                                          *
//          d.LIB SF_RFMOS25:Slow N Fast P corner RF model                                  *
//                                                                                          *
//          e.LIB FS_RFMOS25:Fast N Slow P corner RF model                                  *
//                                                                                          *
//       3. MIM capacitor corner model                                                      *
//                                                                                          *
//          a.LIB TT_RFMIM:Typical model                                                    *
//                                                                                          *
//          b.LIB FF_RFMIM:Fast corner model                                                *
//                                                                                          *
//          c.LIB SS_RFMIM:Slow corner model                                                *
//                                                                                          *
//                                                                                          *
//       4. Inductor corner model                                                           *
//                                                                                          *
//          a.LIB TT_RFIND:Typical model                                                    *
//                                                                                          *
//          b.LIB FF_RFIND:Fast corner model                                                *
//                                                                                          *
//          c.LIB SS_RFIND:Slow corner model                                                *
//                                                                                          *
//                                                                                          *
//       5. 1.2V MOS varactor corner model                                                  *
//                                                                                          *
//          a.LIB TT_RFMVAR:Typical model                                                   *
//                                                                                          *
//          b.LIB FF_RFMVAR:Fast corner model                                               *
//                                                                                          *
//          c.LIB SS_RFMVAR:Slow corner model                                               *
//                                                                                          *
//                                                                                          *
//       6. 2.5V MOS varactor corner model                                                  *
//                                                                                          *
//          a.LIB TT_RFMVAR_25:Typical model                                                *
//                                                                                          *
//          b.LIB FF_RFMVAR_25:Fast corner model                                            *
//                                                                                          *
//          c.LIB SS_RFMVAR_25:Slow corner model                                            *
//                                                                                          *
//                                                                                          *
//       7. P+/NW Junction varactor corner model                                            *
//                                                                                          *
//          a.LIB TT_RFJVAR:Typical model                                                   *
//                                                                                          *
//          b.LIB FF_RFJVAR:Fast corner model                                               *
//                                                                                          *
//          c.LIB SS_RFJVAR:Slow corner model                                               *
//                                                                                          *
//                                                                                          *
//       8. Resistor corner model                                                           *
//                                                                                          *
//          i). Salicided poly resistor                                                     *
//                                                                                          *
//             (a).LIB TT_RFRES_SA:Typical model                                            *
//                                                                                          *
//             (b).LIB FF_RFRES_SA:Fast corner model                                        *
//                                                                                          *
//             (c).LIB SS_RFRES_SA:Slow corner model                                        *
//                                                                                          *
//          ii). Non-salicided P+ poly resistor                                             *
//                                                                                          *
//             (a).LIB TT_RFRES_RPO:Typical model                                           *
//                                                                                          *
//             (b).LIB FF_RFRES_RPO:Fast corner model                                       *
//                                                                                          *
//             (c).LIB SS_RFRES_RPO:Slow corner model                                       *
//                                                                                          *
//          iii). Non-salicided P- poly resistor                                            *
//                                                                                          *
//             (a).LIB TT_RFRES_HRI:Typical model                                           *
//                                                                                          *
//             (b).LIB FF_RFRES_HRI:Fast corner model                                       *
//                                                                                          *
//             (c).LIB SS_RFRES_HRI:Slow corner model                                       *
//                                                                                          *
//                                                                                          *
//      9. Distributed Resistor corner model                                                *
//                                                                                          *
//          a.LIB TT_DISRES:Typical model                                                   *
//                                                                                          *
//          b.LIB FF_DISRES:Fast corner model                                               *
//                                                                                          *
//          c.LIB SS_DISRES:Slow corner model                                               *
//                                                                                          *
//      10. Schottky barrier diode corner model                                             *
//                                                                                          *
//          a.LIB tt_rfsbd:Typical model                                                    *                                    
//                                                                                          *
//          b.LIB ff_rfsbd:Fast corner model                                                *
//                                                                                          *
//          c.LIB ss_rfsbd:Slow corner model                                                *
//                                                                                          *          
//          d.LIB mc_rfsbd:Monte-Carlo RF statistical model                                 *
//                                                                                          *
//*******************************************************************************************
//   **********************************************
//   *             TSMC SPICE MODEL               *
//   **********************************************
//   
//     PROCESS :  0.13um MIXED SIGNAL SALICIDE FSG IMD (1P8M,1.2V/2.5V) (CM013G)
//     MODEL   :  BSIM3 ( V3.24 )
//     DOC. NO.:  T-013-CM-SP-005    
//     VERSION :  2.4                           
//     DATE    :  April 3, 2008      
//     SPECTRE VERSION : 6.2.1.170
//     (The most updated SPECTRE version is suggested for circuit simulation.)
//  ****************************************************************************
// 
//        SPICE model release notes for HSPICE A-2008.03:
// 
// 
//  (1) 1.2V Standard Vt, 1.2V Low Vt, 1.2V High Vt, 1.2V Ultra High Vt and 2.5V devices
//      include Noise and LOD effect.
// 
//  (2) Native devices are without LOD effect.
// 
//  (3) For BSIM3 model, CALCACM is used in HSPICE A-2008.03.  For CALCACM >0,  the
//      default calculation of AS/AD and PS/PD will be calculated using HDIF.
//      When CALCACM=0, the default is zero for AS/AD and PS/PD.
// 
//  ****************************************************************************
//                                                                             *
//        IN THIS MODEL LIB CONTAINS :                                         *
//                                                                             *
//        1.LIB TT                                                             *
//              SS                                                             *
//              FF                                                             *
//              SF                                                             *
//              FS                                                             *
//    ( 1.2V Standard devices with different geometric and corner models)      *
//                                                                             *
//        2.LIB TT_g                                                           *
//              SS_g                                                           *
//              FF_g                                                           *
//              SF_g                                                           *
//              FS_g                                                           *
//    ( 1.2V Standard Vt devices with gate current models)                     *
//                                                                             *
//        3.LIB TT_25                                                          *
//              SS_25                                                          *
//              FF_25                                                          *
//              SF_25                                                          *
//              FS_25                                                          *
//    ( 2.5V Standard devices with different geometric and corner models)      *
//                                                                             *
//        4.LIB TT_na                                                          *
//              SS_na                                                          *
//              FF_na                                                          *
//    ( 1.2V Native devices with different geometric and corner models)        *
//                                                                             *
//        5.LIB TT_na_g                                                        *
//              SS_na_g                                                        *
//              FF_na_g                                                        *
//    ( 1.2V Native devices with gate current models)                          *
//                                                                             *
//        6.LIB TT_lvt                                                         *
//              SS_lvt                                                         *
//              FF_lvt                                                         *
//              SF_lvt                                                         *
//              FS_lvt                                                         *
//    ( 1.2V Low Vt devices with different geometric and corner models)        *
//                                                                             *
//        7.LIB TT_lvt_g                                                       *
//              SS_lvt_g                                                       *
//              FF_lvt_g                                                       *
//              SF_lvt_g                                                       *
//              FS_lvt_g                                                       *
//    ( 1.2V Low Vt devices with gate current models)                          *
//                                                                             *
//        8.LIB TT_lvt25                                                       *
//              SS_lvt25                                                       *
//              FF_lvt25                                                       *
//              SF_lvt25                                                       *
//              FS_lvt25                                                       *
//    ( 2.5V Low Vt devices with different geometric and corner models)        *
//                                                                             *
//        9.LIB TT_hvt                                                         *
//              SS_hvt                                                         *
//              FF_hvt                                                         *
//              SF_hvt                                                         *
//              FS_hvt                                                         *
//    ( 1.2V High Vt devices with different geometric and corner models)       *
//                                                                             *
//       10.LIB TT_hvt_g                                                       *
//              SS_hvt_g                                                       *
//              FF_hvt_g                                                       *
//              SF_hvt_g                                                       *
//              FS_hvt_g                                                       *
//    ( 1.2V High Vt devices with gate current models)                         *
//                                                                             *
//       11.LIB TT_uhvt                                                        *
//              SS_uhvt                                                        *
//              FF_uhvt                                                        *
//              SF_uhvt                                                        *
//              FS_uhvt                                                        *
//    ( 1.2V Ultra High Vt devices with different geometric and corner models) *
//                                                                             *
//       12.LIB TT_uhvt_g                                                      *
//              SS_uhvt_g                                                      *
//              FF_uhvt_g                                                      *
//              SF_uhvt_g                                                      *
//              FS_uhvt_g                                                      *
//    ( 1.2V ULtra High Vt devices with gate current models)                   *
//                                                                             *
//       13.LIB TT_na25                                                        *
//              SS_na25                                                        *
//              FF_na25                                                        *
//                                                                             *
//         ( 2.5V Native nMOS devices )                                        *
//                                                                             *
//       14.LIB TT_BIP                                                         *
//              SS_BIP                                                         *
//              FF_BIP                                                         *
//         ( P+/NW/PSUB 10x10,5x5 and 2x2 vertical PNP bipolar )               *
//                                                                             *
//       15.LIB TT_BIP_NPN                                                     *
//              SS_BIP_NPN                                                     *
//              FF_BIP_NPN                                                     *
//         ( N+/PW/PSUB 10x10,5x5 and 2x2 vertical NPN bipolar )               *
//                                                                             *
//       16.LIB TT_DIO                                                         *
//          LIB SS_DIO                                                         *
//          LIB FF_DIO                                                         *
//         ( 1.2V P+/NW ,N+/PW & NW/PSUB diode )                               *
//                                                                             *
//       17.LIB TT_DIO_DNW                                                     *
//          LIB SS_DIO_DNW                                                     *
//          LIB FF_DIO_DNW                                                     *
//          ( DNWPSUB & PWDNW diode )                                          *
//                                                                             *
//       18.LIB TT_DIO_hvt                                                     *
//          LIB SS_DIO_hvt                                                     *
//          LIB FF_DIO_hvt                                                     *
//         ( 1.2V High Vt P+/NW, N+/PW, and NW/PSUB diode )                    *
//                                                                             *
//       19.LIB TT_DIO_uhvt                                                    *
//          LIB SS_DIO_uhvt                                                    *
//          LIB FF_DIO_uhvt                                                    *
//         ( 1.2V Ultra High Vt P+/NW, N+/PW, and NW/PSUB diode )              *
//                                                                             *
//       20.LIB TT_DIO_na                                                      *
//          LIB SS_DIO_na                                                      *
//          LIB FF_DIO_na                                                      *
//         ( 1.2V Native N+/PW diode )                                         *
//                                                                             *
//       21.LIB TT_DIO_25                                                      *
//          LIB SS_DIO_25                                                      *
//          LIB FF_DIO_25                                                      *
//         ( 2.5V P+/NW, and N+/PW diode )                                     *
//                                                                             *
//       22.LIB TT_DIO_lvt                                                     *
//          LIB SS_DIO_lvt                                                     *
//          LIB FF_DIO_lvt                                                     *
//           ( 1.2V Low Vt P+/NW, N+/PW diode )                                *
//                                                                             *
//       23.LIB TT_DIO_lvt25                                                   *
//          LIB SS_DIO_lvt25                                                   *
//          LIB FF_DIO_lvt25                                                   *
//         ( 2.5V LVT P+/NW, and N+/PW diode )                                 *
//                                                                             *
//       24.LIB TT_DIO_na25                                                    *
//          LIB SS_DIO_na25                                                    *
//          LIB FF_DIO_na25                                                    *
//          ( 2.5V Native N+/PW diode )                                        *
//                                                                             *
//       25.LIB TT_RES                                                         *
//              SS_RES                                                         *
//              FF_RES                                                         *
//         (resist model)                                                      *
//                                                                             *
//       26.LIB TT_MOS_CAP                                                     *
//              SS_MOS_CAP                                                     *
//              FF_MOS_CAP                                                     *
//                                                                             *
//       27.LIB TT_MOS_CAP_25                                                  *
//              SS_MOS_CAP_25                                                  *
//              FF_MOS_CAP_25                                                  *
//                                                                             *
//       28.LIB TT_MIM                                                         *
//              SS_MIM                                                         *
//              FF_MIM                                                         *
//         ( MIM CAPACITOR model)                                              *
//                                                                             *
//       29.LIB TT_RTMOM                                                       *
//             SS_RTMOM                                                        *
//             FF_RTMOM                                                        *
//        (RTMOM capacitor model)                                              *
//                                                                             *
//  ****************************************************************************
//  ****************************************************************************
//                                                                             *
//  1)To use these models directly by programming in this style:               *
//                                                                             *
//      .lib 'lib_path/lib_name' model_name                                    *
//                                                                             *
//                                                                             *
//     EX: .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT                      *
//         for typical 1.2V N,PMOS                                             *
//         .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT_25                   *
//         for typical 2.5V N,PMOS                                             *
//         .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT_hvt                  *
//         for typical 1.2V high Vt N,PMOS                                     *
//         .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT_hvt_g                *
//         for typical 1.2V high Vt N,PMOS with gate current model             *
//         .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT_uhvt                 *
//         for typical 1.2V ultra high Vt N,PMOS                               *
//         .lib '/home/user/tsmc/LOGIC/cm013g_fsg.scs' TT_uhvt_g               *
//         for typical 1.2V ultra high Vt N,PMOS with gate current model       *
//                                                                             *
//   note:                                                                     *
//       corner_name                                                           *
//        TT : typical model for 1.2V devices                                  *
//        SS : Slow NMOS Slow PMOS model for 1.2V devices                      *
//        FF : Fast NMOS Fast PMOS model for 1.2V devices                      *
//        SF : Slow NMOS Fast PMOS model for 1.2V devices                      *
//        FS : Fast NMOS Slow PMOS model for 1.2V devices                      *
//                                                                             *
//       corner_name                                                           *
//        TT_g : typical MOS with gate current for 1.2V devices                *
//        SS_g : Slow NMOS Slow PMOS model with gate current for 1.2V devices  *
//        FF_g : Fast NMOS Fast PMOS model with gate current for 1.2V devices  *
//        SF_g : Slow NMOS Fast PMOS model with gate current for 1.2V devices  *
//        FS_g : Fast NMOS Slow PMOS model with gate current for 1.2V devices  *
//                                                                             *
//       corner_name                                                           *
//        TT_25 : typical model for 2.5V devices                               *
//        SS_25 : Slow NMOS Slow PMOS model for 2.5V devices                   *
//        FF_25 : Fast NMOS Fast PMOS model for 2.5V devices                   *
//        SF_25 : Slow NMOS Fast PMOS model for 2.5V devices                   *
//        FS_25 : Fast NMOS Slow PMOS model for 2.5V devices                   *
//                                                                             *
//       corner_name                                                           *
//        TT_na : typical model for 1.2V  native nmos devices                  *
//        SS_na : Slow NMOS Slow PMOS model for 1.2V native nmos devices       *
//        FF_na : Fast NMOS Fast PMOS model for 1.2V native nmos devices       *
//                                                                             *
//       corner_name                                                           *
//        TT_lvt : typical model for 1.2V low Vt devices                       *
//        SS_lvt : Slow NMOS Slow PMOS model for 1.2V low Vt devices           *
//        FF_lvt : Fast NMOS Fast PMOS model for 1.2V low Vt devices           *
//        SF_lvt : Slow NMOS Fast PMOS model for 1.2V low Vt devices           *
//        FS_lvt : Fast NMOS Slow PMOS model for 1.2V low Vt devices           *
//                                                                             *
//       corner_name                                                           *
//        TT_lvt_g : typical MOS with gate current for 1.2V low Vt devices     *
//        SS_lvt_g : Slow NMOS Slow PMOS model with gate current for 1.2V low Vt devices
//        FF_lvt_g : Fast NMOS Fast PMOS model with gate current for 1.2V low Vt devices
//        SF_lvt_g : Slow NMOS Fast PMOS model with gate current for 1.2V low Vt devices
//        FS_lvt_g : Fast NMOS Slow PMOS model with gate current for 1.2V low Vt devices
//                                                                             *
//       corner_name                                                           *
//        TT_lvt25 : typical model for 2.5V LVT devices                        *
//        SS_lvt25 : Slow NMOS Slow PMOS model for 2.5V LVT devices            *
//        FF_lvt25 : Fast NMOS Fast PMOS model for 2.5V LVT devices            *
//        SF_lvt25 : Slow NMOS Fast PMOS model for 2.5V LVT devices            *
//        FS_lvt25 : Fast NMOS Slow PMOS model for 2.5V LVT devices            *
//                                                                             *
//       corner_name                                                           *
//        TT_hvt : typical model for 1.2V high Vt devices                      *
//        SS_hvt : Slow NMOS Slow PMOS model for 1.2V high Vt devices          *
//        FF_hvt : Fast NMOS Fast PMOS model for 1.2V high Vt devices          *
//        SF_hvt : Slow NMOS Fast PMOS model for 1.2V high Vt devices          *
//        FS_hvt : Fast NMOS Slow PMOS model for 1.2V high Vt devices          *
//                                                                             *
//       corner_name                                                           *
//        TT_hvt_g : typical MOS with gate current for 1.2V high Vt devices    *
//        SS_hvt_g : Slow NMOS Slow PMOS model with gate current for 1.2V high Vt devices 
//        FF_hvt_g : Fast NMOS Fast PMOS model with gate current for 1.2V high Vt devices 
//        SF_hvt_g : Slow NMOS Fast PMOS model with gate current for 1.2V high Vt devices
//        FS_hvt_g : Fast NMOS Slow PMOS model with gate current for 1.2V high Vt devices 
//                                                                             *
//       corner_name                                                           *
//        TT_uhvt : typical model for 1.2V ultra high Vt devices               *
//        SS_uhvt : Slow NMOS Slow PMOS model for 1.2V ultra high Vt devices   *
//        FF_uhvt : Fast NMOS Fast PMOS model for 1.2V ultra high Vt devices   *
//        SF_uhvt : Slow NMOS Fast PMOS model for 1.2V ultra high Vt devices   *
//        FS_uhvt : Fast NMOS Slow PMOS model for 1.2V ultra high Vt devices   *
//                                                                             *
//       corner_name                                                           *
//        TT_uhvt_g : typical MOS with gate current for 1.2V ultra high Vt devices
//        SS_uhvt_g : Slow NMOS Slow PMOS model with gate current for 1.2V ultra high Vt devices 
//        FF_uhvt_g : Fast NMOS Fast PMOS model with gate current for 1.2V ultra high Vt devices 
//        SF_uhvt_g : Slow NMOS Fast PMOS model with gate current for 1.2V ultra high Vt devices
//        FS_uhvt_g : Fast NMOS Slow PMOS model with gate current for 1.2V ultra high Vt devices 
//                                                                             *   
//       corner_name                                                           *
//        TT_na25 : typical model for 2.5V  native nmos devices                *
//        SS_na25 : Slow NMOS Slow PMOS model for 2.5V native nmos devices     *
//        FF_na25 : Fast NMOS Fast PMOS model for 2.5V native nmos devices     *
//                                                                             *
//  2)HDIF depends on your layout poly spacer to contact center distance.      *
//    The value listed here is TSMC minimum-rule value. You can change it      *
//    according to your layout.                                                *
//                                                                             *
//  3)To use the gate current model, please follow the convention given below: *
//    xmn1 D G S B nch_g W=x L=x AD=x AS=x PD=x PS=x NRD=x NRS=x M=x SCALE=x   *
//    xmp1 D G S B pch_g W=x L=x AD=x AS=x PD=x PS=x NRD=x NRS=x M=x SCALE=x   *
//  note:                                                                      *
//    (a) The usage of this macro model is the same as a regular MOS model.    *
//    (b) Please make sure the value of 'SCALE' is given properly (default=1). *
//        The value must be consistent with the value defined in .option SCALE.*
//    (c) The S/D sharing selector is not available in the gate current model. *
// 4)XPART Guideline :							          *
//   a.In TSMC BSIM models, XPART is set to 1 (0/100 partition) in logic          *
//     models to avoid non-convergence issue when simulating logic circuits       * 
//     which tend to be of large size; and XPART is set to 0 (40/60 partition)    *
//     in RF modelsto preserve analog accuracy.				          *
//   b.In BSIM capacitance models, paramter XPART describes how channel charge    *
//     is partitioned between the source and the drain such that the associated   *
//     capacitance models can be derived accordingly. The best agreement was      * 
//     obtained with a partition of 60% of the inversion charge to the source     *
//     and 40% to the drain (XPART=0 (40/60)). But unfortunately, sometimes this  *
//     setting can cause numerical difficulty during a SPICE simulation.          *
//   c.Generally speaking, digital circuits benefit from XPART = 1 (0/100) more   *
//     and analog circuits benefit from XPART = 0 (40/60) more. Both of them      *
//     only have some differences on ring speed for L>1.2um devices (< 2.5%).     *
//     CV simulation curve won't be effect by XPART.		  	          *
//  note:                                                                         *
//     For RF regime, XPART = 0 (40/60) is better for working freq < Device fT    *
//     and XPART = 1 (0/100) is better for working freq > Device fT               *
//*********************************************************************************
// 

section stat_rfmos
statistics {
    mismatch {
        vary parnrf1 dist=gauss std=1/1
        vary parnrf2 dist=gauss std=1/1
        vary parprf1 dist=gauss std=1/1
        vary parprf2 dist=gauss std=1/1
        }
    }
endsection stat_rfmos

section stat_rfmos25
statistics {
    mismatch {
        vary parnrf1_25 dist=gauss std=1/1
        vary parnrf2_25 dist=gauss std=1/1
        vary parprf1_25 dist=gauss std=1/1
        vary parprf2_25 dist=gauss std=1/1
        }
    }
endsection stat_rfmos25

