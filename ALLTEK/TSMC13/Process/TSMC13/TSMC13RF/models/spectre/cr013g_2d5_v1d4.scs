+ c_sub=((0.33658) * nf + ( - 3.67044) * lum + ( - 0.83015) * wum + (0.02842) * 
+ lum * wum * nf + ( - 0.65046) * lum * wum + ( - 0.01218) * lum * nf + (0.04782) 
+ * wum * nf + (10.24635) * sqrt(lum * wum) + ( - 0.10317) * sqrt(lum * wum) * nf 
+ + (27.01793)) * 1e-15 c_sti=(( - 0.112288) * nf + ( - 0.013586) * lum + (0.130999) 
+ * wum + (0.031009) * lum * wum * nf + (0.006041) * lum * wum + (0.023377) * lum 
+ * nf + (0.120170) * wum * nf + ( - 0.033538) * sqrt(wum * lum) + ( - 0.112984)) 
+ * 1e-15 c_pp=(( - 0.282619) * nf + ( - 1.328147) * lum + ( - 0.115162) * wum + 
+ (0.017999) * lum * wum * nf + ( - 0.043202) * lum * wum + (0.412528) * lum * nf 
+ + (0.011854) * wum * nf + (0.751030) * sqrt(wum * lum) + (2.692831)) * 1e-15 is_fdiode1_wo=(( 
+ - 30.7221) * lum + ( - 41.6847) * wum + ( - 665.5646) / nf + ( - 7.0269) * lum 
+ * wum + ( - 183.3680) * lum / nf + ( - 120.9697) * wum / nf + ( - 47.1611) * lum 
+ * wum / nf + (978.5453) * sqrt(wum * lum) / nf + 261.7520 * sqrt(wum * lum) + 
+ ( - 78.4284)) * factor_isf_wo n_fdiode1_wo=(0.088201) / lum + (0.028120) / wum 
+ + ( - 0.027211) / lum / wum + (0.007037) * lum + ( - 0.000642) * wum + 0.884969 
+ cj_fdiode1_wo=(( - 0.001644) / lum + ( - 0.001983) / wum + (0.001299) / lum / 
+ wum + ( - 0.000017) * lum + (4.125926e-06) * wum + (0.004069)) * factor_cjf_wo 
+ mj_fdiode1_wo=(0.036552) / lum + (0.104677) / wum + ( - 0.451701) / lum / wum 
+ + (0.0128) * lum + (0.000296) * wum + 0.643196 is_rdiode_wo=((-12.83783)* nf + (-90.98964) * lum + (-47.0175) * wum + (5.05497) * lum * wum * nf + 
+ (20.70406) * lum * wum + (-6.06581) * lum * nf + (-8.05982) * wum * nf + (114.69857) 
+ * sqrt(lum * wum) + (17.08802) * sqrt(lum * wum) * nf + (161.30248)) * factor_isr_wo n_rdiode_wo=( 
+ - 0.485714) / lum + ( - 4.025397) / wum + (7.591474) / lum / wum + (0.011111) 
+ * lum + ( - 0.011111) * wum + (0.736508) * lum / wum + (0.013968) * wum / lum 
+ + 12.972222 
 
 
 
 
 
 
 
 
// =====================
r1 ( 1 4 ) resistor r=r_1 * factor_rm * (1 + (temp - 25) * 2.93e-3)
l1 ( 4 5 ) inductor l=l_1 * factor_l
csti ( 5 8 ) capacitor c=c_sti * factor_csti
// --- Schottky diode
df1 ( 5 11 ) f_diode1_wo area=a1_eff pj=p1_eff
rs1 ( 11 6 ) resistor r=r_s1 * factor_re_wo
dr ( 11 5 ) r_diode_wo area=a1_eff pj=p1_eff
// --- PN junction diode
df2 ( 5 21 ) f_diode2_wo area=a2_eff pj=p2_eff
rs2 ( 21 6 ) resistor r=r_s2 * factor_re_wo
cpp ( 5 3 ) capacitor c=c_pp
// --- Substrate network
dnw ( 31 7 ) dio_nwpsub area=anw_eff pj=pnw_eff
rsub ( 31 3 ) resistor r=r_sub * factor_rsub * (1 + (temp - 25) * 3.74e-3 + (temp 
+ - 25) * (temp - 25) * 9.1e-6)
csub ( 31 3 ) capacitor c=c_sub * factor_csub * (1 + (temp - 25) * 3.74e-3 + (temp 
+ - 25) * (temp - 25) * 9.1e-6)
rnwell1 ( 6 7 ) resistor r=r_nwell / 2 * factor_rnwell * (1 + (temp - 25) * 3.74e-3 
+ + (temp - 25) * (temp - 25) * 9.1e-6)
rnwell2 ( 7 8 ) resistor r=r_nwell / 2 * factor_rnwell * (1 + (temp - 25) * 3.74e-3 
+ + (temp - 25) * (temp - 25) * 9.1e-6)
 
r2 ( 8 9 ) resistor r=r_2 * factor_rm * (1 + (temp - 25) * 2.93e-3)
l2 ( 9 2 ) inductor l=l_2 * factor_l
 
// -- Forward diode No. 1 ---
// 
model f_diode1_wo diode 
+ level=1                   is=is_fdiode1_wo          rs=1e-010
+ n=n_fdiode1_wo            bv=1e4                    ibv=is_fdiode1_wo
+ ik = 3e+005               ikr = 1e+010
+ isw=3.5e-014              cj=cj_fdiode1_wo          vj=0.8756
+ mj=mj_fdiode1_wo          cjsw=0                    vjsw=0.8956
+ mjsw=0.6823               tlev=2                    eg=0.48
+ xti=2                     tbv1=-1*-0.000888         trs=0.00277
+ tlevc=1                   cta=0.0003067             ctp=0.0002781
+ pta=0.00302               ptp=0.001427              tnom=25
+ fc=0                      ns=n_fdiode1_wo           nz=n_fdiode1_wo
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- Reverse diode to model leakage current ---
// 
model r_diode_wo diode 
+ level=1                   is=is_rdiode_wo           rs=1e-010
+ n=n_rdiode_wo             bv=1e4                    ibv=is_rdiode_wo
+ ik = 6e+004               ikr = 5e+005
+ isw=1.55e-013             cj=0                      vj=0.2006
+ mj=0.4528                 cjsw=0                    vjsw=0.7956
+ mjsw=0.2323               tlev=1                    eg=4.5
+ xti=12                    tbv1=-1*-0.000888         trs=0.00277
+ tlevc=1                   cta=0.0009067             ctp=0.0002781
+ pta=0.001427              ptp=0.001427              tnom=25
+ fc=0                      ns=n_rdiode_wo            nz=n_rdiode_wo
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- Forward diode No. 2, P+/NW STI Diode ---
// 
model f_diode2_wo diode 
+ level=1                   is=1.8e-007*factor_is_d   rs=1e-010*factor_rs_d
+ n=1.02*factor_n_d         bv=8.33                   ibv=0.02
+ ik = 1e+020               ikr = 1e+010
+ isw=6.6e-014*factor_jsw_d cj=0.001369*factor_cj_d   vj=0.9
+ mj=0.4234                 cjsw=9.8e-011*factor_cjsw_d
+ vjsw=0.9                  mjsw=0.1716               tlev=1
+ eg=1.17                   xti=3                     tbv1=-1*-0.000845
+ trs=0.00289               tlevc=1                   cta=0.000887
+ ctp=0.000298              pta=0.001643              ptp=0.001643
+ tnom=25                   fc=0                      area=3.92e-008
+ pj=0.00084                ns=1.02*factor_n_d        nz=1.02*factor_n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- NW/PSUB diode ---
// 
model dio_nwpsub diode 
+ level=1                   is=6.2e-007               rs=1e-010
+ n=1.02                    bv=13.6                   ibv=0.01
+ ik = 1e+010               ikr = 1e+020
+ isw=3.17e-012             cj=0.0001291              vj=0.8122
+ mj=0.4897                 cjsw=5.35e-010            vjsw=0.8122
+ mjsw=0.2822               tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-0.00129          trs=0.00204
+ tlevc=1                   cta=0.002483              ctp=0.001238
+ pta=0.003184              ptp=0.003184              tnom=25
+ fc=0                      area=3.92e-008            pj=0.00084
+ ns=1.02                   nz=1.02                   imax=1e40
+ minr=1e-10                allow_scaling=1
 
 
ends sbd_rf_nw
//   // 
// 
// 
 
endsection rf_sbd
