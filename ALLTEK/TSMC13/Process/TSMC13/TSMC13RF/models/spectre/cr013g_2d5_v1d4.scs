parameters l=1u w=1u multi=1 factor=1 sa=0.35e-6 sb=0.35e-6 ad=2 * hdifp_lvt 
+ / factor * w as=2 * hdifp_lvt / factor * w pd=2 * (2 * hdifp_lvt / factor + w) 
+ ps=2 * (2 * hdifp_lvt / factor + w) nrd=hdifp_lvt / factor / w nrs=hdifp_lvt / 
+ factor / w temp1=parp1_lvt temp2=parp2_lvt fac1=0.798 * temp1 + 0.602 * temp2 
+ fac2=0.798 * temp1 - 0.602 * temp2 lef=l - 2.0e-8 wef=w + 1.5e-8 geo_fac=1 / sqrt(multi 
+ * lef * wef * 1e12) vthmisp_lvt=0.002917 * geo_fac * fac1 dlmisp_lvt=0.001870 
+ * geo_fac * lef * fac2 dwmisp_lvt= - 0.001870 * geo_fac * wef * fac2 toxmisp_lvt=0.001870 
+ * geo_fac * toxp_lvt * fac2 
