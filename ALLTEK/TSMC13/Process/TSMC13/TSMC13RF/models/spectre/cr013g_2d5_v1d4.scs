endsection ff_rfsbd
 
 
// ************************************************************************
// ************ Schottky Barrier Diode Model Statistical Model ************
// ************************************************************************

section mc_rfsbd
parameters par1_rfsbd=0
parameters a1_rfsbd=par1_rfsbd * 4.2387e+000 * 3 / 3
parameters factor_isf_wi=1.0000e+000 + ( - 2.1232e-001) * a1_rfsbd
parameters factor_re_wi=1.0000e+000 + (7.0773e-002) * a1_rfsbd
parameters factor_isr_wi=10 ** (par1_rfsbd * ( - 1) * (log(25) / 3))
parameters factor_cjf_wi=1.0000e+000 + (5.8978e-002) * a1_rfsbd
parameters factor_isf_wo=1.0000e+000 + ( - 2.2411e-001) * a1_rfsbd
parameters factor_re_wo=1.0000e+000 + (7.0773e-002) * a1_rfsbd
parameters factor_isr_wo=10 ** (par1_rfsbd * ( - 1) * (log(15) / 3))
parameters factor_cjf_wo=1.0000e+000 + (5.8978e-002) * a1_rfsbd
parameters factor_l=1.0000e+000 + (5.5795e-003) * a1_rfsbd
parameters factor_rm=1.0000e+000 + (2.3591e-002) * a1_rfsbd
parameters factor_rsub=1.0000e+000 + ( - 4.7182e-002) * a1_rfsbd
parameters factor_csub=1.0000e+000 + (5.8978e-002) * a1_rfsbd
parameters factor_rnwell=1.0000e+000 + (3.5387e-002) * a1_rfsbd
parameters factor_csti=1.0000e+000 + (1.1796e-002) * a1_rfsbd
parameters factor_is_d=1.0000e+000 + ( - 7.0773e-002) * a1_rfsbd
parameters factor_jsw_d=10 ** (par1_rfsbd * ( - 1) * (log(2) / 3))
parameters factor_n_d=1.0000e+000 + (5.8978e-004) * a1_rfsbd
parameters factor_rs_d=1.0000e+000 + (4.7182e-002) * a1_rfsbd
parameters factor_cj_d=1.0000e+000 + (1.1796e-002) * a1_rfsbd
parameters factor_cjsw_d=1.0000e+000 + (2.3591e-002) * a1_rfsbd

statistics {
    process {
        vary par1_rfsbd dist=gauss std=1/3
        }
    }
 
include "cr013g_2d5_v1d4.scs" section=rf_sbd
 
endsection mc_rfsbd

//**************************************************************************************************
//
// 1.2V MOS MODEL :
//
//
//              .lib RF_MOS : Typical
//
//              Model name       nr               lr (um)           wr (um)
//                            low   high        low     high     low    high
//            -----------------------------------------------------------------
//              nmos_rf        1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//              pmos_rf        1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//              pmos_rf_nw     1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//              nmos_rf_mis    1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//              pmos_rf_mis    1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//              pmos_rf_nw_mis 1     64         0.13    0.24     1.2     10
//            -----------------------------------------------------------------
//            End Model
//            **nr: Finger number
//            **wr: Width per finger
//
//**************************************************************************************************
section rf_mos

inline subckt nmos_rf ( d g s b )
parameters lr=13.e-08 nr=1 wr=2.5e-6 lspace=0.42u ledge=2.0u ledgeeff=0.73u lsti=1.0u
+ wsti=2.0u rod=2015 rsti=3364 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+ nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge 
+ + dummyflag * (ledgeeff - ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) 
+ ldios=(ns - 2) * lspace + sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 
+ 1) * lspace + nodd * sleff lod=nr * (lr + lspace) + 2 * ledge - lspace sdiofa=wr 
+ * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr * ldiod 
+ ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr 
+ * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag sax=1 / (log((ledge + lr / 
+ 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge 
+ + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr 
+ * (ledge + lr / 2))) - lr / 2 rsx=(0.0158
+ * (lr * 1e6 + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6)
+ rdx=0.0053 * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd
+ + 0.0867 / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96)
+ / (lr * 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138
+ * wr * 1e6 + 0.718 * lr * 1e6 + 733 * lr / nr / wr + 5.189) 
+ rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 +
+ rsti * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr
+ / 12 + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr *
+ 1e6 + 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19
+ * nr * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6
+ / (lr * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15
+ w1=(wr + 0.015e-6 + dxwrf) * nr l1=lr - 0.02e-6
+ + dxlrf tcc=1 + 1.7e-3 * (temp - 25) area=w1 * 2.5e-9 * 1e4 * tcc tox=(toxnrf
+ - 8.3e-10) * 1e2 jf=2.704e-08 ef=2.623e+07 varaf= - 0.18955 * log(l1) + 0.99251
+ varbf=0.54 * ef * tox jr=5.065e-7 er=7.43e6 varar= - 0.072266 * log(l1) + 16.394
+ varbr=0.52 * er * tox forward_eff=area * jf * exp( - ef * tox * varaf) / pow(tox,2.5)
+ reverse_eff=area * jr * exp( - er * tox * varar) / pow(tox,2.5) tmp1=varbf + 2.0
+ tmp2=varbr + 2.0
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
//  ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
//  *** Diodes  ****************
dss ( sb si ) ndio_rf_f area=sdiofa pj=sdiofp
ddd ( db di ) ndio_rf_f area=ddiofa pj=ddiofp
dsg ( sb si ) ndio_rf_g area=1e-15 pj=sdiogp
ddg ( db di ) ndio_rf_g area=1e-15 pj=ddiogp
//  ***************************************************************************
rb ( b bi ) resistor r=rbx tc1=0.0037 tc2=9.64e-6
cb ( b bi ) capacitor c=162f / rbx
rdb ( db bi ) resistor r=rdbx tc1=0.0037 tc2=9.64e-6
cdb ( db bi ) capacitor c=162f / rdbx
rsb ( sb bi ) resistor r=rdbx tc1=0.0037 tc2=9.64e-6
csb ( sb bi ) capacitor c=162f / rdbx
nmos_rf ( di gi si bi ) nch_rf l=lr w=wr m=nr ad=0 as=0 pd=0 ps=0 sa=sax sb=sax
gdf1 ( gi di ) bsource i =forward_eff * pow((abs(v(gi,di)) + v(gi,di)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(gi,di)) - v(gi,di)) / 2,tmp2) + 1e-18 * v(gi,di)
gdf2 ( gi si ) bsource i =forward_eff * pow((abs(v(gi,si)) + v(gi,si)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(gi,si)) - v(gi,si)) / 2,tmp2) + 1e-18 * v(gi,si)
ends nmos_rf

inline subckt pmos_rf ( d g s b )
parameters lr=13.e-08 nr=1 wr=2.5e-6 lspace=0.42u ledge=2.0u ledgeeff=0.73u lsti=1.0u
+ wsti=2.0u rod=342 rsti=913 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+ nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge 
+ + dummyflag * (ledgeeff - ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) 
+ ldios=(ns - 2) * lspace + sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 
+ 1) * lspace + nodd * sleff lod=nr * (lr + lspace) + 2 * ledge - lspace sdiofa=wr 
+ * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr * ldiod 
+ ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr 
+ * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag sax=1 / (log((ledge + lr / 
+ 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge 
+ + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr 
+ * (ledge + lr / 2))) - lr / 2 rsx=(0.0158
+ * (lr * 1e6 + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6)
+ rdx=0.0053 * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd
+ + 0.0867 / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96)
+ / (lr * 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138
+ * wr * 1e6 + 0.718 * lr * 1e6 + 1223 * lr / nr / wr + 4.689) 
+ rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 +
+ rsti * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr
+ / 12 + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr *
+ 1e6 + 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19
+ * nr * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6
+ / (lr * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15
+ jf=1.1575e-07 ef=7.127e+06 jr=2.8e-8 er=4.373e6
+ w1=(wr + 0.015e-6 + dxwrf) * nr l1=lr + dxlrf - 0.02e-6 tox=(toxprf - 8e-10) *
+ 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 * 1e4 * tcc varaf= - 0.70902
+ * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 * er * tox varar= - 0.31121
+ * log(l1) + 24.530 forward_eff=area * jf * exp( - ef * tox * varaf) / pow(tox,2.5)
+ reverse_eff=area * jr * exp( - er * tox * varar) / pow(tox,2.5) tmp1=varbf + 2.0
+ tmp2=varbr + 2.0

//  ********************
rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
//  ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
//  *** Diodes  ****************
dss ( si sb ) pdio_rf_f area=sdiofa pj=sdiofp
ddd ( di db ) pdio_rf_f area=ddiofa pj=ddiofp
dsg ( si sb ) pdio_rf_g area=1e-15 pj=sdiogp
ddg ( di db ) pdio_rf_g area=1e-15 pj=ddiogp
//  ***************************************************************************
rb ( b bi ) resistor r=rbx tc1=0.00374 tc2=9.10e-6
cb ( b bi ) capacitor c=169f / rbx
rdb ( db bi ) resistor r=rdbx tc1=0.00374 tc2=9.10e-6
cdb ( db bi ) capacitor c=169f / rdbx
rsb ( sb bi ) resistor r=rdbx tc1=0.00374 tc2=9.10e-6
csb ( sb bi ) capacitor c=169f / rdbx
pmos_rf ( di gi si bi ) pch_rf l=lr w=wr m=nr ad=0 as=0 pd=0 ps=0 sa=sax sb=sax
gdf1 ( di gi ) bsource i =forward_eff * pow((abs(v(di,gi)) + v(di,gi)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(di,gi)) - v(di,gi)) / 2,tmp2) + 1e-18 * v(di,gi)
gdf2 ( si gi ) bsource i =forward_eff * pow((abs(v(si,gi)) + v(si,gi)) / 2,tmp1)
+ - reverse_eff * pow((abs(v(si,gi)) - v(si,gi)) / 2,tmp2) + 1e-18 * v(si,gi)
ends pmos_rf

inline subckt pmos_rf_nw ( d g s b )
parameters lr=13.e-08 nr=1 wr=2.5e-6 lspace=0.42u ledge=2.0u ledgeeff=0.73u lsti=1.0u
+ wsti=2.0u rod=805 rsti=2148 ns=int(nr / 2 + 1) nd=int((nr + 1) / 2) 
+nodd=(nr - int(nr / 2) * 2) dummyflag=1 sleff=ledge 
+ + dummyflag * (ledgeeff - ledge) sreff=ledge + dummyflag * (ledgeeff - ledge) 
+ ldios=(ns - 2) * lspace + sleff + sreff + nodd * (lspace - sleff) ldiod=(ns - 
+ 1) * lspace + nodd * sleff lod=nr * (lr + lspace) + 2 * ledge - lspace sdiofa=wr 
+ * ldios sdiofp=2 * ldios + (2 - nodd) * wr * (1 - dummyflag) ddiofa=wr * ldiod 
+ ddiofp=2 * ldiod + nodd * wr * (1 - dummyflag) sdiogp=wr * nr + (2 - nodd) * wr 
+ * dummyflag ddiogp=wr * nr + nodd * wr * dummyflag sax=1 / (log((ledge + lr / 
+ 2 + nr * (lr + lspace)) * (ledge + lr / 2 + (nr - 1) * (lr + lspace)) / (ledge 
+ + lspace + 3 * lr / 2) / (ledge + lr / 2)) / (2 * nr * (lr + lspace)) + 1 / (nr 
+ * (ledge + lr / 2))) - lr / 2 rsx=(0.0158
+ * (lr * 1e6 + 0.42) * (2 * ns + 1 / ns - 3) + 0.771 / ns + 0.232) / (wr * 1e6)
+ rdx=0.0053 * (lr * 1e6 + 0.42) * (nd + 2 / nd) + 0.138 * (wr * 1e6 + 2.16) / nd
+ + 0.0867 / (1.2 + (nd - 1) * (lr * 1e6 + 0.42)) rgx=((0.625 * (wr * 1e6 + 0.96)
+ / (lr * 1e6 - 0.02) + 6.46) / nr + nr * (0.000286 * wr * 1e6 + 0.0139) + 0.0138
+ * wr * 1e6 + 0.718 * lr * 1e6 + 1223 * lr / nr / wr + 4.689) 
+ rbx=(rod * lod / 12 + rsti * lsti / 2) * (rod * wr / 12 +
+ rsti * wsti / 2) / (lod * (rod * lod / 12 + rsti * lsti / 2) + wr * (rod * wr
+ / 12 + rsti * wsti / 2)) rdbx=rod * lr / (wr * nr * 2) cgsx=(1.3 * nr * (lr *
+ 1e6 + 0.42) / (0.1 * wr * 1e6 + 2.9) + 0.2 * wr * 1e6 + 0.67) * 1e-15 cgdx=(0.19
+ * nr * lr * 1e6 + 0.07 * nr + 0.282) * 1e-15 cdsx=(0.1 + 0.062 * nr * wr * 1e6
+ / (lr * 1e6 + 0.6) + 1.8 * nr * (lr * 1e6 + 0.42) / (wr * 1e6 + 9.8)) * 1e-15
+ jf=1.1575e-07 ef=7.127e+06 jr=2.8e-8 er=4.373e6
+ w1=(wr + 0.015e-6 + dxwrf) * nr l1=lr + dxlrf - 0.02e-6 tox=(toxprf - 8e-10) *
+ 1e2 tcc=1 + 1.4e-3 * (temp - 25) area=w1 * 6.1e-9 * 1e4 * tcc varaf= - 0.70902
+ * log(l1) + 5.9821 varbf=1.2 * ef * tox varbr=0.52 * er * tox varar= - 0.31121
+ * log(l1) + 24.530 forward_eff=area * jf * exp( - ef * tox * varaf) / pow(tox,2.5)
+ reverse_eff=area * jr * exp( - er * tox * varar) / pow(tox,2.5) tmp1=varbf + 2.0
+ tmp2=varbr + 2.0

rg ( g gi ) resistor r=rgx
rs ( s si ) resistor r=rsx
rd ( d di ) resistor r=rdx
//  ********************
cgs_m ( gi si ) capacitor c=cgsx
cgd_m ( gi di ) capacitor c=cgdx
cds_m ( si di ) capacitor c=cdsx
//  *** Diodes  ****************
dss ( si sb ) pdio_rf_f area=sdiofa pj=sdiofp
ddd ( di db ) pdio_rf_f area=ddiofa pj=ddiofp
dsg ( si sb ) pdio_rf_g area=1e-15 pj=sdiogp
ddg ( di db ) pdio_rf_g area=1e-15 pj=ddiogp
//  ***************************************************************************
rb ( b bi ) resistor r=rbx tc1=0.00374 tc2=9.10e-6
cb ( b bi ) capacitor c=169f / rbx
