+ rend0=1.01e-04 * (1 + factmis) rsh=r_rppolywo * (1 + factmis) dl=0.04698u dw=0.07953u 
+ pt=temp pvce1=-9.40e-02 pvce2=6.39e+01 pvce3=-2.71e+00 ptce1=-1.71e-03 ptce2=1.06e-06 
+ pvcp1=-1.99e-01 pvcp2=6.05e-06 pvcp3=-3.23e+00 ptcp1=-1.19e-04 ptcp2=6.54e-07 
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) bsource r=rsh / mf * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(3,4) / (l - dl)) + pvcp3) - tanh(pvcp3))) l=l-dl w=mf*(w-dw) kf=1.25E-22 af=2 fexp=1.08 wdexp=1 ldexp=1
rend2 ( 4 n2 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rppolywo_mis
 
subckt rppolyhri_mis ( n1 n2 ) 
parameters l=1u w=1u mf=1 geo_fac =1 / sqrt(mf * l * w * 1e12) factmis=0.011823 * geo_fac * par_res
+ rend0=5.320e-05 * (1 + factmis) rsh=r_rppolyhri * (1 + factmis) dl=0u dw=0.093u 
+ pt=temp pvce1=0.5 pvce2=1.25 pvce3=-1.25 ptce1=-6.5e-04 ptce2=3.5e-08 
+ pvcp1=-0.095 pvcp2=1.205e-06 pvcp3=-0.873 ptcp1=-7.67e-04 ptcp2=7.594e-07 
+ tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 
+ + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) bsource r=rsh / mf * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2 
+ * abs(v(3,4) / (l - dl)) + pvcp3) - tanh(pvcp3))) l=l-dl w=mf*(w-dw) kf=1.65E-22 af=2 fexp=0.95 wdexp=1 ldexp=1
rend2 ( 4 n2 ) bsource r=rend0 / mf / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rppolyhri_mis


endsection res
// 
// 
//  ****************************************************************************
//                                                                             *
//       23.LIB TT_MOS_CAP                                                     *
//              SS_MOS_CAP                                                     *
//              FF_MOS_CAP                                                     *
//                                                                             *
//         ( 1.2V Core NMOS in N-Well varactor )                               *
//                                                                             *
//  ****************************************************************************
//  ******************************************************************************
//                                                                               *
//                   1.2V NMOS in N-Well varactor MODEL                          *
//                                                                               *
//  ******************************************************************************
//  *************** CORNER_LIB OF TYPICAL MODEL ****************************
section tt_mos_cap
parameters xl_var=0.032e-6
parameters xw_var=0
parameters cmin_a=2.1e-3
parameters cmin_l=2.5e-10
parameters cmin_w=4.1e-10
parameters dcga=5e-3
parameters dcgw=0
parameters fac_var=1
include "cr013g_2d5_v1d4.scs" section=mos_cap
endsection tt_mos_cap
//  ***************** CORNER_LIB OF SLOW MODEL *****************************
section ss_mos_cap
parameters xl_var=0.027e-6
parameters xw_var=0.0075E-6
parameters cmin_a=1.932e-3
parameters cmin_l=2.3e-10
parameters cmin_w=3.772e-10
parameters dcga=4.813e-3
parameters dcgw=0
parameters fac_var=0.4082
include "cr013g_2d5_v1d4.scs" section=mos_cap
endsection ss_mos_cap
//  ***************** CORNER_LIB OF FAST MODEL *****************************
section ff_mos_cap
parameters xl_var=0.037e-6
parameters xw_var=-0.0075E-6
parameters cmin_a=2.268e-3
parameters cmin_l=2.7e-10
parameters cmin_w=4.428e-10
parameters dcga=5.187e-3
parameters dcgw=0
parameters fac_var=2.45
include "cr013g_2d5_v1d4.scs" section=mos_cap
endsection ff_mos_cap
//  ************************************************************************
section mos_cap
 
subckt nmoscap ( ng nds ) 
parameters lr=10e-6 wr=10e-6
+ l_eff=(lr - 2 * xl_var)
+ w_eff=(wr - 2 * xw_var) a_eff=(l_eff * w_eff) dvgs= - 0.05 
+ * (1 + 3.6e-03 * (temp - 25)) vgnorm=0.35 * (1 + 2.03e-03 * (temp - 25)) forward_eff=a_eff 
+ * 6e2 gtmp=50e-12 varbf=2.2 rev_eff=a_eff * 1.5e1 varbr=0
 
 
cg ( ng nds ) bsource q=((cmin_a * a_eff + 2 * cmin_l * l_eff + 2 * cmin_w * w_eff 
+ + (dcga * a_eff + 2 * dcgw * w_eff)) * v(ng,nds) + vgnorm * (dcga * a_eff + 2 * dcgw * w_eff) 
+ * log(cosh((v(ng,nds) - dvgs) / vgnorm)))
 
 
gdf1 ( ng nds ) bsource i =fac_var * (forward_eff * pow((abs(v(ng,nds)) + v(ng,nds)) / 2,varbf 
+ + 2) + gtmp * (abs(v(ng,nds)) + v(ng,nds)) - rev_eff * pow((abs(v(ng,nds)) - v(ng,nds)) / 2,varbr
+ + 2))
 
ends nmoscap 
endsection mos_cap
// 
// 
//  ****************************************************************************
//                                                                             *
//       24.LIB TT_MOS_CAP_25                                                  *
//              SS_MOS_CAP_25                                                  *
//              FF_MOS_CAP_25                                                  *
//                                                                             *
//         ( 2.5V Core NMOS in N-Well varactor )                               *
//                                                                             *
//  ****************************************************************************
//  ******************************************************************************
//                                                                               *
//                   2.5V NMOS in N-Well varactor MODEL                          *
//                                                                               *
//  ******************************************************************************
//  *************** CORNER_LIB OF TYPICAL MODEL ****************************
section tt_mos_cap_25
parameters xl_var25=0.06E-6
parameters xw_var25=0.02E-6
parameters cmin_a_25=1.25E-3
parameters cmin_l_25=2.5e-10
parameters cmin_w_25=4.0E-10
parameters dcga_25=2.25E-3
parameters dcgw_25=4.0E-11
include "cr013g_2d5_v1d4.scs" section=mos_cap_25
endsection tt_mos_cap_25
//  ***************** CORNER_LIB OF SLOW MODEL *****************************
section ss_mos_cap_25
parameters xl_var25=0.0534E-6
parameters xw_var25=0.0275E-6
parameters cmin_a_25=1.15E-3
parameters cmin_l_25=2.3E-10
parameters cmin_w_25=3.68E-10
parameters dcga_25=2.1458E-3
parameters dcgw_25=3.81E-11
include "cr013g_2d5_v1d4.scs" section=mos_cap_25
endsection ss_mos_cap_25
//  ***************** CORNER_LIB OF FAST MODEL *****************************
section ff_mos_cap_25
parameters xl_var25=0.0666E-6
parameters xw_var25=0.0125E-6
parameters cmin_a_25=1.35E-3
parameters cmin_l_25=2.7E-10
parameters cmin_w_25=4.32E-10
parameters dcga_25=2.3542E-3
parameters dcgw_25=4.19E-11

include "cr013g_2d5_v1d4.scs" section=mos_cap_25
endsection ff_mos_cap_25
//  ************************************************************************
section mos_cap_25

subckt nmoscap_25 ( ng nds )
parameters gr=1 br=1 lr=10e-6 wr=10e-6
+ l_eff_25=(lr - 2 * xl_var25) * (gr * br)
+ w_eff_25=(wr - 2 * xw_var25) * (gr * br) a_eff_25=(l_eff_25 * w_eff_25) / (gr * br) dvgs_25= - 0.15
+ * (1 + 3.5e-03 * (temp - 25)) vgnorm_25=0.5 * (1 + 2.3e-03 * (temp - 25))

cg ( ng nds ) bsource q=((cmin_a_25 * a_eff_25 + 2 * cmin_l_25 * l_eff_25 + 2 * cmin_w_25 * w_eff_25
+ + (dcga_25 * a_eff_25 + 2 * dcgw_25 * w_eff_25)) * v(ng,nds) + vgnorm_25 * (dcga_25 * a_eff_25 + 2 * dcgw_25 * w_eff_25)
+ * log(cosh((v(ng,nds) - dvgs_25) / vgnorm_25)))

ends nmoscap_25
endsection mos_cap_25



section tt_mim
parameters par_mim=0
parameters cmimbb_mimfac=1.0
include "cr013g_2d5_v1d4.scs" section=mim
endsection tt_mim





section ff_mim
parameters par_mim=0
parameters cmimbb_mimfac=0.9
include "cr013g_2d5_v1d4.scs" section=mim
endsection ff_mim





section ss_mim
parameters par_mim=0
parameters cmimbb_mimfac=1.1
include "cr013g_2d5_v1d4.scs" section=mim
endsection ss_mim





section mim
//*************************************************************************************************
//  MIM CAPACITOR MODEL :
//
//
//     ## library files:
//     
//     1. The base band 1.0fF MIM capacitors with sub-circuit 'mimcap_1p0_sin'
//     2. The base band 1.5fF MIM capacitors with sub-circuit 'mimcap_1p5_sin'
//      
//
//            Model name         lt(um)        wt(um)         
//                           low    high    low    high   
//     --------------------------------------------------
//     mimcap_1p0_sin         2     100      2     100
//     mimcap_1p5_sin         2     100      2     100
//     --------------------------------------------------
//     End Model
//            **lt: length dimension of top metal
//            **wt: width dimension of top metal
//             
//
//*************************************************************************************************
//
//
subckt mimcap_1p0_sin ( top bottom )
parameters lt=10u wt=10u cmim_para=(((wt - 0.108e-6) * (lt - 0.108e-6) * 1e12 * 1.0274) + 2 * ((wt - 0.108e-6)
+ + (lt - 0.108e-6)) * 1e6 * 0.1686 ) * 1e-15 * (1 + (temp - 25) *  - 4.13e-5 + (temp
+ - 25) * (temp - 25) *  - 8e-8)
//
cmim ( top bottom ) bsource q=cmim_para * (v(top,bottom) + 0.5*v(top,bottom)**(2) * 2.96e-5 + 1/3*v(top,bottom)
+ ** 3 *  - 2.44e-5) * cmimbb_mimfac
//
ends mimcap_1p0_sin
//
//
subckt mimcap_1p5_sin ( top bottom ) 
parameters lt=10u wt=10u cmim_para=(((wt - 0.092e-6) * (lt - 0.092e-6) * 1e12 * 
+ 1.547) + 2 * ((wt - 0.092e-6) + (lt - 0.092e-6)) * 1e6 * 0.164) * 1e-15 * (1 + 
+ (temp - 25) *  - 5.016e-5 + (temp - 25) * (temp - 25) * 6.5e-9) 
// 
cmim ( top bottom ) bsource q=cmim_para * (v(top,bottom) + 0.5*v(top,bottom)**(2) * - 3.043e-5 + 1/3*v(top,bottom) 
+ ** 3 *  - 4.6125e-5) * cmimbb_mimfac
// 
ends mimcap_1p5_sin
// 
//
//
//  ********************************
//        Mismatch   model         *
//  ********************************
subckt mimcap_1p0_sin_mis ( top bottom )
parameters lt=10u wt=10u mf=1
+ geo_fac=1 / sqrt(mf * lt * wt * 1e12)
+ factmis=0.004458 * geo_fac * par_mim
+ cmim_para=(1+factmis) * mf * (((wt - 0.108e-6) * (lt - 0.108e-6) * 1e12 * 1.0274) + 2 * ((wt - 0.108e-6)
+ + (lt - 0.108e-6)) * 1e6 * 0.1686 ) * 1e-15 * (1 + (temp - 25) *  - 4.13e-5 + (temp
+ - 25) * (temp - 25) *  - 8e-8)
//
cmim ( top bottom ) bsource q=cmim_para * (v(top,bottom) + 0.5*v(top,bottom)**(2) * 2.96e-5 + 1/3*v(top,bottom)
+ ** 3 *  - 2.44e-5) * cmimbb_mimfac
//
ends mimcap_1p0_sin_mis

subckt mimcap_1p5_sin_mis ( top bottom )
parameters lt=10u wt=10u mf=1
+ geo_fac=1 / sqrt(mf * lt * wt * 1e12)
+ factmis=0.006042 * geo_fac * par_mim
+ cmim_para=(1+factmis) * mf * (((wt - 0.092e-6) * (lt - 0.092e-6) * 1e12 * 
+ 1.547) + 2 * ((wt - 0.092e-6) + (lt - 0.092e-6)) * 1e6 * 0.164) * 1e-15 * (1 + 
+ (temp - 25) *  - 5.016e-5 + (temp - 25) * (temp - 25) * 6.5e-9)
//
cmim ( top bottom ) bsource q=cmim_para * (v(top,bottom) + 0.5*v(top,bottom)**(2) * - 3.043e-5 + 1/3*v(top,bottom) 
+ ** 3 *  - 4.6125e-5) * cmimbb_mimfac
//
ends mimcap_1p5_sin_mis

endsection mim 


