//
// rppolyl_rf : P+Poly w/i silicide (W>2um)
// rppolys_rf : P+Poly w/i silicide (W<2um)
// rppolywo_rf : P+Poly w/o silicide
// rppolyhri_rf : P-Poly w/o silicide
// rppolyl_rf_mis : P+Poly w/i silicide (W>2um)
// rppolys_rf_mis : P+Poly w/i silicide (W<2um)
// rppolywo_rf_mis : P+Poly w/o silicide
// rppolyhri_rf_mis : P-Poly w/o silicide
//  ************************************************************************************************

section rf_res_sa
subckt rppolyl_rf ( hi lo gnode )
parameters l=20u w=5u mf=1 rsh=rppolyl dw=-0.035u ptc1=2.64e-03 ptc2=1.92e-06 pvc1=3.14e-03
+ pvc2=6.18e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt
+ - 25.0) rsubtfac=1.0 + 3.74m * (pt - 25.0) + 9.1u * (pt - 25.0) * (pt - 25.0)
+ rsubx=607.2 / ((1 / (1u + (l + 0.9u) / 6) * (w - dw)) + (1 / (3u + (w - dw) /
+ 6) * (l + 0.9u))) * rsubtfac
rend1 ( hi 1 ) resistor r=11.04 / mf / (int(abs((w - 0.3u) / 0.34u) + 1))
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r1 ( 12 2 ) bsource r=1 / 6 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r2 ( 23 3 ) bsource r=1 / 3 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r3 ( 34 4 ) bsource r=1 / 3 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
r4 ( 4 45 ) bsource r=1 / 6 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
rend2 ( 5 lo ) resistor r=11.04 / mf / (int(abs((w - 0.3u) / 0.34u) + 1))
cox1 ( 2 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
cox2 ( 3 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
cox3 ( 4 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
rsub ( 6 gnode ) resistor r=rsubx * sarsub_fac / mf
csub ( 6 gnode ) capacitor c=197f / rsubx * sacsub_fac * mf
ends rppolyl_rf

subckt rppolys_rf ( hi lo gnode )
parameters l=20u w=1u mf=1 rsh=rppolys dw=-0.035u ptc1=2.88e-03 ptc2=4.47e-07 pvc1=1.93e-04
+ pvc2=1.99e-03 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt - 25.0) * (pt
+ - 25.0) rsubtfac=1.0 + 3.74m * (pt - 25.0) + 9.1u * (pt - 25.0) * (pt - 25.0)
+ rsubx=607.2 / ((1 / (1u + (l + 0.9u) / 6) * (w - dw)) + (1 / (3u + (w - dw) /
+ 6) * (l + 0.9u))) * rsubtfac
rend1 ( hi 1 ) resistor r=11.04 / mf / (int(abs((w - 0.3u) / 0.34u) + 1))
ls1 ( 1 12 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r1 ( 12 2 ) bsource r=1 / 6 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls2 ( 2 23 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r2 ( 23 3 ) bsource r=1 / 3 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls3 ( 3 34 ) inductor l=0.04 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
r3 ( 34 4 ) bsource r=1 / 3 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
r4 ( 4 45 ) bsource r=1 / 6 * rsh / mf * l / (w - dw) * (1 + pvc1 * abs(v(5,1))
+ + pvc2 * v(5,1) * v(5,1)) * tfac
ls4 ( 45 5 ) inductor l=0.02 * l * 1e+6 * (log(l / w) + 0.022 * w / l + 1.19) *
+ 1e-12 * sal_fac / mf
rend2 ( 5 lo ) resistor r=11.04 / mf / (int(abs((w - 0.3u) / 0.34u) + 1))
cox1 ( 2 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
cox2 ( 3 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
cox3 ( 4 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * sacox_fac * mf
rsub ( 6 gnode ) resistor r=rsubx * sarsub_fac / mf
csub ( 6 gnode ) capacitor c=197f / rsubx * sacsub_fac * mf
ends rppolys_rf

