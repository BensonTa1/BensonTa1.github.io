subckt rppolyhri_rf_mis ( hi lo gnode )
parameters l=5u w=2u mf=1 geo_fac=1 / sqrt(mf * l * w * 1e12) factmis=0.011823 * geo_fac * par_hrirf
+ rend0=5.320e-05 * (1 + factmis) rsh=rppolyhri * (1 + factmis) dl=0u dw=0.093u pt=temp
+ pvce1=0.5 pvce2=1.25 pvce3=-1.25 ptce1=-6.5e-04 ptce2=3.5e-08 pvcp1=-0.095 pvcp2=1.205e-06
+ pvcp3=-0.873 ptcp1=-7.670e-04 ptcp2=7.594e-07 tface=1.0 + ptce1 * (pt - 25.0)
+ + ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 *
+ (pt - 25.0) * (pt - 25.0) rsubtfac=1.0 + 3.74m * (pt - 25.0) + 9.1u * (pt - 25.0)
+ * (pt - 25.0) rsubx=607.2 / ((1 / (1u + (l - dl + 0.9u) / 6) * (w - dw)) + (1
+ / (3u + (w - dw) / 6) * (l - dl + 0.9u))) * rsubtfac
rend1 ( hi 1 ) bsource r=rend0 / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(hi,1))
+ + pvce3) - tanh(pvce3))) / mf
r1 ( 1 2 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/6 w=(w-dw) kf=1.65E-22 af=2 fexp=0.95 wdexp=1 ldexp=1
r2 ( 2 3 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/3 w=(w-dw) kf=1.65E-22 af=2 fexp=0.95 wdexp=1 ldexp=1
r3 ( 3 4 ) bsource r=1 / 3 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/3 w=(w-dw) kf=1.65E-22 af=2 fexp=0.95 wdexp=1 ldexp=1
r4 ( 4 5 ) bsource r=1 / 6 * rsh * (l - dl) / (w - dw) * tfacp * (1 + pvcp1 * (tanh(pvcp2
+ * abs(v(1,5) / (l - dl)) + pvcp3) - tanh(pvcp3))) / mf  l=(l-dl)/6 w=(w-dw) kf=1.65E-22 af=2 fexp=0.95 wdexp=1 ldexp=1
rend2 ( 5 lo ) bsource r=rend0 / (w - dw) * tface * (1 + pvce1 * (tanh(pvce2 * abs(v(5,lo))
+ + pvce3) - tanh(pvce3))) / mf
cox1 ( 2 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * hricox_fac * mf
cox2 ( 3 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * hricox_fac * mf
cox3 ( 4 6 ) capacitor c=1 / 3 * (0.09677 * w * (l + 0.9u) * 1e+12 + 0.05582 * 2
+ * (w + l + 0.9u) * 1e+6 + 0.1) * 1e-15 * hricox_fac * mf
rsub ( 6 gnode ) resistor r=rsubx * hrirsub_fac / mf
csub ( 6 gnode ) capacitor c=197f / rsubx * hricsub_fac * mf
ends rppolyhri_rf_mis
endsection rf_res_hri

// ****************************************************************************
