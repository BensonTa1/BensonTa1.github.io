section tt_rfsbd
parameters factor_isf_wi=1
parameters factor_re_wi=1
parameters factor_isr_wi=1
parameters factor_cjf_wi=1
parameters factor_isf_wo=1
parameters factor_re_wo=1
parameters factor_isr_wo=1
parameters factor_cjf_wo=1
parameters factor_l=1
parameters factor_rm=1
parameters factor_rsub=1
parameters factor_csub=1
parameters factor_rnwell=1
parameters factor_csti=1
parameters factor_is_d=1
parameters factor_jsw_d=1
parameters factor_n_d=1
parameters factor_rs_d=1
parameters factor_cj_d=1
parameters factor_cjsw_d=1
include "cr013g_2d5_v1d4.scs" section=rf_sbd
 
endsection tt_rfsbd
 
 

section ss_rfsbd
parameters factor_isf_wi=0.1
parameters factor_re_wi=1.3
parameters factor_isr_wi=1 / 25
parameters factor_cjf_wi=1.25
parameters factor_isf_wo=0.05
parameters factor_re_wo=1.3
parameters factor_isr_wo=1 / 15
parameters factor_cjf_wo=1.25
parameters factor_l=1.0235
parameters factor_rm=1.1
parameters factor_rsub=0.8
parameters factor_csub=1.25
parameters factor_rnwell=1.15
parameters factor_csti=1.05
parameters factor_is_d=0.7
parameters factor_jsw_d=0.5
parameters factor_n_d=1.0025
parameters factor_rs_d=1.2
parameters factor_cj_d=1.05
parameters factor_cjsw_d=1.1
include "cr013g_2d5_v1d4.scs" section=rf_sbd
 
endsection ss_rfsbd
 
 

section ff_rfsbd
parameters factor_isf_wi=1.9
parameters factor_re_wi=0.7
parameters factor_isr_wi=25
parameters factor_cjf_wi=0.75
parameters factor_isf_wo=1.95
parameters factor_re_wo=0.7
parameters factor_isr_wo=15
parameters factor_cjf_wo=0.75
parameters factor_l=0.9762
parameters factor_rm=0.9
parameters factor_rsub=1.2
parameters factor_csub=0.75
parameters factor_rnwell=0.85
parameters factor_csti=0.95
parameters factor_is_d=1.3
