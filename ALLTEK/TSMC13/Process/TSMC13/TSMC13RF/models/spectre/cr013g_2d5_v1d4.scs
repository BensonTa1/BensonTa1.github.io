+ w as=2 * hdifn_25 / factor * w pd=2 * (2 * hdifn_25 / factor + w) ps=2 * (2 * hdifn_25 
+ / factor + w) nrd=hdifn_25 / factor / w nrs=hdifn_25 / factor / w temp1=parn1_25 
+ temp2=parn2_25 fac1=0.427 * temp1 + 0.904 * temp2 fac2=0.427 * temp1 - 0.904 * 
+ temp2 lef=l - 4.0e-8 wef=w + 1.0e-8 geo_fac=1 / sqrt(multi * lef * wef * 1e12) 
+ vthmis=0.006243 * geo_fac * fac1 dlmis=0.002279 * geo_fac * lef * fac2 dwmis= 
+ - 0.002279 * geo_fac * wef * fac2 toxmis=0.002279 * geo_fac * toxn_25 * fac2 
