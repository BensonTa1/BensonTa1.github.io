r1 ( 1 4 ) resistor r=r_1 * factor_rm * (1 + (temp - 25) * 2.93e-3)
l1 ( 4 5 ) inductor l=l_1 * factor_l
csti ( 5 8 ) capacitor c=c_sti * factor_csti
// --- Schottky diode
df1 ( 5 11 ) f_diode1_wi area=a1_eff pj=p1_eff
rs1 ( 11 6 ) resistor r=r_s1 * factor_re_wi
dr ( 11 5 ) r_diode_wi area=a1_eff pj=p1_eff
// --- PN junction diode
df2 ( 5 21 ) f_diode2_wi area=a2_eff pj=p2_eff
rs2 ( 21 6 ) resistor r=r_s2 * factor_re_wi
cpp ( 5 3 ) capacitor c=c_pp
// --- Substrate network
ddnw ( 31 7 ) dio_dnwpsub area=adnw_eff pj=pdnw_eff
rsub ( 31 3 ) resistor r=r_sub * factor_rsub * (1 + (temp - 25) * 3.74e-3 + (temp 
+ - 25) * (temp - 25) * 9.1e-6)
csub ( 31 3 ) capacitor c=c_sub * factor_csub * (1 + (temp - 25) * 3.74e-3 + (temp 
+ - 25) * (temp - 25) * 9.1e-6)
rnwell1 ( 6 7 ) resistor r=r_nwell / 2 * factor_rnwell * (1 + (temp - 25) * 3.74e-3 
+ + (temp - 25) * (temp - 25) * 9.1e-6)
rnwell2 ( 7 8 ) resistor r=r_nwell / 2 * factor_rnwell * (1 + (temp - 25) * 3.74e-3 
+ + (temp - 25) * (temp - 25) * 9.1e-6)
 
r2 ( 8 9 ) resistor r=r_2 * factor_rm * (1 + (temp - 25) * 2.93e-3)
l2 ( 9 2 ) inductor l=l_2 * factor_l
 
// -- Forward diode No. 1 ---
// 
model f_diode1_wi diode 
+ level=1                   is=is_fdiode1_wi          rs=1e-010
+ n=n_fdiode1_wi            bv=1e4                    ibv=is_fdiode1_wi
+ ik = 3e+005               ikr = 1e+010
+ isw=3.5e-014              cj=cj_fdiode1_wi          vj=0.8756
+ mj=mj_fdiode1_wi          cjsw=0                    vjsw=0.8956
+ mjsw=0.6823               tlev=2                    eg=0.48
+ xti=2                     tbv1=-1*-0.000888         trs=0.00277
+ tlevc=1                   cta=0.0003067             ctp=0.0002781
+ pta=0.00302               ptp=0.001427              tnom=25
+ fc=0                      ns=n_fdiode1_wi           nz=n_fdiode1_wi
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- Reverse diode to model leakage current ---
// 
model r_diode_wi diode 
+ level=1                   is=is_rdiode_wi           rs=1e-010
+ n=n_rdiode_wi             bv=1e4                    ibv=is_rdiode_wi
+ ik = 6e+004               ikr = 5e+005
+ isw=1.55e-013             cj=0                      vj=0.2006
+ mj=0.4528                 cjsw=0                    vjsw=0.7956
+ mjsw=0.2323               tlev=2                    eg=4.50
+ xti=12                    tbv1=-1*-0.000888         trs=0.00277
+ tlevc=1                   cta=0.0009067             ctp=0.0002781
+ pta=0.001427              ptp=0.001427              tnom=25
+ fc=0                      ns=n_rdiode_wi            nz=n_rdiode_wi
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- Forward diode No. 2, P+/NW STI Diode ---
// 
model f_diode2_wi diode 
+ level=1                   is=1.8e-007*factor_is_d   rs=1e-010*factor_rs_d
+ n=1.02*factor_n_d         bv=8.33                   ibv=0.02
+ ik = 1e+020               ikr = 1e+010
+ isw=6.6e-014*factor_jsw_d cj=0.001369*factor_cj_d   vj=0.9
+ mj=0.4234                 cjsw=9.8e-011*factor_cjsw_d
+ vjsw=0.9                  mjsw=0.1716               tlev=1
+ eg=1.17                   xti=3                     tbv1=-1*-0.000845
+ trs=0.00289               tlevc=1                   cta=0.000887
+ ctp=0.000298              pta=0.001643              ptp=0.001643
+ tnom=25                   fc=0                      area=3.92e-008
+ pj=0.00084                ns=1.02*factor_n_d        nz=1.02*factor_n_d
+ imax=1e40                 minr=1e-10                allow_scaling=1
 
 
// -- DNW/PSUB diode ---
// 
model dio_dnwpsub diode 
+ level=1                   is=9.76e-007              rs=1e-010
+ n=1.02                    bv=13.8                   ibv=0.03
+ ik = 1e+020               ikr = 1e+010
+ isw=4.13e-012             area=3.92e-008            pj=0.00084
+ cj=0.0001322              vj=0.6012                 mj=0.3431
+ cjsw=1.357e-009           vjsw=0.6012               mjsw=0.3037
+ tlev=1                    eg=1.17                   xti=3
+ tbv1=-1*-0.00071          trs=0.00265               tlevc=1
+ cta=0.002573              ctp=0.002055              pta=0.003146
+ ptp=0.003146              tnom=25                   fc=0
+ ns=1.02                   nz=1.02                   imax=1e40
+ minr=1e-10                allow_scaling=1
 
 
ends sbd_rf
