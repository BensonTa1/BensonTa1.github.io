inline subckt nch_na_g ( n11 n2 n33 n4 ) 
parameters l=1u w=1u factor=1 multi=1 ad=2 * hdifn_na / factor * w as=2 * hdifn_na / 
+ factor * w pd=2 * (2 * hdifn_na / factor + w) ps=2 * (2 * hdifn_na / factor + w) 
+ nrd=hdifn_na / factor / w nrs=hdifn_na / factor / w w1=(w * factor + 0.015e-6 + dxw_na) 
+ * multi l1=l * factor - 0.02e-6 + dxl_na tcc=1 + 1.7e-3 * (temp - 25) area=w1 
+ * 2.5e-9 * 1e4 * tcc tox=(toxn_na - 8.3e-10) * 1e2 jf=2.704e-08 ef=2.623e+07 varaf= 
+ - 0.18955 * log(l1) + 0.99251 varbf=0.54 * ef * tox jr=5.065e-7 er=7.43e6 varar= 
+ - 0.072266 * log(l1) + 16.394 varbr=0.52 * er * tox forward_eff=area * jf * exp( 
+ - ef * tox * varaf) / pow(tox,2.5) reverse_eff=area * jr * exp( - er * tox * varar) 
+ / pow(tox,2.5) tmp1=varbf + 2.0 tmp2=varbr + 2.0 
 
nch_na_g ( n1 n2 n3 n4 ) nch_na w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi
 
gdf1 ( n2 n1 ) bsource i =forward_eff * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,tmp2) + 1e-18 * v(n2,n1)
 
gdf2 ( n2 n3 ) bsource i =forward_eff * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,tmp1) 
+ - reverse_eff * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,tmp2) + 1e-18 * v(n2,n3)
 
rdn ( n1 n11 ) resistor r=6.6 * nrd / multi
rsn ( n3 n33 ) resistor r=6.6 * nrs / multi
ends nch_na_g
 
