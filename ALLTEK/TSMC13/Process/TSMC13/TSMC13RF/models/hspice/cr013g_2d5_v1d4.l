*****************************************************************************
*   
* CMOS 0.13um Schottky Barrier Diode (SBD) Scalable Model
*
* HSPICE LEVEL 49:
*  
*     ## library files:
*        Model Name        l(um)             w(um)               nf
*                        low   high      low     high       low    high  
*        --------------------------------------------------------------------
*        sbd_rf           2      4        4       16         1      16
*        sbd_rf_nw        2      4        4       16         1      16
*        --------------------------------------------------------------------
*     End Model
*
*****************************************************************************
.LIB RF_SBD

*****************************************************************************
*****                 Schottky Diode with Deep N-Well                   *****
*****************************************************************************
.subckt sbd_rf 1 2 3 l=2e-006 w=16e-006 nf=16
.param lum = 'l*1e6'
.param wum = 'w*1e6'

.param num_strip = 'int(6+(lum-2)*2.8)'
.param r_strip = '(1.16*0.09/0.16)+(int((wum-0.08*2+0.18)/0.34)-1)*(2*int((wum-0.08*2+0.18)/0.34)-1)/6/int((wum-0.08*2+0.18)/0.34)*(0.36/0.16*0.09)+0.68/int((wum-0.08*2+0.18)/0.34)'
.param leng_strip = 'r_strip*0.16/0.09'
.param lph_end = '(0.36*int(6+(lum-2)*2.8)+0.4)*1.8'
.param num_sidebranch = '(-1)*(int((nf+1)/2-int(nf/2))-1)*nf/2+(int((nf+1)/2-int(nf/2)))*1'
.param lph_sidex1 = 'lph_end+(num_sidebranch-1)*(2*num_sidebranch-1)/6/num_sidebranch*lph_end+r_strip*0.16/0.09/num_sidebranch-int((nf+1)/2-int(nf/2))*lph_end/2'
.param lph_sidex2 = 'lph_sidex1/2'
.param lph_center = 'leng_strip*1.8'


.param a1_eff = '(l-0.18u)*(w-0.18u)*nf'
.param p1_eff = '((l-0.18u)+(w-0.18u))*2*nf'
.param a2_eff = 'l*w*nf-a1_eff'
.param p2_eff = '(l+w)*2*nf+p1_eff'

.param ldnw_eff = '0.3u*(nf+1)+(0.36u*2+l)*nf+1.41u*2'
.param wdnw_eff = 'w+1.41u*2'
.param adnw_eff = 'ldnw_eff*wdnw_eff'
.param pdnw_eff = '(ldnw_eff+wdnw_eff)*2'

.param r_s1 = '(0.275397)/nf+(0.040389)/lum+(0.476984)/wum+(80.52809)/lum/wum/nf+(1.84136)/lum/wum+(2.915102)/lum/nf+(21.89838)/wum/nf+(0.206569)-0.2'
.param r_s2 = '(3.38)/nf+(0.40944)/lum+(2.338413)/wum+(127.1533)/lum/wum/nf+(4.11991)/lum/wum+(3.99565)/lum/nf+(31.32444)/wum/nf+(-0.17944)'
.param r_1 = 'r_strip/num_strip/nf'
.param l_1 = 'leng_strip*2/num_strip/nf*1e-12'
.param r_2 = 'r_strip/(nf+1)/0.46*0.16'
.param l_2 = '(lph_sidex2*lph_center/(lph_sidex2+lph_center)*(1-int((nf+1)/2-int(nf/2)))+lph_sidex2*int((nf+1)/2-int(nf/2)))*1e-12'

.param r_nwell = '((10.68095)/nf+(0.793813)*lum+(7.825079)/wum+(50.65912)*lum/wum/nf+(-2.16331)*lum/wum+(-1.60032)*lum/nf+(168.78571)/wum/nf+(-0.14392))*(1-1.7e-5*wum**1.5*nf**1.5*lum)-0.6'
.param r_sub = '(-12.291620)/nf+23.746600/lum+(-19.798286)/wum+(-515.426543)/lum/wum/nf+(-31.316278)/lum/wum+(-45.520722)/lum/nf+(512.782361)/wum/nf+8.585479*lum+(-86.802801)*lum/nf/wum+434.279539*1/sqrt(lum*wum*nf)+(-2.220411)'
.param c_sub = '(0.038987*nf+(-0.657017)*lum+(-0.249364)*wum+0.003826*lum*wum*nf+(-0.132405)*lum*wum+(0.009054)*lum*nf+(0.011490)*wum*nf+(2.163004)*sqrt(lum*wum)+(-0.030696)*sqrt(lum*wum)*nf+2.742608)*1e-15'
.param c_sti = '((-0.112288)*nf+(-0.013586)*lum+(0.130999)*wum+(0.031009)*lum*wum*nf+(0.006041)*lum*wum+(0.023377)*lum*nf+(0.120170)*wum*nf+(-0.033538)*sqrt(wum*lum)+(-0.112984))*1e-15'
.param c_pp = '((-0.282619)*nf+(-1.328147)*lum+(-0.115162)*wum+(0.017999)*lum*wum*nf+(-0.043202)*lum*wum+(0.412528)*lum*nf+(0.011854)*wum*nf+(0.751030)*sqrt(wum*lum)+(2.692831))*1e-15'

.param is_fdiode1_wi = '((-30.7221)*lum+(-41.6847)*wum+(-665.5646)/nf+(-7.0269)*lum*wum+(-183.3680)*lum/nf+(-120.9697)*wum/nf+(-47.1611)*lum*wum/nf+(978.5453)*sqrt(wum*lum)/nf+261.7520*sqrt(wum*lum)+(-78.4284))*factor_isf_wi'
.param n_fdiode1_wi = '(0.088201)/lum+(0.028120)/wum+(-0.027211)/lum/wum+(0.007037)*lum+(-0.000642)*wum+0.884969'
.param cj_fdiode1_wi = '((-0.001644)/lum+(-0.001983)/wum+(0.001299)/lum/wum+(-0.000017)*lum+(4.125926e-06)*wum+(0.004069))*factor_cjf_wi'
.param mj_fdiode1_wi = '(0.036552)/lum+(0.104677)/wum+(-0.451701)/lum/wum+(0.0128)*lum+(0.000296)*wum+0.643196'

.param is_rdiode_wi = '((-12.83783)*nf+(-90.98964)*lum+(-47.0175)*wum+(5.05497)*lum*wum*nf+(20.70406)*lum*wum+(-6.06581)*lum*nf+(-8.05982)*wum*nf+(114.69857)*sqrt(lum*wum)+(17.08802)*sqrt(lum*wum)*nf+(161.30248))*factor_isr_wi'
.param n_rdiode_wi = '(-0.485714)/lum+(-4.025397)/wum+(7.591474)/lum/wum+(0.011111)*lum+(-0.011111)*wum+(0.736508)*lum/wum+(0.013968)*wum/lum+12.972222'

*=====================
r1 1 4 'r_1*factor_rm*(1+(temper-25)*2.93e-3)'
l1 4 5 'l_1*factor_l'
csti 5 8 'c_sti*factor_csti'
*--- Schottky diode
df1 5 11 f_diode1_wi area = 'a1_eff' pj = 'p1_eff'
rs1 11 6 'r_s1*factor_re_wi'
dr 11 5 r_diode_wi area = 'a1_eff' pj = 'p1_eff'
*--- PN junction diode
df2 5 21 f_diode2_wi area = 'a2_eff' pj = 'p2_eff'
rs2 21 6 'r_s2*factor_re_wi'
cpp 5 3 'c_pp'
*--- Substrate network
ddnw 31 7 dio_dnwpsub area = 'adnw_eff' pj='pdnw_eff'
rsub 31 3 'r_sub*factor_rsub*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
csub 31 3 'c_sub*factor_csub*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
rnwell1 6 7 'r_nwell/2*factor_rnwell*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
rnwell2 7 8 'r_nwell/2*factor_rnwell*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'

r2 8 9 'r_2*factor_rm*(1+(temper-25)*2.93e-3)'
l2 9 2 'l_2*factor_l'

*-- Forward diode No. 1 ---
.MODEL f_diode1_wi  		 D (
+ LEVEL = 3         		 IS = 'is_fdiode1_wi'		 RS = 1E-010        		 N = 'n_fdiode1_wi' 		
+ BV = 1e4          		 IBV = 'is_fdiode1_wi'		 IK = 3E+005        		 IKR = 1E+010       		
+ JSW = 3.5E-014    		 CJ = 'cj_fdiode1_wi'		 PB = 0.8756        		 MJ = 'mj_fdiode1_wi'		
+ CJSW = 0          		 PHP = 0.8956       		 MJSW = 0.6823      		 TLEV = 2           		
+ EG = 0.48         		 XTI = 2            		 TCV = -0.000888    		 TRS = 0.00277      		
+ TLEVC = 1         		 CTA = 0.0003067    		 CTP = 0.0002781    		 TPB = 0.00302      		
+ TPHP = 0.001427   		 TREF = 25          		 FC = 0             		 FCS = 0 )

*-- Reverse diode to model leakage current ---
.MODEL r_diode_wi   		 D (
+ LEVEL = 3         		 IS = 'is_rdiode_wi'		 RS = 1E-010        		 N = 'n_rdiode_wi'  		
+ BV = 1e4            		 IBV = 'is_rdiode_wi'		 IK = 6E+004        		 IKR = 5E+005       		
+ JSW = 1.55E-013   		 CJ = 0             		 PB = 0.2006        		 MJ = 0.4528        		
+ CJSW = 0          		 PHP = 0.7956       		 MJSW = 0.2323      		 TLEV = 2           		
+ EG = 4.50         		 XTI = 12            		 TCV = -0.000888    		 TRS = 0.00277      		
+ TLEVC = 1         		 CTA = 0.0009067    		 CTP = 0.0002781    		 TPB = 0.001427     		
+ TPHP = 0.001427   		 TREF = 25          		 FC = 0             		 FCS = 0 )

*-- Forward diode No. 2, P+/NW STI Diode ---
.MODEL f_diode2_wi  		 D (
+ LEVEL = 3         		 IS = '1.8E-007*factor_is_d'		 RS = '1E-010*factor_rs_d' 		 N = '1.02*factor_n_d'		
+ BV = 8.33         		 IBV = 0.02         		 IK = 1E+020        		 IKR = 1E+010       		
+ JSW = '6.6E-014*factor_jsw_d'	 CJ = '0.001369*factor_cj_d'		 PB = 0.9           		 MJ = 0.4234        		
+ CJSW = '9.8E-011*factor_cjsw_d'	 PHP = 0.9          		 MJSW = 0.1716      		 TLEV = 1           		
+ EG = 1.17         		 XTI = 3            		 TCV = -0.000845    		 TRS = 0.00289      		
+ TLEVC = 1         		 CTA = 0.000887     		 CTP = 0.000298     		 TPB = 0.001643     		
+ TPHP = 0.001643   		 TREF = 25          		 FC = 0             		 FCS = 0            		
+ AREA = 3.92E-008  		 PJ = 0.00084 )

*-- DNW/PSUB diode ---
.MODEL dio_dnwpsub  		 D (
+ LEVEL = 3         		 IS = 9.76E-007     		 RS = 1E-010        		 N = 1.02           		
+ BV = 13.8         		 IBV = 0.03         		 IK = 1E+020        		 IKR = 1E+010       		
+ JSW = 4.13E-012   		 AREA = 3.92E-008   		 PJ = 0.00084       		 CJ = 0.0001322     		
+ PB = 0.6012       		 MJ = 0.3431        		 CJSW = 1.357E-009  		 PHP = 0.6012       		
+ MJSW = 0.3037     		 TLEV = 1           		 EG = 1.17          		 XTI = 3            		
+ TCV = -0.00071    		 TRS = 0.00265      		 TLEVC = 1          		 CTA = 0.002573     		
+ CTP = 0.002055    		 TPB = 0.003146     		 TPHP = 0.003146    		 TREF = 25          		
+ FC = 0            		 FCS=0 )

.ends sbd_rf
