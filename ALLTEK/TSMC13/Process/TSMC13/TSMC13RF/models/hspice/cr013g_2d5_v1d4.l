.LIB MAC_uhvt

.SUBCKT nch_uhvt_g n11 n2 n33 n4 l=length w=width m=1 scale=1 sa=0.35u sb=0.35u ad='2*hdifn_uhvt/scale*w' as='2*hdifn_uhvt/scale*w' pd='2*(2*hdifn_uhvt/scale+w)' ps='2*(2*hdifn_uhvt/scale+w)' nrd='hdifn_uhvt/scale/w' nrs='hdifn_uhvt/scale/w'

MAIN n1 n2 n3 n4 nch_uhvt  w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=m sa=sa sb=sb
.param w1='(w*scale+0.015e-6+dxw_uhvt)*m' l1='l*scale-0.02e-6+dxl_uhvt'
.param tcc= '1+1.7e-3*(temper-25)'
.param Area='w1*2.5e-9*1e4*tcc'
.param Tox='(toxn_uhvt-8.3e-10)*1e2'
.param JF= '2.704e-08'
.param EF= '2.623e+07'
.param varaf= '-0.18955*log(l1)+0.99251'
.param varbf= '0.54*EF*Tox'
.param JR= '5.065e-7'
.param ER= '7.43e6'
.param varar= '-0.072266*log(l1)+16.394'
.param varbr= '0.52*ER*Tox'
.param forward_eff= '0.5*Area*JF*exp(-EF*Tox*varaf)/pwr(Tox,2.5)'
.param reverse_eff= '0.5*Area*JR*exp(-ER*Tox*varar)/pwr(Tox,2.5)'

.param tmp1= "varbf+2.0"
.param tmp2= "varbr+2.0"
GDF1 n2 n1 Cur="forward_eff*pwr((abs(v(n2,n1))+v(n2,n1))/2,tmp1)-reverse_eff*pwr((abs(v(n2,n1))-v(n2,n1))/2,tmp2)+1e-18*v(n2,n1)"

GDF2 n2 n3 Cur="forward_eff*pwr((abs(v(n2,n3))+v(n2,n3))/2,tmp1)-reverse_eff*pwr((abs(v(n2,n3))-v(n2,n3))/2,tmp2)+1e-18*v(n2,n3)"

rdn n1 n11  '6.6*nrd/m'
rsn n3 n33  '6.6*nrs/m'
.ENDS

.SUBCKT pch_uhvt_g p11 p2 p33 p4 l=length w=width m=1 scale=1 sa=0.35u sb=0.35u ad='2*hdifp_uhvt/scale*w' as='2*hdifp_uhvt/scale*w' pd='2*(2*hdifp_uhvt/scale+w)' ps='2*(2*hdifp_uhvt/scale+w)' nrd='hdifp_uhvt/scale/w' nrs='hdifp_uhvt/scale/w'

MAIN p1 p2 p3 p4 pch_uhvt  w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=m sa=sa sb=sb

.param JF          = '1.1575e-07'         
.param EF          = '7.127e+06'
.param JR          = '2.8e-8 '
.param ER          = '4.373e6  '
.param w1          = '(w*scale+0.015e-6+dxw_uhvt)*m' 
.param l1          = 'l*scale+dxl_uhvt-0.02e-6'
.param Tox         = '(toxp_uhvt-8e-10)*1e2'
.param tcc         = '1+1.4e-3*(temper-25)'
.param Area        = 'w1*6.1e-9*1e4*tcc'
.param varaf       = '-0.70902*log(l1)+5.9821'
.param varbf       = '1.2 *EF*Tox'
.param varbr       = '0.52*ER*Tox'
.param varar       = '-0.31121*log(l1)+24.530'
.param forward_eff = 'Area*JF*exp(-EF*Tox*varaf)/pwr(Tox,2.5)'
.param reverse_eff = '4.5*Area*JR*exp(-ER*Tox*varar)/pwr(Tox,2.5)'


.param tmp1= "varbf+2.0"
.param tmp2= "varbr+2.0"
GDF1 p1 p2 Cur="forward_eff*pwr((abs(v(p1,p2))+v(p1,p2))/2,tmp1)-reverse_eff*pwr((abs(v(p1,p2))-v(p1,p2))/2,tmp2)+1e-18*v(p1,p2)"

GDF2 p3 p2 Cur="forward_eff*pwr((abs(v(p3,p2))+v(p3,p2))/2,tmp1)-reverse_eff*pwr((abs(v(p3,p2))-v(p3,p2))/2,tmp2)+1e-18*v(p3,p2)"


rdp p1 p11  '7.2*nrd/m'
rsp p3 p33  '7.2*nrs/m'
