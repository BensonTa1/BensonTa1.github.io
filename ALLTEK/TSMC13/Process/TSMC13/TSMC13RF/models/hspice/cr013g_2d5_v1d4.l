.LIB MIM
**************************************************************************************************
*  MIM CAPACITOR MODEL :
*
*
*     ## library files:
*     
*     1. The base band 1.0fF MIM capacitors with sub-circuit 'mimcap_1p0_sin'
*     2. The base band 1.5fF MIM capacitors with sub-circuit 'mimcap_1p5_sin'
*      
*
*            Model name        lt(um)          wt(um)         
*                           low    high    low    high   
*     --------------------------------------------------
*     mimcap_1p0_sin         2     100      2     100
*     mimcap_1p5_sin         2     100      2     100
*     --------------------------------------------------
*     End Model
*            **lt: length dimension of top metal
*            **wt: width dimension of top metal
*             
*
**************************************************************************************************
.subckt mimcap_1p0_sin top bottom lt=10u wt=10u
.param cmim_para ='(((wt-0.108e-6)*(lt-0.108e-6)*1e12*1.0274)+2*((wt-0.108e-6)+(lt-0.108e-6))*1e6*0.1686)*1e-15*(1+(temper-25)*-4.13e-5+(temper-25)*(temper-25)*-8e-8)'

*
cmim top bottom 'cmim_para*(1+v(top,bottom)*2.96e-5+(abs(v(top,bottom))**2)*-2.44e-5)*cmimbb_mimfac'
*
.ends mimcap_1p0_sin
*
*
.subckt mimcap_1p5_sin top bottom lt=10u wt=10u
.param cmim_para ='(((wt-0.092e-6)*(lt-0.092e-6)*1e12*1.547)+2*((wt-0.092e-6)+(lt-0.092e-6))*1e6*0.164)*1e-15*(1+(temper-25)*-5.016e-5+(temper-25)*(temper-25)*6.5e-9)'
*
cmim top bottom 'cmim_para*(1+v(top,bottom)*-3.043e-5+(abs(v(top,bottom))**2)*-4.6125e-5)*cmimbb_mimfac'
*
.ends mimcap_1p5_sin
*
*
**********************************
*       Mismatch   model         *
**********************************
.subckt mimcap_1p0_sin_mis top bottom lt=10u wt=10u mf=1
.param geo_fac ='1/sqrt(mf*lt*wt*1e12)'
.param factmis='0.004458*geo_fac*par_mim' 
.param cmim_para ='(1+factmis)*mf*(((wt-0.108e-6)*(lt-0.108e-6)*1e12*1.0274)+2*((wt-0.108e-6)+(lt-0.108e-6))*1e6*0.1686)*1e-15*(1+(temper-25)*-4.13e-5+(temper-25)*(temper-25)*-8e-8)'
*
cmim top bottom 'cmim_para*(1+v(top,bottom)*2.96e-5+(abs(v(top,bottom))**2)*-2.44e-5)*cmimbb_mimfac'
*
.ends mimcap_1p0_sin_mis

.subckt mimcap_1p5_sin_mis top bottom lt=10u wt=10u mf=1
.param geo_fac ='1/sqrt(mf*lt*wt*1e12)'
.param factmis='0.006042*geo_fac*par_mim'
.param cmim_para ='(1+factmis)*mf*(((wt-0.092e-6)*(lt-0.092e-6)*1e12*1.547)+2*((wt-0.092e-6)+(lt-0.092e-6))*1e6*0.164)*1e-15*(1+(temper-25)*-5.016e-5+(temper-25)*(temper-25)*6.5e-9)'
*
cmim top bottom 'cmim_para*(1+v(top,bottom)*-3.043e-5+(abs(v(top,bottom))**2)*-4.6125e-5)*cmimbb_mimfac'
*
.ends mimcap_1p5_sin_mis

.ENDL MIM



