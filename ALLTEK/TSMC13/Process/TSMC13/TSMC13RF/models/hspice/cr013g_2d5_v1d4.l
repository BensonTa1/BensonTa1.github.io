+xl_var    = 0.027E-6       xw_var    = 0.0075E-6
+Cmin_a    = 1.932E-3       Cmin_l    = 2.3E-10        Cmin_w = 3.772E-10  
+dCga      = 4.813E-3       dCgw      = 0
+fac_var   = 0.4082
.lib 'cr013g_2d5_v1d4.l' MOS_CAP
.ENDL SS_MOS_CAP
******************* CORNER_LIB OF FAST MODEL *****************************
.LIB FF_MOS_CAP
.param
+xl_var    = 0.037E-6      xw_var    = -0.0075E-6 
+Cmin_a    = 2.268E-3      Cmin_l    = 2.7E-10         Cmin_w = 4.428E-10    
+dCga      = 5.187E-3      dCgw      = 0
+fac_var   = 2.45
.lib 'cr013g_2d5_v1d4.l' MOS_CAP
.ENDL FF_MOS_CAP
**************************************************************************
.LIB MOS_CAP

.subckt nmoscap ng nds lr=10E-6 wr=10E-6 

.param l_eff='(lr-2*xl_var)'
.param w_eff='(wr-2*xw_var)'
.param a_eff='(l_eff*w_eff)'
.param dVgs='-0.05*(1+3.6E-03*(temper-25))'
.param Vgnorm='0.35*(1+2.03E-03*(temper-25))'
 
cg ng nds '((Cmin_a*a_eff+2*Cmin_l*l_eff+2*Cmin_w*w_eff)+(dCga*a_eff+2*dCgw*w_eff)*(1.0+tanh((v(ng,nds)-dVgs)/Vgnorm)))'

.param forward_eff= 'a_eff*6E2'
.param gtmp= '50E-12'
.param varbf= '2.2'
.param rev_eff= 'a_eff*1.5E1'
.param varbr= '0'


GDF1 ng nds Cur="fac_var*(forward_eff*pwr((abs(v(ng,nds))+v(ng,nds))/2,varbf+2)+gtmp*(abs(v(ng,nds))+v(ng,nds))-rev_eff*pwr((abs(v(ng,nds))-v(ng,nds))/2,varbr+2))"
 
.ends nmoscap
.ENDL MOS_CAP
