************************************************************************

.LIB RTMOM

****************************************************************************************
*                                                                                      *                                                         *
*                        RTMOM with  Width = 0.2um                                     *
*                                                                                      *
*                        parameter range: nv : 8~288, nh : 8~288                       *
*                                         nv and nh should be even fingers             *
*                                         s(spacing):0.21u ~0.4u                       *
*                                         lay(MOM layer number): 3~6                   *
*                                                                                      *
*                                                                                      *                                                      *
****************************************************************************************
.subckt crtmom a b p nv=32 nh=32 s=0.21u lay=6
.param 
+ Edg='((INT((lay-1)/2)+2600/3700)*(nv-1)*(nh*(0.2u+s)-s)+INT(lay/2)*(nh-1)*(nv*(0.2u+s)-s))'
+ AREA='(nv*nh/2*0.2u*0.2u*(lay-1))'
+ FRI2='((INT((lay+1)/2)*nv*0.2u+INT(lay/2)*nh*0.2u)+0.21u*2*lay+INT(lay/2)*(nv*(0.2u+s)-s+0.5u)*2+INT((lay+1)/2)*(nh*(0.2u+s)-s)*2)'
+ FRI1='((nh*nv/2*0.2u*4)*(lay-1))'
+ Abm = '(((nv*(0.2u+s)-s+0.71u*2) +(nh*(0.2u+s)-s+0.5u))*0.21u)'
+ Afm = '(nv*0.2u*(nh*(0.2u+s)-s+0.5u)/2)'
+ Pf = '((nh*(0.2u+s)-s+0.5u)*(nv)+2*((nv*(0.2u+s)-s+1.42u)+(nh*(0.2u+s)-s+0.71u)))'
+ Cc1 = '0.42*s**2*1e12-0.4714*s*1e6+0.1865'
+ Cc2 = '0.0532'
+ Cf = '-0.001*s**2*1e12+0.0277*s*1e6+0.004'
+ Ca = '(-0.0333*s**2*1e12+0.0373*s*1e6+0.0106)/0.2'
+ Ca_p = '(-0.0931*s*s*1e12+0.0767*s*1e6+0.0152)/0.2'
+ Cf_p = '0.014*s*s*1e12+0.0298*s*1e6+0.0063'
*
Cab a b '(Cc1*Edg*1e-9+Cf*1e-9*FRI1+Ca*1e-3*AREA+Cc2*1e-9*FRI2)*(1+(temper-25)*30.36*1e-6+(temper-25)*(temper-25)*1e-8)*(1-2.65*1e-6*v(a,b)-0.1*1e-6*v(a,b)*v(a,b))*RTMOM_fac'
Cpa a p '(Ca_p*(Abm+Afm)*1e-3+Cf_p*Pf*1e-9)*(1+(temper-25)*30.36*1e-6+(temper-25)*(temper-25)*1e-8)*(1-2.65*1e-6*v(a,p)-0.1*1e-6*v(a,p)*v(a,p))*RTMOM_fac'
Cpb b p '(Ca_p*(Abm+Afm)*1e-3+Cf_p*Pf*1e-9)*(1+(temper-25)*30.36*1e-6+(temper-25)*(temper-25)*1e-8)*(1-2.65*1e-6*v(b,p)-0.1*1e-6*v(b,p)*v(b,p))*RTMOM_fac'

.ends crtmom

.ENDL RTMOM


