**************************************************************************************************
*
* 1.2V CORE SVT MOS MODEL
*
*
*
*              .lib RF_MOS : Typical
*
*              Model name       nr               lr (um)           wr (um)
*                            low   high        low     high     low    high
*            -----------------------------------------------------------------
*              nmos_rf        1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*              pmos_rf        1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*              pmos_rf_nw     1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*              nmos_rf_mis    1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*              pmos_rf_mis    1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*              pmos_rf_nw_mis 1     64         0.13    0.24     1.2     10
*            -----------------------------------------------------------------
*            End Model
*            **nr: Finger number
*            **wr: Width per finger
*
**************************************************************************************************


.LIB RF_MOS
.SUBCKT nmos_rf D G S B lr=13.E-08 nr=1 wr=2.5E-6
.param Lspace=0.42u
.param Ledge=2.0u
.param Ledgeeff=0.73u
.param Lsti=1.0u
.param Wsti=2.0u
.param Rod=2015
.param Rsti=3364
.param Ns='int(nr/2+1)'
.param Nd='int((nr+1)/2)'
.param Nodd='(nr-int(nr/2)*2)'
.param dummyflag=1
.param SLeff='Ledge+dummyflag*(Ledgeeff-Ledge)'
.param SReff='Ledge+dummyflag*(Ledgeeff-Ledge)'
.param LdioS='(Ns-2)*Lspace+SLeff+SReff+Nodd*(Lspace-SLeff)'
.param LdioD='(Ns-1)*Lspace+Nodd*SLeff'
.param Lod='nr*(lr+Lspace)+2*Ledge-Lspace'
.param sdiofa='wr*LdioS'
.param sdiofp='2*LdioS+(2-Nodd)*wr*(1-dummyflag)'
.param ddiofa='wr*LdioD'
.param ddiofp='2*LdioD+Nodd*wr*(1-dummyflag)'
.param sdiogp='wr*nr+(2-Nodd)*wr*dummyflag'
.param ddiogp='wr*nr+Nodd*wr*dummyflag'
.param rsx='(0.0158*(lr*1e6+0.42)*(2*Ns+1/Ns-3) +0.771/Ns + 0.232)/(wr*1e6)'
.param rdx='0.0053*(lr*1e6+0.42)*(Nd+2/Nd) + 0.138*(wr*1e6+2.16)/Nd + 0.0867/(1.2+(Nd-1)*(lr*1e6+0.42))'
.param rgx='((0.625*(wr*1e6+0.96)/(lr*1e6-0.02)+6.46)/nr+nr*(0.000286*wr*1e6+0.0139)+0.0138*wr*1e6+0.718*lr*1e6+733*lr/nr/wr+5.189)'
.param rbx='(Rod*Lod/12+Rsti*Lsti/2)*(Rod*wr/12+Rsti*Wsti/2)/(Lod*(Rod*Lod/12+Rsti*Lsti/2)+wr*(Rod*wr/12+Rsti*Wsti/2))'
.param rdbx='Rod*lr/(wr*nr*2)'
.param cgsx='(1.3*nr*(lr*1e6+0.42)/(0.1*wr*1e6+2.9)+0.2*wr*1e6+0.67)*1e-15'
.param cgdx='(0.19*nr*lr*1e6+0.07*nr+0.282)*1e-15'
.param cdsx='(0.1+0.062*nr*wr*1e6/(lr*1e6+0.6)+1.8*nr*(lr*1e6+0.42)/(wr*1e6+9.8))*1e-15'
.param sax='1/(log((Ledge+lr/2+nr*(lr+Lspace))*(Ledge+lr/2+(nr-1)*(lr+Lspace))/(Ledge+Lspace+3*lr/2)/(Ledge+lr/2))/(2*nr*(lr+Lspace))+1/(nr*(Ledge+lr/2)))-lr/2'
.param w1='(wr+0.015e-6+dxwrf)*nr' l1='lr-0.02e-6+dxlrf'
.param tcc= '1+1.7e-3*(temper-25)'
.param Area='w1*2.5e-9*1e4*tcc'
.param Tox='(toxnrf-8.3e-10)*1e2'
.param JF= '2.704e-08'
.param EF= '2.623e+07'
.param varaf= '-0.18955*log(l1)+0.99251'
.param varbf= '0.54*EF*Tox'
.param JR= '5.065e-7'
.param ER= '7.43e6'
.param varar= '-0.072266*log(l1)+16.394'
.param varbr= '0.52*ER*Tox'
.param forward_eff= 'Area*JF*exp(-EF*Tox*varaf)/pwr(Tox,2.5)'
.param reverse_eff= 'Area*JR*exp(-ER*Tox*varar)/pwr(Tox,2.5)'
.param tmp1= "varbf+2.0"
.param tmp2= "varbr+2.0"
*********************
RG  G GI   R=rgx
RS  S SI   R=rsx
RD  D DI   R=rdx
*********************
CGS_M GI SI  C=cgsx
CGD_M GI DI  C=cgdx
CDS_M SI DI  C=cdsx
***** Diodes  ****************
DSS  SB  SI  ndio_rf_f AREA=sdiofa PJ=sdiofp
DDD  DB  DI  ndio_rf_f AREA=ddiofa PJ=ddiofp 
DSG  SB  SI  ndio_rf_g AREA=1E-15  PJ=sdiogp  
DDG  DB  DI  ndio_rf_g AREA=1E-15  PJ=ddiogp
*****************************************************************************
RB    B  BI  R=rbx TC1=0.0037 TC2=9.64E-6
CB    B  BI  C='162f/rbx'
Rdb  DB  BI  R=rdbx TC1=0.0037 TC2=9.64E-6
Cdb  DB  BI  C='162f/rdbx'
Rsb  SB  BI  R=rdbx TC1=0.0037 TC2=9.64E-6
Csb  SB  BI  C='162f/rdbx'
******* MOSFET *******
M0  DI GI SI BI nch_rf L = lr W = wr M = nr AD = 0 AS = 0 PD = 0 PS = 0 SA=sax SB=sax
GDF1 GI DI Cur="forward_eff*pwr((abs(v(GI,DI))+v(GI,DI))/2,tmp1)-reverse_eff*pwr((abs(v(GI,DI))-v(GI,DI))/2,tmp2)+1e-18*v(GI,DI)"
GDF2 GI SI Cur="forward_eff*pwr((abs(v(GI,SI))+v(GI,SI))/2,tmp1)-reverse_eff*pwr((abs(v(GI,SI))-v(GI,SI))/2,tmp2)+1e-18*v(GI,SI)"
.ENDS nmos_rf
