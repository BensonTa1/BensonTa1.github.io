*
*****************************************************************************
*****               Schottky Diode with only N-Well                     *****
*****************************************************************************
.subckt sbd_rf_nw 1 2 3 l=2e-006 w=16e-006 nf=16
.param lum = 'l*1e6'
.param wum = 'w*1e6'

.param num_strip = 'int(6+(lum-2)*2.8)'
.param r_strip = '(1.16*0.09/0.16)+(int((wum-0.08*2+0.18)/0.34)-1)*(2*int((wum-0.08*2+0.18)/0.34)-1)/6/int((wum-0.08*2+0.18)/0.34)*(0.36/0.16*0.09)+0.68/int((wum-0.08*2+0.18)/0.34)'
.param leng_strip = 'r_strip*0.16/0.09'
.param lph_end = '(0.36*int(6+(lum-2)*2.8)+0.4)*1.8'
.param num_sidebranch = '(-1)*(int((nf+1)/2-int(nf/2))-1)*nf/2+(int((nf+1)/2-int(nf/2)))*1'
.param lph_sidex1 = 'lph_end+(num_sidebranch-1)*(2*num_sidebranch-1)/6/num_sidebranch*lph_end+r_strip*0.16/0.09/num_sidebranch-int((nf+1)/2-int(nf/2))*lph_end/2'
.param lph_sidex2 = 'lph_sidex1/2'
.param lph_center = 'leng_strip*1.8'


.param a1_eff = '(l-0.18u)*(w-0.18u)*nf'
.param p1_eff = '((l-0.18u)+(w-0.18u))*2*nf'
.param a2_eff = 'l*w*nf-a1_eff'
.param p2_eff = '(l+w)*2*nf+p1_eff'

.param lnw_eff='0.3u*(nf+1)+(0.36u*2+l)*nf+0.81u*2'
.param wnw_eff='w+0.81u*2'
.param anw_eff='lnw_eff*wnw_eff'
.param pnw_eff='(lnw_eff+wnw_eff)*2'

.param r_s1 = '(0.275397)/nf+(0.040389)/lum+(0.476984)/wum+(80.52809)/lum/wum/nf+(1.84136)/lum/wum+(2.915102)/lum/nf+(21.89838)/wum/nf+(0.206569)-0.2'
.param r_s2 = '(3.38)/nf+(0.40944)/lum+(2.338413)/wum+(127.1533)/lum/wum/nf+(4.11991)/lum/wum+(3.99565)/lum/nf+(31.32444)/wum/nf+(-0.17944)'
.param r_1 = 'r_strip/num_strip/nf'
.param l_1 = 'leng_strip*2/num_strip/nf*1e-12'
.param r_2 = 'r_strip/(nf+1)/0.46*0.16'
.param l_2 = '(lph_sidex2*lph_center/(lph_sidex2+lph_center)*(1-int((nf+1)/2-int(nf/2)))+lph_sidex2*int((nf+1)/2-int(nf/2)))*1e-12'

.param r_nwell = '(7.49708)/nf+(-0.46359)*lum+(1.34025)/wum+(26.87326)*lum/wum/nf+(3.77392)*lum/wum+(2.46390)*lum/nf+(283.75263)/wum/nf+(2.26658)+(-1.4)'
.param r_sub = '(7.15281)/nf+(3.95866)/lum+(-7.70179)/wum+(-160.31468)/lum/wum/nf+(-41.95392)/lum/wum+(-45.36581)/lum/nf+(410.95059)/wum/nf+(6.58653)*lum+(-61.9672)*lum/nf/wum+(394.33295)/sqrt(lum*wum*nf)+(39.32448)'
.param c_sub = '((0.33658)*nf+(-3.67044)*lum+(-0.83015)*wum+(0.02842)*lum*wum*nf+(-0.65046)*lum*wum+(-0.01218)*lum*nf+(0.04782)*wum*nf+(10.24635)*sqrt(lum*wum)+(-0.10317)*sqrt(lum*wum)*nf+(27.01793))*1e-15'
.param c_sti = '((-0.112288)*nf+(-0.013586)*lum+(0.130999)*wum+(0.031009)*lum*wum*nf+(0.006041)*lum*wum+(0.023377)*lum*nf+(0.120170)*wum*nf+(-0.033538)*sqrt(wum*lum)+(-0.112984))*1e-15'
.param c_pp = '((-0.282619)*nf+(-1.328147)*lum+(-0.115162)*wum+(0.017999)*lum*wum*nf+(-0.043202)*lum*wum+(0.412528)*lum*nf+(0.011854)*wum*nf+(0.751030)*sqrt(wum*lum)+(2.692831))*1e-15'

.param is_fdiode1_wo = '((-30.7221)*lum+(-41.6847)*wum+(-665.5646)/nf+(-7.0269)*lum*wum+(-183.3680)*lum/nf+(-120.9697)*wum/nf+(-47.1611)*lum*wum/nf+(978.5453)*sqrt(wum*lum)/nf+261.7520*sqrt(wum*lum)+(-78.4284))*factor_isf_wo'
.param n_fdiode1_wo = '(0.088201)/lum+(0.028120)/wum+(-0.027211)/lum/wum+(0.007037)*lum+(-0.000642)*wum+0.884969'
.param cj_fdiode1_wo = '((-0.001644)/lum+(-0.001983)/wum+(0.001299)/lum/wum+(-0.000017)*lum+(4.125926e-06)*wum+(0.004069))*factor_cjf_wo'
.param mj_fdiode1_wo = '(0.036552)/lum+(0.104677)/wum+(-0.451701)/lum/wum+(0.0128)*lum+(0.000296)*wum+0.643196'

.param is_rdiode_wo = '((-12.83783)*nf+(-90.98964)*lum+(-47.0175)*wum+(5.05497)*lum*wum*nf+(20.70406)*lum*wum+(-6.06581)*lum*nf+(-8.05982)*wum*nf+(114.69857)*sqrt(lum*wum)+(17.08802)*sqrt(lum*wum)*nf+(161.30248))*factor_isr_wo'
.param n_rdiode_wo = '(-0.485714)/lum+(-4.025397)/wum+(7.591474)/lum/wum+(0.011111)*lum+(-0.011111)*wum+(0.736508)*lum/wum+(0.013968)*wum/lum+12.972222'
*=====================
r1 1 4 'r_1*factor_rm*(1+(temper-25)*2.93e-3)'
l1 4 5 'l_1*factor_l'
csti 5 8 'c_sti*factor_csti'
*--- Schottky diode
df1 5 11 f_diode1_wo area = 'a1_eff' pj = 'p1_eff'
rs1 11 6 'r_s1*factor_re_wo'
dr 11 5 r_diode_wo area = 'a1_eff' pj = 'p1_eff'
*--- PN junction diode
df2 5 21 f_diode2_wo area = 'a2_eff' pj = 'p2_eff'
rs2 21 6 'r_s2*factor_re_wo'
cpp 5 3 'c_pp'
*--- Substrate network
dnw 31 7 dio_nwpsub area = 'anw_eff' pj='pnw_eff'
rsub 31 3 'r_sub*factor_rsub*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
csub 31 3 'c_sub*factor_csub*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
rnwell1 6 7 'r_nwell/2*factor_rnwell*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'
rnwell2 7 8 'r_nwell/2*factor_rnwell*(1+(temper-25)*3.74e-3+(temper-25)*(temper-25)*9.1e-6)'

r2 8 9 'r_2*factor_rm*(1+(temper-25)*2.93e-3)'
l2 9 2 'l_2*factor_l'

*-- Forward diode No. 1 ---
.MODEL f_diode1_wo  		 D (
+ LEVEL = 3         		 IS = 'is_fdiode1_wo'		 RS = 1E-010        		 N = 'n_fdiode1_wo' 		
+ BV = 1e4          		 IBV = 'is_fdiode1_wo'		 IK = 3E+005        		 IKR = 1E+010       		
+ JSW = 3.5E-014    		 CJ = 'cj_fdiode1_wo'		 PB = 0.8756        		 MJ = 'mj_fdiode1_wo'		
+ CJSW = 0          		 PHP = 0.8956       		 MJSW = 0.6823      		 TLEV = 2           		
+ EG = 0.48         		 XTI = 2            		 TCV = -0.000888    		 TRS = 0.00277      		
+ TLEVC = 1         		 CTA = 0.0003067    		 CTP = 0.0002781    		 TPB = 0.00302      		
+ TPHP = 0.001427   		 TREF = 25          		 FC = 0             		 FCS = 0 )

*-- Reverse diode to model leakage current ---
.MODEL r_diode_wo   		 D (
+ LEVEL = 3         		 IS = 'is_rdiode_wo'		 RS = 1E-010        		 N = 'n_rdiode_wo'  		
+ BV = 1e4            		 IBV = 'is_rdiode_wo'		 IK = 6E+004        		 IKR = 5E+005       		
+ JSW = 1.55E-013   		 CJ = 0             		 PB = 0.2006        		 MJ = 0.4528        		
+ CJSW = 0          		 PHP = 0.7956       		 MJSW = 0.2323      		 TLEV = 1           		
+ EG = 4.5          		 XTI = 12            		 TCV = -0.000888    		 TRS = 0.00277      		
+ TLEVC = 1         		 CTA = 0.0009067    		 CTP = 0.0002781    		 TPB = 0.001427     		
+ TPHP = 0.001427   		 TREF = 25          		 FC = 0             		 FCS = 0 )

*-- Forward diode No. 2, P+/NW STI Diode ---
.MODEL f_diode2_wo   		 D (
+ LEVEL = 3         		 IS = '1.8E-007*factor_is_d'		 RS = '1E-010*factor_rs_d' 		 N = '1.02*factor_n_d'     		
+ BV = 8.33         		 IBV = 0.02         		 IK = 1E+020        		 IKR = 1E+010       		
+ JSW = '6.6E-014*factor_jsw_d'	 CJ = '0.001369*factor_cj_d'		 PB = 0.9           		 MJ = 0.4234        		
+ CJSW = '9.8E-011*factor_cjsw_d'	 PHP = 0.9          		 MJSW = 0.1716      		 TLEV = 1           		
+ EG = 1.17         		 XTI = 3            		 TCV = -0.000845    		 TRS = 0.00289      		
+ TLEVC = 1         		 CTA = 0.000887     		 CTP = 0.000298     		 TPB = 0.001643     		
+ TPHP = 0.001643   		 TREF = 25          		 FC = 0             		 FCS = 0            		
+ AREA = 3.92E-008  		 PJ = 0.00084 )

*-- NW/PSUB diode ---
.MODEL dio_nwpsub   		 D (
+ LEVEL = 3         		 IS = 6.2E-007      		 RS = 1E-010        		 N = 1.02           		
+ BV = 13.6         		 IBV = 0.01         		 IK = 1E+010        		 IKR = 1E+020       		
+ JSW = 3.17E-012   		 CJ = 0.0001291     		 PB = 0.8122        		 MJ = 0.4897        		
+ CJSW = 5.35E-010  		 PHP = 0.8122       		 MJSW = 0.2822      		 TLEV = 1           		
+ EG = 1.17         		 XTI = 3            		 TCV = -0.00129     		 TRS = 0.00204      		
+ TLEVC = 1         		 CTA = 0.002483     		 CTP = 0.001238     		 TPB = 0.003184     		
+ TPHP = 0.003184   		 TREF = 25          		 FC = 0             		 FCS = 0            		
+ AREA = 3.92E-008  		 PJ = 0.00084 )

.ends sbd_rf_nw
*
*
*
.ENDL RF_SBD



