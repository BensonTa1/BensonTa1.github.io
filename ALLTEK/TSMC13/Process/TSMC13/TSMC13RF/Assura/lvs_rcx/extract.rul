;#############################################
;# ERC CHECK                                 #
;#############################################
; I. The soft-connect checks already include in the "Soft-Connect_Checks" ivIf 
;    statement. Please turn on "Soft-Connect_Checks" switch to check the soft 
;    connect issues on Nwell or Substrate. 
ercSetPwr( "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "AHVDD" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AHVDDR" "AHVDDG" "AHVDDB" "AVDWELL" "VDWELL" "AHVDDWELL" "HVDDWELL" "DVDD" "DHVDD" "VDDESD" "TVDD")
ercSetGnd( "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "TAVSS" "TAVSSPST" "AHVSS" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AHVSSR" "AHVSSG" "AHVSSB" "AVSSUB" "VSSUB" "AHVSSUB" "HVSSUB" "DVSS" "DHVSS" "VSSESD" "TACVSS" "TVSS")

if( avSwitch( "GATE_TO_PG_CHECK") then
; gate1 connect to GROUND 
 npvss150 = geomGetNet( gate1  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "TAVSS" "TAVSSPST" "AHVSS" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AHVSSR" "AHVSSG" "AHVSSB" "AVSSUB" "VSSUB" "AHVSSUB" "HVSSUB" "DVSS" "DHVSS" "VSSESD" "TACVSS" "TVSS")
 errorLayer( npvss150 "<npvss150> gate1 connected to GROUND !") 
)


if( avSwitch( "WELL_TO_PG_CHECK") then
; ntap connect to GROUND 
 npvss49 = geomGetNet( ntap_not_var  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "TAVSS" "TAVSSPST" "AHVSS" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AHVSSR" "AHVSSG" "AHVSSB" "AVSSUB" "VSSUB" "AHVSSUB" "HVSSUB" "DVSS" "DHVSS" "VSSESD" "TACVSS" "TVSS")
 errorLayer( npvss49 "<npvss49> ntap_not_var connected to GROUND !") 
)


; MOS  S/D connect to POWER&GROUND --mnpg*/
 N1tndiff = geomGetNet( tndiff  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "AHVDD" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AHVDDR" "AHVDDG" "AHVDDB" "AVDWELL" "VDWELL" "AHVDDWELL" "HVDDWELL" "DVDD" "DHVDD" "VDDESD" "TVDD")
 T1tndiff = geomButtOrOver(erc_nmos_gates N1tndiff)
 N2tndiff = geomGetNet( tndiff  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "TAVSS" "TAVSSPST" "AHVSS" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AHVSSR" "AHVSSG" "AHVSSB" "AVSSUB" "VSSUB" "AHVSSUB" "HVSSUB" "DVSS" "DHVSS" "VSSESD" "TACVSS" "TVSS")
 T2tndiff = geomButtOrOver(erc_nmos_gates N2tndiff)
if( avSwitch( "DS_TO_PG_CHECK") then
 mnpg = geomAnd(T1tndiff T2tndiff)
 errorLayer( mnpg "<mnpg> MOS connected to both power and ground !")
)


if( avSwitch( "FLOATING_WELL_CHECK") then
;Floating.psub :  psub is not connected to GROUND
  gpck_psub = geomPathCheck( layer(psub) noGnd)
  errorLayer( gpck_psub  "<floating.psub> Floating psub is not allowed." )
)

if( avSwitch( "FLOATING_WELL_CHECK") then
geomStamp( nxwell_float tndiff by ntap multStamp )
;Floating.nxwell_float :  nxwell_float is not connected to POWER
  gpck_nxwell_float = geomPathCheck( layer(nxwell_float) noPwr)
  errorLayer( gpck_nxwell_float  "<floating.nxwell_float> Floating nxwell_float is not allowed." )
)

if( avSwitch( "GATE_TO_PG_CHECK") then
; gate1 connect to POWER 
 ppvdd150 = geomGetNet( gate1  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "AHVDD" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AHVDDR" "AHVDDG" "AHVDDB" "AVDWELL" "VDWELL" "AHVDDWELL" "HVDDWELL" "DVDD" "DHVDD" "VDDESD" "TVDD")
 errorLayer( ppvdd150 "<ppvdd150> gate1 connected to POWER !") 
)


if( avSwitch( "WELL_TO_PG_CHECK") then
; ptap connect to POWER 
 ppvdd49 = geomGetNet( ptap  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "AHVDD" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AHVDDR" "AHVDDG" "AHVDDB" "AVDWELL" "VDWELL" "AHVDDWELL" "HVDDWELL" "DVDD" "DHVDD" "VDDESD" "TVDD")
 errorLayer( ppvdd49 "<ppvdd49> ptap connected to POWER !") 
)


; MOS  S/D connect to POWER&GROUND --mppg*/
 N1tpdiff = geomGetNet( tpdiff  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "AHVDD" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AHVDDR" "AHVDDG" "AHVDDB" "AVDWELL" "VDWELL" "AHVDDWELL" "HVDDWELL" "DVDD" "DHVDD" "VDDESD" "TVDD")
 T1tpdiff = geomButtOrOver(erc_pmos_gates N1tpdiff)
 N2tpdiff = geomGetNet( tpdiff  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "TAVSS" "TAVSSPST" "AHVSS" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AHVSSR" "AHVSSG" "AHVSSB" "AVSSUB" "VSSUB" "AHVSSUB" "HVSSUB" "DVSS" "DHVSS" "VSSESD" "TACVSS" "TVSS")
 T2tpdiff = geomButtOrOver(erc_pmos_gates N2tpdiff)
if( avSwitch( "DS_TO_PG_CHECK") then
 mppg = geomAnd(T1tpdiff T2tpdiff)
 errorLayer( mppg "<mppg> MOS connected to both power and ground !")
)

;ERC PATHCHK !LABELED....not support

; Nodes with a path to ground but not power 
;ERC PATHCHK GROUND && !POWER....not support

; Nodes without a path to power and ground 
;ERC PATHCHK !POWER && !GROUND...not support

; Nodes with a path to power but not ground 
;ERC PATHCHK POWER && !GROUND....not support
saveInterconnect( (metal1 "METAL1"))
saveInterconnect( (metal2 "METAL2"))
saveInterconnect( (metal3 "METAL3"))
saveInterconnect( (metal4 "METAL4"))
saveInterconnect( (metal5 "METAL5"))
saveInterconnect( (metal6 "METAL6"))
saveInterconnect( (metal7 "METAL7"))
saveInterconnect( (metal8 "METAL8"))
saveInterconnect( (metal9 "MD"))
saveInterconnect( (poly "POLYG"))
) ; end of drcExtractRules 


