lrppoly_rf_b = geomButtOrOver(RFDMY lrppoly_rf)  ;
;
;* Define device -- xdev rppolys_rf
srppoly_rf_b = geomButtOrOver(RFDMY srppoly_rf)  ;
;
;* Define device -- xdev rppolywo_rf
rf_rppolywo1 = geomAnd(rppolywo_r2 RFDMY)  ;
