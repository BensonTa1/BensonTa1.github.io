pgate_rfnw = geomOutside(pgate_pthin1 DNW)  ;
;
;* Define device -- xdev pmos_rf25_nw
pgate_rf33nw = geomOutside(pgate_pthin_io1 DNW)  ;
;
;* Define device -- xdev spiral_std
IND_STD_a = geomAnd(IND_STD NTN)  ;
IND_STD_all = geomAnd(IND_STD_a RFDMY)  ;
std_ind1 = geomAnd(M8Y IND_STD_all)  ;
std_ind2 = geomAnd(M7Y IND_STD_all)  ;
std_ind = geomOr(std_ind1 std_ind2)  ;
std_ind_m = geomAnd(std_ind1 std_ind2)  ;
;
;* Define device -- xdev spiral_sym
IND_SYM_a = geomAnd(IND_SYM NTN)  ;
IND_SYM_all = geomAnd(IND_SYM_a RFDMY)  ;
sym_ind1 = geomAnd(M8Y IND_SYM_all)  ;
sym_ind2 = geomAnd(M7Y IND_SYM_all)  ;
sym_ind = geomOr(sym_ind1 sym_ind2)  ;
sym_ind_m = geomAnd(sym_ind1 sym_ind2)  ;
ind_btm1 = geomAnd(sym_ind2 sym_ind1)  ;
ind_btm2 = geomButtOrOver(ind_btm1 VIA7)  ;
ind_btm = geomOr(ind_btm2 IND_RAD)  ;
;
;* Define device -- xdev spiral_sym_ct
IND_CT_a = geomAnd(IND_CT NTN)  ;
IND_CT_all = geomAnd(IND_CT_a RFDMY)  ;
sym_ct_ind1 = geomAnd(M8Y IND_CT_all)  ;
sym_ct_ind2 = geomAnd(M7Y IND_CT_all)  ;
sym_ct_ind5 = geomOr(sym_ct_ind1 sym_ct_ind2)  ;
sym_ct_ind3 = geomAnd(M6Y IND_CT_all)  ;
sym_ct_ind = geomOr(sym_ct_ind5 sym_ct_ind3)  ;
sym_ct_ind_m = geomAnd(sym_ct_ind1 sym_ct_ind2)  ;
ind_ct_btm1 = geomAnd(sym_ct_ind2 sym_ct_ind1)  ;
ind_ct_btm2 = geomButtOrOver(ind_ct_btm1 VIA7)  ;
