if(avSwitch( "CAP_1P5") then 
extractCAP("mimcap_1p5_sin" RCTM_R ctm("TOP") cbm("BOT")
  spiceModel( "mimcap_1p5_sin" )
  cellView("mimcap ivpcell ")
  flagMalformed
) 
   area_CAP = measureParameter(area (RCTM_R) 1e-12) 
   pj_CAP = measureParameter(perimeter (RCTM_R) 1e-6) 
   P_2_CAP  = calculateParameter(pj_CAP * pj_CAP)
   AC4      = calculateParameter(area_CAP * 16)
   KKK1     = calculateParameter(P_2_CAP - AC4)
   KKK      = calculateParameter(KKK1 * step(0,KKK1))
   SQ       = calculateParameter(sqrt(KKK))
   lt       = calculateParameter((pj_CAP+SQ)/4)
   wt       = calculateParameter((pj_CAP-SQ)/4)
   area_CAP1 = calculateParameter((lt*scale + MIM_1P5_DW) * (wt*scale + MIM_1P5_DW))
   pj_CAP1   = calculateParameter(2*((lt*scale + MIM_1P5_DW) + (wt*scale + MIM_1P5_DW)))
   cap_CAP1  = calculateParameter(area_CAP1 * MIM_1P5_CA)
   cap_CAP2  = calculateParameter(pj_CAP1 * MIM_1P5_CF)
   cap_CAP   = calculateParameter(cap_CAP1 + cap_CAP2)    
   nameParameter( area_CAP "AREA" ) 
   attachParameter( cap_CAP "VALUE" RCTM_R) 
   attachParameter( cap_CAP "c" RCTM_R )
   attachParameter( lt "lt" RCTM_R )
   attachParameter( wt "wt" RCTM_R )
if( !avSwitch( "spice_extraction") then
	   saveProperty( RCTM_R "model" "mimcap_1p5_sin")
)

else
extractCAP("mimcap_1p0_sin" RCTM_R ctm("TOP") cbm("BOT")
  spiceModel( "mimcap_1p0_sin" )
  cellView("mimcap ivpcell ")
  flagMalformed
) 
   area_CAP = measureParameter(area (RCTM_R) 1e-12) 
   pj_CAP = measureParameter(perimeter (RCTM_R) 1e-6) 
   P_2_CAP  = calculateParameter(pj_CAP * pj_CAP)
   AC4      = calculateParameter(area_CAP * 16)
   KKK1     = calculateParameter(P_2_CAP - AC4)
   KKK      = calculateParameter(KKK1 * step(0,KKK1))
   SQ       = calculateParameter(sqrt(KKK))
   lt       = calculateParameter((pj_CAP+SQ)/4)
   wt       = calculateParameter((pj_CAP-SQ)/4)
   area_CAP1 = calculateParameter((lt*scale + MIM_1P0_DW) * (wt*scale + MIM_1P0_DW))
   pj_CAP1   = calculateParameter(2*((lt*scale + MIM_1P0_DW) + (wt*scale + MIM_1P0_DW)))
   cap_CAP1  = calculateParameter(area_CAP1 * MIM_1P0_CA)
   cap_CAP2  = calculateParameter(pj_CAP1 * MIM_1P0_CF)
   cap_CAP   = calculateParameter(cap_CAP1 + cap_CAP2)
   nameParameter( area_CAP "AREA" ) 
   attachParameter( cap_CAP "VALUE" RCTM_R )
   attachParameter( cap_CAP "c" RCTM_R )   
   attachParameter( lt "lt" RCTM_R )
   attachParameter( wt "wt" RCTM_R )
if( !avSwitch( "spice_extraction") then
	   saveProperty( RCTM_R "model" "mimcap_1p0_sin")
)
) ; if CAP_1P5

