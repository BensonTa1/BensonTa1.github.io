rf_rppolywo_b = geomButtOrOver(RFDMY rf_rppolywo)  ;
;
;* Define device -- xdev rppolyhri_rf
rf_hripo_b = geomButtOrOver(RFDMY rf_hripo)  ;
;
;* Define device -- xdev mimcap_um_1p0_sin_rf
RCTM_RF1 = geomAnd(RCTM RFDMY)  ;
