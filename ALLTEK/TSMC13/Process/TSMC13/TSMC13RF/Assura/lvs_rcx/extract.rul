MOM_finger_1a = geomButtOrOver(MOM_finger_1 MOM_term_12)  ;
MOM_reg3a = geomSize(MOM_finger_1a 0.4)  ;
MOM_reg3 = geomButtOrOver(MOM_reg3a MOM3_term)  ;
;
;* Define device -- xdev crtmom4
MOM_finger_2a = geomButtOrOver(MOM_finger_2 MOM_term_23)  ;
MOM_rega = geomSize(MOM_finger_2a 0.4)  ;
