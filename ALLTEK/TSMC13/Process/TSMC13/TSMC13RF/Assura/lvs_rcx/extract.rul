;* Define ERC or other layers
erc_pmos_gates = geomAndNot(tpgate1 VARDMY)  ; Exclude RF, SRAM, VAR
nxwell_float1 = geomAndNot(nxwell geomButtOrOver(nxwell VARDMY))  ;
nxwell_float2 = geomAndNot(nxwell_float1 geomButtOrOver(nxwell_float1 BJTDMY))  ;
nxwell_float = geomAndNot(nxwell_float2 geomButtOrOver(nxwell_float2 trwell))  ;
erc_nmos_gates = geomAndNot(tngate1 VARDMY)  ; Exclude RF, SRAM, VAR


; ***** logic operation from XDEV statements *****
sbd_w = drc(schottky_p schottky_n sep < 0.365 opposite)
sym_w1 = drc(sym_ind width < 31 opposite parallel shielded)        ; "31" is a trade number from spice model
sym_w  = geomGetRectangle(sym_w1)
sym_ind_b = geomButtOrOver( RFDMY sym_ind )
sym_ct_w1 = drc(sym_ct_ind5 width < 31 opposite parallel shielded)        ; "31" is a trade number from spice model
sym_ct_w  = geomGetRectangle(sym_ct_w1)
sym_ct_ind_b = geomButtOrOver( RFDMY sym_ct_ind )
std_w1 = drc(std_ind width < 31 opposite parallel shielded)        ; "31" is a trade number from spice model
std_w1a = geomButtOrOver(std_w1 metal8)
std_minus_no_crossa = geomAndNot(std_ind std_w1)
std_minus_no_cross = geomButtOrOver(std_w1a geomButtOrOver(std_minus_no_crossa IND_RAD))
std_w  = geomGetRectangle(std_w1)
sz_ind_std  = geomSize(IND_STD -50)
std_nr0 = geomButtOrOver(std_ind1 IND_RAD)
std_nr1 = drc(std_nr0 width < 31 opposite parallel shielded)
std_nr11 = geomSize(std_nr1 -0.05)
std_nr2 = geomGetRectangle(std_nr11)
std_nr21 = geomSize(std_nr2 0.05)
std_nr3 = geomInside(std_nr21 sz_ind_std)
std_nr4 = geomAndNot(std_nr21 std_nr3)
std_nr5 = geomAndNot(std_nr21 std_nr4)
std_nr6 = geomSize(std_nr4 0.001)
std_nr7 = geomButtOrOver( std_nr6 std_nr5)
std_nr  = geomAndNot(std_nr21 std_nr7)
std_nr_new1 = geomGetVertex(std_ind1 keep > 13)
std_nr_new2 = geomGetAngledEdge(std_nr_new1 40< keep <50)
std_nr_new3 = geomSize(std_nr_new2 0.005 edges)
std_ind_1  = geomSize(std_ind 0.01 edges)
std_nr_new  = geomAnd(std_nr_new3 std_ind_1)    
std_w_m1 = geomSize(IND_STD 0.005)
std_w_m2 = geomAnd(std_w_m1 M8Y)
std_w_m3 = geomAnd(std_w_m1 M7Y)
std_w_m4 = geomOr(std_w_m3 std_w_m2)
std_w_m5 = geomOutside(std_w_m4 IND_STD)
std_w_m  = geomAndNot(std_w_m4 std_w_m5)
std_corns = geomAndNot(std_w_m std_w)
find_corn = geomButtOrOver(std_corns IND_RAD)
std_arm_under1 = geomOr(std_ind2 find_corn)	;;;underneath + find_corn
std_arm_under = geomButtOrOver(std_arm_under1 find_corn)
std_arms = geomButtOrOver(std_w metal8)
std_minus = geomGetVertex(std_ind1 keep == 4)    
std_ind_r1 = geomAndNot(std_ind std_minus)
std_ind_r2  = geomButtOrOver(std_ind_r1 IND_RAD)
std_ind_r   = geomButtOrOver(std_ind_r2 std_minus)
std_ind_no_crossa = geomAndNot( std_ind_r2 geomButtOrOver(std_ind_r2 std_minus))
std_ind_no_cross  = geomAndNot(std_ind_no_crossa std_minus_no_cross)
std_ind_no_cross_b = geomButtOrOver( RFDMY std_ind_no_cross )
std_ind_r_b = geomButtOrOver( RFDMY std_ind_r )
L_EG1    = geomGetEdge( ctm inside metal7 )
L_EG_RG1 = geomSize( L_EG1 0.005 edges )
CTM_EG_RG = geomSize(RCTM 0.005 edges)
L_EG_RG   = geomButtOrOver(CTM_EG_RG L_EG_RG1)
if(avSwitch( "CAP_1P5") then 
RCTM_RF_b = geomButtOrOver( RFDMY RCTM_RF)
RCTM_WOUM_b = geomButtOrOver( RFDMY RCTM_WOUM)
else    
RCTM_RF_b = geomButtOrOver( RFDMY RCTM_RF)
RCTM_WOUM_b = geomButtOrOver( RFDMY RCTM_WOUM)
) ; if CAP_1P5
hripo_d_p = geomAnd(hripo_d psub)
hripo_d_w = geomAnd(hripo_d nxwell)
rnpolywo_d_p = geomAnd(rnpolywo_d psub)
rnpolywo_d_w = geomAnd(rnpolywo_d nxwell)
rppolywo_d_p = geomAnd(rppolywo_d psub)
rppolywo_d_w = geomAnd(rppolywo_d nxwell)
lrppoly_d_p = geomAnd(lrppoly_d psub)
lrppoly_d_w = geomAnd(lrppoly_d nxwell)
srppoly_d_p = geomAnd(srppoly_d psub)
srppoly_d_w = geomAnd(srppoly_d nxwell)
lrnpoly_d_p = geomAnd(lrnpoly_d psub)
lrnpoly_d_w = geomAnd(lrnpoly_d nxwell)
srnpoly_d_p = geomAnd(srnpoly_d psub)
srnpoly_d_w = geomAnd(srnpoly_d nxwell)
F_reg1 = drc(MOM_finger_2 0<sep< 0.41 opposite parallel shielded)
F_rege  = geomAnd( F_reg1 MOMDMY)
F_reg2 = drc(MOM_finger_3 0<sep< 0.41 opposite parallel shielded)
F_rego  = geomAnd( F_reg2 MOMDMY)
MOMDMY_s = geomSize(MOMDMY -0.2)  ;
MOM_finger_nv = geomInside(MOM_finger_3 MOMDMY_s)  ;
MOM_finger_hv = geomInside(MOM_finger_2 MOMDMY_s)  ;
MOM_reg3_b = geomButtOrOver( MOMDMY MOM_reg3 )        
      MOM_reg4_b = geomButtOrOver( MOMDMY MOM_reg4 )    
      MOM_reg5_b = geomButtOrOver( MOMDMY MOM_reg5 )    
      MOM_reg6_b = geomButtOrOver( MOMDMY MOM_reg6 )    
varnwc_rf_b = geomButtOrOver( RFDMY varnwc_rf )
varnwc_rfnw_b = geomButtOrOver( RFDMY varnwc_rfnw )
varnwi_rf_b = geomButtOrOver( RFDMY varnwi_rf )
varnwi_rfnw_b = geomButtOrOver( RFDMY varnwi_rfnw )    
ngate_nthin_b = geomButtOrOver( RFDMY ngate_nthin)
ngate_nthin_io_b = geomButtOrOver( RFDMY ngate_nthin_io)
pgate_pthin_b = geomButtOrOver( RFDMY pgate_pthin)
pgate_rfnw_b = geomButtOrOver( RFDMY pgate_rfnw)
pgate_pthin_io_b = geomButtOrOver( RFDMY pgate_pthin_io)
pgate_rf33nw_b = geomButtOrOver( RFDMY pgate_rf33nw)
tpdiff_jvar = geomAnd( tpdiff jvar_rf)
tndiff_jvar = geomAnd( tndiff jvar_rf)
w_fac   = drc(tndiff_jvar tpdiff_jvar sep < 0.29 opposite)
L_EG_RG1 = geomSize( L_EG1 0.005 edges )
CTM_EG_RG = geomSize(RCTM 0.005 edges)
L_EG_RG   = geomButtOrOver(CTM_EG_RG L_EG_RG1)

;#############################################
;# CONNECTION                                #
;#############################################
ntap_not_var = geomAndNot(ntap VARDMY)
    ;--- geomConnect ---
geomConnect(
buttOrOver(gate1 poly)
    buttOrOver(ntap ntap_not_var)
    buttOrOver(gate1 poly)
    buttOrOver(metal6 MOM_field6)
    via( VIA5  metal6 metal5 ) 
    via( VIA6  metal7 metal6 ) 
    buttOrOver(mim_block ctm)
    buttOrOver(n_pplug tpdiff)
    buttOrOver(cnemit1 tndiff)
    via( cbm_via  cbm metal7 ) 
    buttOrOver(MOM_plant poly)
    buttOrOver(ncoll1 nxwell_npn)
    buttOrOver(nplug tndiff)
    via( odCont  metal1 schottky_n ) 
    via( polyCont  metal1 poly ) 
    via( polyCont  metal1 poly_rf ) 
    buttOrOver(metal1 MOM_field1)
    via( odCont  metal1 s_tpdiff ) 
    via( odCont  metal1 s_tndiff ) 
    via( odCont  metal1 tpdiff ) 
    via( odCont  metal1 d_tpdiff ) 
    via( odCont  metal1 schottky_p ) 
    buttOrOver(metal1 MOM_edge_mt)
    via( odCont  metal1 d_tndiff ) 
    via( odCont  metal1 tndiff ) 
    buttOrOver(cemit1 tpdiff)
    via( VIA4  metal5 metal4 ) 
    buttOrOver(metal5 MOM_field5)
    via( ctm_via  ctm metal7 ) 
    buttOrOver(ptap tpdiff)
    buttOrOver(shield metal4)
    via( VIA7  metal8 metal7 ) 
    via( nplug  nbase1 tndiff ) 
    buttOrOver(pplug tpdiff)
    via( VIA5  MOM_field5 MOM_field6 ) 
    buttOrOver(MOM_field5 MOM5_term)
    via( VIA2  metal3 metal2 ) 
    buttOrOver(metal3 MOM_field3)
    via( polyCont  MOM_edge_mt MOM_plant ) 
    buttOrOver(tndiff ydio_hole)
    via( nplug  tndiff nxwell_npn ) 
    buttOrOver(tndiff ydio_ass)
    buttOrOver(tndiff tpdiff)
    buttOrOver(tndiff ydio)
    buttOrOver(MOM_field6 MOM6_term)
    buttOrOver(metal2 MOM_field2)
    via( VIA1  metal2 metal1 ) 
    buttOrOver(MOM_field4 MOM4_term)
    via( VIA4  MOM_field4 MOM_field5 ) 
    buttOrOver(ntap tndiff)
    buttOrOver(poly_rf poly)
    via( VIA1  MOM_field1 MOM_field2 ) 
    via( VIA8  metal9 metal8 ) 
    buttOrOver(metal4 MOM_field4)
    via( VIA3  metal4 metal3 ) 
    via( VIA2  MOM_field2 MOM_field3 ) 
    via( pplug  pbase1 tpdiff ) 
    buttOrOver(tiod tpdiff)
    buttOrOver(tiod tndiff)
    via( VIA3  MOM_field3 MOM_field4 ) 
    buttOrOver(MOM_field3 MOM3_term)
    buttOrOver( vargt poly )
    buttOrOver( bvargt poly )
    buttOrOver( pvargt poly )
    buttOrOver( pbvargt poly )
    ;common geomConnect in xdev statement----
    ;--------------------------------

    label( metal1_text  metal1 ) 
    label( metal2_text  metal2 ) 
    label( metal3_text  metal3 ) 
    label( metal4_text  metal4 ) 
    label( metal5_text  metal5 ) 
    label( metal6_text  metal6 ) 
    label( metal7_text  metal7 ) 
    label( metal8_text  metal8 ) 
    label( metal9_text  metal9 ) 
    label( metal1_ptext  metal1 ) 
    label( metal2_ptext  metal2 ) 
    label( metal3_ptext  metal3 ) 
    label( metal4_ptext  metal4 ) 
    label( metal5_ptext  metal5 ) 
    label( metal6_ptext  metal6 ) 
    label( metal7_ptext  metal7 ) 
    label( metal8_ptext  metal8 ) 
    label( metal9_ptext  metal9 ) 
)

if( avSwitch( "Skip_Soft_Connect_Checks") then 
    geomStamp( nxwell tndiff by nplug ) 
    geomStamp( iso_hvnw tndiff by nplug ) 
    geomStamp( HVNW tndiff by nplug ) 
    geomStamp( n_psub tpdiff by n_pplug ) 
    geomStamp( psub_term tpdiff by pplug ) 
    geomStamp( psub tpdiff by pplug ) 
    geomStamp( HVPW tpdiff by pplug ) 
    geomStamp( coll1 tpdiff by pplug ) 
    geomStamp( poly_term psub by poly_psub_via ) 
    geomStamp( poly_term nxwell by poly_nw_via ) 
    geomStamp( DNW nxwell by dnwc ) 
else 
    geomStamp( nxwell tndiff by nplug multStamp ) 
    geomStamp( iso_hvnw tndiff by nplug multStamp ) 
    geomStamp( HVNW tndiff by nplug multStamp ) 
    if( !avSwitch( "NW_RING" ) then
       geomStamp( n_psub tpdiff by n_pplug multStamp ) 
    ) ;if

    geomStamp( psub_term tpdiff by pplug multStamp ) 
    geomStamp( psub tpdiff by pplug multStamp ) 
    geomStamp( HVPW tpdiff by pplug multStamp ) 
    geomStamp( coll1 tpdiff by pplug multStamp ) 
    geomStamp( poly_term psub by poly_psub_via multStamp ) 
    geomStamp( poly_term nxwell by poly_nw_via ) 
    geomStamp( DNW nxwell by dnwc multStamp ) 
) ;if 
;//#############################################
;//# STAMP NODAL INFO. TO DEVICE LAYER         #
;//#############################################
;#############################################
;# DEFINE PROCEDURE                          #
;#############################################
;#############################################
;# FORM DEVICE                               #
;#############################################
extractMOS("N1" nrgate poly("G") tndiff("S" "D") psub("B")
  spiceModel( "nch" )
  cellView( "nmos1v ivpcell" )
  flagMalformed)
   w_NMOS    = measureParameter(length (nrgate butting tndiff) 0.5e-6)
   area_NMOS = measureParameter(area (nrgate) 1e-12) 
   l_NMOS    = calculateParameter(area_NMOS/w_NMOS) 
   areaS     = measureParameter( area (tndiff) 1e-12 ) 
   periS     = measureParameter( perimeter (tndiff) 1e-6 ) 
   attachParameter( areaS ("ad" "D") ("as" "S") nrgate shared) 
   attachParameter( periS ("pd" "D") ("ps" "S") nrgate shared) 
   if( avSwitch("ZERO_NRDS") then 
   nrSD = calculateParameter(l_NMOS - l_NMOS) 
   else 
   nrSD = calculateParameter(((areaS/w_NMOS)/w_NMOS)) 
   ) 
   attachParameter( nrSD  ("nrd" "D") ("nrs" "S") nrgate shared) 
   nameParameter( w_NMOS "w" ) 
   nameParameter( l_NMOS "l" ) 
   attachParameter( w_NMOS "fw" nrgate )
   attachParameter( w_NMOS "wPerFinger" nrgate )
   if( !avSwitch( "spice_extraction") then
     saveProperty( nrgate "model" "nch") 
   ) ;if

      
    gateL =  calculateParameter( l_NMOS * 1e6 )
    gateW =  calculateParameter( w_NMOS * 1e6 )
    measureSTI( nrgate
                OD
                60
                output( invSA invSB )
                calculateExp(  sw/gateW/(sa + gateL*0.5)
			       sw/gateW/(sb + gateL*0.5)
		   	    )
               )
    SA = calculateParameter( (1/invSA - 0.5*gateL) * 1e-6 )
    nameParameter( SA "sa")
    SB = calculateParameter( (1/invSB - 0.5*gateL) * 1e-6 )
    nameParameter( SB "sb")

extractMOS("NLV" nlvgate poly("G") tndiff("S" "D") psub("B")
  spiceModel( "nch_lvt" )
  cellView( "nmos1vlvt ivpcell" )
  flagMalformed)
   w_NMOS    = measureParameter(length (nlvgate butting tndiff) 0.5e-6)
   area_NMOS = measureParameter(area (nlvgate) 1e-12) 
   l_NMOS    = calculateParameter(area_NMOS/w_NMOS) 
   areaS     = measureParameter( area (tndiff) 1e-12 ) 
   periS     = measureParameter( perimeter (tndiff) 1e-6 ) 
   attachParameter( areaS ("ad" "D") ("as" "S") nlvgate shared) 
   attachParameter( periS ("pd" "D") ("ps" "S") nlvgate shared) 
   if( avSwitch("ZERO_NRDS") then 
   nrSD = calculateParameter(l_NMOS - l_NMOS) 
   else 
   nrSD = calculateParameter(((areaS/w_NMOS)/w_NMOS)) 
   ) 
   attachParameter( nrSD  ("nrd" "D") ("nrs" "S") nlvgate shared) 
   nameParameter( w_NMOS "w" ) 
   nameParameter( l_NMOS "l" ) 
   attachParameter( w_NMOS "fw" nlvgate )
