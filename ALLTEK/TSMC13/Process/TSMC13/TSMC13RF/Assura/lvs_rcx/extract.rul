extractDevice( "crtmom" MOM_reg5 MOM5_term("PLUS") MOM5_term("MINUS") MOM_plant("BULK") physical
   spiceModel("crtmom")
   cellView("crtmom ivpcell")
   flagMalformed
)
   nv = measureParameter(figCount (MOMDMY_s enclosing MOM_finger_3))
   nh = measureParameter(figCount (MOMDMY_s enclosing MOM_finger_2))
   w1 = measureParameter(length (F_rego butting MOM_finger_3) 0.5e-6)
   w  = calculateParameter(1 * w1/(nv-1))
   s1 = measureParameter( area (F_rego) 1e-12)
   s2  = calculateParameter( s1/(nv-1))
   s   = calculateParameter( s2/w)
   lay = calculateParameter(5 * nv/nv)
   attachParameter(lay "lay" MOM_reg5)
   attachParameter(nv "nv" MOM_reg5)
   attachParameter(nh "nh" MOM_reg5)
   attachParameter(s  "s"  MOM_reg5)
if( !avSwitch( "spice_extraction") then
	   saveProperty(MOM_reg5 "model" "crtmom")
)

