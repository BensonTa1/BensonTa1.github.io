   area_gate = measureParameter(area (pgate_rf_io) 1e-12)
   lr = calculateParameter(area_gate/(wr*nr))
   attachParameter(wr "wr" pgate_rf33nw)
   attachParameter(lr "lr" pgate_rf33nw)
   nameParameter(nr "nr")
if( !avSwitch( "spice_extraction") then
	   saveProperty( pgate_rf33nw "model" "pmos_rf25_nw")
)

extractRES( "M7" mt7res metal7("PLUS" "MINUS")
      spiceModel( "rm8s" )
      cellView( "rm7 ivpcell " )
      flagMalformed 
)
   a  = measureParameter( area (mt7res) 1e-12)
   w  = measureParameter( length ( mt7res butting metal7 ) 0.5e-6)
   l  = calculateParameter( a/w )
   if( avSwitch( "Accuracy") then 
       r = calculateParameter( (RVME * l)/ (w - DWME) )
   else
       r = calculateParameter( (RVME * l)/w )
   )
   nameParameter( r "VALUE" )
;   nameParameter( r "r")
   nameParameter( w "w")
   attachParameter( l "l" mt7res)
   attachParameter( w "wSim" mt7res)
   attachParameter( l "lSim" mt7res)
   attachParameter( w "sumW" mt7res)
   attachParameter( l "sumL" mt7res)
   attachParameter( w "width" mt7res)
   attachParameter( l "length" mt7res)   
   attachParameter( r "r" mt7res)

   if( !avSwitch( "spice_extraction") then
   saveProperty( mt7res "model" "rm8s")
   );

extractDevice("sbd_rf_nw" sbd_rfnw schottky_p("PLUS") schottky_n("MINUS") psub("BULK")
   spiceModel("sbd_rf_nw")
   cellView( "sbd_rf_nw ivpcell" )
   flagMalformed
)
   nf  = measureParameter(figCount (sbd_rfnw enclosing schottky_p))
   w1  = measureParameter(length (schottky_p butting sbd_w))
   w   = calculateParameter(( w1/(2*nf))*1e-6)
   a   = measureParameter(area (schottky_p) 1e-12)
   l   = calculateParameter( a/(w*nf))
   
   nameParameter(nf "nf")
   attachParameter(w "w" sbd_rfnw)
   attachParameter(l "l" sbd_rfnw)

if( !avSwitch( "spice_extraction") then
	   saveProperty(sbd_rfnw "model" "sbd_rf_nw")
)

