srnpoly_d = geomButtOrOver(srnpoly_d1 POLYGi)  ;  N+POLY resistor w/i silicide (3-terminal dis w < 2um)
;
;* Define device -- xdev nc1
gatenw1 = geomAndNot(gatenw HVNWi)  ;
vargt1 = geomAnd(gatenw1 NP)  ;
vargt2 = geomAnd(vargt1 VARDMY)  ;
vargt3 = geomAndNot(vargt2 OD2)  ;
vargt4 = geomAndNot(vargt3 RFDMY)  ; Varactor on thin oxide
vargt = geomAndNot(vargt4 OD3)  ; Varactor on thin oxide
;
;* Define device -- xdev nc2
bvargt1 = geomAnd(vargt2 OD2)  ;
bvargt = geomAndNot(bvargt1 RFDMY)  ; Varactor on thick oxide
;
;* Define device -- xdev pc1
pvargt1 = geomAnd(gatennw PP)  ;
pvargt2 = geomAnd(pvargt1 VARDMY)  ;
pvargt = geomAndNot(pvargt2 OD2)  ; Varactor on thin oxide
;
;* Define device -- xdev pc2
pbvargt = geomAnd(pvargt2 OD2)  ; Varactor on thick oxide
;
;* Define device -- xdev rppolyhri
hripo43 = geomAndNot(hripo42 RFDMY)  ;
hripo44 = geomAndNot(hripo43 geomButtOrOver(hripo43 RHRIDMY_2Ka))  ;
hripo4 = geomButtOrOver(hripo44 POLYGi)  ; HRIp high poly resistor (2-terminals)
;
;* Define device -- xdev mimcap_1p0_sin
RCTM_R = geomAndNot(RCTM RFDMY)  ;
;
;* Define device -- xdev sbd_rf
sbd_rfnw_org1 = geomButtOrOver(sbd_nw schottky_n)  ;
sbd_rfnw_org = geomButtOrOver(sbd_rfnw_org1 schottky_p)  ;
sbd_rfdnw = geomButtOrOver(sbd_rfnw_org DNW)  ;
;
;* Define device -- xdev sbd_rf_nw
sbd_rfnw = geomAndNot(sbd_rfnw_org geomButtOrOver(sbd_rfnw_org DNW))  ;
;
;* Define device -- xdev nmos_rf
ngate_rf1 = geomAnd(gate_rf NP)  ;
ngate_rf2 = geomAndNot(ngate_rf1 VTH_N)  ;
ngate_rf3 = geomAndNot(ngate_rf2 VTL_N)  ;
ngate_rf4 = geomAndNot(ngate_rf3 NTN)  ;
ngate_rf5 = geomInside(ngate_rf4 DNW)  ;
ngate_rf = geomAndNot(ngate_rf5 OD2)  ;
ngate_nthin = geomButtOrOver(nthin ngate_rf)  ;
;
;* Define device -- xdev nmos_rf25
ngate_rf_io = geomAnd(ngate_rf5 OD2)  ;
ngate_nthin_io = geomButtOrOver(nthin ngate_rf_io)  ;
;
;* Define device -- xdev pmos_rf
pgate_rf1 = geomAnd(gate_rf PP)  ;
pgate_rf2 = geomAndNot(pgate_rf1 VTH_P)  ;
pgate_rf3 = geomAndNot(pgate_rf2 VTL_P)  ;
pgate_rf = geomAndNot(pgate_rf3 OD2)  ;
pgate_pthin1 = geomButtOrOver(pthin pgate_rf)  ;
pgate_pthin = geomInside(pgate_pthin1 DNW)  ;
;
