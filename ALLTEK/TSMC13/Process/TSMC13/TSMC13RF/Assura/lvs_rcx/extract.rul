extractDevice( "crtmom" MOM_reg3 MOM3_term("PLUS") MOM3_term("MINUS") MOM_plant("BULK") physical
   spiceModel("crtmom")
   cellView("crtmom ivpcell")
   flagMalformed
)
   nv = measureParameter(figCount (MOMDMY_s enclosing MOM_finger_3))
   nh = measureParameter(figCount (MOMDMY_s enclosing MOM_finger_2))
   w1 = measureParameter(length (F_rege butting MOM_finger_2) 0.5e-6)
   w  = calculateParameter(1 * w1/(nh-1))
   s1 = measureParameter( area (F_rege) 1e-12)
   s2  = calculateParameter( s1/(nh-1))
   s   = calculateParameter( s2/w)
   lay = calculateParameter(3 * nv/nv)
   attachParameter(lay "lay" MOM_reg3)
   attachParameter(nv "nv" MOM_reg3)
   attachParameter(nh "nh" MOM_reg3)
   attachParameter(s  "s"  MOM_reg3)
if( !avSwitch( "spice_extraction") then
	   saveProperty(MOM_reg3 "model" "crtmom")
)

