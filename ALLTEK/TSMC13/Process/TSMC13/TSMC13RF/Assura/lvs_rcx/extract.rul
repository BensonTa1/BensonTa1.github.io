extractRES( "PR" rppolywo_r poly("PLUS" "MINUS")
      spiceModel( "rppolywo" )
      cellView( "rphpoly ivpcell " )
      flagMalformed 
)
   a  = measureParameter( area (rppolywo_r) 1e-12)
   w  = measureParameter( length ( rppolywo_r butting poly ) 0.5e-6)
   l  = calculateParameter( a/w )
   if( avSwitch( "Accuracy") then
       Rend  = calculateParameter( DDPR /(w-DWPR ) )
       Rpure = calculateParameter( (RVPR *(l-DLPR ))/(w-DWPR ) )
       r = calculateParameter( 2.0*Rend+Rpure )
   else
       r = calculateParameter( (RVPR *l)/w )
   )
   nameParameter( r "VALUE" )
;   nameParameter( r "r")
   nameParameter( w "w")
   attachParameter( r "r" rppolywo_r)
   attachParameter( l "l" rppolywo_r)
   attachParameter( w "wSim" rppolywo_r)
   attachParameter( l "lSim" rppolywo_r)
   attachParameter( w "sumW" rppolywo_r)
   attachParameter( l "sumL" rppolywo_r)
   if( !avSwitch( "spice_extraction") then
   saveProperty( rppolywo_r "model" "rppolywo")
   )

extractDevice( "spiral_sym_ct" sym_ct_ind metal8("PLUS") metal8("MINUS") psub("BULK") metal6("CTAP")
   spiceModel("spiral_sym_ct")
   cellView("spiral_sym_ct ivpcell ")
   flagMalformed
)  
   nr1  = measureParameter(figCount (sym_ct_ind5 enclosing ind_ct_btm))
   nr   = calculateParameter(((nr1)/2)+1)
   lay = calculateParameter(8 * nr/nr)
   rad1 = measureParameter(perimeter (IND_RAD))
   rad2 = measureParameter(length (IND_RAD butting sym_ct_ind1) 2)
   rad  = calculateParameter((rad1-rad2) * 0.5e-6)
   nw   = measureParameter(figCount (sym_ct_ind5 enclosing sym_ct_w))
;   w1   = measureParameter(length (sym_ct_w inside sym_ct_ind5))
;   w    = calculateParameter(w1/(nw*2-2)*1e-6)
   w =  measureParameter(length (PP inside sym_ct_ind1) 0.25e-6)
   attachParameter(w "w" sym_ct_ind)
   attachParameter(lay "lay" sym_ct_ind)
   attachParameter(rad "rad" sym_ct_ind)
   attachParameter(nr "nr" sym_ct_ind)
if( !avSwitch( "spice_extraction") then
	   saveProperty(sym_ct_ind "model" "spiral_sym_ct")
)

