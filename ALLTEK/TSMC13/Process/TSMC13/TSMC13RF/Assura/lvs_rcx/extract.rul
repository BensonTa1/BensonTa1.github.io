l_rnpoly_eg = geomGetLength(rnpoly_eg 2 <= keep < 99999999) ;
l_rnpoly_eg_edge_su001=geomSize(l_rnpoly_eg 0.005 edges);
lrnpoly_d1 = geomButtOrCoin( rnpoly_m l_rnpoly_eg_edge_su001 )  ;
