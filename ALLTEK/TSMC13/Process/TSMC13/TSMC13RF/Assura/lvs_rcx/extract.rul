    MOMDMY2    = layer(  155 type(  2) )     ; dummy layer for RTMOM devices
    MOMDMY3    = layer(  155 type(  3) )     ; dummy layer for RTMOM devices
    MOMDMY4    = layer(  155 type(  4) )     ; dummy layer for RTMOM devices
    MOMDMY5    = layer(  155 type(  5) )     ; dummy layer for RTMOM devices
    MOMDMY6    = layer(  155 type(  6) )     ; dummy layer for RTMOM devices
    MOMDMY7    = layer(  155 type(  7) )     ; dummy layer for RTMOM devices
    MOMDMY8    = layer(  155 type(  8) )     ; dummy layer for RTMOM devices
    MOMDMY9    = layer(  155 type(  9) )     ; dummy layer for RTMOM devices
    UBM        = layer(  170 )     ; Under bump metal
    SRAMPSGT   = layer(  186 type(  1) )     ; For SRAM pass gate
    PWELLX     = layer(    2 )     ; for all cis devices
    CELLMV     = layer(   74 type(  0) )     ; for all cis devices
    CIRPO      = layer(   74 type( 11) )     ; for all cis devices
    CELL_TX    = layer(   74 type( 23) )     ; for nch_tg3  
    CELL_RS    = layer(   74 type( 24) )     ; for nch_rt3
    CAP_IMP    = layer(   74 type( 25) )     ; for npoluycap_33 
    CELL_SL    = layer(   74 type( 30) )     ; for nch_rs3
    ISOPW      = layer(   82 )     ;
    NBL        = layer(  141 type(  1) )     ; for HV process (HV N+ buried layer)
    HVOX       = layer(  141 type(  2) )     ; for HV process (HV Oxide)
    HVNWi      = layer(  154 type(  5) )     ; HV PMOS (HV NWELL)
    PSUBi      = layer(  154 type( 13) )     ; for flash HV NMOS and ZMOS (HV PWELL)
    HNVT       = layer(  154 type( 14) )     ; for flash HV NMOS and ZMOS (HV NTN)
    IOPW       = layer(  141 type( 13) )     ;
    IONW       = layer(  141 type( 12) )     ;
    Pbody      = layer(  141 type( 10) )     ;
    DPW        = layer(  141 type( 14) )     ;
    HVDMY      = layer(  141 type( 15) )     ;
    SH_N       = layer(  141 type( 16) )     ;
    SH_P       = layer(  141 type( 17) )     ;
    HV10DMY    = layer(  141 type( 20) )     ;
    HV20DMY    = layer(  141 type( 21) )     ;
    HV28DMY    = layer(  141 type( 22) )     ;
    HV36DMY    = layer(  141 type( 23) )     ;
    HVPWi      = layer(  154 type(  6) )     ; Layer HVPWi for HV and embFlash process
    UDCDMY     = layer(  148 type(101) )     ;
    CUSDMY     = layer(   74 type( 58) )     ;
  ; define no port text layer 
  ; define text layer 
    metal1_text  = textToPin( 131 )
    metal2_text  = textToPin( 132 )
    metal3_text  = textToPin( 133 )
    metal4_text  = textToPin( 134 )
    metal5_text  = textToPin( 135 )
    metal6_text  = textToPin( 136 )
    metal7_text  = textToPin( 137 )
    metal8_text  = textToPin( 138 )
    metal9_text  = textToPin( 159 )
    metal1_ptext  = textToPin( 131 )
    metal2_ptext  = textToPin( 132 )
    metal3_ptext  = textToPin( 133 )
    metal4_ptext  = textToPin( 134 )
    metal5_ptext  = textToPin( 135 )
    metal6_ptext  = textToPin( 136 )
    metal7_ptext  = textToPin( 137 )
    metal8_ptext  = textToPin( 138 )
    metal9_ptext  = textToPin( 159 )
); end gds2 layerDefs 
; #############################################
; # LOGIC OPERATION POOL                      #
; #############################################

; Form BULK layer
 BULK1       = geomBkgnd() 
 BULK        = geomSize( BULK1 0.005)
 VTL_N       = geomOr( LVID VTL_N)
 VTL_P       = geomOr( LVID VTL_P)

; ***** Define connectivity/via layer -- gate1 ****
POLYG = geomOr(POLYGi DPOLY)  ;
p1hr1 = geomAnd(POLYG RPO)  ;
RPDMY = geomOr(RPDMYi RPDMY1)  ;
OD = geomOr(ODi DOD)  ;
diff = geomAndNot(OD RODMY)  ;
rp1 = geomAndNot(RPDMY geomButtOrOver(RPDMY diff))  ;
p1rdum = geomButtOrOver(rp1 POLYG)  ; poly1 resistor dummy
rpop1 = geomButtOrOver(p1hr1 p1rdum)  ;
hripo1 = geomAnd(rpop1 HRI)  ;
rpop = geomAndNot(rpop1 geomButtOrOver(rpop1 hripo1))  ;
rpolywo1 = geomAnd(rpop RHDMY)  ;
rpolywo2 = geomAnd(rpolywo1 RPO)  ;
rpolywo = geomButtOrOver(rpolywo2 p1rdum)  ;
poly1 = geomAndNot(POLYG rpolywo)  ;
rpoly1 = geomAnd(POLYG p1rdum)  ;
rpoly = geomAndNot(rpoly1 geomButtOrOver(rpoly1 RPO))  ;
poly12 = geomAndNot(poly1 rpoly)  ;  POLY interconnect
hripo2 = geomAnd(hripo1 RHRIDMY)  ;
hripo3 = geomAndNot(hripo2 NP)  ;
hripo41 = geomAndNot(hripo3 PP)  ;
polytmp = geomAndNot(poly12 hripo41)  ;
poly = geomAndNot(polytmp MOMDMY)  ; POLY interconnect
dupo1 = geomInside(poly diff)  ;
dupo2 = geomAndNot(dupo1 geomButtOrOver(dupo1 CONT))  ;
realpo = geomAndNot(poly dupo2)  ;
rodwo1 = geomAnd(diff RHDMY)  ;
rodwo2 = geomAnd(rodwo1 RPO)  ;
drdum = geomButtOrOver(RPDMY diff)  ; diff resistor dummy
rodwo = geomButtOrOver(rodwo2 drdum)  ;
mdiff1 = geomAndNot(diff rodwo)  ;
rod1 = geomAnd(diff drdum)  ;
rod = geomAndNot(rod1 geomButtOrOver(rod1 RPO))  ;
mdiff = geomAndNot(mdiff1 rod)  ;
gate1 = geomAnd(realpo mdiff)  ;

; ***** Define connectivity/via layer -- VIA8 ****
VIA8 = geomCat(VIAD)  ;

; ***** Define connectivity/via layer -- MOM3_term ****
MOM_field3 = geomAnd(MOMDMY M3)  ;
MOM_field2 = geomAnd(MOMDMY M2)  ;
MOM_field1 = geomAnd(MOMDMY M1)  ;
MOM_node2 = geomAnd(MOM_field2 MOM_field1)  ;
MOM_node3 = geomAnd(MOM_field3 MOM_node2)  ;
MOM_field6 = geomAnd(MOMDMY M6)  ;
MOM_field5 = geomAnd(MOMDMY M5)  ;
MOM_field4 = geomAnd(MOMDMY M4)  ;
MOM_node4 = geomAnd(MOM_field4 MOM_node3)  ;
MOM_node5 = geomAnd(MOM_field5 MOM_node4)  ;
MOM_node6 = geomAnd(MOM_field6 MOM_node5)  ;
MOM6_term1 = geomButtOrOver(MOM_node6 VIA5)  ;
MOM_term_23 = geomButtOrOver(MOM_node3 VIA1)  ;
MOM_finger_2 = geomAndNot(MOM_field2 MOM_term_23)  ;
MOM6_term2 = geomButtOnly(MOM6_term1 MOM_finger_2)  ;
MOM_finger_3 = geomAndNot(MOM_field3 MOM_term_23)  ;
MOM6_term3 = geomButtOnly(MOM6_term2 MOM_finger_3)  ;
MOM_finger_6 = geomAndNot(MOM_field6 MOM_node6)  ;
MOM6_key = geomAnd(MOM_finger_2 MOM_finger_6)  ;
MOM6_term = geomButtOnly(MOM6_term3 MOM6_key)  ;
MOM3_terma = geomOutside(MOM_node3 MOM6_term)  ;
MOM5_terma = geomOutside(MOM_node5 MOM6_term)  ;
MOM5_term1 = geomButtOrOver(MOM5_terma VIA4)  ;
MOM5_term2 = geomButtOnly(MOM5_term1 MOM_finger_2)  ;
MOM5_term3 = geomButtOnly(MOM5_term2 MOM_finger_3)  ;
MOM_finger_5 = geomAndNot(MOM_field5 MOM_node5)  ;
MOM5_key = geomAnd(MOM_finger_3 MOM_finger_5)  ;
MOM5_term = geomButtOnly(MOM5_term3 MOM5_key)  ;
MOM3_termc = geomOutside(MOM3_terma MOM5_term)  ;
MOM4_terma = geomOutside(MOM_node4 MOM6_term)  ;
MOM4_termc = geomOutside(MOM4_terma MOM5_term)  ;
MOM4_term1 = geomButtOrOver(MOM4_termc VIA3)  ;
MOM4_term2 = geomButtOnly(MOM4_term1 MOM_finger_2)  ;
MOM4_term3 = geomButtOnly(MOM4_term2 MOM_finger_3)  ;
MOM_finger_4 = geomAndNot(MOM_field4 MOM_node4)  ;
MOM4_key = geomAnd(MOM_finger_2 MOM_finger_4)  ;
MOM4_term = geomButtOnly(MOM4_term3 MOM4_key)  ;
MOM3_termd = geomOutside(MOM3_termc MOM4_term)  ;
MOM3_term1 = geomButtOrOver(MOM3_termd VIA2)  ;
MOM_term_12 = geomButtOrOver(MOM_node2 VIA1)  ;
MOM_finger_1 = geomAndNot(MOM_field1 MOM_term_12)  ;
MOM3_term2 = geomButtOnly(MOM3_term1 MOM_finger_1)  ;
MOM3_term3 = geomButtOnly(MOM3_term2 MOM_finger_2)  ;
MOM3_key = geomAnd(MOM_finger_3 MOM_finger_1)  ;
MOM3_term = geomButtOnly(MOM3_term3 MOM3_key)  ;

; ***** Define connectivity/via layer -- ydio_ass ****
ydio_a = geomAnd(ESD3DMY OD)  ;
ydio_c = geomSize(ydio_a -0.2)  ;
ydio_d = geomAnd(ydio_c NP)  ;
ydio_e = geomAnd(ydio_d RPO)  ;
iso_hvnw = geomAndNot(HVNWi HVOX)  ; isolation HVNW
anwel1 = geomOr(iso_hvnw NWELL)  ; LV OR HV NWELL
anwel = geomOr(anwel1 IONW)  ;
ydio_f = geomAndNot(ydio_e anwel)  ;
ydio_g = geomAnd(ESD3DMY POLYG)  ;
ydio_h = geomSize(ydio_g 0.2)  ;
ydio_i = geomAndNot(ydio_f ydio_h)  ;
ydio_j = geomSize(ydio_i -0.7)  ;
ydio_ass = geomSize(ydio_j 0.5)  ;

; ***** Define connectivity/via layer -- ydio_hole ****
ydio = geomSize(ydio_j 0.5)  ;
ydio_hole = geomHoles(ydio)  ;

; ***** Define connectivity/via layer -- cnemit1 ****
nthin1 = geomAnd(mdiff NP)  ; define N+ thin oxide
nthin = geomAndNot(nthin1 ydio)  ;
tndiff = geomAndNot(nthin gate1)  ; define N+ diffusion region
npnrg = geomAnd(DNW BJTDMY)  ; define NPN region
nndiff = geomAnd(tndiff npnrg)  ;
ppsub = geomAndNot(BULK anwel)  ; define total p_sub region
psub2s = geomSize(PSUB2 0.01)  ;
psubband = geomAndNot(psub2s PSUB2)  ; psub separator band (doughnut).
psub = geomAndNot(ppsub psubband)  ;
pbase1 = geomAnd(psub npnrg)  ; define BJT[NV] base terminal
cnemit2 = geomAnd(nndiff pbase1)  ; define BJT[NV] emitter
cnemit2a = geomButtOrOver(cnemit2 RPO)  ; define BJT[NV] emitter
cnemit2b = geomAndNot(cnemit2a OD2)  ; define BJT[NV] emitter
cnemit1 = geomAndNot(cnemit2b OD3)  ; define BJT[NV] emitter

; ***** Define connectivity/via layer -- MOM_plant ****
MOM_plant = geomButtOrOver(poly12 MOMDMY)  ;

; ***** Define connectivity/via layer -- ncoll1 ****
NWDMY = geomOr(NWDMYi NWDMY1)  ;
nxwell = geomAndNot(anwel NWDMY)  ;
ncollrg1 = geomAnd(nxwell npnrg)  ;
ncollrg = geomAndNot(ncollrg1 HVNWi)  ;
ncolls = geomButtOnly(ncollrg pbase1)  ;
ncoll1 = geomOr(ncolls pbase1)  ; define BJT[NV] collector

; ***** Define connectivity/via layer -- nplug ****
nplug1 = geomAnd(tndiff nxwell)  ; define N_well contact
nplug3 = geomButtOrOver(nplug1 CONT)  ;
pthin = geomAnd(mdiff PP)  ; define P+ thin oxide
tpdiff = geomAndNot(pthin gate1)  ; define P+ diffusion region
tpdiffco = geomButtOrOver(tpdiff CONT)  ;
nplug2 = geomButtOrOver(nplug1 tpdiffco)  ;
nplug = geomOr(nplug3 nplug2)  ;  define N_well contact

; ***** Define connectivity/via layer -- polyCont ****
polyCont = geomAnd(CONT POLYG)  ;

; ***** Define connectivity/via layer -- cemit1 ****
ttdiff = geomAnd(tpdiff BJTDMY)  ;
nbase1a = geomAndNot(nxwell geomButtOrOver(nxwell DNW))  ;
nbase1b = geomAndNot(nbase1a HVNWi)  ;
nbase1c = geomAnd(nbase1b BJTDMY)  ;
cemit1b = geomAnd(ttdiff nbase1c)  ; define BJT[PV] emitter
cemit1c = geomAndNot(cemit1b NBL)  ;
cemit1d = geomButtOrOver(cemit1c RPO)  ;
cemit1e = geomAndNot(cemit1d OD2)  ;
cemit1 = geomAndNot(cemit1e OD3)  ;

; ***** Define connectivity/via layer -- d_tndiff ****
d_tndiff = geomAnd(tndiff DRAIN)  ;

; ***** Define connectivity/via layer -- ctm ****
ctm = geomCat(CTMi)  ;

; ***** Define connectivity/via layer -- metal8 ****
M8X = geomOr(M8 DUM8)  ;
M8Y = geomAndNot(M8X M8SLOT)  ;
inddmy1 = geomOr(IND_STD IND_SYM)  ;
IND_CT = geomSize(IND_CTi -0.005)  ;
INDDMY = geomOr(inddmy1 IND_CT)  ;
M8Z = geomAndNot(M8Y INDDMY)  ;
mt8res_RM = geomOr(RMDMY RMDMYi8)  ;
mt8res1 = geomAnd(M8Z mt8res_RM)  ; metal8 resistor
mt8res = geomButtOrOver(mt8res1 M8)  ;
metal8 = geomAndNot(M8Z mt8res)  ;

; ***** Define connectivity/via layer -- nbase1 ****
nbase1 = geomAndNot(nbase1c NBL)  ;

; ***** Define connectivity/via layer -- metal3 ****
M3X = geomOr(M3 DUM3)  ;
M3Y = geomAndNot(M3X M3SLOT)  ;
mt3res_RM = geomOr(RMDMY RMDMYi3)  ;
M3Z = geomAnd(M3Y mt3res_RM)  ;
mt3res = geomButtOrOver(M3Z M3)  ; metal3 resistor
metal3 = geomAndNot(M3Y mt3res)  ;

; ***** Define connectivity/via layer -- metal2 ****
M2X = geomOr(M2 DUM2)  ;
M2Y = geomAndNot(M2X M2SLOT)  ;
mt2res_RM = geomOr(RMDMY RMDMYi2)  ;
M2Z = geomAnd(M2Y mt2res_RM)  ;
mt2res = geomButtOrOver(M2Z M2)  ; metal2 resistor
metal2 = geomAndNot(M2Y mt2res)  ;

; ***** Define connectivity/via layer -- poly_term ****
poly_term11 = geomAnd(POLYG RPDMY1)  ;
hripo42 = geomButtOrOver(hripo41 RPDMYi)  ;
rf_hripo1 = geomAnd(hripo42 RFDMY)  ;
rf_hripo = geomButtOrOver(rf_hripo1 POLYGi)  ; HRI high poly resistor (3-terminals rf)
poly_term1 = geomOr(poly_term11 rf_hripo)  ;
poly_term2 = geomSize(poly_term1 0.005)  ;
poly_term = geomAndNot(poly_term2 poly_term1)  ;

; ***** Define connectivity/via layer -- ntap ****
ntapx = geomAnd(tndiff nxwell)  ;
ntap1 = geomAndNot(ntapx BJTDMY)  ;
ntap2 = geomButtOrOver(ntap1 CONT)  ;
ntap3 = geomButtOrOver(ntap1 tpdiffco)  ;
ntap = geomOr(ntap2 ntap3)  ;

; ***** Define connectivity/via layer -- poly_nw_via ****
poly_nw_via = geomAnd(poly_term nxwell)  ;

; ***** Define connectivity/via layer -- s_tndiff ****
s_tndiff1 = geomAndNot(tndiff DRAIN)  ;
gate_a = geomAndNot(gate1 DMSRM)  ;
gate_rfa = geomAnd(gate_a RFDMY)  ;
poly_rf1 = geomButtOrOver(poly CONT)  ;
poly_rf = geomButtOrOver(poly_rf1 DRAIN)  ;
gate_rfb = geomAnd(gate_rfa poly_rf)  ;
gate_rf = geomAndNot(gate_rfb VARDMY)  ;
s_tndiff = geomButtOrOver(s_tndiff1 gate_rf)  ;

; ***** Define connectivity/via layer -- metal4 ****
M4X = geomOr(M4 DUM4)  ;
M4Y = geomAndNot(M4X M4SLOT)  ;
mt4res_RM = geomOr(RMDMY RMDMYi4)  ;
M4Z = geomAnd(M4Y mt4res_RM)  ;
mt4res = geomButtOrOver(M4Z M4)  ; metal4 resistor
metal4 = geomAndNot(M4Y mt4res)  ;

; ***** Define connectivity/via layer -- schottky_p ****
pthin1 = geomStraddle(mdiff PP)  ;
SBD_RF1 = geomAnd(SBDDMY RFDMY)  ;
SBD_RF = geomAndNot(SBD_RF1 VARDMY)  ;
sbd_nw = geomAnd(nxwell SBD_RF)  ;
schottky_p = geomAnd(pthin1 sbd_nw)  ;

; ***** Define connectivity/via layer -- ctm_via ****
cbm = geomCat(CBMi)  ;
mim_block = geomAnd(ctm cbm)  ;
mim_top = geomButtOrOver(mim_block M7)  ;
RCTM = geomButtOrOver(mim_top VIA6i)  ;
ctm_via = geomAnd(RCTM VIA6i)  ;

; ***** Define connectivity/via layer -- VIA6 ****
VIA6a = geomAndNot(VIA6i ctm_via)  ;
RCBM = geomButtOrOver(cbm RCTM)  ;
OCBM = geomAndNot(RCBM RCTM)  ;
cbm_via = geomAnd(OCBM VIA6i)  ;
VIA6 = geomAndNot(VIA6a cbm_via)  ;

; ***** Define connectivity/via layer -- dnwc ****
dnwc = geomAnd(DNW nxwell)  ;

; ***** Define connectivity/via layer -- tiod ****
tioda = geomAndNot(diff tpdiff)  ;
tiodb = geomAndNot(tioda tndiff)  ;
tiod1 = geomAndNot(tiodb POLYG)  ;
tiod2 = geomAndNot(tiod1 RPO)  ;
tiod3 = geomAndNot(tiod2 RPDMY)  ;
tiod = geomAndNot(tiod3 NWDMY)  ; RPO, RPDMY, NWDMY cut ti-od

; ***** Define connectivity/via layer -- n_psub ****
n_ppsuba = geomAndNot(BULK psubband)  ;
hnw_nbl1 = geomButtOrOver(iso_hvnw NBL)  ;
iso_hvrw = geomInside(ppsub NBL)  ;
hnw_nbl = geomButtOrOver(hnw_nbl1 iso_hvrw)  ;
n_ppsubb = geomAndNot(n_ppsuba hnw_nbl)  ;
HVPW = geomAndNot(HVOX HVNWi)  ;
n_ppsubc = geomAndNot(n_ppsubb HVPW)  ;
n_psub1 = geomAndNot(n_ppsubc psub2s)  ;
n_psub2 = geomAnd(n_ppsubc PSUB2)  ;
n_psub = geomOr(n_psub1 n_psub2)  ;

; ***** Define connectivity/via layer -- psub_term ****
psub_term_a = geomAndNot(psub2s PSUB2)  ;
psub_term_b = geomAndNot(BULK psub_term_a)  ;
psub_term_c = geomAnd(BULK DNW)  ;
psub_term_d = geomAndNot(BULK psub_term_c)  ;
psub_term_e = geomAnd(psub_term_b psub_term_d)  ;
psub_term_f = geomAndNot(psub_term_e PSUBi)  ;
psub_term_g = geomButtOrOver(psub_term_f DNW)  ;
psub_term = geomAndNot(psub_term_g HVOX)  ;

; ***** Define connectivity/via layer -- metal6 ****
M6X = geomOr(M6 DUM6)  ;
M6Y = geomAndNot(M6X M6SLOT)  ;
M6Z = geomAndNot(M6Y INDDMY)  ;
mt6res_RM = geomOr(RMDMY RMDMYi6)  ;
mt6res1 = geomAnd(M6Z mt6res_RM)  ; metal6 resistor
mt6res = geomButtOrOver(mt6res1 M6)  ;
metal6 = geomAndNot(M6Z mt6res)  ;

; ***** Define connectivity/via layer -- metal7 ****
M7X = geomOr(M7 DUM7)  ;
M7Y = geomAndNot(M7X M7SLOT)  ;
M7Z = geomAndNot(M7Y INDDMY)  ;
mt7res_RM = geomOr(RMDMY RMDMYi7)  ;
mt7res1 = geomAnd(M7Z mt7res_RM)  ; metal7 resistor
mt7res = geomButtOrOver(mt7res1 M7)  ;
metal7 = geomAndNot(M7Z mt7res)  ;

; ***** Define connectivity/via layer -- s_tpdiff ****
s_tpdiff1 = geomAndNot(tpdiff DRAIN)  ;
s_tpdiff = geomButtOrOver(s_tpdiff1 gate_rf)  ;

; ***** Define connectivity/via layer -- d_tpdiff ****
d_tpdiff = geomAnd(tpdiff DRAIN)  ;

; ***** Define connectivity/via layer -- n_pplug ****
n_pplug1 = geomButtOrOver(mdiff CONT)  ;
n_pplug2 = geomAnd(n_pplug1 PP)  ;
n_pplug3 = geomAndNot(n_pplug2 nxwell)  ;
rw = geomInside(ppsub DNW)  ;
n_pplug4 = geomAndNot(n_pplug3 rw)  ;
n_pplug5 = geomAnd(n_pplug4 n_psub)  ;
n_pplug = geomAndNot(n_pplug5 gate1)  ;

; ***** Define connectivity/via layer -- poly_psub_via ****
poly_psub_via = geomAnd(poly_term psub)  ;

; ***** Define connectivity/via layer -- metal1 ****
M1X = geomOr(M1 DUM1)  ;
M1Y = geomAndNot(M1X M1SLOT)  ;
mt1res_RM = geomOr(RMDMY RMDMYi1)  ;
M1Z = geomAnd(M1Y mt1res_RM)  ;
mt1res = geomButtOrOver(M1Z M1)  ; metal1 resistor
metal1 = geomAndNot(M1Y mt1res)  ;

; ***** Define connectivity/via layer -- metal5 ****
M5X = geomOr(M5 DUM5)  ;
M5Y = geomAndNot(M5X M5SLOT)  ;
M5Z = geomAndNot(M5Y INDDMY)  ;
mt5res_RM = geomOr(RMDMY RMDMYi5)  ;
mt5res1 = geomAnd(M5Z mt5res_RM)  ; metal5 resistor
mt5res = geomButtOrOver(mt5res1 M5)  ;
metal5 = geomAndNot(M5Z mt5res)  ;

; ***** Define connectivity/via layer -- nxwell_npn ****
ncollsa = geomButtOnly(ncolls cnemit1)  ;
nxwell_npn = geomAndNot(ncolls ncollsa)  ;

; ***** Define connectivity/via layer -- ptap ****
ptap1 = geomAnd(tpdiff psub)  ;
ptap2 = geomButtOrOver(ptap1 CONT)  ;
tndiffco = geomButtOrOver(tndiff CONT)  ;
ptap3 = geomButtOrOver(ptap1 tndiffco)  ;
ptap = geomOr(ptap2 ptap3)  ;

; ***** Define connectivity/via layer -- shield ****
shield1 = geomOr(metal5 metal4)  ;
shield2 = geomAnd(shield1 ctm)  ;
shield = geomAnd(shield2 RFDMY)  ;

; ***** Define connectivity/via layer -- pplug ****
pplug1 = geomAnd(tpdiff psub)  ; define p_sub contact
pplug3 = geomButtOrOver(pplug1 CONT)  ;
pplug2 = geomButtOrOver(pplug1 tndiffco)  ;
pplug = geomOr(pplug3 pplug2)  ; define p_sub contact

; ***** Define connectivity/via layer -- hvdnwc ****
HVNW = geomAnd(HVNWi HVOX)  ;
hvdnwc1 = geomAnd(NBL HVNW)  ;
hvdnwc2 = geomAndNot(hvdnwc1 DPW)  ;
hvdnwc3 = geomAnd(NBL iso_hvnw)  ;
hvdnwc = geomOr(hvdnwc2 hvdnwc3)  ;

; ***** Define connectivity/via layer -- MOM_edge_mt ****
MOM_edge_mt = geomAnd(M1 MOM_plant)  ;

; ***** Define connectivity/via layer -- schottky_n ****
schottky_n = geomAnd(nthin1 sbd_nw)  ;

; ***** Define connectivity/via layer -- metal9 ****
metal9 = geomCat(MD)  ;

; ***** Define connectivity/via layer -- coll1 ****
collsur = geomButtOnly(psub nbase1c)  ;
coll1a = geomOr(collsur nbase1c)  ; define BJT[PV] collector
collsura = geomButtOnly(collsur cemit1b)  ;
coll1b = geomAndNot(coll1a collsura)  ;
coll1c = geomAndNot(coll1b cemit1)  ; define pnp collector
coll1 = geomAndNot(coll1c NBL)  ;

; ***** Define connectivity/via layer -- odCont ****
odCont = geomAndNot(CONT POLYG)  ;

;//#############################################
;//# FORM DEVICE LAYER                         #
;//#############################################
;
;* Define device -- nmos N
gate = geomAndNot(gate_a RFDMY)  ;
gatennw = geomAndNot(gate nxwell)  ; gate not inside nwell
tngate1 = geomAnd(gatennw NP)  ;
tngate1a = geomAndNot(tngate1 PSUBi)  ;
tngate2 = geomAndNot(tngate1a OD2)  ;
tngate3a = geomAndNot(tngate2 NTN)  ;
tngate3 = geomAndNot(tngate3a HNVT)  ;
tngate4 = geomAndNot(tngate3 DNW)  ;
nlvgate = geomAnd(tngate4 VTL_N)  ; CORE LOW_VT NMOS
ngate1 = geomAndNot(tngate4 nlvgate)  ;
nhvgate = geomAnd(tngate4 VTH_N)  ; CORE HIGH_VT NMOS
ngate2 = geomAndNot(ngate1 nhvgate)  ;
ngate = geomAndNot(ngate2 UHVT_N)  ; CORE NMOS
;
;* Define device -- nmos ND
bngate1 = geomAnd(tngate1a OD2)  ;
bngate2a = geomAndNot(bngate1 NTN)  ;
bngate2b = geomAndNot(bngate2a CAP_IMP)  ;
bngate2c = geomAndNot(bngate2b CELLMV)  ;
bngate2 = geomAndNot(bngate2c HNVT)  ;
bngate3 = geomAndNot(bngate2 DNW)  ;
bngate = geomAndNot(bngate3 VTL_N)  ; I/O NMOS (original)
;
;* Define device -- nmos NHL
bnlvgate = geomAnd(bngate3 VTL_N)  ; I/O LOW_VT NMOS
;
;* Define device -- nmos N1
tdgate1 = geomAnd(tngate3 DNW)  ;
n1lvgate = geomAnd(tdgate1 VTL_N)  ; CORE LOW_VT NMOS on DNW
nrgate1 = geomAndNot(tdgate1 n1lvgate)  ;
n1hvgate = geomAnd(tdgate1 VTH_N)  ; CORE HIGH_VT NMOS on DNW
nrgate = geomAndNot(nrgate1 n1hvgate)  ; CORE NMOS on DNW
;
;* Define device -- nmos N2
bndgate = geomAnd(bngate2 DNW)  ;
bnrgate = geomAndNot(bndgate VTL_N)  ; I/O NMOS on DNW
;
;* Define device -- nmos N2LV
bndlvgate = geomAnd(bndgate VTL_N)  ; I/O LOW_VT NMOS on DNW
;
;* Define device -- nmos NL
nlgate1 = geomAnd(tngate2 NTN)  ;
nlgate1a = geomAndNot(nlgate1 HNVT)  ;
nlgate2 = geomAndNot(nlgate1a VTL_N)  ;
nlgate3 = geomAndNot(nlgate2 VTH_N)  ;
nlgate4 = geomAndNot(nlgate3 DNW)  ; CORE Native Devies
nlgate = geomAndNot(nlgate4 OD3)  ; CORE Native Devies
;
;* Define device -- nmos NN
bnngate1 = geomAnd(bngate1 NTN)  ;
bnngate2 = geomAndNot(bnngate1 VTL_N)  ;
bnngate3 = geomAndNot(bnngate2 HNVT)  ;
bnngate4 = geomAndNot(bnngate3 DNW)  ;
bnngate = geomAndNot(bnngate4 CAP_IMP)  ; I/O Native Devices
;
;* Define device -- nmos nch_uhvt
ngate_uhvt = geomAnd(ngate2 UHVT_N)  ; CORE UHVT NMOS
;
;* Define device -- nmos nch_sram
gate_s1 = geomAnd(gate1 DMSRM)  ;
gatennw_s = geomAndNot(gate_s1 nxwell)  ; gate not inside nwell
ngate_s1 = geomAnd(gatennw_s NP)  ;
ngate_s2 = geomAndNot(ngate_s1 OD2)  ;
ngate_s3 = geomAndNot(ngate_s2 VTH_N)  ;
ngate_s4 = geomAndNot(ngate_s3 VTL_N)  ;
ngate_s5 = geomAndNot(ngate_s4 HVTSRM)  ;
ngate_s = geomCat(ngate_s5)  ; SRAM NMOS
;
;* Define device -- nmos nch_sram_hvt
ngate_s_hvt = geomAnd(ngate_s4 HVTSRM)  ; HVT SRAM NMOS
;
;* Define device -- pmos P
gatenw = geomAnd(gate nxwell)  ; gate inside nwell
tpgate1 = geomAnd(gatenw PP)  ;
tpgate2 = geomAndNot(tpgate1 OD2)  ;
tpgate3 = geomAndNot(tpgate2 HVNWi)  ;
plvgate = geomAnd(tpgate3 VTL_P)  ; CORE LOW_VT PMOS
pgate1 = geomAndNot(tpgate3 plvgate)  ;
phvgate = geomAnd(tpgate3 VTH_P)  ; CORE HIGH_VT PMOS
pgate2 = geomAndNot(pgate1 phvgate)  ;
pgate = geomAndNot(pgate2 UHVT_P)  ; CORE PMOS
;
;* Define device -- pmos PD
bpgate1 = geomAnd(tpgate1 OD2)  ;
bpgate2 = geomAndNot(bpgate1 HVNWi)  ;
bpgate = geomAndNot(bpgate2 VTL_P)  ; I/O PMOS
;
;* Define device -- pmos pch_sram
gatenw_s = geomAnd(gate_s1 nxwell)  ; gate inside nwell
pgate_s1 = geomAnd(gatenw_s PP)  ;
pgate_s2 = geomAndNot(pgate_s1 OD2)  ;
pgate_s3 = geomAndNot(pgate_s2 VTH_P)  ;
pgate_s4 = geomAndNot(pgate_s3 VTL_P)  ;
pgate_s = geomAndNot(pgate_s4 HVTSRM)  ; SRAM PMOS
;
;* Define device -- pmos pchpu_hvtsr_g
pgate_s_hvt = geomAnd(pgate_s4 HVTSRM)  ; HVT SRAM PMOS
;
;* Define device -- pmos PHL
bplvgate = geomAnd(bpgate2 VTL_P)  ; I/O LOW_VT PMOS
;
;* Define device -- pmos pch_uhvt
pgate_uhvt = geomAnd(pgate2 UHVT_P)  ; CORE UHVT PMOS
;
;* Define device -- diode DP
pdio1 = geomAnd(tpdiff DIODMY)  ;
pdio2a = geomAnd(pdio1 nxwell)  ;
npdiff = geomAnd(tpdiff tndiff)  ; overlap region of PP diff with NP diff
zenarng = geomAnd(npdiff RPO)  ;
zenpdif1 = geomButtOrOver(pdio2a zenarng)  ;
pdio2 = geomAndNot(pdio2a zenpdif1)  ;
pdio3 = geomAndNot(pdio2 OD2)  ;
cpdio1 = geomAndNot(pdio3 VTH_P)  ;
cpdio2 = geomAndNot(cpdio1 VTL_P)  ;
cpdio3 = geomAndNot(cpdio2 geomButtOrOver(cpdio2 HVNWi))  ;
cpdio = geomAndNot(cpdio3 UHVT_P)  ; CORE P+/NW DIODE
;
;* Define device -- diode DN
ndio1 = geomAnd(tndiff DIODMY)  ;
ndio2a = geomAnd(ndio1 psub)  ;
ndio2b = geomAndNot(ndio2a HVOX)  ;
ndio2 = geomAndNot(ndio2b PSUBi)  ; Exclude ndio from ndio_hv(Add by pywangi on 09/08/04)
ndio3 = geomAndNot(ndio2 OD2)  ;
ndio4 = geomAndNot(ndio3 NTN)  ;
cndio1 = geomAndNot(ndio4 VTH_N)  ;
cndio2 = geomAndNot(cndio1 VTL_N)  ;
cndio = geomAndNot(cndio2 UHVT_N)  ; CORE N+/PW DIODE
;
;* Define device -- diode DW
DIONW = geomOutside(DIODMY tpdiff)  ;
nwdio1a = geomAnd(nxwell DIONW)  ;
nwdio1 = geomAndNot(nwdio1a HVNWi)  ;
cnwdio = geomAndNot(nwdio1 OD2)  ; CORE NW/PW diode
;
;* Define device -- diode D1
ipdioa = geomAnd(pdio2 OD2)  ;
ipdio = geomAndNot(ipdioa VTL_P)  ; I/O  P+/NW DIODE		
;
;* Define device -- diode D2
indio1 = geomAnd(ndio2 OD2)  ;
indioa = geomAndNot(indio1 NTN)  ;
indioa2 = geomAndNot(indioa VTL_N)  ; I/O N+/PW DIODE
indio = geomAndNot(indioa2 CELLMV)  ;
;
;* Define device -- diode DPL
pdiol = geomAnd(pdio3 VTL_P)  ; CORE P+/NW Low_VT DIODE
;
;* Define device -- diode DNL
ndiol = geomAnd(ndio4 VTL_N)  ; CORE N+/PW Low_VT DIODE
;
;* Define device -- diode D1N
nndio1 = geomAnd(ndio3 NTN)  ;
ndion2 = geomAndNot(nndio1 VTH_N)  ;
ndion3 = geomAndNot(ndion2 VTL_N)  ; CORE N+/PW Native DIODE
cndion = geomAndNot(ndion3 OD3)  ; CORE N+/PW Native DIODE
;
;* Define device -- diode D2N
indion = geomAnd(indio1 NTN)  ; I/O N+/PW Native DIODE
;
;* Define device -- diode DPH
pdioh = geomAnd(pdio3 VTH_P)  ; CORE P+/NW HIGH_VT DIODE
;
;* Define device -- diode DNH
ndioh = geomAnd(ndio4 VTH_N)  ; CORE N+/PW HIGH_VT DIODE
;
;* Define device -- diode D3
inwdio = geomAnd(nwdio1 OD2)  ; I/O NW/PW diode
;
;* Define device -- diode NDIO_lvt25
indio_lvt = geomAnd(indio1 VTL_N)  ; I/O N+/PW Low_VT DIODE
;
;* Define device -- diode PDIO_lvt25
ipdio_lvt = geomAnd(ipdioa VTL_P)  ; I/O  P+/NW Low_VT DIODE
;
;* Define device -- diode ndio_uhvt
cndio_uhvt = geomAnd(cndio2 UHVT_N)  ; UHVT CORE N+/PW DIODE
;
;* Define device -- diode pdio_uhvt
cpdio_uhvt = geomAnd(cpdio3 UHVT_P)  ; UHVT CORE P+/NW DIODE
;
;* Define device -- bjt pnp2
cemit2 = drc(cemit1 3.999 < area < 4.001) ;
;
;* Define device -- bjt pnp5
cemit5 = drc(cemit1 24.999 < area < 25.001) ;
;
;* Define device -- bjt pnp10
cemit10 = drc(cemit1 99.999 < area < 100.001) ;
;
;* Define device -- bjt npn2
nemit2 = drc(cnemit1 3.999 < area < 4.001) ;
;
;* Define device -- bjt npn5
nemit5 = drc(cnemit1 24.999 < area < 25.001) ;
;
;* Define device -- bjt npn10
nemit10 = drc(cnemit1 99.999 < area < 100.001) ;
;
;* Define device -- xdev PR
rppolywo_r1 = geomAnd(rpolywo PP)  ;
rppolywo_r2 = geomButtOrOver(rppolywo_r1 RPDMYi)  ;
rppolywo_r3 = geomAndNot(rppolywo_r2 RFDMY)  ;
rppolywo_r = geomButtOrOver(rppolywo_r3 POLYGi)  ; P+POLY resistor w/o silicide
;
;* Define device -- xdev NR
rnpolywo_r1 = geomAnd(rpolywo NP)  ;
rnpolywo_r2 = geomButtOrOver(rnpolywo_r1 RPDMYi)  ;
rnpolywo_r = geomButtOrOver(rnpolywo_r2 POLYGi)  ; N+POLY resistor w/o silicide
;
;* Define device -- xdev PD
rpodwo1 = geomAnd(rodwo PP)  ;
rpodwo_r1 = geomAnd(rpodwo1 NWELL)  ;
rpodwo_r2 = geomButtOrOver(rpodwo_r1 RPDMYi)  ;
rpodwo_r = geomButtOrOver(rpodwo_r2 ODi)  ; P+OD resistor w/o silicide
;
;* Define device -- xdev ND
rnodwo1 = geomAnd(rodwo NP)  ;
rnodwo_r1 = geomAndNot(rnodwo1 NWELL)  ;
rnodwo_r2 = geomButtOrOver(rnodwo_r1 RPDMYi)  ;
rnodwo_r = geomButtOrOver(rnodwo_r2 ODi)  ; N+OD resistor w/o silicide
;
;* Define device -- xdev WR
trwell = geomAnd(NWDMY NWELL)  ; N-well resistor layer
drpo1 = geomAnd(diff RPO)  ;
drpo = geomButtOrOver(drpo1 ODi)  ;
nwsti_r1 = geomAndNot(trwell drpo)  ; NWDMY*NWELL-RPO-diff --> nwsti
nwsti_r = geomButtOrOver(nwsti_r1 NWDMYi)  ; NWDMY*NWELL-RPO-diff --> nwsti
;
;* Define device -- xdev WO
nwod_r1 = geomAnd(trwell drpo)  ;
nwod_r = geomButtOrOver(nwod_r1 NWDMYi)  ; NWDMY*NWELL*RPO*diff --> nwod
;
;* Define device -- xdev PS1
rppoly_r1 = geomAnd(rpoly PP)  ;
rppoly_r1_eg = geomGetEdge(rppoly_r1 inside POLYG)  ;
l_rppoly_r1_eg = geomGetLength(rppoly_r1_eg 2 <= keep < 99999999) ;
l_rppoly_r1_eg_edge_su001=geomSize(l_rppoly_r1_eg 0.005 edges);
l_rppoly_r1 = geomButtOrCoin( rppoly_r1 l_rppoly_r1_eg_edge_su001 )  ;
rf_lrppoly = geomAnd(l_rppoly_r1 RFDMY)  ;
lrppoly_rf1 = geomButtOrOver(rf_lrppoly RPDMYi)  ;
lrppoly_rf = geomButtOrOver(lrppoly_rf1 POLYGi)  ; P+POLY resistor w/i silicide (3-terminal rf w >=  2um)
lrppoly_ra = geomAndNot(l_rppoly_r1 lrppoly_rf)  ;
lrppoly_d1 = geomButtOrOver(l_rppoly_r1 RPDMY1)  ;
lrppoly_d = geomButtOrOver(lrppoly_d1 POLYGi)  ; P+POLY resistor w/i silicide (3-terminal dis w >=  2um)
lrppoly_rb = geomAndNot(lrppoly_ra lrppoly_d)  ;
s_rppoly_r1 = geomAndNot(rppoly_r1 l_rppoly_r1)  ;
rf_srppoly = geomAnd(s_rppoly_r1 RFDMY)  ;
srppoly_rf1 = geomButtOrOver(rf_srppoly RPDMYi)  ;
srppoly_rf = geomButtOrOver(srppoly_rf1 POLYGi)  ; P+POLY resistor w/i silicide (3-terminal rf w < 2um)
srppoly_ra = geomAndNot(s_rppoly_r1 srppoly_rf)  ;
srppoly_d1 = geomButtOrOver(s_rppoly_r1 RPDMY1)  ;
srppoly_d = geomButtOrOver(srppoly_d1 POLYGi)  ; P+POLY resistor w/i silicide (3-terminal dis w < 2um)
srppoly_rb = geomAndNot(srppoly_ra srppoly_d)  ;
rppoly_rx = geomOr(lrppoly_rb srppoly_rb)  ;
rppoly_ry = geomButtOrOver(rppoly_rx RPDMYi)  ;
rppoly_r = geomButtOrOver(rppoly_ry POLYGi)  ; P+POLY resistor w/i silicide
rppoly_edge = geomGetEdge(rppoly_r inside POLYG)  ;
l_rppoly = geomGetLength(rppoly_edge 2 <= keep < 99999999) ;
l_rppoly_edge_su001=geomSize(l_rppoly 0.005 edges);
rppolyl_r = geomButtOrCoin( rppoly_r l_rppoly_edge_su001 )  ;  P+POLY resistor w/i silicide >=  2
;
;* Define device -- xdev PS2
rppolys_r = geomAndNot(rppoly_r rppolyl_r)  ;  P+POLY resistor w/i silicide < 2
;
;* Define device -- xdev NS1
rnpoly_r1 = geomAnd(rpoly NP)  ;
rnpoly_r2 = geomButtOrOver(rnpoly_r1 RPDMYi)  ;
rnpoly_r = geomButtOrOver(rnpoly_r2 POLYGi)  ; N+POLY resistor w/i silicide
rnpoly_edge = geomGetEdge(rnpoly_r inside POLYG)  ;
l_rnpoly = geomGetLength(rnpoly_edge 2 <= keep < 99999999) ;
l_rnpoly_edge_su001=geomSize(l_rnpoly 0.005 edges);
rnpolyl_r = geomButtOrCoin( rnpoly_r l_rnpoly_edge_su001 )  ;  N+POLY resistor w/i silicide >=  2
;
;* Define device -- xdev NS2
rnpolys_r = geomAndNot(rnpoly_r rnpolyl_r)  ;  N+POLY resistor w/i silicide < 2
;
;* Define device -- xdev PI1
rpod1 = geomAnd(rod PP)  ;
rpod_r1 = geomAnd(rpod1 NWELL)  ;
rpod_r2 = geomButtOrOver(rpod_r1 RPDMYi)  ;
rpod_r = geomButtOrOver(rpod_r2 ODi)  ; P+OD resistor w/i silicide
rpod_edge = geomGetEdge(rpod_r inside diff)  ;
l_rpod = geomGetLength(rpod_edge 2 <= keep < 99999999) ;
l_rpod_edge_su001=geomSize(l_rpod 0.005 edges);
rpodl_r = geomButtOrCoin( rpod_r l_rpod_edge_su001 )  ;  P+OD resistor w/i silicide >=  2
;
;* Define device -- xdev PI2
rpods_r = geomAndNot(rpod_r rpodl_r)  ;  P+OD resistor w/i silicide < 2
;
;* Define device -- xdev NI1
rnod1 = geomAnd(rod NP)  ;
rnod_r1 = geomAndNot(rnod1 NWELL)  ;
rnod_r2 = geomButtOrOver(rnod_r1 RPDMYi)  ;
rnod_r = geomButtOrOver(rnod_r2 ODi)  ; N+OD resistor w/i silicide
rnod_edge = geomGetEdge(rnod_r inside diff)  ;
l_rnod = geomGetLength(rnod_edge 2 <= keep < 99999999) ;
l_rnod_edge_su001=geomSize(l_rnod 0.005 edges);
rnodl_r = geomButtOrCoin( rnod_r l_rnod_edge_su001 )  ;  N+OD resistor w/i silicide >=  2
;
;* Define device -- xdev NI2
rnods_r = geomAndNot(rnod_r rnodl_r)  ;  N+OD resistor w/i silicide < 2
;
;* Define device -- xdev rpodwo_m
rpodwo_mr1 = geomButtOrOver(rpodwo_r1 RPDMY1)  ;
rpodwo_mr = geomButtOrOver(rpodwo_mr1 ODi)  ; P+OD resistor w/o silicide (3-terminals)
;
;* Define device -- xdev rnodwo_m
rnodwo_mr1 = geomButtOrOver(rnodwo_r1 RPDMY1)  ;
rnodwo_mr = geomButtOrOver(rnodwo_mr1 ODi)  ; N+OD resistor w/o silicide (3-terminals)
;
;* Define device -- xdev rnwod_m
nwod_mr = geomButtOrOver(nwod_r1 NWDMY1)  ; NWDMY*NWELL*RPO*diff --> nwod (3-terminals)
;
;* Define device -- xdev rpodl_m
rpod_mr1a = geomButtOrOver(rpod_r1 RPDMY1)  ;
rpod_mr1 = geomButtOrOver(rpod_mr1a ODi)  ;
rpod_mr1_edge = geomGetEdge(rpod_mr1 inside diff)  ;
l_rpod_mr1 = geomGetLength(rpod_mr1_edge 2 <= keep < 99999999) ;
l_rpod_mr1_edge_su001=geomSize(l_rpod_mr1 0.005 edges);
rpodl_mr = geomButtOrCoin( rpod_mr1 l_rpod_mr1_edge_su001 )  ; P+OD resistor w/i silicide (3-terminals)
;
;* Define device -- xdev rnodl_m
rnod_mr1a = geomButtOrOver(rnod_r1 RPDMY1)  ;
rnod_mr1 = geomButtOrOver(rnod_mr1a ODi)  ;
rnod_mr1_edge = geomGetEdge(rnod_mr1 inside diff)  ;
l_rnod_mr1 = geomGetLength(rnod_mr1_edge 2 <= keep < 99999999) ;
l_rnod_mr1_edge_su001=geomSize(l_rnod_mr1 0.005 edges);
rnodl_mr = geomButtOrCoin( rnod_mr1 l_rnod_mr1_edge_su001 )  ; N+OD resistor w/i silicide (3-terminals)
;
;* Define device -- xdev rpods_m
rpods_mr = geomAndNot(rpod_mr1 rpodl_mr)  ; P+OD resistor w/i silicide (3-terminals)
;
;* Define device -- xdev rnods_m
rnods_mr = geomAndNot(rnod_mr1 rnodl_mr)  ; N+OD resistor w/i silicide (3-terminals)
;
;* Define device -- xdev rnwsti_m
nwsti_mr = geomButtOrOver(nwsti_r1 NWDMY1)  ; NWDMY*NWELL-RPO-diff --> nwsti (3-terminals)
;
;* Define device -- xdev pwdnw
rwdio_a = geomAndNot(DNW nxwell)  ;
rwdio = geomAndNot(rwdio_a BJTDMY)  ;
;
;* Define device -- xdev dnwpsub
dnwdio_b = geomButtOrOver(nxwell DNW)  ;
dnwdio_c = geomAndNot(dnwdio_b HVNWi)  ;
dnwdio_a = geomInside(nxwell DNW)  ;
dnwdio_k = geomAndNot(dnwdio_c dnwdio_a)  ;
dnwdio = geomButtOrOver(DNW dnwdio_k)  ;
;
;* Define device -- xdev pnwdio
bjtdmy_nbase_all = geomButtOrOver(BJTDMY nbase1)  ; BJTDMY in pnp devices
pnwdio0 = geomAndNot(nxwell bjtdmy_nbase_all)  ;
pnwdio1 = geomAndNot(pnwdio0 geomButtOrOver(pnwdio0 NWDMY1))  ;
pnwdio2 = geomOutside(pnwdio1 nwdio1a)  ;
pnwdio4 = geomAndNot(pnwdio2 DNW)  ;
pnwdio = geomButtOnly(geomOutside(pnwdio4 psub) psub keep == 1 ) ;
;
;* Define device -- xdev rppolyhri_dis
hripo_d1 = geomButtOrOver(hripo41 RPDMY1)  ;
hripo_d2 = geomButtOrOver(hripo_d1 POLYGi)  ; HRI high poly resistor (3-terminals dis)
RHRIDMY_2K = geomCat(RHRIDMY_2Ki)  ;
RHRIDMY_2Ka = geomButtOrOver(BULK RHRIDMY_2K)  ;
hripo_d = geomAndNot(hripo_d2 geomButtOrOver(hripo_d2 RHRIDMY_2Ka))  ;
;
;* Define device -- xdev rnpolywo_dis
rnpolywo_d1 = geomButtOrOver(rnpolywo_r1 RPDMY1)  ;
rnpolywo_d = geomButtOrOver(rnpolywo_d1 POLYGi)  ; N+POLY resistor w/o silicide (3-terminals dis)
;
;* Define device -- xdev rppolywo_dis
rppolywo_d1 = geomButtOrOver(rppolywo_r1 RPDMY1)  ;
rppolywo_d = geomButtOrOver(rppolywo_d1 POLYGi)  ; P+POLY resistor w/o silicide (3-terminals dis)
;
