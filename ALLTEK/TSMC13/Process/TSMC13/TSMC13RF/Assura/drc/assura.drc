 pad_m4iu_by_text = geomGetTexted( m4x m4pin "?" )  
 pwr_m5iu_by_text = geomGetTexted( m5x m5pin "VDD?" )  
 gnd_m5iu_by_text = geomGetTexted( m5x m5pin "VSS?" )  
 pad_m5iu_by_text = geomGetTexted( m5x m5pin "?" )  
