 errorLayer( geomAndNot(srcbd_rvwarn4_sr_edgex2 geomButtOrOver(srcbd_rvwarn4_sr_edgex2 cbdi )) 
	"SR.CBD_RV.WARN 2   CBD is must in seal-ring if flip chip (without AlCu fuse or AlCu RDL) is used  Either CBD or RV is must in seal-ring if flip chip(with AlCu fuse or AlCu RDL) is used ")  
