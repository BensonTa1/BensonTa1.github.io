/* CSR CHECKS */
/* ========== */
 sr_not_pmdmy = geomAndNot(sealring geomButtOrOver(sealring pmdmy ))   
 co_and1 =  geomAnd(co csrdmy)  
 cc_co = geomAndNot(co_and1 via_exd)  
 csr_od = geomAnd(odi csrdmy)  
 cc_m1 = geomAnd(m1x csrdmy)  
 cc_v1 = geomAnd(via12i csrdmy)  
if((LmarkSealringCorner == 1) then
 cc_m1_sz1 =  geomWidth(  cc_m1 keep > 1.2   )  /*  filter non-check metal */ 
cc_m1_sz1_out1 = geomHoles(cc_m1_sz1  )
 cc_m1_hole = cc_m1_sz1_out1  /*  filter non-check metal */
else;
cc_m1_out1 = geomHoles(cc_m1  )
 cc_m1_hole = cc_m1_out1  
) ; 
 check_csr_m1 = geomOr(cc_m1 cc_m1_hole)  
 cc_m1_lslot = geomButtOrOver( cc_m1_hole lslot  )  /*  filter LMARK */ 
 cc_m1_fence_hole = geomAndNot(cc_m1_hole geomButtOrOver(cc_m1_hole lslot ))   
 cc_m1_fence_hole1 =  geomSize(cc_m1_fence_hole CSR_R_3 edges)   
 cc_m1_not1 =  geomAndNot(cc_m1 cc_m1_fence_hole1)  
 cc_m1_not1_not1 =  geomAndNot(cc_m1_not1 geomButtOrOver(cc_m1_not1 sealring ))   
 cc_m1_e = geomWidth(  cc_m1_not1_not1 keep > 0.8   )   
 cc_m1_g = geomGetEdge(cc_m1_e coincident check_csr_m1)   
 cc_m1_g_sz1 = geomSize(cc_m1_g 0.005 edges)
 cc_m1_fence_cross = geomAndNot( cc_m1_e geomButtOrCoin( cc_m1_e cc_m1_g_sz1 ))   
 cc_m2 = geomAnd(m2x csrdmy)  
 cc_v2 = geomAnd(via23i csrdmy)  
if((LmarkSealringCorner == 1) then
 cc_m2_sz1 =  geomWidth(  cc_m2 keep > 1.2   )  /*  filter non-check metal */ 
cc_m2_sz1_out1 = geomHoles(cc_m2_sz1  )
 cc_m2_hole = cc_m2_sz1_out1  /*  filter non-check metal */
else;
cc_m2_out1 = geomHoles(cc_m2  )
 cc_m2_hole = cc_m2_out1  
) ; 
