 poly_edge_45l = geomGetLength( poly_edge_45  keep >= PO_W_4_L )   
/*  PO.W.1_1.0V_1.2V_1.5V is checked by PO.W.3 */
/*  PO.W.2_1.0V_1.2V_1.5V is checked by PO.W.3 */
if((HIGH_VOLTAGE == 2.5) then
 drc( hv_pgate_w   width < PO_W_1_25V  
	"PO.W.1_2.5V  Channel length of 2.5V PMOS >= ^PO_W_1_25V um ")  
 drc( hv_ngate_w   width < PO_W_2_25V  
	"PO.W.2_2.5V  Channel length of 2.5V NMOS >= ^PO_W_2_25V um ")  
) ; 
if((HIGH_VOLTAGE == 3.3) then
 drc( hv_pgate_w   width < PO_W_1_33V  
	"PO.W.1_3.3V  Channel length of 3.3V PMOS >= ^PO_W_1_33V um ")  
 drc( hv_ngate_w   width < PO_W_2_33V  
	"PO.W.2_3.3V  Channel length of 3.3V NMOS >= ^PO_W_2_33V um ")  
) ; 
 drc( poly   width < PO_W_3  withCornerTouch 
	"PO.W.3  Width >= ^PO_W_3 um ")  
 drc( poly_edge_45l   width < PO_W_4  
	"PO.W.4  Width of 45 degree FIELD PO [with length >= 0.39 um] >= ^PO_W_4 um ")  
 drc( poly   sepNotch < PO_S_1  
	"PO.S.1  Space >= ^PO_S_1 um ")  
 drc( lv_gate   sepNotch < PO_S_2  
	"PO.S.2  GATE space in same OD >= ^PO_S_2 um ")  
 drc( hv_gate_w  0 <  sepNotch < PO_S_3  
	"PO.S.3  {GATE inside OD2} space in the same OD >= ^PO_S_3 um  ")  
 drc( hv_gate  0 <  sepNotch < PO_S_3 cornerToCorner 
	"PO.S.3 2  {GATE inside OD2} space in the same OD >= ^PO_S_3 um  ")  
 drc( poly od  sep < PO_S_4  shielded withIntersection withSingularPoint 
	"PO.S.4  FIELD PO space to OD >= ^PO_S_4 um ")  
if((HALF_NODE == 1) then
 pos5_x = geomSize(poly_edge_45 PO_S_5 edges)   
