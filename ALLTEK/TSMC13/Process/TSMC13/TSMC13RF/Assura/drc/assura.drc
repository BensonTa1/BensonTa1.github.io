 pact_real_iact11 =  geomAndNot(pact_real_iact1 geomOutside(pact_real_iact1 beside_post_driver ))   
 beside_post_driver_pmos = geomAndNot(pact_real_iact11 post_driver_pmos)  
/*  For LUP.3/LUP.5 - Wide GuardRing */
/* ==================================== */
 post_driver_nact2 =  geomOr(post_driver_nact beside_post_driver_nmos)  
 ptap_guard_ring_holex = geomEnclose( ptap_guard_ring_hole post_driver_nact2  )   
