            am4dn3_m4_den2_pc = calculate( area(am4dn3_m4) / area(chip))
            am4dn3_m4_den2 = output( am4dn3_m4_den2_pc squareSize = 100 0 <=  keep < 0.15)
        ); end measure
); end processCoverage
  err_m4_d0 = am4dn3_m4_den2  
 m5dn3_m5cell = geomAnd(m5dn3_m5cellin m5dn3_m5cellout)  
 m5dn3_m5marker = geomAnd(metal5i rrulerecommended)  
 m5dn3_m5cell_or1 =  geomOr(m5dn3_m5cell m5dn3_m5marker)  
 m5dn3_m5 = geomAndNot(m5dn3_m5cell_or1 block)  
 dm5dn3_m5cell = geomAnd(dm5dn3_m5cellin dm5dn3_m5cellout)  
 dm5dn3_m5marker = geomAnd(dum5 rrulerecommended)  
 dm5dn3_m5cell1 =  geomOr(dm5dn3_m5cell dm5dn3_m5marker)  
 dm5dn3_m5 = geomAndNot(dm5dn3_m5cell1 block)  
 am5dn3_m5 = geomOr(m5dn3_m5 dm5dn3_m5)  

processCoverage(
	backup
         
        measure( 
             windowSize = 100 stepSize = 50
            am5dn3_m5_den2_pc = calculate( area(am5dn3_m5) / area(chip))
            am5dn3_m5_den2 = output( am5dn3_m5_den2_pc squareSize = 100 0 <=  keep < 0.15)
        ); end measure
); end processCoverage
  err_m5_d0 = am5dn3_m5_den2  
 m6dn3_m6cell = geomAnd(m6dn3_m6cellin m6dn3_m6cellout)  
 m6dn3_m6marker = geomAnd(metal6i rrulerecommended)  
 m6dn3_m6cell_or1 =  geomOr(m6dn3_m6cell m6dn3_m6marker)  
 m6dn3_m6 = geomAndNot(m6dn3_m6cell_or1 block)  
 dm6dn3_m6cell = geomAnd(dm6dn3_m6cellin dm6dn3_m6cellout)  
 dm6dn3_m6marker = geomAnd(dum6 rrulerecommended)  
 dm6dn3_m6cell1 =  geomOr(dm6dn3_m6cell dm6dn3_m6marker)  
 dm6dn3_m6 = geomAndNot(dm6dn3_m6cell1 block)  
 am6dn3_m6 = geomOr(m6dn3_m6 dm6dn3_m6)  

processCoverage(
	backup
         
        measure( 
             windowSize = 100 stepSize = 50
            am6dn3_m6_den2_pc = calculate( area(am6dn3_m6) / area(chip))
            am6dn3_m6_den2 = output( am6dn3_m6_den2_pc squareSize = 100 0 <=  keep < 0.15)
        ); end measure
); end processCoverage
  err_m6_d0 = am6dn3_m6_den2  
 m7dn3_m7cell = geomAnd(m7dn3_m7cellin m7dn3_m7cellout)  
 m7dn3_m7marker = geomAnd(metal7i rrulerecommended)  
 m7dn3_m7cell_or1 =  geomOr(m7dn3_m7cell m7dn3_m7marker)  
 m7dn3_m7 = geomAndNot(m7dn3_m7cell_or1 block)  
 dm7dn3_m7cell = geomAnd(dm7dn3_m7cellin dm7dn3_m7cellout)  
 dm7dn3_m7marker = geomAnd(dum7 rrulerecommended)  
 dm7dn3_m7cell1 =  geomOr(dm7dn3_m7cell dm7dn3_m7marker)  
 dm7dn3_m7 = geomAndNot(dm7dn3_m7cell1 block)  
 am7dn3_m7 = geomOr(m7dn3_m7 dm7dn3_m7)  

processCoverage(
	backup
         
        measure( 
             windowSize = 100 stepSize = 50
            am7dn3_m7_den2_pc = calculate( area(am7dn3_m7) / area(chip))
            am7dn3_m7_den2 = output( am7dn3_m7_den2_pc squareSize = 100 0 <=  keep < 0.15)
        ); end measure
); end processCoverage
  err_m7_d0 = am7dn3_m7_den2  
/* 3 consecutive		     */
if((_M1DN3_ == 1) then
 err_m1_d0_and1 =  geomAnd(err_m1_d0 err_m2_d0)  
 rr_re_m1dn3_x = geomAnd(err_m1_d0_and1 err_m3_d0)  
 x_not1 =  geomAndNot(rr_re_m1dn3_x metal_den_exc)  
 drc( x_not1  area >= 2500 
	"RR:RE:M1DN3 2  3 consecutive metal layer(M1,M2,M3) over any 100umx100um window step 50um must >= 15% ") 
) ; /*  _M1DN3_ */
if((_M2DN3_ == 1) then
 err_m2_d0_and1 =  geomAnd(err_m2_d0 err_m3_d0)  
 rr_re_m2dn3_x = geomAnd(err_m2_d0_and1 err_m4_d0)  
 x_not2 =  geomAndNot(rr_re_m2dn3_x metal_den_exc)  
 drc( x_not2  area >= 2500 
	"RR:RE:M2DN3 2  3 consecutive metal layer(M2,M3,M4) over any 100umx100um window step 50um must >= 15% ") 
) ; /*  _M2DN3_ */
if((_M3DN3_ == 1) then
 err_m3_d0_and1 =  geomAnd(err_m3_d0 err_m4_d0)  
 rr_re_m3dn3_x = geomAnd(err_m3_d0_and1 err_m5_d0)  
 x_not3 =  geomAndNot(rr_re_m3dn3_x metal_den_exc)  
 drc( x_not3  area >= 2500 
	"RR:RE:M3DN3 2  3 consecutive metal layer(M3,M4,M5) over any 100umx100um window step 50um must >= 15% ") 
) ; /*  _M3DN3_ */
if((_M4DN3_ == 1) then
 err_m4_d0_and1 =  geomAnd(err_m4_d0 err_m5_d0)  
 rr_re_m4dn3_x = geomAnd(err_m4_d0_and1 err_m6_d0)  
 x_not4 =  geomAndNot(rr_re_m4dn3_x metal_den_exc)  
 drc( x_not4  area >= 2500 
	"RR:RE:M4DN3 2  3 consecutive metal layer(M4,M5,M6) over any 100umx100um window step 50um must >= 15% ") 
) ; /*  _M4DN3_ */
if((UTM == 0) then
if((_M5DN3_ == 1) then
 err_m5_d0_and1 =  geomAnd(err_m5_d0 err_m6_d0)  
 rr_re_m5dn3_x = geomAnd(err_m5_d0_and1 err_m7_d0)  
 x_not5 =  geomAndNot(rr_re_m5dn3_x metal_den_exc)  
 drc( x_not5  area >= 2500 
	"RR:RE:M5DN3 2  3 consecutive metal layer(M5,M6,M7) over any 100umx100um window step 50um must >= 15% ") 
) ; /*  _M5DN3_ */
) ; /* UTM */
if((UTM == 1) then
if((_M7W2_ == 1) then
 m7w2_m7cell = geomAnd(m7w2_m7cellin m7w2_m7cellout)  
 m7w2_m7marker = geomAnd(metal7i rrulerecommended)  
 m7w2_m7cell_or1 =  geomOr(m7w2_m7cell m7w2_m7marker)  
 m7w2_m7 = geomAndNot(m7w2_m7cell_or1 block)  
 rrarm7w2 = geomOr(m6 dum6)  
 rrarm7w2_sz1 =  geomSize( geomSize( rrarm7w2  (5 *1.0/2-0.001 ) ) -(5 *1.0/2-0.001 ))   
 m7w2_ext = geomAndNot(chip rrarm7w2_sz1)  
 m7w2_ext_sz1 =  geomWidth(  m7w2_ext keep > 5-2*0.001    )   
 m7w2_big = geomSize( m7w2_ext_sz1 1.0 noClipAcute )   
m7w2_check_1 = geomAndNot( m7w2_m7 geomGetEdge( m7w2_m7 outside m7w2_big))
  m7w2_check_2 = geomAndNot( m7w2_check_1  geomGetCorner( m7w2_m7 keep > 270 ) )
  m7w2_check = geomAndNot( m7w2_check_2  geomGetCorner( m7w2_m7 keep < 90 ) )
  m7w2_1 = drc( m7w2_check width < 0.42 )
  m7w2_2 = geomStretchCorner(geomGetCorner( m7w2_m7 keep < 90 ) 0.42 angleAll)
 
 errorLayer( geomAndNot( m7w2_1 m7w2_2)
	"RR:RE:M7W2  Recommended M7 width on (M6 OR DM6 with space>= 5x5 sizing 1) >= 0.42 ")  
) ; /*  _M7W2_ */
) ; /* UTM */
if((_M8W2_ == 1) then
 m8w2_m8cell = geomAnd(m8w2_m8cellin m8w2_m8cellout)  
 m8w2_m8marker = geomAnd(metal8i rrulerecommended)  
 m8w2_m8cell_or1 =  geomOr(m8w2_m8cell m8w2_m8marker)  
 m8w2_m8 = geomAndNot(m8w2_m8cell_or1 block)  
 rrarm8w2 = geomOr(m7 dum7)  
 rrarm8w2_sz1 =  geomSize( geomSize( rrarm8w2  (5 *1.0/2-0.001 ) ) -(5 *1.0/2-0.001 ))   
 m8w2_ext = geomAndNot(chip rrarm8w2_sz1)  
 m8w2_ext_sz1 =  geomWidth(  m8w2_ext keep > 5-2*0.001    )   
 m8w2_big = geomSize( m8w2_ext_sz1 1.0 noClipAcute )   
 m8w2_check = geomAndNot(m8w2_m8 geomGetEdge(m8w2_m8 outside m8w2_big))   
 drc( m8w2_check   width < 0.42  
	"RR:RE:M8W2  Recommended M8 width on (M7 OR DM7 with space>= 5x5 sizing 1) >= 0.42 ")  
) ; /*  _M8W2_ */
if((_MDW2_ == 1) then
 mdw2_mdcell = geomAnd(mdw2_mdcellin mdw2_mdcellout)  
 mdw2_mdmarker = geomAnd(mdi rrulerecommended)  
 mdw2_mdcell_or1 =  geomOr(mdw2_mdcell mdw2_mdmarker)  
 mdw2_md = geomAndNot(mdw2_mdcell_or1 block)  
 rrarmdw2 = geomOr(m8 dum8)  
 rrarmdw2_sz1 =  geomSize( geomSize( rrarmdw2  (5 *1.0/2-0.001 ) ) -(5 *1.0/2-0.001 ))   
 mdw2_ext = geomAndNot(chip rrarmdw2_sz1)  
 mdw2_ext_sz1 =  geomWidth(  mdw2_ext keep > 5-2*0.001    )   
 mdw2_big = geomSize( mdw2_ext_sz1 1.0 noClipAcute )   
 mdw2_check = geomAndNot(mdw2_md geomGetEdge(mdw2_md outside mdw2_big))   
 drc( mdw2_check   width < 0.42  
	"RR:RE:MDW2  Recommended MD width on (M8 OR DM8 with space>= 5x5 sizing 1) >= 0.42 ")  
) ; /*  _MDW2_ */
) ; /*  Recommended */
if((Analog == 1) then
if((_POEX1m_ == 1) then
 poex1m_pocell = geomAnd(poex1m_pocellin poex1m_pocellout)  
 poex1m_pomarker = geomAnd(polygi rruleanalog)  
 poex1m_pocell1 =  geomOr(poex1m_pocell poex1m_pomarker)  
 poex1m_pocell11 =  geomAndNot(poex1m_pocell1 sram_exclude)  
 poex1m_po = geomOutside( poex1m_pocell11 block  )   
 drc( poex1m_po od  enc < 0.20  opposite shielded withIntersection 
	"RR:AN:POEX1m  Recommended PO extension on OD >= 0.20 ")  
) ; /*  _POEX1m_ */
if((_POS4m_ == 1) then
 pos4m_pocell = geomAnd(pos4m_pocellin pos4m_pocellout)  
 pos4m_pomarker = geomAnd(polygi rruleanalog)  
 pos4m_pocell_or1 =  geomOr(pos4m_pocell pos4m_pomarker)  
 pos4m_pocell_or11 =  geomAndNot(pos4m_pocell_or1 sram_exclude)  
 pos4m_po = geomOutside( pos4m_pocell_or11 block  )   
 pos4m_gate = geomAnd(pos4m_po odi)  
 longgatel = geomGetEdge(gate_l coincident pos4m_gate)   
 longgatelexp = geomSize(geomStretch( longgatel PO_S_1) -GRID edges)   
 longgatelexe = geomGetEdge(odi coincident longgatelexp)   
 drc( longgatelexe pos4m_po  sep < 0.12  opposite withIntersection 
	"RR:AN:POS4m:LPO  L-PO space to OD >= 0.12um ")  
 longgatew = geomGetEdge(gate_w coincident pos4m_gate)   
 longgatewexp = geomSize(geomStretch( longgatew OD_S_1) -GRID edges)   
 longgatewexe = geomGetEdge(pos4m_po coincident longgatewexp)   
 drc( longgatewexe odi  sep < 0.12  opposite withIntersection 
	"RR:AN:POS4m:LOD  L-OD space to PO >= 0.12um ")  
) ; /*  _POS4m_ */
 bjtr_pp_emod = geomAnd(pact bjtdmy)  
 bjtr_np_emod = geomAnd(nact bjtdmy)  
 bjtr_emod = geomOr(bjtr_pp_emod bjtr_np_emod)  
if((_BJTR2R_ == 1) then
 bjtr2r_x = geomAndNot( bjtr_emod geomContactCheck( bjtr_emod length == BJT_R_2R_A width == BJT_R_2R_A swap allWithTolerance=1.0) )  
 bjtr2r1_y = geomAndNot( bjtr2r_x geomContactCheck( bjtr2r_x length == BJT_R_2R_B width == BJT_R_2R_B swap allWithTolerance=1.0) )  
 errorLayer( geomAndNot( bjtr2r1_y geomContactCheck( bjtr2r1_y length == BJT_R_2R_C width == BJT_R_2R_C swap allWithTolerance=1.0) )
	"BJT.R.2R  OD( Emitter size ) is ^BJT_R_2R_A x ^BJT_R_2R_A, ^BJT_R_2R_B x ^BJT_R_2R_B, ^BJT_R_2R_C x ^BJT_R_2R_C  ")  
) ; /*  _BJTR2R_ */
if((_BJTR3R_ == 1) then
 bjtr3r_x = geomSize( bjtr_pp_emod BJT_R_3R noClipAcute )   
 bjtr3r1_y = geomButtOrOver( nwel bjtr_pp_emod  )   
 errorLayer( geomXor(bjtr3r_x bjtr3r1_y) 
	"BJT.R.3R  NW enclosure of P+OD ( Emitter OD ) for PNP == ^BJT_R_3R ") 
) ; /*  _BJTR3R_ */
 bjt_nw = geomAnd(nwel bjtdmy)  
 bjt_dnw = geomAnd(dnw bjtdmy)  
 bjt_rw = geomAndNot(bjt_dnw bjt_nw)  
if((_BJTR4R_ == 1) then
 bjtr4r_x = geomSize( bjtr_np_emod BJT_R_4R noClipAcute )   
 bjtr4r1_y = geomButtOrOver( bjt_rw bjtr_np_emod  )   
 errorLayer( geomAndNot(bjtr4r_x bjtr4r1_y) 
	"BJT.R.4R  NW space to N+OD ( Emitter OD ) for NPN == ^BJT_R_4R ") /*  min. check  */
/*  max. check : DRC un-checkable.   */
) ; /*  _BJTR4R_ */
if((_BJTR5R_ == 1) then
 drc( bjt_nw bjt_dnw  enc < BJT_R_5R  shielded withIntersection withSingularPoint 
	"BJT.R.5R  NW enclosure of DNW for NPN >= ^BJT_R_5R ")  
) ; /*  _BJTR5R_ */
if((_BJTR6R_ == 1) then
 bjtr6r_x = geomSize( bjt_rw BJT_R_6R noClipAcute )   
 errorLayer( geomAndNot(bjtr6r_x bjt_dnw) 
	"BJT.R.6R  DNW enclosure of PW for NPN ( three side ) = ^BJT_R_6R ") 
 bjtr6r1_y = geomXor(bjtr6r_x bjt_dnw)  
 nstp_and1 =  geomAnd(nstp bjtdmy)  
 errorLayer( geomAndNot(bjtr6r1_y geomButtOrOver(bjtr6r1_y nstp_and1 )) 
	"BJT.R.6R 2  DNW enclosure of PW for NPN ( three side ) = ^BJT_R_6R ")  
) ; /*  _BJTR6R_ */
if((_BJTR7R_ == 1) then
 errorLayer( geomAnd(bjtdmy ntn) 
	"BJT.R.7R  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy poly) 
	"BJT.R.7R 2  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy vthn) 
	"BJT.R.7R 3  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy vthp) 
	"BJT.R.7R 4  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy vtln) 
	"BJT.R.7R 5  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy vtlp) 
	"BJT.R.7R 6  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy rhdmy) 
	"BJT.R.7R 7  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy vardmy) 
	"BJT.R.7R 8  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
 errorLayer( geomAnd(bjtdmy dmsrmi) 
	"BJT.R.7R 9  BJTDMY overlap of NT_N, PO, VTH_N, VTH_P, VTL_N, VTL_P, RH, VAR and SRM is not recommended ") 
) ; /*  _BJTR7R_ */
if((_RES5m_ == 1) then
 res5m_odcell = geomAnd(res5m_odcellin res5m_odcellout)  
 res5m_odmarker = geomAnd(odi rruleanalog)  
 res5m_odcell_or1 =  geomOr(res5m_odcell res5m_odmarker)  
 res5m_odcell_or11 =  geomAndNot(res5m_odcell_or1 sram_exclude)  
 res5m_od = geomOutside( res5m_odcell_or11 block  )   
 res5m_od_out1 =  geomOutside( res5m_od nwdmy  )  /*  field oxide */ 
 res5m_od_out11 =  geomAndNot(res5m_od_out1 gate)  /*  field oxide */
 res5m_od_out111 =  geomOutside( res5m_od_out11 bjtdmy  )  /*  field oxide */ 
 res5m_fod = geomOutside( res5m_od_out111 inddmy  )  /*  field oxide */ 
 res5m_odres = geomAnd(res5m_fod rpo_rpdmy_usram)  
rr_an_res5m_od_odr_trm = geomSizeAnd( res5m_odres od OD_S_1* 0.7 RPO_S_3 )  
 errorLayer( geomAndNot(rr_an_res5m_od_odr_trm geomButtOrOver(rr_an_res5m_od_odr_trm co )) 
	"RR:AN:RES5m:OD  CO space to unsilicided OD resistor should be equal to 0.22um (RPO_S_3) ")  
 res5m_pocell = geomAnd(res5m_pocellin res5m_pocellout)  
 res5m_pomarker = geomAnd(polygi rruleanalog)  
 res5m_pocell_or1 =  geomOr(res5m_pocell res5m_pomarker)  
 res5m_pocell_or11 =  geomAndNot(res5m_pocell_or1 sram_exclude)  
 res5m_po = geomOutside( res5m_pocell_or11 block  )   
 res5m_fpo1 = geomAndNot(res5m_po odi)  /*  Field poly */
 res5m_fpo1_and1 =  geomAnd(res5m_fpo1 rpo_rpdmy_usram)  /*  POLY resistor region */
 res5m_fpo1_and11 =  geomOutside( res5m_fpo1_and1 bjtdmy  )  /*  POLY resistor region */ 
 res5m_pores = geomOutside( res5m_fpo1_and11 inddmy  )  /*  POLY resistor region */ 
 res5m_poresg = geomAndNot(pores geomButtOrOver(pores sdi ))   
rr_an_res5m_po_por_trm = geomSizeAnd( res5m_poresg poly PO_S_1* 0.7 RPO_S_3 )  
 errorLayer( geomAndNot(rr_an_res5m_po_por_trm geomButtOrOver(rr_an_res5m_po_por_trm co )) 
	"RR:AN:RES5m:PO  CO space to unsilicided PO resistor should be equal to 0.22um (RPO_S_3) ")  
) ; /*  _BJTR8R_ */
if((_ANR17mg_ == 1) then
 anr17mg_pocell = geomAnd(anr17mg_pocellin anr17mg_pocellout)  
 anr17mg_pomarker = geomAnd(polygi rruleanalog)  
 anr17mg_pocell1 =  geomOr(anr17mg_pocell anr17mg_pomarker)  
 anr17mg_pocell11 =  geomAndNot(anr17mg_pocell1 sram_exclude)  
 anr17mg_po = geomOutside( anr17mg_pocell11 block  )   
 anr17mg_pores = geomAnd(anr17mg_po pores)  
 errorLayer( geomAndNot(anr17mg_pores nwel) 
	"RR:AN:ANR17mg  PO resistor on NW for better noise immunity; P+ PO resistor is recommended ") 
 errorLayer( geomAndNot(anr17mg_pores geomButtOrOver(anr17mg_pores pp )) 
	"RR:AN:ANR17mg 2  PO resistor on NW for better noise immunity; P+ PO resistor is recommended ")  
) ; /*  _ANR17mg_ */
if((_ANR19mg_ == 1) then
 anr19mg_varcell = geomAnd(anr19mg_varcellin anr19mg_varcellout)  
 anr19mg_varmarker = geomAnd(vardmy rruleanalog)  
 anr19mg_varcell1 =  geomOr(anr19mg_varcell anr19mg_varmarker)  
 anr19mg_var = geomAndNot(anr19mg_varcell1 block)  
 anr19mg_varod = geomAnd(anr19mg_var od)  
 errorLayer( geomAndNot(anr19mg_varod od2) 
	"RR:AN:ANR19mg  Use OD2 MOS varactor is recommended. ") 
) ; /*  _ANR19mg_ */
) ; /*  Analog */
) ; /*  DFM */

)
