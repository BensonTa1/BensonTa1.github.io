 poly_iact1 =  geomButtOrOver( poly co  )   
 dummy_mos = geomAndNot(mos_not1 geomButtOrOver(mos_not1 poly_iact1 ))   
 dact_not1 =  geomAndNot(dact geomButtOrOver(dact poly ))   
 dummy_diode = geomAndNot(dact_not1 geomButtOrOver(dact_not1 co ))   
