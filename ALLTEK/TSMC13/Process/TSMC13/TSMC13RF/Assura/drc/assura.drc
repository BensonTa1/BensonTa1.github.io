 odr1_butt_edge = geomGetEdge(sd butting dstp)   
 odr11_butt_long_edge = geomGetLength( odr1_butt_edge  keep >= OD_R_1_W )   
 butt_edge_exp1 =  geomSize(geomStretch( odr1_butt_edge 0.005) -0.005 edges)   
 odr12_butt_exp = geomAnd(butt_edge_exp1 sd)  
 odr11_butt_long_edge1 = geomSize(odr11_butt_long_edge 0.005 edges)
 odr13_butt_exp_short = geomAndNot( odr12_butt_exp geomButtOrCoin( odr12_butt_exp odr11_butt_long_edge1 ))   
 odr14_check_sd = geomButtOrOver( sd odr13_butt_exp_short  )   
