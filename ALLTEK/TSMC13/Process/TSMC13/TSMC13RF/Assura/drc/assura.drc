 errorLayer( geomAndNot(poly_enc1 geomInside(poly_enc1 logo )) 
	"PO.EX.2  OD extension on PO >= ^PO_EX_2 um ")  
 drc( poly  area < PO_A_1 
	"PO.A.1  Area>= ^PO_A_1 um2 ") 
PO_A_2pre = ( ( PO_A_2 + ( PO_S_1 * PO_S_1 * 3.142 ) ) / ( 2 * PO_S_1 ) ) * ( ( PO_A_2 + ( PO_S_1 * PO_S_1 * 3.142 ) ) / ( 2 * PO_S_1 ) ) / 3.141
poly_out1 = geomHoles(poly innermost area < PO_A_2pre)
 poa2_a = poly_out1  
