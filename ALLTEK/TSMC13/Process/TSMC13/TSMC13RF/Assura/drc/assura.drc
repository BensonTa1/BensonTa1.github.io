	"DM7.S.6  Space to LOGO >= 0.0(or 0.0 if switch HALF_NODE is activated) um ") 
 drc( inddmy dum7  sep < DM7_S_7  shielded withIntersection withSingularPoint 
	"DM7.S.7  Space to INDDMY >= 2.5(or 2.75 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(inddmy dum7) 
	"DM7.S.7 2  Space to INDDMY >= 2.5(or 2.75 if switch HALF_NODE is activated) um ") 
if((FULL_CHIP == 1) then
 chip_chamfered7 =  geomSize( chip_chamfered -DM7_EN_1 noClipAcute )   
 errorLayer( geomAndNot(dum7 chip_chamfered7) 
	"DM7.EN.1  Enclosure by chip edge >= 2.5(or 2.50 if switch HALF_NODE is activated) um ") 
) ; 
/*  Metal density rules are implemented in M7 section */
if((FULL_CHIP == 1) then
 errorLayer( geomAndNot(chip_chamfered geomButtOrOver(chip_chamfered dum7 )) 
	"DM7.R.1  DMx is required. The DMx CAD layer (TSMC default, 37;1 for DM7) must be different from the Mx CAD layers. ")  
) ; 
/*  DM7.R.2 is checked by CSR.R.1 */
dum7_out1 = geomHoles(dum7  )
 errorLayer( dum7_out1 
	"DM7.R.3  The only shapes allowed are square (or rectangle) and solid ") 
 errorLayer( geomAndNot( dum7 geomGetRectangle( dum7   swap ) )
	"DM7.R.3 2  The only shapes allowed are square (or rectangle) and solid ")  
 drc( dum8   width < DM8_W_1  withCornerTouch 
	"DM8.W.1  Width >= 0.80 um ")  
 errorLayer( geomWidth(  dum8 keep > DM8_W_2   ) 
	"DM8.W.2  Width (by sizing down 3.0/2 um) <= 3.0 um ")  
 drc( dum8   sepNotch < DM8_S_1  
	"DM8.S.1  Space >= 0.80 um ")  
 drc( m8x dum8  sep < DM8_S_2  shielded withIntersection withSingularPoint 
	"DM8.S.2  Space to M8 [overlap is not allowed] >= 0.60 um ")  
 errorLayer( geomAnd(m8x dum8) 
	"DM8.S.2 2  Space to M8 [overlap is not allowed] >= 0.60 um ") 
 drc( dum8  area < DM8_A_1 
	"DM8.A.1  Area (minimum) >= 0.80(or 0.965 if switch HALF_NODE is activated) um2 ") 
 drc( dum8  area > DM8_A_2 
	"DM8.A.2  Area (maximum) <= 160.0(or 193.6 if switch HALF_NODE is activated) um2 ") 
 drc( fwi dum8  sep < DM8_S_3  shielded withIntersection withSingularPoint parallel 
	"DM8.S.3  Space to FW >= 5.0(or 5.50 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(fwi dum8) 
	"DM8.S.3 2  Space to FW >= 5.0(or 5.50 if switch HALF_NODE is activated) um ") 
 drc( lmark dum8  sep < DM8_S_4  shielded withIntersection withSingularPoint 
	"DM8.S.4  Space to LMARK >= 5.0(or 5.50 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(lmark dum8) 
	"DM8.S.4 2  Space to LMARK >= 5.0(or 5.50 if switch HALF_NODE is activated) um ") 
 errorLayer( geomAnd(logo dum8) 
	"DM8.S.6  Space to LOGO >= 0.0(or 0.0 if switch HALF_NODE is activated) um ") 
 drc( inddmy dum8  sep < DM8_S_7  shielded withIntersection withSingularPoint 
	"DM8.S.7  Space to INDDMY >= 2.5(or 2.75 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(inddmy dum8) 
	"DM8.S.7 2  Space to INDDMY >= 2.5(or 2.75 if switch HALF_NODE is activated) um ") 
if((FULL_CHIP == 1) then
 chip_chamfered8 =  geomSize( chip_chamfered -DM8_EN_1 noClipAcute )   
 errorLayer( geomAndNot(dum8 chip_chamfered8) 
	"DM8.EN.1  Enclosure by chip edge >= 2.5(or 2.5 if switch HALF_NODE is activated) um ") 
) ; 
/*  Metal density rules are implemented in M8 section */
if((FULL_CHIP == 1) then
 errorLayer( geomAndNot(chip_chamfered geomButtOrOver(chip_chamfered dum8 )) 
	"DM8.R.1  DMx is required. The DMx CAD layer (TSMC default, 38;1 for DM8) must be different from the Mx CAD layers. ")  
) ; 
/*  DM8.R.2 is checked by CSR.R.1 */
dum8_out1 = geomHoles(dum8  )
 errorLayer( dum8_out1 
	"DM8.R.3  The only shapes allowed are square (or rectangle) and solid ") 
 errorLayer( geomAndNot( dum8 geomGetRectangle( dum8   swap ) )
	"DM8.R.3 2  The only shapes allowed are square (or rectangle) and solid ")  
 drc( dumd   width < DMD_W_1  withCornerTouch 
	"DMD.W.1  Width >= ^DMD_W_1 um ")  
 errorLayer( geomWidth(  dumd keep > DMD_W_2   ) 
	"DMD.W.2  Width (by sizing down ^DMD_W_2/2 um) <= ^DMD_W_2 um ")  
 drc( dumd   sepNotch < DMD_S_1  
	"DMD.S.1  Space >= ^DMD_S_1 um ")  
 drc( mdx dumd  sep < DMD_S_2  shielded withIntersection withSingularPoint 
	"DMD.S.2  Space to MD [overlap is not allowed] >= ^DMD_S_2 um ")  
 errorLayer( geomAnd(mdx dumd) 
	"DMD.S.2 2  Space to MD [overlap is not allowed] >= ^DMD_S_2 um ") 
 drc( dumd  area < DMD_A_1 
	"DMD.A.1  Area (minimum) >= ^DMD_A_1 um2 ") 
 drc( dumd  area > DMD_A_2 
	"DMD.A.2  Area (maximum) <= ^DMD_A_2 um2 ") 
 drc( fwi dumd  sep < DMD_S_3  shielded withIntersection withSingularPoint 
	"DMD.S.3  Space to FW >= ^DMD_S_3 um ")  
 errorLayer( geomAnd(fwi dumd) 
	"DMD.S.3 2  Space to FW >= ^DMD_S_3 um ") 
 drc( lmark dumd  sep < DMD_S_4  shielded withIntersection withSingularPoint 
	"DMD.S.4  Space to LMARK >= ^DMD_S_4 um ")  
 errorLayer( geomAnd(lmark dumd) 
	"DMD.S.4 2  Space to LMARK >= ^DMD_S_4 um ") 
 errorLayer( geomAnd(logo dumd) 
	"DMD.S.6  Space to LOGO >= ^DMD_S_6 um ") 
 drc( inddmy dumd  sep < DMD_S_7  shielded withIntersection withSingularPoint 
	"DMD.S.7  Space to INDDMY >= ^DMD_S_7 um ")  
 errorLayer( geomAnd(inddmy dumd) 
	"DMD.S.7 2  Space to INDDMY >= ^DMD_S_7 um ") 
if((FULL_CHIP == 1) then
 chip_chamfered9 =  geomSize( chip_chamfered -DMD_EN_1 noClipAcute )   
 errorLayer( geomAndNot(dumd chip_chamfered9) 
	"DMD.EN.1  Enclosure by chip edge >= ^DMD_EN_1 um ") 
) ; 
/*  Metal density rules are implemented in MD section */
if((FULL_CHIP == 1) then
 chip_chamfered10 =  geomButtOrOver( chip_chamfered mdx  )   
 errorLayer( geomAndNot(chip_chamfered10 geomButtOrOver(chip_chamfered10 dumd )) 
	"DMD.R.1  DMD is required. The DMD CAD layer (TSMC default, 168;1 for DMD) must be different from the MD CAD layers. ")  
) ; 
/*  DMD.R.2 is checked by CSR.R.1 */
dumd_out1 = geomHoles(dumd  )
 errorLayer( dumd_out1 
	"DMD.R.3  The only shapes allowed are square (or rectangle) and solid ") 
 errorLayer( geomAndNot( dumd geomGetRectangle( dumd   swap ) )
	"DMD.R.3 2  The only shapes allowed are square (or rectangle) and solid ")  
if((UTM == 1) then
 drc( cbm dum6  sep < DM6_S_8  shielded withIntersection withSingularPoint 
	"DM6.S.8  Space to CBM [CBM between M6 and M7][overlap is not allowed] >= 1.50(or 1.65 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(cbm dum6) 
	"DM6.S.8 2  Space to CBM [CBM between M6 and M7][overlap is not allowed] >= 1.50(or 1.65 if switch HALF_NODE is activated) um ") 
else;
 drc( cbm dum7  sep < DM7_S_8  shielded withIntersection withSingularPoint 
	"DM7.S.8  Space to CBM [CBM between M7 and M8][overlap is not allowed] >= 1.50(or 1.65 if switch HALF_NODE is activated) um ")  
 errorLayer( geomAnd(cbm dum7) 
	"DM7.S.8 2  Space to CBM [CBM between M7 and M8][overlap is not allowed] >= 1.50(or 1.65 if switch HALF_NODE is activated) um ") 
) ; 
) ; /*  BACK_END */
/* LOGO CHECKS */
/* ============ */
 logo_sz1 =  geomSize( logo LOGO_S_1 noClipAcute )   
 logos1_logo_outside = geomAndNot(logo_sz1 logo)  
 errorLayer( geomAnd(logos1_logo_outside odi) 
	"LOGO.S.1  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside polygi) 
	"LOGO.S.1 2  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m1x) 
	"LOGO.S.1 3  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m2x) 
	"LOGO.S.1 4  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m3x) 
	"LOGO.S.1 5  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m4x) 
	"LOGO.S.1 6  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m5x) 
	"LOGO.S.1 7  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m6x) 
	"LOGO.S.1 8  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m7x) 
	"LOGO.S.1 9  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside m8x) 
	"LOGO.S.1 10  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(logos1_logo_outside mdx) 
	"LOGO.S.1 11  Space to real OD/PO/Metal >= ^LOGO_S_1 um ") 
 errorLayer( geomAnd(excli logo) 
	"LOGO.R.1  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(padi logo) 
	"LOGO.R.1 2  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") /*  CB */
 errorLayer( geomAnd(cbdi logo) 
	"LOGO.R.1 3  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(fwi logo) 
	"LOGO.R.1 4  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(ubmi logo) 
	"LOGO.R.1 5  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dod logo) 
	"LOGO.R.1 6  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dpo logo) 
	"LOGO.R.1 7  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum1 logo) 
	"LOGO.R.1 8  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum2 logo) 
	"LOGO.R.1 9  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum3 logo) 
	"LOGO.R.1 10  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum4 logo) 
	"LOGO.R.1 11  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum5 logo) 
	"LOGO.R.1 12  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum6 logo) 
	"LOGO.R.1 13  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum7 logo) 
	"LOGO.R.1 14  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dum8 logo) 
	"LOGO.R.1 15  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
 errorLayer( geomAnd(dumd logo) 
	"LOGO.R.1 16  Overlap of EXCL, CB, CBD, FW, UBM, DOD, DPO, or DMx is not allowed. ") 
/*  LOGO.R.2 can not be checked by DRC */
/*  LOGO.R.3 is followed by OD.R.2, PO.EX.1, PO.EX.2, PO.EX.2R, PO.R.1, PO.R.3, PP.EN.1 and NP.EN.1 */
if((FRONT_END == 1) then
/* DUMMY OD RULE */
/* ================ */
 drc( dod   width < DOD_W_1  withCornerTouch 
	"DOD.W.1  Width >= ^DOD_W_1 um ")  
 drc( dod   sepNotch < DOD_S_1  
	"DOD.S.1  Space >= ^DOD_S_1 um ")  
 drc( odi dod  sep < DOD_S_2  shielded withIntersection withSingularPoint 
	"DOD.S.2  Space to OD [overlap is not allowed] >= ^DOD_S_2 um ")  
 errorLayer( geomAnd(odi dod) 
	"DOD.S.2 2  Space to OD [overlap is not allowed] >= ^DOD_S_2 um ") 
 drc( polygi dod  sep < DOD_S_3  shielded withIntersection withSingularPoint 
	"DOD.S.3  Space to PO [overlap is not allowed] >= ^DOD_S_3 um ")  
 errorLayer( geomAnd(polygi dod) 
	"DOD.S.3 2  Space to PO [overlap is not allowed] >= ^DOD_S_3 um ") 
 drc( nwelli dod  sep < DOD_S_5  shielded withIntersection withSingularPoint 
	"DOD.S.5  Space to NW [overlap is not allowed] >= ^DOD_S_5 um ")  
 drc( fwi dod  sep < DOD_S_6  shielded withIntersection withSingularPoint 
	"DOD.S.6  Space to FW [overlap is not allowed] >= ^DOD_S_6 um ")  
 errorLayer( geomAnd(fwi dod) 
	"DOD.S.6 2  Space to FW [overlap is not allowed] >= ^DOD_S_6 um ") 
 drc( lmark dod  sep < DOD_S_7  shielded withIntersection withSingularPoint 
	"DOD.S.7  Space to LMARK [overlap is not allowed] >= ^DOD_S_7 um ")  
 errorLayer( geomAnd(lmark dod) 
	"DOD.S.7 2  Space to LMARK [overlap is not allowed] >= ^DOD_S_7 um ") 
 drc( nwdmy dod  sep < DOD_S_8  shielded withIntersection withSingularPoint 
	"DOD.S.8  Space to NWDMY [overlap is not allowed] >= ^DOD_S_8 um ")  
 errorLayer( geomAnd(nwdmy dod) 
	"DOD.S.8 2  Space to NWDMY [overlap is not allowed] >= ^DOD_S_8 um ") 
 errorLayer( geomAnd(logo dod) 
	"DOD.S.9  Space to LOGO [overlap is not allowed] >= 0 um ") 
 drc( inddmy dod  sep < DOD_S_10  shielded withIntersection withSingularPoint 
	"DOD.S.10  Space to INDDMY [overlap is not allowed] >= ^DOD_S_10 um ")  
 errorLayer( geomAnd(inddmy dod) 
	"DOD.S.10 2  Space to INDDMY [overlap is not allowed] >= ^DOD_S_10 um ") 
 drc( nwelli dod  enc < DOD_EN_1  shielded withIntersection withSingularPoint 
	"DOD.EN.1  Enclosure by NW >= ^DOD_EN_1 um ")  
 errorLayer( geomStraddle(dod nwelli) 
	"DOD.EN.1  Enclosure by NW >= ^DOD_EN_1 um ") 
if((FULL_CHIP == 1) then
 chip_chamfered11 =  geomSize( chip_chamfered -DOD_EN_2 noClipAcute )   
 errorLayer( geomAndNot(dod chip_chamfered11) 
	"DOD.EN.2  Enclosuer by chip edge >= ^DOD_EN_2 um ") 
) ; 
/*  OD density rules are implemented in OD section */
if((FULL_CHIP == 1) then
 errorLayer( geomAndNot(chip_chamfered geomButtOrOver(chip_chamfered dod )) 
	"DOD.R.1  DOD is required.  The DOD CAD layer (TSMC default, 6:1)must be different from the OD CAD layer. ")  
/*  DOD.R.2 is checked by CSR.R.1 */
) ; 
dod_out1 = geomHoles(dod  )
 errorLayer( dod_out1 
	"DOD.R.3  The only shapes allowed are square(or rectangular) and solid ") 
 errorLayer( geomAndNot( dod geomGetRectangle( dod   swap ) )
	"DOD.R.3 2  The only shapes allowed are square(or rectangular) and solid ")  
/* DUMMY POLY RULE */
/* ================ */
 drc( dpo   width < DPO_W_1  withCornerTouch 
	"DPO.W.1  Width >= ^DPO_W_1 um ")  
 drc( dpo   sepNotch < DPO_S_1  
	"DPO.S.1  Space >= ^DPO_S_1 um ")  
 drc( odi dpo  sep < DPO_S_2  shielded withIntersection withSingularPoint 
	"DPO.S.2  Space to OD [overlap is not allowed] >= ^DPO_S_2 um ")  
 errorLayer( geomAnd(odi dpo) 
	"DPO.S.2 2  Space to OD [overlap is not allowed] >= ^DPO_S_2 um ") 
 drc( polygi dpo  sep < DPO_S_3  shielded withIntersection withSingularPoint 
	"DPO.S.3  Space to PO [overlap is not allowed] >= ^DPO_S_3 um ")  
 errorLayer( geomAnd(polygi dpo) 
	"DPO.S.3 2  Space to PO [overlap is not allowed] >= ^DPO_S_3 um ") 
 drc( fwi dpo  sep < DPO_S_5  shielded withIntersection withSingularPoint 
	"DPO.S.5  Space to FW [overlap is not allowed] >= ^DPO_S_5 um ")  
 errorLayer( geomAnd(fwi dpo) 
	"DPO.S.5 2  Space to FW [overlap is not allowed] >= ^DPO_S_5 um ") 
 drc( lmark dpo  sep < DPO_S_6  shielded withIntersection withSingularPoint 
	"DPO.S.6  Space to LMARK [overlap is not allowed] >= ^DPO_S_6 um ")  
 errorLayer( geomAnd(lmark dpo) 
	"DPO.S.6 2  Space to LMARK [overlap is not allowed] >= ^DPO_S_6 um ") 

  errorLayer( geomAnd(logo dpo) "DPO.S.7 Space to LOGO [overlap is not allowed] >= 0.0")


 drc( inddmy dpo  sep < DPO_S_8  shielded withIntersection withSingularPoint 
	"DPO.S.8  Space to INDDMY [overlap is not allowed] >= ^DPO_S_8 um  ")  
 errorLayer( geomAnd(inddmy dpo) 
	"DPO.S.8 2  Space to INDDMY [overlap is not allowed] >= ^DPO_S_8 um  ") 
if((HALF_NODE == 0) then
 drc( dpo dod  sep < DPO_S_9  shielded withIntersection withSingularPoint 
	"DPO.S.9  Space to DOD [overlap is not allowed] >= ^DPO_S_9 um  ")  
 errorLayer( geomAnd(dpo dod) 
	"DPO.S.9 2  Space to DOD [overlap is not allowed] >= ^DPO_S_9 um  ") 
) ; /* HALF_NODE */
if((FULL_CHIP == 1) then
 chip_chamfered12 =  geomSize( chip_chamfered -DPO_EN_1 noClipAcute )   
 errorLayer( geomAndNot(dpo chip_chamfered12) 
	"DPO.EN.1  Enclosure by chip edge >= ^DPO_EN_1 um ") 
) ; 
if((HALF_NODE == 0) then
 drc( dpo  area < DPO_A_1 
	"DPO.A.1  Area => ^DPO_A_1 um2 ") 
) ; /* HALF_NODE */
/*  PO.DN.1 and PO.DN.2 density rule is implemented in PO section */
if((FULL_CHIP == 1) then
 po_density_and1 =  geomAnd(po_density chipx)  
 errorLayer( geomAndNot(po_density_and1 geomButtOrOver(po_density_and1 dpo )) 
	"DPO.R.1  DPO is required. [PO density of the whole chip <14%] The DPO CAD layer (TSMC default, 17:1)must be different from the PO CAD layer. ")  
) ; 
/*  DPO.R.2 is checked by CSR.R.1 */
dpo_out1 = geomHoles(dpo  )
 errorLayer( dpo_out1 
	"DPO.R.3  The only allowed shapes are square (or rectangular) and solid ") 
 errorLayer( geomAndNot( dpo geomGetRectangle( dpo   swap ) )
	"DPO.R.3 2  The only allowed shapes are square (or rectangular) and solid ")  
