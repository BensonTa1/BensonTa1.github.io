 narrow_sd1_out1 =  geomOutside( odr17_narrow_sd1 odr18_narrow_sd2  )   
 narrow_sd1_out11 =  geomSize( narrow_sd1_out1 0.001 noClipAcute )   
 narrow_sd1_out111 =  geomAnd(narrow_sd1_out11 sd)  
 odr19_narrow_sd3 = geomButtOrOver( narrow_sd1_out111 odr18_narrow_sd2  )   
 odr110_narrow_sd = geomOr(odr18_narrow_sd2 odr19_narrow_sd3)  
 odr111_narrow_sd_edge = geomGetEdge(odr110_narrow_sd coincident od)   
 errorLayer( geomGetLength(odr111_narrow_sd_edge  keep > OD_R_1_L contiguous ) 
	"OD.R.1  Width (J) of at least one segment of boundary between ACTIVE and Butted STRAP >= ^OD_R_1_W um When J<0.3um, length (T) of {ACTIVE (source) interact with Butted_STRAP} >= ^OD_R_1_L um ")  
 od_not1 =  geomAndNot(od odwr)  
 od_not1_not1 =  geomAndNot(od_not1 logo)  
 od_not1_not11 =  geomAndNot(od_not1_not1 cdudmy)  
 errorLayer( geomAndNot(od_not1_not11 imp) 
	"OD.R.2  OD must be fully covered by N+/P+ except for DOD/LOGO/NW resister within OD ") 
/* OD2 CHECKS */
/* ========== */
 drc( od2   width < OD2_W_1  withCornerTouch 
	"OD2.W.1  Width >= ^OD2_W_1 um ")  
 drc( od2   sepNotch < OD2_S_1  
	"OD2.S.1  Space >= ^OD2_S_1 um ")  
 od2s2_x = geomOr(dact gate)  
 drc( od2 od2s2_x  sep < OD2_S_2  shielded withIntersection withSingularPoint 
	"OD2.S.2  Space to {ACTIVE OR GATE} >= ^OD2_S_2 um ")  
 od2s3_a = geomGetEdge(od2 inside od)   
 drc( od2s3_a gate_w  sep < OD2_S_3  shielded withIntersection 
	"OD2.S.3  Space to 1.0V 1.2V or 1.5V GATE in S/D direction >= ^OD2_S_3 um ")  
 drc( od2 nwel 0 < sep < OD2_S_4  shielded withIntersection withSingularPoint 
	"OD2.S.4  Space to NW >= ^OD2_S_4 um ")  
 drc( od2 gate_w  enc < OD2_EN_1  opposite shielded withIntersection 
	"OD2.EN.1  Enclosure of 2.5V or 3.3v gate in S/D direction >= ^OD2_EN_1 um ")  
 errorLayer( geomStraddle( gate od2  ) 
	"OD2.EN.1 2  Enclosure of 2.5V or 3.3v gate in S/D direction >= ^OD2_EN_1 um ")  
 od2ex1_dactg = geomOr(dact gate)  
 od2ex11_check_edge = drc( od2 od2ex1_dactg  enc < OD2_EX_1  shielded withIntersection withSingularPoint edgeb )
 errorLayer( geomAndNot(od2ex11_check_edge geomGetEdge(od2ex11_check_edge butting dstp)) 
	"OD2.EX.1  Extension on { ACTIVE OR GATE } >= ^OD2_EX_1 um ")  
 errorLayer( geomInside( od2 dact  ) 
	"OD2.EX.1 2  Extension on { ACTIVE OR GATE } >= ^OD2_EX_1 um ")  
 drc( nwel od2 0 < enc < OD2_EX_2  shielded withIntersection withSingularPoint 
	"OD2.EX.2  NW extension on OD2 >= ^OD2_EX_2 um ")  
 drc( od2 nwel 0 < enc < OD2_EX_3  shielded withIntersection withSingularPoint 
	"OD2.EX.3  Extension on NW >= ^OD2_EX_3 um ")  
 od2o1_x = geomAnd(od2 nwel)  
od2o1_x_1 = drc( od2o1_x   width < OD2_O_1 withNoAngledEdgeTolerance withCornerTouch )   
