if((UTM == 0) then
M5_DN_5 = 0.15
 cbm_sz5 =  geomSize( cbm 25 noClipAcute )   
 m5dn5_cbm_merge = geomSize( cbm_sz5 -25 noClipAcute )   
 m5dn5_check_cbm = drc( m5dn5_cbm_merge  area >= 200* 200 ) 
