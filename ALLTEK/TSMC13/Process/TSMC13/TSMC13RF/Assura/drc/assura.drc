 drc( poa21_b  area < PO_A_2 
	"PO.A.2  Enclosed area >= ^PO_A_2 um2 ") 
if((FULL_CHIP == 1) then

processCoverage(
	backup
        withinLayer( chipx )
        measure( 
            
            all_poly_den2_pc = calculate( area(all_poly) / area(chip))
            all_poly_den2 = output( all_poly_den2_pc  0 <=  keep < PO_DN_1)
        ); end measure
); end processCoverage
  po_density = all_poly_den2  
 errorLayer( geomAnd(po_density chipx) 
	"PO.DN.1  {PO OR DPO} density across full chip >= 14% ") 
) ; 
 gate_not1 =  geomAndNot( gate geomGetRectangle( gate   swap ) )  
 errorLayer( geomAndNot(gate_not1 geomInside(gate_not1 logo )) 
	"PO.R.1  The gate must be a rectangle orthogonal to the grid. (A bent gate is not allowed). ")  
/*  PO.R.2 is not able to check */
 por3_gatew = geomGetEdge(gate inside od)   
 por3_gatew_sz1 = geomSize(por3_gatew 0.001 edges)
 por31_x = geomAndNot(gate geomButtOrCoin( gate por3_gatew_sz1  keep == 2))   
 	por32_a = drc( por3_gatew width < GRID )
	por3_gatew_a = geomButtOrOver( gate por32_a )
	por3_gatew_x = geomOr( por31_x por3_gatew_a )
	por3_gatew_logo = geomAndNot( por3_gatew_x logo )
 errorLayer( geomAndNot(por3_gatew_logo rtmomdmy) 
	"PO.R.3  PO intersecting OD must form two or more diffusions except LOGO and RTMOM region (MOMDMY, CAD layer: 155;21).    ") 
if((FULL_CHIP == 1) then
/* get all floating gates */

geomStamp( psdu_g psdu )
geomStamp( nsdu_g nsdu )
  processAntenna(
	gate((gateu gateu))
        antenna( gateu pstpu nstpu psdu_g nsdu_g cbu cb2u ubmnu ubmdu cou   )
        ratio = zerop( pstpu.area )*zerop( nstpu.area )*zerop( psdu_g.area )*zerop( nsdu_g.area )*zerop( cbu.area )*zerop( cb2u.area )*zerop( ubmnu.area )*zerop( ubmdu.area )+zerop( cou.area )
 
float_gate = drcAntenna( gateu (gateu) ratio keep > 0 suppressErrorMessage )
)
 float_gate = geomButtOrOver( gateu float_gate_gateu)
/* get all floating source/drain */
  processAntenna(
	gate((nsdu_g nsdu_g))
        antenna( nsdu_g psdu_g gateu pstpu nstpu cbu cb2u ubmnu ubmdu   )
        ratio = zerop(plusp(nsdu_g.shapeCount-1) )*zerop( psdu_g.area )*zerop( gateu.area )*zerop( pstpu.area )*zerop( nstpu.area )*zerop( cbu.area )*zerop( cb2u.area )*zerop( ubmnu.area )*zerop( ubmdu.area )
 
float_nsd = drcAntenna( nsdu_g (nsdu_g) ratio keep > 0 suppressErrorMessage )
)
 float_nsd = geomButtOrOver( nsdu_g float_nsd_nsdu_g)
  processAntenna(
	gate((psdu_g psdu_g))
        antenna( psdu_g nsdu_g gateu pstpu nstpu cbu cb2u ubmnu ubmdu   )
        ratio = zerop(plusp(psdu_g.shapeCount-1) )*zerop( nsdu_g.area )*zerop( gateu.area )*zerop( pstpu.area )*zerop( nstpu.area )*zerop( cbu.area )*zerop( cb2u.area )*zerop( ubmnu.area )*zerop( ubmdu.area )
 
float_psd = drcAntenna( psdu_g (psdu_g) ratio keep > 0 suppressErrorMessage )
)
 float_psd = geomButtOrOver( psdu_g float_psd_psdu_g)
/* not floating source/drain */
 effective_nsd = geomAndNot(nsdu_g float_nsd)  
 effective_psd = geomAndNot(psdu_g float_psd)  
float_nsd_or1 =  geomSize( geomOr(float_nsd gate) GRID )
    geomStamp( effective_nsd nsdu )
    geomStamp(float_nsd_or1 effective_nsd buttOrOver multStamp "float_nsd_or11" suppressErrorMessage )
 float_nsd_or11 = geomOverlap( float_nsd_or1 effective_nsd diffNet )
 float_nsd_a = geomAndNot(float_nsd float_nsd_or11)  
float_psd_or1 =  geomSize( geomOr(float_psd gate) GRID ) 
geomStamp( effective_psd psdu )
    geomStamp(float_psd_or1 effective_psd )
  float_psd_or11 =  geomOverlap( float_psd_or1 effective_psd diffNet )
 float_psd_a = geomAndNot(float_psd float_psd_or11)  
 float_nsd_a_or1 =  geomOr(float_nsd_a float_psd_a)  
 float_gate_check = geomAndNot(float_gate geomButtOrOver(float_gate float_nsd_a_or1 ))   
float_gate_check11 = geomCat( float_gate_check )
 geomStamp(float_gate_check nsdu buttOrOver multStamp "POR4_a" suppressErrorMessage )
 geomStamp(float_gate_check11 psdu buttOrOver multStamp "POR4_b" suppressErrorMessage)
 errorLayer( geomOr( POR4_a POR4_b )
	"PO.R.4  It is prohibited for Floating Gate if the effective source/drain is not connected together  " ) 
) ; 
