 pw_inside_guard_ring_pre21 = geomSize(pw_inside_guard_ring_pre2 0.005 edges)
 pw_inside_guard_ring = geomAndNot( pw_inside_guard_ring_pre1 geomButtOrCoin( pw_inside_guard_ring_pre1 pw_inside_guard_ring_pre21 ))   
