 srcbwarn_chip_int_cb = geomAndNot(chip_iact3 geomButtOrOver(chip_iact3 ubmi ))   
 srcbwarn1_sr_edgex = geomButtOrOver( sr_edge srcbwarn_chip_int_cb  )   
 errorLayer( geomAndNot(srcbwarn1_sr_edgex geomButtOrOver(srcbwarn1_sr_edgex padi )) 
	"SR.CB.WARN  CB is must in seal-ring if wire bond is used  ")  
