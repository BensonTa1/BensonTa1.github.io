 errorLayer( geomAndNot(srcbd_rvwarn3_sr_edgex1 geomButtOrOver(srcbd_rvwarn3_sr_edgex1 cbdi_or1 )) 
	"SR.CBD_RV.WARN   CBD is must in seal-ring if flip chip (without AlCu fuse or AlCu RDL) is used  Either CBD or RV is must in seal-ring if flip chip(with AlCu fuse or AlCu RDL) is used ")  
