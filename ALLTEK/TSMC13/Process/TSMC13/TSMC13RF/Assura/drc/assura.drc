 rvi_or2 =  geomOr(rvi fwi)  
 srcbd_rvwarn2_chip_ubm_2 = geomAndNot(srcbd_rvwarn_chip_ubm geomButtOrOver(srcbd_rvwarn_chip_ubm rvi_or2 ))   
 srcbd_rvwarn3_sr_edgex1 = geomButtOrOver( sr_edge srcbd_rvwarn1_chip_ubm_1  )   
