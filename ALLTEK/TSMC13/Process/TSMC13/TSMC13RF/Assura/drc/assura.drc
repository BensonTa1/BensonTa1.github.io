  m1dn1l10_d7 = m1_not_exc_den2  

processCoverage(
	backup
        withinLayer( chipu80 )
        measure( 
             windowSize = 200 stepSize = 100
            m1_not_exc_den2_pc = calculate( area(m1_not_exc) / area(chip_not_m1_exc))
            m1_not_exc_den2 = output( m1_not_exc_den2_pc squareSize = 200 0 <=  keep < M1_DN_1L)
        ); end measure
); end processCoverage
  m1dn1l11_d8 = m1_not_exc_den2  

processCoverage(
	backup
        withinLayer( chipu90 )
        measure( 
             windowSize = 200 stepSize = 100
            m1_not_exc_den2_pc = calculate( area(m1_not_exc) / area(chip_not_m1_exc))
            m1_not_exc_den2 = output( m1_not_exc_den2_pc squareSize = 200 0 <=  keep < M1_DN_1L)
        ); end measure
); end processCoverage
  m1dn1l12_d9 = m1_not_exc_den2  
 d_and3 =  geomAnd(m1dn1l1_d m1dn1l4_d1)  
 d_and3_and1 =  geomAnd(d_and3 m1dn1l5_d2)  
 d_and3_and1_and1 =  geomAnd(d_and3_and1 m1dn1l6_d3)  
 d_and3_and1_and11 =  geomAnd(d_and3_and1_and1 m1dn1l7_d4)  
 d_and3_and1_and111 =  geomAnd(d_and3_and1_and11 m1dn1l8_d5)  
 d_and3_and1_and1111 =  geomAnd(d_and3_and1_and111 m1dn1l9_d6)  
 d_and3_and1_and11111 =  geomAnd(d_and3_and1_and1111 m1dn1l10_d7)  
 d_and3_and1_and111111 =  geomAnd(d_and3_and1_and11111 m1dn1l11_d8)  
 d_and3_and1_and1111111 =  geomAnd(d_and3_and1_and111111 m1dn1l12_d9)  
 m1dn1l13_err2 = geomButtOrOver( m1dn1l1_d d_and3_and1_and1111111  )   
 err2_not3 =  geomAndNot(m1dn1l13_err2 m1_den_exc)  
 m1dn1l14_f2 = drc( err2_not3  area >= 10000 ) 
 m1dn1l15_f = geomOr(m1dn1l3_f1 m1dn1l14_f2)  
 processCoverage( 
	backup
         
 measure(
          windowSize = 200 stepSize = 100
     chip_not_m1_exc_den3_pc =  calculate(
           if( area(m1dn1l15_f) > 0   then
             area(m1_not_exc) / area(chip_not_m1_exc)
                    
               else
                    -1
             )
            ) 
            chip_not_m1_exc_den3 = output( chip_not_m1_exc_den3_pc squareSize = 200 0 <=  keep < M1_DN_1L)

         ) ;end measure
 ) ;end processCoverage
 errorLayer( chip_not_m1_exc_den3 
	"M1.DN.1L  {M1 OR DM1} local density range over 200um x 200um area stepping 100um >= ^M1_DN_1L  ") ;


