 ppod = geomAnd(od pp)  
 cood = geomAnd(co od)  /*  Contact diffusions  */
 copo = geomAndNot(co od)  /*  Contacts on poly + floating contacts */
/*  For NW (within OD) resistor checks */
 rnwel = geomButtOrOver( nwel nwdmy  )  /*  NW resistor (UNDER OD & STI) */ 
 nonwr = geomAndNot(nwel geomButtOrOver(nwel nwdmy ))  /*  NW exclude resistor area */ 
 odwr = geomButtOrOver( od rnwel  )  /*  OD area of NW resistor */ 
/*  For NW within OD (NWROD) resistor  */
 nwres = geomButtOrOver( rnwel rpo  )  /*  NW resistor (within OD) */ 
 nwres_sti = geomAndNot(rnwel geomButtOrOver(rnwel rpo ))  /*  NWEL resistor (Under STI) */ 
 npwr = geomButtOrOver( np nwres  )  /*  N+ implant on NW resistor terminals */ 
 cowr = geomButtOrOver( cood nwres  )  /*  Contact on NW resistor terminals */ 
 rhwr = geomAndNot(odwr rpo)  /*  Silicided area of NW resistor     */
 nstpi = geomAnd(npodi nonwri)  /*  NWell pickup  */
 pstpi = geomAndNot(ppodi nwelli)  /*  Substrate(PWEL) Pick-Up */
 nacti = geomAndNot(npodi nwelli)  /*  NMOS device active diffusion including regions of SRAM */
 pacti = geomAnd(ppodi nonwri)  /*  PMOS Device */
 nsdi = geomAndNot(nacti polygi)  /*  NMOS source/drain */
 psdi = geomAndNot(pacti polygi)  /*  PMOS source/drain */
 ilp1i = geomAndNot(polygi rpo)  /*  interconnect poly */
 nw2v = geomAnd(nwel od2)  
 nw1v = geomAndNot(nwel od2)  
 nstp = geomAnd(npod nonwr)  /*  NW strap diffusion */
 pstp = geomAndNot(ppod nwel)  /*  Substrate (pwell) strap diffusion */
 nact = geomAndNot(npod nwel)  /*  NMOS device active diffusion */
 pact = geomAnd(ppod nwel)  /*  PMOS device active diffusion */
 apn = geomAndNot(api geomButtOrOver(api mdi ))   
 dact = geomOr(nact pact)  /*  NMOS/PMOS device active diffusion */
 gate = geomAnd(poly od)  /*  Gate regions for NMOS and PMOS */
 dact_enc1 =  geomEnclose( dact gate  )  /*  Source, drain areas */ 
 sd = geomAndNot(dact_enc1 gate)  /*  Source, drain areas */
 dstp = geomOr(nstp pstp)  /*  All straps */
 fpo1 = geomAndNot(poly odi)  /*  Field poly */
 hv_gate = geomAnd(gate od2)  
 lv_gate = geomAndNot(gate od2)  
 gate_np = geomAnd(gate np)  
 gate_pp = geomAnd(gate pp)  
 gate_w = geomGetEdge(poly inside od)  /*  Gate width */ 
 gate_l = geomGetEdge(od inside poly)  /*  Coincident edge of interconnect POLY */ 
 gaten_w = geomGetEdge(gate_w inside np)   
 gatep_w = geomGetEdge(gate_w inside pp)   
 hv_gate_w = geomGetEdge(gate_w inside od2)  /*  2.5V MOS gates */ 
 lv_gate_w = geomAndNot(gate_w geomGetEdge(gate_w inside od2))  /*  1.2V/1.0V MOS gates */ 
 hv_ngate_w = geomGetEdge(hv_gate_w inside np)  /*  2.5V NMOS gate edges */ 
 hv_pgate_w = geomGetEdge(hv_gate_w inside pp)  /*  2.5V PMOS gate edges */ 
 lv_ngate_w = geomGetEdge(lv_gate_w inside np)  /*  1.2V/1.0V NMOS gate edges */ 
 lv_pgate_w = geomGetEdge(lv_gate_w inside pp)  /*  1.2V/1.0V PMOS gate edges */ 
/*  For poly and od resistors identify */
 rpo_rpdmy = geomOr(rpoi rpdmy)  
 rpo_rpdmy_usram = geomAndNot(rpo_rpdmy excl_srm)  /*  for resistor recognition */
 res_not_sdi = geomAndNot(rpo_rpdmy_usram sdi)  /*  For OD/poly resistors    */
 res_and_sdi = geomAnd(rpo_rpdmy_usram sdi)  /*  For OD/poly resistors */
 pores_in_sdi = geomAnd(fpo1 res_and_sdi)  
 pores_not_sdi = geomAnd(fpo1 res_not_sdi)  
 pores_in_sdi_or1 =  geomOr(pores_in_sdi pores_not_sdi)  /*  POLY resistor region */
 pores_in_sdi_or11 =  geomOutside( pores_in_sdi_or1 bjtdmy  )  /*  POLY resistor region */ 
 pores = geomOutside( pores_in_sdi_or11 inddmy  )  /*  POLY resistor region */ 
 pores_us = geomAnd(pores rpo)  /*  unsilicided POLY resistor */
 pores_si = geomAndNot(pores geomButtOrOver(pores rpo ))  /*  silicided POLY resistor */ 
 od_out1 =  geomOutside( od nwdmy  )  /*  field oxide */ 
 od_out1_not1 =  geomAndNot(od_out1 gate)  /*  field oxide */
 od_out1_not11 =  geomOutside( od_out1_not1 bjtdmy  )  /*  field oxide */ 
 fod = geomOutside( od_out1_not11 inddmy  )  /*  field oxide */ 
 odres = geomAnd(fod rpo_rpdmy_usram)  /*  OD unsilicided resistor region */
 odres_us = geomAnd(odres rpo)  /*  unsilicided POLY resistor */
 odres_si = geomAndNot(odres geomButtOrOver(odres rpo ))  /*  silicided POLY resistor */ 
 odpo_res = geomOr(odres pores)  /*  All OD/poly resitors */
/*  For VTL/H_N/P.R.2 checks */
 rpo_od = geomAnd(rpo od)  
 rpo_po = geomAnd(rpo poly)  
/*  For ESD checks */
 pmos = geomEnclose( pact gate  )   
 nmos = geomEnclose( nact gate  )   
 pasd = geomAndNot(pmos gate)  /*  Source/Drain of PMOS */
 nasd = geomAndNot(nmos gate)  /*  Source/Drain of NMOS */
 epmos = geomAnd(sdi pmos)  /*  ESD PMOS device */
 enmos = geomAnd(sdi nmos)  /*  ESD NMOS device */
if((DFM_ONLY == 1) then


;OPTION SETUP OF DFM RULES
; Recommendation rules 
DFM = 1
) ; 
if((DEFINE_PAD_BY_TEXT == 1) then
CHECK_LATCHUP_BY_PAD_CONNECTION = 1
) ; 
if((HALF_NODE == 1) then
if((LK == 1) then
 errorLayer( geomCat(chip) 
	"UTM.OPTION.WARN  Please turn off LK switch , 0.11 um process is not allowed Low-K process ")  
) ; 
 errorLayer( geomCat(lvid) 
	"LVID.OPTION.WARN  0.11 um process did not support Low-Power process ")  
) ; 
/*  For SEAL-RING and CHIP CORNER checks. */
if((FULL_CHIP == 1) then
 chip_core = geomSize( chipx -20 noClipAcute )  /*  Width of the seal-ring + assembly isolation */ 
else;
 chip_core = geomCat(chipx)   
) ; 
all_pad_out1 = geomHoles(all_pad  )
 padh = all_pad_out1  
 score = geomInside( chip_core padh  )   
 chip_wisr = geomButtOrOver( chipx score  )   
 sr_edge = geomAndNot(chip_wisr score)  
 chip_nosr = geomAndNot(chipx geomButtOrOver(chipx sr_edge ))   
 chip_nosr1 = geomCat(chip_nosr)   
 chip_nosr2 = geomCat(chip_nosr)   
if((FULL_CHIP == 1) then
if((BigSealringCorner == 1) then
 chip_us = geomSize( chip_nosr -157 noClipAcute )   
 chip_exp = geomSize(chip_us 157 edges)   
 chip_no_corner = geomOr(chip_us chip_exp)  
 chip_corner = geomAndNot(chip_nosr chip_no_corner)  
 corner_tri = drc(chip_no_corner sepNotch < 72 only_perp )   
/*  without seal-ring */
 chip_corner_not1 =  geomAndNot(chip_corner corner_tri)  
 empty_area = geomAnd(chip_corner_not1 chip_nosr)  
/*  with seal-ring */
