 errorLayer( geomCat(chip) 
	"LmarkSealringCorner.OPTION.WARN  Please turn on LmarkSealringCorner when WLCSP_SEALRING design is applied. ")  
) ; 
) ; 
if((MSRF == 0) then
 errorLayer( geomButtOrOver( chip ctm  ) 
	"MSRF.OPTION.WARN  Please turn on MSRF when MS/RF design is applied. ")  
 errorLayer( geomButtOrOver( chip cbm  ) 
	"MSRF.OPTION.WARN 2  Please turn on MSRF when MS/RF design is applied. ")  
 errorLayer( geomButtOrOver( chip inddmy  ) 
	"MSRF.OPTION.WARN 3  Please turn on MSRF when MS/RF design is applied. ")  
 errorLayer( geomButtOrOver( chip ctmdmy  ) 
	"MSRF.OPTION.WARN 4  Please turn on MSRF when MS/RF design is applied. ")  
 errorLayer( geomButtOrOver( chip rfdmy  ) 
	"MSRF.OPTION.WARN 5  Please turn on MSRF when MS/RF design is applied. ")  
) ; 
if((FRONT_END == 1) then
/* NT_N CHECKS */
/* ============ */
 ntn_od = geomAnd(od ntn)  
 ntn_po = geomAnd(poly ntn)  
 ntn_gate_w = geomGetEdge(ntn_po inside ntn_od)   
 ntn_hv_gate_w = geomGetEdge(ntn_gate_w inside od2)   
if((MSRF == 1) then
 ntn_check = geomAndNot(ntn geomButtOrOver(ntn inddmy ))   
else;
 ntn_check = geomCat(ntn)   
) ; 
 drc( ntn   width < NT_N_W_1  withCornerTouch 
	"NT_N.W.1  Width >= ^NT_N_W_1 um ")  
 drc( ntn_gate_w   width < NT_N_W_2  
	"NT_N.W.2  Channel length of 1.0V,1.2V or 1.5V native devide >= ^NT_N_W_2 um ")  
 drc( ntn_hv_gate_w   width < NT_N_W_3  
	"NT_N.W.3  Channel length of 2.5V/3.3V native device >= ^NT_N_W_3 um ")  
if((HALF_NODE == 1) then
 nt_nw4_ntn_gate_l = geomGetEdge(ntn_od inside ntn_po)   
 drc( nt_nw4_ntn_gate_l   width < NT_N_W_4  
	"NT_N.W.4  Channel width of native device >= ^NT_N_W_4 um  ")  
) ; 
 drc( ntn   sepNotch < NT_N_S_1  
	"NT_N.S.1  Space >= ^NT_N_S_1 um ")  
 nt_ns2_dact_out = geomOutside( dact ntn  )   
 drc( nt_ns2_dact_out ntn_check  sep < NT_N_S_2  shielded withIntersection withSingularPoint 
	"NT_N.S.2  Space to {Active outside NT_N} >= ^NT_N_S_2 um ")  
 errorLayer( geomStraddle(nt_ns2_dact_out ntn_check) 
	"NT_N.S.2  Space to {Active outside NT_N} >= ^NT_N_S_2 um ") 
 drc( ntn nwelli  sep < NT_N_S_3  shielded withIntersection withSingularPoint 
	"NT_N.S.3  Space to NWEL [overlap is not allowed] >= ^NT_N_S_3 um  ")  
 errorLayer( geomAnd(ntn nwelli) 
	"NT_N.S.3  Space to NWEL [overlap is not allowed] >= ^NT_N_S_3 um  ")  
 errorLayer( geomAnd(ntn nwelli) 
	"NT_N.S.3 2  Space to NWEL [overlap is not allowed] >= ^NT_N_S_3 um  ") 
 nt_nen1_a = geomButtOrOver( ntn_check npod  )   
 nt_nen11_b = geomButtOrOver( npod ntn_check  )   
 nt_nen12_c = geomSize( nt_nen11_b NT_N_EN_1 noClipAcute )   
 nt_nen13_d = geomSize( nt_nen1_a -NT_N_EN_1 noClipAcute )   
 errorLayer( geomXor(nt_nen1_a nt_nen12_c) 
	"NT_N.EN.1  Enclosure of N+OD (minimum = maximum) == ^NT_N_EN_1 um ") 
 errorLayer( geomXor(nt_nen11_b nt_nen13_d) 
	"NT_N.EN.1 2  Enclosure of N+OD (minimum = maximum) == ^NT_N_EN_1 um ") 
 drc( poly ntn_od  enc < NT_N_EX_1  shielded withIntersection withSingularPoint 
	"NT_N.EX.1  PO extension on {OD inside NT_N} (PO endcap) >= ^NT_N_EX_1 um ")  
 errorLayer( geomAnd(ntn dnw) 
	"NT_N.R.1  Overlap of DNW is not allowed.    ") 
 errorLayer( geomEnclose( ntn od keep > 1 ) 
	"NT_N.R.2  Only one OD is allowed in an NT_N (except for NMOS capacitors with same potential). ")  
 ntn_and1 =  geomAnd(ntn gate_pp)  
 errorLayer( geomAndNot(ntn_and1 inddmy) 
	"NT_N.R.3  P+ gate is not allowed in NT_N    ") 
/* HRI CHECKS */
/* ========== */
 pores_iact1 =  geomButtOrOver( pores hri  )   
 hrep = geomAnd(pores_iact1 rhridmy)  
 hrep_l = geomGetEdge(hrep coincident poly)   
 drc( hri   width < HRI_W_1  withCornerTouch 
	"HRI.W.1  Width >= ^HRI_W_1 ")  
 drc( hrep_l   width < HRI_W_2  
	"HRI.W.2  Width of HRI PO resistor >= ^HRI_W_2 ")  
 errorLayer( geomGetLength(hrep_l  keep < HRI_L_1 contiguous ) 
	"HRI.L.1  Length of HRI PO resistor >= ^HRI_L_1 ")  
 drc( hri   sepNotch < HRI_S_1  
	"HRI.S.1  Space >= ^HRI_S_1 ")  
 hris2_dpod = geomOr(npod ppod)  
 drc( hri hris2_dpod  sep < HRI_S_2  shielded withIntersection withSingularPoint 
	"HRI.S.2  Space to N+OD or P+OD region >= ^HRI_S_2 ")  
 drc( hri gate  sep < HRI_S_3_4  shielded withIntersection withSingularPoint 
	"HRI.S.3_HRI.S.4  Space to NMOS/PMOS GATE >= ^HRI_S_3_4 ")  
 hriex1_a = geomAnd(poly hri)  
 drc( hri hriex1_a  enc < HRI_EX_1  shielded withIntersection withSingularPoint 
	"HRI.EX.1  Extension on HRI PO >= ^HRI_EX_1 ")  
/* HRI.R.1 is checked by HRI.R.3 */
 hrir2_np_ovp_hri = geomAnd(np hri)  
 errorLayer( geomAnd(hrir2_np_ovp_hri fpo1) 
	"HRI.R.2  Overlap of NP on the same PO region (seated on a non-OD region.) is not allowed. ") 
 errorLayer( geomAnd(hri od) 
	"HRI.R.3  Overlap of OD is not allowed.  ") 
 drc( hri  area < HRI_A_1 
	"HRI.A.1  Area >= ^HRI_A_1 ") 
 poly_and1 =  geomAnd(poly hri)  
 hrio1_a = geomAnd(poly_and1 rpo)  
 hrio11_b = geomGetEdge(hrio1_a inside poly)   
 hrio12_c = geomSize(hrio11_b -HRI_O_1 edges)   
 hrio13_d = geomAnd(hrio1_a pp)  
 errorLayer( geomXor(hrio12_c hrio13_d) 
	"HRI.O.1  PP overlap of HRI PO resistor (maximum = minimum) == ^HRI_O_1 ") 
/* VTL_N CHECKS */
 vtln_r = geomWidth(vtln keep  >= 0.56 ) 
/*  waive one track overlap 	   */
 vtln_a1 = drc( vtln   width < 0.4  app == 0 parallel )
 vtln_r_exp1 =  geomSize(vtln_r -VTL_N_R_3/ 2 edges) 
 vtln_b1 = geomAndNot(vtln_r vtln_r_exp1)  
 vtln_c1 = drc( vtln_b1   sepNotch < GRID withSingularPoint withIntersection )
 vtln_d1 = geomEnclose( vtln_a1 vtln_c1  )   
/*  waive one track space */
 vtln_a2 = drc( vtln  0 <  sepNotch < 0.24 withIntersection  app == 0 parallel )
 vtln_r_exp2 =  geomSize(vtln_r VTL_N_R_3/ 2 edges)   
 vtln_b2 = geomOr(vtln_r vtln_r_exp2)  
 vtln_c2 = drc( vtln_b2   sepNotch < GRID withSingularPoint withIntersection  )
 vtln_d2 = geomEnclose( vtln_a2 vtln_c2  )   
/*  waive point touch */
 VTLN_P_X  = geomButtOrOver( vtln_r drc( vtln_r   sep < GRID cornerToCorner  ) )
 VTLN_P_Y1 = drc( VTLN_P_X  0 < sepNotch < 0.24 withSingularPoint )
 VTLN_P_Y2 = drc( VTLN_P_X  0 < sepNotch < 0.24 opposite )
 vtln_p  = geomAndNot( VTLN_P_Y1 VTLN_P_Y2 )

/* ============ */
 drc( vtln   width < VTL_N_W_1  withCornerTouch 
	"VTL_N.W.1  Space >= ^VTL_N_W_1 um ")  
 vtl_nw2_a = geomGetEdge(lv_ngate_w inside vtln)   
 drc( vtl_nw2_a   width < VTL_N_W_2  
	"VTL_N.W.2  Channel length of 1.2V low Vt NMOS >= ^VTL_N_W_2 um ")  
if((MSRF == 1) then
if((HIGH_VOLTAGE == 2.5) then
 vtl_nw3_a = geomGetEdge(hv_ngate_w inside vtln)   
 drc( vtl_nw3_a   width < VTL_N_W_3  
	"VTL_N.W.3  Channel length of 2.5V low Vt NMOS >= ^VTL_N_W_3 um ")  
else;
 errorLayer( geomAnd(vtln od2) 
	"VTL_N.W.3 2  TSMC do not offer 3.3V Low Vt NMOS ") 
) ; 
else;/* MSRF */
 errorLayer( geomAnd(vtln od2) 
	"VTL_N.W.3 3  TSMC do not offer 2.5V or 3.3V Low Vt NMOS in LOGIC process ") 
) ; /* MSRF */
 drc( vtln   sepNotch < VTL_N_S_1  
	"VTL_N.S.1  Space >= ^VTL_N_S_1 um ")  
 vtl_ns2_a = geomAndNot(gate geomButtOrOver(gate vtln ))   
 vtl_ns21_x = geomGetEdge(vtl_ns2_a inside od)   
 x_exp1 =  geomSize(vtl_ns21_x (VTL_N_S_3 - VTL_N_S_2 ) edges)   
 vtl_ns22_b = geomOr(x_exp1 vtl_ns2_a)  
 vtl_ns23_c = geomSize( vtl_ns22_b VTL_N_S_2 noClipAcute )   
 errorLayer( geomAnd(vtln vtl_ns23_c) 
	"VTL_N.S.2  Space to GATE in poly endcap direction >= ^VTL_N_S_2 um ") 
/*  VTL_N.S.3 is checked by VTL_N.S.2 */
 vtl_nex1_a = geomButtOrOver( gate vtln  )   
 vtl_nex11_x = geomGetEdge(vtl_nex1_a inside od)   
 x_exp2 =  geomSize(vtl_nex11_x (VTL_N_EX_2 - VTL_N_EX_1 ) edges)   
 vtl_nex12_b = geomOr(x_exp2 vtl_nex1_a)  
 vtl_nex13_c = geomSize( vtl_nex12_b VTL_N_EX_1 noClipAcute )   
 errorLayer( geomAndNot(vtl_nex13_c vtln) 
	"VTL_N.EX.1  Extension on GATE in 1. poly endcap direction >= ^VTL_N_EX_1 um 2. S/D direction >= ^VTL_N_EX_2 um ") 
/*  VTL_N.EX.2 is checked by VTL_N.EX.1 */
 errorLayer( geomAnd(vtln nwel) 
	"VTL_N.R.1  Overlap of {NW OR NT_N} is not allowed ") 
 errorLayer( geomAnd(vtln ntn) 
	"VTL_N.R.1 2  Overlap of {NW OR NT_N} is not allowed ") 
/* VTL_P CHECKS */
/* ============ */
 drc( vtlp   width < VTL_P_W_1  withCornerTouch 
	"VTL_P.W.1  Width >= ^VTL_P_W_1 um ")  
 vtl_pw2_a = geomGetEdge(lv_pgate_w inside vtlp)   
 drc( vtl_pw2_a   width < VTL_P_W_2  
	"VTL_P.W.2  Channel length of 1.2V low Vt PMOS >= ^VTL_P_W_2 um ")  
if((MSRF == 1) then
if((HIGH_VOLTAGE == 2.5) then
 vtl_pw3_a = geomGetEdge(hv_pgate_w inside vtlp)   
 drc( vtl_pw3_a   width < VTL_P_W_3  
	"VTL_P.W.3  Channel length of 2.5V low Vt NMOS >= ^VTL_P_W_3 um ")  
else;
 errorLayer( geomAnd(vtlp od2) 
	"VTL_P.W.3 2  TSMC do not offer 3.3V Low Vt NMOS ") 
) ; 
else;/* MSRF */
 errorLayer( geomAnd(vtlp od2) 
	"VTL_P.W.3 3  TSMC do not offer 2.5V or 3.3V Low Vt NMOS in LOGIC process ") 
) ; /* MSRF */
 drc( vtlp   sepNotch < VTL_P_S_1  
	"VTL_P.S.1  Space >= ^VTL_P_S_1 um ")  
 vtl_ps2_a = geomAndNot(gate geomButtOrOver(gate vtlp ))   
 vtl_ps21_x = geomGetEdge(vtl_ps2_a inside od)   
 x_exp3 =  geomSize(vtl_ps21_x (VTL_P_S_3 - VTL_P_S_2 ) edges)   
 vtl_ps22_b = geomOr(x_exp3 vtl_ps2_a)  
 vtl_ps23_c = geomSize( vtl_ps22_b VTL_P_S_2 noClipAcute )   
 errorLayer( geomAnd(vtlp vtl_ps23_c) 
	"VTL_P.S.2  Space to GATE in poly endcap direction >= ^VTL_P_S_2 um ") 
/*  VTL_P.S.3 is checked by VTL_P.S.2 */
 vtl_pex1_a = geomButtOrOver( gate vtlp  )   
 vtl_pex11_x = geomGetEdge(vtl_pex1_a inside od)   
 x_exp4 =  geomSize(vtl_pex11_x (VTL_P_EX_2 - VTL_P_EX_1 ) edges)   
 vtl_pex12_b = geomOr(x_exp4 vtl_pex1_a)  
 vtl_pex13_c = geomSize( vtl_pex12_b VTL_P_EX_1 noClipAcute )   
 errorLayer( geomAndNot(vtl_pex13_c vtlp) 
	"VTL_P.EX.1  Extension on GATE in poly endcap direction >= ^VTL_P_EX_1 um, in S/D direction >= ^VTL_P_EX_2 um ") 
/*  VTL_P.EX.2 is checked by VTL_P.EX.1 */
 errorLayer( geomAndNot(vtlp nwel) 
	"VTL_P.R.1  Overlap of {PW OR NT_N} is not allowed ") 
 errorLayer( geomAnd(vtlp ntn) 
	"VTL_P.R.1 2  Overlap of {PW OR NT_N} is not allowed ") 
/*  LVID CHECKS */
/* ============ */
 lovt_gate = geomButtOrOver( lv_gate lvid  )   
 drc( lvid   width < LVID_W_1  withCornerTouch 
	"LVID.W.1  Width >= ^LVID_W_1 um ")  
 drc( lvid   sepNotch < LVID_S_1  
	"LVID.S.1  Space >= ^LVID_S_1 um ")  
 lvids2_a = geomAndNot(gate geomButtOrOver(gate lvid ))   
 lvids21_x = geomGetEdge(lvids2_a inside poly)   
 x_exp5 =  geomSize(lvids21_x (LVID_S_2 - LVID_S_3 ) edges)   
 lvids22_b = geomOr(x_exp5 lvids2_a)  
 lvids23_c = geomSize( lvids22_b LVID_S_3 noClipAcute )   
 errorLayer( geomAnd(lvid lvids23_c) 
	"LVID.S.2  Space to GATE in poly endcap direction >= ^LVID_S_2 um, in S/D direction >= ^LVID_S_3 um ") 
/*  LVID.S.3 is checked by LVID.S.2 */
 lvidex1_a = geomButtOrOver( gate lvid  )   
 lvidex11_x = geomGetEdge(lvidex1_a inside od)   
 drc( lvid lvidex11_x  enc < LVID_EX_1  opposite shielded withIntersection 
	"LVID.EX.1  Extension on gate in S/D direction >= ^LVID_EX_1 um ")  
 lvidr1_a = geomButtOrOver( gate lvid  )   
 lvidr11_x = geomGetEdge(lvidr1_a inside poly)   
 x_exp6 =  geomSize(lvidr11_x LVID_R_1_1 edges)   
 lvidr12_b = geomOr(x_exp6 lvidr1_a)  
 lvidr13_c = geomSize( lvidr12_b LVID_R_1_2 noClipAcute )   
 errorLayer( geomAndNot(lvidr13_c lvid) 
	"LVID.R.1  LVID must fully cover {(((LVID and gate) SIZING ^LVID_R_1_1) AND PO) SIZING ^LVID_R_1_2} ") 
/* VTH_N CHECKS */
/* ============ */
 errorLayer( geomAnd(vthn od2) 
	"VTH_N.TITLE  Only core (1.0V, 1.2V) has high Vt devices. ") 
 drc( vthn   width < VTH_N_W_1  withCornerTouch 
	"VTH_N.W.1  Width >= ^VTH_N_W_1 um ")  
 vth_nw2_a = geomGetEdge(lv_ngate_w inside vthn)   
 drc( vth_nw2_a   width < VTH_N_W_2  
	"VTH_N.W.2  Channel length of 1.0V or 1.2V high Vt NMOS >= ^VTH_N_W_2 um ")  
 drc( vthn   sepNotch < VTH_N_S_1  
	"VTH_N.S.1  Space >= ^VTH_N_S_1 um ")  
 vth_ns2_a = geomAndNot(gate geomButtOrOver(gate vthn ))   
 vth_ns21_x = geomGetEdge(vth_ns2_a inside od)   
 x_exp7 =  geomSize(vth_ns21_x (VTH_N_S_3 - VTH_N_S_2 ) edges)   
 vth_ns22_b = geomOr(x_exp7 vth_ns2_a)  
 vth_ns23_c = geomSize( vth_ns22_b VTH_N_S_2 noClipAcute )   
 errorLayer( geomAnd(vthn vth_ns23_c) 
	"VTH_N.S.2  Space to GATE in poly endcap direction >= ^VTH_N_S_2 um ") 
/*  VTH_N.S.3 is checked by VTH_N.S.2 */
 vth_nex1_a = geomButtOrOver( gate vthn  )   
 vth_nex11_x = geomGetEdge(vth_nex1_a inside od)   
 x_exp8 =  geomSize(vth_nex11_x (VTH_N_EX_2 - VTH_N_EX_1 ) edges)   
 vth_nex12_b = geomOr(x_exp8 vth_nex1_a)  
 vth_nex13_c = geomSize( vth_nex12_b VTH_N_EX_1 noClipAcute )   
 errorLayer( geomAndNot(vth_nex13_c vthn) 
	"VTH_N.EX.1  Extension on GATE in poly endcap direction >= ^VTH_N_EX_1 um, in S/D direction >= ^VTH_N_EX_1 um ") 
/*  VTH_N.EX.2 is checked by VTH_N.EX.1 */
 errorLayer( geomAnd(vthn nwel) 
	"VTH_N.R.1  Overlap {NW OR NT_N} is not allowed ") 
 errorLayer( geomAnd(vthn ntn) 
	"VTH_N.R.1 2  Overlap {NW OR NT_N} is not allowed ") 
/* VTH_P CHECKS */
/* ============ */
 errorLayer( geomAnd(vthp od2) 
	"VTH_P.TITLE  Only core (1.0V, 1.2V) has high Vt devices. ") 
 drc( vthp   width < VTH_P_W_1  withCornerTouch 
	"VTH_P.W.1  Space >= ^VTH_P_W_1 um ")  
 vth_pw2_a = geomGetEdge(lv_pgate_w inside vthp)   
 drc( vth_pw2_a   width < VTH_P_W_2  
	"VTH_P.W.2  Channel length of 1.0V or 1.2V high Vt PMOS >= ^VTH_P_W_2 um ")  
 drc( vthp   sepNotch < VTH_P_S_1  
	"VTH_P.S.1  Space >= ^VTH_P_S_1 um ")  
 vth_ps2_a = geomAndNot(gate geomButtOrOver(gate vthp ))   
 vth_ps21_x = geomGetEdge(vth_ps2_a inside od)   
 x_exp9 =  geomSize(vth_ps21_x (VTH_P_S_3 - VTH_P_S_2 ) edges)   
 vth_ps22_b = geomOr(x_exp9 vth_ps2_a)  
 vth_ps23_c = geomSize( vth_ps22_b VTH_P_S_2 noClipAcute )   
 errorLayer( geomAnd(vthp vth_ps23_c) 
	"VTH_P.S.2  Space to GATE in poly endcap direction >= ^VTH_P_S_2 um ") 
/*  VTH_P.S.3 is checked by VTH_P.S.2 */
 vth_pex1_a = geomButtOrOver( gate vthp  )   
 vth_pex11_x = geomGetEdge(vth_pex1_a inside od)   
 x_exp10 =  geomSize(vth_pex11_x (VTH_P_EX_2 - VTH_P_EX_1 ) edges)   
 vth_pex12_b = geomOr(x_exp10 vth_pex1_a)  
 vth_pex13_c = geomSize( vth_pex12_b VTH_P_EX_1 noClipAcute )   
 errorLayer( geomAndNot(vth_pex13_c vthp) 
	"VTH_P.EX.1  Extension on GATE in poly endcap direction >= ^VTH_P_EX_1 um, in S/D direction >= ^VTH_P_EX_2 um ") 
/*  VTH_P.EX.2 is checked by VTH_P.EX.1 */
 errorLayer( geomAndNot(vthp nwel) 
	"VTH_P.R.1  Overlap of {PW OR NT_N} is not allowed ") 
 errorLayer( geomAnd(vthp ntn) 
	"VTH_P.R.1 2  Overlap of {PW OR NT_N} is not allowed ") 
/* OD CHECKS */
/* ========= */
if((CHECK_DENSITY_IN_ODBLK == 1) then
if((MSRF == 1) then
 cb_exd = geomSize( cb 2 noClipAcute )   
 nwdmy_or3 =  geomOr(nwdmy fwi)  
 nwdmy_or3_or1 =  geomOr(nwdmy_or3 lmark)  
 nwdmy_or3_or11 =  geomOr(nwdmy_or3_or1 logo)  
 nwdmy_or3_or111 =  geomOr(nwdmy_or3_or11 inddmy)  
 od_exc = geomOr(nwdmy_or3_or111 cb_exd)  
else;
 nwdmy_or4 =  geomOr(nwdmy fwi)  
 nwdmy_or4_or1 =  geomOr(nwdmy_or4 lmark)  
 nwdmy_or4_or11 =  geomOr(nwdmy_or4_or1 logo)  
 od_exc = geomOr(nwdmy_or4_or11 inddmy)  
) ; 
else;
if((MSRF == 1) then
 cb_exd = geomSize( cb 2 noClipAcute )   
 nwdmy_or5 =  geomOr(nwdmy fwi)  
 nwdmy_or5_or1 =  geomOr(nwdmy_or5 lmark)  
 nwdmy_or5_or11 =  geomOr(nwdmy_or5_or1 logo)  
 nwdmy_or5_or111 =  geomOr(nwdmy_or5_or11 inddmy)  
 nwdmy_or5_or1111 =  geomOr(nwdmy_or5_or111 odblk)  
 od_exc = geomOr(nwdmy_or5_or1111 cb_exd)  
else;
 nwdmy_or6 =  geomOr(nwdmy fwi)  
 nwdmy_or6_or1 =  geomOr(nwdmy_or6 lmark)  
 nwdmy_or6_or11 =  geomOr(nwdmy_or6_or1 logo)  
 nwdmy_or6_or111 =  geomOr(nwdmy_or6_or11 inddmy)  
 od_exc = geomOr(nwdmy_or6_or111 odblk)  
) ; 
) ; 
if((FULL_CHIP == 1) then
 odx = geomAndNot(all_od empty_area)  
 chip_not_od_exc = geomCat(chip_chamfered)   
else;
 odx = geomCat(all_od)   
 chip_not_od_exc = geomCat(chip)   
) ; 
od_1 = drc( od   width < OD_W_1 withNoAngledEdgeTolerance withCornerTouch )   
 od_2 = geomStretchCorner( geomGetCorner( od keep < 90 ) OD_W_1 angleAll )
 errorLayer( geomOr( od_1 od_2 ) 
	"OD.W.1  Width >= ^OD_W_1 um ")  
/*  OD.W.2 is checked by OD.W.1 */
 drc( od   sepNotch < OD_S_1  
	"OD.S.1  Space >= ^OD_S_1 um ")  
/*  OD.S.2 is checked by PP.R.2 */
 ods3_a = geomAndNot(npod odwr)  
 a_ext1 =  drc( ods3_a nwelli  sep < OD_S_3  shielded withIntersection withSingularPoint )
 errorLayer( geomAndNot(a_ext1 geomInside(a_ext1 excl_srm )) 
	"OD.S.3  N+ ACTIVE space to NW >= ^OD_S_3 um ")  
 a_cut1 =  geomStraddle( ods3_a nwelli  )   
 errorLayer( geomAndNot(a_cut1 geomInside(a_cut1 excl_srm )) 
	"OD.S.3 2  N+ ACTIVE space to NW >= ^OD_S_3 um ")  
 ppod_ext1 =  drc( ppod nwelli  sep < OD_S_4  shielded withIntersection withSingularPoint )
 errorLayer( geomAndNot(ppod_ext1 geomInside(ppod_ext1 excl_srm )) 
	"OD.S.4  PW STRAP space to NW >= ^OD_S_4 um ")  
 ppod_cut1 =  geomStraddle( ppod nwelli  )   
 errorLayer( geomAndNot(ppod_cut1 geomInside(ppod_cut1 excl_srm )) 
	"OD.S.4 2  PW STRAP space to NW >= ^OD_S_4 um ")  
 ods5_x = geomSize(gaten_w OD_S_5 edges)   
 errorLayer( geomButtOnly(geomOutside(ods5_x pstp) pstp ) 
	"OD.S.5  GATE space to Butted STRAP[point projection] >= ^OD_S_5 um  ")  
 ods51_y = geomSize(gatep_w OD_S_5 edges)   
 errorLayer( geomButtOnly(geomOutside(ods51_y nstp) nstp ) 
	"OD.S.5 2  GATE space to Butted STRAP[point projection] >= ^OD_S_5 um  ")  
 npod_enc1 =  drc( nonwr npod  enc < OD_EN_1  shielded withIntersection withSingularPoint )
 errorLayer( geomAndNot(npod_enc1 geomInside(npod_enc1 excl_srm )) 
	"OD.EN.1  NW STRAP enclosure by NW >= ^OD_EN_1 um ")  
 npod_cut1 =  geomStraddle( npod nonwr  )   
 errorLayer( geomAndNot(npod_cut1 geomInside(npod_cut1 excl_srm )) 
	"OD.EN.1 2  NW STRAP enclosure by NW >= ^OD_EN_1 um ")  
 ppod_enc1 =  drc( nonwr ppod  enc < OD_EN_2  shielded withIntersection withSingularPoint )
 errorLayer( geomAndNot(ppod_enc1 geomInside(ppod_enc1 excl_srm )) 
	"OD.EN.2  P+ACTIVE enclosure by NW >= ^OD_EN_2 um ")  
 ppod_cut2 =  geomStraddle( ppod nonwr  )   
 errorLayer( geomAndNot(ppod_cut2 geomInside(ppod_cut2 excl_srm )) 
	"OD.EN.2 2  P+ACTIVE enclosure by NW >= ^OD_EN_2 um ")  
 drc( od  area < OD_A_1 
	"OD.A.1  Area >= ^OD_A_1 um2 ") 
OD_A_2pre = ( ( OD_A_2 + ( OD_S_1 * OD_S_1 * 3.142 ) ) / ( 2 * OD_S_1 ) ) * ( ( OD_A_2 + ( OD_S_1 * OD_S_1 * 3.142 ) ) / ( 2 * OD_S_1 ) ) / 3.141
od_out2 = geomHoles(od innermost area < OD_A_2pre)
 oda2_a = od_out2  
 oda21_b = geomAndNot(oda2_a od)  
 drc( oda21_b  area < OD_A_2 
	"OD.A.2  Enclosed area >= ^OD_A_2 um2 ") 
 chipu_od25 = geomSize( chip 25 noClipAcute )   
 chipu_od50 = geomSize( chip 50 noClipAcute )   
 chipu_od75 = geomSize( chip 75 noClipAcute )   
 chipu_od100 = geomSize( chip 100 noClipAcute )   
 chipu_od125 = geomSize( chip 125 noClipAcute )   
 chipu_od150 = geomSize( chip 150 noClipAcute )   
 chipu_od175 = geomSize( chip 175 noClipAcute )   
 chipu_od200 = geomSize( chip 200 noClipAcute )   
 chipu_od225 = geomSize( chip 225 noClipAcute )   

processCoverage(
	backup
         
        measure( 
             windowSize = 500 stepSize = 250
            odx_den2_pc = calculate( area(odx) / area(chip_not_od_exc))
            odx_den2 = output( odx_den2_pc squareSize = 500 0 <=  keep < OD_DN_1)
        ); end measure
); end processCoverage
  oddn1_d0 = odx_den2  
