 errorLayer( geomButtOrOver( nwrodr1m2_check_res nwrodr1m7_d  ) 
	"NWROD.R.1m 3  Width >= 1.8um and length >= 20um for NW resistor with OD ")  
 nwrstir1m_nwcell = geomAnd(nwrstir1m_nwcellin nwrstir1m_nwcellout)  
