/*  DRAWN LAYER DEFINITIONS */
/* ------------------------ */
drcExtractRules(

layerDefs( "df2"
	dnwelli	 = layer(  "DNWELL" ) 
	/*  DNWELL deep-nwell */
	nwelli	 = layer( "NWELL" type("drawing") type("pin") ) 
	/*  NWELL nwell technology */
	nwi_others	 = layer( "NWELL" type("pin") ) 
	
	odi	 = layer( "OD" type("pin") type("drawing")  "PDIFF" "NDIFF" ) 
	/*  DIFF PDIFF NDIFF active areas */
	odi_rfdrain	 = layer( "OD" type("drain") ) 
	
	odi_others	 = layer( "OD" type("pin")  "PDIFF" "NDIFF" ) 
	
	dod	 = layer( "OD" type("dummy") ) 
	/*  Dummy OD (DIFF) */
	odblk	 = layer( "ODBLK" type("dummy") ) 
	/*  DOD and DPO blocking for insertion */
	od2i	 = layer(  "OD2" ) 
	/*  OD2 define thick oxides for HV gates */
	polygi	 = layer( "POLYG" type("drawing") )
	/*  POLYG polysilicon gates, interconnect */
	dpo	 = layer( "POLYG" type("dummy") ) 
	/*  Dummy Poly */
	poi_others	 = layer( "POLYG" type("slot") ) 
	
	poblk	 = layer( "POBLK" type("dummy") ) 
	/*  DPO blocking for insertion */
	pimpi	 = layer(  "PIMP" ) 
	/*  PIMP P+ imlant */
	nimpi	 = layer(  "NIMP" ) 
	/*  NIMP N+ imlant */
	conti	 = layer(  "CONT" ) 
	/*  CONT Define connect for M1 to S/D and Gate */
	metal1i	 = layer(  "METAL1"  type("drawing") ) 
	/*  METAL1 */
	m1sloti	 = layer( "METAL1" type("slot") ) 
	/*  Metal1 slot (if drawn) */
	dum1	 = layer( "METAL1" type("dummy") ) 
	/*  dummy Metal1 */
	dm1excl	 = layer( "DMEXCL" type("dummy1") ) 
	
	metal2i	 = layer(  "METAL2"  type("drawing") ) 
	/*  METAL2 */
	m2sloti	 = layer( "METAL2" type("slot") ) 
	/*  Metal2 slot (if drawn) */
	dum2	 = layer( "METAL2" type("dummy") ) 
	/*  dummy Metal2 */
	dm2excl	 = layer( "DMEXCL" type("dummy2") ) 
	
	metal3i	 = layer(  "METAL3"  type("drawing") ) 
	/*  METAL3 */
	m3sloti	 = layer( "METAL3" type("slot") ) 
	/*  Metal3 slot (if drawn) */
	dum3	 = layer( "METAL3" type("dummy") ) 
	/*  dummy Metal3 */
	dm3excl	 = layer( "DMEXCL" type("dummy3") ) 
	
	metal4i	 = layer(  "METAL4"  type("drawing") ) 
	/*  METAL4 */
	m4sloti	 = layer( "METAL4" type("slot") ) 
	/*  Metal4 slot (if drawn) */
	dum4	 = layer( "METAL4" type("dummy") ) 
	/*  dummy Metal4 */
	dm4excl	 = layer( "DMEXCL" type("dummy4") ) 
	
	metal5i	 = layer(  "METAL5"  type("drawing") ) 
	/*  METAL5 */
	m5sloti	 = layer( "METAL5" type("slot") ) 
	/*  Metal5 slot (if drawn) */
	dum5	 = layer( "METAL5" type("dummy") ) 
	/*  dummy Metal5 */
	dm5excl	 = layer( "DMEXCL" type("dummy5") ) 
	
	metal6i	 = layer(  "METAL6"  type("drawing") ) 
	/*  METAL6 */
	m6sloti	 = layer( "METAL6" type("slot") ) 
	/*  Metal6 slot (if drawn) */
	dum6	 = layer( "METAL6" type("dummy") ) 
	/*  dummy Metal6 */
	dm6excl	 = layer( "DMEXCL" type("dummy6") ) 
	
	metal7i	 = layer(  "METAL7"  type("drawing") ) 
	/*  METAL7 */
	m7sloti	 = layer( "METAL7" type("slot") ) 
	/*  Metal7 slot (if drawn) */
	dum7	 = layer( "METAL7" type("dummy") ) 
	/*  dummy Metal7 */
	dm7excl	 = layer( "DMEXCL" type("dummy7") ) 
	
	metal8i	 = layer(  "METAL8"  type("drawing") ) 
	/*  METAL8 */
	m8sloti	 = layer( "METAL8" type("slot") ) 
	/*  Metal8 slot (if drawn) */
	dum8	 = layer( "METAL8" type("dummy") ) 
	/*  dummy Metal8 */
	dm8excl	 = layer( "DMEXCL" type("dummy8") ) 
	
	mdi	 = layer(  "MD"  type("drawing") ) 
	/*  MD For RDL interconnection */
	mdsloti	 = layer( "MD" type("slot") ) 
	/*  MD slot (if drawn) */
	dumd	 = layer( "MD" type("dummy") ) 
	/*  dummy MD */
	dmdexcl	 = layer( "DMEXCL" type("dummyf") ) 
	
	via12i	 = layer(  "VIA12" ) 
	/*  VIA12 Define connection from M2 to M1 */
	via23i	 = layer(  "VIA23" ) 
	/*  VIA23 Define connection from M3 to M2 */
	via34i	 = layer(  "VIA34" ) 
	/*  VIA34 Define connection from M4 to M3 */
	via45i	 = layer(  "VIA45" ) 
	/*  VIA45 Define connection from M5 to M4 */
	via56i	 = layer(  "VIA56" ) 
	/*  VIA56 Define connection from M6 to M5 */
	via67i	 = layer(  "VIA67" ) 
	/*  VIA67 Define connection from M7 to M6 */
	via78i	 = layer(  "VIA78" ) 
	/*  VIA78 Define connection from M8 to M7 */
	viadi	 = layer(  "VIAD" ) 
	/*  VIAD	Connection between MD and Mtop for RDL */
	rvi	 = layer(  "RV" ) 
	/*  Via hole for AlRDL */
	api	 = layer(  "AP"  type("drawing") ) 
	
	cu_ppii	 = layer( "AP" type("drawing1") ) 
	/*  Cu_PPI interconnection between Polymide1 and Polymide2 for WLCSP */
	padi	 = layer(  "PAD" ) 
	/*  PAD(CB) Passivation opening for Bond Pad */
	cb2i	 = layer(  "CB2" ) 
	/*  Passivation 2 for AP RDL used. */
	cbdi	 = layer(  "CBD" ) 
	/*  CBD for solder bump and RDL layer (filp-chip design)  */
	ubmi	 = layer(  "UBM" ) 
	/*  UBM for solder bump and RDL layer  */
	wbdmy	 = layer(  "WBDMY" ) 
	/*  WBDMY for CUP structure recognition */
	lupwdmy	 = layer( "FFCDMY" type("drawing1") ) 
	/*  DRC dummy layer to waive Latch-Up rules for verified IP. */
	vdddmy	 = layer( "VDDDMY" type("drawing") ) 
	/*  DRC dummy layer to identify VDD PAD for Latch-Up rules. */
	vssdmy	 = layer( "VSSDMY" type("drawing") ) 
	/*  DRC dummy layer to identify VSS PAD for Latch-Up rules. */
	momdmy_1	 = layer( "MOMDMY" type("drawing1") ) 
	/*  Dummy layer for M1 MOM region */
	momdmy_2	 = layer( "MOMDMY" type("drawing2") ) 
	/*  Dummy layer for M2 MOM region */
	momdmy_3	 = layer( "MOMDMY" type("drawing3") ) 
	/*  Dummy layer for M3 MOM region */
	momdmy_4	 = layer( "MOMDMY" type("drawing4") ) 
	/*  Dummy layer for M4 MOM region */
	momdmy_5	 = layer( "MOMDMY" type("drawing5") ) 
	/*  Dummy layer for M5 MOM region */
	momdmy_6	 = layer( "MOMDMY" type("drawing6") ) 
	/*  Dummy layer for M6 MOM region */
	momdmy_7	 = layer( "MOMDMY" type("drawing7") ) 
	/*  Dummy layer for M7 MOM region */
	momdmy_8	 = layer( "MOMDMY" type("drawing8") ) 
	/*  Dummy layer for M8 MOM region */
	momdmy_ap	 = layer( "MOMDMY" type("dummy1") ) 
	/*  Dummy layer for AP MOM region */
	rtmomdmy	 = layer( "MOMDMY" type("dummy2") ) 
	/*  Dummy layer for RTMOM, used to waive PO.R.3 */
	rpoi	 = layer(  "RPO" ) 
	/*  RPO Silicide blockage layer */
	nt_ni	 = layer(  "NT_N" ) 
	/*  NTN Native NMOS implant blockage */
	vtl_ni	 = layer(  "VTL_N" ) 
	/*  VT1MN 1.2V Low Vt NMOS Implant */
	vtl_pi	 = layer(  "VTL_P" ) 
	/*  VT1MP 1.2V Low Vt PMOS Implant */
	vth_ni	 = layer(  "VTH_N" ) 
	/*  VT2MN 1.0V or 1.2V High Vt NMOS Implant */
	vth_pi	 = layer(  "VTH_P" ) 
	/*  VT2MP 1.0V or 1.2V High Vt PMOS Implant */
	lvidi	 = layer(  "LVID" ) 
	/*  1.5V Low Vt NMOS/PMOS Implant */
	ctmi	 = layer(  "CTM" ) 
	/*  CTM MiM capacitor */
	hrii	 = layer(  "HRI" ) 
	/*  HRI High resistor implant */
	fwi	 = layer(  "FW" ) 
	/*  FW Fuse passivation window */
	uhvt_n	 = layer( "UHVT_N" type("drawing") ) 
	
	uhvt_p	 = layer( "UHVT_P" type("drawing") ) 
	
	plmidei	 = layer(  "PLMIDE"  type("drawing") ) 
	/*  PLMIDE Polymide (PM) */
	pm1i	 = layer( "PLMIDE" type("drawing1") ) 
	/*  Polymide (if drawn) */
	pm2i	 = layer( "PLMIDE" type("drawing2") ) 
	/*  Polymide (if drawn) */
	sealring	 = layer(  "SEALRING" ) 
	/*  SEALRING Layer used seal ring area */
	csrdmy	 = layer(  "CSRDMY" ) 
	/*  CSRDMY Layer to cover chip corner areas */
	nwdmy	 = layer(  "NWDMY" ) 
	/*  NWDMY NWEL resistor dummy layer */
	hotwl	 = layer(  "HOTWL" ) 
	/*  HOTWL Dummy layer to mark hot-NWELL for DRC  */
	rhdmy	 = layer(  "RHDMY" ) 
	/*  RHDMY Dummy layer for OD/POLY resistoris */
	rpdmy	 = layer(  "RPDMY" ) 
	/*  RPDMY Dummy layer for precision high poly resistor */
	pmdmy	 = layer(  "PMDMY" ) 
	/*  PMDMY Dummy layer for fuse window and protection ring structure */
	sdi	 = layer(  "SDI" ) 
	/*  SDI DRC purpose for ESD protection devices */
	dpdmy	 = layer(  "DPDMY" ) 
	/*  DPDMY Dummy pad area dummy layer */
	pldmy	 = layer(  "PLDMY" ) 
	/*  PLDMY Power line area dummy layer */
	esd1dmy	 = layer(  "ESD1DMY" ) 
	/*  ESD1DMY for ESD protection devices */
	esd2dmy	 = layer(  "ESD2DMY" ) 
	/*  ESD2DMY for ESD protection devices */
	esd3dmy	 = layer(  "ESD3DMY" ) 
	/*  ESD3DMY for ESD protection devices */
	lmark	 = layer(  "LMARK" ) 
	/*  LMARK Alignment Mark Rule for Laser Repair */
	rhridmy	 = layer(  "RHRIDMY" ) 
	/*  RHRIDMY Dummy layer for precision HRI poly resistor */
	vardmy	 = layer(  "VARDMY" ) 
	/*  VARDMY Dummy layer for both MOS and junction type varactor */
	logo	 = layer(  "LOGO" ) 
	/*  Dummy layer for product labels and LOGO */
	inddmy	 = layer(  "INDDMY" ) 
	/*  INDDMY Dummy layer to cover inductor devices */
	cbmi	 = layer(  "CBM" ) 
	/*  Definition of capacitor bottom metal */
