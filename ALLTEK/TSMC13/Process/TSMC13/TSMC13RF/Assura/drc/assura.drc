 drc( post_driver_nmos_pw_hv beside_post_driver_pmos_nw  sep < LUP_5_3g  shielded withIntersection withSingularPoint 
	"LUP.5.3g 4  Minimum space >= ^LUP_5_3g um 1. between 2.5V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 2.5V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_nmos_rw_hv beside_post_driver_pmos_nw  sep < LUP_5_3g  sameNet shielded withIntersection withSingularPoint 
	"LUP.5.3g 5  Minimum space >= ^LUP_5_3g um 1. between 2.5V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 2.5V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_nmos_rwi_hv beside_post_driver_pmos_nwi  sep < LUP_5_3g  diffNet shielded withIntersection withSingularPoint 
	"LUP.5.3g 6  Minimum space >= ^LUP_5_3g um 1. between 2.5V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 2.5V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
) ; /*  2.5V */
if((HIGH_VOLTAGE == 3.3) then
 drc( post_driver_pmos_nw_hv beside_post_driver_nmos_pw  sep < LUP_5_4g  shielded withIntersection withSingularPoint 
	"LUP.5.4g  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_pmos_nw_hv beside_post_driver_nmos_rw  sep < LUP_5_4g  sameNet shielded withIntersection withSingularPoint 
	"LUP.5.4g 2  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_pmos_nwi_hv beside_post_driver_nmos_rwi  sep < LUP_5_4g  diffNet shielded withIntersection withSingularPoint 
	"LUP.5.4g 3  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_nmos_pw_hv beside_post_driver_pmos_nw  sep < LUP_5_4g  shielded withIntersection withSingularPoint 
	"LUP.5.4g 4  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_nmos_rw_hv beside_post_driver_pmos_nw  sep < LUP_5_4g  sameNet shielded withIntersection withSingularPoint 
	"LUP.5.4g 5  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
 drc( post_driver_nmos_rwi_hv beside_post_driver_pmos_nwi  sep < LUP_5_4g  diffNet shielded withIntersection withSingularPoint 
	"LUP.5.4g 6  Minimum space >= ^LUP_5_4g um 1. between 3.3V NMOS which connects to the IO pad and the PMOS in the internal circuit  2. between 3.3V PMOS which connects to the IO pad and the NMOS in the internal circuit   ")  
) ; /*  3.3V */
) ; /*  GUIDELINE_LUP */
 psdc_not1 =  geomAndNot(psdc geomOutside(psdc conti ))   
 co_pact = geomOr(conti psdc_not1)  
 npui = geomButtOrOver( nstpi co_pact  )   
 npui_sram = geomInside( npui dmsrmi  )   
nstp_os = geomSizeAnd( npui nwelli NW_S_1* 0.7 LUP_6 )  
nstp_os_sram = geomSizeAnd( npui_sram nwelli NW_S_1* 0.7 LUP_6_SRAM )  
 pacti_iact1 =  geomButtOrOver( pacti conti  )   
 pacti_iact11 =  geomButtOrOver( pacti_iact1 polygi  )   
 pact_check = geomAndNot(pacti_iact11 polygi)  
 pact_check_non_sram = geomAndNot(pact_check geomInside(pact_check dmsrmi ))   
 pact_check_sram = geomInside( pact_check dmsrmi  )   
 nsdc_not1 =  geomAndNot(nsdc geomOutside(nsdc conti ))   
 co_nact = geomOr(conti nsdc_not1)  
 ppui = geomButtOrOver( pstpi co_nact  )   
 ppui_sram = geomInside( ppui dmsrmi  )   
pstp_os = geomSizeAnd( ppui pweli NW_S_1* 0.7 LUP_6 )  
pstp_os_sram = geomSizeAnd( ppui_sram pweli NW_S_1* 0.7 LUP_6_SRAM )  
 nacti_iact1 =  geomButtOrOver( nacti conti  )   
 nacti_iact11 =  geomButtOrOver( nacti_iact1 polygi  )   
 nact_check = geomAndNot(nacti_iact11 polygi)  
 nact_check_non_sram = geomAndNot(nact_check geomInside(nact_check dmsrmi ))   
 nact_check_sram = geomInside( nact_check dmsrmi  )   
 errorLayer( geomAndNot(pact_check_non_sram nstp_os) 
	"LUP.6  Any point inside NMOS source/drain space to the nearest PW STRAP in the same PW <= ^LUP_6 um Any point inside PMOS source/drain space to the nearest NW STRAP in the same NW <= ^LUP_6 um In SRAM bit cell region, the rule is relaxed to ^LUP_6_SRAM um ") 
 nstp_os_or1 =  geomOr(nstp_os nstp_os_sram)  
 errorLayer( geomAndNot(pact_check_sram nstp_os_or1) 
	"LUP.6 2  Any point inside NMOS source/drain space to the nearest PW STRAP in the same PW <= ^LUP_6 um Any point inside PMOS source/drain space to the nearest NW STRAP in the same NW <= ^LUP_6 um In SRAM bit cell region, the rule is relaxed to ^LUP_6_SRAM um ") 
 errorLayer( geomAndNot(nact_check_non_sram pstp_os) 
	"LUP.6 3  Any point inside NMOS source/drain space to the nearest PW STRAP in the same PW <= ^LUP_6 um Any point inside PMOS source/drain space to the nearest NW STRAP in the same NW <= ^LUP_6 um In SRAM bit cell region, the rule is relaxed to ^LUP_6_SRAM um ") 
 pstp_os_or1 =  geomOr(pstp_os pstp_os_sram)  
 errorLayer( geomAndNot(nact_check_sram pstp_os_or1) 
	"LUP.6 4  Any point inside NMOS source/drain space to the nearest PW STRAP in the same PW <= ^LUP_6 um Any point inside PMOS source/drain space to the nearest NW STRAP in the same NW <= ^LUP_6 um In SRAM bit cell region, the rule is relaxed to ^LUP_6_SRAM um ") 
if((GUIDELINE_ESD == 1) then
/*  I/O ESD Guidance */
/* ================== */
 pacti_iact2 =  geomButtOrOver( pacti polygi  )  /* Interact CONTi to filter out filler cell. */ 
 pmosi = geomButtOrOver( pacti_iact2 conti  )  /* Interact CONTi to filter out filler cell. */ 
 nacti_iact2 =  geomButtOrOver( nacti polygi  )   
 nmosi = geomButtOrOver( nacti_iact2 conti  )   
 emos = geomOr(epmos enmos)  
 epsd = geomAnd(sdi pasd)  
 ensd = geomAnd(sdi nasd)  
 egte = geomAnd(sdi gate)  
 co_and2 =  geomAnd(co sdi)  
 eco = geomAnd(co_and2 od)  
/*  Define ESD Gate Type */
/* ====================== */
 egte_full_rpo = geomInside( egte rpo  )   
 egte_part_rpo = geomStraddle( egte rpo  )   
 egte_no_rpo = geomAndNot(egte geomButtOrOver(egte rpo ))   
 enmos_iact1 =  geomButtOrOver( enmos egte_part_rpo  )   
 reg_enmos = geomAndNot(enmos_iact1 geomButtOrOver(enmos_iact1 egte_full_rpo ))   
 epmos_iact1 =  geomButtOrOver( epmos egte_part_rpo  )   
 reg_epmos = geomAndNot(epmos_iact1 geomButtOrOver(epmos_iact1 egte_full_rpo ))   
 enmos_iact2 =  geomButtOrOver( enmos egte_part_rpo  )   
 tol_enmos = geomButtOrOver( enmos_iact2 egte_full_rpo  )   
 pcl_enmos = geomAndNot(enmos geomButtOrOver(enmos rpo ))   
 reg_enmos_or1 =  geomOr(reg_enmos reg_epmos)  
 reg_egte = geomAnd(egte reg_enmos_or1)  
 tol_enmos_or1 =  geomOr(tol_enmos reg_epmos)  
 tol_egte = geomAnd(egte tol_enmos_or1)  
 pcl_enmos_or1 =  geomOr(pcl_enmos reg_enmos)  
 pcl_egte = geomAnd(egte pcl_enmos_or1)  
/*  For ESD.1g */
/* ============= */
 nsdc_hvmos = geomButtOrOver( nsdc hv_gate  )   
 nsdc_lvmos = geomButtOrOver( nsdc lv_gate  )   
 psdc_hvmos = geomButtOrOver( psdc hv_gate  )   
 psdc_lvmos = geomButtOrOver( psdc lv_gate  )   
 nsdc_hvmos_sdi = geomButtOrOver( nsdc_hvmos sdi  )   
 nsdc_lvmos_sdi = geomButtOrOver( nsdc_lvmos sdi  )   
 psdc_hvmos_sdi = geomButtOrOver( psdc_hvmos sdi  )   
 psdc_lvmos_sdi = geomButtOrOver( psdc_lvmos sdi  )   
geomStamp(nsdc_hvmos nsdc)
geomStamp( nsdc_hvmos_sdi nsdc_hvmos  )
 geomStamp( nsdc_lvmos nsdc  )
 geomStamp( nsdc_lvmos_sdi nsdc_lvmos  )
 geomStamp( psdc_hvmos psdc  )
 geomStamp( psdc_hvmos_sdi psdc_hvmos  )
 geomStamp( psdc_lvmos psdc  )
 geomStamp( psdc_lvmos_sdi psdc_lvmos  )
 polygi_not1 =  geomAndNot(polygi rpo)  
 ilp1 = geomAndNot(polygi_not1 rpdmy)  
geomConnect(incremental
        buttOrOver(ilp1 ilp1i )
)
geomStamp(hv_gate ilp1i buttOrOver floating "hv_gatec_tmp" suppressErrorMessage )
 hv_gatec = geomAndNot( hv_gate hv_gatec_tmp )
geomStamp(lv_gate ilp1 buttOrOver floating "lv_gatec_tmp" suppressErrorMessage )
 lv_gatec = geomAndNot( lv_gate lv_gatec_tmp )
/*  For ESD.6g */
/* ============= */
geomConnect( incremental
	buttOrOver(ensd nsdu)
	buttOrOver(epsd psdu)
	buttOrOver(hv_gatec ilp1i)
	buttOrOver(lv_gatec ilp1i)
)
 ensdi = geomCat(ensd)   
 epsdi = geomCat(epsd)   
geomConnect( incremental
	buttOrOver(ensdi nsdc)
	buttOrOver(epsdi psdc)
)
 pstp_real = geomAndNot(pstpi diodmy)  
 nstp_real = geomAndNot(nstpi diodmy)  
  processAntenna(
	gate((ensdi ensdi))
        antenna( ensdi pstp_real   )
        ratio = zerop(zerop( ensdi.area ))*zerop(zerop( pstp_real.area ))
 
ensd_source_pre = drcAntenna( ensdi (ensdi) ratio keep > 0 suppressErrorMessage )
)
 ensd_source_pre = geomButtOrOver( ensdi ensd_source_pre_ensdi )
  processAntenna(
	gate((epsdi epsdi))
        antenna( epsdi nstp_real   )
        ratio = zerop(zerop( epsdi.area ))*zerop(zerop( nstp_real.area ))
 
epsd_source_pre = drcAntenna( epsdi (epsdi) ratio keep > 0 suppressErrorMessage )
)
 epsd_source_pre = geomButtOrOver( epsdi epsd_source_pre_epsdi )

 ensd_not1 =  geomAndNot(ensd pcl_enmos)  
 ensd_not1_out1 =  geomOutside( ensd_not1 rpo  )   
 ensd_source = geomOr(ensd_source_pre ensd_not1_out1)  
 epsd_out1 =  geomOutside( epsd rpo  )   
 epsd_source = geomOr(epsd_source_pre epsd_out1)  
 ensd_drain = geomAndNot(ensd ensd_source)  
 epsd_drain = geomAndNot(epsd epsd_source)  
geomStamp(epsd_drain epsd )
geomStamp(ensd_drain ensd )
 ensd_drainx = geomButtOrOver( ensd_drain co  )   
geomStamp(ensd_drainx ensd )

 enmosc = geomCat(enmos)
 geomStamp( enmosc ensd_drainx floating "enmosc_float" suppressErrorMessage )
 enmosc = geomAndNot( enmosc enmosc_float )
epmosc = geomCat( epmos )
 epsd_drainx = geomButtOrOver( epsd_drain co  )   
  geomStamp(epsd_drainx epsd )
	geomStamp(epmosc epsd_drainx floating "epmosc_float" suppressErrorMessage )  
 epmosc = geomAndNot( epmosc epmosc_float )

if((FULL_CHIP == 1) then
 errorLayer( geomAndNot(chipx geomButtOrOver(chipx sdi )) 
	"ESD.WARN.1  SDI is not in whole chip. If SDI does not exist, the ESD related DRC will not work well. ")  
) ; 
 dact_iact1 =  geomButtOrOver( dact sdi  )   
 errorLayer( geomAndNot(dact_iact1 sdi) 
	"ESD.WARN.2  SDI encloure of ACTIVE >= 0 ") 
  processAntenna(
	gate((nsdc_hvmos_sdi nsdc_hvmos_sdi))
        antenna( nsdc_hvmos_sdi nsdc_lvmos psdc_lvmos lv_gatec pstpi   )
       ratio = zerop(zerop( nsdc_hvmos_sdi.area ))*zerop( pstpi.area )*(zerop(zerop( nsdc_lvmos.area ))+zerop(zerop( psdc_lvmos.area ))+zerop(zerop( lv_gatec.area )))
 ESD1G = drcAntenna( nsdc_hvmos_sdi (nsdc_hvmos_sdi) ratio keep > 0  suppressErrorMessage )
)
  errorLayer( geomCat( ESD1G_nsdc_hvmos_sdi ) 
	"ESD.1g   Use thin oxide transistor for thin oxide power clamp and thin oxide I/O buffers; use thick oxide transistor for the thick oxide Power Clamp and thick oxide I/O buffers ")
  processAntenna(
	gate((nsdc_lvmos_sdi nsdc_lvmos_sdi))
        antenna( nsdc_lvmos_sdi nsdc_hvmos psdc_hvmos hv_gatec pstpi   )
        ratio = zerop(zerop( nsdc_lvmos_sdi.area ))*zerop( pstpi.area )*(zerop(zerop( nsdc_hvmos.area ))+zerop(zerop( psdc_hvmos.area ))+zerop(zerop( hv_gatec.area )))
 ESD1G2 = drcAntenna( nsdc_lvmos_sdi (nsdc_lvmos_sdi) ratio keep > 0    suppressErrorMessage )
)
	errorLayer( geomCat( ESD1G2_nsdc_lvmos_sdi )
	"ESD.1g 2   Use thin oxide transistor for thin oxide power clamp and thin oxide I/O buffers; use thick oxide transistor for the thick oxide Power Clamp and thick oxide I/O buffers ")
  processAntenna(
	gate((psdc_hvmos_sdi psdc_hvmos_sdi))
        antenna( psdc_hvmos_sdi nsdc_lvmos psdc_lvmos lv_gatec pstpi   )
        ratio = zerop(zerop( psdc_hvmos_sdi.area ))*zerop( pstpi.area )*(zerop(zerop( nsdc_lvmos.area ))+zerop(zerop( psdc_lvmos.area ))+zerop(zerop( lv_gatec.area )))
 ESD1G3 = drcAntenna( psdc_hvmos_sdi (psdc_hvmos_sdi) ratio keep > 0   suppressErrorMessage ) 
)
	errorLayer( geomCat( ESD1G3_psdc_hvmos_sdi ) "ESD.1g 3   Use thin oxide transistor for thin oxide power clamp and thin oxide I/O buffers; use thick oxide transistor for the thick oxide Power Clamp and thick oxide I/O buffers ")

  processAntenna(
	gate((psdc_lvmos_sdi psdc_lvmos_sdi))
        antenna( psdc_lvmos_sdi nsdc_hvmos psdc_hvmos hv_gatec pstpi   )
        ratio = zerop(zerop( psdc_lvmos_sdi.area ))*zerop( pstpi.area )*(zerop(zerop( nsdc_hvmos.area ))+zerop(zerop( psdc_hvmos.area ))+zerop(zerop( hv_gatec.area )))
 ESD1G4 = drcAntenna( psdc_lvmos_sdi (psdc_lvmos_sdi) ratio keep > 0  suppressErrorMessage )
)
	errorLayer( geomCat( ESD1G4_psdc_lvmos_sdi ) "ESD.1g 4   Use thin oxide transistor for thin oxide power clamp and thin oxide I/O buffers; use thick oxide transistor for the thick oxide Power Clamp and thick oxide I/O buffers ")

 esd3g_egte_w = geomGetEdge(egte inside od)   
 errorLayer( geomGetLength(esd3g_egte_w  keep < ESD_3g_MIN contiguous ) 
	"ESD.3g  Unit finger width of NMOS and PMOS for I/O buffer and Power Clamp >= ^ESD_3g_MIN um <= ^ESD_3g_MAX um ")  
 errorLayer( geomGetLength(esd3g_egte_w  keep > ESD_3g_MAX contiguous ) 
	"ESD.3g 2  Unit finger width of NMOS and PMOS for I/O buffer and Power Clamp >= ^ESD_3g_MIN um <= ^ESD_3g_MAX um ")  
 esd4g_edge_nsd = geomButtOrOver( nsdu egte keep == 1 )   
  processAntenna(
	gate((esd4g_edge_nsd esd4g_edge_nsd))
        antenna( esd4g_edge_nsd pstpu   )
        ratio = zerop(zerop( esd4g_edge_nsd.area ))*zerop( pstpu.area )
 
     ERR = drcAntenna( esd4g_edge_nsd (esd4g_edge_nsd) ratio keep > 0 suppressErrorMessage )  
)
	errorLayer( geomCat(ERR_esd4g_edge_nsd)
	"ESD.4g  The OD area of the edge side of I/O buffer and Power Clamp should be Source or Bulk rather than Drain,  to avoid an unwanted parasitic bipolar effect or an abnormal discharge path in ESD zapping. DRC only flag (((OD INTERACT SDI) NOT PO) INTERACT one Gate) does not connect to STRAP. ")

 esd4g1_edge_psd = geomButtOrOver( psdu egte keep == 1 )   
  processAntenna(
	gate((esd4g1_edge_psd esd4g1_edge_psd))
        antenna( esd4g1_edge_psd nstpu   )
        ratio = zerop(zerop( esd4g1_edge_psd.area ))*zerop( nstpu.area )
 
  ERR = drcAntenna( esd4g1_edge_psd (esd4g1_edge_psd) ratio keep > 0 suppressErrorMessage )  
)
	errorLayer( geomCat(ERR_esd4g1_edge_psd)
	"ESD.4g 2  The OD area of the edge side of I/O buffer and Power Clamp should be Source or Bulk rather than Drain,  to avoid an unwanted parasitic bipolar effect or an abnormal discharge path in ESD zapping. DRC only flag (((OD INTERACT SDI) NOT PO) INTERACT one Gate) does not connect to STRAP. ")

 errorLayer( geomAndNot(epmos geomInside(epmos ntap_guard_ring_hole )) 
	"ESD.5g  For same type OD of the I/O buffer and Power Clamp should be surrounded by a guard-ring. All other type ODs should be placed outside this guard-ring. ")  
 errorLayer( geomAndNot(enmos geomInside(enmos ptap_guard_ring_hole )) 
	"ESD.5g 2  For same type OD of the I/O buffer and Power Clamp should be surrounded by a guard-ring. All other type ODs should be placed outside this guard-ring. ")  
enmosc_ext1 =  drc( enmosc  sep < ESD_6g  opposite  sameNet 0 < withIntersection  )
 esd6g_a = geomAndNot(enmosc_ext1 geomButtOrOver(enmosc_ext1 gate ))   
