 m7innerhole = m7exd_out1  
 m7bighole = geomSize( m7innerhole -5 noClipAcute )  /*  Holes with width <= 10um */ 
 m7hole = geomOutside( m7innerhole m7bighole  )   
 m7holespace = geomAndNot(m7hole m7exd)  
 fim7c = geomOr(m7exd m7holespace)  
 fim7c_sz1     = geomSize(  fim7c -1 downUp   )
 fim7c_sz1_sz1 = geomSize(  fim7c_sz1 -MS_R_1_W_s downUp   )
 fim7y = geomAnd(fim7c_sz1_sz1 fim7c)  
 lm7x = geomEncloseRect( fim7y MS_R_1_L MS_R_1_W )   
 m7holed = geomAnd(m7holespace lm7x)  
if((HALF_NODE == 1) then
 m7widems = geomCat(m7wide77)   
else;
 m7widems = geomCat(m7wide7)   
) ; 
 m7widems_not1 =  geomAndNot(m7widems slt_exd)  
 msr1m7_m7wideexd = geomAndNot(m7widems_not1 inddmy)  
 m7wideexd_sz1 =  geomSize(  msr1m7_m7wideexd -MS_R_1_W_s downUp  )
 msr1m71_x = geomAnd(m7wideexd_sz1 msr1m7_m7wideexd)  
 errorLayer( geomEncloseRect( msr1m71_x MS_R_1_L MS_R_1_W ) 
	"MS.R.1.M7  Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad/INDDMY areas are excluded.    ")  
geomConnect( incremental
	buttOrOver(m7holed lm7x)
)
processAntenna(
	gate((lm7x m7holed))
        antenna( m7holed )
        ratio = m7holed.area/lm7x.area
 MS_DN_1_M7 = drcAntenna( m7holed lm7x ratio keep < MS_DN_1
                        suppressErrorMessage
                      )
 ) ;end of processAntenna
 MS_DN_1_M7_zero = geomAvoiding( lm7x m7holed )
 MS_DN_1_M7 = geomOr( MS_DN_1_M7_zero MS_DN_1_M7_lm7x )
 errorLayer( MS_DN_1_M7  	"MS.DN.1.M7 2  Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%   ") 
/*  MS.R.2.M7 is not able to check */
/* M8 SLOT CHECKS */
/* ================== */
/*  Bonding pad, chip corner dummy pad, and inductor need not put slot */
pad_exd8 = geomSizeAnd( pad_exd m8x 0.32 5 )  
 slt_exd_or2 =  geomOr(slt_exd pad_exd8)  /*  For top metal only */
 slt_exd_or2_or1 =  geomOr(slt_exd_or2 wbdmy)  /*  For top metal only */
 slt_exd8 = geomOr(slt_exd_or2_or1 inddmy)  /*  For top metal only */
 m8exd = geomAndNot(m8x slt_exd8)  
m8exd_out1 = geomHoles(m8exd innermost )
 m8innerhole = m8exd_out1  
 m8bighole = geomSize( m8innerhole -5 noClipAcute )  /*  Holes with width <= 10um */ 
 m8hole = geomOutside( m8innerhole m8bighole  )   
 m8holespace = geomAndNot(m8hole m8exd)  
 fim8c = geomOr(m8exd m8holespace)  
 fim8c_sz1     = geomSize(  fim8c -1 downUp   )
 fim8c_sz1_sz1 = geomSize(  fim8c_sz1 -MS_R_1_W_s downUp   )
 fim8y = geomAnd(fim8c_sz1_sz1 fim8c)  
 lm8x = geomEncloseRect( fim8y MS_R_1_L MS_R_1_W )   
 m8holed = geomAnd(m8holespace lm8x)  
if((UTM == 1) then
 fim8_t_sz1 =  geomWidth(  fim8_t keep > M8_DN_2_W-2*0.001   )   
 fim8_t_sz1_and1 =  geomAnd(fim8_t_sz1 fim8_t)  
 lutm8_t = geomEncloseRect( fim8_t_sz1_and1 M8_DN_2_L M8_DN_2_W )   
 m8slt_t2 = geomInside( m8ho_t lutm8_t  )   
geomConnect( incremental
	buttOrOver(m8slt_t2 lutm8_t)
)
processAntenna(
	gate((lutm8_t m8slt_t2))
        antenna( m8slt_t2 )
        ratio = m8slt_t2.area/lutm8_t.area
     UTM_DN_2 = drcAntenna( m8slt_t2 lutm8_t ratio keep < 0.09 suppressErrorMessage )
 ) ;end of processAntenna
 UTM_DN_2_zero = geomAvoiding( lutm8_t m8slt_t2 )
 errorLayer( geomOr( UTM_DN_2_zero UTM_DN_2_lutm8_t )  
	"UTM.DN.2  Min. slot density for metal lines that need to apply slot  9% ") 
else;/* UTM */
if((HALF_NODE == 1) then
 m8widems = geomCat(m8wide77)   
else;
 m8widems = geomCat(m8wide7)   
) ; 
 m8widems_not1 =  geomAndNot(m8widems slt_exd8)  
 msr1m8_m8wideexd = geomAndNot(m8widems_not1 inddmy)  
 m8wideexd_sz1 =  geomSize(  msr1m8_m8wideexd -MS_R_1_W_s downUp  )
 msr1m81_x = geomAnd(m8wideexd_sz1 msr1m8_m8wideexd)  
 errorLayer( geomEncloseRect( msr1m81_x MS_R_1_L MS_R_1_W ) 
	"MS.R.1.M8  Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad/INDDMY areas are excluded.    ")  
geomConnect( incremental
	buttOrOver(m8holed lm8x)
)
processAntenna(
	gate((lm8x m8holed))
        antenna( m8holed )
        ratio = m8holed.area/lm8x.area
 MS_DN_1_M8 = drcAntenna( m8holed lm8x ratio keep < MS_DN_1
                        suppressErrorMessage
                      )
 ) ;end of processAntenna
 MS_DN_1_M8_zero = geomAvoiding( lm8x m8holed )
 MS_DN_1_M8 = geomOr( MS_DN_1_M8_zero MS_DN_1_M8_lm8x )
 errorLayer( MS_DN_1_M8  	"MS.DN.1.M8 2  Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%   ") 
) ; /* UTM */
/*  MS.R.2.M8 is not able to check */
/* MD SLOT CHECKS */
/* ================== */
if((UTM == 0) then
/* MD SLOT CHECKS */
/* ============== */
/*  Bonding pad, chip corner dummy pad, and inductor need not put slot */
 lmark_or2 =  geomOr(lmark csrdmy)  
 ubm_exdd_or1 =  geomOr(ubm_exdd inddmy)  
 lmark_or2_or1 =  geomOr(lmark_or2 ubm_exdd_or1)  
 mdexd = geomAndNot(mdx lmark_or2_or1)  
mdexd_out1 = geomHoles(mdexd innermost )
 mdinnerhole = mdexd_out1  
 mdbighole = geomSize( mdinnerhole -5 noClipAcute )  /*  Holes with width less than 10um will be filled back */ 
 mdhole = geomOutside( mdinnerhole mdbighole  )   
 mdholespace = geomAndNot(mdhole mdexd)  
 fimdc = geomOr(mdexd mdholespace)  
 fimdc_sz1     = geomSize(  fimdc -1 downUp   )
 fimdc_sz1_sz1 = geomSize(  fimdc_sz1 -MS_R_1_W_s downUp   )
 fimdy = geomAnd(fimdc_sz1_sz1 fimdc)  
 lmdx = geomEncloseRect( fimdy MS_R_1_L MS_R_1_W )   
 mdholed = geomAnd(mdholespace lmdx)  
 mdexd_sz1 =  geomWidth(  mdexd keep > 2   )   
 mdexd_sz1_sz1 =  geomWidth(  mdexd_sz1 keep > 0   )   
 msr1md_x = geomAnd(mdexd_sz1_sz1 mdexd)  
 errorLayer( geomEncloseRect( msr1md_x MS_R_1_L MS_R_1_W ) 
	"MS.R.1.MD  Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad/INDDMY areas are excluded.    ")  
geomConnect( incremental
	buttOrOver(mdholed lmdx)
)
processAntenna(
	gate((lmdx mdholed))
        antenna( mdholed )
        ratio = mdholed.area/lmdx.area
 MS_DN_1_MD = drcAntenna( mdholed lmdx ratio keep < MS_DN_1
                        suppressErrorMessage
                      )
 ) ;end of processAntenna
 MS_DN_1_MD_zero = geomAvoiding( lmdx mdholed )
 MS_DN_1_MD = geomOr( MS_DN_1_MD_zero MS_DN_1_MD_lmdx )
 errorLayer( MS_DN_1_MD  	"MS.DN.1.MD  Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%   ") 
/*  MS.R.2.MD is not able to check */
) ; 
/* CTM CHECKS */
/* ========== */
if((UTM == 1) then
 vcap = geomCat(via6)   
mcap = geomCat( m7 )
geomStamp(mcap m7x)  
 dmcap = geomCat(dum7)   
 mbot = geomCat(m6)   
else;/* UTM */
 vcap = geomCat(via7)   
mcap = geomCat( m8 )
geomStamp(mcap m8x)  
 dmcap = geomCat(dum8)   
 mbot = geomCat(m7)   
) ; /* UTM */
 via_ctm = geomAnd(vcap ctm)  
 vcap_and1 =  geomAnd(vcap cbm)  
 via_cbm = geomAndNot(vcap_and1 ctm)  
 via_ctmdmy = geomAnd(vcap ctmdmy)  
 mcap_ctmdmy = geomAnd(mcap ctmdmy)  
 dmcap_ctmdmy = geomAnd(dmcap ctmdmy)  
 mbot_ctmdmy = geomButtOrOver( mbot ctmdmy  )   
 drc( ctm   width < CTM_W_1  withCornerTouch 
	"CTM.W.1  Width(minimum) >= ^CTM_W_1 um.  ")  
 errorLayer( geomEncloseRect( ctm CTM_W_2+GRID GRID manhattanOnly) 
	"CTM.W.2  Width(maximum for either length or width) >= ^CTM_W_2 um.  ")  
 drc( ctm   sepNotch < CTM_S_1  
	"CTM.S.1  Space >= ^CTM_S_1 um.  ")  
 drc( ctm vcap  enc < CTM_EN_1  shielded withIntersection withSingularPoint 
	"CTM.EN.1  Enclosure of Vcap >= ^CTM_EN_1 um. ")  
 errorLayer( geomStraddle(vcap ctm) 
	"CTM.EN.1  Enclosure of Vcap >= ^CTM_EN_1 um. ") 
 drc( cbm ctm  enc < CTM_EN_2  shielded withIntersection withSingularPoint 
	"CTM.EN.2  Enclosure by CBM >= ^CTM_EN_2 um. ")  
 errorLayer( geomGetEdge(ctm outside cbm) 
	"CTM.EN.2  Enclosure by CBM >= ^CTM_EN_2 um. ")  
 errorLayer( geomAndNot(ctm cbm) 
	"CTM.EN.2 2  Enclosure by CBM >= ^CTM_EN_2 um. ") 
 drc( ctm via_cbm  sep < CTM_S_2  shielded withIntersection withSingularPoint 
	"CTM.S.2  CTM space to {Vcap outside CTM} >= ^CTM_S_2 um. ")  
/* CTM.R.1 is checked by CTM.EN.2 */
 drc( via_ctm   sepNotch < CTM_S_3  
	"CTM.S.3  {Vcap inside CTM} space to {Vcap inside CTM} >= ^CTM_S_3 um. ")  
/* CTM.R.2 can not be checked by drc */
/* CTM.R.3 VIA dimension is checked by VIA7.W.1,thickness can not be checked by drc */
/* CBM CHECKS */
/* ========== */
 ctmdmy_dn_s = drc( ctmdmy  area <= 40000 ) 
 ctmdmy_dn_w = geomAndNot(ctmdmy ctmdmy_dn_s)  
 ctmdmy_s = drc( ctmdmy  area <= CBM_S_1W ) 
 ctmdmy_w = geomAndNot(ctmdmy ctmdmy_s)  
 cbm_s = geomAnd(cbm ctmdmy_s)  
 cbm_w = geomAnd(cbm ctmdmy_w)  
 drc( cbm   width < CBM_W_1  withCornerTouch 
	"CBM.W.1  Width (minimum) >= ^CBM_W_1 um.  ")  
 errorLayer( geomEncloseRect( cbm CBM_W_2+GRID GRID manhattanOnly) 
	"CBM.W.2  Width (maximum for either length or width) >= ^CBM_W_1 um.  ")  
 drc( cbm via_cbm  enc < CBM_EN_1  shielded withIntersection withSingularPoint 
	"CBM.EN.1  Enclosure of Vcap >= ^CBM_EN_1 um. ")  
 errorLayer( geomStraddle(via_cbm cbm) 
	"CBM.EN.1  Enclosure of Vcap >= ^CBM_EN_1 um. ") 
 cbmen2_a = geomSize( cbm CBM_EN_2 noClipAcute )   
 errorLayer( geomXor(cbmen2_a ctmdmy) 
	"CBM.EN.2  One DRC checking layer (CTMDMY, GDS layer 148) is needed to specify the MiM capacitor region; special Mcap and Vcap design rules will be defined inside this area. CTMDMY is equal to CBM layer sizing up ^CBM_EN_2 um for each side. ") 
 drc( cbm_s   sepNotch < CBM_S_1A  
	"CBM.S.1  1. Space (For CTMDMY area <= ^CBM_S_1W m2) >= ^CBM_S_1A um, 2. Space (For CTMDMY area > ^CBM_S_1W m2) >= ^CBM_S_1B um ")  
 drc( cbm_w   sepNotch < CBM_S_1B  
	"CBM.S.1 2  1. Space (For CTMDMY area <= ^CBM_S_1W m2) >= ^CBM_S_1A um, 2. Space (For CTMDMY area > ^CBM_S_1W m2) >= ^CBM_S_1B um ")  
 cbmdn1_mcap_w = geomAnd(mcap ctmdmy_dn_w)  

processCoverage(
	backup
         
        measure( 
             windowSize = CBM_DN_1W stepSize = CBM_DN_1S
            cbmdn1_mcap_w_den2_pc = calculate( area(cbmdn1_mcap_w) / area(ctmdmy_dn_w))
            cbmdn1_mcap_w_den2 = output( cbmdn1_mcap_w_den2_pc squareSize = CBM_DN_1W 0 <=  keep < CBM_DN_1)
        ); end measure
); end processCoverage
  cbmdn11_error_window = cbmdn1_mcap_w_den2  
 error_window1 =  geomAnd(cbmdn11_error_window ctmdmy_dn_w)  
 drc( error_window1  area >= CBM_DN_1A 
	"CBM.DN.1  When CTMDMY area > 40,000 um2, {Mcap inside CTMDMY} density range over any 200 um x 200 um area (checked by stepping in 100 um increments). >= ^CBM_DN_1 This rule is only applied to the overlapped area of checking window and CTMDMY >= ^CBM_DN_1A um2 ") 
/* CBM.DN.2 is checked by logic metal density check. */
 drc( via_cbm   sepNotch < CBM_S_2  
	"CBM.S.2  {Vcap inside CBM} space to {Vcap inside CBM} >= ^CBM_S_2 um. ")  
 cbmw3_a = geomButtOrOver( mcap ctmdmy  )   
 cbmw31_b = drc( cbmw3_a   width < CBM_W_3  withCornerTouch )
 errorLayer( geomAnd(cbmw31_b ctmdmy) 
	"CBM.W.3  Width of {Mcap inside CTMDMY} >= ^CBM_W_3 um. ") 
 drc( mcap_ctmdmy   sepNotch < CBM_S_3  
	"CBM.S.3  Space of {Mcap inside CTMDMY} >= ^CBM_S_3 um. ")  
mcap_ctmdmy_shr1 =  geomGrow( mcap_ctmdmy -5 0 0 0 ) 
mcap_ctmdmy_shr11 =  geomGrow( mcap_ctmdmy_shr1 0 0 -5 0 ) 
mcap_ctmdmy_shr111 =  geomGrow( mcap_ctmdmy_shr11 0 -5 0 0 ) 
cbms4_mcap_s5 = geomGrow( mcap_ctmdmy_shr111 0 0 0 -5 ) 
mcap_s5_gro1 =  geomGrow( cbms4_mcap_s5 5 0 0 0 ) 
mcap_s5_gro11 =  geomGrow( mcap_s5_gro1 0 0 5 0 ) 
mcap_s5_gro111 =  geomGrow( mcap_s5_gro11 0 5 0 0 ) 
cbms41_mcap_g5 = geomGrow( mcap_s5_gro111 0 0 0 5 ) 
 cbms42_mcap_wide = geomAnd(cbms41_mcap_g5 mcap)  
cbms43_mcap_exp = geomSizeAnd( cbms42_mcap_wide mcap 0.644 2 )  
 cbms44_mcap_branch = geomAndNot(cbms43_mcap_exp cbms42_mcap_wide)  
 cbms45_mcap_branch_edge = geomGetEdge(cbms44_mcap_branch coincident mcap)   
 mcap_exp_sz1 =  geomSize( cbms43_mcap_exp CBM_S_4 noClipAcute )   
 cbms46_mcap_check = geomAnd(mcap mcap_exp_sz1)  
 mcap_branch_edge1 =  geomSize(cbms45_mcap_branch_edge CBM_S_4 edges)   
 cbms47_mcap_branch_check = geomAnd(mcap mcap_branch_edge1)  
cbms48_mcap_widec = geomCat( cbms42_mcap_wide )
geomStamp(cbms48_mcap_widec mcap)  
cbms49_mcap_checkc = geomCat( cbms46_mcap_check )
geomStamp(cbms49_mcap_checkc mcap)  
cbms410_mcap_branchc = geomCat( cbms44_mcap_branch )
geomStamp(cbms410_mcap_branchc mcap)  
cbms411_mcap_branch_checkc = geomCat( cbms47_mcap_branch_check )
geomStamp(cbms411_mcap_branch_checkc mcap)  
 drc( cbms48_mcap_widec cbms49_mcap_checkc 0 < sep < CBM_S_4  diffNet withIntersection 
	"CBM.S.4  Inside the CTMDMY region, Mcap space to wide Mcap (both Mcap line width and length > 10 um), or wide Mcap branch (a small piece of Mcap is connected to wide Mcap within 2.0 um range from the wide Mcap) >= ^CBM_S_4 um  ")  
 drc( cbms410_mcap_branchc cbms411_mcap_branch_checkc 0 < sep < CBM_S_4  diffNet withIntersection 
	"CBM.S.4 2  Inside the CTMDMY region, Mcap space to wide Mcap (both Mcap line width and length > 10 um), or wide Mcap branch (a small piece of Mcap is connected to wide Mcap within 2.0 um range from the wide Mcap) >= ^CBM_S_4 um  ")  
 cbmen3_a = geomInside( vcap ctmdmy  )   
 cbmen31_b = geomButtOrOver( mcap cbmen3_a  )   
 drc( cbmen31_b cbmen3_a  enc < CBM_EN_3  shielded withIntersection withSingularPoint 
	"CBM.EN.3  {Vcap inside CTMDMY} Enclosure by Mcap >= ^CBM_EN_3 um ")  
 errorLayer( geomGetEdge(cbmen3_a outside cbmen31_b) 
	"CBM.EN.3  {Vcap inside CTMDMY} Enclosure by Mcap >= ^CBM_EN_3 um ")  
 errorLayer( geomEnclose( ctm vcap keep == 1 ) 
	"CBM.R.1  Single Vcap is not allowed on one CTM or CBM or Mcap or Mcap-1 inside CTMDMY.			 ")  
 errorLayer( geomEnclose( cbm via_cbm keep == 1 ) 
	"CBM.R.1 2  Single Vcap is not allowed on one CTM or CBM or Mcap or Mcap-1 inside CTMDMY.			 ")  
 cbmr1_a = geomEnclose( mbot_ctmdmy vcap keep == 1 )   
 errorLayer( geomAnd(via_ctmdmy cbmr1_a) 
	"CBM.R.1 3  Single Vcap is not allowed on one CTM or CBM or Mcap or Mcap-1 inside CTMDMY.			 ") 
 cbmr11_b = geomEnclose( mcap_ctmdmy vcap keep == 1 )   
 errorLayer( geomAnd(via_ctmdmy cbmr11_b) 
	"CBM.R.1 4  Single Vcap is not allowed on one CTM or CBM or Mcap or Mcap-1 inside CTMDMY.			 ") 
/* CBM.R.2 is not necessary to check */
 errorLayer( geomAnd(mbot cbm) 
	"CBM.R.3  Mcap-1 under CBM region is not allowed ") 
 drc( mbot cbm  sep < CBM_S_5  shielded withIntersection withSingularPoint 
	"CBM.S.5  Space to Mcap-1 >= ^CBM_S_5 um. ")  
M1_DN_5 = 0.15
 cbm_sz1 =  geomSize( cbm 25 noClipAcute )   
 m1dn5_cbm_merge = geomSize( cbm_sz1 -25 noClipAcute )   
 m1dn5_check_cbm = drc( m1dn5_cbm_merge  area >= 200* 200 ) 
 m1dn5_m1_check = geomAnd(m1 m1dn5_check_cbm)  
 m1dn5_m2_check = geomAnd(m2 m1dn5_check_cbm)  
 m1dn5_m3_check = geomAnd(m3 m1dn5_check_cbm)  
geomConnect( incremental
	buttOrOver(m1dn5_check_cbm m1dn5_m1_check)
	buttOrOver(m1dn5_check_cbm m1dn5_m2_check)
	buttOrOver(m1dn5_check_cbm m1dn5_m3_check)
)
processAntenna(
	gate((m1dn5_check_cbm m1dn5_m1_check))
        antenna( m1dn5_m1_check )
        ratio = m1dn5_m1_check.area/m1dn5_check_cbm.area
m1dn5_a = drcAntenna( m1dn5_m1_check m1dn5_check_cbm ratio keep < M1_DN_5  suppressErrorMessage  )
)
m1dn5_a_1 =  geomNodeRelate( m1dn5_check_cbm m1dn5_a_m1dn5_check_cbm disc )
m1dn5_a = geomCat( m1dn5_a_1 m1dn5_a_m1dn5_check_cbm )  
processAntenna(
	gate((m1dn5_check_cbm m1dn5_m2_check))
        antenna( m1dn5_m2_check )
        ratio = m1dn5_m2_check.area/m1dn5_check_cbm.area
m1dn51_b = drcAntenna( m1dn5_m2_check m1dn5_check_cbm ratio keep < M1_DN_5  suppressErrorMessage  )
)
m1dn51_b_1 =  geomNodeRelate( m1dn5_check_cbm m1dn51_b_m1dn5_check_cbm disc )
m1dn51_b = geomCat( m1dn51_b_1 m1dn51_b_m1dn5_check_cbm )  
processAntenna(
	gate((m1dn5_check_cbm m1dn5_m3_check))
        antenna( m1dn5_m3_check )
        ratio = m1dn5_m3_check.area/m1dn5_check_cbm.area
m1dn52_c = drcAntenna( m1dn5_m3_check m1dn5_check_cbm ratio keep < M1_DN_5  suppressErrorMessage  )
)
m1dn52_c_1 =  geomNodeRelate( m1dn5_check_cbm m1dn52_c_m1dn5_check_cbm disc )
m1dn52_c = geomCat( m1dn52_c_1 m1dn52_c_m1dn5_check_cbm )  
 a_and1 =  geomAnd(m1dn5_a m1dn51_b)  
 errorLayer( geomAnd(a_and1 m1dn52_c) 
	"M1.DN.5  It is not allowed to have local density < ^M1_DN_5 of all 3 consecutive metal (M1,M2,M3) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um ") 
M2_DN_5 = 0.15
 cbm_sz2 =  geomSize( cbm 25 noClipAcute )   
 m2dn5_cbm_merge = geomSize( cbm_sz2 -25 noClipAcute )   
 m2dn5_check_cbm = drc( m2dn5_cbm_merge  area >= 200* 200 ) 
 m2dn5_m2_check = geomAnd(m2 m2dn5_check_cbm)  
 m2dn5_m3_check = geomAnd(m3 m2dn5_check_cbm)  
 m2dn5_m4_check = geomAnd(m4 m2dn5_check_cbm)  
geomConnect( incremental
	buttOrOver(m2dn5_check_cbm m2dn5_m2_check)
	buttOrOver(m2dn5_check_cbm m2dn5_m3_check)
	buttOrOver(m2dn5_check_cbm m2dn5_m4_check)
)
processAntenna(
	gate((m2dn5_check_cbm m2dn5_m2_check))
        antenna( m2dn5_m2_check )
        ratio = m2dn5_m2_check.area/m2dn5_check_cbm.area
m2dn5_a = drcAntenna( m2dn5_m2_check m2dn5_check_cbm ratio keep < M2_DN_5  suppressErrorMessage  )
)
