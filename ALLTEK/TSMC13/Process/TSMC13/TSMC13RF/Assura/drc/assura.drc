 m3dn3_m3cell_or1 =  geomOr(m3dn3_m3cell m3dn3_m3marker)  
 m3dn3_m3 = geomAndNot(m3dn3_m3cell_or1 block)  
 dm3dn3_m3cell = geomAnd(dm3dn3_m3cellin dm3dn3_m3cellout)  
 dm3dn3_m3marker = geomAnd(dum3 rrulerecommended)  
