	backup
         
        measure( 
             windowSize = 100 stepSize = 50
            am1dn3_m1_den2_pc = calculate( area(am1dn3_m1) / area(chip))
            am1dn3_m1_den2 = output( am1dn3_m1_den2_pc squareSize = 100 0 <=  keep < 0.15)
        ); end measure
); end processCoverage
  err_m1_d0 = am1dn3_m1_den2  
 m2dn3_m2cell = geomAnd(m2dn3_m2cellin m2dn3_m2cellout)  
 m2dn3_m2marker = geomAnd(metal2i rrulerecommended)  
 m2dn3_m2cell_or1 =  geomOr(m2dn3_m2cell m2dn3_m2marker)  
 m2dn3_m2 = geomAndNot(m2dn3_m2cell_or1 block)  
