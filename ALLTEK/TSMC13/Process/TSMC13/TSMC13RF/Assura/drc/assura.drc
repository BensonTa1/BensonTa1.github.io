            m1_not_exc_den2_pc = calculate( area(m1_not_exc) / area(chip_not_m1_exc))
            m1_not_exc_den2 = output( m1_not_exc_den2_pc squareSize = 200  keep > M1_DN_1H)
        ); end measure
); end processCoverage
  m1dn1h_d0 = m1_not_exc_den2  
