/*  For NW checks */
 nrodi = geomAndNot(odi rpdmy)  /* exclude OD resistor region */
 npodi = geomAnd(nimpi nrodi)  
 nonwri = geomAndNot(nwelli geomButtOrOver(nwelli nwdmy ))  /*  for NW.S.1/NW.S.2/NW.S.3 */ 
 ppodi = geomAnd(pimpi nrodi)  
 imp = geomOr(np pp)  
