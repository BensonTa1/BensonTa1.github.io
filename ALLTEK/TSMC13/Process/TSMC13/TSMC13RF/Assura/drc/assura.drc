	"ESD.6g  Butted STRAP and the STRAP which are between two sources of the N/PMOS in the same I/O buffer and Power Clamp are strictly prohibited.  ")  
epmosc_ext1 =  drc( epmosc  sep < ESD_6g  opposite  sameNet 0 < withIntersection  )
 esd6g1_b = geomAndNot(epmosc_ext1 geomButtOrOver(epmosc_ext1 gate ))   
 errorLayer( geomButtOrOver( esd6g1_b nstpi  ) 
	"ESD.6g 2  Butted STRAP and the STRAP which are between two sources of the N/PMOS in the same I/O buffer and Power Clamp are strictly prohibited.  ")  
 nwelc = geomCat(nwel)   
 nwelc_con1 = geomCat(nwelc)
geomStamp(nwelc nwel)
 pwelc = geomCat(pwel)   
 pwelc_con1 = geomCat(pwelc)
geomStamp(pwelc pwel)
geomStamp( psd_iopad psdiu )
 geomStamp( nsd_iopad nsdiu )
 pact_iact1 =  geomButtOrOver( pact psd_iopad  )   
 esd7g_pact_check = geomAndNot(pact_iact1 epmos)  
esd7g1_pact_check_cb = geomCat( esd7g_pact_check )
geomStamp(esd7g1_pact_check_cb psd_iopad)  
 esd7g2_p1 = drc( esd7g1_pact_check_cb   sep < ESD_7g  diffNet shielded )
 pact_check_iact1 =  geomButtOrOver( esd7g_pact_check esd7g2_p1  )   
esd7g3_pact_check_nw = geomCat( pact_check_iact1 )
geomStamp(esd7g3_pact_check_nw nwelc)  
 esd7g4_p2 = drc( esd7g3_pact_check_nw   sep < ESD_7g  sameNet shielded )
 esd7g5_esd_p3 = geomAnd(esd7g2_p1 esd7g4_p2)  
 esd_p3_not1 =  geomAndNot(esd7g5_esd_p3 nstpi)  
   geomStamp(esd_p3_not1 esd7g1_pact_check_cb buttOrOver ) 
 errorLayer( geomButtOrOver(esd_p3_not1 esd7g1_pact_check_cb diffNet )
 "ESD.7g Follow either of : 1. space of two same type ODs(ex. N+OD and N+OD in the same PW where connected to two different Pad) >= 2.4um 2. two same type ODs should be separated by different type OD.")
 nact_iact1 =  geomButtOrOver( nact nsd_iopad  )   
 esd7g6_nact_check = geomAndNot(nact_iact1 enmos)  
esd7g7_nact_check_cb = geomCat( esd7g6_nact_check )
geomStamp(esd7g7_nact_check_cb nsd_iopad)  
 esd7g8_n1 = drc( esd7g7_nact_check_cb   sep < ESD_7g  diffNet shielded )
 nact_check_iact1 =  geomButtOrOver( esd7g6_nact_check esd7g8_n1  )   
esd7g9_nact_check_pw = geomCat( nact_check_iact1 )
geomStamp(esd7g9_nact_check_pw pwelc)  
 esd7g10_n2 = drc( esd7g9_nact_check_pw   sep < ESD_7g  sameNet shielded )
 esd7g11_esd_n3 = geomAnd(esd7g8_n1 esd7g10_n2)  
 esd_n3_not1 =  geomAndNot(esd7g11_esd_n3 pstpi)  
    geomStamp(esd_n3_not1 esd7g7_nact_check_cb buttOrOver ) 
 errorLayer(  geomButtOrOver( esd_n3_not1 esd7g7_nact_check_cb diffNet )
 "ESD.7g Follow either of : 1. space of two same type ODs(ex. N+OD and N+OD in the same PW where connected to two different Pad) >= 2.4um 2. two same type ODs should be separated by different type OD.")
/*  ESD.8g, ESD.9g, ESD.10g, and ESD.11g can not be checked by DRC */
 od_not2 =  geomAndNot(od poly)  
 od_not2_iact1 =  geomButtOrOver( od_not2 odres_a  )   
