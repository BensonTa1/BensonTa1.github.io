 gnd_m8iu_by_text = geomGetTexted( m8x m8pin "VSS?" )  
 pad_m8iu_by_text = geomGetTexted( m8x m8pin "?" )  
 pwr_mdiu_by_text = geomGetTexted( mdx mdpin "VDD?" )  
 gnd_mdiu_by_text = geomGetTexted( mdx mdpin "VSS?" )  
 pad_mdiu_by_text = geomGetTexted( mdx mdpin "?" )  
