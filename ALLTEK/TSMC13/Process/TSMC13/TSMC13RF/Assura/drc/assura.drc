	"M5.DN.5  It is not allowed to have local density < ^M5_DN_5 of all 3 consecutive metal (M5,M6,M7) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um ") 
) ; 
/* METAL DENSITY RULES  */
/* =================== */
 chipu10 = geomSize( chip 10 noClipAcute )   
 chipu20 = geomSize( chip 20 noClipAcute )   
 chipu30 = geomSize( chip 30 noClipAcute )   
 chipu40 = geomSize( chip 40 noClipAcute )   
 chipu50 = geomSize( chip 50 noClipAcute )   
 chipu60 = geomSize( chip 60 noClipAcute )   
 chipu70 = geomSize( chip 70 noClipAcute )   
 chipu80 = geomSize( chip 80 noClipAcute )   
 chipu90 = geomSize( chip 90 noClipAcute )   
 m1_den_exc = geomCat(metal_den_exc)   
 m2_den_exc = geomCat(metal_den_exc)   
 m3_den_exc = geomCat(metal_den_exc)   
 m4_den_exc = geomCat(metal_den_exc)   
 m5_den_exc = geomCat(metal_den_exc)   
if((UTM == 1) then
 m6_den_exc = geomOr(metal_den_exc ctmdmy)  
 m7_den_exc = geomCat(metal_den_exc)   
else;/* UTM */
 m6_den_exc = geomCat(metal_den_exc)   
 m7_den_exc = geomOr(metal_den_exc ctmdmy)  
) ; /* UTM */
 m1_not_exc = geomAndNot(all_m1 m1_den_exc)  
 chip_not_m1_exc = geomAndNot(chipx m1_den_exc)  
if((CHECK_DENSITY_IN_DMxEXCL_ONLY == 1) then
 chip_and_dm1excl = geomAnd(dm1excl chip_not_m1_exc)  
 m1_and_dm1excl = geomAnd(all_m1 chip_and_dm1excl)  

processCoverage(
	backup
         
        measure( 
             windowSize = 200 stepSize = 100
            m1_and_dm1excl_den2_pc = calculate( area(m1_and_dm1excl) / area(chip_and_dm1excl))
            m1_and_dm1excl_den2 = output( m1_and_dm1excl_den2_pc squareSize = 200 0 <=  keep < DM1_DN_2L)
        ); end measure
); end processCoverage
  dm1dn2l_err_win = m1_and_dm1excl_den2  
 err_win_and1 =  geomAnd(dm1dn2l_err_win dm1excl)  
 dm1dn2l1_f = drc( err_win_and1  area >= 10000 ) 
 processCoverage( 
	backup
         
 measure(
          windowSize = 200 stepSize = 100
     chip_and_dm1excl_den3_pc =  calculate(
           if( area(dm1dn2l1_f) > 0   then
             area(m1_and_dm1excl) / area(chip_and_dm1excl)
                    
               else
                    -1
             )
            ) 
            chip_and_dm1excl_den3 = output( chip_and_dm1excl_den3_pc squareSize = 200 0 <=  keep < DM1_DN_2L)

         ) ;end measure
 ) ;end processCoverage
 errorLayer( chip_and_dm1excl_den3 
	"DM1.DN.2L  M1 local density range within DM1EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um >= ^DM1_DN_2L  ") ;


processCoverage(
	backup
         
        measure( 
             windowSize = 200 stepSize = 100
            m1_and_dm1excl_den2_pc = calculate( area(m1_and_dm1excl) / area(chip_and_dm1excl))
            m1_and_dm1excl_den2 = output( m1_and_dm1excl_den2_pc squareSize = 200  keep > DM1_DN_2H)
        ); end measure
); end processCoverage
  dm1dn2h_err_win = m1_and_dm1excl_den2  
 err_win_and2 =  geomAnd(dm1dn2h_err_win dm1excl)  
drc( err_win_and2 area >= 10000
	"DM1.DN.2H  M1 local density range within DM1EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um <= ^DM1_DN_2H ") ;

else;

processCoverage(
	backup
         
        measure( 
             windowSize = 200 stepSize = 100
            m1_not_exc_den2_pc = calculate( area(m1_not_exc) / area(chip_not_m1_exc))
            m1_not_exc_den2 = output( m1_not_exc_den2_pc squareSize = 200 0 <=  keep < M1_DN_1L)
        ); end measure
); end processCoverage
  m1dn1l_d0 = m1_not_exc_den2  
 m1dn1l1_d = geomContactCheck( m1dn1l_d0 length == 200  swap allWithTolerance=1.0)   
 d0_not3 =  geomAndNot(m1dn1l_d0 m1dn1l1_d)  
 m1dn1l2_err1 = geomAndNot(d0_not3 m1_den_exc)  
 m1dn1l3_f1 = drc( m1dn1l2_err1  area >= 10000 ) 

processCoverage(
	backup
        withinLayer( chipu10 )
        measure( 
             windowSize = 200 stepSize = 100
            m1_not_exc_den2_pc = calculate( area(m1_not_exc) / area(chip_not_m1_exc))
            m1_not_exc_den2 = output( m1_not_exc_den2_pc squareSize = 200 0 <=  keep < M1_DN_1L)
        ); end measure
); end processCoverage
  m1dn1l4_d1 = m1_not_exc_den2  

processCoverage(
	backup
        withinLayer( chipu20 )
