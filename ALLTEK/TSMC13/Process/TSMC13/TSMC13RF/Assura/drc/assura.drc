if((DISCONNECT_AFTER_RESISTOR == 1) then
 nstpiu = geomAndNot(nstpi emptyi)  
 pstpiu = geomAndNot(pstpi emptyi)  
 nsdiu = geomAndNot(nsdc emptyi)  
 psdiu = geomAndNot(psdc emptyi)  
 cbiu = geomAndNot(padi emptyi)  
