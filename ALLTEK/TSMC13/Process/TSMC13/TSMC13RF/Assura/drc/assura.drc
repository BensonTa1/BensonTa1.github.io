 g_diode = geomButtOrOver( mos gate_iact3_iact1  )   
 dact_not2 =  geomAndNot(dact geomButtOrOver(dact odres_a ))   
 dact_not2_not1 =  geomAndNot(dact_not2 geomButtOrOver(dact_not2 rnwel ))   
 dact_not2_not11 =  geomAndNot(dact_not2_not1 dummy_mos)  
 dact_not2_not111 =  geomAndNot(dact_not2_not11 g_diode)  
