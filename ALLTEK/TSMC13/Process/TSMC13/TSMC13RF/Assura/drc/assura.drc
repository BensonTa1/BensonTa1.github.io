 nwrstir1m_nwcell1 =  geomOr(nwrstir1m_nwcell nwrstir1m_nwmarker)  
 nwrstir1m_nwcell11 =  geomAndNot(nwrstir1m_nwcell1 geomInside(nwrstir1m_nwcell1 sram_exclude ))   
 nwrstir1m_nw = geomOutside( nwrstir1m_nwcell11 block  )   
 nwrstir1m_nw1 =  geomAnd(nwrstir1m_nw nwres_sti)  
