geomStamp(esd12g1_odrut cou)  
  processAntenna(
	gate((esd12g1_odrut esd12g1_odrut))
        antenna( esd12g1_odrut cbu cb2u ubmnu ubmdu   )
        ratio = zerop(zerop( esd12g1_odrut.area ))*(zerop(zerop( cbu.area ))+zerop(zerop( cb2u.area ))+zerop(zerop( ubmnu.area ))+zerop(zerop( ubmdu.area )))
 
 ESD12G = drcAntenna( esd12g1_odrut (esd12g1_odrut) ratio keep > 0 suppressErrorMessage )   
)
	errorLayer( geomCat(ESD12G_esd12g1_odrut) "ESD.12g  It is not allowed to use OD RPO resistor or NW resistor connected to PAD ")

  processAntenna(
	gate((nwrut nwrut))
        antenna( nwrut cbu cb2u ubmnu ubmdu   )
        ratio = zerop(zerop( nwrut.area ))*(zerop(zerop( cbu.area ))+zerop(zerop( cb2u.area ))+zerop(zerop( ubmnu.area ))+zerop(zerop( ubmdu.area )))
 
 ESD12G_1 = drcAntenna( nwrut ( nwrut ) ratio keep > 0 suppressErrorMessage )   
)
	errorLayer( geomCat(ESD12G_1_nwrut) "ESD.12g 2  It is not allowed to use OD RPO resistor or NW resistor connected to PAD ")

/*  ESD.13g, ESD.14g, and ESD.15g can not be checked by DRC */
/*  Regular I/O */
/* ============ */
 newsdi = geomAndNot(sdi geomButtOrOver( sdi rpo keep == 2 ) )
 esd_gate_w = geomGetEdge(gate_w inside newsdi)
 esd_pmos_gate_w = geomGetEdge(esd_gate_w inside pp)   
 esd_nmos_gate_w = geomGetEdge(esd_gate_w inside np)   
 esd_pmos_gate_w_exp = geomSize(esd_pmos_gate_w -GRID edges)   
 esd_nmos_gate_w_exp = geomSize(esd_nmos_gate_w -GRID edges)   
esd_pmos_gate_w_expc = geomCat( esd_pmos_gate_w_exp )
 geomStamp( esd_pmos_gate_w_expc epmosc floating "esd_pmos_gate_w_exp_floating" suppressErrorMessage )
 esd_pmos_gate_w_expc = geomAndNot( esd_pmos_gate_w_expc esd_pmos_gate_w_exp_floating )
esd_nmos_gate_w_expc = geomCat( esd_nmos_gate_w_exp ) 
geomStamp( esd_nmos_gate_w_expc enmosc floating "esd_nmos_gate_w_exp_floating" suppressErrorMessage )
 esd_nmos_gate_w_expc = geomAndNot( esd_nmos_gate_w_expc esd_nmos_gate_w_exp_floating )

 processAntenna(
	gate(( esd_nmos_gate_w_expc esd_nmos_gate_w_expc))
        antenna( esd_nmos_gate_w_expc   )
        ratio = (( esd_nmos_gate_w_expc.area )/2)/GRID
 	ERR = drcAntenna( esd_nmos_gate_w_expc ( esd_nmos_gate_w_expc ) ratio keep <  ESD_16g suppressErrorMessage ) 
)
 errorLayer( geomCat( ERR_esd_nmos_gate_w_expc )
     		"ESD.16g Total finger width for NMOS in same connection of drain > ^ESD_16g um [check ESD.24g also]"
         )
  processAntenna(
        gate((esd_pmos_gate_w_expc esd_pmos_gate_w_expc))
        antenna( esd_pmos_gate_w_expc  )
        ratio = (( esd_pmos_gate_w_expc.area )/2)/GRID
 ESD_17G = drcAntenna( esd_pmos_gate_w_expc (esd_pmos_gate_w_expc) ratio keep < ESD_17g suppressErrorMessage )
)
 errorLayer( geomCat( ESD_17G_esd_pmos_gate_w_expc )
        "ESD.17g Total finger width for PMOS in same connection of drain > ^ESD_17g um [check ESD.25g also]"
 )
                                                                                
 reg_egte_hv = geomAnd(reg_egte od2)  
 reg_egte_lv = geomAndNot(reg_egte od2)  
if((HIGH_VOLTAGE == 3.3) then
 drc( reg_egte_hv   width < ESD_18g_33V  withCornerTouch 
	"ESD.18g 2  Channel length of 3.3V I/O >= ^ESD_18g_33V Channel length of 2.5V I/O >= ^ESD_18g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_18g_LV ")  
) ; 
if((HIGH_VOLTAGE == 2.5) then
 drc( reg_egte_hv   width < ESD_18g_25V  withCornerTouch 
	"ESD.18g 5  Channel length of 3.3V I/O >= ^ESD_18g_33V Channel length of 2.5V I/O >= ^ESD_18g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_18g_LV ")  
) ; 
 drc( reg_egte_lv   width < ESD_18g_LV  withCornerTouch 
	"ESD.18g 7  Channel length of 3.3V I/O >= ^ESD_18g_33V Channel length of 2.5V I/O >= ^ESD_18g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_18g_LV ")  
/*  ESD.19g can not be checked by DRC */
 errorLayer( geomOutside( reg_egte rpo  ) 
	"ESD.20g  Overlap of RPO on the drain side to the poly gate for Regular I/O == ^ESD_20g um ")  
 esd20g_reg_egte_w = geomGetEdge(reg_egte inside od)   
 esd20g1_x = geomGetEdge(esd20g_reg_egte_w inside rpo)   
 esd20g2_y = geomSize(esd20g1_x -ESD_20g edges)   
 esd20g1_x_sz1 = geomSize(esd20g1_x 0.005 edges)
 errorLayer( geomButtOrCoin( reg_egte esd20g1_x_sz1  keep > 1) 
	"ESD.20g 2  Overlap of RPO on the drain side to the poly gate for Regular I/O == ^ESD_20g um ")  
 reg_egte_and1 =  geomAnd(reg_egte rpo)  
 errorLayer( geomXor(reg_egte_and1 esd20g2_y) 
	"ESD.20g 3  Overlap of RPO on the drain side to the poly gate for Regular I/O == ^ESD_20g um ") 
 ensd_iact1 =  geomButtOrOver( ensd reg_egte  )   
 esd21g_reg_ensd = geomAnd(ensd_iact1 rpo)  
 drc( esd21g_reg_ensd   width < ESD_21g  withCornerTouch 
	"ESD.21g  Width of the RPO on drain side for NMOS Regular I/O >= ^ESD_21g um ")  
 epsd_iact1 =  geomButtOrOver( epsd reg_egte  )   
 esd22g_reg_epsd = geomAnd(epsd_iact1 rpo)  
 drc( esd22g_reg_epsd   width < ESD_22g  withCornerTouch 
	"ESD.22g  Width of the RPO on drain side for PMOS Regular I/O >= ^ESD_22g um ")  
 drc( eco reg_egte  sep < ESD_23g  shielded withIntersection withSingularPoint 
	"ESD.23g  Space of poly to CO on source side for Regular I/O >= ^ESD_23g um ")  
/*  HV Tolerant I/O */
/* ================ */
 tol_enod = geomButtOrOver( ensd tol_egte  )   
 tol_enod_not1 =  geomAndNot(tol_enod geomButtOrOver(tol_enod eco ))   
 tol_eng = geomAndNot(tol_enod_not1 geomButtOrOver(tol_enod_not1 pstp ))   
 tol_ensd = geomAndNot(tol_enod tol_eng)  
 tol_ens = geomOutside( tol_ensd rpo  )   
 tol_end = geomAndNot(tol_ensd geomOutside(tol_ensd rpo ))   
/*  ESD.24g is checked by ESD.16g */
/*  ESD.25g is checked by ESD.17g */
 tol_egte_hv = geomAnd(tol_egte od2)  
 tol_egte_lv = geomAndNot(tol_egte od2)  
if((HIGH_VOLTAGE == 3.3) then
 drc( tol_egte_hv   width < ESD_26g_5V  withCornerTouch 
	"ESD.26g.5V  Channel length for  5V NMOS/PMOS HV Tolerant I/O >= ^ESD_26g_5V um ")  
) ; 
if((HIGH_VOLTAGE == 2.5) then
 drc( tol_egte_hv   width < ESD_26g_33V  withCornerTouch 
	"ESD.26g.33V  Channel length of 3.3V NMOS/PMOS HV TOlerant I/O >= ^ESD_26g_33V ")  
) ; 
 errorLayer( geomAndNot(tol_egte geomButtOrOver(tol_egte rpo )) 
	"ESD.27g  The NMOS and PMOS should have an unsilicided area on the drain side.  That is, the RPO mask should block the drain side of the device. (except the contact region which should remain silicided). DRC only flags no RPO in this device. ")  
 esd28g_tol_engte1 = geomButtOrOver( tol_egte tol_end  )   
 esd28g1_tol_engte2 = geomButtOrOver( tol_egte tol_ens  )   
 errorLayer( geomAndNot(esd28g_tol_engte1 rpo) 
	"ESD.28g  Overlap of RPO on the drain side to the poly gate for NMOS HV Tolerant I/O == ^ESD_28g um ") 
 errorLayer( geomOutside( esd28g1_tol_engte2 rpo  ) 
	"ESD.28g 2  Overlap of RPO on the drain side to the poly gate for NMOS HV Tolerant I/O == ^ESD_28g um ")  
 errorLayer( geomAndNot(tol_eng geomButtOrOver(tol_eng esd28g1_tol_engte2 )) 
	"ESD.28g 3  Overlap of RPO on the drain side to the poly gate for NMOS HV Tolerant I/O == ^ESD_28g um ")  
 esd28g2_tol_engte2_w = geomGetEdge(esd28g1_tol_engte2 inside od)   
 esd28g3_x = geomGetEdge(esd28g2_tol_engte2_w inside rpo)   
 esd28g4_y = geomSize(esd28g3_x -ESD_28g edges)   
 tol_engte2_and1 =  geomAnd(esd28g1_tol_engte2 rpo)  
 errorLayer( geomXor(tol_engte2_and1 esd28g4_y) 
	"ESD.28g 4  Overlap of RPO on the drain side to the poly gate for NMOS HV Tolerant I/O == ^ESD_28g um ") 
 esd29g_tol_epgte = geomButtOrOver( tol_egte epsd  )   
 errorLayer( geomOutside( esd29g_tol_epgte rpo  ) 
	"ESD.29g  Overlap of RPO on the drain side to the poly gate for PMOS HV Tolerant I/O == ^ESD_29g um ")  
 esd29g1_tol_epgte_w = geomGetEdge(esd29g_tol_epgte inside od)   
 esd29g2_x = geomGetEdge(esd29g1_tol_epgte_w inside rpo)   
 esd29g3_y = geomSize(esd29g2_x -ESD_29g edges)   
 esd29g2_x_sz1 = geomSize(esd29g2_x 0.005 edges)
 errorLayer( geomButtOrCoin( esd29g_tol_epgte esd29g2_x_sz1  keep > 1) 
	"ESD.29g 2  Overlap of RPO on the drain side to the poly gate for PMOS HV Tolerant I/O == ^ESD_29g um ")  
 tol_epgte_and1 =  geomAnd(esd29g_tol_epgte rpo)  
 errorLayer( geomXor(tol_epgte_and1 esd29g3_y) 
	"ESD.29g 3  Overlap of RPO on the drain side to the poly gate for PMOS HV Tolerant I/O == ^ESD_29g um ") 
 esd30g_tol_ensd = geomAnd(tol_end rpo)  
 drc( esd30g_tol_ensd   width < ESD_30g  withCornerTouch 
	"ESD.30g  Width of the RPO on drain side for NMOS HV Tolerant I/O >= ^ESD_30g um ")  
 epsd_iact2 =  geomButtOrOver( epsd tol_egte  )   
 esd31g_tol_epsd = geomAnd(epsd_iact2 rpo)  
 drc( esd31g_tol_epsd   width < ESD_31g  withCornerTouch 
	"ESD.31g  Width of the RPO on drain side for PMOS HV Tolerant I/O >= ^ESD_31g um ")  
 drc( eco tol_egte  sep < ESD_32g  shielded withIntersection withSingularPoint 
	"ESD.32g  Space of poly to CO on source side for HV Tolerant I/O >= ^ESD_32g um ")  
 drc( tol_eng   width < ESD_33g  withCornerTouch 
	"ESD.33g  Space of poly gate(N2) to poly gate(N3) for NMOS HV Tolerant I/O == ^ESD_33g um ")  
 errorLayer( geomWidth(tol_eng keep  > ESD_33g) 
	"ESD.33g 2  Space of poly gate(N2) to poly gate(N3) for NMOS HV Tolerant I/O == ^ESD_33g um ")
 tol_egte_and1 =  geomAnd(tol_egte np)  
 errorLayer( geomAndNot(tol_egte_and1 geomButtOrOver(tol_egte_and1 tol_eng )) 
	"ESD.33g 3  Space of poly gate(N2) to poly gate(N3) for NMOS HV Tolerant I/O == ^ESD_33g um ")  
 errorLayer( geomAndNot(tol_enmos geomButtOrOver(tol_enmos esd3dmy )) 
	"ESD.34g  The NMOS HV Tolerant I/O should have ESD3DMY ")  
/*  ESD.35g can not be checked by DRC */
/*  Power Clamp */
/* ============ */
 pcl_gate_w = geomGetEdge(esd_gate_w inside pcl_enmos)   
 pcl_hv_gate_w = geomGetEdge(pcl_gate_w inside od2)   
 pcl_lv_gate_w = geomAndNot(pcl_gate_w geomGetEdge(pcl_gate_w inside od2))   
 pcl_hv_gate_w_exp = geomSize(pcl_hv_gate_w -GRID edges)   
 pcl_lv_gate_w_exp = geomSize(pcl_lv_gate_w -GRID edges)   
pcl_hv_gate_w_expc = geomCat( pcl_hv_gate_w_exp )
geomStamp(pcl_hv_gate_w_expc enmosc floating "pcl_hv_gate_w_expc_1" suppressErrorMessage )  
 pcl_hv_gate_w_expc = geomAndNot( pcl_hv_gate_w_expc pcl_hv_gate_w_expc_1 )
 pcl_lv_gate_w_expc = geomAndNot( pcl_lv_gate_w_exp geomButtOrOver( pcl_enmos pcl_lv_gate_w_exp  keep == 18 ) )

 geomStamp(pcl_lv_gate_w_expc enmosc floating "pcl_lv_gate_w_expc_1" suppressErrorMessage )  
 pcl_lv_gate_w_expc = geomAndNot( pcl_lv_gate_w_expc pcl_lv_gate_w_expc_1 )

  processAntenna(
	gate((pcl_hv_gate_w_expc pcl_hv_gate_w_expc))
        antenna( pcl_hv_gate_w_expc   )
        ratio = (( pcl_hv_gate_w_expc.area )/2)/GRID
 ESD_36G = drcAntenna( pcl_hv_gate_w_expc (pcl_hv_gate_w_expc) ratio keep < ESD_36g suppressErrorMessage )
)
 errorLayer( geomCat( ESD_36G_pcl_hv_gate_w_expc )
	"ESD.36g  Total finger width for 3.3V/2.5V Power Clamp in same connection of drain >= ^ESD_36g um ")

  processAntenna(
	gate((pcl_lv_gate_w_expc pcl_lv_gate_w_expc))
        antenna( pcl_lv_gate_w_expc   )
        ratio = (( pcl_lv_gate_w_expc.area )/2)/GRID
 ESD_37G = drcAntenna( pcl_lv_gate_w_expc (pcl_lv_gate_w_expc) ratio keep < ESD_37g suppressErrorMessage )
)
 errorLayer(geomCat( ESD_37G_pcl_lv_gate_w_expc )
	"ESD.37g Total finger width for 1.1V/0.9V Power Clamp in same connection of drain >= ^ESD_37g um ")

 pcl_egte_hv = geomAnd(pcl_egte od2)  
 pcl_egte_lv = geomAndNot(pcl_egte od2)  
if((HIGH_VOLTAGE == 3.3) then
 drc( pcl_egte_hv   width < ESD_38g_33V  withCornerTouch 
	"ESD.38g 2  Channel length for 3.3V NMOS/PMOS Power Clamp >= ^ESD_38g_33V um Channel length of 2.5V Power Clamp >= ^ESD_38g_25V Channel length of 1.0V/1.2V/1.5V Power Clamp >= ^ESD_38g_LV ")  
) ; 
if((HIGH_VOLTAGE == 2.5) then
 drc( pcl_egte_hv   width < ESD_38g_25V  withCornerTouch 
	"ESD.38g 5  Channel length for 3.3V NMOS/PMOS Power Clamp >= ^ESD_38g_33V um Channel length of 2.5V Power Clamp >= ^ESD_38g_25V Channel length of 1.0V/1.2V/1.5V Power Clamp >= ^ESD_38g_LV ")  
) ; 
 drc( pcl_egte_lv   width < ESD_38g_LV  withCornerTouch 
	"ESD.38g 7  Channel length for 3.3V NMOS/PMOS Power Clamp >= ^ESD_38g_33V um Channel length of 2.5V Power Clamp >= ^ESD_38g_25V Channel length of 1.0V/1.2V/1.5V Power Clamp >= ^ESD_38g_LV ")  
 drc( eco pcl_egte  sep < ESD_43g  shielded withIntersection withSingularPoint 
	"ESD.43g  Space of poly to CO on source side for Power Clamp >= ^ESD_43g um ")  
 egte_rpo = geomButtOrOver( egte rpo  )   
 epmos_iact2 =  geomButtOrOver( epmos rpo  )   
 regulario_type2_pmos = geomAndNot(epmos_iact2 geomButtOrOver(epmos_iact2 egte_rpo ))   
 regulario_type2_pmos_drain = geomAnd(epsd_drain regulario_type2_pmos)  
 regulario_type2_pmos_gate = geomAnd(egte regulario_type2_pmos)  
 regulario_type2_pmos_gate_w = geomGetEdge(esd_gate_w inside regulario_type2_pmos)   
 regulario_type2_pmos_gate_w_exp = geomSize(regulario_type2_pmos_gate_w -GRID edges)   
regulario_type2_pmos_gate_w_expc = geomCat( regulario_type2_pmos_gate_w_exp )
geomStamp(regulario_type2_pmos_gate_w_expc epmosc)  
 hv_regulario_type2_pmos_gate_w = geomGetEdge(regulario_type2_pmos_gate_w inside od2)   
 lv_regulario_type2_pmos_gate_w = geomAndNot(regulario_type2_pmos_gate_w geomGetEdge(regulario_type2_pmos_gate_w inside od2))   

 processAntenna(
        gate((regulario_type2_pmos_gate_w_expc regulario_type2_pmos_gate_w_expc ))
        antenna( regulario_type2_pmos_gate_w_expc   )
        ratio = (( regulario_type2_pmos_gate_w_expc.area )/2)/GRID
 ESD_44G = drcAntenna( regulario_type2_pmos_gate_w_expc (regulario_type2_pmos_gate_w_expc) ratio keep < ESD_44g suppressErrorMessage )

)
 errorLayer(geomCat( ESD_44G_regulario_type2_pmos_gate_w_expc )
        "ESD.44g Total finger width for PMOS in same connection > ^ESD_44g um " )

if((HIGH_VOLTAGE == 3.3) then
 drc( hv_regulario_type2_pmos_gate_w   width < ESD_45g_33V  
	"ESD.45g 2  Channel length of 3.3V I/O >= ^ESD_45g_33V Channel length of 2.5V I/O >= ^ESD_45g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_45g_LV ")  
) ; 
if((HIGH_VOLTAGE == 2.5) then
 drc( hv_regulario_type2_pmos_gate_w   width < ESD_45g_25V  
	"ESD.45g 5  Channel length of 3.3V I/O >= ^ESD_45g_33V Channel length of 2.5V I/O >= ^ESD_45g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_45g_LV ")  
) ; 
 drc( lv_regulario_type2_pmos_gate_w   width < ESD_45g_LV  
	"ESD.45g 7  Channel length of 3.3V I/O >= ^ESD_45g_33V Channel length of 2.5V I/O >= ^ESD_45g_25V Channel length of 1.0V/1.2V/1.5V I/O >= ^ESD_45g_LV ")  
 errorLayer( geomAndNot(regulario_type2_pmos_drain geomButtOrOver(regulario_type2_pmos_drain rpo )) 
	"ESD.46g  The PMOS should have an unsilicided area on the drain side.  That is, the RPO mask should block the drain side of the device. (except the contact region which should remain silicided). DRC only flags no RPO in this device. ")  
esd_gate_w = geomGetEdge(gate_w inside sdi) 
 esd47g_x = geomGetEdge( esd_gate_w butting regulario_type2_pmos_drain wholeEdge ) 
 esd47g1_a = geomSize(esd47g_x ESD_47g edges)   
 esd47g2_b = drc( rpo regulario_type2_pmos_gate  sep == ESD_47g  shielded )
 errorLayer( geomXor(esd47g1_a esd47g2_b) 
	"ESD.47g  RPO on the drain side space to the poly gate = ^ESD_47g um ") 
 esd48g_a = geomAnd(regulario_type2_pmos_drain rpo)  
 drc( esd48g_a   width < ESD_48g  withCornerTouch 
	"ESD.48g  Width of the RPO on the drain side for PMOS >= ^ESD_48g um ")  
 esd49g_a = geomGetEdge( esd_gate_w coincident regulario_type2_pmos_gate ) 
 drc( eco esd49g_a  sep < ESD_49g  shielded withIntersection 
	"ESD.49g  Space of poly to CO on the source side >= ^ESD_49g um ")  
 enmos_iact3 =  geomButtOrOver( enmos rpo  )   
 enmos_iact31 =  geomButtOrOver( enmos_iact3 egte_full_rpo  )   
 ncs_type2_nmos = geomAndNot(enmos_iact31 geomButtOrOver(enmos_iact31 egte_part_rpo ))   
 ncs_type2_nmos_drain = geomAnd(ensd_drain ncs_type2_nmos)  
 ncs_type2_nmos_gate = geomAnd(egte ncs_type2_nmos)  
 ncs_type2_nmos_gate_w = geomGetEdge(esd_gate_w inside ncs_type2_nmos)   
 ncs_type2_nmos_gate_w_exp = geomSize(ncs_type2_nmos_gate_w -GRID edges)   
ncs_type2_nmos_gate_w_expc = geomCat( ncs_type2_nmos_gate_w_exp )
geomStamp(ncs_type2_nmos_gate_w_expc enmosc)  
 hv_ncs_type2_nmos_gate_w = geomGetEdge(ncs_type2_nmos_gate_w inside od2)   

 processAntenna(
        gate((ncs_type2_nmos_gate_w_expc ncs_type2_nmos_gate_w_expc ))
        antenna( ncs_type2_nmos_gate_w_expc   )
        ratio = (( ncs_type2_nmos_gate_w_expc.area )/2)/GRID
 	ERR = drcAntenna( ncs_type2_nmos_gate_w_expc (ncs_type2_nmos_gate_w_expc) ratio keep < ESD_50g suppressErrorMessage ) 
)
    errorLayer( geomCat( ERR_ncs_type2_nmos_gate_w_expc)
       		"ESD.50g Total finger width in same connection > ^ESD_50g um " )

if((HIGH_VOLTAGE == 3.3) then
 drc( hv_ncs_type2_nmos_gate_w   width < ESD_51g_33V  
	"ESD.51g.33V  Channel length of 3.3V Power Clamp >= ^ESD_51g_33V ")  
) ; 
if((HIGH_VOLTAGE == 2.5) then
 drc( hv_ncs_type2_nmos_gate_w   width < ESD_51g_25V  
	"ESD.51g.25V  Channel length of 2.5V Power Clamp >= ^ESD_51g_25V ")  
) ; 
 errorLayer( geomAndNot(ncs_type2_nmos_gate geomButtOrOver(ncs_type2_nmos_gate rpo )) 
	"ESD.52g  The NMOS should have an unsilicided area on the drain/source side.  That is, the RPO mask should block the drain/source side of the device. (except the contact region which should remain silicided). DRC only flags no RPO in this device. ")  
 esd53g_a = geomAnd(ncs_type2_nmos_drain rpo)  
 drc( esd53g_a   width < ESD_53g  withCornerTouch 
	"ESD.53g  Width of the RPO on the drain side for PMOS >= ^ESD_53g um ")  
 esd54g_a = geomGetEdge( esd_gate_w coincident ncs_type2_nmos_gate ) 
 drc( eco esd54g_a  sep < ESD_54g  shielded withIntersection 
	"ESD.54g  Space of poly to CO on the source side >= ^ESD_54g um ")  
) ; 
if((HALF_NODE == 1) then
/* SRAM CHECKS */
/* =========== */
 drc( dmsrmi   width < SRAM_W_1  withCornerTouch 
	"SRAM.W.1  Width >= ^SRAM_W_1 um  ")  
 drc( dmsrmi nwelli 0 < enc < SRAM_EX_1  shielded withIntersection withSingularPoint 
	"SRAM.EX.1  Min. clearance DMSRM to NWEL < ^SRAM_EX_1 um  ")  
) ; 
/*  Analog Checks */
/* ============== */
 pp_emod = geomAnd(pact bjtdmy)  
 np_emod = geomAnd(nact bjtdmy)  
 emod = geomOr(pp_emod np_emod)  
if((HALF_NODE == 1) then
if((LV == 1) then
 emod_sz1 =  geomSize( emod BJT_R_1 noClipAcute )   
 emod_sz2 =  geomSize( emod -BJT_R_1 noClipAcute )   
 bjtr1_x1 = geomAndNot(emod_sz1 emod_sz2)  
 bjtr11_y1 = geomButtOrOver( rpo emod  )   
 bjtr12_z1 = geomXor(bjtr1_x1 bjtr11_y1)  
 bjtr13_e1 = geomButtOrOver( emod bjtr12_z1  )   
 e1_sz1 =  geomSize( bjtr13_e1 BJT_R_1_1 noClipAcute )   
 e1_sz2 =  geomSize( bjtr13_e1 -BJT_R_1_1 noClipAcute )   
 bjtr14_x2 = geomAndNot(e1_sz1 e1_sz2)  
 bjtr15_y2 = geomButtOrOver( rpo bjtr12_z1  )   
 errorLayer( geomXor(bjtr14_x2 bjtr15_y2) 
	"BJT.R.1  RPO needs to cover 0.3um or 0.33um on EM OD edge from OD and STI sides ") 
else;/* LV */
 emod_sz3 =  geomSize( emod BJT_R_1 noClipAcute )   
 emod_sz4 =  geomSize( emod -BJT_R_1 noClipAcute )   
 bjtr16_x = geomAndNot(emod_sz3 emod_sz4)  
 bjtr17_y = geomButtOrOver( rpo emod  )   
 errorLayer( geomXor(bjtr16_x bjtr17_y) 
	"BJT.R.1 2  RPO needs to cover ^BJT_R_1 on EM OD edge from OD and STI sides ") 
) ; /* LV */
else;/* HALF_NODE */
 emod_sz5 =  geomSize( emod BJT_R_1 noClipAcute )   
 emod_sz6 =  geomSize( emod -BJT_R_1 noClipAcute )   
 bjtr18_x = geomAndNot(emod_sz5 emod_sz6)  
 bjtr19_y = geomButtOrOver( rpo emod  )   
 errorLayer( geomXor(bjtr18_x bjtr19_y) 
	"BJT.R.1 3  RPO needs to cover ^BJT_R_1 on EM OD edge from OD and STI sides ") 
) ; /* HALF_NODE */
 res2m_pocell = geomAnd(res2m_pocellin res2m_pocellout)  
 res2m_pomarker = geomAnd(polygi rruleanalog)  
 res2m_pocell_or1 =  geomOr(res2m_pocell res2m_pomarker)  
 res2m_pocell_or11 =  geomAndNot(res2m_pocell_or1 sram_exclude)  
 res2m_po = geomOutside( res2m_pocell_or11 block  )   
 res2m_pores = geomAnd(pores res2m_po)  
 drc( res2m_pores   width < 1.0  withCornerTouch 
	"RES.2m  Width >= 1.0um and length >= 2.0um for unsilicided PO resistor ")  
 res2m_res_l = geomGetEdge(res2m_pores inside rpo)   
 res2m1_x = geomGetLength(res2m_res_l  keep < 2.0 contiguous )   
 res2m1_x_sz1 = geomSize(res2m1_x 0.005 edges)
 res2m2_check_res = geomButtOrCoin( res2m_pores res2m1_x_sz1 )   
 res2m3_res_e = geomGetEdge(res2m2_check_res coincident rpo)   
 res2m4_a = geomSize(res2m3_res_e -GRID edges)   
res2m5_b = geomSizeAnd( res2m4_a res2m_pores PO_S_1* 0.7 (1.0-GRID*2 ) )  
 res2m6_c = geomAndNot(res2m2_check_res res2m5_b)  
 errorLayer( geomAndNot(res2m2_check_res geomButtOrOver(res2m2_check_res res2m6_c )) 
	"RES.2m 2  Width >= 1.0um and length >= 2.0um for unsilicided PO resistor ")  
 res2m7_d = drc( res2m6_c   width < GRID* 2  )
 errorLayer( geomButtOrOver( res2m2_check_res res2m7_d  ) 
	"RES.2m 3  Width >= 1.0um and length >= 2.0um for unsilicided PO resistor ")  
