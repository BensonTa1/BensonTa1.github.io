m2dn52_c = geomCat( m2dn52_c_1 m2dn52_c_m2dn5_check_cbm )  
 a_and2 =  geomAnd(m2dn5_a m2dn51_b)  
 errorLayer( geomAnd(a_and2 m2dn52_c) 
	"M2.DN.5  It is not allowed to have local density < ^M2_DN_5 of all 3 consecutive metal (M2,M3,M4) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um ") 
M3_DN_5 = 0.15
 cbm_sz3 =  geomSize( cbm 25 noClipAcute )   
 m3dn5_cbm_merge = geomSize( cbm_sz3 -25 noClipAcute )   
 m3dn5_check_cbm = drc( m3dn5_cbm_merge  area >= 200* 200 ) 
 m3dn5_m3_check = geomAnd(m3 m3dn5_check_cbm)  
 m3dn5_m4_check = geomAnd(m4 m3dn5_check_cbm)  
 m3dn5_m5_check = geomAnd(m5 m3dn5_check_cbm)  
geomConnect( incremental
	buttOrOver(m3dn5_check_cbm m3dn5_m3_check)
	buttOrOver(m3dn5_check_cbm m3dn5_m4_check)
	buttOrOver(m3dn5_check_cbm m3dn5_m5_check)
)
processAntenna(
