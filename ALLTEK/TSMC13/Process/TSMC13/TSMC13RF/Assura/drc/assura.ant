	       gate(( HV_GATE POLY ))
	       antenna( cumulative M6 )
               M6_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  = plusp(M6.area) * plusp(HV_GATE.area) * M6.area/GATE.area
               ratio  = if( M6_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M6 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

