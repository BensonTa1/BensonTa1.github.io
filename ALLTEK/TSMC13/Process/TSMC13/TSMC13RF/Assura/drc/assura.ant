;=======================
;== ENVIRONMENT SETUP ==
;=======================
LargeNumber   = 1000000000
PO_THICKNESS  = 0.18
DIODE_AREA    = 0.16
DIODE_AREA_AP = 0.06
APn_THICKNESS = 1.45



drcExtractRules(
	
layerDefs( "gds2"
    CHIP    = cellBoundary(root)
    DIFFi   = layer( 6 )
    PDIFFi  = layer( 7 )
    NDIFFi  = layer( 8 )
    OD2i    = layer( 15 )
    POLYGi  = layer( 17 )
    CONTi   = layer( 30 )
    M1i     = layer( 31 type(0 3:255) )
    DUM1    = layer( 31 type(1) ) 
    M1SLOTi = layer( 31 type(2) )
    VIA1i   = layer( 51 )
    M2i     = layer( 32 type(0 3:255) )
    DUM2    = layer( 32 type(1) ) 
    M2SLOTi = layer( 32 type(2) )
    VIA2i   = layer( 52 )
    M3i     = layer( 33 type(0 3:255) )
    DUM3    = layer( 33 type(1) ) 
    M3SLOTi = layer( 33 type(2) ) 
    VIA3i   = layer( 53 )
    M4i     = layer( 34 type(0 3:255) )
    DUM4    = layer( 34 type(1) ) 
    M4SLOTi = layer( 34 type(2) ) 
    VIA4i   = layer( 54 )
    M5i     = layer( 35 type(0 3:255) )
    DUM5    = layer( 35 type(1) ) 
    M5SLOTi = layer( 35 type(2) )
    VIA5i   = layer( 55 )
    M6i     = layer( 36 type(0 3:255) )
    DUM6    = layer( 36 type(1) ) 
    M6SLOTi = layer( 36 type(2) )
    VIA6i   = layer( 56 )
    M7i     = layer( 37 type(0 3:255) )
    DUM7    = layer( 37 type(1) ) 
    M7SLOTi = layer( 37 type(2) )
    VIA7i   = layer( 57 )
    M8i     = layer( 38 type(0 3:255) )
    DUM8    = layer( 38 type(1) ) 
    M8SLOTi = layer( 38 type(2) ) 
    VIADi   = layer( 167 ) 
    MDi     = layer( 168 type(0 3:255) )
    DUMD    = layer( 168 type(1) ) 
    MDSLOTi = layer( 168 type(2) )
    CTMi    = layer( 77 )
    CBMi    = layer( 88 )
    APi     = layer( 42 )
    RVi     = layer( 85 )
    CBD     = layer( 169 )
    CB      = layer( 43 )
    CB2     = layer( 86 )
    DOD     = layer( 6 type(1) )   ; DOD should be an individual CAD layer and different from real OD
    DPO     = layer( 17 type(1) )  ; DPO should be an individual CAD layer and different from real POLGY
    Cu_PPI  = layer( 42 type(10) )  ; Cu_PPI interconnection between Polymide1 and Polymide2 for WLCSP

) ;end of layerdefs_GDS2

layerDefs( "df2"
    CHIP    = cellBoundary(root)
    DIFFi   = layer( "OD"     type( "drawing" ) )
    PDIFFi  = layer( "PDIFF"  type( "drawing" ) )
    NDIFFi  = layer( "NDIFF"  type( "drawing" ) )
    OD2i    = layer( "OD2"    type( "drawing" ) )
    POLYGi  = layer( "POLYG"  type( "drawing" ) )
    CONTi   = layer( "CONT"   type( "drawing" ) )
    M1i     = layer( "METAL1" type( "drawing" ) )
    DUM1    = layer( "METAL1" type( "dummy" ) ) 
    M1SLOTi = layer( "METAL1" type( "slot" ) )
    VIA1i   = layer( "VIA12"  type( "drawing" ) )
    M2i     = layer( "METAL2" type( "drawing" ) )
    DUM2    = layer( "METAL2" type( "dummy" ) ) 
    M2SLOTi = layer( "METAL2" type( "slot" ) )
    VIA2i   = layer( "VIA23"  type( "drawing" ) )
    M3i     = layer( "METAL3" type( "drawing" ) )
    DUM3    = layer( "METAL3" type( "dummy" ) ) 
    M3SLOTi = layer( "METAL3" type( "slot" ) ) 
    VIA3i   = layer( "VIA34"  type( "drawing" ) )
    M4i     = layer( "METAL4" type( "drawing" ) )
    DUM4    = layer( "METAL4" type( "dummy" ) ) 
    M4SLOTi = layer( "METAL4" type( "slot" ) ) 
    VIA4i   = layer( "VIA45"  type( "drawing" ) )
    M5i     = layer( "METAL5" type( "drawing" ) )
    DUM5    = layer( "METAL5" type( "dummy" ) ) 
    M5SLOTi = layer( "METAL5" type( "slot" ) )
    VIA5i   = layer( "VIA56"  type( "drawing" ) )
    M6i     = layer( "METAL6" type( "drawing" ) )
    DUM6    = layer( "METAL6" type( "dummy" ) ) 
    M6SLOTi = layer( "METAL6" type( "slot" ) )
    VIA6i   = layer( "VIA67"  type( "drawing" ) )
    M7i     = layer( "METAL7" type( "drawing" ) )
    DUM7    = layer( "METAL7" type( "dummy" ) ) 
    M7SLOTi = layer( "METAL7" type( "slot" ) )
    VIA7i   = layer( "VIA78"  type( "drawing" ) )
    M8i     = layer( "METAL8" type( "drawing" ) )
    DUM8    = layer( "METAL8" type( "dummy" ) ) 
    M8SLOTi = layer( "METAL8" type( "slot" ) ) 
    VIADi   = layer( "VIAD"   type( "drawing" ) ) 
    MDi     = layer( "MD"     type( "drawing" ) )
    DUMD    = layer( "MD"     type( "dummy" ) ) 
    MDSLOTi = layer( "MD"     type( "slot" ) )
    CTMi    = layer( "CTM"    type( "drawing" ) )
    CBMi    = layer( "CBM"    type( "drawing" ) )
    APi     = layer( "AP"     type( "drawing" ) )
    RVi     = layer( "RV"     type( "drawing" ) )
    CBD     = layer( "CBD"    type( "drawing" ) )
    CB      = layer( "PAD"    type( "drawing" ) )
    CB2     = layer( "CB2"    type( "drawing" ) )
    DOD     = layer( "OD"     type( "dummy" ) )     ; DOD should be an individual CAD layer and different from real OD
    DPO     = layer( "POLYG"  type( "dummy" ) )     ; DPO should be an individual CAD layer and different from real POLGY
    Cu_PPI  = layer( "AP"     type( "drawing1" ) )  ; Cu_PPI interconnection between Polymide1 and Polymide2 for WLCSP
) ;end of layerDefs_DFII



ODi   = geomOr( DIFFi PDIFFi NDIFFi ) 
OD    = geomButtOrOver( ODi geomOr( POLYGi CONTi ) )
POLY  = geomButtOrOver( POLYGi geomOr( OD CONTi ) )
VIAD  = geomCat( VIADi )

/* Separate the via upon CTM region */
VIAt  = geomAndNot( VIA7i geomButtOrOver( VIA7i CTMi ) )
VIAc  = geomAnd( VIA7i CTMi )

GATE  = geomAnd( OD POLY )
SD    = geomButtOrOver( geomAndNot( OD POLY ) CONTi )
CO_PO = geomButtOrOver( CONTi POLY )
    
/* metal in sillicon */
M1x = geomAndNot( M1i M1SLOTi )
M1  = geomButtOrOver( M1x geomOr( CONTi VIA1i ) ) 
M2x = geomAndNot( M2i M2SLOTi )
M2  = geomButtOrOver( M2x geomOr( VIA1i VIA2i ) )
M3x = geomAndNot( M3i M3SLOTi )
M3  = geomButtOrOver( M3x geomOr( VIA2i VIA3i ) )
M4x = geomAndNot( M4i M4SLOTi )
M4  = geomButtOrOver( M4x geomOr( VIA3i VIA4i ) )
M5x = geomAndNot( M5i M5SLOTi )
M5  = geomButtOrOver( M5x geomOr( VIA4i VIA5i ) )
M6x = geomAndNot( M6i M6SLOTi )
M6  = geomButtOrOver( M6x geomOr( VIA5i VIA6i ) )
M7x = geomAndNot( M7i M7SLOTi )
M7  = geomButtOrOver( M7x geomOr( VIA6i VIA7i ) )
M8x = geomAndNot( M8i M8SLOTi )
M8  = geomButtOrOver( M8x geomOr( VIA7i VIAD ) )
MDx = geomAndNot( MDi MDSLOTi )
MD  = geomButtOrOver( MDx VIAD )
AP  = geomButtOrOver( APi RVi  )

HV_GATE = geomAnd( GATE OD2i )


;=================
;== POLY CHECKS ==
;=================

geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( POLY )
	       ratio = plusp(GATE.area) * ( plusp(HV_GATE.area) * ( POLY.perimeter * PO_THICKNESS / GATE.area - 500 ) + zerop(HV_GATE.area) * ( POLY.perimeter * PO_THICKNESS / GATE.area - 1000) )
	       ERR   = drcAntenna( POLY ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	)

AR1POLY = geomOr( ERR_GATE )
errorLayer( AR1POLY "A.R.1.POLY (Poly perim*thickness / gate area) > (500 in OD2, 1000 not in OD2)")


;===============
;== CO CHECKS ==
;===============

geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( CO_PO )
	       ratio = plusp(HV_GATE.area) * ( CO_PO.area / GATE.area - 10 ) + zerop(HV_GATE.area) * ( CO_PO.area / GATE.area - 50)
	       ERR   = drcAntenna( CO_PO ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	)
AR2CO = geomOr( ERR_GATE )
errorLayer( AR2CO "A.R.2.CO (contact area / gate area) > (10 in OD2, 50 not in OD2)")


;===============
;== M1 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M1 )
               M1_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value  =  plusp(M1.area) * zerop(HV_GATE.area) * M1.area/GATE.area
               ratio  = if( M1_MIN_DIO >= 1 then 0 else value  )
               error  = if( M1_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M1 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

AR4M1A = geomOr( ERR1_GATE )
errorLayer( AR4M1A "A.R.4.M1.A (M1 top area / gate area) without protection OD > 5500 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( cumulative M1 )
               M1_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value  = plusp(M1.area) * plusp(HV_GATE.area) * M1.area/GATE.area
               ratio  = if( M1_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M1 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

AR4M1B = geomOr( ERR2_HV_GATE )
errorLayer( AR4M1B "A.R.4.M1.B (M1 top area / gate area) without protection OD > 600 (with OD2)")

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M1 )
               M1_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value1 = plusp(M1.area) * plusp(GATE.area) * M1.area/GATE.area
               value2 = 43000 + SD.area * 456
               ratio  = if( M1_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M1 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

AR6M1 = geomOr( ERR3_GATE )
errorLayer( AR6M1 "A.R.6.M1 (M1 top area / gate area) with protection OD > (protection OD area)*456 + 43000 ")


;===============
;== M2 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2      )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( cumulative M2 )
               M2_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  =  plusp(M2.area) * zerop(HV_GATE.area) * M2.area/GATE.area
               ratio  = if( M2_MIN_DIO >= 1 then 0 else value  )
               error  = if( M2_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M2 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

AR4M2A = geomOr( ERR1_GATE )
errorLayer( AR4M2A "A.R.4.M2.A (M2 top area / gate area) without protection OD > 5500 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( cumulative M2 )
               M2_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  = plusp(M2.area) * plusp(HV_GATE.area) * M2.area/GATE.area
               ratio  = if( M2_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M2 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

AR4M2B = geomOr( ERR2_HV_GATE )
errorLayer( AR4M2B "A.R.4.M2.B (M2 top area / gate area) without protection OD > 600 (with OD2)")

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M2 )
               M2_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value1 = plusp(M2.area) * plusp(GATE.area) * M2.area/GATE.area 
               value2 = 43000 + SD.area * 456
               ratio  = if( M2_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M2 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

AR6M2 = geomOr( ERR3_GATE )
errorLayer( AR6M2 "A.R.6.M2 (M2 top area / gate area) with protection OD > (protection OD area)*456 + 43000 ")

;===============
;== M3 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2      )
	           via( VIA2i M2 M3      )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( cumulative M3 )
               M3_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  =  plusp(M3.area) * zerop(HV_GATE.area) * M3.area/GATE.area
               ratio  = if( M3_MIN_DIO >= 1 then 0 else value  )
               error  = if( M3_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M3 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

AR4M3A = geomOr( ERR1_GATE )
errorLayer( AR4M3A "A.R.4.M3.A (M3 top area / gate area) without protection OD > 5500 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( cumulative M3 )
               M3_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  = plusp(M3.area) * plusp(HV_GATE.area) * M3.area/GATE.area
               ratio  = if( M3_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M3 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

AR4M3B = geomOr( ERR2_HV_GATE )
errorLayer( AR4M3B "A.R.4.M3.B (M3 top area / gate area) without protection OD > 600 (with OD2)")

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M3 )
               M3_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value1 = plusp(M3.area) * plusp(GATE.area) * M3.area/GATE.area 
               value2 = 43000 + SD.area * 456
               ratio  = if( M3_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M3 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

AR6M3 = geomOr( ERR3_GATE )
errorLayer( AR6M3 "A.R.6.M3 (M3 top area / gate area) with protection OD > (protection OD area)*456 + 43000 ")

;===============
;== M4 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2      )
	           via( VIA2i M2 M3      )
	           via( VIA3i M3 M4      )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( cumulative M4 )
               M4_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  =  plusp(M4.area) * zerop(HV_GATE.area) * M4.area/GATE.area
               ratio  = if( M4_MIN_DIO >= 1 then 0 else value  )
               error  = if( M4_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M4 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

AR4M4A = geomOr( ERR1_GATE )
errorLayer( AR4M4A "A.R.4.M4.A (M4 top area / gate area) without protection OD > 5500 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( cumulative M4 )
               M4_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  = plusp(M4.area) * plusp(HV_GATE.area) * M4.area/GATE.area
               ratio  = if( M4_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M4 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

AR4M4B = geomOr( ERR2_HV_GATE )
errorLayer( AR4M4B "A.R.4.M4.B (M4 top area / gate area) without protection OD > 600 (with OD2)")

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M4 )
               M4_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value1 = plusp(M4.area) * plusp(GATE.area) * M4.area/GATE.area 
               value2 = 43000 + SD.area * 456
               ratio  = if( M4_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M4 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

AR6M4 = geomOr( ERR3_GATE )
errorLayer( AR6M4 "A.R.6.M4 (M4 top area / gate area) with protection OD > (protection OD area)*456 + 43000 ")

;===============
;== M5 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2      )
	           via( VIA2i M2 M3      )
	           via( VIA3i M3 M4      )
	           via( VIA4i M4 M5      )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( cumulative M5 )
               M5_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  =  plusp(M5.area) * zerop(HV_GATE.area) * M5.area/GATE.area
               ratio  = if( M5_MIN_DIO >= 1 then 0 else value  )
               error  = if( M5_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M5 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

AR4M5A = geomOr( ERR1_GATE )
errorLayer( AR4M5A "A.R.4.M5.A (M5 top area / gate area) without protection OD > 5500 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( cumulative M5 )
               M5_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  = plusp(M5.area) * plusp(HV_GATE.area) * M5.area/GATE.area
               ratio  = if( M5_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( M5 ( HV_GATE ) ratio ( keep > 600 ) suppressErrorMessage ) 
	      )

AR4M5B = geomOr( ERR2_HV_GATE )
errorLayer( AR4M5B "A.R.4.M5.B (M5 top area / gate area) without protection OD > 600 (with OD2)")

processAntenna(
	       gate(( GATE POLY ))
	       antenna( cumulative M5 )
               M5_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value1 = plusp(M5.area) * plusp(GATE.area) * M5.area/GATE.area 
               value2 = 43000 + SD.area * 456
               ratio  = if( M5_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M5 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

AR6M5 = geomOr( ERR3_GATE )
errorLayer( AR6M5 "A.R.6.M5 (M5 top area / gate area) with protection OD > (protection OD area)*456 + 43000 ")

;===============
;== M6 CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2      )
	           via( VIA2i M2 M3      )
	           via( VIA3i M3 M4      )
	           via( VIA4i M4 M5      )
	           via( VIA5i M5 M6      )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( cumulative M6 )
               M6_MIN_DIO = if( ( SD.area - DIODE_AREA ) >= 0 then 1 else 0  )
               value  =  plusp(M6.area) * zerop(HV_GATE.area) * M6.area/GATE.area
               ratio  = if( M6_MIN_DIO >= 1 then 0 else value  )
               error  = if( M6_MIN_DIO >= 1 then LargeNumber  else 5500  )
	       ERR1   = drcAntenna( M6 ( GATE ) ratio ( keep > error ) suppressErrorMessage ) 
	      )

