               value = plusp( M1.area) * plusp(GATE.area) * ( zerop(HV_GATE.area) * ( VIA1i.area / GATE.area - 50 ) + plusp(HV_GATE.area) * ( VIA1i.area / GATE.area - 20 ) )
               ratio  = if( VIA1_MIN_DIO >= 1 then 0 else value )
	       ERR1   = drcAntenna( M1 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

