               value1 = plusp(APn.area) * plusp(GATE.area) * APn.perimeter*APn_THICKNESS/GATE.area
               value2 = 30000 + SD.area * 8000
               ratio  = if( APn_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( APn ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

