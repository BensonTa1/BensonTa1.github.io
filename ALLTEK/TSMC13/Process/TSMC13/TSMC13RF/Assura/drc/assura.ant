               VIA6_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = ( plusp(M6.area) * plusp(GATE.area)) * ( VIA6i.area / GATE.area - SD.area * 210 - 900 )
               ratio  = if( VIA6_MIN_DIO >= 1 then value else 0 )
	       ERR1   = drcAntenna( M6 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR5VIA6 = geomOr( ERR1_GATE )
geomStamp( AR5VIA6 POLY )
A_R_5_VIA6 = geomNodeRelate( M6 AR5VIA6 conn )
errorLayer( A_R_5_VIA6 "A.R.5.VIA6 (VIA6 area / gate area) with protection OD > (protection OD area)*210 + 900")
;=================
;== VIA7 CHECKS ==
;=================

geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
                   via( VIA1i M2 M1 )
                   via( VIA2i M3 M2 )
                   via( VIA3i M4 M3 )
                   via( VIA4i M5 M4 )
                   via( VIA5i M6 M5 )
                   via( VIA6i M7 M6 )
	    buttOrOver( VIA7i M7    )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( VIA7i M7 )
               VIA7_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = plusp( M7.area) * plusp(GATE.area) * ( zerop(HV_GATE.area) * ( VIA7i.area / GATE.area - 50 ) + plusp(HV_GATE.area) * ( VIA7i.area / GATE.area - 20 ) )
               ratio  = if( VIA7_MIN_DIO >= 1 then 0 else value )
	       ERR1   = drcAntenna( M7 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR3VIA7 = geomOr( ERR1_GATE )
geomStamp( AR3VIA7 POLY )
A_R_3_VIA7 = geomNodeRelate( M7 AR3VIA7 conn )
errorLayer( A_R_3_VIA7 "A.R.3.VIA7 (VIA7 area / gate area) without protection OD should > 50 (without OD2) or  > 20 (with OD2)")


processAntenna(
	       gate(( GATE POLY ))
	       antenna( VIA7i M7 )
               VIA7_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = ( plusp(M7.area) * plusp(GATE.area)) * ( VIA7i.area / GATE.area - SD.area * 210 - 900 )
               ratio  = if( VIA7_MIN_DIO >= 1 then value else 0 )
	       ERR1   = drcAntenna( M7 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR5VIA7 = geomOr( ERR1_GATE )
geomStamp( AR5VIA7 POLY )
A_R_5_VIA7 = geomNodeRelate( M7 AR5VIA7 conn )
errorLayer( A_R_5_VIA7 "A.R.5.VIA7 (VIA7 area / gate area) with protection OD > (protection OD area)*210 + 900")

;=================
;== VIAD CHECKS ==
;=================
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M2 M1      )
                   via( VIA2i M3 M2 )
                   via( VIA3i M4 M3 )
                   via( VIA4i M5 M4 )
                   via( VIA5i M6 M5 )
                   via( VIA6i M7 M6 )
                   via( VIA7i M8 M7 )
	    buttOrOver( VIAD  M8    )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( VIAD M8 )
               VIAD_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = plusp( M8.area) * plusp(GATE.area) * ( zerop(HV_GATE.area) * ( VIAD.area / GATE.area - 50 ) + plusp(HV_GATE.area) * ( VIAD.area / GATE.area - 20 ) )
               ratio  = if( VIAD_MIN_DIO >= 1 then 0 else value )
	       ERR1   = drcAntenna( M8 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR3VIAD = geomOr( ERR1_GATE )
geomStamp( AR3VIAD POLY )
A_R_3_VIAD = geomNodeRelate( M8 AR3VIAD conn )
errorLayer( A_R_3_VIAD "A.R.3.VIAD (VIAD area / gate area) without protection OD should > 50 (without OD2) or  > 20 (with OD2)")


processAntenna(
	       gate(( GATE POLY ))
	       antenna( VIAD M8 )
               VIAD_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = ( plusp(M8.area) * plusp(GATE.area)) * ( VIAD.area / GATE.area - SD.area * 210 - 900 )
               ratio  = if( VIAD_MIN_DIO >= 1 then value else 0 )
	       ERR1   = drcAntenna( M8 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR5VIAD = geomOr( ERR1_GATE )
geomStamp( AR5VIAD POLY )
A_R_5_VIAD = geomNodeRelate( M8 AR5VIAD conn )
errorLayer( A_R_5_VIAD "A.R.5.VIAD (VIAD area / gate area) with protection OD > (protection OD area)*210 + 900")


;===============
;== RV CHECKS ==
;===============
geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M2 M1      )
                   via( VIA2i M3 M2 )
                   via( VIA3i M4 M3 )
                   via( VIA4i M5 M4 )
                   via( VIA5i M6 M5 )
                   via( VIA6i M7 M6 )
                   via( VIA7i M8 M7 )
	    buttOrOver( RVi   M8    )
	   )

processAntenna(
	       gate(( GATE POLY ))
	       antenna( RVi  M8 )
               RV_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = plusp( M8.area) * plusp(GATE.area) * ( zerop(HV_GATE.area) * ( RVi.area / GATE.area - 200 ) + plusp(HV_GATE.area) * ( RVi.area / GATE.area - 20 ) )
               ratio  = if( RV_MIN_DIO >= 1 then 0 else value )
	       ERR1   = drcAntenna( M8 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR10RV = geomOr( ERR1_GATE )
geomStamp( AR10RV POLY )
A_R_10_RV = geomNodeRelate( M8 AR10RV conn )
errorLayer( A_R_10_RV "A.R.10.RV (RV area / gate area) without protection OD should > 200 (without OD2) or  > 20 (with OD2)")


processAntenna(
	       gate(( GATE POLY ))
	       antenna( RVi  M8 )
               RV_MIN_DIO = if( ( SD.area-DIODE_AREA ) >= 0  then 1 else 0  )
               value = ( plusp(M8.area) * plusp(GATE.area)) * ( RVi.area / GATE.area - SD.area * 83 - 400 )
               ratio  = if( RV_MIN_DIO >= 1 then value else 0 )
	       ERR1   = drcAntenna( M8 ( GATE ) ratio ( keep > 0 ) suppressErrorMessage ) 
	      )

AR12RV = geomOr( ERR1_GATE )
geomStamp( AR12RV POLY )
A_R_12_RV = geomNodeRelate( M8 AR12RV conn )
errorLayer( A_R_12_RV "A.R.12.RV (RV area / gate area) with protection OD > (protection OD area)*83 + 400")


) ;end of drcExtract
