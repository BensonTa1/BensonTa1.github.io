               value1 = plusp(M6.area) * plusp(GATE.area) * M6.area/GATE.area 
               value2 = 43000 + SD.area * 456
               ratio  = if( M6_MIN_DIO >= 1 then value1 else 0 )
	       ERR3   = drcAntenna( M6 ( GATE ) ratio ( keep > value2 ) suppressErrorMessage ) 
	      )

