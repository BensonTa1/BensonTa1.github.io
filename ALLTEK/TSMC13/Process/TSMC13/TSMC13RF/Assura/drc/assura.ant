geomStamp( AR13AP POLY )
A_R_13_AP = geomNodeRelate( APn AR13AP conn )
errorLayer( A_R_13_AP "A.R.13.AP (APn perimeter area / gate area) with protection OD > (protection OD area) * 8000 + 30000")


