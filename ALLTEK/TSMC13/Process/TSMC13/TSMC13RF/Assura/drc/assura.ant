APn = geomAndNot( AP geomButtOrOver( AP MD ) )

geomConnect(
	    buttOrOver( GATE POLY )
	    buttOrOver( HV_GATE POLY )
	    buttOrOver( CO_PO POLY )
	           via( CONTi M1 POLY SD )
	           via( VIA1i M1 M2     )
	           via( VIA2i M2 M3     )
	           via( VIA3i M3 M4     )
	           via( VIA4i M4 M5     )
	           via( VIA5i M5 M6     )
	           via( VIA6i M6 M7     )
	           via( VIA7i M7 M8     )
	           via( RVi APn M8       )
	           via( CB  APn M8       )
	           via( CBD APn M8       )
	   )

processAntenna(
	       gate(( GATE POLY ))
               antenna( APn )
               APn_MIN_DIO = if( ( SD.area - DIODE_AREA_AP ) >= 0 then 1 else 0  )
               value  =  plusp(APn.area) * zerop(HV_GATE.area) * APn.perimeter*APn_THICKNESS/GATE.area
               ratio  = if( APn_MIN_DIO >= 1 then 0 else value  )
               error  = if( APn_MIN_DIO >= 1 then LargeNumber else 2000  )
	       ERR1   = drcAntenna( APn ( GATE ) ratio ( keep > error ) suppressErrorMessage )	       
	      )

AR11APA = geomOr( ERR1_GATE )
geomStamp( AR11APA POLY )
A_R_11_AP_A = geomNodeRelate( APn AR11APA conn )
errorLayer( A_R_11_AP_A "A.R.11.AP.A (APn perimeter area / gate area) without effective diode > 2000 (without OD2)")

processAntenna(
	       gate(( HV_GATE POLY ))
	       antenna( APn )
               APn_MIN_DIO = if( ( SD.area - DIODE_AREA_AP ) >= 0 then 1 else 0  )
               value  = plusp(APn.area) * plusp(HV_GATE.area) * APn.perimeter*APn_THICKNESS/GATE.area
               ratio  = if( APn_MIN_DIO >= 1 then 0 else value  )
	       ERR2   = drcAntenna( APn ( HV_GATE ) ratio ( keep > 1000 ) suppressErrorMessage ) 
	      )

AR11APB = geomOr( ERR2_HV_GATE )
geomStamp( AR11APB POLY )
A_R_11_APB = geomNodeRelate( APn AR11APB conn )
errorLayer( A_R_11_APB "A.R.11.AP.B (APn perimeter area / gate area) without protection OD > 1000 (with OD2)")

processAntenna(
