DEVICE rnodl_m rnodl_mr tndiff(PLUS) tndiff(MINUS) psub(B) (PLUS MINUS) [
   property w,l
   w = perimeter_coincide(rnodl_mr,tndiff)/2
   l = area(rnodl_mr)/w
]
TRACE PROPERTY rnodl_m w w 0
TRACE PROPERTY rnodl_m l l 0

LVS REDUCE rnodl_m PARALLEL YES 
[  TOLERANCE l 0  
   EFFECTIVE w,l
   l = SUM(l)/COUNT()
   w = SUM(w)
]

LVS REDUCE rnodl_m SERIES PLUS MINUS YES
[ TOLERANCE w 0
  EFFECTIVE w,l
  w = SUM(w)/COUNT()
  l = SUM(l)
]

