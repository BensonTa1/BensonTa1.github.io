DEVICE moscap_rf varnwc_rf poly(PLUS) tndiff(MINUS) psub(BULK) <vargtc_rf> <nthin> [
  property lr,wr,br,gr
  br1 = count(vargtc_rf)
  gr  = count(nthin)
  br  = br1/gr
  wr = (perimeter_coincide(vargtc_rf,poly)/2)/br1
  lr = (area(vargtc_rf)/wr)/br1
]
TRACE PROPERTY moscap_rf lr lr 0
TRACE PROPERTY moscap_rf wr wr 0
TRACE PROPERTY moscap_rf br br 0
TRACE PROPERTY moscap_rf gr gr 0

