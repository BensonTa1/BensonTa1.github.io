F_reg = EXT MOM_finger_2 <0.41 OPPOSITE REGION
F_reg1 = EXT MOM_finger_3 <0.41 OPPOSITE REGION
MOMDMY_s     = SIZE MOMDMY BY -0.2
MOM_finger_nv = MOM_finger_3 INSIDE MOMDMY_s
MOM_finger_hv = MOM_finger_2 INSIDE MOMDMY_s
DEVICE crtmom MOM_reg3 MOM3_term(PLUS) MOM3_term(MINUS) MOM_plant(BULK) <MOM_finger_nv> <MOM_finger_hv> <F_reg> (PLUS MINUS) [
    property w,s,nv,nh,lay
    nv = count(MOM_finger_nv)
    nh = count(MOM_finger_hv)
    w = ((perimeter_coincide(F_reg,MOM_finger_hv)/2)/(nh-1))
    s = ((area(F_reg)/(nh-1))/w)
    lay = 3
]

TRACE PROPERTY crtmom nv nv 0
TRACE PROPERTY crtmom nh nh 0
TRACE PROPERTY crtmom s s 0
TRACE PROPERTY crtmom lay lay 0

DEVICE crtmom MOM_reg4 MOM4_term(PLUS) MOM4_term(MINUS) MOM_plant(BULK) <MOM_finger_nv> <MOM_finger_hv> <F_reg1> (PLUS MINUS) [
    property w,s,nv,nh,lay
    nv = count(MOM_finger_nv)
    nh = count(MOM_finger_hv)
    w = ((perimeter_coincide(F_reg1,MOM_finger_nv)/2)/(nv-1))
    s = ((area(F_reg1)/(nv-1))/w)
    lay = 4
]

DEVICE crtmom MOM_reg5 MOM5_term(PLUS) MOM5_term(MINUS) MOM_plant(BULK) <MOM_finger_nv> <MOM_finger_hv> <F_reg1> (PLUS MINUS) [
    property w,s,nv,nh,lay
    nv = count(MOM_finger_nv)
    nh = count(MOM_finger_hv)
    w = ((perimeter_coincide(F_reg1,MOM_finger_nv)/2)/(nv-1))
    s = ((area(F_reg1)/(nv-1))/w)
    lay = 5
]

DEVICE crtmom MOM_reg6 MOM6_term(PLUS) MOM6_term(MINUS) MOM_plant(BULK) <MOM_finger_nv> <MOM_finger_hv> <F_reg1> (PLUS MINUS) [
    property w,s,nv,nh,lay
    nv = count(MOM_finger_nv)
    nh = count(MOM_finger_hv)
    w = ((perimeter_coincide(F_reg1,MOM_finger_nv)/2)/(nv-1))
    s = ((area(F_reg1)/(nv-1))/w)
    lay = 6
]

#IFDEF extract_parasitic_diodes
DEVICE D(dnwpsub) dnwdio psub_term DNW [
    PROPERTY A,PJ
    A = area(DNW)
    PJ = perimeter(DNW)
]
  #IFDEF compare_parasitic_diodes
   TRACE PROPERTY D(dnwpsub) A A 0
  #ELSE 
   LVS FILTER D(dnwpsub) LAYOUT OPEN 
  #ENDIF
#ENDIF

//
L_EG_RG1 = EXPAND EDGE L_EG1 OUTSIDE BY 0.005
L_EG     = RCTM TOUCH EDGE L_EG_RG1
L_EG_RG = EXPAND EDGE L_EG OUTSIDE BY 0.005

tpdiff_jvar = tpdiff AND jvar_rf
tndiff_jvar = tndiff AND jvar_rf
w_fac = EXT tpdiff_jvar tndiff_jvar < 0.29 OPPOSITE REGION


#IFDEF CAP_1P5
#IFDEF RC_DECK
DEVICE C(mimcap_1p5_sin) RCTM_R ctm cbm netlist model mimcap_1p5_sin netlist element "X" [
  property wt, lt
  A_CAP = area(RCTM_R)
  P_CAP = perimeter(RCTM_R)
  P_2_CAP = P_CAP * P_CAP
  AC4 = A_CAP * 16
  KKK = P_2_CAP-AC4
  IF(KKK<0) {
  KKK=0
  }
  SQ = sqrt(KKK)
  lt = (P_CAP+SQ)/4
  wt = (P_CAP-SQ)/4
]
#ELSE
DEVICE C(mimcap_1p5_sin)  RCTM_R ctm cbm [
    property C
  A_CAP = area(RCTM_R)
  P_CAP = perimeter(RCTM_R)
  P_2_CAP = P_CAP * P_CAP
  AC4 = A_CAP * 16
  KKK = P_2_CAP-AC4
  IF(KKK<0) {
  KKK=0
  }
  SQ = sqrt(KKK)
  lt = (P_CAP+SQ)/4 * PRESCALE + MIM_1P5_DW
  wt = (P_CAP-SQ)/4 * PRESCALE + MIM_1P5_DW
  A_CAP1 = lt * wt
  P_CAP1 = 2*(lt + wt)
  C_CAP1 = A_CAP1 * MIM_1P5_CA
  C_CAP2 = P_CAP1 * MIM_1P5_CF
  C = C_CAP1 + C_CAP2
]

TRACE PROPERTY C(mimcap_1p5_sin) C C 0
#ENDIF
#ELSE
#IFDEF RC_DECK
DEVICE C(mimcap_1p0_sin) RCTM_R ctm cbm netlist model mimcap_1p0_sin netlist element "X" [
  property wt, lt
  A_CAP = area(RCTM_R)
  P_CAP = perimeter(RCTM_R)
  P_2_CAP = P_CAP * P_CAP
  AC4 = A_CAP * 16
  KKK = P_2_CAP-AC4
  IF(KKK<0) {
  KKK=0
  }
  SQ = sqrt(KKK)
  lt = (P_CAP+SQ)/4
  wt = (P_CAP-SQ)/4
]
#ELSE
DEVICE C(mimcap_1p0_sin) RCTM_R ctm cbm [
  property C
  A_CAP = area(RCTM_R)
  P_CAP = perimeter(RCTM_R)
  P_2_CAP = P_CAP * P_CAP
  AC4 = A_CAP * 16
  KKK = P_2_CAP-AC4
  IF(KKK<0) {
  KKK=0
  }
  SQ = sqrt(KKK)
  lt = (P_CAP+SQ)/4 * PRESCALE + MIM_1P0_DW
  wt = (P_CAP-SQ)/4 * PRESCALE + MIM_1P0_DW
  A_CAP1 = lt * wt
  P_CAP1 = 2*(lt + wt)
  C_CAP1 = A_CAP1 * MIM_1P0_CA
  C_CAP2 = P_CAP1 * MIM_1P0_CF
  C = C_CAP1 + C_CAP2
]
TRACE PROPERTY C(mimcap_1p0_sin) C C 0

#ENDIF
#ENDIF

