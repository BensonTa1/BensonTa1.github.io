//////////////////////////////////////////////////////////////////////////////// 
// 
//                             DEVICE FORMULA 
//	 CORE == 1.0v or 1.2v  
//	 I/O  == 2.5v or 3.3v 
//   ---------------  -----------------------------  ---------------------------------- 
//   NAME             DESCRIPTION                    DEVICE LAYER OPERATION 
//   ---------------  -----------------------------  ---------------------------------- 
//   M[N]             CORE Nominal VT NMOS           ((NGATE-OD2-NTN)-DNW) 
//   M[N1]            CORE Nominal VT NMOS/DNW       ((NGATE-OD2-NTN)*DNW) 
//   M[ND]            I/O Nominal VT NMOS            ((NGATE*OD2-NTN)-DNW) 
//   M[N2]            I/O Nominal VT NMOS/DNW        ((NGATE*OD2-NTN)*DNW) 
//   M[NL]            CORE native device             ((NGATE-OD2)*NTN) 
//   M[NN]            I/O native device              ((NGATE*OD2)*NTN-CAP_IMP) 
//   M[P]             CORE Nominal VT PMOS           (PGATE-OD2) 
//   M[PD]            I/O Nominal VT PMOS            (PGATE*OD2) 
//   M[nch_sram]      CORE SRAM NMOS/DNW             ((NGATE-OD2-NTN)*DMSRM-HVTSRM-LVT_LP_N-VTH_N-SRAMPSGT) 
//   M[nch_sram_hvt]  CORE HVT_SRAM NMOS/DNW         ((NGATE-OD2-NTN)*DMSRM*HVTSRM-LVT_LP_N-VTH_N) 
//   M[NLV]           CORE LOW-VT NMOS               (NGATE-OD2-NTN-DNW*LVT_LP_N) 
//   M[N1LV]          CORE LOW-VT NMOS/DNW           ((NGATE-OD2-NTN)*DNW*LVT_LP_N) 
//   M[NHV]           CORE High-VT NMOS              (NGATE-OD2-NTN-DNW*VTH_N) 
//   M[N1HV]          CORE HIGH-VT NMOS/DNW          ((NGATE-OD2-NTN)*DNW*VTH_N) 
//   M[N2LV]          I/O LOW-VT NMOS/DNW            ((NGATE*OD2-NTN)*DNW*LVT_LP_N) 
//   M[NHL]           I/O LOW-VT NMOS	           (NGATE*OD2-NTN-DNW*LVT_LP_N) 
//   M[PLV]           CORE LOW-VT PMOS               (PGATE-OD2*LVT_LP_P) 
//   M[pch_sram]      CORE SRAM PMOS                 (PGATE-OD2*DMSRM-HVTSRM-LVT_LP_P-VTH_P) 
//   M[pchpu_hvtsr_g] CORE HVT_SRAM PMOS             (PGATE-OD2*DMSRM*HVTSRM-LVT_LP_P-VTH_P) 
//   M[PHV]           CORE High-VT PMOS              (PGATE-OD2*VTH_P) 
//   M[PHL]           I/O LOW-VT PMOS                (PGATE*OD2*LVT_LP_P) 
//   M[nch_uhvt]      CORE Ultra High Vt NMOS        (NGATE-OD2-NTN-HNVT-DNW-VTL_N-VTH_N*UHVT_N) 
//   M[pch_uhvt]      CORE Ultra High Vt PMOS        (PGATE-OD2-VTL_P-VTH_P*UHVT_P) 
//   R[WO]            N-Well resistor under OD       (NWDMYi*NWELL*(OD*RPO)) 
//   R[WR]            N-Well resister under STI      (NWDMYi*NWELL-(OD*RPO)) 
//   R[PR]            P+Poly resistor w/o Silicide   (RPDMYi*POLYG*PP*RPO*RHDMY) 
//   R[NR]            N+Poly resistor w/o Silicide   (RPDMYi*POLYG*NP*RPO*RHDMY) 
//   R[PS]            P+Poly resistor w/i Silicide   (RPDMYi*POLYG*PP-RPO) 
//   R[NS]            N+Poly resistor w/i Silicide   (RPDMYi*POLYG*NP-RPO) 
//   R[PD]            P+diff resistor w/o Silicide   (RPDMYi*OD*PP*RPO*RHDMY*NWELL) 
//   R[ND]            N+diff resistor w/o Silicide   (RPDMYi*OD*NP*RPO*RHDMY-NWELL) 
//   R[PI]            P+diff resistor w/i Silicide   (RPDMYi*OD*PP-RPO*NWELL) 
//   R[NI]            N+diff resistor w/i Silicide   (RPDMYi*OD*NP-RPO-NWELL) 
//   R[M1]            METAL1 resistor                (RMDMY1*METAL1) 
//   R[M2]            METAL2 resistor                (RMDMY2*METAL2) 
//   R[M3]            METAL3 resistor                (RMDMY3*METAL3) 
//   R[M4]            METAL4 resistor                (RMDMY4*METAL4) 
//   R[M5]            METAL5 resistor                (RMDMY5*METAL5) 
//   R[M6]            METAL6 resistor                (RMDMY6*METAL6) 
//   R[M7]            METAL7 resistor                (RMDMY7*METAL7) 
//   R[ME]            METAL8 resistor                (RMDMY8*METAL8) 
//   D[DP]            CORE diode P+/NW               (DIODMY*OD*PP-OD2*NWELL) 
//   D[DN]            CORE diode N+/PW               (DIODMY*OD*NP-OD2*PSUB) 
//   D[DW]            CORE diode NW/PW               (DIODMY*NWELL-OD2) 
//   D[D1]            I/O diode P+/NW                (DIODMY*OD*PP*OD2*NWELL) 
//   D[D2]            I/O diode N+/PW                (DIODMY*OD*NP*OD2*PSUB) 
//   D[DPH]           CORE High-VT diode P+/NW       (DIODMY*OD*PP-OD2*NWELL*VTH_P) 
//   D[DNH]           CORE High-VT diode N+/PW       (DIODMY*OD*NP-OD2*PSUB*VTH_N) 
//   D[NDIO_uhvt]     CORE Ultra High Vt diode N+/PW (DIODMY*OD*NP-OD2*PSUB*UHVT_N-VTL_N-VTH_N-NTN) 
//   D[PDIO_uhvt]     CORE Ultra High Vt diode P+/NW (DIODMY*OD*PP-OD2*NWELL*UHVT_P-VTL_P-VTH_P) 
//   D[D3]               I/O diode NW/PW                (DIODMY*NWELL*OD2)  
//    D[NDIO_lvt25]    I/O Low_VT diode N+/PW      (DIODMY*OD*NP*OD2*PSUB*LVT_LP_N) 
//   D[PDIO_lvt25]    I/O Low_VT diode P+/NW      (DIODMY*OD*PP*OD2*NWELL*LVT_LP_P) 
//   D[DB]            ESD diode                      (ESD3DMY*OD*NP*RPO-NWELL-PO) 		        
//   D[DPL]           CORE Low-VT diode P+/NW        (DIODMY*OD*PP-OD2*NWELL*LVT_LP_P) 
//   D[DNL]           CORE Low-VT diode N+/PW        (DIODMY*OD*NP-OD2*PSUB*LVT_LP_N) 
//   D[D1N]           CORE native diode N+/PW        (DIODMY*OD*NP-OD2*PSUB*NTN) 
//   D[D2N]           I/O native diode N+/PW         (DIODMY*OD*NP*OD2*PSUB*NTN) 
//   D[dnwpsub]       DNW/PSUB DIODE                 (DNW*NWELL) 
//   D[pwdnw]         PSUB(R-WELL)/DNW DIODE         (DNW-NWELL) 
//   D[pnwdio]        NWELL/psub diode                  (NWELL-DIODMY-OD3) 
//     
//   Q[PV]            CORE PNP-BJT                   (BJTDMY*OD*PP-OD2*NWELL*RPO) 
//   Q[NV]            CORE NPN-BJT                   (BJTDMY*OD*NP*PSUB*DNW*RPO) 
//    PC1              PMOS Varactor core             (PVARGT-OD2) 
//    PC2              PMOS Varactor I/O              (PVARGT*OD2) 
//    NC1              NMOS Varactor core             (VARGT-OD2) 
//    NC2              NMOS Varactor I/O              (VARGT*OD2) 
//   rppolyhri        HRI High poly resistor         (RPDMYi*RPO*RHRIDMY*POLYG*HRI) 
//   rnwsti_m         N-Well resistor under STI      (NWDMY1*NWELL-(OD*RPO))  
//   rnwod_m          N-Well resistor under OD       (NWDMY1*NWELL*(OD*RPO)) 
//   rpodwo_m         P+diff resistor w/o Silicide   (RPDMY1*OD*PP*RPO*RHDMY*NWELL)  
//   rnodwo_m         N+diff resistor w/o Silicide   (RPDMY1*OD*NP*RPO*RHDMY-NWELL)  
//   rpodl_m          P+diff resistor w/i Silicide   (RPDMY1*OD*PP-RPO*NWELL)  
//   rnodl_m          N+diff resistor w/i Silicide   (RPDMY1*OD*NP-RPO-NWELL) 
//   rpods_m          P+diff resistor w/i Silicide   (RPDMY1*OD*PP-RPO*NWELL) 
//   rnods_m          N+diff resistor w/i Silicide   (RPDMY1*OD*NP-RPO-NWELL) 
//   C[mimcap_1p0_sin]   1.0fF MIM capacitor                (CTM*CBM-RFDMY) 
//   C[mimcap_1p5_sin]   1.5fF MIM capacitor                (CTM*CBM-RFDMY) 
//   crtmom              MOM fringe capacitor ex:use M1-M6  (M1*M2*M3*M4*M5*M6*MOMDMY*POLYG)  
//   nmos_rf                 CORE Nominal VT NMOS/DNW      ((RFNGATE-OD2-ESD3DMY-NTN)*DRAIN*DNW*RFDMY)  
//   nmos_rf25            I/O Nominal VT NMOS/DNW       ((RFNGATE*OD2-ESD3DMY-NTN)*DRAIN*DNW*RFDMY) 
//   pmos_rf                 CORE Nominal VT PMOS          (RFPGATE-OD2*DRAIN*DNW*RFDMY)   
//   pmos_rf_nw              CORE Nominal VT PMOS          (RFPGATE-OD2*DRAIN-DNW*RFDMY) 
//   pmos_rf25            I/O Nominal VT PMOS           (RFPGATE*OD2*DRAIN*DNW*RFDMY) 
//   pmos_rf25_nw         I/O Nominal VT PMOS           (RFPGATE*OD2*DRAIN-DNW*RFDMY) 
//   moscap_rf               Varactor on thin oxide        (VARGT-OD2*DNW*RFDMY)  
//   moscap_rf25          Varactor on thin oxide        (VARGT*OD2*DNW*RFDMY) 
//   moscap_rf_nw            Varactor on thin oxide        (VARGT-OD2-DNW*RFDMY)  
//   moscap_rf25_nw       Varactor on thin oxide        (VARGT*OD2-DNW*RFDMY) 
// 
//   mimcap_um_1p5_sin_rf    RF CTM capacitor              (CTM*CBM*RFDMY-DNW) 
//   mimcap_um_1p0_sin_rf    RF CTM capacitor              (CTM*CBM*RFDMY-DNW) 
//   mimcap_woum_1p5_sin_rf  RF CTM capacitor              (CTM*CBM*RFDMY*DNW) 
//   mimcap_woum_1p0_sin_rf  RF CTM capacitor              (CTM*CBM*RFDMY*DNW) 
//   spiral_std       Standard Spiral Inductor             	(IND_STD*METAL8) 
//   spiral_sym       Symmetric Spiral Inductor            	(IND_SYM*METAL8) 
//   spiral_sym_ct    Symmetric(center-tapped) Spiral Inductor	(IND_CTi*METAL8) 
// 
//   xjvar            Junction Varactor             (JVARD*NP*PP*DNW*RFDMY)  
//   xjvar_nw         Junction Varactor             (JVARD*NP*PP-DNW*RFDMY) 
//   rppolywo_rf      P+Poly resistor w/o Silicide  (RPDMYi*POLYG*PP*RPO*RFDMY*RHDMY) 
//   rppolyl_rf       P+Poly resistor w/i Silicide  (RPDMYi*POLYG*PP-RPO*RFDMY) 
//   rppolys_rf       P+Poly resistor w/i Silicide  (RPDMYi*POLYG*PP-RPO*RFDMY) 
//   rppolyhri_rf     HRI High poly resistor(RF)    (RPDMYi*RPO*RHRIDMY*POLYG*HRI*RFDMY) 
//    sbd_rf           RF Schottky Barrier Diode w/i DNW (NWELL*SBDDMY*RFDMY-VARDMY*PP*NP*DNW) 
//   sbd_rf_nw        RF Schottky Barrier Diode w/o DNW (NWELL*SBDDMY*RFDMY-VARDMY*PP*NP-DNW) 
//   rnpolywo_dis     N+Poly resistor w/o Silicide(distributed)  (RPDMY1*POLYG*NP*RPO*RHDMY) 
//   rppolywo_dis     P+Poly resistor w/o Silicide(distributed)  (RPDMY1*POLYG*PP*RPO*RHDMY) 
//   rnpolys_dis      N+Poly resistor w/i Silicide(distributed w<2um)  (RPDMY1*POLYG*NP-RPO) 
//   rppolys_dis      P+Poly resistor w/i Silicide(distributed w<2um)  (RPDMY1*POLYG*PP-RPO) 
//   rnpolyl_dis      N+Poly resistor w/i Silicide(distributed w>=2um) (RPDMY1*POLYG*NP-RPO-RHDMY) 
//   rppolyl_dis      P+Poly resistor w/i Silicide(distributed w>=2um) (RPDMY1*POLYG*PP-RPO-RHDMY) 
//   rppolyhri_dis    HRI High poly resistor(distributed)        (RPDMY1*RPO*RHRIDMY*POLYG*HRI) 
//     
//   ---------------------------------------------------------------------------------- 
//   * PSUB = BULK 
//   * HVPW = PSUBi 
//   * CTM  = CTMi 
//   * CBM  = CBMi 
//   * OD   = ODi 
//   * POLYG = POLYGi 
//   * NGATE = ODi * POLYGi * NP - NWELL 
//   * PGATE = ODi * POLYGi * PP * NWELL 
//   * VARGT = ODi * POLYGi * NP * NWELL * VARDMY 
//   * PVARGT = ODi * POLYGi * PP - NWELL * VARDMY 
//   * RFNGATE = ODi * POLYGi * NP - NWELL 
//   * RFPGATE = ODi * POLYGi * PP * NWELL 
//   * JVARD  = ODi - POLYGi * NWELL * VARDMY 
//   * METAL1 = M1  
//   * RMDMY1 = RMDMYi1 + RMDMY 
//   * METAL2 = M2  
//   * RMDMY2 = RMDMYi2 + RMDMY 
//   * METAL3 = M3  
//   * RMDMY3 = RMDMYi3 + RMDMY 
//   * METAL4 = M4  
//   * RMDMY4 = RMDMYi4 + RMDMY 
//   * METAL5 = M5  
//   * RMDMY5 = RMDMYi5 + RMDMY 
//   * METAL6 = M6  
//   * RMDMY6 = RMDMYi6 + RMDMY 
//   * METAL7 = M7  
//   * RMDMY7 = RMDMYi7 + RMDMY 
//   * METAL8 = M8  
//   * RMDMY8 = RMDMYi8 + RMDMY 
//   * LVT_LP_N = VTL_N  
//   * LVT_LP_P = VTL_P 
//////////////////////////////////////////////////////////////////////////////// 
//USER NOTES : 
// 
// 1) mnpg49 mppg49 are obtained in a DRC run, not in an LVS run.   
//   
// 2) For Calibre "EDTEXT" file, use .INCLUDE strings.txt.   
//    LAYOUT TEXT  "text string" [x] [y]  (layer num) (cell name)   
//   
// 3) Input layer 'OD' is defined as thin oxide (OD) area which would    
//    be drawn by one generic od mask or by seperated N+OD and P+OD.    
//    Remove layers in the 'OD' entries you don't want to use at    
//    layer definition block.   
//  
// 4) Default setting for property check is 0%. Users should check with   
//    IP/Designe providers for proper tolerance.   
//   
// 5) It's recommended to run Calibre LVS by hierarchical mode since false   
//    errors have been encountered by only flat mode option '-lvs'.   
//   
// 6) Default property resolution for ambiguity is set to 32. It could be   
//    necessary to increase this setting to resolve serious ambiguity.   
//    Uncomment statement 'LVS PROPERTY RESOLUTION MAXIMUM' in this deck   
//    to reset the capability of property resolution.   
//   
// 7) This deck default not to extracts MOS AS/AD property. To turn on the   
//    extraction of MOS AS/AD property, please uncomment the line   
//    "#DEFINE extract_as_ad". It would cause SEED PROMOTION, and pose   
//    much overhead on layout netlist extraction, erc checks, and lvs comparison. 
// 
// 8) For MOS capacitors, AS and AD values are calculated by combining the total   
//    amount of source and drain area for the device and splitting up the result   
//    evenly between AS and AD. PS and PD values are similarily calculated by evenly   
//    splitting up the total amount of source and drain perimeter. This is valid   
//    since simulation results for MOS capacitors should not depend on how AS/AD   
//    and PS/PD are split up between source and drain.  
//  
// 9) This file usually contains the super set of device extraction rule at TSMC 
//    processes. However, all of device in basic deck may not be offered at current 
//    SPICE model. PLEASE ALWAYS REFER TO THE CORRESPONDING SPICE MODEL DOCUMENT 
//    FOR ANY DEVICE YOU WOULD LIKE USE. 
//     
//10) Set LVS INJECT LOGIC as NO to align the default setting of Calibre version before 2008 for backward compatible 
// 
//11) This file usually reads all datatype (0-255) for each layer defined. 
//    User customization datatype maybe already included in the layout mapping of this deck. 
//    PLEASE ALWAYS REVIEW THE LAYER DEFINITION AND MODIFY IT FOR USERS' PARTICULAR LAYER USE. 
// 
//////////////////////////////////////////////////////////////////////////////// 
//                      Introduction to each switch  
//  
//   -------------------------	-------------------------------------------------------  
//   SWITCH NAME                  		DESCRIPTION                 
//   -------------------------	-------------------------------------------------------  
//   RC_DECK                      Turn-on this switch during extracting RCX spice netlist. 
// 
//   ACCURACY                     Resistance value variable setting.   
//   
//   extract_as_ad                Turn_on this switch if only AS/AD need to be extracted. 
// 
//   ZERO_NRS_NRD                 Set nrd=0 and nrs=0 when run RCX extraction flow. 
// 
//   LP/GENERIC                   PROCESS VARIABLE SETTING => LOW POWER or GENERIC 
//    
//   NW_RING                      If turn on this switch, the soft-connect check for nwell   
//                                ring and psub(rwell) inside will be checked. 
//				Don't recommend to turn on because from process's point 
//				of view BULK cannot be fully separated by NW ring. 
// 
//   FILTER_DGS_TIED_MOS          Turn on this switch to filter MOS with D, G and S tied   
//                                together(default filter MOS with all pins tied). 
//				 
//   WELL_TO_PG_CHECK             Check if nwell connects to ground or psub connects to power,  
//                                default is turned on. 
//    
//   GATE_TO_PG_CHECK             Check if mos gate directly connects to power or ground,  
//                                default is turned off. 
// 
//   DS_TO_PG_CHECK               Check if MOS connected to both power and ground, default 
//                                turned on.					 
// 
//   PATH_CHECK                   ERC path check, default is turned off. 
// 
//////////////////////////////////////////////////////////////////////////////// 
//lvs_gen.pl version: 
//calibre.pl version: 

// LVS/RC switch option
// --------------------
//#define RC_DECK    //uncomment this line when this deck would be used as a RC command file
//#define ZERO_NRS_NRD    //uncomment this line when this deck would set NRS=0 and NRD=0 
//#define FILTER_DGS_TIED_MOS // uncomment this line to filter MOS with D, G and S tied together (default filter MOS with all pins tied)
#define WELL_TO_PG_CHECK 
// Default is on. Turn on to highlight if nwell connects to ground or psub connects to power.
//#define GATE_TO_PG_CHECK 
// Default is off. Turn on to highlight if a mos gate directly connects to power or ground.
//#define PATH_CHECK 
// Default is off. Turn on to highlight if
//(1) nodes have a path to power but no path to ground
//(2) nodes have a path to ground but no path to power
//(3) nodes have no path to power or ground
//(4) nodes have no path to any label net
#define DS_TO_PG_CHECK 
// Default is on. Turn on to highlight if drain connects to power and source connects to ground.
#define FLOATING_WELL_CHECK 
// Default is on. Turn on to highlight if well does not connect to power or ground. 
//The nwell of moscaps and nwell-resistor are excluded.

VARIABLE PRESCALE 1.0

//#define NW_RING	//uncomment this line to enable the NW ring to separate the node from BULK

// POWER and GROUND name string variable setting
VARIABLE POWER_NAME  "AHVDD"  "AHVDDB"  "AHVDDG"  "AHVDDR"  "AHVDDWELL"  "AVDD"  "AVDDB"  "AVDDBG"  "AVDDG"  "AVDDR"  "AVDWELL"  "DHVDD"  "DVDD"  "HVDDWELL"  "TAVD33"  "TAVD33PST"  "TAVDD"  "TAVDDPST"  "TVDD"  "VD33"  "VDD"  "VDD5V"  "VDDESD"  "VDDG"  "VDDPST"  "VDDSA"  "VDWELL" 

