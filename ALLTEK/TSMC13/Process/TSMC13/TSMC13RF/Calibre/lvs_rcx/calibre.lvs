//#############################################
//# LOGIC OPERATION POOL                      #
//#############################################

//Form BULK layer
DRC:1 = EXTENT
BULK  = SIZE DRC:1 BY 0.005

//* Define device -- nmos N
POLYG = POLYGi OR DPOLY 
p1hr1 = POLYG AND RPO 
RPDMY = RPDMYi OR RPDMY1 
OD = ODi OR DOD 
diff = OD NOT RODMY 
rp1 = RPDMY NOT INTERACT diff 
p1rdum = rp1 INTERACT POLYG  //  poly1 resistor dummy
rpop1 = p1hr1 INTERACT p1rdum 
hripo1 = rpop1 AND HRI 
rpop = rpop1 NOT INTERACT hripo1 
rpolywo1 = rpop AND RHDMY 
rpolywo2 = rpolywo1 AND RPO 
rpolywo = rpolywo2 INTERACT p1rdum 
poly1 = POLYG NOT rpolywo 
rpoly1 = POLYG AND p1rdum 
rpoly = rpoly1 NOT INTERACT RPO 
poly12 = poly1 NOT rpoly  //   POLY interconnect
hripo2 = hripo1 AND RHRIDMY 
hripo3 = hripo2 NOT NP 
hripo41 = hripo3 NOT PP 
polytmp = poly12 NOT hripo41 
poly = polytmp NOT MOMDMY  //  POLY interconnect
dupo1 = poly INSIDE diff 
dupo2 = dupo1 NOT INTERACT CONT 
realpo = poly NOT dupo2 
rodwo1 = diff AND RHDMY 
rodwo2 = rodwo1 AND RPO 
drdum = RPDMY INTERACT diff  //  diff resistor dummy
rodwo = rodwo2 INTERACT drdum 
mdiff1 = diff NOT rodwo 
rod1 = diff AND drdum 
rod = rod1 NOT INTERACT RPO 
mdiff = mdiff1 NOT rod 
gate1 = realpo AND mdiff 
gate_a = gate1 NOT DMSRM 
gate = gate_a NOT RFDMY 
iso_hvnw = HVNWi NOT HVOX  //  isolation HVNW
anwel1 = iso_hvnw OR NWELL  //  LV OR HV NWELL
anwel = anwel1 OR IONW 
NWDMY = NWDMYi OR NWDMY1 
nxwell = anwel NOT NWDMY 
gatennw = gate NOT nxwell  //  gate not inside nwell
tngate1 = gatennw AND NP 
tngate1a = tngate1 NOT PSUBi 
tngate2 = tngate1a NOT OD2 
tngate3a = tngate2 NOT NTN 
tngate3 = tngate3a NOT HNVT 
tngate4 = tngate3 NOT DNW 
nlvgate = tngate4 AND VTL_N  //  CORE LOW_VT NMOS
ngate1 = tngate4 NOT nlvgate 
nhvgate = tngate4 AND VTH_N  //  CORE HIGH_VT NMOS
ngate2 = ngate1 NOT nhvgate 
ngate = ngate2 NOT UHVT_N  //  CORE NMOS

//***** Define connectivity/via layer -- tndiff ****
nthin1 = mdiff AND NP  //  define N+ thin oxide
ydio_a = ESD3DMY AND OD 
ydio_c = SIZE ydio_a BY -0.2 
ydio_d = ydio_c AND NP 
ydio_e = ydio_d AND RPO 
ydio_f = ydio_e NOT anwel 
ydio_g = ESD3DMY AND POLYG 
ydio_h = SIZE ydio_g BY 0.2 
ydio_i = ydio_f NOT ydio_h 
ydio_j = SIZE ydio_i BY -0.7 
ydio = SIZE ydio_j BY 0.5 
nthin = nthin1 NOT ydio 
tndiff = nthin NOT gate1  //  define N+ diffusion region

//***** Define connectivity/via layer -- psub ****
ppsub = BULK NOT anwel  //  define total p_sub region
psub2s = SIZE PSUB2 BY 0.01 
psubband = psub2s NOT PSUB2  //  psub separator band (doughnut).
psub = ppsub NOT psubband 

//* Define device -- nmos ND
bngate1 = tngate1a AND OD2 
bngate2a = bngate1 NOT NTN 
bngate2b = bngate2a NOT CAP_IMP 
bngate2c = bngate2b NOT CELLMV 
bngate2 = bngate2c NOT HNVT 
bngate3 = bngate2 NOT DNW 
bngate = bngate3 NOT VTL_N  //  I/O NMOS (original)

//* Define device -- nmos NHL
bnlvgate = bngate3 AND VTL_N  //  I/O LOW_VT NMOS

//* Define device -- nmos N1
tdgate1 = tngate3 AND DNW 
n1lvgate = tdgate1 AND VTL_N  //  CORE LOW_VT NMOS on DNW
nrgate1 = tdgate1 NOT n1lvgate 
n1hvgate = tdgate1 AND VTH_N  //  CORE HIGH_VT NMOS on DNW
nrgate = nrgate1 NOT n1hvgate  //  CORE NMOS on DNW

//* Define device -- nmos N2
bndgate = bngate2 AND DNW 
bnrgate = bndgate NOT VTL_N  //  I/O NMOS on DNW

//* Define device -- nmos N2LV
bndlvgate = bndgate AND VTL_N  //  I/O LOW_VT NMOS on DNW

//* Define device -- nmos NL
nlgate1 = tngate2 AND NTN 
nlgate1a = nlgate1 NOT HNVT 
nlgate2 = nlgate1a NOT VTL_N 
nlgate3 = nlgate2 NOT VTH_N 
nlgate4 = nlgate3 NOT DNW  //  CORE Native Devies
nlgate = nlgate4 NOT OD3  //  CORE Native Devies

//* Define device -- nmos NN
bnngate1 = bngate1 AND NTN 
bnngate2 = bnngate1 NOT VTL_N 
bnngate3 = bnngate2 NOT HNVT 
bnngate4 = bnngate3 NOT DNW 
bnngate = bnngate4 NOT CAP_IMP  //  I/O Native Devices

//* Define device -- nmos nch_uhvt
ngate_uhvt = ngate2 AND UHVT_N  //  CORE UHVT NMOS

//* Define device -- nmos nch_sram
gate_s1 = gate1 AND DMSRM 
gatennw_s = gate_s1 NOT nxwell  //  gate not inside nwell
ngate_s1 = gatennw_s AND NP 
ngate_s2 = ngate_s1 NOT OD2 
ngate_s3 = ngate_s2 NOT VTH_N 
ngate_s4 = ngate_s3 NOT VTL_N 
ngate_s5 = ngate_s4 NOT HVTSRM 
ngate_s = COPY ngate_s5  //  SRAM NMOS

//* Define device -- nmos nch_sram_hvt
ngate_s_hvt = ngate_s4 AND HVTSRM  //  HVT SRAM NMOS

//* Define device -- pmos P
gatenw = gate AND nxwell  //  gate inside nwell
tpgate1 = gatenw AND PP 
tpgate2 = tpgate1 NOT OD2 
tpgate3 = tpgate2 NOT HVNWi 
plvgate = tpgate3 AND VTL_P  //  CORE LOW_VT PMOS
pgate1 = tpgate3 NOT plvgate 
phvgate = tpgate3 AND VTH_P  //  CORE HIGH_VT PMOS
pgate2 = pgate1 NOT phvgate 
pgate = pgate2 NOT UHVT_P  //  CORE PMOS

//***** Define connectivity/via layer -- tpdiff ****
pthin = mdiff AND PP  //  define P+ thin oxide
tpdiff = pthin NOT gate1  //  define P+ diffusion region

//* Define device -- pmos PD
bpgate1 = tpgate1 AND OD2 
bpgate2 = bpgate1 NOT HVNWi 
bpgate = bpgate2 NOT VTL_P  //  I/O PMOS

//* Define device -- pmos pch_sram
gatenw_s = gate_s1 AND nxwell  //  gate inside nwell
pgate_s1 = gatenw_s AND PP 
pgate_s2 = pgate_s1 NOT OD2 
pgate_s3 = pgate_s2 NOT VTH_P 
pgate_s4 = pgate_s3 NOT VTL_P 
pgate_s = pgate_s4 NOT HVTSRM  //  SRAM PMOS

//* Define device -- pmos pchpu_hvtsr_g
pgate_s_hvt = pgate_s4 AND HVTSRM  //  HVT SRAM PMOS

//* Define device -- pmos PHL
bplvgate = bpgate2 AND VTL_P  //  I/O LOW_VT PMOS

//* Define device -- pmos pch_uhvt
pgate_uhvt = pgate2 AND UHVT_P  //  CORE UHVT PMOS

//* Define device -- diode DP
pdio1 = tpdiff AND DIODMY 
pdio2a = pdio1 AND nxwell 
npdiff = tpdiff AND tndiff  //  overlap region of PP diff with NP diff
zenarng = npdiff AND RPO 
zenpdif1 = pdio2a INTERACT zenarng 
pdio2 = pdio2a NOT zenpdif1 
pdio3 = pdio2 NOT OD2 
cpdio1 = pdio3 NOT VTH_P 
cpdio2 = cpdio1 NOT VTL_P 
cpdio3 = cpdio2 NOT INTERACT HVNWi 
cpdio = cpdio3 NOT UHVT_P  //  CORE P+/NW DIODE

//* Define device -- diode DN
ndio1 = tndiff AND DIODMY 
ndio2a = ndio1 AND psub 
ndio2b = ndio2a NOT HVOX 
ndio2 = ndio2b NOT PSUBi  //  Exclude ndio from ndio_hv(Add by pywangi on 09/08/04)
ndio3 = ndio2 NOT OD2 
ndio4 = ndio3 NOT NTN 
cndio1 = ndio4 NOT VTH_N 
cndio2 = cndio1 NOT VTL_N 
cndio = cndio2 NOT UHVT_N  //  CORE N+/PW DIODE

//* Define device -- diode DW
DIONW = DIODMY OUTSIDE tpdiff 
nwdio1a = nxwell AND DIONW 
nwdio1 = nwdio1a NOT HVNWi 
cnwdio = nwdio1 NOT OD2  //  CORE NW/PW diode

//* Define device -- diode D1
ipdioa = pdio2 AND OD2 
ipdio = ipdioa NOT VTL_P  //  I/O  P+/NW DIODE		

//* Define device -- diode D2
indio1 = ndio2 AND OD2 
indioa = indio1 NOT NTN 
indioa2 = indioa NOT VTL_N  //  I/O N+/PW DIODE
indio = indioa2 NOT CELLMV 

//* Define device -- diode DPL
pdiol = pdio3 AND VTL_P  //  CORE P+/NW Low_VT DIODE

//* Define device -- diode DNL
ndiol = ndio4 AND VTL_N  //  CORE N+/PW Low_VT DIODE

//* Define device -- diode D1N
nndio1 = ndio3 AND NTN 
ndion2 = nndio1 NOT VTH_N 
ndion3 = ndion2 NOT VTL_N  //  CORE N+/PW Native DIODE
cndion = ndion3 NOT OD3  //  CORE N+/PW Native DIODE

//* Define device -- diode D2N
indion = indio1 AND NTN  //  I/O N+/PW Native DIODE

//* Define device -- diode DPH
pdioh = pdio3 AND VTH_P  //  CORE P+/NW HIGH_VT DIODE

//* Define device -- diode DNH
ndioh = ndio4 AND VTH_N  //  CORE N+/PW HIGH_VT DIODE

//* Define device -- diode D3
inwdio = nwdio1 AND OD2  //  I/O NW/PW diode

//* Define device -- diode NDIO_lvt25
indio_lvt = indio1 AND VTL_N  //  I/O N+/PW Low_VT DIODE

//* Define device -- diode PDIO_lvt25
ipdio_lvt = ipdioa AND VTL_P  //  I/O  P+/NW Low_VT DIODE

//* Define device -- diode ndio_uhvt
cndio_uhvt = cndio2 AND UHVT_N  //  UHVT CORE N+/PW DIODE

//* Define device -- diode pdio_uhvt
cpdio_uhvt = cpdio3 AND UHVT_P  //  UHVT CORE P+/NW DIODE

//***** Define connectivity/via layer -- ydio_hole ****
ydio_hole = HOLES ydio 

//* Define device -- bjt pnp2
ttdiff = tpdiff AND BJTDMY 
nbase1a = nxwell NOT INTERACT DNW 
nbase1b = nbase1a NOT HVNWi 
nbase1c = nbase1b AND BJTDMY 
cemit1b = ttdiff AND nbase1c  //  define BJT[PV] emitter
cemit1c = cemit1b NOT NBL 
cemit1d = cemit1c INTERACT RPO 
cemit1e = cemit1d NOT OD2 
cemit1 = cemit1e NOT OD3 
cemit2 = AREA cemit1  > 3.999  < 4.001 

//***** Define connectivity/via layer -- coll1 ****
collsur = psub TOUCH nbase1c 
coll1a = collsur OR nbase1c  //  define BJT[PV] collector
collsura = collsur TOUCH cemit1b 
coll1b = coll1a NOT collsura 
coll1c = coll1b NOT cemit1  //  define pnp collector
coll1 = coll1c NOT NBL 

//***** Define connectivity/via layer -- nbase1 ****
nbase1 = nbase1c NOT NBL 

//* Define device -- bjt pnp5
cemit5 = AREA cemit1  > 24.999  < 25.001 

//* Define device -- bjt pnp10
cemit10 = AREA cemit1  > 99.999  < 100.001 

//* Define device -- bjt npn2
npnrg = DNW AND BJTDMY  //  define NPN region
nndiff = tndiff AND npnrg 
pbase1 = psub AND npnrg  //  define BJT[NV] base terminal
cnemit2 = nndiff AND pbase1  //  define BJT[NV] emitter
cnemit2a = cnemit2 INTERACT RPO  //  define BJT[NV] emitter
cnemit2b = cnemit2a NOT OD2  //  define BJT[NV] emitter
cnemit1 = cnemit2b NOT OD3  //  define BJT[NV] emitter
nemit2 = AREA cnemit1  > 3.999  < 4.001 

//***** Define connectivity/via layer -- ncoll1 ****
ncollrg1 = nxwell AND npnrg 
ncollrg = ncollrg1 NOT HVNWi 
ncolls = ncollrg TOUCH pbase1 
ncoll1 = ncolls OR pbase1  //  define BJT[NV] collector

//* Define device -- bjt npn5
nemit5 = AREA cnemit1  > 24.999  < 25.001 

//* Define device -- bjt npn10
nemit10 = AREA cnemit1  > 99.999  < 100.001 

//* Define device -- xdev M1
M1X = M1 OR DUM1 
M1Y = M1X NOT M1SLOT 
mt1res_RM = RMDMY OR RMDMYi1 
M1Z = M1Y AND mt1res_RM 
mt1res = M1Z INTERACT M1  //  metal1 resistor

//***** Define connectivity/via layer -- metal1 ****
metal1 = M1Y NOT mt1res 

//* Define device -- xdev M2
M2X = M2 OR DUM2 
M2Y = M2X NOT M2SLOT 
mt2res_RM = RMDMY OR RMDMYi2 
M2Z = M2Y AND mt2res_RM 
mt2res = M2Z INTERACT M2  //  metal2 resistor

//***** Define connectivity/via layer -- metal2 ****
metal2 = M2Y NOT mt2res 

//* Define device -- xdev M3
M3X = M3 OR DUM3 
M3Y = M3X NOT M3SLOT 
mt3res_RM = RMDMY OR RMDMYi3 
M3Z = M3Y AND mt3res_RM 
mt3res = M3Z INTERACT M3  //  metal3 resistor

//***** Define connectivity/via layer -- metal3 ****
metal3 = M3Y NOT mt3res 

//* Define device -- xdev M4
M4X = M4 OR DUM4 
M4Y = M4X NOT M4SLOT 
mt4res_RM = RMDMY OR RMDMYi4 
M4Z = M4Y AND mt4res_RM 
mt4res = M4Z INTERACT M4  //  metal4 resistor

//***** Define connectivity/via layer -- metal4 ****
metal4 = M4Y NOT mt4res 

//* Define device -- xdev M5
M5X = M5 OR DUM5 
M5Y = M5X NOT M5SLOT 
inddmy1 = IND_STD OR IND_SYM 
IND_CT = SIZE IND_CTi BY -0.005 
INDDMY = inddmy1 OR IND_CT 
M5Z = M5Y NOT INDDMY 
mt5res_RM = RMDMY OR RMDMYi5 
mt5res1 = M5Z AND mt5res_RM  //  metal5 resistor
mt5res = mt5res1 INTERACT M5 

//***** Define connectivity/via layer -- metal5 ****
metal5 = M5Z NOT mt5res 

//* Define device -- xdev M6
M6X = M6 OR DUM6 
M6Y = M6X NOT M6SLOT 
M6Z = M6Y NOT INDDMY 
mt6res_RM = RMDMY OR RMDMYi6 
mt6res1 = M6Z AND mt6res_RM  //  metal6 resistor
mt6res = mt6res1 INTERACT M6 

//***** Define connectivity/via layer -- metal6 ****
metal6 = M6Z NOT mt6res 

//* Define device -- xdev M7
M7X = M7 OR DUM7 
M7Y = M7X NOT M7SLOT 
M7Z = M7Y NOT INDDMY 
mt7res_RM = RMDMY OR RMDMYi7 
mt7res1 = M7Z AND mt7res_RM  //  metal7 resistor
mt7res = mt7res1 INTERACT M7 

//***** Define connectivity/via layer -- metal7 ****
metal7 = M7Z NOT mt7res 

//* Define device -- xdev ME
M8X = M8 OR DUM8 
M8Y = M8X NOT M8SLOT 
M8Z = M8Y NOT INDDMY 
mt8res_RM = RMDMY OR RMDMYi8 
mt8res1 = M8Z AND mt8res_RM  //  metal8 resistor
mt8res = mt8res1 INTERACT M8 

//***** Define connectivity/via layer -- metal8 ****
metal8 = M8Z NOT mt8res 

//* Define device -- xdev PR
rppolywo_r1 = rpolywo AND PP 
rppolywo_r2 = rppolywo_r1 INTERACT RPDMYi 
rppolywo_r3 = rppolywo_r2 NOT RFDMY 
rppolywo_r = rppolywo_r3 INTERACT POLYGi  //  P+POLY resistor w/o silicide

//* Define device -- xdev NR
rnpolywo_r1 = rpolywo AND NP 
rnpolywo_r2 = rnpolywo_r1 INTERACT RPDMYi 
rnpolywo_r = rnpolywo_r2 INTERACT POLYGi  //  N+POLY resistor w/o silicide

//* Define device -- xdev PD
rpodwo1 = rodwo AND PP 
rpodwo_r1 = rpodwo1 AND NWELL 
rpodwo_r2 = rpodwo_r1 INTERACT RPDMYi 
rpodwo_r = rpodwo_r2 INTERACT ODi  //  P+OD resistor w/o silicide

//* Define device -- xdev ND
rnodwo1 = rodwo AND NP 
rnodwo_r1 = rnodwo1 NOT NWELL 
rnodwo_r2 = rnodwo_r1 INTERACT RPDMYi 
rnodwo_r = rnodwo_r2 INTERACT ODi  //  N+OD resistor w/o silicide

//* Define device -- xdev WR
trwell = NWDMY AND NWELL  //  N-well resistor layer
drpo1 = diff AND RPO 
drpo = drpo1 INTERACT ODi 
nwsti_r1 = trwell NOT drpo  //  NWDMY*NWELL-RPO-diff --> nwsti
nwsti_r = nwsti_r1 INTERACT NWDMYi  //  NWDMY*NWELL-RPO-diff --> nwsti

//* Define device -- xdev WO
nwod_r1 = trwell AND drpo 
nwod_r = nwod_r1 INTERACT NWDMYi  //  NWDMY*NWELL*RPO*diff --> nwod

//* Define device -- xdev PS1
rppoly_r1 = rpoly AND PP 
rppoly_r1_eg = rppoly_r1 INSIDE EDGE POLYG 
l_rppoly_r1_eg = LENGTH rppoly_r1_eg  >= 2  < 99999999 
l_rppoly_r1 = rppoly_r1 WITH EDGE l_rppoly_r1_eg 
rf_lrppoly = l_rppoly_r1 AND RFDMY 
lrppoly_rf1 = rf_lrppoly INTERACT RPDMYi 
lrppoly_rf = lrppoly_rf1 INTERACT POLYGi  //  P+POLY resistor w/i silicide (3-terminal rf w >=  2um)
lrppoly_ra = l_rppoly_r1 NOT lrppoly_rf 
lrppoly_d1 = l_rppoly_r1 INTERACT RPDMY1 
lrppoly_d = lrppoly_d1 INTERACT POLYGi  //  P+POLY resistor w/i silicide (3-terminal dis w >=  2um)
lrppoly_rb = lrppoly_ra NOT lrppoly_d 
s_rppoly_r1 = rppoly_r1 NOT l_rppoly_r1 
rf_srppoly = s_rppoly_r1 AND RFDMY 
srppoly_rf1 = rf_srppoly INTERACT RPDMYi 
srppoly_rf = srppoly_rf1 INTERACT POLYGi  //  P+POLY resistor w/i silicide (3-terminal rf w < 2um)
srppoly_ra = s_rppoly_r1 NOT srppoly_rf 
srppoly_d1 = s_rppoly_r1 INTERACT RPDMY1 
srppoly_d = srppoly_d1 INTERACT POLYGi  //  P+POLY resistor w/i silicide (3-terminal dis w < 2um)
srppoly_rb = srppoly_ra NOT srppoly_d 
rppoly_rx = lrppoly_rb OR srppoly_rb 
rppoly_ry = rppoly_rx INTERACT RPDMYi 
rppoly_r = rppoly_ry INTERACT POLYGi  //  P+POLY resistor w/i silicide
rppoly_edge = rppoly_r INSIDE EDGE POLYG 
l_rppoly = LENGTH rppoly_edge  >= 2  < 99999999 
rppolyl_r = rppoly_r WITH EDGE l_rppoly  //   P+POLY resistor w/i silicide >=  2

//* Define device -- xdev PS2
rppolys_r = rppoly_r NOT rppolyl_r  //   P+POLY resistor w/i silicide < 2

//* Define device -- xdev NS1
rnpoly_r1 = rpoly AND NP 
rnpoly_r2 = rnpoly_r1 INTERACT RPDMYi 
rnpoly_r = rnpoly_r2 INTERACT POLYGi  //  N+POLY resistor w/i silicide
rnpoly_edge = rnpoly_r INSIDE EDGE POLYG 
l_rnpoly = LENGTH rnpoly_edge  >= 2  < 99999999 
rnpolyl_r = rnpoly_r WITH EDGE l_rnpoly  //   N+POLY resistor w/i silicide >=  2

//* Define device -- xdev NS2
rnpolys_r = rnpoly_r NOT rnpolyl_r  //   N+POLY resistor w/i silicide < 2

//* Define device -- xdev PI1
rpod1 = rod AND PP 
rpod_r1 = rpod1 AND NWELL 
rpod_r2 = rpod_r1 INTERACT RPDMYi 
rpod_r = rpod_r2 INTERACT ODi  //  P+OD resistor w/i silicide
rpod_edge = rpod_r INSIDE EDGE diff 
l_rpod = LENGTH rpod_edge  >= 2  < 99999999 
rpodl_r = rpod_r WITH EDGE l_rpod  //   P+OD resistor w/i silicide >=  2

//* Define device -- xdev PI2
rpods_r = rpod_r NOT rpodl_r  //   P+OD resistor w/i silicide < 2

//* Define device -- xdev NI1
rnod1 = rod AND NP 
rnod_r1 = rnod1 NOT NWELL 
rnod_r2 = rnod_r1 INTERACT RPDMYi 
rnod_r = rnod_r2 INTERACT ODi  //  N+OD resistor w/i silicide
rnod_edge = rnod_r INSIDE EDGE diff 
l_rnod = LENGTH rnod_edge  >= 2  < 99999999 
rnodl_r = rnod_r WITH EDGE l_rnod  //   N+OD resistor w/i silicide >=  2

//* Define device -- xdev NI2
rnods_r = rnod_r NOT rnodl_r  //   N+OD resistor w/i silicide < 2

//***** Define connectivity/via layer -- pplug ****
pplug1 = tpdiff AND psub  //  define p_sub contact
pplug3 = pplug1 INTERACT CONT 
tndiffco = tndiff INTERACT CONT 
pplug2 = pplug1 INTERACT tndiffco 
pplug = pplug3 OR pplug2  //  define p_sub contact

//* Define device -- xdev rpodwo_m
rpodwo_mr1 = rpodwo_r1 INTERACT RPDMY1 
rpodwo_mr = rpodwo_mr1 INTERACT ODi  //  P+OD resistor w/o silicide (3-terminals)

//* Define device -- xdev rnodwo_m
rnodwo_mr1 = rnodwo_r1 INTERACT RPDMY1 
rnodwo_mr = rnodwo_mr1 INTERACT ODi  //  N+OD resistor w/o silicide (3-terminals)

//* Define device -- xdev rnwod_m
nwod_mr = nwod_r1 INTERACT NWDMY1  //  NWDMY*NWELL*RPO*diff --> nwod (3-terminals)

//* Define device -- xdev rpodl_m
rpod_mr1a = rpod_r1 INTERACT RPDMY1 
rpod_mr1 = rpod_mr1a INTERACT ODi 
rpod_mr1_edge = rpod_mr1 INSIDE EDGE diff 
l_rpod_mr1 = LENGTH rpod_mr1_edge  >= 2  < 99999999 
rpodl_mr = rpod_mr1 WITH EDGE l_rpod_mr1  //  P+OD resistor w/i silicide (3-terminals)

//* Define device -- xdev rnodl_m
rnod_mr1a = rnod_r1 INTERACT RPDMY1 
rnod_mr1 = rnod_mr1a INTERACT ODi 
rnod_mr1_edge = rnod_mr1 INSIDE EDGE diff 
l_rnod_mr1 = LENGTH rnod_mr1_edge  >= 2  < 99999999 
rnodl_mr = rnod_mr1 WITH EDGE l_rnod_mr1  //  N+OD resistor w/i silicide (3-terminals)

//* Define device -- xdev rpods_m
rpods_mr = rpod_mr1 NOT rpodl_mr  //  P+OD resistor w/i silicide (3-terminals)

//* Define device -- xdev rnods_m
rnods_mr = rnod_mr1 NOT rnodl_mr  //  N+OD resistor w/i silicide (3-terminals)

//* Define device -- xdev rnwsti_m
nwsti_mr = nwsti_r1 INTERACT NWDMY1  //  NWDMY*NWELL-RPO-diff --> nwsti (3-terminals)

//* Define device -- xdev pwdnw
rwdio_a = DNW NOT nxwell 
rwdio = rwdio_a NOT BJTDMY 

//* Define device -- xdev dnwpsub
dnwdio_b = nxwell INTERACT DNW 
dnwdio_c = dnwdio_b NOT HVNWi 
dnwdio_a = nxwell INSIDE DNW 
dnwdio_k = dnwdio_c NOT dnwdio_a 
dnwdio = DNW INTERACT dnwdio_k 

//***** Define connectivity/via layer -- psub_term ****
psub_term_a = psub2s NOT PSUB2 
psub_term_b = BULK NOT psub_term_a 
psub_term_c = BULK AND DNW 
psub_term_d = BULK NOT psub_term_c 
psub_term_e = psub_term_b AND psub_term_d 
psub_term_f = psub_term_e NOT PSUBi 
psub_term_g = psub_term_f INTERACT DNW 
psub_term = psub_term_g NOT HVOX 

//* Define device -- xdev pnwdio
bjtdmy_nbase_all = BJTDMY INTERACT nbase1  //  BJTDMY in pnp devices
pnwdio0 = nxwell NOT bjtdmy_nbase_all 
pnwdio1 = pnwdio0 NOT INTERACT NWDMY1 
pnwdio2 = pnwdio1 OUTSIDE nwdio1a 
pnwdio4 = pnwdio2 NOT DNW 
pnwdio = pnwdio4 TOUCH psub == 1

//* Define device -- xdev rppolyhri_dis
hripo_d1 = hripo41 INTERACT RPDMY1 
hripo_d2 = hripo_d1 INTERACT POLYGi  //  HRI high poly resistor (3-terminals dis)
RHRIDMY_2K = COPY RHRIDMY_2Ki 
RHRIDMY_2Ka = BULK INTERACT RHRIDMY_2K 
hripo_d = hripo_d2 NOT INTERACT RHRIDMY_2Ka 

//***** Define connectivity/via layer -- poly_term ****
poly_term11 = POLYG AND RPDMY1 
hripo42 = hripo41 INTERACT RPDMYi 
rf_hripo1 = hripo42 AND RFDMY 
rf_hripo = rf_hripo1 INTERACT POLYGi  //  HRI high poly resistor (3-terminals rf)
poly_term1 = poly_term11 OR rf_hripo 
poly_term2 = SIZE poly_term1 BY 0.005 
poly_term = poly_term2 NOT poly_term1 

//* Define device -- xdev rnpolywo_dis
rnpolywo_d1 = rnpolywo_r1 INTERACT RPDMY1 
rnpolywo_d = rnpolywo_d1 INTERACT POLYGi  //  N+POLY resistor w/o silicide (3-terminals dis)

//* Define device -- xdev rppolywo_dis
rppolywo_d1 = rppolywo_r1 INTERACT RPDMY1 
rppolywo_d = rppolywo_d1 INTERACT POLYGi  //  P+POLY resistor w/o silicide (3-terminals dis)

//* Define device -- xdev rnpolyl_dis
rnpoly_m = rnpoly_r1 INTERACT RPDMY1 
rnpoly_eg = rnpoly_m INSIDE EDGE POLYG 
l_rnpoly_eg = LENGTH rnpoly_eg  >= 2  < 99999999 
lrnpoly_d1 = rnpoly_m WITH EDGE l_rnpoly_eg 
lrnpoly_d = lrnpoly_d1 INTERACT POLYGi  //  N+POLY resistor w/i silicide (3-terminal dis w >=  2um)

//* Define device -- xdev rnpolys_dis
srnpoly_d1 = rnpoly_m NOT lrnpoly_d 
srnpoly_d = srnpoly_d1 INTERACT POLYGi  //   N+POLY resistor w/i silicide (3-terminal dis w < 2um)

//* Define device -- xdev nc1
gatenw1 = gatenw NOT HVNWi 
vargt1 = gatenw1 AND NP 
vargt2 = vargt1 AND VARDMY 
vargt3 = vargt2 NOT OD2 
vargt4 = vargt3 NOT RFDMY  //  Varactor on thin oxide
vargt = vargt4 NOT OD3  //  Varactor on thin oxide

//* Define device -- xdev nc2
bvargt1 = vargt2 AND OD2 
bvargt = bvargt1 NOT RFDMY  //  Varactor on thick oxide

//* Define device -- xdev pc1
pvargt1 = gatennw AND PP 
pvargt2 = pvargt1 AND VARDMY 
pvargt = pvargt2 NOT OD2  //  Varactor on thin oxide

//* Define device -- xdev pc2
pbvargt = pvargt2 AND OD2  //  Varactor on thick oxide

//* Define device -- xdev rppolyhri
hripo43 = hripo42 NOT RFDMY 
hripo44 = hripo43 NOT INTERACT RHRIDMY_2Ka 
hripo4 = hripo44 INTERACT POLYGi  //  HRIp high poly resistor (2-terminals)

//* Define device -- xdev mimcap_1p0_sin
ctm = COPY CTMi 
cbm = COPY CBMi 
mim_block = ctm AND cbm 
mim_top = mim_block INTERACT M7 
RCTM = mim_top INTERACT VIA6i 
RCTM_R = RCTM NOT RFDMY 

//* Define device -- xdev sbd_rf
SBD_RF1 = SBDDMY AND RFDMY 
SBD_RF = SBD_RF1 NOT VARDMY 
sbd_nw = nxwell AND SBD_RF 
schottky_n = nthin1 AND sbd_nw 
sbd_rfnw_org1 = sbd_nw INTERACT schottky_n 
pthin1 = mdiff CUT PP 
schottky_p = pthin1 AND sbd_nw 
sbd_rfnw_org = sbd_rfnw_org1 INTERACT schottky_p 
sbd_rfdnw = sbd_rfnw_org INTERACT DNW 

//* Define device -- xdev sbd_rf_nw
sbd_rfnw = sbd_rfnw_org NOT INTERACT DNW 

//* Define device -- xdev nmos_rf
gate_rfa = gate_a AND RFDMY 
poly_rf1 = poly INTERACT CONT 
poly_rf = poly_rf1 INTERACT DRAIN 
gate_rfb = gate_rfa AND poly_rf 
gate_rf = gate_rfb NOT VARDMY 
ngate_rf1 = gate_rf AND NP 
ngate_rf2 = ngate_rf1 NOT VTH_N 
ngate_rf3 = ngate_rf2 NOT VTL_N 
ngate_rf4 = ngate_rf3 NOT NTN 
ngate_rf5 = ngate_rf4 INSIDE DNW 
ngate_rf = ngate_rf5 NOT OD2 
ngate_nthin = nthin INTERACT ngate_rf 

//***** Define connectivity/via layer -- d_tndiff ****
d_tndiff = tndiff AND DRAIN 

//***** Define connectivity/via layer -- s_tndiff ****
s_tndiff1 = tndiff NOT DRAIN 
s_tndiff = s_tndiff1 INTERACT gate_rf 

//* Define device -- xdev nmos_rf25
ngate_rf_io = ngate_rf5 AND OD2 
ngate_nthin_io = nthin INTERACT ngate_rf_io 

//* Define device -- xdev pmos_rf
pgate_rf1 = gate_rf AND PP 
pgate_rf2 = pgate_rf1 NOT VTH_P 
pgate_rf3 = pgate_rf2 NOT VTL_P 
pgate_rf = pgate_rf3 NOT OD2 
pgate_pthin1 = pthin INTERACT pgate_rf 
pgate_pthin = pgate_pthin1 INSIDE DNW 

//***** Define connectivity/via layer -- d_tpdiff ****
d_tpdiff = tpdiff AND DRAIN 

//***** Define connectivity/via layer -- s_tpdiff ****
s_tpdiff1 = tpdiff NOT DRAIN 
s_tpdiff = s_tpdiff1 INTERACT gate_rf 

//* Define device -- xdev pmos_rf25
pgate_rf_io = pgate_rf3 AND OD2 
pgate_pthin_io1 = pthin INTERACT pgate_rf_io 
pgate_pthin_io = pgate_pthin_io1 INSIDE DNW 

//* Define device -- xdev pmos_rf_nw
pgate_rfnw = pgate_pthin1 OUTSIDE DNW 

//* Define device -- xdev pmos_rf25_nw
pgate_rf33nw = pgate_pthin_io1 OUTSIDE DNW 

//* Define device -- xdev spiral_std
IND_STD_a = IND_STD AND NTN 
IND_STD_all = IND_STD_a AND RFDMY 
std_ind1 = M8Y AND IND_STD_all 
std_ind2 = M7Y AND IND_STD_all 
std_ind = std_ind1 OR std_ind2 
std_ind_m = std_ind1 AND std_ind2 

//* Define device -- xdev spiral_sym
IND_SYM_a = IND_SYM AND NTN 
IND_SYM_all = IND_SYM_a AND RFDMY 
sym_ind1 = M8Y AND IND_SYM_all 
sym_ind2 = M7Y AND IND_SYM_all 
sym_ind = sym_ind1 OR sym_ind2 
sym_ind_m = sym_ind1 AND sym_ind2 
ind_btm1 = sym_ind2 AND sym_ind1 
ind_btm2 = ind_btm1 INTERACT VIA7 
ind_btm = ind_btm2 OR IND_RAD 

//* Define device -- xdev spiral_sym_ct
IND_CT_a = IND_CT AND NTN 
IND_CT_all = IND_CT_a AND RFDMY 
sym_ct_ind1 = M8Y AND IND_CT_all 
sym_ct_ind2 = M7Y AND IND_CT_all 
sym_ct_ind5 = sym_ct_ind1 OR sym_ct_ind2 
sym_ct_ind3 = M6Y AND IND_CT_all 
sym_ct_ind = sym_ct_ind5 OR sym_ct_ind3 
sym_ct_ind_m = sym_ct_ind1 AND sym_ct_ind2 
ind_ct_btm1 = sym_ct_ind2 AND sym_ct_ind1 
ind_ct_btm2 = ind_ct_btm1 INTERACT VIA7 
ind_ct_btm = ind_ct_btm2 OR IND_RAD 
sym_ct_ind_m1 = sym_ct_ind2 AND sym_ct_ind3 

//* Define device -- xdev rppolyl_rf
lrppoly_rf_b = RFDMY INTERACT lrppoly_rf 

//* Define device -- xdev rppolys_rf
srppoly_rf_b = RFDMY INTERACT srppoly_rf 

//* Define device -- xdev rppolywo_rf
rf_rppolywo1 = rppolywo_r2 AND RFDMY 
rf_rppolywo = rf_rppolywo1 INTERACT POLYGi  //  P+POLY resistor w/o silicide (3-terminals rf)
rf_rppolywo_b = RFDMY INTERACT rf_rppolywo 

//* Define device -- xdev rppolyhri_rf
rf_hripo_b = RFDMY INTERACT rf_hripo 

//* Define device -- xdev mimcap_um_1p0_sin_rf
RCTM_RF1 = RCTM AND RFDMY 
RCTM_RF = RCTM_RF1 OUTSIDE DNW 
RCTM_WOUM = RCTM_RF1 INSIDE DNW 

//***** Define connectivity/via layer -- shield ****
shield1 = metal5 OR metal4 
shield2 = shield1 AND ctm 
shield = shield2 AND RFDMY 
L_EG1 = ctm INSIDE EDGE metal7 

//* Define device -- xdev xjvar
VAR_RF1 = VARDMY AND RFDMY 
VAR_RF2 = VAR_RF1 NOT SBDDMY 
VAR_RF = VAR_RF2 INTERACT gate_a 
XJ_RF = VAR_RF2 NOT VAR_RF 
jvar1_rf = nxwell AND XJ_RF 
jvar2_rf = jvar1_rf INTERACT tpdiff 
jvar_rf = jvar2_rf INTERACT tndiff 
jvar_rf1 = jvar_rf AND DNW 

//* Define device -- xdev xjvar_nw
jvar3_rf = jvar_rf AND tpdiff 
jvar_rfnw = jvar_rf NOT DNW 

//* Define device -- xdev moscap_rf
varnw_rf1 = nxwell AND VAR_RF 
varnw_rf2 = varnw_rf1 INTERACT NP 
varnw_rf = varnw_rf2 NOT HVNWi 
varnwc_rf1 = varnw_rf NOT OD2 
varnwc_rf = varnwc_rf1 AND DNW 

//* Define device -- xdev moscap_rf_nw
vargt_rf = gate_a AND VAR_RF 
vargtc_rf = vargt_rf NOT OD2 

//* Define device -- xdev moscap_rf25
varnwi_rf1 = varnw_rf AND OD2 
varnwi_rf = varnwi_rf1 AND DNW 

//* Define device -- xdev moscap_rf25_nw
vargti_rf = vargt_rf AND OD2 
varnwc_rfnw = varnwc_rf1 NOT DNW 
varnwi_rfnw = varnwi_rf1 NOT DNW 

//* Define device -- xdev crtmom
MOM_field1 = MOMDMY AND M1 
MOM_field2 = MOMDMY AND M2 
MOM_node2 = MOM_field2 AND MOM_field1 
MOM_term_12 = MOM_node2 INTERACT VIA1 
MOM_finger_1 = MOM_field1 NOT MOM_term_12 
MOM_finger_1a = MOM_finger_1 INTERACT MOM_term_12 
MOM_reg3a = SIZE MOM_finger_1a BY 0.4 
MOM_field3 = MOMDMY AND M3 
MOM_node3 = MOM_field3 AND MOM_node2 
MOM_field6 = MOMDMY AND M6 
MOM_field5 = MOMDMY AND M5 
MOM_field4 = MOMDMY AND M4 
MOM_node4 = MOM_field4 AND MOM_node3 
MOM_node5 = MOM_field5 AND MOM_node4 
MOM_node6 = MOM_field6 AND MOM_node5 
MOM6_term1 = MOM_node6 INTERACT VIA5 
MOM_term_23 = MOM_node3 INTERACT VIA1 
MOM_finger_2 = MOM_field2 NOT MOM_term_23 
MOM6_term2 = MOM6_term1 TOUCH MOM_finger_2 
MOM_finger_3 = MOM_field3 NOT MOM_term_23 
MOM6_term3 = MOM6_term2 TOUCH MOM_finger_3 
MOM_finger_6 = MOM_field6 NOT MOM_node6 
MOM6_key = MOM_finger_2 AND MOM_finger_6 
MOM6_term = MOM6_term3 TOUCH MOM6_key 
MOM3_terma = MOM_node3 OUTSIDE MOM6_term 
MOM5_terma = MOM_node5 OUTSIDE MOM6_term 
MOM5_term1 = MOM5_terma INTERACT VIA4 
MOM5_term2 = MOM5_term1 TOUCH MOM_finger_2 
MOM5_term3 = MOM5_term2 TOUCH MOM_finger_3 
MOM_finger_5 = MOM_field5 NOT MOM_node5 
MOM5_key = MOM_finger_3 AND MOM_finger_5 
MOM5_term = MOM5_term3 TOUCH MOM5_key 
MOM3_termc = MOM3_terma OUTSIDE MOM5_term 
MOM4_terma = MOM_node4 OUTSIDE MOM6_term 
MOM4_termc = MOM4_terma OUTSIDE MOM5_term 
MOM4_term1 = MOM4_termc INTERACT VIA3 
MOM4_term2 = MOM4_term1 TOUCH MOM_finger_2 
MOM4_term3 = MOM4_term2 TOUCH MOM_finger_3 
MOM_finger_4 = MOM_field4 NOT MOM_node4 
MOM4_key = MOM_finger_2 AND MOM_finger_4 
MOM4_term = MOM4_term3 TOUCH MOM4_key 
MOM3_termd = MOM3_termc OUTSIDE MOM4_term 
MOM3_term1 = MOM3_termd INTERACT VIA2 
MOM3_term2 = MOM3_term1 TOUCH MOM_finger_1 
MOM3_term3 = MOM3_term2 TOUCH MOM_finger_2 
MOM3_key = MOM_finger_3 AND MOM_finger_1 
MOM3_term = MOM3_term3 TOUCH MOM3_key 
MOM_reg3 = MOM_reg3a INTERACT MOM3_term 

//***** Define connectivity/via layer -- MOM_plant ****
MOM_plant = poly12 INTERACT MOMDMY 

//* Define device -- xdev crtmom4
MOM_finger_2a = MOM_finger_2 INTERACT MOM_term_23 
MOM_rega = SIZE MOM_finger_2a BY 0.4 
MOM_reg4 = MOM_rega INTERACT MOM4_term 

//* Define device -- xdev crtmom5
MOM_reg5 = MOM_rega INTERACT MOM5_term 

//* Define device -- xdev crtmom6
MOM_reg6 = MOM_rega INTERACT MOM6_term 

//***** Define connectivity/via layer -- ydio_ass ****
ydio_ass = SIZE ydio_j BY 0.5 

//***** Define connectivity/via layer -- polyCont ****
polyCont = CONT AND POLYG 

//***** Define connectivity/via layer -- dnwc ****
dnwc = DNW AND nxwell 

//***** Define connectivity/via layer -- tiod ****
tioda = diff NOT tpdiff 
tiodb = tioda NOT tndiff 
tiod1 = tiodb NOT POLYG 
tiod2 = tiod1 NOT RPO 
tiod3 = tiod2 NOT RPDMY 
tiod = tiod3 NOT NWDMY  //  RPO, RPDMY, NWDMY cut ti-od

//***** Define connectivity/via layer -- n_psub ****
n_ppsuba = BULK NOT psubband 
hnw_nbl1 = iso_hvnw INTERACT NBL 
iso_hvrw = ppsub INSIDE NBL 
hnw_nbl = hnw_nbl1 INTERACT iso_hvrw 
n_ppsubb = n_ppsuba NOT hnw_nbl 
HVPW = HVOX NOT HVNWi 
n_ppsubc = n_ppsubb NOT HVPW 
n_psub1 = n_ppsubc NOT psub2s 
n_psub2 = n_ppsubc AND PSUB2 
n_psub = n_psub1 OR n_psub2 

//***** Define connectivity/via layer -- cbm_via ****
RCBM = cbm INTERACT RCTM 
OCBM = RCBM NOT RCTM 
cbm_via = OCBM AND VIA6i 

//***** Define connectivity/via layer -- nxwell_npn ****
ncollsa = ncolls TOUCH cnemit1 
nxwell_npn = ncolls NOT ncollsa 

//***** Define connectivity/via layer -- MOM_edge_mt ****
MOM_edge_mt = M1 AND MOM_plant 

//***** Define connectivity/via layer -- odCont ****
odCont = CONT NOT POLYG 

//***** Define connectivity/via layer -- HVNW ****
HVNW = HVNWi AND HVOX 

//***** Define connectivity/via layer -- VIA8 ****
VIA8 = COPY VIAD 

//***** Define connectivity/via layer -- nplug ****
nplug1 = tndiff AND nxwell  //  define N_well contact
nplug3 = nplug1 INTERACT CONT 
tpdiffco = tpdiff INTERACT CONT 
nplug2 = nplug1 INTERACT tpdiffco 
nplug = nplug3 OR nplug2  //   define N_well contact

//* Define ERC or other layers
erc_pmos_gates = tpgate1 NOT VARDMY  //  Exclude RF, SRAM, VAR

//***** Define connectivity/via layer -- ntap ****
ntapx = tndiff AND nxwell 
ntap1 = ntapx NOT BJTDMY 
ntap2 = ntap1 INTERACT CONT 
ntap3 = ntap1 INTERACT tpdiffco 
ntap = ntap2 OR ntap3 

//***** Define connectivity/via layer -- poly_nw_via ****
poly_nw_via = poly_term AND nxwell 

//***** Define connectivity/via layer -- ctm_via ****
ctm_via = RCTM AND VIA6i 

//***** Define connectivity/via layer -- VIA6 ****
VIA6a = VIA6i NOT ctm_via 
VIA6 = VIA6a NOT cbm_via 

//***** Define connectivity/via layer -- n_pplug ****
n_pplug1 = mdiff INTERACT CONT 
n_pplug2 = n_pplug1 AND PP 
n_pplug3 = n_pplug2 NOT nxwell 
rw = ppsub INSIDE DNW 
n_pplug4 = n_pplug3 NOT rw 
n_pplug5 = n_pplug4 AND n_psub 
n_pplug = n_pplug5 NOT gate1 

//***** Define connectivity/via layer -- poly_psub_via ****
poly_psub_via = poly_term AND psub 
nxwell_float1 = nxwell NOT INTERACT VARDMY 
nxwell_float2 = nxwell_float1 NOT INTERACT BJTDMY 
nxwell_float = nxwell_float2 NOT INTERACT trwell 

//***** Define connectivity/via layer -- ptap ****
ptap1 = tpdiff AND psub 
ptap2 = ptap1 INTERACT CONT 
ptap3 = ptap1 INTERACT tndiffco 
ptap = ptap2 OR ptap3 

//***** Define connectivity/via layer -- hvdnwc ****
hvdnwc1 = NBL AND HVNW 
hvdnwc2 = hvdnwc1 NOT DPW 
hvdnwc3 = NBL AND iso_hvnw 
hvdnwc = hvdnwc2 OR hvdnwc3 

//***** Define connectivity/via layer -- metal9 ****
metal9 = COPY MD 
erc_nmos_gates = tngate1 NOT VARDMY  //  Exclude RF, SRAM, VAR
//#############################################
//# CONNECTION                                #
//#############################################
CONNECT MOM_edge_mt MOM_plant BY polyCont
CONNECT MOM_field1 MOM_field2 BY VIA1
CONNECT MOM_field2 MOM_field3 BY VIA2
CONNECT MOM_field3 MOM3_term
CONNECT MOM_field3 MOM_field4 BY VIA3
CONNECT MOM_field4 MOM4_term
CONNECT MOM_field4 MOM_field5 BY VIA4
CONNECT MOM_field5 MOM5_term
CONNECT MOM_field5 MOM_field6 BY VIA5
CONNECT MOM_field6 MOM6_term
CONNECT MOM_plant poly
CONNECT cbm metal7 BY cbm_via
CONNECT cemit1 tpdiff
CONNECT cnemit1 tndiff
CONNECT ctm metal7 BY ctm_via
CONNECT gate1 poly
CONNECT metal1 MOM_edge_mt
CONNECT metal1 MOM_field1
CONNECT metal1 d_tndiff BY odCont
CONNECT metal1 d_tpdiff BY odCont
CONNECT metal1 poly BY polyCont
CONNECT metal1 poly_rf BY polyCont
CONNECT metal1 s_tndiff BY odCont
CONNECT metal1 s_tpdiff BY odCont
CONNECT metal1 schottky_n BY odCont
CONNECT metal1 schottky_p BY odCont
CONNECT metal1 tndiff BY odCont
CONNECT metal1 tpdiff BY odCont
CONNECT metal2 MOM_field2
CONNECT metal2 metal1 BY VIA1
CONNECT metal3 MOM_field3
CONNECT metal3 metal2 BY VIA2
CONNECT metal4 MOM_field4
CONNECT metal4 metal3 BY VIA3
CONNECT metal5 MOM_field5
CONNECT metal5 metal4 BY VIA4
CONNECT metal6 MOM_field6
CONNECT metal6 metal5 BY VIA5
CONNECT metal7 metal6 BY VIA6
CONNECT metal8 metal7 BY VIA7
CONNECT metal9 metal8 BY VIA8
CONNECT mim_block ctm
CONNECT n_pplug tpdiff
CONNECT nbase1 tndiff BY nplug
CONNECT ncoll1 nxwell_npn
CONNECT nplug tndiff
CONNECT ntap tndiff
CONNECT pbase1 tpdiff BY pplug
CONNECT poly_rf poly
CONNECT pplug tpdiff
CONNECT ptap tpdiff
CONNECT shield metal4
CONNECT tiod tndiff
CONNECT tiod tpdiff
CONNECT tndiff nxwell_npn BY nplug
CONNECT tndiff tpdiff
CONNECT tndiff ydio
CONNECT tndiff ydio_ass
CONNECT tndiff ydio_hole

#IFDEF RC_DECK
CONNECT  poly gate
CONNECT  nxwell poly_term BY poly_nw_via
CONNECT  nxwell DNW BY dnwc
CONNECT  psub poly_term BY poly_psub_via
CONNECT  iso_hvnw NBL BY hvdnwc
CONNECT  tpdiff psub_term BY pplug
CONNECT  tpdiff psub BY pplug
CONNECT  tpdiff HVPW BY pplug
CONNECT  tpdiff coll1 BY pplug
CONNECT  HVNW NBL BY hvdnwc
CONNECT  tndiff nxwell BY nplug
CONNECT  tndiff iso_hvnw BY nplug
CONNECT  tndiff HVNW BY nplug
#ELSE
SCONNECT nxwell poly_term BY poly_nw_via
SCONNECT nxwell DNW BY dnwc
SCONNECT psub poly_term BY poly_psub_via
SCONNECT iso_hvnw NBL BY hvdnwc
#IFNDEF NW_RING
  SCONNECT tpdiff n_psub BY n_pplug
#ENDIF
SCONNECT tpdiff psub_term BY pplug
SCONNECT tpdiff psub BY pplug
SCONNECT tpdiff HVPW BY pplug
SCONNECT tpdiff coll1 BY pplug
SCONNECT HVNW NBL BY hvdnwc
SCONNECT tndiff nxwell BY nplug
SCONNECT tndiff iso_hvnw BY nplug
SCONNECT tndiff HVNW BY nplug
#ENDIF
//#############################################
//# FORM DEVICE                               #
//#############################################

#IFDEF RC_DECK
DEVICE MN(N) ngate poly(G) tndiff(S) tndiff(D) psub(B) <nthin> <OD> netlist model nch [
  property sa,sb,W,L,AS,AD,PD,PS,NRD,NRS
   SCALE = PRESCALE
   W = (perimeter_coincide(ngate, tndiff ) + perimeter_inside(ngate, tndiff)) / 2
   L = area(ngate) / W
   s = enclosure_vector( OD, 60 )
   sa = W/sum(s::W/(s::a + 0.5 *L)) - 0.5*L
   sb = W/sum(s::W/(s::b + 0.5 *L)) - 0.5*L
   PI_S_OD = perimeter_inside(S,nthin)
   PI_D_OD = perimeter_inside(D,nthin)
   IF(PI_S_OD == 0) {
    AD = area(D) * W / PI_D_OD
    AS = AD
    PD = perimeter(D) * W /PI_D_OD
    PS = PD } 
   ELSE IF(PI_D_OD == 0) {
    AS = area(S) * W / PI_S_OD
    AD = AS
    PS = perimeter(S) * W /PI_S_OD
    PD = PS } 
   ELSE {
    AS = area(S) * W / PI_S_OD
    AD = area(D) * W / PI_D_OD
    PS = perimeter(S) * W /PI_S_OD
    PD = perimeter(D) * W /PI_D_OD }
 #IFDEF ZERO_NRS_NRD 
   NRS = 0
   NRD = 0
 #ELSE 
   NRS = AS / W / W
   NRD = AD / W / W
 #ENDIF 
]

DEVICE MN(N1) nrgate poly(G) tndiff(S) tndiff(D) psub(B) <nthin> <OD> netlist model nch [
  property sa,sb,W,L,AS,AD,PD,PS,NRD,NRS
   SCALE = PRESCALE
   W = (perimeter_coincide(nrgate, tndiff ) + perimeter_inside(nrgate, tndiff)) / 2
   L = area(nrgate) / W
   s = enclosure_vector( OD, 60 )
   sa = W/sum(s::W/(s::a + 0.5 *L)) - 0.5*L
   sb = W/sum(s::W/(s::b + 0.5 *L)) - 0.5*L
   PI_S_OD = perimeter_inside(S,nthin)
   PI_D_OD = perimeter_inside(D,nthin)
   IF(PI_S_OD == 0) {
    AD = area(D) * W / PI_D_OD
    AS = AD
    PD = perimeter(D) * W /PI_D_OD
    PS = PD } 
   ELSE IF(PI_D_OD == 0) {
    AS = area(S) * W / PI_S_OD
    AD = AS
    PS = perimeter(S) * W /PI_S_OD
    PD = PS } 
   ELSE {
    AS = area(S) * W / PI_S_OD
    AD = area(D) * W / PI_D_OD
    PS = perimeter(S) * W /PI_S_OD
    PD = perimeter(D) * W /PI_D_OD }
 #IFDEF ZERO_NRS_NRD 
   NRS = 0
   NRD = 0
 #ELSE 
   NRS = AS / W / W
   NRD = AD / W / W
 #ENDIF 
]

DEVICE MN(N1HV) n1hvgate poly(G) tndiff(S) tndiff(D) psub(B) <nthin> <OD> netlist model nch_hvt [
