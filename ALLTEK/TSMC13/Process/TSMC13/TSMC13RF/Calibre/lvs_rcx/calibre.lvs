   a  = area(bvargt)/nr
   wr = a/lr
   }else {
   wr = perimeter_inside(bvargt,nthin)/2/nr
   lr = area(bvargt)/wr/nr
   }       
]
TRACE PROPERTY nc2 wr wr 0
TRACE PROPERTY nc2 lr lr 0

