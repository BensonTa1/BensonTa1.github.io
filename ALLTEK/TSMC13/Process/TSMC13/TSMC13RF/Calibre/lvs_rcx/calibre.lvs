  property wr,lr,nr
  nr = count(ngate_rf)
  wr = ((perimeter_coincide(ngate_rf,s_tndiff)+ perimeter_coincide(ngate_rf,d_tndiff))/2)/nr
  lr = (area(ngate_rf)/wr)/nr
]
