DEVICE nc1 vargt poly(PLUS) tndiff(MINUS) <nthin> NETLIST MODEL nmoscap  [
       property lr,wr
   nr = count(vargt)
   sw = count(tndiff)
   if(sw < 2) {
   lr = perimeter_coincide(vargt,nthin)/nr
   a  = area(vargt)/nr
   wr = a/lr
   }else {
   wr = perimeter_inside(vargt,nthin)/2/nr
   lr = area(vargt)/wr/nr
   }       
]
TRACE PROPERTY nc1 wr wr 0
TRACE PROPERTY nc1 lr lr 0

DEVICE nc2 bvargt poly(PLUS) tndiff(MINUS) <nthin> NETLIST MODEL nmoscap_25  [
       property lr,wr
   nr = count(bvargt)
