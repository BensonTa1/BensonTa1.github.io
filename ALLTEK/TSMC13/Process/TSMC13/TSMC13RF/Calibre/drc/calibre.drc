RR:RE:M2EN1 { @ Recommended M2 enclosure of VIA1 >= 0.05 um
    ENC M2EN1_VIA1 M2 < 0.05 ABUT < 90 REGION 
}
#ENDIF // _M2EN1_
#IFDEF _M2EN2_
