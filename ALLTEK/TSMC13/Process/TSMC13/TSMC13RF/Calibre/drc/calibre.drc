VIADEN2_VIADMarker = VIADi AND RRuleRecommended
VIADEN2_VIAD = (VIADEN2_VIADCell OR VIADEN2_VIADMarker) NOT Block


RR:RE:VIADEN2 { @ Recommended VIAD enclosure by M8 [at least two opposite sides] >= 0.08 um
  X = RECTANGLE ENCLOSURE VIADEN2_VIAD M8 ABUT > 0 < 90 GOOD VIAD_EN_1 0.08 OPPOSITE VIAD_EN_1 0.08 OPPOSITE
  Y = ENC [X] M8 < 0.08 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
