#ENDIF
#IFDEF FULL_CHIP
#IFDEF BigSealringCorner
CSR_A1=INT CHIP_WISR < 75 ABUT == 90 REGION INTERSECTING ONLY
CSR_A2=INT CSR_A1 < 2 ABUT == 45 REGION INTERSECTING ONLY
CSR_REGION1 = CSR_A1 NOT CSR_A2
CHIP_B1 = SIZE CHIP_CORE BY -155.5  
CHIP_B2 = EXPAND EDGE CHIP_B1 OUTSIDE BY 155.5+20  
CSR_B1 = CHIP_CORE NOT (CHIP_B1 OR CHIP_B2)
CSR_B2 =EXT (CHIP_B1 OR CHIP_B2) < 70.5 ABUT == 90 REGION INTERSECTING ONLY   
CSR_B3 =INT CHIP_CORE < 70.5 ABUT == 90 REGION INTERSECTING ONLY              
CSR_REGION2 = (CSR_B1 NOT CSR_B2)NOT CSR_B3
CSR.R.2 { @ User must add CSR in 4 chip corners.
  SR_EDGE NOT INTERACT CSRDMY	// Only dummy layer checked
  CSR_REGION1 NOT CSRDMY
  CSR_REGION2 NOT CSRDMY
}
#ELSE
#IFDEF SmallSealringCorner
CSR_A1=INT CHIP_WISR < 75 ABUT == 90 REGION INTERSECTING ONLY
CSR_A2=INT CSR_A1 < 2 ABUT == 45 REGION INTERSECTING ONLY
CSR_REGION1 = CSR_A1 NOT CSR_A2
CSR_B1 = INT CHIP_CORE < 155.5 ABUT == 90 REGION INTERSECTING ONLY  
CSR_B2 = INT CHIP_CORE < 70.5 ABUT == 90 REGION INTERSECTING ONLY
CSR_B3=INT CSR_B1 < 1.5 ABUT == 45 REGION INTERSECTING ONLY
CSR_REGION2 = (CSR_B1 NOT CSR_B2)NOT CSR_B3
CSR.R.2 { @ User must add CSR in 4 chip corners.
  SR_EDGE NOT INTERACT CSRDMY	// Only dummy layer checked
  CSR_REGION1 NOT CSRDMY
  CSR_REGION2 NOT CSRDMY
}
#ELSE   
#IFDEF LmarkSealringCorner
CSR_A1=INT CHIP_WISR < 83 ABUT == 90 REGION INTERSECTING ONLY
CSR_A2=INT CSR_A1 < 1.5 ABUT == 45 REGION INTERSECTING ONLY
CSR_REGION1 = CSR_A1 NOT CSR_A2
CSR.R.2 { @ User must add CSR in 4 chip corners.
  SR_EDGE NOT INTERACT CSRDMY	// Only dummy layer checked
  CSR_REGION1 NOT CSRDMY
}
#ELSE  // not specify seal-ring structure, use BigSealringCorner
CSR_A1=INT CHIP_WISR < 75 ABUT == 90 REGION INTERSECTING ONLY
CSR_A2=INT CSR_A1 < 2 ABUT == 45 REGION INTERSECTING ONLY
CSR_REGION1 = CSR_A1 NOT CSR_A2
CHIP_B1 = SIZE CHIP_CORE BY -155.5  
CHIP_B2 = EXPAND EDGE CHIP_B1 OUTSIDE BY 155.5+20  
CSR_B1 = CHIP_CORE NOT (CHIP_B1 OR CHIP_B2)
CSR_B2 =EXT (CHIP_B1 OR CHIP_B2) < 70.5 ABUT == 90 REGION INTERSECTING ONLY   
CSR_B3 =INT CHIP_CORE < 70.5 ABUT == 90 REGION INTERSECTING ONLY             
CSR_REGION2 = (CSR_B1 NOT CSR_B2)NOT CSR_B3
CSR.R.2 { @ User must add CSR in 4 chip corners.
  SR_EDGE NOT INTERACT CSRDMY	// Only dummy layer checked
  CSR_REGION1 NOT CSRDMY
  CSR_REGION2 NOT CSRDMY
}
#ENDIF
#ENDIF
#ENDIF
#ENDIF  // FULL_CHIP

CSR.R.3A { @ CSR structure must include Mtop~M1/VIAtop~VIA1/CO/PP/OD. 
  CSRDMY NOT INTERACT ODi 
  CSRDMY NOT INTERACT PIMPi 
  CSRDMY NOT INTERACT M1x 
  CSRDMY NOT INTERACT M2x 
  CSRDMY NOT INTERACT M3x 
  CSRDMY NOT INTERACT M4x 
  CSRDMY NOT INTERACT M5x 
  CSRDMY NOT INTERACT M6x 
  CSRDMY NOT INTERACT M7x 
  CSRDMY NOT INTERACT M8x 
  CSRDMY NOT ENCLOSE CONTi 
  CSRDMY NOT ENCLOSE VIA12i 
  CSRDMY NOT ENCLOSE VIA23i 
  CSRDMY NOT ENCLOSE VIA34i 
  CSRDMY NOT ENCLOSE VIA45i 
  CSRDMY NOT ENCLOSE VIA56i 
  CSRDMY NOT ENCLOSE VIA67i 
  CSRDMY NOT ENCLOSE VIA78i 
}
    CSR.R.3B.M1 { @ M1 and CC_M2 must be stacked and coincident the edge in CSR region.
      XOR CC_M1 CC_M2         
    }
    CSR.R.3B.M2 { @ M2 and CC_M3 must be stacked and coincident the edge in CSR region.
      XOR CC_M2 CC_M3         
    }
    CSR.R.3B.M3 { @ M3 and CC_M4 must be stacked and coincident the edge in CSR region.
      XOR CC_M3 CC_M4         
    }
    CSR.R.3B.M4 { @ M4 and CC_M5 must be stacked and coincident the edge in CSR region.
      XOR CC_M4 CC_M5         
    }
    CSR.R.3B.M5 { @ M5 and CC_M6 must be stacked and coincident the edge in CSR region.
      XOR CC_M5 CC_M6         
    }
    
#IFDEF UTM
 #IFDEF LmarkSealringCorner
    CSR.R.3B.M6 { @ M6 and CC_M7 must be stacked and coincident the edge in CSR region.
      A = NOT CC_M6 CC_M7  
      X1 = ANGLE A != 45
      X2 = ANGLE A == 45
      WITH WIDTH A >= 0.2*2
      INT X1 > 0.2 < 0.2*2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X2 > 0.2+GRID < 0.2*2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X1 < 0.2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X2 < 0.2-GRID ABUT < 90 OPPOSITE PARALLEL ONLY REGION
    }
 #ELSE  //LmarkSealringCorner
  #IFDEF HALF_NODE
    CSR.R.3B.M6 { @ M6 and CC_M7 must be stacked and coincident the edge in CSR region.
      A = NOT CC_M6 CC_M7  
      X1 = ANGLE A != 45
      X2 = ANGLE A == 45
      WITH WIDTH A >= 0.2*2
      INT X1 > 0.2 < 0.2*2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X2 > 0.2+GRID < 0.2*2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X1 < 0.2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
      INT X2 < 0.2-GRID ABUT < 90 OPPOSITE PARALLEL ONLY REGION
    }
  #ELSE  //HALF_NODE
    CSR.R.3B.M6 { @ M6 and CC_M7 must be stacked and coincident the edge in CSR region.
      XOR CC_M6 CC_M7  
    }
  #ENDIF  //HALF_NODE
 #ENDIF  //LmarkSealringCorner
#ELSE  //UTM
    CSR.R.3B.M6 { @ M6 and CC_M7 must be stacked and coincident the edge in CSR region.
      XOR CC_M6 CC_M7  
    }
#ENDIF  //UTM



    #IFDEF LmarkSealringCorner
    CSR.R.3C.M1 { @ M1 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M1_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M1_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M2 { @ M2 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M2_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M2_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M3 { @ M3 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M3_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M3_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M4 { @ M4 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M4_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M4_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M5 { @ M5 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M5_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M5_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M6 { @ M6 at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M6_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M6_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    
    CSR.R.3C.M7 { @ M# at same level have a exactive spacing value ^CSR_R_3
      NOT RECTANGLE CC_M7_FENCE_HOLE   == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
      NOT RECTANGLE CC_M7_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    #ELSE  //LmarkSealringCorner
    CSR.R.3C.M1 { @ M1 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M1_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M1_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M1_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M2 { @ M2 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M2_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M2_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M2_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M3 { @ M3 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M3_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M3_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M3_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M4 { @ M4 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M4_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M4_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M4_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M5 { @ M5 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M5_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M5_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M5_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    CSR.R.3C.M6 { @ M6 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M6_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M6_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M6_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    
    CSR.R.3C.M7 { @ M7 at same level have a exactive spacing value ^CSR_R_3
      INT CC_M7_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M7_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M7_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    #ENDIF   //LmarkSealringCorner
#IFDEF LmarkSealringCorner   
    CSR.R.3B.M7 { @ M7 and CC_M8 must be stacked and coincident the edge in CSR region.
      NOT CC_M7 CC_M8  // Top metal in L-mark seal-ring corner is solid
    } 
    CSR.R.3E { @ The CSR pattern must be covered by solid L-mark Metal.
      CC_M7_FENCE_HOLE NOT LMARK_METAL_CSR
    }   
#ELSE  //LmarkSealringCorner
    
    #IFDEF UTM
    CSR.R.3C.M8 { @ M# at same level have a exactive spacing value ^CSR_R_3_UTM
      A = NOT RECTANGLE CC_M8_FENCE_HOLE   == CSR_R_3_UTM BY == CSR_R_3_UTM ORTHOGONAL ONLY
      INT CC_M8_FENCE_HOLE < CSR_R_3_UTM ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M8_FENCE_HOLE BY CSR_R_3_UTM /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M8_FENCE_CROSS  == CSR_R_3_UTM BY == CSR_R_3_UTM ORTHOGONAL ONLY
    }
    #ELSE    //UTM
    CSR.R.3B.M7 { @ M7 and CC_M8 must be stacked and coincident the edge in CSR region.
      XOR CC_M7 CC_M8  
    }
    CSR.R.3C.M8 { @ M# at same level have a exactive spacing value ^CSR_R_3
      INT CC_M8_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
      SIZE CC_M8_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
      NOT RECTANGLE CC_M8_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
      CSR.R.3C.MD { @ M# at same level have a exactive spacing value ^CSR_R_3
        INT CC_MD_FENCE_HOLE < CSR_R_3 ABUT < 90 PARALLEL ONLY REGION
        SIZE CC_MD_FENCE_HOLE BY CSR_R_3 /2 UNDEROVER TRUNCATE CSR_R_3 /2
        NOT RECTANGLE CC_MD_FENCE_CROSS  == CSR_R_3 BY == CSR_R_3 ORTHOGONAL ONLY
    }
    #ENDIF  //UTM
#ENDIF  //LmarkSealringCorner
CSR.OD.WARN { @ Metal must be overlap with OD in CSR region.
      CC_M1 NOT OD         
}
CSR.S.1 { @ CO space >= ^CSR_S_1 um
  CC_CO = CONTi AND CSRDMY
  EXT CC_CO < CSR_S_1 ABUT < 90 SINGULAR REGION 
}

CSR.EN.1 { @ CO enclosure by M1[crossing area] >=^CSR_EN_1 um
   ENC CC_CO CC_M1_FENCE_CROSS  < CSR_EN_1 ABUT < 90 SINGULAR REGION 
}
CSR.R.4.CO { @ CO number at M1 crossing area = ^CSR_R_4_X 
   CC_M1_FENCE_CROSS INTERACT CO < CSR_R_4_X
   CC_M1_FENCE_CROSS INTERACT CO > CSR_R_4_X
   CC_M1_FENCE_CROSS NOT INTERACT CO
}
CSR.EN.6.CO { @ Metal enclosure of CO around L-slot >= ^CSR_EN_6 um
   EXT CC_M1_LSLOT SR_CO < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M1_LSLOT AND SR_CO    
}
CSR.S.2.VIA1 { @ VIA1 space at the same level >=^CSR_S_2 um
  EXT CC_V1 < CSR_S_2 ABUT < 90 SINGULAR REGION
}
CSR.EN.2.VIA1 { @ VIA1 enclosure by metal[crossing area] >=CSR_EN_2
     ENC CC_V1 CC_M1_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V1 CUT CC_M1_FENCE_CROSS
}
CSR.R.4.VIA1 { @ VIA1 number at M1 crossing area = ^CSR_R_4_X
   CC_M1_FENCE_CROSS INTERACT VIA1 < CSR_R_4_X
   CC_M1_FENCE_CROSS INTERACT VIA1 > CSR_R_4_X
   CC_M1_FENCE_CROSS NOT INTERACT VIA1
}
#IFDEF UTM
CSR.EN.6.VIA1 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT CC_M2_LSLOT SR_V1 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M2_LSLOT AND SR_V1
}
#ELSE  //UTM

CSR.EN.6.VIA1 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V1 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M2_LSLOT AND SR_V1
}
#ENDIF  //UTM

CSR.S.2.VIA2 { @ VIA2 space at the same level >=^CSR_S_2 um
  EXT CC_V2 < CSR_S_2 ABUT < 90 SINGULAR REGION
}
CSR.EN.2.VIA2 { @ VIA2 enclosure by metal[crossing area] >=CSR_EN_2
     ENC CC_V2 CC_M2_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V2 CUT CC_M2_FENCE_CROSS
}
CSR.R.4.VIA2 { @ VIA2 number at M2 crossing area = ^CSR_R_4_X
   CC_M2_FENCE_CROSS INTERACT VIA2 < CSR_R_4_X
   CC_M2_FENCE_CROSS INTERACT VIA2 > CSR_R_4_X
   CC_M2_FENCE_CROSS NOT INTERACT VIA2
}
#IFDEF UTM
CSR.EN.6.VIA2 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT CC_M3_LSLOT SR_V2 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M3_LSLOT AND SR_V2
}
#ELSE  //UTM

CSR.EN.6.VIA2 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V2 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M3_LSLOT AND SR_V2
}
#ENDIF  //UTM

CSR.S.2.VIA3 { @ VIA3 space at the same level >=^CSR_S_2 um
  EXT CC_V3 < CSR_S_2 ABUT < 90 SINGULAR REGION
}
CSR.EN.2.VIA3 { @ VIA3 enclosure by metal[crossing area] >=CSR_EN_2
     ENC CC_V3 CC_M3_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V3 CUT CC_M3_FENCE_CROSS
}
CSR.R.4.VIA3 { @ VIA3 number at M3 crossing area = ^CSR_R_4_X
   CC_M3_FENCE_CROSS INTERACT VIA3 < CSR_R_4_X
   CC_M3_FENCE_CROSS INTERACT VIA3 > CSR_R_4_X
   CC_M3_FENCE_CROSS NOT INTERACT VIA3
}
#IFDEF UTM
CSR.EN.6.VIA3 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT CC_M4_LSLOT SR_V3 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M4_LSLOT AND SR_V3
}
#ELSE  //UTM

CSR.EN.6.VIA3 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V3 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M4_LSLOT AND SR_V3
}
#ENDIF  //UTM

CSR.S.2.VIA4 { @ VIA4 space at the same level >=^CSR_S_2 um
  EXT CC_V4 < CSR_S_2 ABUT < 90 SINGULAR REGION
}
CSR.EN.2.VIA4 { @ VIA4 enclosure by metal[crossing area] >=CSR_EN_2
     ENC CC_V4 CC_M4_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V4 CUT CC_M4_FENCE_CROSS
}
CSR.R.4.VIA4 { @ VIA4 number at M4 crossing area = ^CSR_R_4_X
   CC_M4_FENCE_CROSS INTERACT VIA4 < CSR_R_4_X
   CC_M4_FENCE_CROSS INTERACT VIA4 > CSR_R_4_X
   CC_M4_FENCE_CROSS NOT INTERACT VIA4
}
#IFDEF UTM
CSR.EN.6.VIA4 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT CC_M5_LSLOT SR_V4 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M5_LSLOT AND SR_V4
}
#ELSE  //UTM

CSR.EN.6.VIA4 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V4 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M5_LSLOT AND SR_V4
}
#ENDIF  //UTM

CSR.S.2.VIA5 { @ VIA5 space at the same level >=^CSR_S_2 um
  EXT CC_V5 < CSR_S_2 ABUT < 90 SINGULAR REGION
}
CSR.EN.2.VIA5 { @ VIA5 enclosure by metal[crossing area] >=CSR_EN_2
     ENC CC_V5 CC_M5_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V5 CUT CC_M5_FENCE_CROSS
}
CSR.R.4.VIA5 { @ VIA5 number at M5 crossing area = ^CSR_R_4_X
   CC_M5_FENCE_CROSS INTERACT VIA5 < CSR_R_4_X
   CC_M5_FENCE_CROSS INTERACT VIA5 > CSR_R_4_X
   CC_M5_FENCE_CROSS NOT INTERACT VIA5
}
#IFDEF UTM
CSR.EN.6.VIA5 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT CC_M6_LSLOT SR_V5 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M6_LSLOT AND SR_V5
}
#ELSE  //UTM

CSR.EN.6.VIA5 { @ Metal enclosure of VIAx around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V5 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M6_LSLOT AND SR_V5
}
#ENDIF  //UTM

#IFDEF UTM
CSR.S.3.VIA6 { @ VIA6 space at the same level >=^CSR_S_3 um
  EXT CC_V6 < CSR_S_3 ABUT < 90 SINGULAR REGION 
}
CSR.EN.3.VIA6 { @ VIA6 enclosure by metal[crossing area] >=^CSR_EN_3 um
     ENC CC_V6 CC_M6_FENCE_CROSS < CSR_EN_3 ABUT < 90 SINGULAR REGION  
     CC_V6 CUT CC_M6_FENCE_CROSS
}
CSR.R.4.VIA6 { @ VIA6 number at M6 crossing area = ^CSR_R_4_Z
   CC_M6_FENCE_CROSS INTERACT VIA6 < CSR_R_4_Z
   CC_M6_FENCE_CROSS INTERACT VIA6 > CSR_R_4_Z
   CC_M6_FENCE_CROSS NOT INTERACT VIA6
}
CSR.EN.6.VIA6 { @ Metal enclosure of VIA6 around L-slot >= ^CSR_EN_6_1 um
   EXT CC_M7_LSLOT SR_V6 < CSR_EN_6_1 ABUT < 90 OPPOSITE ANGLED == 0 REGION
   EXT CC_M7_LSLOT SR_V6 < CSR_EN_6_1-GRID ABUT < 90 OPPOSITE ANGLED == 2 REGION
   CC_M7_LSLOT AND SR_V6
}
#ELSE  //UTM
CSR.S.2.VIA6 { @ VIA6 space at the same level >=^CSR_S_2 um
  EXT CC_V6 < CSR_S_2 ABUT < 90 SINGULAR REGION 
}
CSR.EN.3.VIA6 { @ VIA6 enclosure by metal[crossing area] >=^CSR_EN_3 um
     ENC CC_V6 CC_M6_FENCE_CROSS < CSR_EN_2 ABUT < 90 SINGULAR REGION  
     CC_V6 CUT CC_M6_FENCE_CROSS
}
CSR.R.4.VIA6 { @ VIA6 number at M6 crossing area = ^CSR_R_4_X
   CC_M6_FENCE_CROSS INTERACT VIA6 < CSR_R_4_X
   CC_M6_FENCE_CROSS INTERACT VIA6 > CSR_R_4_X
   CC_M6_FENCE_CROSS NOT INTERACT VIA6
}
CSR.EN.6.VIA6 { @ Metal enclosure of VIA6 around L-slot >= ^CSR_EN_6 um
   EXT LMARK_SLOT_CSR SR_V6 < CSR_EN_6 ABUT < 90 OPPOSITE REGION
   CC_M7_LSLOT AND SR_V6
}
#ENDIF  //UTM
CSR.S.3.VIA7 { @ VIA7 space at the same level >=^CSR_S_3 um
  EXT CC_V7 < CSR_S_3 ABUT < 90 SINGULAR REGION 
}

#IFNDEF UTM
CSR.R.4.VIA7 { @ VIA6 number at M6 crossing area = ^CSR_R_4_Z
   CC_M7_FENCE_CROSS INTERACT VIA7 < CSR_R_4_Z
   CC_M7_FENCE_CROSS INTERACT VIA7 > CSR_R_4_Z
   CC_M7_FENCE_CROSS NOT INTERACT VIA7
}
CSR.EN.3.VIA7 { @ VIA7 enclosure by metal[crossing area] >=^CSR_EN_3 um
     ENC CC_V7 CC_M7_FENCE_CROSS < CSR_EN_3 ABUT < 90 SINGULAR REGION  
     CC_V7 CUT CC_M7_FENCE_CROSS
}
#ELSE  //UTM
#IFDEF LmarkSealringCorner
CSR.R.4.VIA7 { @ VIA6 number at M6 crossing area = ^CSR_R_4_Z
   CC_M7_FENCE_CROSS INTERACT VIA7 < CSR_R_4_Z
   CC_M7_FENCE_CROSS INTERACT VIA7 > CSR_R_4_Z
   CC_M7_FENCE_CROSS NOT INTERACT VIA7
}
#ENDIF  //LmarkSealringCorner
#IFDEF HALF_NODE
CSR.EN.8.VIA7 { @ VIA7 (Via under UTM) enclosure by metal[crossing area] >=CSR_EN_8
     ENC CC_V7 CC_M7_FENCE_CROSS < CSR_EN_8 ABUT < 90 SINGULAR REGION  
     CC_V7 CUT CC_M7_FENCE_CROSS
}
#ELSE   //HALF_NODE
CSR.EN.3.VIA7 { @ VIA7 enclosure by metal[crossing area] >=^CSR_EN_3 um
     ENC CC_V7 CC_M7_FENCE_CROSS < CSR_EN_3 ABUT < 90 SINGULAR REGION  
     CC_V7 CUT CC_M7_FENCE_CROSS
}
#ENDIF  //HALF_NODE
#ENDIF  //UTM
CSR.EN.6.VIA7 { @ Metal enclosure of VIA7 around L-slot >= ^CSR_EN_6_1 um
   EXT CC_M8_LSLOT SR_V7 < CSR_EN_6_1 ABUT < 90 OPPOSITE ANGLED == 0 REGION
   EXT CC_M8_LSLOT SR_V7 < CSR_EN_6_1-GRID ABUT < 90 OPPOSITE ANGLED == 2 REGION
   CC_M8_LSLOT AND SR_V7
}
#IFNDEF UTM    
CSR.S.3.VIAD { @ VIAD space at the same level >=^CSR_S_3 um
  EXT CC_VD < CSR_S_3 ABUT < 90 SINGULAR REGION
}
#IFDEF LmarkSealringCorner    
CSR.EN.3.VIAD { @ VIAD enclosure by metal[crossing area] >=^CSR_EN_3 um
     ENC CC_VD CC_M8_FENCE_CROSS < CSR_EN_3 ABUT < 90 SINGULAR REGION  
     CC_VD CUT CC_M8_FENCE_CROSS
}

CSR.R.4.VIAD { @ VIAD number at M8 crossing area = ^CSR_R_4_Z
   CC_M8_FENCE_CROSS INTERACT VIAD < CSR_R_4_Z
   CC_M8_FENCE_CROSS INTERACT VIAD > CSR_R_4_Z
   CC_M8_FENCE_CROSS NOT INTERACT VIAD
}

#ENDIF  //LmarkSealringCorner
CSR.EN.6.VIAD { @ Metal enclosure of VIAD around L-slot >= ^CSR_EN_6_1 um
   EXT CC_MD_LSLOT SR_VD < CSR_EN_6_1 ABUT < 90 OPPOSITE ANGLED == 0 REGION
   EXT CC_MD_LSLOT SR_VD < CSR_EN_6_1-GRID ABUT < 90 OPPOSITE ANGLED == 2 REGION
   CC_MD_LSLOT AND SR_VD
}
#ENDIF  //UTM


#IFDEF LmarkSealringCorner

CSR.W.1 {@ Width of L-slot (minimum=maximum)  = ^CSR_W_1 um 
   INT LMARK_SLOT_CSR > CSR_W_1 <100 ABUT < 90 ANGLED == 0 PARALLEL ONLY OPPOSITE REGION
   LMARK_SLOT_CSR WITH WIDTH > 100
   INT LMARK_SLOT_CSR < CSR_W_1 ABUT < 90 ANGLED == 0 PARALLEL ONLY OPPOSITE REGION
}
CSR.L.1 { @ Length of L-slot, >= ^CSR_L_1_1 um <= ^CSR_L_1_2 um
   X = CONVEX EDGE LMARK_SLOT_CSR ANGLE1 == 90 ANGLE2 == 135
   LENGTH X < CSR_L_1_1  
   LENGTH X > CSR_L_1_2 
   Y = CONVEX EDGE LMARK_SLOT_CSR ANGLE1 == 90 ANGLE2 == 225
   LENGTH Y < CSR_L_1_1  
   LENGTH Y > CSR_L_1_2 
}   
#IFDEF WLCSP_SEALRING
CSR.EN.4.1 { @ L-mark metal in CSR enclosure of L-slot [in the direction of L-slot length](for WLCSP sealring region) >= ^CSR_EN_4_1_L1 um <= ^CSR_EN_4_1_L2 um
   X = CONVEX EDGE LMARK_SLOT_CSR ANGLE1 == 90 ANGLE2 == 90
   ENC X LMARK_MS_CSR < CSR_EN_4_1_L1 ABUT < 90 OPPOSITE REGION	  	
   ENC X LMARK_MS_CSR > CSR_EN_4_1_L2 < 100 ABUT < 90 OPPOSITE REGION 	
}

#ELSE    //WLCSP_SEALRING
CSR.EN.4 { @ L-mark metal in CSR enclosure of L-slot [in the direction of L-slot length] >= ^CSR_EN_4_1 um <= ^CSR_EN_4_2 um
   X = CONVEX EDGE LMARK_SLOT_CSR ANGLE1 == 90 ANGLE2 == 90
   ENC X LMARK_MS_CSR < CSR_EN_4_1 ABUT < 90 OPPOSITE REGION
   ENC X LMARK_MS_CSR > CSR_EN_4_2 < 100 ABUT < 90 OPPOSITE REGION
}
#ENDIF  //WLCSP_SEALRING
#IFDEF WLCSP_SEALRING
TM_SR_EXT = (EXTENT (METAL8i OR MDi)) INTERACT CSRDMY
TM_SR_CORNER_A = INT TM_SR_EXT <= CSR_EN_5_1_L1 ABUT == 90 REGION INTERSECTING ONLY
TM_SR_CORNER_B = INT TM_SR_EXT <= CSR_EN_5_1_L2 ABUT == 90 REGION INTERSECTING ONLY
CSR.EN.5.1.M1 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL1i
   TM_SR_CORNER_B NOT INTERACT METAL1i
}
CSR.EN.5.1.M2 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL2i
   TM_SR_CORNER_B NOT INTERACT METAL2i
}
CSR.EN.5.1.M3 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL3i
   TM_SR_CORNER_B NOT INTERACT METAL3i
}
CSR.EN.5.1.M4 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL4i
   TM_SR_CORNER_B NOT INTERACT METAL4i
}
CSR.EN.5.1.M5 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL5i
   TM_SR_CORNER_B NOT INTERACT METAL5i
}
CSR.EN.5.1.M6 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL6i
   TM_SR_CORNER_B NOT INTERACT METAL6i
}
CSR.EN.5.1.M7 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL7i
   TM_SR_CORNER_B NOT INTERACT METAL7i
}
CSR.EN.5.1.M8 { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND METAL8i
   TM_SR_CORNER_B NOT INTERACT METAL8i
}
CSR.EN.5.1.MD { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND MDi
   (TM_SR_CORNER_B AND LMARK_MD) NOT INTERACT MDi
}
CSR.EN.5.1.AP { @ An empty isosceles triangle area must exist butted to the WLCSP sealring outside corner.
   TM_SR_CORNER_A AND APi
}
#ELSE
  CSR.EN.5 { @ L-mark metal in CSR enclosure of L-slot 
             @ [perpendicular to the direction of the L-slot length] >= ^CSR_EN_5_1 um <= ^CSR_EN_5_2 um
     X = CONVEX EDGE LMARK_SLOT_CSR ANGLE1 == 90 ANGLE2 == 225
     ENC X LMARK_MS_CSR < CSR_EN_5_1 ABUT < 90 OPPOSITE REGION
     ENC X LMARK_MS_CSR > CSR_EN_5_2 < 100 ABUT < 90 OPPOSITE REGION
  }
#ENDIF

CSR.W.2 { @ Width of 45 degree corner of L-slot >= 6 
   X = ANGLE LMARK_SLOT_CSR == 45
   Y = EXPAND EDGE X INSIDE BY CSR_W_2_2+GRID    
   Y OUTSIDE LMARK_METAL_CSR
   INT LMARK_SLOT_CSR < CSR_W_2_1 ABUT < 90 ANGLED == 2 REGION
}
// CSR.W.3 s checked by CO.W.2/VIAx.W.2
CSR.EN.7.M1 {@ M1 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL1i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL1i
}
CSR.EN.7.M2 {@ M2 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL2i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL2i
}
CSR.EN.7.M3 {@ M3 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL3i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL3i
}
CSR.EN.7.M4 {@ M4 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL4i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL4i
}
CSR.EN.7.M5 {@ M5 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL5i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL5i
}
CSR.EN.7.M6 {@ M6 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL6i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL6i
}
CSR.EN.7.M7 {@ M7 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um
   EXT LMARK_SLOT_CSR METAL7i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   LMARK_SLOT_CSR AND METAL7i
}
#IFNDEF UTM    
CSR.EN.7.M8 {@ M8 enclosure by L-mark metal in CSR around L-slot >= ^CSR_EN_7 um 
   X = LMARK_SLOT_CSR INTERACT MDi
   EXT X METAL8i < CSR_EN_7 ABUT < 90 OPPOSITE REGION
   X AND METAL8i
}
#ENDIF  //UTM
#ENDIF  //LmarkSealringCorner

//SEAL-RING CHECKS
//================

SR_USER_GUIDE.0 { @ Seal-ring structure must be Mtop~M1/VIAtop~VIA1/CO/PP/OD
  SR_NOT_PMDMY NOT ODi 
  SR_NOT_PMDMY NOT PIMPi
  SR_NOT_PMDMY NOT M1x 
  SR_NOT_PMDMY NOT M2x 
  SR_NOT_PMDMY NOT M3x 
  SR_NOT_PMDMY NOT M4x 
  SR_NOT_PMDMY NOT M5x 
  SR_NOT_PMDMY NOT M6x 
  #IFNDEF UTM
  SR_NOT_PMDMY NOT M7x 
  SR_NOT_PMDMY NOT M8x 
  #ENDIF
  SR_M1 NOT ENCLOSE CONTi 
  SR_M1 NOT ENCLOSE VIA12i 
  SR_M2 NOT ENCLOSE VIA23i 
  SR_M3 NOT ENCLOSE VIA34i 
  SR_M4 NOT ENCLOSE VIA45i 
  SR_M5 NOT ENCLOSE VIA56i 
  SR_M6 NOT ENCLOSE VIA67i 
  SR_M7 NOT ENCLOSE VIA78i 
}

