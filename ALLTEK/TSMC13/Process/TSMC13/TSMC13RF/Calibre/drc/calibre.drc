#IFDEF _M1DN3_
RR:RE:M1DN3 { @ 3 consecutive metal layer(M1,M2,M3) over any 100umx100um window step 50um must >= 15%
    
    X = (ERR_M1_D0 AND ERR_M2_D0) AND ERR_M3_D0 
    AREA ( X NOT METAL_DEN_EXC ) >= 2500	
}
#ENDIF // _M1DN3_




