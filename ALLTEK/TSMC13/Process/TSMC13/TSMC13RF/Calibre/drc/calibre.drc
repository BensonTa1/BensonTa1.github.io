  HOLE_SR_M3 = HOLES SR_M3
  CHECK_SR_M3 = SR_M3 OR HOLE_SR_M3
  CHECK_SR_M3 NOT CHECK_SR_OD
  A1 = ANGLE CHECK_SR_M3 != 45
