CC_M6_G = CC_M6_E COINCIDENT INSIDE EDGE CHECK_CSR_M6
CC_M6_FENCE_CROSS =   CC_M6_E NOT WITH EDGE CC_M6_G

CC_M7  = M7x     AND CSRDMY
CC_V7  = VIA78i    AND CSRDMY
#IFDEF LmarkSealringCorner
CC_M7_HOLE = HOLES (SIZE CC_M7 BY 0.6 UNDEROVER) // filter non-check metal
#ELSE
CC_M7_HOLE = HOLES CC_M7
#ENDIF
CHECK_CSR_M7 = CC_M7 OR CC_M7_HOLE
CC_M7_LSLOT = CC_M7_HOLE INTERACT LSLOT // filter LMARK
CC_M7_FENCE_HOLE  = CC_M7_HOLE NOT INTERACT LSLOT
CC_M7_E = SIZE ((CC_M7 NOT (EXPAND EDGE CC_M7_FENCE_HOLE OUTSIDE BY CSR_R_3)) NOT INTERACT SEALRING ) BY 0.4 UNDEROVER
CC_M7_G = CC_M7_E COINCIDENT INSIDE EDGE CHECK_CSR_M7
CC_M7_FENCE_CROSS =   CC_M7_E NOT WITH EDGE CC_M7_G

CC_M8  = M8x     AND CSRDMY
#IFDEF LmarkSealringCorner
CC_M8_HOLE = HOLES (SIZE CC_M8 BY 0.6 UNDEROVER) // filter non-check metal
#ELSE
CC_M8_HOLE = HOLES CC_M8
#ENDIF
CHECK_CSR_M8 = CC_M8 OR CC_M8_HOLE
CC_M8_LSLOT = CC_M8_HOLE INTERACT LSLOT // filter LMARK
CC_M8_FENCE_HOLE  = CC_M8_HOLE NOT INTERACT LSLOT
#IFDEF UTM
CC_M8_E = SIZE ((CC_M8 NOT (EXPAND EDGE CC_M8_FENCE_HOLE OUTSIDE BY CSR_R_3_UTM)) NOT INTERACT SEALRING ) BY 0.4 UNDEROVER
#ELSE    //UTM
CC_M8_E = SIZE ((CC_M8 NOT (EXPAND EDGE CC_M8_FENCE_HOLE OUTSIDE BY CSR_R_3)) NOT INTERACT SEALRING ) BY 0.4 UNDEROVER
#ENDIF    //UTM
CC_M8_G = CC_M8_E COINCIDENT INSIDE EDGE CHECK_CSR_M8
CC_M8_FENCE_CROSS =   CC_M8_E NOT WITH EDGE CC_M8_G
CC_VD  = VIADi      AND CSRDMY
CC_MD  = MDx        AND CSRDMY
#IFDEF LmarkSealringCorner
CC_MD_HOLE = HOLES (SIZE CC_MD BY 0.6 UNDEROVER) // filter non-check metal
#ELSE
CC_MD_HOLE = HOLES CC_MD
#ENDIF
CHECK_CSR_MD = CC_MD OR CC_MD_HOLE
CC_MD_LSLOT = CC_MD_HOLE INTERACT LSLOT // filter LMARK
CC_MD_FENCE_HOLE  = CC_MD_HOLE NOT INTERACT LSLOT
#IFNDEF UTM
CC_MD_E = SIZE ((CC_MD NOT (EXPAND EDGE CC_MD_FENCE_HOLE OUTSIDE BY CSR_R_3)) NOT INTERACT SEALRING ) BY 0.4 UNDEROVER
CC_MD_G = CC_MD_E COINCIDENT INSIDE EDGE CHECK_CSR_MD
CC_MD_FENCE_CROSS =   CC_MD_E NOT WITH EDGE CC_MD_G
#ENDIF    //UTM

LMARK_METAL_CSR = LMARK_METAL AND CSRDMY // L-mark in CSR
LMARK_SLOT_CSR = LSLOT AND CSRDMY  // L shaped oxide in L-mark metal
LMARK_MS_CSR = LMARK_METAL_CSR OR LMARK_SLOT_CSR




