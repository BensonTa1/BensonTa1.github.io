#IFDEF FULL_CHIP
SR.S.1 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
  (ISOR AND CONTi) NOT INSIDE CDUDMY
  ISOR AND DNWELLi
  ISOR AND NWELLi
  (ISOR AND POLYGi) NOT INSIDE CDUDMY
  ISOR AND DPO
  (ISOR AND ODi) NOT INSIDE CDUDMY
  ISOR AND DOD
  ISOR AND CBMi
  ISOR AND CTMi
  (ISOR AND CONTi) NOT INSIDE CDUDMY
  ISOR AND VIA12i
  ISOR AND VIA23i
  ISOR AND VIA34i
  ISOR AND VIA45i
  ISOR AND VIA56i
  ISOR AND VIA67i
  ISOR AND VIA78i
  ISOR AND VIADi // For CuRDL
  ISOR AND RVi	 // For AlRDL
  ISOR AND UBMi
  ISOR AND CBDi
  ISOR AND PADi
  ISOR AND CB2i
}
SR.S.1.M1 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring 
  A = ISOR NOT (METAL1i INTERACT SEALRING)
  B = (METAL1i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M1_C
  ((METAL1i NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM1 AND ISOR
}
SR.S.1.M2 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL2i INTERACT SEALRING)
  B = (METAL2i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M2_C
  ((M2x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM2 AND ISOR
}

SR.S.1.M3 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL3i INTERACT SEALRING)
  B = (METAL3i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M3_C
  ((M3x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM3 AND ISOR
}

SR.S.1.M4 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL4i INTERACT SEALRING)
  B = (METAL4i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M4_C
  ((M4x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM4 AND ISOR
}

SR.S.1.M5 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL5i INTERACT SEALRING)
  B = (METAL5i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M5_C
  ((M5x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM5 AND ISOR
}

SR.S.1.M6 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL6i INTERACT SEALRING)
  B = (METAL6i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M6_C
  ((M6x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM6 AND ISOR
}

SR.S.1.M7 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
   A = ISOR NOT (METAL7i INTERACT SEALRING)
  B = (METAL7i INTERACT SEALRING) AND ISOR
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M7_C
  ((M7x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR 
  DUM7 AND ISOR
}

#IFDEF UTM
 #IFDEF SmallSealringCorner
  #IFDEF HALF_NODE
   ISOR_THICK = COPY ISOR
  #ELSE  //HALF_NODE
   ISOR_THICK = ISOR NOT CSRDMY
  #ENDIF    //HALF_NODE
 #ELSE  //SmallSealringCorner
   ISOR_THICK = COPY ISOR
 #ENDIF  //SmallSealringCorner
#ELSE  //UTM
   ISOR_THICK = COPY ISOR
#ENDIF  //UTM
SR.S.1.M8 { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring
  A = ISOR NOT (METAL8i INTERACT SEALRING)
  B = (METAL8i INTERACT SEALRING) AND ISOR_THICK
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND M8_C
  ((M8x  NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR_THICK 
  DUM8 AND ISOR_THICK
}
SR.S.1.MD { @ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
            @ 1. Connect circuit to sealring through M1~Mtop if needed for WLCSP sealring 
  A = ISOR NOT (MDx INTERACT SEALRING)
  B = (MDx INTERACT SEALRING) AND ISOR_THICK
  B TOUCH A <2
  C = B TOUCH A > 2
  (CHIPx NOT INTERACT C)AND MD_C
  ((MDx NOT INTERACT SEALRING) NOT INSIDE CDUDMY) AND ISOR_THICK 
  DUMD AND ISOR_THICK
}


#IFDEF WLCSP_SEALRING
SR.S.1.AP {@ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
	   @ 2. Connect circuit to sealring through AP, it is only allowed connecting to the most inner sealring (AP overlap with CB2 is not allowed)  
  (APi NOT INTERACT SEALRING) AND ISOR
  (APi AND SRCSR) AND CB2i
}
SR.AP.WARN { @ AP is must in seal-ring if flip chip or AlCu RDL or AlCu fuse is used 
             @ AP enclosure of CB/CBD in seal-ring >= 1
  SRCSRx = SRCSR INTERACT (CHIP INTERACT APi)  // flip chip or AlCu RDL or AlCu fuse is used
  SRx_CB  = PADi  INSIDE SRCSRx 
  SRx_CBD = CBDi INSIDE SRCSRx 	 
  SRx_RV  = RVi  INSIDE SRCSRx
  SRx_CB  NOT APi
  SRx_CBD NOT APi
  SRx_RV  NOT APi
  A1 = ANGLE SRx_CB != 45
  A2 = ANGLE SRx_CB == 45
  B1 = ANGLE SRx_CBD != 45
  B2 = ANGLE SRx_CBD == 45
  C1 = ANGLE SRx_RV != 45
  C2 = ANGLE SRx_RV == 45
  ENC A1 APi < 1 ABUT < 90  OPPOSITE REGION
  ENC B1 APi < 1 ABUT < 90  OPPOSITE REGION
  ENC C1 APi < 1 ABUT < 90  OPPOSITE REGION
  ENC A2 APi < 1-GRID ABUT < 90  OPPOSITE REGION
  ENC B2 APi < 1-GRID ABUT < 90  OPPOSITE REGION
  ENC C2 APi < 1-GRID ABUT < 90  OPPOSITE REGION  
}

#ELSE

SR.S.1.AP {@ Width of Assembly isolation >= ^SR_S_1 um, Only M1~Mtop and CDU allowed in assembly isolation region
	   @ 2. Connect circuit to sealring through AP is not allowed  
  APi AND ISOR
}

SR.AP.WARN { @ AP is must in seal-ring if flip chip or AlCu RDL or AlCu fuse is used 
             @ AP enclosure of CB/CBD/CB2 in seal-ring >= 1
  SRCSRx = SRCSR INTERACT (CHIP INTERACT APi)  // flip chip or AlCu RDL or AlCu fuse is used
  SRx_CB  = PADi INSIDE SRCSRx 
  SRx_CBD = CBDi INSIDE SRCSRx 
  SRx_CB2 = CB2i INSIDE SRCSRx		 
  SRx_RV  = RVi  INSIDE SRCSRx
  SRx_CB  NOT APi
  SRx_CBD NOT APi
  SRx_CB2 NOT APi
  SRx_RV  NOT APi
  ENC SRx_CB  APi < 1 ABUT < 90 SINGULAR REGION
  ENC SRx_CBD APi < 1 ABUT < 90 SINGULAR REGION
  ENC SRx_CB2 APi < 1 ABUT < 90 SINGULAR REGION
  ENC SRx_RV  APi < 1 ABUT < 90 SINGULAR REGION
}

#ENDIF


#IFNDEF WLCSP_SEALRING
SR.S.1.1 { @ it is not allowed to use AP-MD to connect circuit and seal ring for Flip Chip to avoid the encroachment of AP-MD by UTM tech process
  CHIP_UBM = CHIP INTERACT UBMi
  (ISOR INTERACT CHIP_UBM) AND APi
}
#ENDIF
SR_OD = OD INTERACT SRCSR
HOLE_SR_OD = HOLES SR_OD
CHECK_SR_OD = SR_OD OR HOLE_SR_OD

SR.EN.1.M1 { @ {OD INTERACT SEALRING} enclosure of metal with the outer edge of sealring >= ^SR_EN_1 um
  M1K = (M1 AND SRCSR) AND CHIPx
  SR_M1_C = M1K INSIDE CSRDMY
  HOLE_SR_M1_C = HOLES SR_M1_C
  CHECK_SR_M1_C= SR_M1_C OR HOLE_SR_M1_C
  ENC CHECK_SR_M1_C CHECK_SR_OD < SR_EN_C REGION 
  HOLE_SR_M1 = HOLES SR_M1
  CHECK_SR_M1 = SR_M1 OR HOLE_SR_M1
  CHECK_SR_M1 NOT CHECK_SR_OD
  A1 = ANGLE CHECK_SR_M1 != 45
  A2 = ANGLE CHECK_SR_M1 == 45
  ENC A1 CHECK_SR_OD < SR_EN_1 ABUT < 90 OPPOSITE REGION
  ENC A2 CHECK_SR_OD < SR_EN_1-GRID ABUT < 90 REGION
}

SR.EN.1.M2 { @ {OD INTERACT SEALRING} enclosure of metal with the outer edge of sealring >= ^SR_EN_1 um
  M2K = (M2 AND SRCSR) AND CHIPx
  SR_M2_C = M2K INSIDE CSRDMY
  HOLE_SR_M2_C = HOLES SR_M2_C
  CHECK_SR_M2_C= SR_M2_C OR HOLE_SR_M2_C
  ENC CHECK_SR_M2_C CHECK_SR_OD < SR_EN_C REGION 
  HOLE_SR_M2 = HOLES SR_M2
  CHECK_SR_M2 = SR_M2 OR HOLE_SR_M2
  CHECK_SR_M2 NOT CHECK_SR_OD
  A1 = ANGLE CHECK_SR_M2 != 45
  A2 = ANGLE CHECK_SR_M2 == 45
  ENC A1 CHECK_SR_OD < SR_EN_1 ABUT < 90 OPPOSITE REGION
  ENC A2 CHECK_SR_OD < SR_EN_1-GRID ABUT < 90 REGION
}

SR.EN.1.M3 { @ {OD INTERACT SEALRING} enclosure of metal with the outer edge of sealring >= ^SR_EN_1 um
