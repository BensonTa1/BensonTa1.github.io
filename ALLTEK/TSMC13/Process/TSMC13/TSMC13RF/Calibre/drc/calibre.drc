G.2.DNWELLi { @ DNWELLi shapes with acute angles between line segments are not allowed.
  INT DNWELLi < 0.1 ABUT < 90 INTERSECTING ONLY
  EXT DNWELLi < 0.1 ABUT < 90 INTERSECTING ONLY
}
