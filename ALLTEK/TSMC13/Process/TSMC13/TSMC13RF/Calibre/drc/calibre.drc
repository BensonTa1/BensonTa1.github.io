M4HoleD     = M4HoleSpace AND LM4X

#IFDEF HALF_NODE
M4WideMS = COPY M4Wide7.7
#ELSE
M4WideMS = COPY M4Wide7
#ENDIF
MS.R.1.M4 { @ Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad areas are excluded.   
  M4WideEXD = M4WideMS NOT SLT_EXD
  X = (SIZE M4WideEXD BY MS_R_1_W_s UNDEROVER) AND M4WideEXD
  ENCLOSE RECTANGLE X MS_R_1_W MS_R_1_L
}

CONNECT M4HoleD LM4X

MS.DN.1.M4 { @ Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%  

  NET AREA RATIO LM4X M4HoleD < MS_DN_1
    [ AREA(M4HoleD) / AREA(LM4X) ] RDB M4Hole.density LM4X M4HoleD
}

