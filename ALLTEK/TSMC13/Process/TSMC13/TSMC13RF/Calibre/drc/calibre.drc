#IFDEF UTM
MM.SR_USER_GUIDE.1.M1 { @ Seal-ring exact space between M1 1.9um.
   EXT MM_SR_MW1 MM_SR_MS1 < 1.9 ABUT < 90 PARALLEL ONLY ANGLED == 0 OPPOSITE REGION
   EXT MM_SR_MW1 MM_SR_MS1 < ( 1.9 -0.004) ABUT < 90  PARALLEL ONLY ANGLED == 2 OPPOSITE REGION
   K1 = EXPAND EDGE MM_SR_MW1 OUTSIDE BY 1.9
   B1 = EXPAND EDGE MM_SR_MS1 OUTSIDE BY 1.9 
   C1 = K1 OR B1
   Z1 = C1 NOT SR_M1
   SIZE Z1 BY (1.9 +0.004) /2 UNDEROVER TRUNCATE (1.9 +0.004) /2
}
MM.SR_USER_GUIDE.1.M2 { @ Seal-ring exact space between M2 1.9um.
   EXT MM_SR_MW2 MM_SR_MS2 < 1.9 ABUT < 90 PARALLEL ONLY ANGLED == 0 OPPOSITE REGION
   EXT MM_SR_MW2 MM_SR_MS2 < ( 1.9 -0.004) ABUT < 90  PARALLEL ONLY ANGLED == 2 OPPOSITE REGION
   K2 = EXPAND EDGE MM_SR_MW2 OUTSIDE BY 1.9
   B2 = EXPAND EDGE MM_SR_MS2 OUTSIDE BY 1.9 
   C2 = K2 OR B2
   Z2 = C2 NOT SR_M2
   SIZE Z2 BY (1.9 +0.004) /2 UNDEROVER TRUNCATE (1.9 +0.004) /2
}
MM.SR_USER_GUIDE.1.M3 { @ Seal-ring exact space between M3 1.9um.
   EXT MM_SR_MW3 MM_SR_MS3 < 1.9 ABUT < 90 PARALLEL ONLY ANGLED == 0 OPPOSITE REGION
   EXT MM_SR_MW3 MM_SR_MS3 < ( 1.9 -0.004) ABUT < 90  PARALLEL ONLY ANGLED == 2 OPPOSITE REGION
   K3 = EXPAND EDGE MM_SR_MW3 OUTSIDE BY 1.9
   B3 = EXPAND EDGE MM_SR_MS3 OUTSIDE BY 1.9 
   C3 = K3 OR B3
   Z3 = C3 NOT SR_M3
   SIZE Z3 BY (1.9 +0.004) /2 UNDEROVER TRUNCATE (1.9 +0.004) /2
}
MM.SR_USER_GUIDE.1.M4 { @ Seal-ring exact space between M4 1.9um.
   EXT MM_SR_MW4 MM_SR_MS4 < 1.9 ABUT < 90 PARALLEL ONLY ANGLED == 0 OPPOSITE REGION
   EXT MM_SR_MW4 MM_SR_MS4 < ( 1.9 -0.004) ABUT < 90  PARALLEL ONLY ANGLED == 2 OPPOSITE REGION
   K4 = EXPAND EDGE MM_SR_MW4 OUTSIDE BY 1.9
   B4 = EXPAND EDGE MM_SR_MS4 OUTSIDE BY 1.9 
