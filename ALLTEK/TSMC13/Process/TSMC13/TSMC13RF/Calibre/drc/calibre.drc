#ENDIF  //UTM
#ENDIF // LmarkSealringCorner


VIA4.S.1 { @ Space >= ^VIA4_S_1 um 
  EXT VIA4 < VIA4_S_1 ABUT < 90 SINGULAR REGION
}
VIA4.S.2 { @ Space in VIA4 array [VIA4 number >= 3x3(row and column >= 3) with space <= ^VIA4_S_2_S um ] >= ^VIA4_S_2 um 
  VIA4Merge = SIZE VIA4 BY VIA4_S_2_S / 2 OVERUNDER  // space <= VIA4_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA4_W_1 + ( 3 - 2 ) * VIA4_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA4Merge BY ( ( 3 - 1 ) * VIA4_W_1 + ( 3 - 2 ) * VIA4_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA4Array = MinArray INTERACT VIA4 >= 3 * 3
  VIA4InArray = VIA4 INTERACT VIA4Array
  EXT VIA4InArray < VIA4_S_2 ABUT < 90 REGION
}
VIA4.EN.1 { @ Enclosure by M4 >= ^VIA4_EN_1 um 
  ENC VIA4 M4 < VIA4_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}

VIA4.EN.2 { @ Enclosure by M4 [at least two opposite sides] >= ^VIA4_EN_2 um
  X = RECTANGLE ENCLOSURE VIA4 M4 ABUT < 90 GOOD VIA4_EN_1 VIA4_EN_2 OPPOSITE VIA4_EN_1 VIA4_EN_2 OPPOSITE
  Y = ENC [X] M4 < VIA4_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA4_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

// VIA4.R.1 is checked by VIA4.W.1
#IFNDEF LK
#IFDEF HALF_NODE
M4WideR2_1 = COPY M4Wide1.54
M5WideR2_2 = COPY M5Wide1.54
#ELSE
M4WideR2_1 = COPY M4Wide1.4
M5WideR2_2 = COPY M5Wide1.4
#ENDIF
VIA4.R.2_FSG { @ When M4 or M5 width > ^VIAx_R_2_FSG_W um, more than 1 VIA4 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um
  M5OvpM4W = (M5 AND M4WideR2_1) OR (M4 AND M5WideR2_2)
  M4_has_wm_ovp  = METAL4i  INTERACT M5OvpM4W
  M5_has_wm_ovp = METAL5i INTERACT M5OvpM4W
  MOvp = M4_has_wm_ovp AND M5_has_wm_ovp 
  VIA_EXC = VIA4 NOT VIA_EXD
  M4M5Wide = M4WideR2_1 OR M5WideR2_2
  OvpOnM4M5W = MOvp NOT OUTSIDE M4M5Wide
  VIA_CheckM4 = VIA_EXC INTERACT OvpOnM4M5W
  
  Merge1OnM4M5W = SIZE VIA_CheckM4 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM4M5W STEP (0.21*0.7)
  badRegion1  = Merge1OnM4M5W INTERACT VIA_CheckM4 < 2
  GoodRegion1 = Merge1OnM4M5W OUTSIDE badRegion1
  Merge2OnM4M5W = SIZE Merge1OnM4M5W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM4M5W STEP (0.21*0.7)
  badRegion2  = Merge2OnM4M5W INTERACT VIA_CheckM4 < 4
  GoodRegion2 = Merge2OnM4M5W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM4 INTERACT GoodRegion) NOT OUTSIDE M4M5Wide
  M4M5Check = (M4M5Wide AND OvpOnM4M5W) NOT INTERACT GoodVIA
  VIA_CheckM4 NOT OUTSIDE M4M5Check 
}
#ENDIF  // LK

//M5 CHECKS
//=========
M5_EDGE_45 = M5 ANGLE == 45
M5_EDGE_45L = LENGTH M5_EDGE_45 >= M5_W_2_L
M5.W.1 { @ Width >= ^M5_W_1 um
  INT M5 < M5_W_1 ABUT < 90 SINGULAR REGION
}
M5.W.2 { @ Width of 45 degree bent M5 (with length >= ^M5_W_2_L um) >= ^M5_W_2 um
  INT M5_EDGE_45L < M5_W_2 ABUT < 90 REGION
}
M5.S.1 { @ Space >= ^M5_S_1 um
  EXT M5 < M5_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M5.S.2 { @ Space to wide M5 (both metal line width and length > 11 um) or wide M5 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M5 >= ^M5_S_2 um
  M5_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M5Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M5_G5.5 = GROW (GROW (GROW (GROW M5_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M5_Wide = M5_G5.5 AND M5
  M5_Exp = SIZE M5_Wide BY M5_S_2_B INSIDE OF M5 STEP M5_S_1 * 0.7
  M5_Branch = M5_Exp NOT M5_Wide
  M5_Branch_edge = M5_Branch COIN INSIDE EDGE M5
  M5_Check = M5 AND (SIZE M5_Exp BY M5_S_2)
  M5_Branch_Check = M5 AND (EXPAND EDGE M5_Branch_edge OUTSIDE BY M5_S_2 CORNER FILL)
  M5_WideC = STAMP M5_Wide BY M5x
  M5_CheckC = STAMP M5_Check BY M5x
  M5_BranchC = STAMP M5_Branch BY M5x
  M5_Branch_CheckC = STAMP M5_Branch_Check BY M5x
  EXT M5_WideC M5_CheckC < M5_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M5_BranchC M5_Branch_CheckC < M5_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M5.S.2 { @ Space to wide M5 (both metal line width and length > 10 um) or wide M5 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M5 >= ^M5_S_2 um
  M5_S5 = SHRINK (SHRINK (SHRINK (SHRINK M5Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M5_G5 = GROW (GROW (GROW (GROW M5_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M5_Wide = M5_G5 AND M5
  M5_Exp = SIZE M5_Wide BY M5_S_2_B INSIDE OF M5 STEP M5_S_1 * 0.7
  M5_Branch = M5_Exp NOT M5_Wide
  M5_Branch_edge = M5_Branch COIN INSIDE EDGE M5
  M5_Check = M5 AND (SIZE M5_Exp BY M5_S_2)
  M5_Branch_Check = M5 AND (EXPAND EDGE M5_Branch_edge OUTSIDE BY M5_S_2 CORNER FILL)
  M5_WideC = STAMP M5_Wide BY M5x
  M5_CheckC = STAMP M5_Check BY M5x
  M5_BranchC = STAMP M5_Branch BY M5x
  M5_Branch_CheckC = STAMP M5_Branch_Check BY M5x
  EXT M5_WideC M5_CheckC < M5_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M5_BranchC M5_Branch_CheckC < M5_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M5WideS3 = COPY M5Wide0.43
#ELSE
M5WideS3 = COPY M5Wide0.4
#ENDIF
M5.S.3 { @ Space [for at least one metal line width >= ^M5_S_3_W um and
         @ the parallel metal run length >= ^M5_S_3_L um] >= ^M5_S_3 um
  X = EXT M5WideS3 M5 < M5_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M5_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M5WideS3
  PATH LENGTH WideEdge >= M5_S_3_L
}
M5.S.4 { @ Space to 45 degree bent M5 (with length >= ^M5_W_2_L um) >= ^M5_S_4 um
  X = EXPAND EDGE M5_EDGE_45L OUTSIDE BY M5_S_4
  X AND M5
}
M5.EN.1 { @ Enclosure of VIA4 >= ^M5_EN_1 um
  ENC VIA4 M5 < M5_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M5.EN.2 { @ Enclosure of VIA4 [at least two opposite sides] >= ^M5_EN_2 um
  X = RECTANGLE ENCLOSURE VIA4 M5 ABUT < 90 GOOD M5_EN_1 M5_EN_2 OPPOSITE M5_EN_1 M5_EN_2 OPPOSITE
  Y = ENC [X] M5 < M5_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA4_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M5.A.1 { @ Area >= ^M5_A_1 um2
  AREA M5 < M5_A_1
}

VARIABLE M5_A_2pre ((M5_A_2 + (M5_S_1 * M5_S_1 * 3.142))/(2 * M5_S_1))*((M5_A_2 + (M5_S_1 * M5_S_1 * 3.142))/(2 * M5_S_1))/3.141

M5.A.2 { @ Enclosed area >= ^M5_A_2 um2 
  M5HO = HOLES M5 INNER < M5_A_2pre
  M5HOC = M5HO NOT M5
  (AREA M5HOC < M5_A_2) NOT INSIDE SRAM_EXCLUDE
}

M5.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M5_S_5_W um, and the projection length > ^M5_S_5_W um]
	 @ >= ^M5_S_5 um
  M5OverlapBig = (SIZE M5Overlap BY M5_S_5_W/2 UNDEROVER TRUNCATE M5_S_5_W/2) AND M5Overlap
  W = EXT M5OverlapBig M5Overlap < M5_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M4
  Y = X NOT INSIDE M5
  Y1 = Y NOT INSIDE M6
  ENCLOSE RECTANGLE Y1 GRID (M5_S_5_W + GRID)
}


//VIA5 CHECKS
//===========

VIA5.W.1 { @ Width (square) (maximum == minimum) == ^VIA5_W_1 um
  A = NOT RECTANGLE VIA5 == VIA5_W_1 BY == VIA5_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA5.W.2 { @ Width of VIA5 bar. VIA5 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA5_W_2 um
  INT SR_V5 < VIA5_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V5 BY (VIA5_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA5_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA5.W.2 { @ Width of VIA5 bar. VIA5 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA5_W_2 um
  INT SR_V5 < VIA5_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V5 BY (VIA5_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA5_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}
#ELSE  //HALF_NODE
VIA5.W.2 { @ Width of VIA5 bar. VIA5 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA5_W_2 um
  INT SR_V5 < VIA5_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V5 BY (VIA5_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA5_W_2 / 2 + GRID)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA5.W.2 { @ Width of VIA5 bar. VIA5 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA5_W_2 um
  INT SR_V5 < VIA5_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V5 BY (VIA5_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA5_W_2 / 2 + GRID)
}
#ENDIF  //UTM
#ENDIF // LmarkSealringCorner


VIA5.S.1 { @ Space >= ^VIA5_S_1 um 
  EXT VIA5 < VIA5_S_1 ABUT < 90 SINGULAR REGION
}
VIA5.S.2 { @ Space in VIA5 array [VIA5 number >= 3x3(row and column >= 3) with space <= ^VIA5_S_2_S um ] >= ^VIA5_S_2 um 
  VIA5Merge = SIZE VIA5 BY VIA5_S_2_S / 2 OVERUNDER  // space <= VIA5_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA5_W_1 + ( 3 - 2 ) * VIA5_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA5Merge BY ( ( 3 - 1 ) * VIA5_W_1 + ( 3 - 2 ) * VIA5_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA5Array = MinArray INTERACT VIA5 >= 3 * 3
  VIA5InArray = VIA5 INTERACT VIA5Array
  EXT VIA5InArray < VIA5_S_2 ABUT < 90 REGION
}
VIA5.EN.1 { @ Enclosure by M5 >= ^VIA5_EN_1 um 
  ENC VIA5 M5 < VIA5_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}

VIA5.EN.2 { @ Enclosure by M5 [at least two opposite sides] >= ^VIA5_EN_2 um
  X = RECTANGLE ENCLOSURE VIA5 M5 ABUT < 90 GOOD VIA5_EN_1 VIA5_EN_2 OPPOSITE VIA5_EN_1 VIA5_EN_2 OPPOSITE
  Y = ENC [X] M5 < VIA5_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA5_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

// VIA5.R.1 is checked by VIA5.W.1
#IFNDEF LK
#IFDEF HALF_NODE
M5WideR2_1 = COPY M5Wide1.54
M6WideR2_2 = COPY M6Wide1.54
#ELSE
M5WideR2_1 = COPY M5Wide1.4
M6WideR2_2 = COPY M6Wide1.4
#ENDIF
VIA5.R.2_FSG { @ When M5 or M6 width > ^VIAx_R_2_FSG_W um, more than 1 VIA5 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um
  M6OvpM5W = (M6 AND M5WideR2_1) OR (M5 AND M6WideR2_2)
  M5_has_wm_ovp  = METAL5i  INTERACT M6OvpM5W
  M6_has_wm_ovp = METAL6i INTERACT M6OvpM5W
  MOvp = M5_has_wm_ovp AND M6_has_wm_ovp 
  VIA_EXC = VIA5 NOT VIA_EXD
  M5M6Wide = M5WideR2_1 OR M6WideR2_2
  OvpOnM5M6W = MOvp NOT OUTSIDE M5M6Wide
  VIA_CheckM5 = VIA_EXC INTERACT OvpOnM5M6W
  
  Merge1OnM5M6W = SIZE VIA_CheckM5 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM5M6W STEP (0.21*0.7)
  badRegion1  = Merge1OnM5M6W INTERACT VIA_CheckM5 < 2
  GoodRegion1 = Merge1OnM5M6W OUTSIDE badRegion1
  Merge2OnM5M6W = SIZE Merge1OnM5M6W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM5M6W STEP (0.21*0.7)
  badRegion2  = Merge2OnM5M6W INTERACT VIA_CheckM5 < 4
  GoodRegion2 = Merge2OnM5M6W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM5 INTERACT GoodRegion) NOT OUTSIDE M5M6Wide
  M5M6Check = (M5M6Wide AND OvpOnM5M6W) NOT INTERACT GoodVIA
  VIA_CheckM5 NOT OUTSIDE M5M6Check 
}
#ENDIF  // LK

//M6 CHECKS
//=========
M6_EDGE_45 = M6 ANGLE == 45
M6_EDGE_45L = LENGTH M6_EDGE_45 >= M6_W_2_L
M6.W.1 { @ Width >= ^M6_W_1 um
  INT M6 < M6_W_1 ABUT < 90 SINGULAR REGION
}
M6.W.2 { @ Width of 45 degree bent M6 (with length >= ^M6_W_2_L um) >= ^M6_W_2 um
  INT M6_EDGE_45L < M6_W_2 ABUT < 90 REGION
}
M6.S.1 { @ Space >= ^M6_S_1 um
  EXT M6 < M6_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M6.S.2 { @ Space to wide M6 (both metal line width and length > 11 um) or wide M6 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M6 >= ^M6_S_2 um
  M6_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M6Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M6_G5.5 = GROW (GROW (GROW (GROW M6_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M6_Wide = M6_G5.5 AND M6
  M6_Exp = SIZE M6_Wide BY M6_S_2_B INSIDE OF M6 STEP M6_S_1 * 0.7
  M6_Branch = M6_Exp NOT M6_Wide
  M6_Branch_edge = M6_Branch COIN INSIDE EDGE M6
  M6_Check = M6 AND (SIZE M6_Exp BY M6_S_2)
  M6_Branch_Check = M6 AND (EXPAND EDGE M6_Branch_edge OUTSIDE BY M6_S_2 CORNER FILL)
  M6_WideC = STAMP M6_Wide BY M6x
  M6_CheckC = STAMP M6_Check BY M6x
  M6_BranchC = STAMP M6_Branch BY M6x
  M6_Branch_CheckC = STAMP M6_Branch_Check BY M6x
  EXT M6_WideC M6_CheckC < M6_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M6_BranchC M6_Branch_CheckC < M6_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M6.S.2 { @ Space to wide M6 (both metal line width and length > 10 um) or wide M6 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M6 >= ^M6_S_2 um
  M6_S5 = SHRINK (SHRINK (SHRINK (SHRINK M6Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M6_G5 = GROW (GROW (GROW (GROW M6_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M6_Wide = M6_G5 AND M6
  M6_Exp = SIZE M6_Wide BY M6_S_2_B INSIDE OF M6 STEP M6_S_1 * 0.7
  M6_Branch = M6_Exp NOT M6_Wide
  M6_Branch_edge = M6_Branch COIN INSIDE EDGE M6
  M6_Check = M6 AND (SIZE M6_Exp BY M6_S_2)
  M6_Branch_Check = M6 AND (EXPAND EDGE M6_Branch_edge OUTSIDE BY M6_S_2 CORNER FILL)
  M6_WideC = STAMP M6_Wide BY M6x
  M6_CheckC = STAMP M6_Check BY M6x
  M6_BranchC = STAMP M6_Branch BY M6x
  M6_Branch_CheckC = STAMP M6_Branch_Check BY M6x
  EXT M6_WideC M6_CheckC < M6_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M6_BranchC M6_Branch_CheckC < M6_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M6WideS3 = COPY M6Wide0.43
#ELSE
M6WideS3 = COPY M6Wide0.4
#ENDIF
M6.S.3 { @ Space [for at least one metal line width >= ^M6_S_3_W um and
         @ the parallel metal run length >= ^M6_S_3_L um] >= ^M6_S_3 um
  X = EXT M6WideS3 M6 < M6_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M6_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M6WideS3
  PATH LENGTH WideEdge >= M6_S_3_L
}
M6.S.4 { @ Space to 45 degree bent M6 (with length >= ^M6_W_2_L um) >= ^M6_S_4 um
  X = EXPAND EDGE M6_EDGE_45L OUTSIDE BY M6_S_4
  X AND M6
}
M6.EN.1 { @ Enclosure of VIA5 >= ^M6_EN_1 um
  ENC VIA5 M6 < M6_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M6.EN.2 { @ Enclosure of VIA5 [at least two opposite sides] >= ^M6_EN_2 um
  X = RECTANGLE ENCLOSURE VIA5 M6 ABUT < 90 GOOD M6_EN_1 M6_EN_2 OPPOSITE M6_EN_1 M6_EN_2 OPPOSITE
  Y = ENC [X] M6 < M6_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA5_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M6.A.1 { @ Area >= ^M6_A_1 um2
  AREA M6 < M6_A_1
}

VARIABLE M6_A_2pre ((M6_A_2 + (M6_S_1 * M6_S_1 * 3.142))/(2 * M6_S_1))*((M6_A_2 + (M6_S_1 * M6_S_1 * 3.142))/(2 * M6_S_1))/3.141

M6.A.2 { @ Enclosed area >= ^M6_A_2 um2 
  M6HO = HOLES M6 INNER < M6_A_2pre
  M6HOC = M6HO NOT M6
  (AREA M6HOC < M6_A_2) NOT INSIDE SRAM_EXCLUDE
}

M6.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M6_S_5_W um, and the projection length > ^M6_S_5_W um]
	 @ >= ^M6_S_5 um
  M6OverlapBig = (SIZE M6Overlap BY M6_S_5_W/2 UNDEROVER TRUNCATE M6_S_5_W/2) AND M6Overlap
  W = EXT M6OverlapBig M6Overlap < M6_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M5
  Y = X NOT INSIDE M6
  Y1 = Y NOT INSIDE M7
  ENCLOSE RECTANGLE Y1 GRID (M6_S_5_W + GRID)
}

#IFDEF UTM

//TOP VIA5 CHECKS
//==================
VIA6.W.1 { @ Width (maximum == minimum) == ^VIA6_W_1 um
  A = NOT RECTANGLE VIA6 == VIA6_W_1 BY == VIA6_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD_THICK
}
#IFDEF LmarkSealringCorner
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_V6 BY (VIA6_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIA6.S.1 { @ Space >= ^VIA6_S_1 um 
  EXT ( VIA6 NOT SR_V6 ) < VIA6_S_1 ABUT < 90 SINGULAR REGION
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_V6 BY (VIA6_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIA6.S.1 { @ Space >= ^VIA6_S_1 um 
  EXT ( VIA6 NOT SR_V6 ) < VIA6_S_1 ABUT < 90 SINGULAR REGION
}
#ELSE  //HALF_NODE
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
}

VIA6.S.1 { @ Space >= ^VIA6_S_1 um
  EXT VIA6 < VIA6_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
}

VIA6.S.1 { @ Space >= ^VIA6_S_1 um
  EXT VIA6 < VIA6_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //UTM
#ENDIF //LmarkSealringCorner
VIA6.S.2 { @ Space in VIA6 array [VIA6 number >= 3x3(row and column >= 3) with space <= ^VIA6_S_2_S um ] >= ^VIA6_S_2 um 
  VIA6Merge = SIZE VIA6 BY VIA6_S_2_S / 2 OVERUNDER  // space <= VIA6_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA6_W_1 + ( 3 - 2 ) * VIA6_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA6Merge BY ( ( 3 - 1 ) * VIA6_W_1 + ( 3 - 2 ) * VIA6_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA6Array = MinArray INTERACT VIA6 >= 3 * 3
  VIA6InArray = VIA6 INTERACT VIA6Array
  EXT VIA6InArray < VIA6_S_2 ABUT < 90 REGION
}
#IFDEF UTM
VIA6.EN.1 { @ Enclosure by M6 >= ^VIA6_EN_1 um 
  ENC VIA6 M6 < VIA6_EN_1 ABUT < 90 SINGULAR REGION
  (VIA6 NOT M6)NOT CBM
}
#ELSE  //UTM
VIA6.EN.1 { @ Enclosure by M6 >= ^VIA6_EN_1 um 
  ENC VIA6 M6 < VIA6_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
#ENDIF  //UTM

VIA6.EN.2 { @ Enclosure by M6 (at least two opposite sides) >= ^VIA6_EN_2 um
  X = RECTANGLE ENCLOSURE VIA6 M6 ABUT < 90 GOOD VIA6_EN_1 VIA6_EN_2 OPPOSITE VIA6_EN_1 VIA6_EN_2 OPPOSITE
  Y = ENC [X] M6 < VIA6_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA6_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}
// VIA6.R.1 is checked by VIA6.W.1
#IFDEF HALF_NODE
M6WideR2_1 = COPY M6Wide1.98
M7WideR2_2 = COPY M7Wide1.98
#ELSE  //HALF_NODE
M6WideR2_1 = COPY M6Wide1.8
M7WideR2_2 = COPY M7Wide1.8
#ENDIF  //HALF_NODE

VIA6.R.2 { @ At least 2 VIA6, with space <= ^VIA6_R_2_S um, are required to connect M6 and M7, 
	          @ if either M6 or M7 has both width and length > ^VIA6_R_2_W um
  M7OvpM6W = (M7 AND M6WideR2_1) OR (M6 AND M7WideR2_2)
  M6_has_wm_ovp  = METAL6i  INTERACT M7OvpM6W
  M7_has_wm_ovp = METAL7i INTERACT M7OvpM6W
  MOvp = M6_has_wm_ovp AND M7_has_wm_ovp 
  VIA_EXC = VIA6 NOT VIA_EXD
  M6M7Wide = M6WideR2_1 OR M7WideR2_2
  OvpOnM6M7W = MOvp NOT OUTSIDE M6M7Wide
  VIA_CheckM6 = VIA_EXC INTERACT OvpOnM6M7W
  
  Merge1OnM6M7W = SIZE VIA_CheckM6 BY (VIA6_R_2_S/2) INSIDE OF OvpOnM6M7W STEP (0.42*0.7)
  badRegion1  = Merge1OnM6M7W INTERACT VIA_CheckM6 < 2
  GoodRegion1 = Merge1OnM6M7W OUTSIDE badRegion1
  GoodVIAM6 = (VIA_CheckM6 INTERACT GoodRegion1) NOT OUTSIDE M6M7Wide
  M6M7Check = (M6M7Wide AND OvpOnM6M7W) NOT INTERACT GoodVIAM6
  VIA_CheckM6 NOT OUTSIDE M6M7Check 
}    




//THICK M7 CHECKS
//===================

M7.W.1 { @ width >= ^M7_W_1 um
  INT M7 < M7_W_1 ABUT < 90 SINGULAR REGION
}

M7.S.1 { @ Space >= ^M7_S_1 um
  EXT M7 < M7_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M7.S.2 { @ Space to wide M7 (both metal line width and length > 11 um) or wide M7 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M7 >= ^M7_S_2 um
  M7_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M7Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M7_G5.5 = GROW (GROW (GROW (GROW M7_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M7_Wide = M7_G5.5 AND M7
  M7_Exp = SIZE M7_Wide BY M7_S_2_B INSIDE OF M7 STEP M7_S_1 * 0.7
  M7_Branch = M7_Exp NOT M7_Wide
  M7_Branch_edge = M7_Branch COIN INSIDE EDGE M7
  M7_Check = M7 AND (SIZE M7_Exp BY M7_S_2)
  M7_Branch_Check = M7 AND (EXPAND EDGE M7_Branch_edge OUTSIDE BY M7_S_2 CORNER FILL)
  M7_WideC = STAMP M7_Wide BY M7x
  M7_CheckC = STAMP M7_Check BY M7x
  M7_BranchC = STAMP M7_Branch BY M7x
  M7_Branch_CheckC = STAMP M7_Branch_Check BY M7x
  EXT M7_WideC M7_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M7_BranchC M7_Branch_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M7.S.2 { @ Space to wide M7 (both metal line width and length > 10 um) or wide M7 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M7 >= ^M7_S_2 um
  M7_S5 = SHRINK (SHRINK (SHRINK (SHRINK M7Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M7_G5 = GROW (GROW (GROW (GROW M7_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M7_Wide = M7_G5 AND M7
  M7_Exp = SIZE M7_Wide BY M7_S_2_B INSIDE OF M7 STEP M7_S_1 * 0.7
  M7_Branch = M7_Exp NOT M7_Wide
  M7_Branch_edge = M7_Branch COIN INSIDE EDGE M7
  M7_Check = M7 AND (SIZE M7_Exp BY M7_S_2)
  M7_Branch_Check = M7 AND (EXPAND EDGE M7_Branch_edge OUTSIDE BY M7_S_2 CORNER FILL)
  M7_WideC = STAMP M7_Wide BY M7x
  M7_CheckC = STAMP M7_Check BY M7x
  M7_BranchC = STAMP M7_Branch BY M7x
  M7_Branch_CheckC = STAMP M7_Branch_Check BY M7x
  EXT M7_WideC M7_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M7_BranchC M7_Branch_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

M7.EN.1 { @ Enclosure of 8<VIA6 >= ^M7_EN_1 um
  ENC VIA6 M7 < M7_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M7.EN.2 { @ Enclosure of VIA6 [at least two opposite sides] >= ^M7_EN_2_A um
	        @ Or, Enclosure of VIA6 for all sides >= ^M7_EN_2_B um
  A = RECTANGLE ENCLOSURE VIA6 M7 ABUT < 90 GOOD M7_EN_1 M7_EN_2_A OPPOSITE M7_EN_1 M7_EN_2_A OPPOSITE
  ENC A M7 < M7_EN_2_B ABUT < 90 SINGULAR REGION
}
M7.A.1 { @ Area >= ^M7_A_1 um2
  AREA M7 < M7_A_1
}
VARIABLE M7_A_2pre ((M7_A_2 + (M7_S_1 * M7_S_1 * 3.142))/(2 * M7_S_1))*((M7_A_2 + (M7_S_1 * M7_S_1 * 3.142))/(2 * M7_S_1))/3.141

M7.A.2 { @ Enclosed area >= ^M7_A_2 um2 
  M7HO = HOLES M7 INNER < M7_A_2pre
  M7HOC = M7HO NOT M7
  (AREA M7HOC < M7_A_2) NOT INSIDE SRAM_EXCLUDE
} 

#ELSE //UTM

//VIA6 CHECKS
//===========

VIA6.W.1 { @ Width (square) (maximum == minimum) == ^VIA6_W_1 um
  A = NOT RECTANGLE VIA6 == VIA6_W_1 BY == VIA6_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}
#ELSE  //HALF_NODE
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA6.W.2 { @ Width of VIA6 bar. VIA6 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA6_W_2 um
  INT SR_V6 < VIA6_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V6 BY (VIA6_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA6_W_2 / 2 + GRID)
}
#ENDIF  //UTM
#ENDIF // LmarkSealringCorner


VIA6.S.1 { @ Space >= ^VIA6_S_1 um 
  EXT VIA6 < VIA6_S_1 ABUT < 90 SINGULAR REGION
}
VIA6.S.2 { @ Space in VIA6 array [VIA6 number >= 3x3(row and column >= 3) with space <= ^VIA6_S_2_S um ] >= ^VIA6_S_2 um 
  VIA6Merge = SIZE VIA6 BY VIA6_S_2_S / 2 OVERUNDER  // space <= VIA6_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA6_W_1 + ( 3 - 2 ) * VIA6_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA6Merge BY ( ( 3 - 1 ) * VIA6_W_1 + ( 3 - 2 ) * VIA6_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA6Array = MinArray INTERACT VIA6 >= 3 * 3
  VIA6InArray = VIA6 INTERACT VIA6Array
  EXT VIA6InArray < VIA6_S_2 ABUT < 90 REGION
}
VIA6.EN.1 { @ Enclosure by M6 >= ^VIA6_EN_1 um 
  ENC VIA6 M6 < VIA6_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}

VIA6.EN.2 { @ Enclosure by M6 [at least two opposite sides] >= ^VIA6_EN_2 um
  X = RECTANGLE ENCLOSURE VIA6 M6 ABUT < 90 GOOD VIA6_EN_1 VIA6_EN_2 OPPOSITE VIA6_EN_1 VIA6_EN_2 OPPOSITE
  Y = ENC [X] M6 < VIA6_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA6_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

// VIA6.R.1 is checked by VIA6.W.1
#IFNDEF LK
#IFDEF HALF_NODE
M6WideR2_1 = COPY M6Wide1.54
M7WideR2_2 = COPY M7Wide1.54
#ELSE
M6WideR2_1 = COPY M6Wide1.4
M7WideR2_2 = COPY M7Wide1.4
#ENDIF
VIA6.R.2_FSG { @ When M6 or M7 width > ^VIAx_R_2_FSG_W um, more than 1 VIA6 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um
  M7OvpM6W = (M7 AND M6WideR2_1) OR (M6 AND M7WideR2_2)
  M6_has_wm_ovp  = METAL6i  INTERACT M7OvpM6W
  M7_has_wm_ovp = METAL7i INTERACT M7OvpM6W
  MOvp = M6_has_wm_ovp AND M7_has_wm_ovp 
  VIA_EXC = VIA6 NOT VIA_EXD
  M6M7Wide = M6WideR2_1 OR M7WideR2_2
  OvpOnM6M7W = MOvp NOT OUTSIDE M6M7Wide
  VIA_CheckM6 = VIA_EXC INTERACT OvpOnM6M7W
  
  Merge1OnM6M7W = SIZE VIA_CheckM6 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM6M7W STEP (0.21*0.7)
  badRegion1  = Merge1OnM6M7W INTERACT VIA_CheckM6 < 2
  GoodRegion1 = Merge1OnM6M7W OUTSIDE badRegion1
  Merge2OnM6M7W = SIZE Merge1OnM6M7W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM6M7W STEP (0.21*0.7)
  badRegion2  = Merge2OnM6M7W INTERACT VIA_CheckM6 < 4
  GoodRegion2 = Merge2OnM6M7W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM6 INTERACT GoodRegion) NOT OUTSIDE M6M7Wide
  M6M7Check = (M6M7Wide AND OvpOnM6M7W) NOT INTERACT GoodVIA
  VIA_CheckM6 NOT OUTSIDE M6M7Check 
}
#ENDIF  // LK

//M7 CHECKS
//=========
M7_EDGE_45 = M7 ANGLE == 45
M7_EDGE_45L = LENGTH M7_EDGE_45 >= M7_W_2_L
M7.W.1 { @ Width >= ^M7_W_1 um
  INT M7 < M7_W_1 ABUT < 90 SINGULAR REGION
}
M7.W.2 { @ Width of 45 degree bent M7 (with length >= ^M7_W_2_L um) >= ^M7_W_2 um
  INT M7_EDGE_45L < M7_W_2 ABUT < 90 REGION
}
M7.S.1 { @ Space >= ^M7_S_1 um
  EXT M7 < M7_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M7.S.2 { @ Space to wide M7 (both metal line width and length > 11 um) or wide M7 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M7 >= ^M7_S_2 um
  M7_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M7Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M7_G5.5 = GROW (GROW (GROW (GROW M7_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M7_Wide = M7_G5.5 AND M7
  M7_Exp = SIZE M7_Wide BY M7_S_2_B INSIDE OF M7 STEP M7_S_1 * 0.7
  M7_Branch = M7_Exp NOT M7_Wide
  M7_Branch_edge = M7_Branch COIN INSIDE EDGE M7
  M7_Check = M7 AND (SIZE M7_Exp BY M7_S_2)
  M7_Branch_Check = M7 AND (EXPAND EDGE M7_Branch_edge OUTSIDE BY M7_S_2 CORNER FILL)
  M7_WideC = STAMP M7_Wide BY M7x
  M7_CheckC = STAMP M7_Check BY M7x
  M7_BranchC = STAMP M7_Branch BY M7x
  M7_Branch_CheckC = STAMP M7_Branch_Check BY M7x
  EXT M7_WideC M7_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M7_BranchC M7_Branch_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M7.S.2 { @ Space to wide M7 (both metal line width and length > 10 um) or wide M7 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M7 >= ^M7_S_2 um
  M7_S5 = SHRINK (SHRINK (SHRINK (SHRINK M7Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M7_G5 = GROW (GROW (GROW (GROW M7_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M7_Wide = M7_G5 AND M7
  M7_Exp = SIZE M7_Wide BY M7_S_2_B INSIDE OF M7 STEP M7_S_1 * 0.7
  M7_Branch = M7_Exp NOT M7_Wide
  M7_Branch_edge = M7_Branch COIN INSIDE EDGE M7
  M7_Check = M7 AND (SIZE M7_Exp BY M7_S_2)
  M7_Branch_Check = M7 AND (EXPAND EDGE M7_Branch_edge OUTSIDE BY M7_S_2 CORNER FILL)
  M7_WideC = STAMP M7_Wide BY M7x
  M7_CheckC = STAMP M7_Check BY M7x
  M7_BranchC = STAMP M7_Branch BY M7x
  M7_Branch_CheckC = STAMP M7_Branch_Check BY M7x
  EXT M7_WideC M7_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M7_BranchC M7_Branch_CheckC < M7_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M7WideS3 = COPY M7Wide0.43
#ELSE
M7WideS3 = COPY M7Wide0.4
#ENDIF
M7.S.3 { @ Space [for at least one metal line width >= ^M7_S_3_W um and
         @ the parallel metal run length >= ^M7_S_3_L um] >= ^M7_S_3 um
  X = EXT M7WideS3 M7 < M7_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M7_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M7WideS3
  PATH LENGTH WideEdge >= M7_S_3_L
}
M7.S.4 { @ Space to 45 degree bent M7 (with length >= ^M7_W_2_L um) >= ^M7_S_4 um
  X = EXPAND EDGE M7_EDGE_45L OUTSIDE BY M7_S_4
  X AND M7
}
M7.EN.1 { @ Enclosure of VIA6 >= ^M7_EN_1 um
  ENC VIA6 M7 < M7_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M7.EN.2 { @ Enclosure of VIA6 [at least two opposite sides] >= ^M7_EN_2 um
  X = RECTANGLE ENCLOSURE VIA6 M7 ABUT < 90 GOOD M7_EN_1 M7_EN_2 OPPOSITE M7_EN_1 M7_EN_2 OPPOSITE
  Y = ENC [X] M7 < M7_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA6_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M7.A.1 { @ Area >= ^M7_A_1 um2
  AREA M7 < M7_A_1
}

VARIABLE M7_A_2pre ((M7_A_2 + (M7_S_1 * M7_S_1 * 3.142))/(2 * M7_S_1))*((M7_A_2 + (M7_S_1 * M7_S_1 * 3.142))/(2 * M7_S_1))/3.141

M7.A.2 { @ Enclosed area >= ^M7_A_2 um2 
  M7HO = HOLES M7 INNER < M7_A_2pre
  M7HOC = M7HO NOT M7
  (AREA M7HOC < M7_A_2) NOT INSIDE SRAM_EXCLUDE
}

M7.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M7_S_5_W um, and the projection length > ^M7_S_5_W um]
	 @ >= ^M7_S_5 um
  M7OverlapBig = (SIZE M7Overlap BY M7_S_5_W/2 UNDEROVER TRUNCATE M7_S_5_W/2) AND M7Overlap
  W = EXT M7OverlapBig M7Overlap < M7_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M6
  Y = X NOT INSIDE M7
  Y1 = Y NOT INSIDE M8
  ENCLOSE RECTANGLE Y1 GRID (M7_S_5_W + GRID)
}
#ENDIF //UTM



//TOP VIA6 CHECKS
//==================
VIA7.W.1 { @ Width (maximum == minimum) == ^VIA7_W_1 um
  A = NOT RECTANGLE VIA7 == VIA7_W_1 BY == VIA7_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD_THICK
}
#IFDEF LmarkSealringCorner
VIA7.W.2 { @ Width of VIA7 bar. VIA7 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA7_W_2 um
  INT SR_V7 < VIA7_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_V7 BY (VIA7_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIA7_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIA7.S.1 { @ Space >= ^VIA7_S_1 um 
  EXT ( VIA7 NOT SR_V7 ) < VIA7_S_1 ABUT < 90 SINGULAR REGION
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA7.W.2 { @ Width of VIA7 bar. VIA7 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA7_W_2 um
  INT SR_V7 < VIA7_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_V7 BY (VIA7_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIA7_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIA7.S.1 { @ Space >= ^VIA7_S_1 um 
  EXT ( VIA7 NOT SR_V7 ) < VIA7_S_1 ABUT < 90 SINGULAR REGION
}
#ELSE  //HALF_NODE
VIA7.W.2 { @ Width of VIA7 bar. VIA7 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA7_W_2 um
  INT SR_V7 < VIA7_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_V7 BY (VIA7_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA7_W_2 / 2 + GRID)
}

VIA7.S.1 { @ Space >= ^VIA7_S_1 um
  EXT VIA7 < VIA7_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA7.W.2 { @ Width of VIA7 bar. VIA7 bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIA7_W_2 um
  INT SR_V7 < VIA7_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_V7 BY (VIA7_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA7_W_2 / 2 + GRID)
}

VIA7.S.1 { @ Space >= ^VIA7_S_1 um
  EXT VIA7 < VIA7_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //UTM
#ENDIF //LmarkSealringCorner
VIA7.S.2 { @ Space in VIA7 array [VIA7 number >= 3x3(row and column >= 3) with space <= ^VIA7_S_2_S um ] >= ^VIA7_S_2 um 
  VIA7Merge = SIZE VIA7 BY VIA7_S_2_S / 2 OVERUNDER  // space <= VIA7_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA7_W_1 + ( 3 - 2 ) * VIA7_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA7Merge BY ( ( 3 - 1 ) * VIA7_W_1 + ( 3 - 2 ) * VIA7_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA7Array = MinArray INTERACT VIA7 >= 3 * 3
  VIA7InArray = VIA7 INTERACT VIA7Array
  EXT VIA7InArray < VIA7_S_2 ABUT < 90 REGION
}
#IFNDEF UTM
VIA7.EN.1 { @ Enclosure by M7 >= ^VIA7_EN_1 um 
  ENC VIA7 M7 < VIA7_EN_1 ABUT < 90 SINGULAR REGION
  (VIA7 NOT M7)NOT CBM
}
#ELSE  //UTM
VIA7.EN.1 { @ Enclosure by M7 >= ^VIA7_EN_1 um 
  ENC VIA7 M7 < VIA7_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
#ENDIF  //UTM


VIA7.EN.2 { @ Enclosure by M7 (at least two opposite sides) >= ^VIA7_EN_2 um
  X = RECTANGLE ENCLOSURE VIA7 M7 ABUT < 90 GOOD VIA7_EN_1 VIA7_EN_2 OPPOSITE VIA7_EN_1 VIA7_EN_2 OPPOSITE
  Y = ENC [X] M7 < VIA7_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA7_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}
// VIA7.R.1 is checked by VIA7.W.1
#IFDEF HALF_NODE
#IFDEF UTM
M7WideR2_1 = COPY M7Wide1.8
M8WideR2_2 = COPY M8Wide1.8
#ELSE //UTM
M7WideR2_1 = COPY M7Wide1.98
M8WideR2_2 = COPY M8Wide1.98
#ENDIF  //UTM
#ELSE  //HALF_NODE
M7WideR2_1 = COPY M7Wide1.8
M8WideR2_2 = COPY M8Wide1.8
#ENDIF  //HALF_NODE

VIA7.R.2 { @ At least 2 VIA7, with space <= ^VIA7_R_2_S um, are required to connect M7 and M8, 
	          @ if either M7 or M8 has both width and length > ^VIA7_R_2_W um
  M8OvpM7W = (M8 AND M7WideR2_1) OR (M7 AND M8WideR2_2)
  M7_has_wm_ovp  = METAL7i  INTERACT M8OvpM7W
  M8_has_wm_ovp = METAL8i INTERACT M8OvpM7W
  MOvp = M7_has_wm_ovp AND M8_has_wm_ovp 
  VIA_EXC = VIA7 NOT VIA_EXD
  M7M8Wide = M7WideR2_1 OR M8WideR2_2
  OvpOnM7M8W = MOvp NOT OUTSIDE M7M8Wide
  VIA_CheckM7 = VIA_EXC INTERACT OvpOnM7M8W
  
  Merge1OnM7M8W = SIZE VIA_CheckM7 BY (VIA7_R_2_S/2) INSIDE OF OvpOnM7M8W STEP (0.42*0.7)
  badRegion1  = Merge1OnM7M8W INTERACT VIA_CheckM7 < 2
  GoodRegion1 = Merge1OnM7M8W OUTSIDE badRegion1
  GoodVIAM7 = (VIA_CheckM7 INTERACT GoodRegion1) NOT OUTSIDE M7M8Wide
  M7M8Check = (M7M8Wide AND OvpOnM7M8W) NOT INTERACT GoodVIAM7
  VIA_CheckM7 NOT OUTSIDE M7M8Check 
}    



#IFDEF UTM

//UTM8 CHECKS
//=========

CORE_M8x = M8 NOT INDDMY
CORE_M8 = STAMP CORE_M8x BY M8x
IND_M8 = M8 AND INDDMY
CORE_M8_H = (M8x NOT INDDMY) NOT CB
CORE_M8_L = M8x NOT INDDMY

UTM.W.1 { @ Width >= ^M8_W_1 um 
  INT M8 < M8_W_1 ABUT <90 SINGULAR REGION
}

UTM.S.1 { @ Space >= ^M8_S_1 um 
  EXT M8 < M8_S_1 ABUT <90 SINGULAR REGION
}

UTM.EN.1 { @ Enclosure of VIA7 >= ^M8_EN_1 um 
  ENC VIA7 M8 < M8_EN_1 ABUT <90 OUTSIDE ALSO SINGULAR REGION
}

UTM.EN.2 { @ Enclosure of VIA7 [at least two opposite] >= ^M8_EN_2 um 
  X = RECTANGLE ENCLOSURE VIA7 M8 ABUT > 0 < 90 GOOD M8_EN_1 M8_EN_2 OPPOSITE M8_EN_1 M8_EN_2 OPPOSITE
  Y = ENC [X] M8 < M8_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA7_W_1 ABUT == 90 INTERSECTING ONLY  // adjacent narrow sides
}

UTM.EN.3 { @ M7 enclosure of VIA7 >= ^M8_EN_3 um 
  ENC VIA7 M7 < M8_EN_3 ABUT <90 OUTSIDE ALSO SINGULAR REGION
}

UTM.A.1 { @ Area >= ^M8_A_1 um2
  AREA M8 < M8_A_1
}

UTM.R.1 { @ INDDMY enclosure of M8 inductor regions >= ^M8_R_1 um
  ENC M8 INDDMY < M8_R_1 ABUT < 90 ANGLED == 0 REGION 
  ENC M8 INDDMY < (M8_R_1 - GRID * 2) ABUT < 90 ANGLED == 2 SINGULAR REGION
}

UTM.R.4 { @ Nothing besides an inductor structure are allowed in INDDMY
  A = INDDMY INTERACT NTN
  B = NTN INTERACT INDDMY
  A XOR B
  INDDMY AND NWEL
  INDDMY AND VIA1
  INDDMY AND M2x
  INDDMY AND VIA2
  INDDMY AND M3x
  INDDMY AND VIA3
  INDDMY AND M4x
  INDDMY AND VIA4
  INDDMY AND M5x
  INDDMY AND VIA5
  IND_VIA7  = VIA7  INTERACT IND_M8
  IND_M7    = M7    INTERACT IND_VIA7
  IND_VIA6 = VIA6 INTERACT IND_M7
  CORE_M7   = M7  NOT INTERACT IND_VIA7
  CORE_M6  = M6 NOT INTERACT IND_VIA6
  CORE_M7 AND INDDMY
  CORE_M6 AND INDDMY 
}

// UTM.R.3 can not be checked by drc

UTM.R.5 { @ Max dimension of an INDDMY region >= ^M8_R_5 um
  ENCLOSE RECTANGLE INDDMY GRID (M8_R_5 + GRID) ORTHOGONAL ONLY
}

UTM.S.2 { @ Space to wide M8 (width and length >= ^M8_S_2_L) >= ^M8_S_2 um 
  CORE_M8_S7.5 = SHRINK (SHRINK (SHRINK (SHRINK CORE_M8 RIGHT BY 7.5) LEFT BY 7.5) TOP BY 7.5) BOTTOM BY 7.5
  CORE_M8_G7.5 = GROW (GROW (GROW (GROW CORE_M8_S7.5 RIGHT BY 7.5) LEFT BY 7.5) TOP BY 7.5) BOTTOM BY 7.5
  CORE_M8_Wide = CORE_M8_G7.5 AND CORE_M8
  CORE_M8_Exp = SIZE CORE_M8_Wide BY M8_S_2 INSIDE OF CORE_M8 STEP 1.4
  CORE_M8_Branch = CORE_M8_Exp NOT CORE_M8_Wide
  CORE_M8_Branch_edge = CORE_M8_Branch COIN INSIDE EDGE CORE_M8
  CORE_M8_Check = CORE_M8 AND (SIZE CORE_M8_Exp BY M8_S_2)
  CORE_M8_Branch_Check = CORE_M8 AND (EXPAND EDGE CORE_M8_Branch_edge OUTSIDE BY M8_S_2 CORNER FILL)
  CORE_M8_WideC = STAMP CORE_M8_Wide BY CORE_M8
  CORE_M8_CheckC = STAMP CORE_M8_Check BY CORE_M8
  CORE_M8_BranchC = STAMP CORE_M8_Branch BY CORE_M8
  CORE_M8_Branch_CheckC = STAMP CORE_M8_Branch_Check BY CORE_M8
  EXT CORE_M8_WideC CORE_M8_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT CORE_M8_BranchC CORE_M8_Branch_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}

UTM.W.2 { @ Width for inductor application inside INDDMY (checked by sizing down 15um) >= ^M8_W_2 um 
  A = IND_M8 COIN INSIDE EDGE INDDMY
  B = EXPAND EDGE A INSIDE BY GRID
  C = IND_M8 TOUCH INSIDE EDGE B 
  D = INT C < 50.005 OPPOSITE REGION  
  E = IND_M8 NOT D
  SIZE E BY (M8_W_2 / 2 + GRID) UNDEROVER
}

PAD_EXD8T = SIZE PAD_EXD BY 5 INSIDE OF M8x STEP 0.32
SLT_EXD8T =  ( SLT_EXD OR PAD_EXD8T ) OR INDDMY 		// For top metal only
UTM8EXD = M8x NOT SLT_EXD8T
M8HOC_T  = HOLES UTM8EXD INNER // Metal slot (include not in wide metal)
M8HOD_T  = SIZE M8HOC_T BY 10 UNDEROVER
M8HO_T   = M8HOC_T OUTSIDE M8HOD_T
FIM8X_T  = UTM8EXD OR M8HO_T
FIM8Y_T  = (SIZE (SIZE FIM8X_T BY 1.0 UNDEROVER) BY M8_DN_2_W/2-0.001 UNDEROVER) AND FIM8X_T  // filter out small metal
LM8X_T   = ENCLOSE RECTANGLE FIM8Y_T M8_DN_2_W M8_DN_2_L
M8SLT_T  = M8HO_T INSIDE LM8X_T
FIM8_T   = UTM8EXD OR M8SLT_T

UTM.R.6 { @ Wide M8 with width >= ^M8_R_6_W and length >= ^M8_R_6_L must have slot
   	  @ metal slots in INDDMY are not allowed.
   UTM8WideEXD = M8Wide7 NOT SLT_EXD8T
   X = (SIZE UTM8WideEXD BY 11.999 UNDEROVER) AND UTM8WideEXD
   ENCLOSE RECTANGLE X M8_R_6_W M8_R_6_L
   HOLES IND_M8
}

// UTM.R.7 is recommendation.
#IFDEF HALF_NODE
UTM.A.2 { @ Enclosed area >= ^M8_A_2 um2
   UTMHO = HOLES M8 INNER
   UTMHOC = (UTMHO NOT M8)NOT CSRDMY
   AREA UTMHOC < M8_A_2
}   
#ELSE  //HALF_NODE
UTM.A.2 { @ Enclosed area >= ^M8_A_2 um2
   UTMHO = HOLES M8 INNER
   UTMHOC = UTMHO NOT M8
   AREA UTMHOC < M8_A_2
}   
#ENDIF  //HALF_NODE

//UTM.R.8 is checked by VIA7.R.2 because of UTM.W.1
//UTM.DN.1 is checked by M8.DN.1
UTM.DN.3 { @ M8 metal density in whole chip >= 20% and <= 70% 
  DENSITY ALL_M8 > M8_DN_3_H PRINT UTM.DN.3.high.density
  DENSITY ALL_M8 < M8_DN_3_L PRINT UTM.DN.3.low.density
}

//UTM.R.9 can not be checked by drc


#ELSE //UTM

//THICK M8 CHECKS
//===================

M8.W.1 { @ width >= ^M8_W_1 um
  INT M8 < M8_W_1 ABUT < 90 SINGULAR REGION
}

M8.S.1 { @ Space >= ^M8_S_1 um
  EXT M8 < M8_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M8.S.2 { @ Space to wide M8 (both metal line width and length > 11 um) or wide M8 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M8 >= ^M8_S_2 um
  M8_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M8Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M8_G5.5 = GROW (GROW (GROW (GROW M8_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M8_Wide = M8_G5.5 AND M8
  M8_Exp = SIZE M8_Wide BY M8_S_2_B INSIDE OF M8 STEP M8_S_1 * 0.7
  M8_Branch = M8_Exp NOT M8_Wide
  M8_Branch_edge = M8_Branch COIN INSIDE EDGE M8
  M8_Check = M8 AND (SIZE M8_Exp BY M8_S_2)
  M8_Branch_Check = M8 AND (EXPAND EDGE M8_Branch_edge OUTSIDE BY M8_S_2 CORNER FILL)
  M8_WideC = STAMP M8_Wide BY M8x
  M8_CheckC = STAMP M8_Check BY M8x
  M8_BranchC = STAMP M8_Branch BY M8x
  M8_Branch_CheckC = STAMP M8_Branch_Check BY M8x
  EXT M8_WideC M8_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M8_BranchC M8_Branch_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M8.S.2 { @ Space to wide M8 (both metal line width and length > 10 um) or wide M8 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M8 >= ^M8_S_2 um
  M8_S5 = SHRINK (SHRINK (SHRINK (SHRINK M8Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M8_G5 = GROW (GROW (GROW (GROW M8_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M8_Wide = M8_G5 AND M8
  M8_Exp = SIZE M8_Wide BY M8_S_2_B INSIDE OF M8 STEP M8_S_1 * 0.7
  M8_Branch = M8_Exp NOT M8_Wide
  M8_Branch_edge = M8_Branch COIN INSIDE EDGE M8
  M8_Check = M8 AND (SIZE M8_Exp BY M8_S_2)
  M8_Branch_Check = M8 AND (EXPAND EDGE M8_Branch_edge OUTSIDE BY M8_S_2 CORNER FILL)
  M8_WideC = STAMP M8_Wide BY M8x
  M8_CheckC = STAMP M8_Check BY M8x
  M8_BranchC = STAMP M8_Branch BY M8x
  M8_Branch_CheckC = STAMP M8_Branch_Check BY M8x
  EXT M8_WideC M8_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M8_BranchC M8_Branch_CheckC < M8_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

M8.EN.1 { @ Enclosure of 8<VIA7 >= ^M8_EN_1 um
  ENC VIA7 M8 < M8_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M8.EN.2 { @ Enclosure of VIA7 [at least two opposite sides] >= ^M8_EN_2_A um
	        @ Or, Enclosure of VIA7 for all sides >= ^M8_EN_2_B um
  A = RECTANGLE ENCLOSURE VIA7 M8 ABUT < 90 GOOD M8_EN_1 M8_EN_2_A OPPOSITE M8_EN_1 M8_EN_2_A OPPOSITE
  ENC A M8 < M8_EN_2_B ABUT < 90 SINGULAR REGION
}
M8.A.1 { @ Area >= ^M8_A_1 um2
  AREA M8 < M8_A_1
}
VARIABLE M8_A_2pre ((M8_A_2 + (M8_S_1 * M8_S_1 * 3.142))/(2 * M8_S_1))*((M8_A_2 + (M8_S_1 * M8_S_1 * 3.142))/(2 * M8_S_1))/3.141

M8.A.2 { @ Enclosed area >= ^M8_A_2 um2 
  M8HO = HOLES M8 INNER < M8_A_2pre
  M8HOC = M8HO NOT M8
  (AREA M8HOC < M8_A_2) NOT INSIDE SRAM_EXCLUDE
} 

#ENDIF //UTM


#IFNDEF UTM

//TOP VIA7 CHECKS
//==================
VIAD.W.1 { @ Width (maximum == minimum) == ^VIAD_W_1 um
  A = NOT RECTANGLE VIAD == VIAD_W_1 BY == VIAD_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD_THICK
}
#IFDEF LmarkSealringCorner
VIAD.W.2 { @ Width of VIAD bar. VIAD bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIAD_W_2 um
  INT SR_VD < VIAD_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_VD BY (VIAD_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIAD_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIAD.S.1 { @ Space >= ^VIAD_S_1 um 
  EXT ( VIAD NOT SR_VD ) < VIAD_S_1 ABUT < 90 SINGULAR REGION
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIAD.W.2 { @ Width of VIAD bar. VIAD bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIAD_W_2 um
  INT SR_VD < VIAD_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  A = SIZE SR_VD BY (VIAD_W_2 /2 + GRID) UNDEROVER TRUNCATE (VIAD_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 2 GRID
}

VIAD.S.1 { @ Space >= ^VIAD_S_1 um 
  EXT ( VIAD NOT SR_VD ) < VIAD_S_1 ABUT < 90 SINGULAR REGION
}
#ELSE  //HALF_NODE
VIAD.W.2 { @ Width of VIAD bar. VIAD bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIAD_W_2 um
  INT SR_VD < VIAD_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_VD BY (VIAD_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIAD_W_2 / 2 + GRID)
}

VIAD.S.1 { @ Space >= ^VIAD_S_1 um
  EXT VIAD < VIAD_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIAD.W.2 { @ Width of VIAD bar. VIAD bar is only allowed in seal ring and fuse protection ring. 
                  @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	          @ is a must if VIAx bar is used >= ^VIAD_W_2 um
  INT SR_VD < VIAD_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION 
  SIZE SR_VD BY (VIAD_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIAD_W_2 / 2 + GRID)
}

VIAD.S.1 { @ Space >= ^VIAD_S_1 um
  EXT VIAD < VIAD_S_1 ABUT < 90 SINGULAR REGION
}
#ENDIF  //UTM
#ENDIF //LmarkSealringCorner
VIAD.S.2 { @ Space in VIAD array [VIAD number >= 3x3(row and column >= 3) with space <= ^VIAD_S_2_S um ] >= ^VIAD_S_2 um 
  VIADMerge = SIZE VIAD BY VIAD_S_2_S / 2 OVERUNDER  // space <= VIAD_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIAD_W_1 + ( 3 - 2 ) * VIAD_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIADMerge BY ( ( 3 - 1 ) * VIAD_W_1 + ( 3 - 2 ) * VIAD_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIADArray = MinArray INTERACT VIAD >= 3 * 3
  VIADInArray = VIAD INTERACT VIADArray
  EXT VIADInArray < VIAD_S_2 ABUT < 90 REGION
}
VIAD.EN.1 { @ Enclosure by M8 >= ^VIAD_EN_1 um 
  ENC VIAD M8 < VIAD_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}


VIAD.EN.2 { @ Enclosure by M8 (at least two opposite sides) >= ^VIAD_EN_2 um
  X = RECTANGLE ENCLOSURE VIAD M8 ABUT < 90 GOOD VIAD_EN_1 VIAD_EN_2 OPPOSITE VIAD_EN_1 VIAD_EN_2 OPPOSITE
  Y = ENC [X] M8 < VIAD_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIAD_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}
// VIAD.R.1 is checked by VIAD.W.1
#IFDEF HALF_NODE
#IFDEF UTM
M8WideR2_1 = COPY M8Wide1.8
MDWideR2_2 = COPY MDWide1.8
#ELSE //UTM
M8WideR2_1 = COPY M8Wide1.98
MDWideR2_2 = COPY MDWide1.98
#ENDIF  //UTM
#ELSE  //HALF_NODE
M8WideR2_1 = COPY M8Wide1.8
MDWideR2_2 = COPY MDWide1.8
#ENDIF  //HALF_NODE

VIAD.R.2 { @ At least 2 VIAD, with space <= ^VIAD_R_2_S um, are required to connect M8 and MD, 
	          @ if either M8 or MD has both width and length > ^VIAD_R_2_W um
  MDOvpM8W = (MD AND M8WideR2_1) OR (M8 AND MDWideR2_2)
  M8_has_wm_ovp  = METAL8i  INTERACT MDOvpM8W
  MD_has_wm_ovp = MDi INTERACT MDOvpM8W
  MOvp = M8_has_wm_ovp AND MD_has_wm_ovp 
  VIA_EXC = VIAD NOT VIA_EXD
  M8MDWide = M8WideR2_1 OR MDWideR2_2
  OvpOnM8MDW = MOvp NOT OUTSIDE M8MDWide
  VIA_CheckM8 = VIA_EXC INTERACT OvpOnM8MDW
  
  Merge1OnM8MDW = SIZE VIA_CheckM8 BY (VIAD_R_2_S/2) INSIDE OF OvpOnM8MDW STEP (0.42*0.7)
  badRegion1  = Merge1OnM8MDW INTERACT VIA_CheckM8 < 2
  GoodRegion1 = Merge1OnM8MDW OUTSIDE badRegion1
  GoodVIAM8 = (VIA_CheckM8 INTERACT GoodRegion1) NOT OUTSIDE M8MDWide
  M8MDCheck = (M8MDWide AND OvpOnM8MDW) NOT INTERACT GoodVIAM8
  VIA_CheckM8 NOT OUTSIDE M8MDCheck 
}    




//THICK MD CHECKS
//===================

MD.W.1 { @ width >= ^MD_W_1 um
  INT MD < MD_W_1 ABUT < 90 SINGULAR REGION
}

MD.S.1 { @ Space >= ^MD_S_1 um
  EXT MD < MD_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
MD.S.2 { @ Space to wide MD (both metal line width and length > 11 um) or wide MD branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide MD >= ^MD_S_2 um
  MD_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK MDWide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  MD_G5.5 = GROW (GROW (GROW (GROW MD_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  MD_Wide = MD_G5.5 AND MD
  MD_Exp = SIZE MD_Wide BY MD_S_2_B INSIDE OF MD STEP MD_S_1 * 0.7
  MD_Branch = MD_Exp NOT MD_Wide
  MD_Branch_edge = MD_Branch COIN INSIDE EDGE MD
  MD_Check = MD AND (SIZE MD_Exp BY MD_S_2)
  MD_Branch_Check = MD AND (EXPAND EDGE MD_Branch_edge OUTSIDE BY MD_S_2 CORNER FILL)
  MD_WideC = STAMP MD_Wide BY MDx
  MD_CheckC = STAMP MD_Check BY MDx
  MD_BranchC = STAMP MD_Branch BY MDx
  MD_Branch_CheckC = STAMP MD_Branch_Check BY MDx
  EXT MD_WideC MD_CheckC < MD_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT MD_BranchC MD_Branch_CheckC < MD_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
MD.S.2 { @ Space to wide MD (both metal line width and length > 10 um) or wide MD branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide MD >= ^MD_S_2 um
  MD_S5 = SHRINK (SHRINK (SHRINK (SHRINK MDWide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  MD_G5 = GROW (GROW (GROW (GROW MD_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  MD_Wide = MD_G5 AND MD
  MD_Exp = SIZE MD_Wide BY MD_S_2_B INSIDE OF MD STEP MD_S_1 * 0.7
  MD_Branch = MD_Exp NOT MD_Wide
  MD_Branch_edge = MD_Branch COIN INSIDE EDGE MD
  MD_Check = MD AND (SIZE MD_Exp BY MD_S_2)
  MD_Branch_Check = MD AND (EXPAND EDGE MD_Branch_edge OUTSIDE BY MD_S_2 CORNER FILL)
  MD_WideC = STAMP MD_Wide BY MDx
  MD_CheckC = STAMP MD_Check BY MDx
  MD_BranchC = STAMP MD_Branch BY MDx
  MD_Branch_CheckC = STAMP MD_Branch_Check BY MDx
  EXT MD_WideC MD_CheckC < MD_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT MD_BranchC MD_Branch_CheckC < MD_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

MD.EN.1 { @ Enclosure of 8<VIA8 >= ^MD_EN_1 um
  ENC VIAD MD < MD_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
MD.EN.2 { @ Enclosure of VIAD [at least two opposite sides] >= ^MD_EN_2_A um
	        @ Or, Enclosure of VIAD for all sides >= ^MD_EN_2_B um
  A = RECTANGLE ENCLOSURE VIAD MD ABUT < 90 GOOD MD_EN_1 MD_EN_2_A OPPOSITE MD_EN_1 MD_EN_2_A OPPOSITE
  ENC A MD < MD_EN_2_B ABUT < 90 SINGULAR REGION
}
MD.A.1 { @ Area >= ^MD_A_1 um2
  AREA MD < MD_A_1
}
VARIABLE MD_A_2pre ((MD_A_2 + (MD_S_1 * MD_S_1 * 3.142))/(2 * MD_S_1))*((MD_A_2 + (MD_S_1 * MD_S_1 * 3.142))/(2 * MD_S_1))/3.141

MD.A.2 { @ Enclosed area >= ^MD_A_2 um2 
  MDHO = HOLES MD INNER < MD_A_2pre
  MDHOC = MDHO NOT MD
  (AREA MDHOC < MD_A_2) NOT INSIDE SRAM_EXCLUDE
} 

#ENDIF



#IFDEF LK
M1Wide0.85 = (SIZE M1 BY 0.85/2 UNDEROVER TRUNCATE 0.85/2) AND M1
M1Trunk2_2 = (SIZE M1Wide0.85 BY 2/2 UNDEROVER TRUNCATE 2/2) AND M1
M1Tree2_2 = M1 INTERACT M1Trunk2_2
M1Wide2.5 = (SIZE M1Trunk2_2 BY 2.5/2 UNDEROVER TRUNCATE 2.5/2) AND M1
M1Trunk2.5_20 = ENCLOSE RECTANGLE M1Wide2.5 2.5 20.005
M1Tree2.5_20 = M1 INTERACT M1Trunk2.5_20


// VIA1 CHECKS
//=============

M2Wide0.85 = (SIZE M2 BY 0.85/2 UNDEROVER TRUNCATE 0.85/2) AND M2
M2Trunk2_2 = (SIZE M2Wide0.85 BY 2/2 UNDEROVER TRUNCATE 2/2) AND M2
M2Tree2_2 = M2 INTERACT M2Trunk2_2
M2Wide2.5 = (SIZE M2Trunk2_2 BY 2.5/2 UNDEROVER TRUNCATE 2.5/2) AND M2
M2Trunk2.5_20 = ENCLOSE RECTANGLE M2Wide2.5 2.5 20.005
M2Tree2.5_20 = M2 INTERACT M2Trunk2.5_20

VIA1.R.2_LK { @ When M1 or M2 width > 0.85um, more than 1 VIA1 is required.
           @ if the metal has < 4 vias, vias spacing should be <= 0.71um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= 1um
  M2OvpM1W = (M2 AND M1Wide0.85) OR (M1 AND M2Wide0.85)
  m1_has_wm_ovp = METAL1i INTERACT M2OvpM1W
  m2_has_wm_ovp = METAL2i INTERACT M2OvpM1W
  MOvp = m1_has_wm_ovp AND m2_has_wm_ovp 
  VIA_EXC = VIA1 NOT VIA_EXD
  M12Wide = M1Wide0.85 OR M2Wide0.85
  OvpOnM12W = MOvp NOT OUTSIDE M12Wide
  VIA_Check1 = VIA_EXC INTERACT OvpOnM12W 
  
  Merge1OnM12W = SIZE VIA_Check1 BY 0.71/2 INSIDE OF OvpOnM12W STEP 0.21*0.7
  badRegion1  = Merge1OnM12W INTERACT VIA_Check1 < 2
  GoodRegion1 = Merge1OnM12W OUTSIDE badRegion1
  Merge2OnM12W = SIZE Merge1OnM12W BY (1 - 0.71)/2 INSIDE OF OvpOnM12W STEP 0.21*0.7
  badRegion2  = Merge2OnM12W INTERACT VIA_Check1 < 4
  GoodRegion2 = Merge2OnM12W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_Check1 INTERACT GoodRegion) NOT OUTSIDE M12Wide
  M12Check = (M12Wide AND OvpOnM12W) NOT INTERACT GoodVIA
  VIA_Check1 NOT OUTSIDE M12Check 
}    

VIA1.R.2.1_LK.M1 { @ More than one VIA1 are required on the M1 (D1 < 5um) 
		@connected to wide metal(W1 > 2.5um, L1 > 20um)
  M_Branch = (M1Tree2.5_20 NOT M1Trunk2.5_20) INTERACT VIA1
  Check_Edge = M_Branch COIN OUTSIDE EDGE M1Trunk2.5_20
  X = EXPAND EDGE Check_Edge OUTSIDE BY 0.005
  Check_Branch = (SIZE X BY 4.995 INSIDE OF M_Branch STEP 0.1) AND M2
  Bad_Branch = Check_Branch INTERACT VIA1 == 1
  M_Ovlp = ((M1Tree2.5_20 AND M2) INTERACT Bad_Branch) INTERACT VIA1 == 1
  (VIA1 INTERACT M_Ovlp) NOT VIA_EXD
}  
VIA1.R.2.1_LK.M2 { @ More than one VIA1 are required on the M2 (D1 < 5um) 
		@connected to wide metal(W1 > 2.5um, L1 > 20um)
  M_Branch = (M2Tree2.5_20 NOT M2Trunk2.5_20) INTERACT VIA1
  Check_Edge = M_Branch COIN OUTSIDE EDGE M2Trunk2.5_20
  X = EXPAND EDGE Check_Edge OUTSIDE BY 0.005
  Check_Branch = (SIZE X BY 4.995 INSIDE OF M_Branch STEP 0.1) AND M1
  Bad_Branch = Check_Branch INTERACT VIA1 == 1
  M_Ovlp = ((M2Tree2.5_20 AND M1) INTERACT Bad_Branch) INTERACT VIA1 == 1
  (VIA1 INTERACT M_Ovlp) NOT VIA_EXD
}  

VIA1.R.2.2_LK.M1 { @ More than one VIA1 are required on the M1 (D2 < 1um) 
		@connected to wide metal(W2 > 2um, L2 > 2um)
  M_Branch = (M1Tree2_2 NOT M1Trunk2_2) INTERACT VIA1
  Check_Edge = M_Branch COIN OUTSIDE EDGE M1Trunk2_2
  X = EXPAND EDGE Check_Edge OUTSIDE BY 0.005
