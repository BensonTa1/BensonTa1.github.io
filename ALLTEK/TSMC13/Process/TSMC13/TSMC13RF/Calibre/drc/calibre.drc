    D9 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC > M6_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
            [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
    ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
    F2 = AREA ( ERR2 NOT M6_DEN_EXC ) >= 10000
    F = F1 OR F2
    DENSITY F M6_NOT_EXC CHIP_NOT_M6_EXC > M6_DN_1H WINDOW 200 STEP 100 BACKUP PRINT M6_DN_1H.density 
          [ !!AREA(F) * (AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC)) ]
}
#ENDIF


