  M6WideEXD = M6WideMS NOT SLT_EXD
  X = (SIZE M6WideEXD BY MS_R_1_W_s UNDEROVER) AND M6WideEXD
  ENCLOSE RECTANGLE X MS_R_1_W MS_R_1_L
