M2EN2_VIA1 = (M2EN2_VIA1Cell OR M2EN2_VIA1Marker) NOT Block


RR:RE:M2EN2 { @ Recommended enclosure of VIA1 at least two opposite sides >= 0.08 um, to avoid high Rc
  X = RECTANGLE ENCLOSURE M2EN2_VIA1 M2 ABUT < 90 GOOD 0.005 0.08 OPPOSITE 0.005 0.08 OPPOSITE
  Y = ENC [X] M2 < 0.08 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA1_W_1 ABUT == 90 INTERSECTING ONLY  // adjacent narrow sides}
}
#ENDIF //_M2EN2_

#IFDEF _M3S5_ 
