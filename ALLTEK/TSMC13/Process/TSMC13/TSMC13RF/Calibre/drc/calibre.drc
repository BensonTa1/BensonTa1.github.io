   EXT SR_MWD SR_MSD < 2.3 ABUT < 90 PARALLEL ONLY ANGLED == 0 OPPOSITE REGION
   EXT SR_MWD SR_MSD < ( 2.3 -0.004) ABUT < 90  PARALLEL ONLY ANGLED == 2 OPPOSITE REGION
   KD = EXPAND EDGE SR_MWD OUTSIDE BY 2.3
   BD = EXPAND EDGE SR_MSD OUTSIDE BY 2.3 
   CD = KD OR BD
   ZD = CD NOT SR_MD
   SIZE ZD BY (2.3 +0.004) /2 UNDEROVER TRUNCATE (2.3 +0.004) /2
}
