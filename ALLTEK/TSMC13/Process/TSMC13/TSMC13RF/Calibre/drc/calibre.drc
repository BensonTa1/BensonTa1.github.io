#IFDEF DATATYPE_WARNING
NW_DATATYPE.WARNING1 { @ Extreme user care needs to be taken when using any layer other than (3;0) that default MT form considers to create NW mask. The tapeout engineer must explicitly explain that those non-default layers must be considered equivalent to NW in the MT form to ensure complete fabrication. It is strongly recommended to use NW;drawing (3;0) layer to define NW regions. 
    COPY NWi_OTHERS
}
OD_DATATYPE.WARNING1 { @ Extreme user care needs to be taken when using any other layer to create OD mask such as pdiff (7;0), ndiff (8;0) or any layer other than (6;0), and (6;1) that default MT form considers. The tapeout engineer must explicitly explain that those non-default layers must be considered equivalent to OD in the MT form to ensure complete fabrication.  It is strongly recommended to use only OD;drawing (6;0) and OD;dummy (6;1) layers to defined OD and DOD regions.    
  COPY ODi_OTHERS
}
OD_DATATYPE.WARNING2 { @ RFMOS DRAIN OD (6;3) lvs dummy layer are only allowed in RFDMY region. 
   ODi_RFDRAIN NOT RFDMY
}
OD_DATATYPE.WARNING3 { @ Layer (6;3) is for recognition purpose of RF devices, please take care if this layer is adopted for non-RF designs and not for masking purpose of diffusion regions together with OD (6;0). 
   ODi_RFDRAIN NOT RFDMY
   ODi_RFDRAIN AND POLYGi
   ODi_RFDRAIN NOT ODi
}
PO_DATATYPE.WARNING1 { @ Extreme user care needs to be taken when using any layer other than (17;0), and (17,1) that default MT form considers to create PO mask. The tapeout engineer must explicitly explain that those non-default layers must be considered equivalent to PO in the MT form to ensure complete fabrication. It is strongly recommended to use PO;drawing (17;0) and PO;dummy (17;1) layer to define PO and DPO regions. 
   COPY POi_OTHERS
}

#ENDIF
#IFDEF WLCSP_SEALRING
#IFDEF BigSealringCorner
BigSealringCorner.OPTION.WARN{@ Please turn off BigSealringCorner and turn on LmarkSealringCorner when WLCSP_SEALRING design is applied.
      COPY CHIP
    }
#ENDIF
#IFDEF SmallSealringCorner
SmallSealringCorner.OPTION.WARN{@ Please turn off SmallSealringCorner and turn on LmarkSealringCorner when WLCSP_SEALRING design is applied.
      COPY CHIP
    }
#ENDIF
#IFNDEF LmarkSealringCorner
LmarkSealringCorner.OPTION.WARN{@ Please turn on LmarkSealringCorner when WLCSP_SEALRING design is applied.
      COPY CHIP
    }
#ENDIF
#ENDIF
#IFNDEF MSRF
  MSRF.OPTION.WARN{@ Please turn on MSRF when N90 MS/RF design is applied.
    CHIP INTERACT CTM
    CHIP INTERACT CBM
    CHIP INTERACT INDDMY
    CHIP INTERACT CTMDMY
    CHIP INTERACT RFDMY
  }
#ENDIF


#IFDEF FRONT_END


//NT_N CHECKS
//============

NTN_OD        = OD     AND NTN
NTN_PO        = POLY   AND NTN
NTN_GATE_W    = NTN_PO INSIDE EDGE NTN_OD
NTN_HV_GATE_W = NTN_GATE_W INSIDE EDGE OD2
#IFDEF MSRF
NTN_check     = NTN NOT INTERACT INDDMY
#ELSE
NTN_check     = COPY NTN
#ENDIF

NT_N.W.1 { @ Width >= ^NT_N_W_1 um
  INT NTN < NT_N_W_1 ABUT < 90 SINGULAR REGION
}
NT_N.W.2 { @ Channel length of 1.0V,1.2V or 1.5V native devide >= ^NT_N_W_2 um
  INT NTN_GATE_W <  NT_N_W_2 ABUT < 90 REGION
}
NT_N.W.3 { @ Channel length of 2.5V/3.3V native device >= ^NT_N_W_3 um
  INT NTN_HV_GATE_W < NT_N_W_3 ABUT < 90 REGION
}
#IFDEF HALF_NODE
NT_N.W.4 { @ Channel width of native device >= ^NT_N_W_4 um 
  NTN_GATE_L  = NTN_OD INSIDE EDGE NTN_PO
  INT NTN_GATE_L < NT_N_W_4 ABUT < 90 REGION
}  
#ENDIF
NT_N.S.1 { @ Space >= ^NT_N_S_1 um
  EXT NTN < NT_N_S_1 ABUT < 90 SINGULAR REGION
}
NT_N.S.2 { @ Space to {Active outside NT_N} >= ^NT_N_S_2 um
  DACT_OUT = DACT OUTSIDE NTN
  EXT DACT_OUT NTN_check < NT_N_S_2 ABUT < 90 OVERLAP SINGULAR REGION
}

NT_N.S.3 { @ Space to NWEL [overlap is not allowed] >= ^NT_N_S_3 um 
  EXT NTN NWELLi < NT_N_S_3 ABUT < 90 INSIDE ALSO SINGULAR REGION
  NTN AND NWELLi
}
NT_N.EN.1 { @ Enclosure of N+OD (minimum = maximum) == ^NT_N_EN_1 um
  A = NTN_check INTERACT NPOD
  B = NPOD INTERACT NTN_check
  C = SIZE B BY NT_N_EN_1
  D = SIZE A BY -NT_N_EN_1
  A XOR C
  B XOR D
}
NT_N.EX.1 { @ PO extension on {OD inside NT_N} (PO endcap) >= ^NT_N_EX_1 um
   ENC NTN_OD POLY < NT_N_EX_1 ABUT < 90 SINGULAR REGION
}
NT_N.R.1 { @ Overlap of DNW is not allowed.   
  NTN AND DNW
}
NT_N.R.2 { @ Only one OD is allowed in an NT_N (except for NMOS capacitors with same potential).
  NTN ENCLOSE OD > 1
}
NT_N.R.3 { @ P+ gate is not allowed in NT_N   
  (NTN AND GATE_PP) NOT INDDMY
}




//HRI is MSRF rules

//HRI CHECKS
//==========

HREP  = (PORES INTERACT HRI) AND RHRIDMY
HREP_L = HREP COIN INSIDE EDGE POLY

HRI.W.1 { @ Width >= ^HRI_W_1
  INT HRI < HRI_W_1 ABUT <90 SINGULAR REGION
}
HRI.W.2 { @ Width of HRI PO resistor >= ^HRI_W_2
  INT HREP_L < HRI_W_2 ABUT < 90 REGION
}
HRI.L.1 { @ Length of HRI PO resistor >= ^HRI_L_1
  PATH LENGTH HREP_L < HRI_L_1
}
HRI.S.1 { @ Space >= ^HRI_S_1
  EXT HRI < HRI_S_1 ABUT <90 SINGULAR REGION
}
HRI.S.2 { @ Space to N+OD or P+OD region >= ^HRI_S_2
  DPOD = NPOD OR PPOD
  EXT HRI DPOD < HRI_S_2 ABUT <90 SINGULAR REGION
}
HRI.S.3_HRI.S.4 { @ Space to NMOS/PMOS GATE >= ^HRI_S_3_4
  EXT HRI GATE < HRI_S_3_4 ABUT <90 SINGULAR REGION
}
HRI.EX.1 { @ Extension on HRI PO >= ^HRI_EX_1
  A = POLY AND HRI
  ENC A HRI < HRI_EX_1 ABUT <90 SINGULAR REGION
}
//HRI.R.1 is checked by HRI.R.3

HRI.R.2 { @ Overlap of NP on the same PO region (seated on a non-OD region.) is not allowed.
  NP_OVP_HRI = NP AND HRI
  NP_OVP_HRI AND FPO1
}
HRI.R.3 { @ Overlap of OD is not allowed. 
  HRI AND OD
}
HRI.A.1 { @ Area >= ^HRI_A_1
  AREA HRI < HRI_A_1
}
HRI.O.1 { @ PP overlap of HRI PO resistor (maximum = minimum) == ^HRI_O_1
  A = (POLY AND HRI) AND RPO
  B = A INSIDE EDGE POLY
  C = EXPAND EDGE B INSIDE BY HRI_O_1
  D = A AND PP
  C XOR D
}  



//VTL_N CHECKS
//============

VTL_N.W.1 { @ Space >= ^VTL_N_W_1 um
  INT VTLN < VTL_N_W_1 ABUT < 90 SINGULAR REGION
}
VTL_N.W.2 { @ Channel length of 1.2V low Vt NMOS >= ^VTL_N_W_2 um
  A = LV_NGATE_W INSIDE EDGE VTLN
  INT A < VTL_N_W_2 ABUT < 90 REGION
}
#IFDEF MSRF
#IFDEF 2.5V
VTL_N.W.3 { @ Channel length of 2.5V low Vt NMOS >= ^VTL_N_W_3 um
  A = HV_NGATE_W INSIDE EDGE VTLN
  INT A < VTL_N_W_3 ABUT < 90 REGION
}
#ELSE
VTL_N.W.3 { @ TSMC do not offer 3.3V Low Vt NMOS
  VTLN AND OD2
}  
#ENDIF
#ELSE  //MSRF
VTL_N.W.3 { @ TSMC do not offer 2.5V or 3.3V Low Vt NMOS in LOGIC process
  VTLN AND OD2
}
#ENDIF  //MSRF

VTL_N.S.1 { @ Space >= ^VTL_N_S_1 um
  EXT VTLN < VTL_N_S_1 ABUT < 90 SINGULAR REGION
}
VTL_N.S.2 { @ Space to GATE in poly endcap direction >= ^VTL_N_S_2 um
  A = GATE NOT INTERACT VTLN
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTL_N_S_3 - VTL_N_S_2)) OR A
  C = SIZE B BY VTL_N_S_2
  VTLN AND C
}
// VTL_N.S.3 is checked by VTL_N.S.2
VTL_N.EX.1 { @ Extension on GATE in
             @ 1. poly endcap direction >= ^VTL_N_EX_1 um
             @ 2. S/D direction >= ^VTL_N_EX_2 um
  A = GATE INTERACT VTLN
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTL_N_EX_2 - VTL_N_EX_1)) OR A
  C = SIZE B BY VTL_N_EX_1
  C NOT VTLN
}
// VTL_N.EX.2 is checked by VTL_N.EX.1
VTL_N.R.1 { @ Overlap of {NW OR NT_N} is not allowed
  VTLN AND NWEL
  VTLN AND NTN
}

//VTL_P CHECKS
//============
VTL_P.W.1 { @ Width >= ^VTL_P_W_1 um
  INT VTLP < VTL_P_W_1 ABUT < 90 SINGULAR REGION
}
VTL_P.W.2 { @ Channel length of 1.2V low Vt PMOS >= ^VTL_P_W_2 um
  A = LV_PGATE_W INSIDE EDGE VTLP
  INT A < VTL_P_W_2 ABUT < 90 REGION
}
#IFDEF MSRF
#IFDEF 2.5V
VTL_P.W.3 { @ Channel length of 2.5V low Vt NMOS >= ^VTL_P_W_3 um
  A = HV_PGATE_W INSIDE EDGE VTLP
  INT A < VTL_P_W_3 ABUT < 90 REGION
}
#ELSE
VTL_P.W.3 { @ TSMC do not offer 3.3V Low Vt NMOS
  VTLP AND OD2
}  
#ENDIF
#ELSE  //MSRF
VTL_P.W.3 { @ TSMC do not offer 2.5V or 3.3V Low Vt NMOS in LOGIC process
  VTLP AND OD2
}
#ENDIF  //MSRF

VTL_P.S.1 { @ Space >= ^VTL_P_S_1 um
  EXT VTLP < VTL_P_S_1 ABUT < 90 SINGULAR REGION
}
VTL_P.S.2 { @ Space to GATE in poly endcap direction >= ^VTL_P_S_2 um
  A = GATE NOT INTERACT VTLP
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTL_P_S_3 - VTL_P_S_2)) OR A
  C = SIZE B BY VTL_P_S_2
  VTLP AND C
}
// VTL_P.S.3 is checked by VTL_P.S.2
VTL_P.EX.1 { @ Extension on GATE in poly endcap direction >= ^VTL_P_EX_1 um, in S/D direction >= ^VTL_P_EX_2 um
  A = GATE INTERACT VTLP
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTL_P_EX_2 - VTL_P_EX_1)) OR A
  C = SIZE B BY VTL_P_EX_1
  C NOT VTLP
}
// VTL_P.EX.2 is checked by VTL_P.EX.1
VTL_P.R.1 { @ Overlap of {PW OR NT_N} is not allowed
  VTLP NOT NWEL
  VTLP AND NTN
}


// LVID CHECKS
//============

LOVT_GATE = LV_GATE INTERACT LVID

LVID.W.1 { @ Width >= ^LVID_W_1 um
   INT LVID < LVID_W_1 ABUT < 90 SINGULAR REGION 
}
LVID.S.1 { @ Space >= ^LVID_S_1 um
    EXT LVID < LVID_S_1 ABUT < 90 SINGULAR REGION 
}
LVID.S.2 { @ Space to GATE in poly endcap direction >= ^LVID_S_2 um, in S/D direction >= ^LVID_S_3 um
  A = GATE NOT INTERACT LVID
  X = A INSIDE EDGE POLY
  B = (EXPAND EDGE X OUTSIDE BY (LVID_S_2 - LVID_S_3)) OR A
  C = SIZE B BY LVID_S_3
  LVID AND C
}
// LVID.S.3 is checked by LVID.S.2
LVID.EX.1 { @ Extension on gate in S/D direction >= ^LVID_EX_1 um
    A = GATE INTERACT LVID
    X = A INSIDE EDGE OD
    ENC X LVID < LVID_EX_1 ABUT < 90 OPPOSITE REGION 
}
LVID.R.1 { @ LVID must fully cover {(((LVID and gate) SIZING ^LVID_R_1_1) AND PO) SIZING ^LVID_R_1_2}
  A = GATE INTERACT LVID
  X = A INSIDE EDGE POLY
  B = (EXPAND EDGE X OUTSIDE BY LVID_R_1_1) OR A
  C = SIZE B BY LVID_R_1_2
  C NOT LVID
}


//VTH_N CHECKS
//============

VTH_N.TITLE { @ Only core (1.0V, 1.2V) has high Vt devices.
  VTHN AND OD2
}  
VTH_N.W.1 { @ Width >= ^VTH_N_W_1 um
  INT VTHN < VTH_N_W_1 ABUT < 90 SINGULAR REGION
}
VTH_N.W.2 { @ Channel length of 1.0V or 1.2V high Vt NMOS >= ^VTH_N_W_2 um
  A = LV_NGATE_W INSIDE EDGE VTHN
  INT A < VTH_N_W_2 ABUT < 90 REGION
}
VTH_N.S.1 { @ Space >= ^VTH_N_S_1 um
  EXT VTHN < VTH_N_S_1 ABUT < 90 SINGULAR REGION
}
VTH_N.S.2 { @ Space to GATE in poly endcap direction >= ^VTH_N_S_2 um
  A = GATE NOT INTERACT VTHN
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTH_N_S_3 - VTH_N_S_2)) OR A
  C = SIZE B BY VTH_N_S_2
  VTHN AND C
}
// VTH_N.S.3 is checked by VTH_N.S.2
VTH_N.EX.1 { @ Extension on GATE in poly endcap direction >= ^VTH_N_EX_1 um, in S/D direction >= ^VTH_N_EX_1 um
  A = GATE INTERACT VTHN
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTH_N_EX_2 - VTH_N_EX_1)) OR A
  C = SIZE B BY VTH_N_EX_1
  C NOT VTHN
}
// VTH_N.EX.2 is checked by VTH_N.EX.1
VTH_N.R.1 { @ Overlap {NW OR NT_N} is not allowed
  VTHN AND NWEL
  VTHN AND NTN
}

//VTH_P CHECKS
//============

VTH_P.TITLE { @ Only core (1.0V, 1.2V) has high Vt devices.
  VTHP AND OD2
}  
VTH_P.W.1 { @ Space >= ^VTH_P_W_1 um
  INT VTHP < VTH_P_W_1 ABUT < 90 SINGULAR REGION
}
VTH_P.W.2 { @ Channel length of 1.0V or 1.2V high Vt PMOS >= ^VTH_P_W_2 um
  A = LV_PGATE_W INSIDE EDGE VTHP
  INT A < VTH_P_W_2 ABUT < 90 REGION
}
VTH_P.S.1 { @ Space >= ^VTH_P_S_1 um
  EXT VTHP < VTH_P_S_1 ABUT < 90 SINGULAR REGION
}
VTH_P.S.2 { @ Space to GATE in poly endcap direction >= ^VTH_P_S_2 um
  A = GATE NOT INTERACT VTHP
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTH_P_S_3 - VTH_P_S_2)) OR A
  C = SIZE B BY VTH_P_S_2
  VTHP AND C
}
// VTH_P.S.3 is checked by VTH_P.S.2
VTH_P.EX.1 { @ Extension on GATE in poly endcap direction >= ^VTH_P_EX_1 um, in S/D direction >= ^VTH_P_EX_2 um
  A = GATE INTERACT VTHP
  X = A INSIDE EDGE OD
  B = (EXPAND EDGE X OUTSIDE BY (VTH_P_EX_2 - VTH_P_EX_1)) OR A
  C = SIZE B BY VTH_P_EX_1
  C NOT VTHP
}
// VTH_P.EX.2 is checked by VTH_P.EX.1
VTH_P.R.1 { @ Overlap of {PW OR NT_N} is not allowed
  VTHP NOT NWEL
  VTHP AND NTN
}



//OD CHECKS
//=========

#IFDEF CHECK_DENSITY_IN_ODBLK
#IFDEF MSRF 
CB_EXD = SIZE CB BY 2
OD_EXC = ((((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY) OR CB_EXD
#ELSE
OD_EXC = (((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY
#ENDIF
#ELSE
#IFDEF MSRF 
CB_EXD = SIZE CB BY 2
OD_EXC = (((((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY) OR ODBLK) OR CB_EXD
#ELSE
OD_EXC = ((((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY) OR ODBLK
#ENDIF
#ENDIF

#IFDEF FULL_CHIP
ODx = ALL_OD NOT EMPTY_AREA
CHIP_NOT_OD_EXC = COPY CHIP_CHAMFERED  
#ELSE
ODx = COPY ALL_OD 
CHIP_NOT_OD_EXC = COPY CHIP 
#ENDIF

OD.W.1 { @ Width >= ^OD_W_1 um
  INT OD < OD_W_1 ABUT < 90 SINGULAR REGION
}
// OD.W.2 is checked by OD.W.1
OD.S.1 { @ Space >= ^OD_S_1 um
  EXT OD < OD_S_1 ABUT < 90 SINGULAR REGION
}
// OD.S.2 is checked by PP.R.2
OD.S.3 { @ N+ ACTIVE space to NW >= ^OD_S_3 um
  A = NPOD NOT ODWR
  (EXT A NWELLi < OD_S_3 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( A CUT NWELLi ) NOT INSIDE EXCL_SRM
}
OD.S.4 { @ PW STRAP space to NW >= ^OD_S_4 um
  (EXT PPOD NWELLi < OD_S_4 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( PPOD CUT NWELLi ) NOT INSIDE EXCL_SRM    
}
OD.S.5 { @ GATE space to Butted STRAP[point projection] >= ^OD_S_5 um 
  X = EXPAND EDGE GATEN_W OUTSIDE BY OD_S_5
  X TOUCH PSTP
  Y = EXPAND EDGE GATEP_W OUTSIDE BY OD_S_5
  Y TOUCH NSTP
}
OD.EN.1 { @ NW STRAP enclosure by NW >= ^OD_EN_1 um
  (ENC NPOD NONWR < OD_EN_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( NPOD CUT NONWR ) NOT INSIDE EXCL_SRM    
}
OD.EN.2 { @ P+ACTIVE enclosure by NW >= ^OD_EN_2 um
  (ENC PPOD NONWR < OD_EN_2 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( PPOD CUT NONWR ) NOT INSIDE EXCL_SRM    
}
OD.A.1 { @ Area >= ^OD_A_1 um2
  AREA OD < OD_A_1
}
VARIABLE OD_A_2pre ((OD_A_2 + (OD_S_1 * OD_S_1 * 3.142))/(2 * OD_S_1))*((OD_A_2 + (OD_S_1 * OD_S_1 * 3.142))/(2 * OD_S_1))/3.141

OD.A.2 { @ Enclosed area >= ^OD_A_2 um2
  A = HOLES OD INNER < OD_A_2pre
  B = A NOT OD
  AREA B < OD_A_2
}  
CHIPU_od25   = SIZE CHIP BY 25
CHIPU_od50   = SIZE CHIP BY 50
CHIPU_od75   = SIZE CHIP BY 75
CHIPU_od100   = SIZE CHIP BY 100
CHIPU_od125   = SIZE CHIP BY 125
CHIPU_od150   = SIZE CHIP BY 150
CHIPU_od175   = SIZE CHIP BY 175
CHIPU_od200   = SIZE CHIP BY 200
CHIPU_od225   = SIZE CHIP BY 225
OD.DN.1 { @ {OD OR DOD} local density (minimum) over window 500um x 500um stepping 250um >= 20%
  D0 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP  
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D = RECTANGLE D0 == 500
  ERR1 = ( D0 NOT D ) NOT OD_EXC
  F1 = AREA ERR1 >= 62500
  D1 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od25
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D2 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od50
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D3 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od75
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D4 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od100
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D5 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od125
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D6 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od150
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D7 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od175
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D8 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od200
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D9 = DENSITY ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od225
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)  
  F2 = AREA ( ERR2 NOT OD_EXC ) >= 62500
  F = F1 OR F2
  DENSITY F ODx CHIP_NOT_OD_EXC < OD_DN_1 WINDOW 500 STEP 250 BACKUP PRINT OD_DN_1.density 
          [ !AREA(F) + (AREA(ODx)/AREA(CHIP_NOT_OD_EXC)) ]       
}
OD.DN.2 { @ {OD OR DOD} local density (maximum) over window 500um x 500um stepping 250um <= 80% 
  D0 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP  
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D = RECTANGLE D0 == 500
  ERR1 = ( D0 NOT D ) NOT OD_EXC
  F1 = AREA ERR1 >= 62500
  D1 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od25
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D2 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od50
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D3 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od75
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D4 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od100
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D5 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od125
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D6 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od150
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D7 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od175
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D8 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od200
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  D9 = DENSITY ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP INSIDE OF LAYER CHIPU_od225
          [ AREA(ODx)/AREA(CHIP_NOT_OD_EXC) ]
  ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
  F2 = AREA ( ERR2 NOT OD_EXC ) >= 62500
  F = F1 OR F2
  DENSITY F ODx CHIP_NOT_OD_EXC > OD_DN_2 WINDOW 500 STEP 250 BACKUP PRINT OD_DN_2.density 
          [ !!AREA(F) * ((AREA(ODx)/AREA(CHIP_NOT_OD_EXC))) ]
}
#IFDEF FULL_CHIP
OD.DN.3 { @ {OD OR DOD} density across full chip (minimum) >= 25%
  DENSITY ALL_OD < OD_DN_3 PRINT OD_DN_3.density
}
OD.DN.4 { @ {OD OR DOD} density across full chip (maximum) <= 75%
  DENSITY ALL_OD > OD_DN_4 PRINT OD_DN_4.density
}  
#ENDIF
OD.R.1 { @ Width (J) of at least one segment of boundary between ACTIVE and Butted STRAP >= ^OD_R_1_W um
	 @ When J<0.3um, length (T) of {ACTIVE (source) interact with Butted_STRAP} >= ^OD_R_1_L um
  BUTT_EDGE = SD COIN OUTSIDE EDGE DSTP
  BUTT_LONG_EDGE = LENGTH BUTT_EDGE >= OD_R_1_W
  BUTT_EXP = (EXPAND EDGE BUTT_EDGE INSIDE BY 0.005 EXTEND BY 0.005) AND SD
  BUTT_EXP_SHORT = BUTT_EXP NOT WITH EDGE BUTT_LONG_EDGE
  CHECK_SD = SD INTERACT BUTT_EXP_SHORT
  CHECK_EDGE = (CHECK_SD OUTSIDE EDGE GATE) OUTSIDE EDGE DSTP
  CHECK_EDGE_LONG = PATH LENGTH CHECK_EDGE > OD_R_1_L
  NARROW_SD1 = INT CHECK_EDGE_LONG < OD_R_1_W ABUT < 90 OPPOSITE REGION
  NARROW_SD2 = NARROW_SD1 INTERACT BUTT_EXP_SHORT
  NARROW_SD3 = ((SIZE (NARROW_SD1 OUTSIDE NARROW_SD2) BY 0.001) AND SD) INTERACT NARROW_SD2
  NARROW_SD = NARROW_SD2 OR NARROW_SD3
  NARROW_SD_EDGE = NARROW_SD COIN INSIDE EDGE OD
  PATH LENGTH NARROW_SD_EDGE > OD_R_1_L
}
OD.R.2 { @ OD must be fully covered by N+/P+ except for DOD/LOGO/NW resister within OD
  (((OD NOT ODWR) NOT LOGO) NOT CDUDMY) NOT IMP
}


//OD2 CHECKS
//==========

OD2.W.1 { @ Width >= ^OD2_W_1 um
  INT OD2 < OD2_W_1 ABUT < 90 SINGULAR REGION
}
OD2.S.1 { @ Space >= ^OD2_S_1 um
  EXT OD2 < OD2_S_1 ABUT < 90 SINGULAR REGION
}
OD2.S.2 { @ Space to {ACTIVE OR GATE} >= ^OD2_S_2 um
  x = DACT OR GATE
  EXT OD2 x < OD2_S_2 ABUT < 90 SINGULAR REGION
}
OD2.S.3 { @ Space to 1.0V 1.2V or 1.5V GATE in S/D direction >= ^OD2_S_3 um
   A = OD2 INSIDE EDGE OD
   EXT A GATE_W < OD2_S_3 ABUT < 90 REGION
}
OD2.S.4 { @ Space to NW >= ^OD2_S_4 um
  EXT OD2 NWEL < OD2_S_4 ABUT < 90 > 0 SINGULAR REGION
}
OD2.EN.1 { @ Enclosure of 2.5V or 3.3v gate in S/D direction >= ^OD2_EN_1 um
  ENC GATE_W OD2 < OD2_EN_1 ABUT < 90 OPPOSITE REGION
  GATE CUT OD2
}
OD2.EX.1 { @ Extension on { ACTIVE OR GATE } >= ^OD2_EX_1 um
   DACTG = DACT OR GATE 
   CHECK_EDGE = ENC [DACTG] OD2 < OD2_EX_1 ABUT < 90 SINGULAR
   CHECK_EDGE NOT COIN OUTSIDE EDGE DSTP
   OD2 INSIDE DACT
}
OD2.EX.2 { @ NW extension on OD2 >= ^OD2_EX_2 um
  ENC OD2 NWEL < OD2_EX_2 ABUT < 90 > 0 SINGULAR REGION
}
OD2.EX.3 { @ Extension on NW >= ^OD2_EX_3 um
  ENC NWEL OD2 < OD2_EX_3 ABUT < 90 > 0 SINGULAR REGION
}
OD2.O.1 { @ Overlap of NW >= ^OD2_O_1 um
  X = OD2 AND NWEL
  INT X < OD2_O_1 ABUT < 90 SINGULAR REGION
}


//PO CHECKS
//=========

POLY_EDGE_45 = POLY ANGLE == 45
POLY_EDGE_45L = LENGTH POLY_EDGE_45 >= PO_W_4_L

// PO.W.1_1.0V_1.2V_1.5V is checked by PO.W.3
// PO.W.2_1.0V_1.2V_1.5V is checked by PO.W.3


#IFDEF 2.5V
PO.W.1_2.5V { @ Channel length of 2.5V PMOS >= ^PO_W_1_25V um
  INT HV_PGATE_W < PO_W_1_25V ABUT < 90 REGION
}
PO.W.2_2.5V { @ Channel length of 2.5V NMOS >= ^PO_W_2_25V um
  INT HV_NGATE_W < PO_W_2_25V ABUT < 90 REGION
}
#ENDIF

#IFDEF 3.3V
PO.W.1_3.3V { @ Channel length of 3.3V PMOS >= ^PO_W_1_33V um
  INT HV_PGATE_W < PO_W_1_33V ABUT < 90 REGION
}
PO.W.2_3.3V { @ Channel length of 3.3V NMOS >= ^PO_W_2_33V um
  INT HV_NGATE_W < PO_W_2_33V ABUT < 90 REGION
}
#ENDIF

PO.W.3 { @ Width >= ^PO_W_3 um
  INT POLY < PO_W_3 ABUT < 90 SINGULAR REGION
}
PO.W.4 { @ Width of 45 degree FIELD PO [with length >= 0.39 um] >= ^PO_W_4 um
  INT POLY_EDGE_45L < PO_W_4 ABUT < 90 REGION
}
PO.S.1 { @ Space >= ^PO_S_1 um
  EXT POLY < PO_S_1 ABUT < 90 SINGULAR REGION
}
PO.S.2 { @ GATE space in same OD >= ^PO_S_2 um
  EXT LV_GATE < PO_S_2 ABUT < 90 SINGULAR REGION
}
PO.S.3 { @ {GATE inside OD2} space in the same OD >= ^PO_S_3 um 
    EXT HV_GATE_W < PO_S_3 ABUT < 90 REGION 
    EXT HV_GATE < PO_S_3 ABUT < 90 CORNER TO CORNER	
}
PO.S.4 { @ FIELD PO space to OD >= ^PO_S_4 um
  EXT POLY OD < PO_S_4 ABUT < 89.5 SINGULAR REGION
}
#IFDEF HALF_NODE
PO.S.5 { @ Min. space between two 45 degree bent PO >= ^PO_S_5 um
  X = EXPAND EDGE POLY_EDGE_45 OUTSIDE BY PO_S_5
  X AND POLY
}
#ENDIF
PO.EX.1 { @ Extension on PO in endcap direction >= ^PO_EX_1 um
  ENC OD POLY < PO_EX_1 ABUT < 89.5 SINGULAR REGION
}
PO.EX.2 { @ OD extension on PO >= ^PO_EX_2 um
  ENC POLY OD < PO_EX_2 ABUT < 89.5 OPPOSITE SINGULAR REGION
}
PO.A.1 { @ Area>= ^PO_A_1 um2
  AREA POLY < PO_A_1
}
PO.A.2 { @ Enclosed area >= ^PO_A_2 um2
  HOLES POLY < PO_A_2 INNER
}  

#IFDEF FULL_CHIP

PO_DENSITY = DENSITY ALL_POLY CHIP < PO_DN_1 INSIDE OF LAYER CHIPx PRINT PO_DN_1.density [ AREA(ALL_POLY)/AREA(CHIP) ]
PO.DN.1 { @ {PO OR DPO} density across full chip >= 14%
  PO_DENSITY AND CHIPx
}
#ENDIF
PO.R.1 { @ The gate must be a rectangle orthogonal to the grid.
         @ (A bent gate is not allowed).
  (NOT RECTANGLE GATE ORTHOGONAL ONLY) NOT INSIDE LOGO
}
// PO.R.2 is not able to check
PO.R.3 { @ PO intersecting OD must form two or more diffusions except LOGO and RTMOM region (MOMDMY, CAD layer: 155;21).   
  GATEW = GATE INSIDE EDGE OD
  X = GATE NOT WITH EDGE GATEW == 2
  A = INT GATEW < GRID ABUT == 90 INTERSECTING ONLY REGION
  ((X OR (GATE INTERACT A)) NOT LOGO) NOT RTMOMDMY  
}  

#IFDEF FULL_CHIP
//get all floating gates
Float_GATE = NET AREA RATIO GATEu PSTPu NSTPu PSDu_g NSDu_g CBu CB2u UBMnu UBMdu COu > 0 
	[!AREA(PSTPu)*!AREA(NSTPu)*!AREA(PSDu_g)*!AREA(NSDu_g)*!AREA(CBu)*!AREA(CB2u)*!AREA(UBMnu)*!AREA(UBMdu)+!AREA(COu)]

//get all floating source/drain
Float_NSD = NET AREA RATIO NSDu_g PSDu_g GATEu PSTPu NSTPu CBu CB2u UBMnu UBMdu > 0
	[~(COUNT(NSDu_g)-1)*!AREA(PSDu_g)*!AREA(GATEu)*!AREA(PSTPu)*!AREA(NSTPu)*!AREA(CBu)*!AREA(CB2u)*!AREA(UBMnu)*!AREA(UBMdu)]
Float_PSD = NET AREA RATIO PSDu_g NSDu_g GATEu PSTPu NSTPu CBu CB2u UBMnu UBMdu > 0
	[~(COUNT(PSDu_g)-1)*!AREA(NSDu_g)*!AREA(GATEu)*!AREA(PSTPu)*!AREA(NSTPu)*!AREA(CBu)*!AREA(CB2u)*!AREA(UBMnu)*!AREA(UBMdu)]

//not floating source/drain
effective_NSD = NSDu_g NOT Float_NSD
effective_PSD = PSDu_g NOT Float_PSD

Float_NSD_a = Float_NSD NOT ((Float_NSD OR GATE) INTERACT effective_NSD >= 2 BY NET)
Float_PSD_a = Float_PSD NOT ((Float_PSD OR GATE) INTERACT effective_PSD >= 2 BY NET)

Float_GATE_check = Float_GATE NOT INTERACT (Float_NSD_a OR Float_PSD_a)

PO.R.4{@ It is prohibited for Floating Gate if the effective source/drain is not connected together 
  Float_GATE_check INTERACT NSDu > 1 BY NET
  Float_GATE_check INTERACT PSDu > 1 BY NET
}
#ENDIF
#IFDEF HALF_NODE
ALL_POD = ALL_OD OR ALL_POLY
#IFDEF CHECK_DENSITY_IN_PODBLK
POD_EXC = (((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY
#ELSE
POD_EXC = (((((NWDMY OR FWi) OR LMARK) OR LOGO) OR INDDMY) OR ODBLK) OR POBLK
#ENDIF

#IFDEF FULL_CHIP
PODx = (ALL_POD NOT POD_EXC) NOT EMPTY_AREA
CHIP_NOT_POD_EXC = CHIP_CHAMFERED NOT POD_EXC 
#ELSE
PODx = ALL_POD NOT POD_EXC
CHIP_NOT_POD_EXC = CHIP NOT POD_EXC
#ENDIF
PO.DN.2 { @ {OD OR DOD OR PO OR DPO } local density (minimun) over window 20um x 20um stepping 10um >= 0.1%
   DENSITY PODx CHIP_NOT_POD_EXC < 0.001 WINDOW 20 STEP 10 BACKUP PRINT PO_DN_2.density 
    [ AREA(PODx)/AREA(CHIP_NOT_POD_EXC) ]
}
#ENDIF   //HALF_NODE



//NP CHECKS
//=========

NP_BEDGE = NP INSIDE EDGE OD   // NP edge to form/abut butted tap
BUTT_PSTP     = PSTP TOUCH NACT
BUTT_NSTP     = NSTP TOUCH PACT
BUTT_OD       = BUTT_PSTP OR BUTT_NSTP
NP.W.1 { @ Width >= ^NP_W_1 um
  (INT NP < NP_W_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NP.S.1 { @ Space >= ^NP_S_1 um
  (EXT NP < NP_S_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NP.S.2 { @ Space to P+ACTIVE (non-butted) >= ^NP_S_2 um
  (EXT NP PACT < NP_S_2 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( NP AND PACT ) NOT INSIDE EXCL_SRM    
  X = EXT NP [PACT] < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT NPOD) NOT INSIDE EXCL_SRM
}
NP.S.3 { @ Space to PW STRAP (non-butted) >= ^NP_S_3 um
  (EXT NP PSTP < NP_S_3 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( NP AND PSTP ) NOT INSIDE EXCL_SRM    
  X = EXT NP [PSTP] < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT NPOD) NOT INSIDE EXCL_SRM
}
NP.S.4 { @ {NP edge on OD} space to PMOS GATE >= ^NP_S_4 um
  (EXT GATEP_W NP_BEDGE < NP_S_4 ABUT < 90 OPPOSITE REGION) NOT INSIDE EXCL_SRM
}

// NP.S.5 is checked by PP.R.2

EX_GATEP = EXPAND EDGE GATEP_W OUTSIDE BY NP_S_6 EXTEND BY NP_S_6_J

NP.S.6 { @ Butted NW STRAP space to PO in the same OD [the butted P+ ACTIVE extending 0 < J1 < ^NP_S_6_J um] >= ^NP_S_6 um
  A = EX_GATEP AND BUTT_NSTP
  B = EX_GATEP AND PACT
  C = A INTERACT B
  D = SD INTERACT C
  E = GATEP_W COIN OUTSIDE EDGE D
  F = EXPAND EDGE E OUTSIDE BY NP_S_6 EXTEND BY NP_S_6_J
  C AND F
}
ODPO_RES_unsi = ODPO_RES INTERACT RPO
NP.S.7 { @ Space to P type unsilicided PO/OD >= ^NP_S_7 um
  PYRE = ODPO_RES_unsi AND PP 		// P-type PO and OD resistor
  (EXT PYRE NP < NP_S_7 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}

// NP.EN.1 is checked by PP.EN.1

NP.EN.2 { @ Enclosure of NW STRAP >= ^NP_EN_2 um
  (ENC NSTP NP < NP_EN_2 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  X = ENC [NSTP] NP < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT PPOD) NOT INSIDE EXCL_SRM
}
NP.EX.1 { @ Extension on N+ACTIVE >= ^NP_EX_1 um
  A = NACT NOT ODWR
  (ENC A NP < NP_EX_1 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  X = ENC [A] NP < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT PPOD) NOT INSIDE EXCL_SRM
}

// NP.EX.2 is checked by NP.EN.2, PP.R.2

NP.EX.3 { @ Extension on N type unsilicided PO/OD >= ^NP_EX_3 um
  (ENC ODPO_RES_unsi NP < NP_EX_3 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NP.EX.4 { @ {NP edge on OD} extension on NMOS GATE >= ^NP_EX_4 um
  (ENC GATEN_W NP_BEDGE < NP_EX_4 ABUT < 90 OPPOSITE REGION) NOT INSIDE EXCL_SRM
}
NP.O.1 { @ Overlap of OD >= ^NP_O_1 um
  (INT OD NP < NP_O_1 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NP.A.1 { @ Area	>= ^NP_A_1 um2
  AREA NP < NP_A_1
}
VARIABLE NP_A_2pre ((NP_A_2 + (NP_S_1 * NP_S_1 * 3.142))/(2 * NP_S_1))*((NP_A_2 + (NP_S_1 * NP_S_1 * 3.142))/(2 * NP_S_1))/3.141
NP.A.2 { @ Enclosed area >= ^NP_A_2 um2
  A = HOLES NP INNER < NP_A_2pre 
  B = A NOT NP
  (AREA B < NP_A_2) NOT INSIDE SRAM_EXCLUDE
}
NP.R.1 { @ NP must fully cover {((NMOS GATE SIZING ^NP_R_1_1 ) AND PO) SIZING ^NP_R_1 }
  EXGATE_NP = SIZE ((SIZE GATE_NP BY NP_R_1_1) AND POLY) BY NP_R_1
  (EXGATE_NP NOT NP) NOT INSIDE EXCL_SRM
}

// NP.R.2 is checked by PP.R.2


//PP CHECKS
//=========

// Expand edges outward from OD and extended side to side to form a rectangle.
PP_BEDGE = PP INSIDE EDGE OD   // PP edge to form/abut butted tap
#IFDEF FULL_CHIP
PP_CORE  = (PP NOT CSRDMY) NOT SRCSR
#ELSE
PP_CORE  = PP NOT CSRDMY
#ENDIF
PP.W.1 { @ Width >= ^PP_W_1 um
  (INT PP < PP_W_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
PP.S.1 { @ Space >= ^PP_S_1 um
  (EXT PP < PP_S_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
PP.S.2 { @ Space to N+ACTIVE (non-butted) >= ^PP_S_2 um
  (EXT PP NACT < PP_S_2 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( PP AND NACT ) NOT INSIDE EXCL_SRM    
  X = EXT PP [NACT] < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT PPOD) NOT INSIDE EXCL_SRM
}
PP.S.3 { @ Space to NW STRAP (non-butted) >= ^PP_S_3 um
  (EXT PP NSTP < PP_S_3 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ( PP AND NSTP ) NOT INSIDE EXCL_SRM    
  X = EXT PP [NSTP] < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT PPOD) NOT INSIDE EXCL_SRM
}
PP.S.4 { @ {PP edge on OD} space to NMOS GATE >= ^PP_S_4 um
  (EXT GATEN_W PP_BEDGE < PP_S_4 ABUT < 90 OPPOSITE REGION) NOT INSIDE EXCL_SRM
}

// PP.S.5 is checked by PP.R.2

EX_GATEN = EXPAND EDGE GATEN_W OUTSIDE BY PP_S_6 EXTEND BY PP_S_6_J

PP.S.6 { @ Butted PW STRAP space to PO in the same OD [the butted N+ ACTIVE extending 0 < J1 < ^PP_S_6_J um] >= ^PP_S_6 um
  A = EX_GATEN AND BUTT_PSTP
  B = EX_GATEN AND NACT
  C = A INTERACT B
  D = SD INTERACT C
  E = GATEN_W COIN OUTSIDE EDGE D
  F = EXPAND EDGE E OUTSIDE BY PP_S_6 EXTEND BY PP_S_6_J
  C AND F
}
PP.S.7 { @ Space to N type unsilicided PO/OD >= ^PP_S_7 um
  NYRE = ODPO_RES_unsi AND NP 		// N-type PO and OD resistor
  (EXT NYRE PP < PP_S_7 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
PP.EN.1 { @ {NP OR PP} enclosure of PO (except DPO and LOGO) >= ^PP_EN_1 um
  ILP_NOT_LOGO = ( POLY NOT LOGO) NOT CDUDMY
  (ENC ILP_NOT_LOGO IMP < PP_EN_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
  ((ILP_NOT_LOGO NOT IMP) NOT HRI) NOT INSIDE EXCL_SRM 
}
PP.EN.2 { @ Enclosure of PW STRAP >= ^PP_EN_2 um
  (ENC PSTP PP_CORE < PP_EN_2 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  X = ENC [PSTP] PP_CORE < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT NPOD) NOT INSIDE EXCL_SRM
}
PP.EX.1 { @ Extension on P+ACTIVE >= ^PP_EX_1 um
  IMP1 = NP OR PP_CORE
  (ENC PACT PP_CORE < PP_EX_1 ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
  X = ENC [PACT] PP_CORE < 0.001 ABUT == 0
  Y = EXPAND EDGE X OUTSIDE BY 0.001
  (Y NOT INTERACT NPOD) NOT INSIDE EXCL_SRM
  OD COIN INSIDE EDGE IMP1 
  // IMP cannot coincident OD except butting diffusion edge. PP.EX.1,PP.EN.2/NP.EX.1,NP.EN.2
}

// PP.EX.2 is checked by PP.EN.2, PP.R.2

PP.EX.3 { @ Extension on P type unsilicided PO/OD >= ^PP_EX_3 um
  (ENC ODPO_RES_unsi PP < PP_EX_3 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
PP.EX.4 { @ {PP edge on OD} extension on PMOS GATE >= ^PP_EX_4 um
  (ENC GATEP_W PP_BEDGE < PP_EX_4 ABUT < 90 OPPOSITE REGION) NOT INSIDE EXCL_SRM
}
PP.O.1 { @ Overlap of OD >= ^PP_O_1 um
  (INT OD PP_CORE < PP_O_1  ABUT < 90 > 0 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
PP.A.1 { @ Area	>= ^PP_A_1 um2
  AREA PP < PP_A_1
}
VARIABLE PP_A_2pre ((PP_A_2 + (PP_S_1 * PP_S_1 * 3.142))/(2 * PP_S_1))*((PP_A_2 + (PP_S_1 * PP_S_1 * 3.142))/(2 * PP_S_1))/3.141

PP.A.2 { @ Enclosed area >= ^PP_A_2 um2
  A = HOLES PP INNER < PP_A_2pre
  B = A NOT PP
  (AREA B < PP_A_2) NOT INSIDE SRAM_EXCLUDE
}
PP.R.1 { @ PP must fully cover {((PMOS GATE SIZING ^PP_R_1_1 ) AND PO) SIZING ^PP_R_1 }
  EXGATE_PP = SIZE ((SIZE GATE_PP BY PP_R_1_1) AND POLY) BY PP_R_1
  (EXGATE_PP NOT PP) NOT INSIDE EXCL_SRM
}
PP.R.2 { @ Overlap of NP is not allowed
  (PP AND NP) NOT INSIDE EXCL_SRM
}


//LDN CHECKS
//==========

OD2D = SIZE OD2 BY OD2D_SIZE
OD2U = SIZE OD2 BY OD2U_SIZE

NP_NOT_NW = NP NOT NWEL
NLDDN1 = ((NP_NOT_NW NOT OD2D) NOT RHDMY) NOT VARDMY
NLDDN1V = SIZE (SIZE (SIZE NLDDN1 BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2
NLDDN2 = ((NP_NOT_NW AND OD2U) NOT RHDMY) NOT VARDMY
NLDDN2V = SIZE (SIZE (SIZE NLDDN2 BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2

PP_AND_NW = PP AND NWEL
PLDDP1 = ((PP_AND_NW NOT OD2D) NOT RHDMY) NOT VARDMY
PLDDP1V = SIZE (SIZE (SIZE PLDDP1 BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2
PLDDP2 = ((PP_AND_NW AND OD2U) NOT RHDMY) NOT VARDMY
PLDDP2V = SIZE (SIZE (SIZE PLDDP2 BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2

VTC_N = SIZE (SIZE (SIZE (DMSRMi NOT NWELLi) BY LD_SIZE4) BY -LD_SIZE3) BY LD_SIZE4
VTL_N_LD = SIZE (SIZE (SIZE ((OD2 OR NWEL) OR ( VTLN OR LVID )) BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2
VTL_P_LD = SIZE (SIZE (SIZE ((NWEL NOT OD2) NOT ( VTLP OR LVID )) BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2
CHIP_HVTSRM = CHIP INTERACT HVTSRM
VTHNx = VTHN INTERACT CHIP_HVTSRM
VTHPx = VTHP INTERACT CHIP_HVTSRM
VTH_N_LD = SIZE (SIZE (SIZE ((HVTSRM NOT NWEL) OR VTHNx) BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2
VTH_P_LD = SIZE (SIZE (SIZE ((HVTSRM AND NWEL) OR VTHPx) BY LD_SIZE2) BY -LD_SIZE1) BY LD_SIZE2

LDN.EX.1 { @ NP extension on OD2D/NW/RHDMY/VARDMY >= ^LDN_EX_1 um
  A = INT NLDDN1V < LDN_EX_1 ABUT < 90 OPPOSITE REGION
  B = EXT NLDDN1V < LDN_EX_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 LDN_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 LDN_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT NLDDN1V < LDN_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT NLDDN1V < LDN_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT NLDDN1V < LDN_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT NLDDN1V < LDN_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
LDN.O.1 { @ NP overlap of OD2U/NW >= ^LDN_O_1 um
  A = INT NLDDN2V < LDN_O_1 ABUT < 90 OPPOSITE REGION
  B = EXT NLDDN2V < LDN_O_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 LDN_O_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 LDN_O_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT NLDDN2V < LDN_O_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT NLDDN2V < LDN_O_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT NLDDN2V < LDN_O_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT NLDDN2V < LDN_O_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
// LDN.EX.2 is checked by LDN.EX.1

//LDN GUIDELINES
//==============

// LDN.EX.3g is checked by LDN.EX.1
// LDN.EX.4g is checked by LDN.EX.1

//LDP CHECKS
//==========

LDP.EX.1 { @ PP extension on OD2D/RHDMY/VARDMY >= ^LDP_EX_1 um
  A = INT PLDDP1V < LDP_EX_1 ABUT < 90 OPPOSITE REGION
  B = EXT PLDDP1V < LDP_EX_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 LDP_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 LDP_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT PLDDP1V < LDP_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT PLDDP1V < LDP_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT PLDDP1V < LDP_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT PLDDP1V < LDP_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
LDP.O.1 { @ PP overlap of OD2U >= ^LDP_O_1 um
  A = INT PLDDP2V < LDP_O_1 ABUT < 90 OPPOSITE REGION
  B = EXT PLDDP2V < LDP_O_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 LDP_O_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 LDP_O_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT PLDDP2V < LDP_O_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT PLDDP2V < LDP_O_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT PLDDP2V < LDP_O_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT PLDDP2V < LDP_O_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
// LDP.O.2 is checked by LDP.EX.1

//LDP GUIDELINES
//==============

// LDP.EX.3g is checked by LDP.EX.1
// LDP.EX.4g is checked by LDP.EX.1


//VT CHECKS
//=========

#IFDEF GUIDELINE_LDD

VT.S.1g { @ OD2 space to VTL_N >= ^VT_S_1 um
  A = INT VTL_N_LD < VT_S_1 ABUT < 90 OPPOSITE REGION
  B = EXT VTL_N_LD < VT_S_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 VT_S_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 VT_S_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT VTL_N_LD < VT_S_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT VTL_N_LD < VT_S_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTL_N_LD < VT_S_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTL_N_LD < VT_S_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
// VT.S.1.1g is checked by VT.S.1g

// VT.S.2g is checked by VT.S.1g

// VT.S.2.1g is checked by VT.S.1g

// VT.S.3g is checked by VT.EX.2g

VT.S.4g { @ HVTSRM space to VTH_P >= ^VT_S_4 um
  A = INT VTH_P_LD < VT_S_4 ABUT < 90 OPPOSITE REGION
  B = EXT VTH_P_LD < VT_S_4 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 VT_S_4 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 VT_S_4 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT VTH_P_LD < VT_S_4 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT VTH_P_LD < VT_S_4 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTH_P_LD < VT_S_4 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTH_P_LD < VT_S_4 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
VT.EX.1g { @ DMSRM extension on NW >= ^VT_EX_1 um
  A = INT VTC_N < VT_EX_1 ABUT < 90 OPPOSITE REGION
  B = EXT VTC_N < VT_EX_1 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE3 VT_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE3 VT_EX_1 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT VTC_N < VT_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT VTC_N < VT_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTC_N < VT_EX_1 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTC_N < VT_EX_1 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
VT.EX.2g { @ HVTSRM extension on NW >= ^VT_EX_2 um
  A = INT VTH_N_LD < VT_EX_2 ABUT < 90 OPPOSITE REGION
  B = EXT VTH_N_LD < VT_EX_2 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 VT_EX_2 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 VT_EX_2 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT VTH_N_LD < VT_EX_2 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT VTH_N_LD < VT_EX_2 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTH_N_LD < VT_EX_2 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTH_N_LD < VT_EX_2 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
VT.EX.3g { @ NW extension on VTL_P >= ^VT_EX_3 um
  A = INT VTL_P_LD < VT_EX_3 ABUT < 90 OPPOSITE REGION
  B = EXT VTL_P_LD < VT_EX_3 ABUT < 90 OPPOSITE REGION
  (NOT ENCLOSE RECTANGLE A LD_SIZE1 VT_EX_3 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (NOT ENCLOSE RECTANGLE B LD_SIZE1 VT_EX_3 ORTHOGONAL ONLY) NOT INSIDE SRAM_EXCLUDE
  (INT VTL_P_LD < VT_EX_3 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE  
  (INT VTL_P_LD < VT_EX_3 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTL_P_LD < VT_EX_3 ABUT < 90 CORNER SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE 
  (EXT VTL_P_LD < VT_EX_3 ABUT < 90 PROJ == 0 REGION) NOT INSIDE SRAM_EXCLUDE
}
//VT.EX.3.1g is checked by VT.EX.3g
#ENDIF //end of GUIDELINE_LDD


//RPO CHECKS
//==========

NOGT  = (GATE NOT ESD1DMY) NOT ESD2DMY  // Normal gates
FPO1A = (FPO1 NOT ESD1DMY) NOT ESD2DMY

RPO.W.1 { @ Width >= ^RPO_W_1 um
  INT RPO < RPO_W_1 ABUT < 90 SINGULAR REGION
}
RPO.S.1 { @ Space >= ^RPO_S_1 um
  EXT RPO < RPO_S_1 ABUT < 90 SINGULAR REGION
}
RPO.S.2 { @ Space to OD >= ^RPO_S_2 um
  EXT RPO OD < RPO_S_2 ABUT < 90 SINGULAR
}
RPO.S.3 { @ Space to CO [overlap is not allowed] >= ^RPO_S_3 um
  EXT RPO CO < RPO_S_3 ABUT < 90 SINGULAR REGION
  RPO AND CO
}
RPO.S.4 { @ Space to GATE [overlap is not allowed except ESD circuit] >= ^RPO_S_4 um
  RPO AND NOGT
  EXT RPO GATE < RPO_S_4 ABUT < 90 SINGULAR REGION
}
RPO.S.5 { @ Space to PO >= ^RPO_S_5 um
  EXT RPO FPO1 < RPO_S_5 ABUT < 90 SINGULAR REGION
}
RPO.EX.1 { @ Extension on unsilicided OD >= ^RPO_EX_1 um
  ENC OD RPO < RPO_EX_1 ABUT < 90 SINGULAR REGION
}
RPO.EX.2 { @ OD extension on RPO >= ^RPO_EX_2 um
  ENC RPO OD < RPO_EX_2 ABUT < 90 SINGULAR REGION
}
RPO.EX.3 { @ Extension on unsilicided PO >= ^RPO_EX_3 um
  ENC FPO1A RPO < RPO_EX_3 ABUT < 90 SINGULAR REGION
}
RPO.A.1 { @ Area >= ^RPO_A_1 um2
  AREA RPO < RPO_A_1
}

VARIABLE RPO_A_2pre ((RPO_A_2 + (RPO_S_1 * RPO_S_1 * 3.142))/(2 * RPO_S_1))*((RPO_A_2 + (RPO_S_1 * RPO_S_1 * 3.142))/(2 * RPO_S_1))/3.141
RPO.A.2 { @ Enclosed Area >= ^RPO_A_2 um2
  A = HOLES RPO INNER < RPO_A_2pre 
  B = A NOT RPO
  AREA B < RPO_A_2
}  
RPO.R.1.PO { @ Butted NP/PP on unsilicided PO is not allowed
    NX = RPO_PO AND NP
    PX = RPO_PO AND PP    
    Y  = NX INTERACT PX
    RPO_PO INTERACT Y
}  
RPO.R.1.OD { @ Butted NP/PP on unsilicided OD is not allowed
    NX = RPO_OD AND NP
    PX = RPO_OD AND PP    
    Y  = NX INTERACT PX
    RPO_OD INTERACT Y
}  

RES.9g.WARN { @ For unsilicided OD resistor, RHDMY overlap gate is not allow 
  RH_RES = RHDMY NOT OUTSIDE ODPO_RES
  RH_RES AND GATE
  GATE INSIDE RHDMY // RHDMY can not fully cover GATE
}


PORESg = PORES NOT INTERACT SDI
#IFDEF GUIDELINE_RES


RES.2g { @ Recommended width >= ^RES_2G_PO_W um and length >= ^RES_2G_PO_L um for unsilicided PO resistor
  INT PORESg < RES_2G_PO_W ABUT < 90 SINGULAR REGION
  RES_L = PORESg INSIDE EDGE RPO
  X = PATH LENGTH RES_L < RES_2G_PO_L
  CHECK_RES = PORESg WITH EDGE X
  RES_E = CHECK_RES COIN INSIDE EDGE RPO
  A = EXPAND EDGE RES_E INSIDE BY GRID
  B = SIZE A BY (RES_2G_PO_L/2 - GRID*2) INSIDE OF PORESg STEP PO_S_1*0.7  
  C = CHECK_RES NOT B 
  CHECK_RES NOT INTERACT C
  D = INT C < GRID*2 ABUT < 90 REGION
  CHECK_RES INTERACT D
}
RES.3g.OD { @ Recommended width >= ^RES_3G_OD_W um and length >= ^RES_3G_OD_L um for unsilicided OD resistor
  INT ODRES < RES_3G_OD_W ABUT < 90 SINGULAR REGION
  RES_L = ODRES INSIDE EDGE RPO
  X = PATH LENGTH RES_L < RES_3G_OD_L
  CHECK_RES = ODRES WITH EDGE X
  RES_E = CHECK_RES COIN INSIDE EDGE RPO
  A = EXPAND EDGE RES_E INSIDE BY GRID
  B = SIZE A BY (RES_3G_OD_L/2 - GRID*2) INSIDE OF ODRES STEP OD_S_1*0.7  
  C = CHECK_RES NOT B 
  CHECK_RES NOT INTERACT C
  D = INT C < GRID*2 ABUT < 90 REGION
  CHECK_RES INTERACT D
}
RES.3g.PO { @ Recommended width >= ^RES_3G_PO_W um and length >= ^RES_3G_PO_L um for HRI PO resistor
  HREP = PORES INTERACT RHRIDMY
  INT HREP < RES_3G_PO_W ABUT < 90 SINGULAR REGION
  RES_L = HREP INSIDE EDGE RHRIDMY
  X = PATH LENGTH RES_L < RES_3G_PO_L
  CHECK_RES = HREP WITH EDGE X
  RES_E = CHECK_RES COIN INSIDE EDGE RHRIDMY
  A = EXPAND EDGE RES_E INSIDE BY GRID
  B = SIZE A BY (RES_3G_PO_L/2 - GRID*2) INSIDE OF HREP STEP PO_S_1*0.7  
  C = CHECK_RES NOT B 
  CHECK_RES NOT INTERACT C
  D = INT C < GRID*2 ABUT < 90 REGION
  CHECK_RES INTERACT D
}
RES.9g { @ For unsilicided OD resistor in the S/D direction of MOS, RHDMY space to gate >= 0.4um
  RH_RES = RHDMY NOT OUTSIDE ODPO_RES
  EXT RH_RES GATE_W < RES_9G ABUT < 90 REGION
  RH_RES AND GATE
  GATE INSIDE RHDMY // RHDMY can not fully cover GATE
}
RES.10g { @ For unsilicided OD resistor in the S/D of MOS, RHDMY extension on {RPO AND OD} >= 0.20um
  ODRES_SD = ODRES AND SD  
  ENC ODRES_SD RHDMY < RES_10G ABUT < 90 SINGULAR REGION
  ODRES_SD NOT RHDMY
}
#ENDIF

RES.9 { @ RHDMY space to {((PMOS GATE SIZING 0.03) AND PO) SIZING 0.27}(Overlap is not allowed) >= ^RES_9 um
  EXGATE = SIZE ((SIZE GATE_PP BY RES_9_1) AND POLY) BY RES_9
  RHDMY AND EXGATE
}
RES.12 { @ RPO intersecting (PO AND RHDMY) must form two or more POs
  X = PORESg AND RHDMY 
  A = POLY NOT X
  X INTERACT A < 2
  X NOT INTERACT A
}
RES.13 { @ RPO intersecting (OD AND RHDMY) must form two or more ODs
  X = ODRES AND RHDMY 
  A = OD NOT X
  X INTERACT A < 2 
  X NOT INTERACT A
}  


//VARDMY CHECKS
//==========

VAR_GATE = GATE NOT OUTSIDE VARDMY

VAR.W.1 { @ Width (Channel length) of {gate AND VARDMY}	>= ^VAR_W_1 um
  X = GATE_W INSIDE EDGE VARDMY    
  INT X  < VAR_W_1 ABUT < 90 REGION
}
VAR.L.1 { @ Length (Channel width) of {gate AND VARDMY}	>= ^VAR_L_1 um
  X = GATE_L INSIDE EDGE VARDMY  
  INT X  < VAR_L_1 ABUT < 90 REGION
}
VAR.S.1 { @ Space to Active >= ^VAR_S_1 um
  EXT VARDMY DACT < VAR_S_1 ABUT < 90 SINGULAR REGION
}
VAR.EN.1 { @ Enclosure of OD >= ^VAR_EN_1 um
  ENC OD VARDMY < VAR_EN_1 ABUT < 90 SINGULAR REGION
  OD CUT VARDMY
}
VAR.EN.2 { @ Enclosure of {VARDMY AND gate} >= ^VAR_EN_2 um
  X = GATE AND VARDMY
  ENC X VARDMY < VAR_EN_2 ABUT < 90 SINGULAR REGION
  X CUT VARDMY
}
VAR.R.1 { @ VARDMY layer must be drawn to fully cover the varactor devices
  VAR_GATE NOT VARDMY
}
VAR.R.2 { @ Overlap of VTL_N, VTL_P, VTH_N, VTH_P, NT_N,  PW, or RPO is not allowed
  VARDMY AND VTLN
  VARDMY AND VTLP
  VARDMY AND VTHN
  VARDMY AND VTHP
  VARDMY AND NTN
  VARDMY NOT NWEL
  VARDMY AND RPO
}
VAR.R.3 { @ PP overlap of {gate AND VARDMY} is not allowed
  VAR_GATE AND PP
}
VAR.R.4 { @ Overlap of {gate SIZING ^VAR_R_4 um} is not allowed
  VAR_E = SIZE VARDMY BY VAR_W_1 	// For filtering only
  VAR_EXG = (GATE INTERACT VAR_E) OUTSIDE VARDMY
  VAR_EXGS = SIZE VAR_EXG BY VAR_R_4
  VARDMY AND VAR_EXGS
}
VAR.R.5 { @ NP must fully cover {(((VARDMY AND GATE) sizing ^VAR_R_5a ) AND OD) sizing ^VAR_R_5b }
  VAR_GATE_a = SIZE VAR_GATE BY VAR_R_5a  
  VAR_GATE_a_OD_b = SIZE (VAR_GATE_a AND OD) BY VAR_R_5b
  VAR_GATE_a_OD_b NOT NP
}




//NW CHECKS
//=========

#IFDEF SUGGESTED

NW1Vs = NWEL OUTSIDE OD2
NW2Vs = NWEL NOT OUTSIDE OD2

SUGGESTED.NW.S.3 { @ More conservative way to check NW.S.3 as DRC can not determine the
		   @ operating voltages of nwels.
  EXT NW1Vs NW2Vs < NW_S_3 ABUT < 90 > 0 SINGULAR REGION
}
SUGGESTED.NW.S.4 { @ More conservative way to check NW.S.4 as DRC can not determine the
		   @ operating voltages of nwels.
  NW2V_NODALs = STAMP NW2Vs BY NWELLi
  EXT NW2V_NODALs < NW_S_4 ABUT < 90 SPACE NOT CONNECTED SINGULAR REGION
}

#ENDIF

NW.W.1 { @ Width >= ^NW_W_1 um
  (INT NWEL < NW_W_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NW.S.1 { @ Space >= ^NW_S_1 um
  (EXT NWEL < NW_S_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NW.S.2 { @ Space to two NW1V with different potentials >= ^NW_S_2 um
  NW1V_NODAL = STAMP NW1V BY NWELLi
  (EXT NW1V_NODAL < NW_S_2 ABUT < 90 SPACE NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
}
NW.S.3 { @ NW1V space to NW2V with different potentials >= ^NW_S_3 um 
  NW1Vc = STAMP NW1V BY NWELLi 
  NW2Vc = STAMP NW2V BY NWELLi 
  (EXT NW1Vc NW2Vc < NW_S_3 ABUT < 90 > 0 NOT CONNECTED SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE
}
NW.S.4 { @ space of two NW2V with different potentials >= ^NW_S_4 um 
  NW2V_NODAL = STAMP NW2V BY NWELLi
  (EXT NW2V_NODAL < NW_S_4 ABUT < 90 SPACE NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
}

NW.A.1 { @ Area >= ^NW_A_1 um2 
  AREA NWEL < NW_A_1
}
VARIABLE NW_A_2pre ((NW_A_2 + (NW_S_1 * NW_S_1 * 3.142))/(2 * NW_S_1))*((NW_A_2 + (NW_S_1 * NW_S_1 * 3.142))/(2 * NW_S_1))/3.141

NW.A.2 { @ Enclosed area >= ^NW_A_2 um2 
  A = HOLES NWEL INNER < NW_A_2pre
  B = A NOT NWEL
  (AREA B < NW_A_2) NOT INSIDE SRAM_EXCLUDE
}



//NW Resistor CHECKS
//==================

NWROD.W.1 { @ Width >= ^NWROD_W_1 um
  INT RNWEL < NWROD_W_1 ABUT < 90 SINGULAR REGION
}
NWROD.S.1 { @ Space to NWROD or to NW >= ^NWROD_S_1 um 
  EXT RNWEL < NWROD_S_1 ABUT < 90 NOTCH SINGULAR REGION
  EXT RNWEL NWEL < NWROD_S_1 ABUT < 90 SINGULAR REGION
}
NWROD.S.2 { @ Space to RPO >= ^NWROD_S_2 um
  EXT NWRES RPO < NWROD_S_2 ABUT < 90 SINGULAR REGION
}
NWROD.EN.1 { @ Enclosure by OD >= ^NWROD_EN_1 um 
  ENC NWRES ODWR < NWROD_EN_1 ABUT < 90 OVERLAP SINGULAR REGION
}
NWROD.EN.2 { @ Enclose of CO >= ^NWROD_EN_2 um 
  ENC COWR NWRES < NWROD_EN_2 ABUT < 90 OVERLAP SINGULAR REGION
}
NWROD.EX.1 { @ RPO extension on OD >= ^NWROD_EX_1 um 
  ENC ODWR RPO < NWROD_EX_1 ABUT < 90 SINGULAR REGION
  (ODWR INTERACT RPO) OUTSIDE EDGE RPO
}
NWROD.O.1 { @ RPO overlap of NP >= ^NWROD_O_1 um 
  INT NPWR RPO < NWROD_O_1 ABUT < 90 SINGULAR REGION
  X = RPO INTERACT NWRES
  H = HOLES X INNER
  H NOT NPWR
}
NWROD.O.2 { @ {OD AND NWDMY} overlap of PP, NP, VTL_N. VTL_P, VTH_N, VTH_P is not allowed
  NWROD = NWDMY AND OD
  NWROD AND NP
  NWROD AND PP
  NWROD AND VTLN
  NWROD AND VTLP
  NWROD AND VTHN
  NWROD AND VTHP
}

NWROD.R.1 { @ { OD AND NWDMY } interact with DNW is not allow
   X = OD AND NWDMY
   X INTERACT DNW    
}
// For NW under STI (NWRSTI) resistor
NWROD.R.4 { @ Only one NW in NWROD is allowed in one OD
  A = OD INTERACT (RNWEL AND OD) > 1
  RNWEL INTERACT A
}
NWROD.R.5 { @ Only two NP in NWROD is allowed in one OD
  A = OD INTERACT NWRES
  VALID = A INTERACT (NP INTERACT NWRES) == 2
  NP INTERACT (A NOT INTERACT VALID)
}
NWROD.R.6 { @ Only two RPO hole (Salicide) in NWROD is allowed in same OD
  A = OD INTERACT NWRES
  VALID = A INTERACT (HOLES RPO) == 2
  RPO INTERACT (A NOT INTERACT VALID)
}
NWROD.R.7 { @ For U-shape or S-shape NWROD, both OD and NW must be U-shape or S-shape and the OD edge must be parallel to the NW edge. 
            @ DRC can only flag the pattern without OD space while 2 edges of NW [NW space or notch <= 5 um] parallel length > 0 um.
  ((EXT NWRES <= NWROD_R_7 NOTCH OPPOSITE REGION) NOT RNWEL) INSIDE OD
}

ODWR_STI  = OD      INTERACT NWRES_STI
NPWR_STI  = NP      INTERACT NWRES_STI

// NWRSTI.W.1 is checked by NWROD.W.1
// NWRSTI.S.1 is checked by NWROD.S.1

NWRSTI.EN.3 { @ NP enclosure of OD >= ^NWRSTI_EN_3 um
  ENC ODWR_STI NPWR_STI < NWRSTI_EN_3 ABUT < 90 SINGULAR REGION
  ODWR_STI NOT NPWR_STI
}


//DNW CHECKS
//==========

DNW.W.1 { @ Width >= ^DNW_W_1 um
  (INT DNW < DNW_W_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
DNW.S.1 { @ Space >= ^DNW_S_1 um
  (EXT DNW < DNW_S_1 ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}
DNW.S.2 { @ Space to NW with different potential >= ^DNW_S_2 um
    (EXT DNW NWEL < DNW_S_2  ABUT <90 NOT CONNECTED SINGULAR REGION MEASURE ALL) NOT INSIDE EXCL_SRM
}

RW = PWEL INSIDE DNW
RW1V = RW NOT INTERACT OD2
RW2V = RW INTERACT OD2
RW1V_NODAL = STAMP RW1V BY RWi
RW2V_NODAL = STAMP RW2V BY RWi
PWEL_NODAL = STAMP PWEL BY PWELi

DNW.S.3 { @ RW space to { RW or PW } with different potential >= ^DNW_S_3 um
  (EXT RW1V_NODAL < DNW_S_3 ABUT < 90 NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
  (EXT RW1V_NODAL PWEL_NODAL < DNW_S_3 ABUT < 90 NOT CONNECTED SINGULAR REGION ) NOT INSIDE EXCL_SRM    
}

DNW.S.4 { @ { RW OR PW } space to {RW interact OD2 } with different potential >= ^DNW_S_4 um	
  (EXT RW2V_NODAL < DNW_S_4 ABUT < 90 NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
  (EXT RW2V_NODAL RW1V_NODAL < DNW_S_4 ABUT <90 NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
  (EXT RW2V_NODAL PWEL_NODAL < DNW_S_4 ABUT < 90 NOT CONNECTED SINGULAR REGION) NOT INSIDE EXCL_SRM
}

DNW.S.5 { @ Space to N+ACTIVE(DNW cut N+ACTIVE is not allowed) >= ^DNW_S_5 um
  A = NACT OUTSIDE DNW
  ( EXT DNW A < DNW_S_5 ABUT < 90 SINGULAR REGION ) NOT INSIDE EXCL_SRM
  NACT CUT DNW
}

DNW.O.1 { @ Overlap of NW >= ^DNW_O_1 um 
  (INT DNW NWEL < DNW_O_1  ABUT < 90 SINGULAR REGION) NOT INSIDE EXCL_SRM
}

// DNW.R.2 can not be checked by drc
// DNW.R.4 can not be checked by drc



#ENDIF  //FRONT_END


//CO CHECKS
//=========

PSTP_NACT_BTE  = PSTP COIN OUTSIDE EDGE NACT     
NACT_PSTP_BTE  = NACT COIN OUTSIDE EDGE PSTP
NSTP_PACT_BTE  = NSTP COIN OUTSIDE EDGE PACT
PACT_NSTP_BTE  = PACT COIN OUTSIDE EDGE NSTP     

CO.W.1 { @ Width (square) (maximum = minimum) == ^CO_W_1 um
  A = NOT RECTANGLE CO == CO_W_1 BY == CO_W_1 ORTHOGONAL ONLY
  (A NOT VIA_EXD) NOT SR_M1
}
#IFDEF LmarkSealringCorner
CO.W.2 { @ Width of CO bar. CO bar is only allowed in seal ring >= ^CO_W_2 um
   INT SR_CO < CO_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY
   A = SIZE SR_CO BY (CO_W_2 / 2 + 0.005) UNDEROVER TRUNCATE (CO_W_2 / 2 + 0.005)
   ENCLOSE RECTANGLE A 1 0.005 
}
#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
#ELSE  //HALF_NODE
CO.W.2 { @ Width of CO bar. CO bar is only allowed in seal ring >= ^CO_W_2 um
   INT SR_CO < CO_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY
   SIZE SR_CO BY (CO_W_2 / 2 + 0.005) UNDEROVER TRUNCATE (CO_W_2 / 2 + 0.005)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
CO.W.2 { @ Width of CO bar. CO bar is only allowed in seal ring >= ^CO_W_2 um
   INT SR_CO < CO_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY
   SIZE SR_CO BY (CO_W_2 / 2 + 0.005) UNDEROVER TRUNCATE (CO_W_2 / 2 + 0.005)
}
#ENDIF  //UTM
#ENDIF //LmarkSealringCorner
CO.S.1 { @ Space >= ^CO_S_1 um
  EXT CO < CO_S_1 ABUT < 90 SINGULAR REGION
}
CO.S.2 { @ Space in CO array [CO number >= 4x4 (row and column >= 4) with space <= ^CO_S_2_1 um] >= ^CO_S_2 um 
  COMerge = SIZE CO BY CO_S_2_1 / 2 OVERUNDER  // space <= CO_S_2_1 um treated as array
  // ( ( 4 - 1 ) * CO_W_1 + ( 4 - 2 ) * CO_S_2_1 ) / 2 ) = MinArray
  MinArray = SIZE COMerge BY ( ( 4 - 1 ) * CO_W_1 + ( 4 - 2 ) * CO_S_2_1 ) / 2 UNDEROVER
  // get array larger than or equal to 4 x 4 
  COArray = MinArray INTERACT CO >= 4 * 4
  COInArray = CO INTERACT COArray
  EXT COInArray < CO_S_2 ABUT < 90 REGION
}

CO.S.3 { @ {CO inside OD} space to 1.0V, 1.2V, 1.5V,or 2.5V GATE >= ^CO_S_3 um
  EXT COOD GATE < CO_S_3 ABUT < 90 INSIDE ALSO SINGULAR REGION
}
#IFDEF 3.3V
CO.S.4 { @ {CO inside OD} space to 3.3V GATE >= ^CO_S_4 um
  EXT COOD HV_GATE < CO_S_4 ABUT < 90 INSIDE ALSO SINGULAR REGION
}
#ENDIF


CO.S.5 { @ {CO inside PO} space to OD >= ^CO_S_5 um 
  EXT COPO OD < CO_S_5 ABUT < 90 INSIDE ALSO SINGULAR REGION
}
CO.EN.1 { @ Enclosure by ACTIVE >= ^CO_EN_1 um 
  ENC COOD DACT < CO_EN_1 ABUT < 90 SINGULAR REGION
}
CO.EN.2 { @ Enclosure by PO >= ^CO_EN_2 um 
  ENC COPO POLY < CO_EN_2 ABUT < 90 SINGULAR REGION
}
CO.EN.3 { @ Enclosure by butted PP on OD >= ^CO_EN_3 um
  EXT NACT_PSTP_BTE COOD < CO_EN_3 ABUT < 90 REGION
  EXT NSTP_PACT_BTE COOD < CO_EN_3 ABUT < 90 REGION
  COOD CUT PP
  ENC COOD PP < 0.001 ABUT < 90 SINGULAR REGION
}
CO.EN.4 { @ Enclosure by butted NP on OD >= ^CO_EN_4 um
  EXT PACT_NSTP_BTE COOD < CO_EN_4 ABUT < 90 REGION
  EXT PSTP_NACT_BTE COOD < CO_EN_4 ABUT < 90 REGION
  COOD CUT NP
  ENC COOD NP < 0.001 ABUT < 90 SINGULAR
}
CO.EN.5 { @ Enclosure by STRAP >= ^CO_EN_5 um 
  ENC COOD DSTP < CO_EN_5 ABUT < 90 SINGULAR REGION
}

// CO.R.1 is checked by CO.S.3, CO.S.5
// CO.R.2 is checked by RPO.S.3
// CO.R.3 is checked by CO.W.1

CO.R.6 { @ {CO outside OD} or {CO outside PO} is not allowed
  (CO NOT ODi) NOT POLYGi
}

#IFDEF BACK_END

//BACKEND RULES 
//=============

//M1 CHECKS
//=========
M1_EDGE_45  = M1 ANGLE == 45
M1_EDGE_45L = LENGTH M1_EDGE_45 >= M1_W_2_L
M1.W.1 { @ Width >= ^M1_W_1 um
  (INT M1 < M1_W_1 ABUT < 90 SINGULAR REGION) NOT INSIDE SRAM_EXCLUDE
}
M1.W.2 { @ Width of 45 degree bent M1 (with length >= ^M1_W_2_L um) >= ^M1_W_2 um
  INT M1_EDGE_45L < M1_W_2 ABUT < 90 REGION
}
M1.S.1 { @ Space >= ^M1_S_1 um
  EXT M1 < M1_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M1.S.2 { @ Space to wide M1 (both metal line width and length > 11 um) or wide M1 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M1 >= ^M1_S_2 um
  M1_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M1Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M1_G5.5 = GROW (GROW (GROW (GROW M1_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M1_Wide = M1_G5.5 AND M1
  M1_Exp = SIZE M1_Wide BY M1_S_2_B INSIDE OF M1 STEP M1_S_1 * 0.7
  M1_Branch = M1_Exp NOT M1_Wide
  M1_Branch_edge = M1_Branch COIN INSIDE EDGE M1
  M1_Check = M1 AND (SIZE M1_Exp BY M1_S_2)
  M1_Branch_Check = M1 AND (EXPAND EDGE M1_Branch_edge OUTSIDE BY M1_S_2 CORNER FILL)
  M1_WideC = STAMP M1_Wide BY M1x
  M1_CheckC = STAMP M1_Check BY M1x
  M1_BranchC = STAMP M1_Branch BY M1x
  M1_Branch_CheckC = STAMP M1_Branch_Check BY M1x
  EXT M1_WideC M1_CheckC < M1_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M1_BranchC M1_Branch_CheckC < M1_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M1.S.2 { @ Space to wide M1 (both metal line width and length > 10 um) or wide M1 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M1 >= ^M1_S_2 um
  M1_S5 = SHRINK (SHRINK (SHRINK (SHRINK M1Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M1_G5 = GROW (GROW (GROW (GROW M1_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M1_Wide = M1_G5 AND M1
  M1_Exp = SIZE M1_Wide BY M1_S_2_B INSIDE OF M1 STEP M1_S_1 * 0.7
  M1_Branch = M1_Exp NOT M1_Wide
  M1_Branch_edge = M1_Branch COIN INSIDE EDGE M1
  M1_Check = M1 AND (SIZE M1_Exp BY M1_S_2)
  M1_Branch_Check = M1 AND (EXPAND EDGE M1_Branch_edge OUTSIDE BY M1_S_2 CORNER FILL)
  M1_WideC = STAMP M1_Wide BY M1x
  M1_CheckC = STAMP M1_Check BY M1x
  M1_BranchC = STAMP M1_Branch BY M1x
  M1_Branch_CheckC = STAMP M1_Branch_Check BY M1x
  EXT M1_WideC M1_CheckC < M1_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M1_BranchC M1_Branch_CheckC < M1_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M1WideS3 = COPY M1Wide0.33
#ELSE
M1WideS3 = COPY M1Wide0.3
#ENDIF
M1.S.3 { @ Space [for at least one metal line width >= ^M1_S_3_W um and
         @ the parallel metal run length >= ^M1_S_3_L um] >= ^M1_S_3 um
  X = EXT M1WideS3 M1 < M1_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M1_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M1WideS3
  PATH LENGTH WideEdge >= M1_S_3_L
}

M1.S.4 { @ Space to 45 degree bent M1 (with length >= ^M1_W_2_L um) >= ^M1_S_4 um
  X = EXPAND EDGE M1_EDGE_45L OUTSIDE BY M1_S_4
  X AND M1
}
M1.EN.1 { @ Enclosure of CO >= ^M1_EN_1 um
  CO NOT M1
}

M1.EN.2 { @ Enclosure of CO [at least two opposite sides] >= ^M1_EN_2 um 
  X = RECTANGLE ENCLOSURE CO M1 ABUT < 90 GOOD M1_EN_1 M1_EN_2 OPPOSITE M1_EN_1 M1_EN_2 OPPOSITE
  Y = ENC [X] M1 < M1_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < CO_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M1.A.1 { @ Area >= ^M1_A_1 um2
  AREA M1 < M1_A_1
}
VARIABLE M1_A_2pre ((M1_A_2 + (M1_S_1 * M1_S_1 * 3.142))/(2 * M1_S_1))*((M1_A_2 + (M1_S_1 * M1_S_1 * 3.142))/(2 * M1_S_1))/3.141

M1.A.2 { @ Enclosed area >= ^M1_A_2 um2 
  M1HO = HOLES M1 INNER < M1_A_2pre
  M1HOC = M1HO NOT M1
  (AREA M1HOC < M1_A_2) NOT INSIDE SRAM_EXCLUDE
}




//VIA1 CHECKS
//===========

VIA1.W.1 { @ Width (square) (maximum == minimum) == ^VIA1_W_1 um
  A = NOT RECTANGLE VIA1 == VIA1_W_1 BY == VIA1_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA1.W.2 { @ Width of VIA1 bar. VIA1 bar is only allowed in seal ring and fuse protection ring.
           @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	   @ is a must if VIAx bar is used >= ^VIA1_W_2 um
  INT SR_V1 < VIA1_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V1 BY (VIA1_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA1_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA1.W.2 { @ Width of VIA1 bar. VIA1 bar is only allowed in seal ring and fuse protection ring.
           @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	   @ is a must if VIAx bar is used >= ^VIA1_W_2 um
  INT SR_V1 < VIA1_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V1 BY (VIA1_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA1_W_2 / 2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}
#ELSE  //HALF_NODE
VIA1.W.2 { @ Width of VIA1 bar. VIA1 bar is only allowed in seal ring and fuse protection ring.
           @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	   @ is a must if VIAx bar is used >= ^VIA1_W_2 um
  INT SR_V1 < VIA1_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V1 BY (VIA1_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA1_W_2 / 2 + GRID)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA1.W.2 { @ Width of VIA1 bar. VIA1 bar is only allowed in seal ring and fuse protection ring.
           @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	   @ is a must if VIAx bar is used >= ^VIA1_W_2 um
  INT SR_V1 < VIA1_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V1 BY (VIA1_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA1_W_2 / 2 + GRID)
}
#ENDIF  //UTM
#ENDIF  //LmarkSealringCorner


VIA1.S.1 { @ Space >= ^VIA1_S_1 um 
  EXT VIA1 < VIA1_S_1 ABUT < 90 SINGULAR REGION
}
VIA1.S.2 { @ Space in VIA1 array [VIA1 number >= 3x3(row and column >= 3) with space <= ^VIA1_S_2_S um ] >= ^VIA1_S_2 um 
  VIA1Merge = SIZE VIA1 BY VIA1_S_2_S / 2 OVERUNDER  // space <= VIA1_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA1_W_1 + ( 3 - 2 ) * VIA1_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA1Merge BY ( ( 3 - 1 ) * VIA1_W_1 + ( 3 - 2 ) * VIA1_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA1Array = MinArray INTERACT VIA1 >= 3 * 3
  VIA1InArray = VIA1 INTERACT VIA1Array
  EXT VIA1InArray < VIA1_S_2 ABUT < 90 REGION
}
VIA1.EN.1 { @ Enclosure by M1 >= ^VIA1_EN_1 um 
  ENC VIA1 M1 < VIA1_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
VIA1.EN.2 { @ Enclosure by M1 [at least two opposite sides] >= ^VIA1_EN_2 um 
  X = RECTANGLE ENCLOSURE VIA1 M1 ABUT < 90 GOOD VIA1_EN_1 VIA1_EN_2 OPPOSITE VIA1_EN_1 VIA1_EN_2 OPPOSITE
  Y = ENC [X] M1 < VIA1_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA1_W_1 ABUT == 90 INTERSECTING ONLY // adjacent narrow sides
}
// VIA1.R.1 is checked by VIA1.W.1

#IFNDEF LK
#IFDEF HALF_NODE
M1WideR2_1 = COPY M1Wide1.54
M2WideR2_2 = COPY M2Wide1.54
#ELSE
M1WideR2_1 = COPY M1Wide1.4
M2WideR2_2 = COPY M2Wide1.4
#ENDIF
VIA1.R.2_FSG { @ When M1 or M2 width > ^VIAx_R_2_FSG_W um, more than 1 VIA1 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um

  M2OvpM1W = (M2 AND M1WideR2_1) OR (M1 AND M2WideR2_2)
  M1_has_wm_ovp  = METAL1i  INTERACT M2OvpM1W
  M2_has_wm_ovp = METAL2i INTERACT M2OvpM1W
  MOvp = M1_has_wm_ovp AND M2_has_wm_ovp 
  VIA_EXC = VIA1 NOT VIA_EXD
  M1M2Wide = M1WideR2_1 OR M2WideR2_2
  OvpOnM1M2W = MOvp NOT OUTSIDE M1M2Wide
  VIA_CheckM1 = VIA_EXC INTERACT OvpOnM1M2W
  
  Merge1OnM1M2W = SIZE VIA_CheckM1 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM1M2W STEP (0.21*0.7)
  badRegion1  = Merge1OnM1M2W INTERACT VIA_CheckM1 < 2
  GoodRegion1 = Merge1OnM1M2W OUTSIDE badRegion1
  Merge2OnM1M2W = SIZE Merge1OnM1M2W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM1M2W STEP (0.21*0.7)
  badRegion2  = Merge2OnM1M2W INTERACT VIA_CheckM1 < 4
  GoodRegion2 = Merge2OnM1M2W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM1 INTERACT GoodRegion) NOT OUTSIDE M1M2Wide
  M1M2Check = (M1M2Wide AND OvpOnM1M2W) NOT INTERACT GoodVIA
  VIA_CheckM1 NOT OUTSIDE M1M2Check 
} 
#ENDIF  // LK


//M2 CHECKS
//=========
M2_EDGE_45 = M2 ANGLE == 45
M2_EDGE_45L = LENGTH M2_EDGE_45 >= M2_W_2_L
M2.W.1 { @ Width >= ^M2_W_1 um
  INT M2 < M2_W_1 ABUT < 90 SINGULAR REGION
}
M2.W.2 { @ Width of 45 degree bent M2 (with length >= ^M2_W_2_L um) >= ^M2_W_2 um
  INT M2_EDGE_45L < M2_W_2 ABUT < 90 REGION
}
M2.S.1 { @ Space >= ^M2_S_1 um
  EXT M2 < M2_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M2.S.2 { @ Space to wide M2 (both metal line width and length > 11 um) or wide M2 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M2 >= ^M2_S_2 um
  M2_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M2Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M2_G5.5 = GROW (GROW (GROW (GROW M2_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M2_Wide = M2_G5.5 AND M2
  M2_Exp = SIZE M2_Wide BY M2_S_2_B INSIDE OF M2 STEP M2_S_1 * 0.7
  M2_Branch = M2_Exp NOT M2_Wide
  M2_Branch_edge = M2_Branch COIN INSIDE EDGE M2
  M2_Check = M2 AND (SIZE M2_Exp BY M2_S_2)
  M2_Branch_Check = M2 AND (EXPAND EDGE M2_Branch_edge OUTSIDE BY M2_S_2 CORNER FILL)
  M2_WideC = STAMP M2_Wide BY M2x
  M2_CheckC = STAMP M2_Check BY M2x
  M2_BranchC = STAMP M2_Branch BY M2x
  M2_Branch_CheckC = STAMP M2_Branch_Check BY M2x
  EXT M2_WideC M2_CheckC < M2_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M2_BranchC M2_Branch_CheckC < M2_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M2.S.2 { @ Space to wide M2 (both metal line width and length > 10 um) or wide M2 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M2 >= ^M2_S_2 um
  M2_S5 = SHRINK (SHRINK (SHRINK (SHRINK M2Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M2_G5 = GROW (GROW (GROW (GROW M2_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M2_Wide = M2_G5 AND M2
  M2_Exp = SIZE M2_Wide BY M2_S_2_B INSIDE OF M2 STEP M2_S_1 * 0.7
  M2_Branch = M2_Exp NOT M2_Wide
  M2_Branch_edge = M2_Branch COIN INSIDE EDGE M2
  M2_Check = M2 AND (SIZE M2_Exp BY M2_S_2)
  M2_Branch_Check = M2 AND (EXPAND EDGE M2_Branch_edge OUTSIDE BY M2_S_2 CORNER FILL)
  M2_WideC = STAMP M2_Wide BY M2x
  M2_CheckC = STAMP M2_Check BY M2x
  M2_BranchC = STAMP M2_Branch BY M2x
  M2_Branch_CheckC = STAMP M2_Branch_Check BY M2x
  EXT M2_WideC M2_CheckC < M2_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M2_BranchC M2_Branch_CheckC < M2_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M2WideS3 = COPY M2Wide0.43
#ELSE
M2WideS3 = COPY M2Wide0.4
#ENDIF
M2.S.3 { @ Space [for at least one metal line width >= ^M2_S_3_W um and
         @ the parallel metal run length >= ^M2_S_3_L um] >= ^M2_S_3 um
  X = EXT M2WideS3 M2 < M2_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M2_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M2WideS3
  PATH LENGTH WideEdge >= M2_S_3_L
}
M2.S.4 { @ Space to 45 degree bent M2 (with length >= ^M2_W_2_L um) >= ^M2_S_4 um
  X = EXPAND EDGE M2_EDGE_45L OUTSIDE BY M2_S_4
  X AND M2
}
M2.EN.1 { @ Enclosure of VIA1 >= ^M2_EN_1 um
  ENC VIA1 M2 < M2_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M2.EN.2 { @ Enclosure of VIA1 [at least two opposite sides] >= ^M2_EN_2 um
  X = RECTANGLE ENCLOSURE VIA1 M2 ABUT < 90 GOOD M2_EN_1 M2_EN_2 OPPOSITE M2_EN_1 M2_EN_2 OPPOSITE
  Y = ENC [X] M2 < M2_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA1_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M2.A.1 { @ Area >= ^M2_A_1 um2
  AREA M2 < M2_A_1
}

VARIABLE M2_A_2pre ((M2_A_2 + (M2_S_1 * M2_S_1 * 3.142))/(2 * M2_S_1))*((M2_A_2 + (M2_S_1 * M2_S_1 * 3.142))/(2 * M2_S_1))/3.141

M2.A.2 { @ Enclosed area >= ^M2_A_2 um2 
  M2HO = HOLES M2 INNER < M2_A_2pre
  M2HOC = M2HO NOT M2
  (AREA M2HOC < M2_A_2) NOT INSIDE SRAM_EXCLUDE
}

M2.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M2_S_5_W um, and the projection length > ^M2_S_5_W um]
	 @ >= ^M2_S_5 um
  M2OverlapBig = (SIZE M2Overlap BY M2_S_5_W/2 UNDEROVER TRUNCATE M2_S_5_W/2) AND M2Overlap
  W = EXT M2OverlapBig M2Overlap < M2_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M1
  Y = X NOT INSIDE M2
  Y1 = Y NOT INSIDE M3
  ENCLOSE RECTANGLE Y1 GRID (M2_S_5_W + GRID)
}


//VIA2 CHECKS
//===========

VIA2.W.1 { @ Width (square) (maximum == minimum) == ^VIA2_W_1 um
  A = NOT RECTANGLE VIA2 == VIA2_W_1 BY == VIA2_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA2.W.2 { @ Width of VIA2 bar. VIA2 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA2_W_2 um
  INT SR_V2 < VIA2_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V2 BY (VIA2_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA2_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA2.W.2 { @ Width of VIA2 bar. VIA2 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA2_W_2 um
  INT SR_V2 < VIA2_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V2 BY (VIA2_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA2_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}
#ELSE  //HALF_NODE
VIA2.W.2 { @ Width of VIA2 bar. VIA2 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA2_W_2 um
  INT SR_V2 < VIA2_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V2 BY (VIA2_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA2_W_2 / 2 + GRID)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA2.W.2 { @ Width of VIA2 bar. VIA2 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA2_W_2 um
  INT SR_V2 < VIA2_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V2 BY (VIA2_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA2_W_2 / 2 + GRID)
}
#ENDIF  //UTM
#ENDIF // LmarkSealringCorner


VIA2.S.1 { @ Space >= ^VIA2_S_1 um 
  EXT VIA2 < VIA2_S_1 ABUT < 90 SINGULAR REGION
}
VIA2.S.2 { @ Space in VIA2 array [VIA2 number >= 3x3(row and column >= 3) with space <= ^VIA2_S_2_S um ] >= ^VIA2_S_2 um 
  VIA2Merge = SIZE VIA2 BY VIA2_S_2_S / 2 OVERUNDER  // space <= VIA2_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA2_W_1 + ( 3 - 2 ) * VIA2_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA2Merge BY ( ( 3 - 1 ) * VIA2_W_1 + ( 3 - 2 ) * VIA2_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA2Array = MinArray INTERACT VIA2 >= 3 * 3
  VIA2InArray = VIA2 INTERACT VIA2Array
  EXT VIA2InArray < VIA2_S_2 ABUT < 90 REGION
}
VIA2.EN.1 { @ Enclosure by M2 >= ^VIA2_EN_1 um 
  ENC VIA2 M2 < VIA2_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}

VIA2.EN.2 { @ Enclosure by M2 [at least two opposite sides] >= ^VIA2_EN_2 um
  X = RECTANGLE ENCLOSURE VIA2 M2 ABUT < 90 GOOD VIA2_EN_1 VIA2_EN_2 OPPOSITE VIA2_EN_1 VIA2_EN_2 OPPOSITE
  Y = ENC [X] M2 < VIA2_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA2_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

// VIA2.R.1 is checked by VIA2.W.1
#IFNDEF LK
#IFDEF HALF_NODE
M2WideR2_1 = COPY M2Wide1.54
M3WideR2_2 = COPY M3Wide1.54
#ELSE
M2WideR2_1 = COPY M2Wide1.4
M3WideR2_2 = COPY M3Wide1.4
#ENDIF
VIA2.R.2_FSG { @ When M2 or M3 width > ^VIAx_R_2_FSG_W um, more than 1 VIA2 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um
  M3OvpM2W = (M3 AND M2WideR2_1) OR (M2 AND M3WideR2_2)
  M2_has_wm_ovp  = METAL2i  INTERACT M3OvpM2W
  M3_has_wm_ovp = METAL3i INTERACT M3OvpM2W
  MOvp = M2_has_wm_ovp AND M3_has_wm_ovp 
  VIA_EXC = VIA2 NOT VIA_EXD
  M2M3Wide = M2WideR2_1 OR M3WideR2_2
  OvpOnM2M3W = MOvp NOT OUTSIDE M2M3Wide
  VIA_CheckM2 = VIA_EXC INTERACT OvpOnM2M3W
  
  Merge1OnM2M3W = SIZE VIA_CheckM2 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM2M3W STEP (0.21*0.7)
  badRegion1  = Merge1OnM2M3W INTERACT VIA_CheckM2 < 2
  GoodRegion1 = Merge1OnM2M3W OUTSIDE badRegion1
  Merge2OnM2M3W = SIZE Merge1OnM2M3W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM2M3W STEP (0.21*0.7)
  badRegion2  = Merge2OnM2M3W INTERACT VIA_CheckM2 < 4
  GoodRegion2 = Merge2OnM2M3W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM2 INTERACT GoodRegion) NOT OUTSIDE M2M3Wide
  M2M3Check = (M2M3Wide AND OvpOnM2M3W) NOT INTERACT GoodVIA
  VIA_CheckM2 NOT OUTSIDE M2M3Check 
}
#ENDIF  // LK

//M3 CHECKS
//=========
M3_EDGE_45 = M3 ANGLE == 45
M3_EDGE_45L = LENGTH M3_EDGE_45 >= M3_W_2_L
M3.W.1 { @ Width >= ^M3_W_1 um
  INT M3 < M3_W_1 ABUT < 90 SINGULAR REGION
}
M3.W.2 { @ Width of 45 degree bent M3 (with length >= ^M3_W_2_L um) >= ^M3_W_2 um
  INT M3_EDGE_45L < M3_W_2 ABUT < 90 REGION
}
M3.S.1 { @ Space >= ^M3_S_1 um
  EXT M3 < M3_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M3.S.2 { @ Space to wide M3 (both metal line width and length > 11 um) or wide M3 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M3 >= ^M3_S_2 um
  M3_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M3Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M3_G5.5 = GROW (GROW (GROW (GROW M3_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M3_Wide = M3_G5.5 AND M3
  M3_Exp = SIZE M3_Wide BY M3_S_2_B INSIDE OF M3 STEP M3_S_1 * 0.7
  M3_Branch = M3_Exp NOT M3_Wide
  M3_Branch_edge = M3_Branch COIN INSIDE EDGE M3
  M3_Check = M3 AND (SIZE M3_Exp BY M3_S_2)
  M3_Branch_Check = M3 AND (EXPAND EDGE M3_Branch_edge OUTSIDE BY M3_S_2 CORNER FILL)
  M3_WideC = STAMP M3_Wide BY M3x
  M3_CheckC = STAMP M3_Check BY M3x
  M3_BranchC = STAMP M3_Branch BY M3x
  M3_Branch_CheckC = STAMP M3_Branch_Check BY M3x
  EXT M3_WideC M3_CheckC < M3_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M3_BranchC M3_Branch_CheckC < M3_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M3.S.2 { @ Space to wide M3 (both metal line width and length > 10 um) or wide M3 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M3 >= ^M3_S_2 um
  M3_S5 = SHRINK (SHRINK (SHRINK (SHRINK M3Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M3_G5 = GROW (GROW (GROW (GROW M3_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M3_Wide = M3_G5 AND M3
  M3_Exp = SIZE M3_Wide BY M3_S_2_B INSIDE OF M3 STEP M3_S_1 * 0.7
  M3_Branch = M3_Exp NOT M3_Wide
  M3_Branch_edge = M3_Branch COIN INSIDE EDGE M3
  M3_Check = M3 AND (SIZE M3_Exp BY M3_S_2)
  M3_Branch_Check = M3 AND (EXPAND EDGE M3_Branch_edge OUTSIDE BY M3_S_2 CORNER FILL)
  M3_WideC = STAMP M3_Wide BY M3x
  M3_CheckC = STAMP M3_Check BY M3x
  M3_BranchC = STAMP M3_Branch BY M3x
  M3_Branch_CheckC = STAMP M3_Branch_Check BY M3x
  EXT M3_WideC M3_CheckC < M3_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M3_BranchC M3_Branch_CheckC < M3_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M3WideS3 = COPY M3Wide0.43
#ELSE
M3WideS3 = COPY M3Wide0.4
#ENDIF
M3.S.3 { @ Space [for at least one metal line width >= ^M3_S_3_W um and
         @ the parallel metal run length >= ^M3_S_3_L um] >= ^M3_S_3 um
  X = EXT M3WideS3 M3 < M3_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M3_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M3WideS3
  PATH LENGTH WideEdge >= M3_S_3_L
}
M3.S.4 { @ Space to 45 degree bent M3 (with length >= ^M3_W_2_L um) >= ^M3_S_4 um
  X = EXPAND EDGE M3_EDGE_45L OUTSIDE BY M3_S_4
  X AND M3
}
M3.EN.1 { @ Enclosure of VIA2 >= ^M3_EN_1 um
  ENC VIA2 M3 < M3_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M3.EN.2 { @ Enclosure of VIA2 [at least two opposite sides] >= ^M3_EN_2 um
  X = RECTANGLE ENCLOSURE VIA2 M3 ABUT < 90 GOOD M3_EN_1 M3_EN_2 OPPOSITE M3_EN_1 M3_EN_2 OPPOSITE
  Y = ENC [X] M3 < M3_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA2_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M3.A.1 { @ Area >= ^M3_A_1 um2
  AREA M3 < M3_A_1
}

VARIABLE M3_A_2pre ((M3_A_2 + (M3_S_1 * M3_S_1 * 3.142))/(2 * M3_S_1))*((M3_A_2 + (M3_S_1 * M3_S_1 * 3.142))/(2 * M3_S_1))/3.141

M3.A.2 { @ Enclosed area >= ^M3_A_2 um2 
  M3HO = HOLES M3 INNER < M3_A_2pre
  M3HOC = M3HO NOT M3
  (AREA M3HOC < M3_A_2) NOT INSIDE SRAM_EXCLUDE
}

M3.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M3_S_5_W um, and the projection length > ^M3_S_5_W um]
	 @ >= ^M3_S_5 um
  M3OverlapBig = (SIZE M3Overlap BY M3_S_5_W/2 UNDEROVER TRUNCATE M3_S_5_W/2) AND M3Overlap
  W = EXT M3OverlapBig M3Overlap < M3_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M2
  Y = X NOT INSIDE M3
  Y1 = Y NOT INSIDE M4
  ENCLOSE RECTANGLE Y1 GRID (M3_S_5_W + GRID)
}


//VIA3 CHECKS
//===========

VIA3.W.1 { @ Width (square) (maximum == minimum) == ^VIA3_W_1 um
  A = NOT RECTANGLE VIA3 == VIA3_W_1 BY == VIA3_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA3.W.2 { @ Width of VIA3 bar. VIA3 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA3_W_2 um
  INT SR_V3 < VIA3_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V3 BY (VIA3_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA3_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}

#ELSE  //LmarkSealringCorner
#IFDEF UTM
#IFDEF HALF_NODE
VIA3.W.2 { @ Width of VIA3 bar. VIA3 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA3_W_2 um
  INT SR_V3 < VIA3_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  A = SIZE SR_V3 BY (VIA3_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA3_W_2 /2 + GRID)
  ENCLOSE RECTANGLE A 1 GRID
}
#ELSE  //HALF_NODE
VIA3.W.2 { @ Width of VIA3 bar. VIA3 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA3_W_2 um
  INT SR_V3 < VIA3_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V3 BY (VIA3_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA3_W_2 / 2 + GRID)
}
#ENDIF  //HALF_NODE
#ELSE  //UTM
VIA3.W.2 { @ Width of VIA3 bar. VIA3 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA3_W_2 um
  INT SR_V3 < VIA3_W_2 ABUT < 90 OPPOSITE PARALLEL ONLY REGION
  SIZE SR_V3 BY (VIA3_W_2 / 2 + GRID) UNDEROVER TRUNCATE (VIA3_W_2 / 2 + GRID)
}
#ENDIF  //UTM
#ENDIF // LmarkSealringCorner


VIA3.S.1 { @ Space >= ^VIA3_S_1 um 
  EXT VIA3 < VIA3_S_1 ABUT < 90 SINGULAR REGION
}
VIA3.S.2 { @ Space in VIA3 array [VIA3 number >= 3x3(row and column >= 3) with space <= ^VIA3_S_2_S um ] >= ^VIA3_S_2 um 
  VIA3Merge = SIZE VIA3 BY VIA3_S_2_S / 2 OVERUNDER  // space <= VIA3_S_2_S um treated as array
  // ( ( 3 - 1 ) * VIA3_W_1 + ( 3 - 2 ) * VIA3_S_2_S ) / 2 ) = MinArray
  MinArray = SIZE VIA3Merge BY ( ( 3 - 1 ) * VIA3_W_1 + ( 3 - 2 ) * VIA3_S_2_S ) / 2 UNDEROVER
  // get array larger than or equal to 3 x 3 
  VIA3Array = MinArray INTERACT VIA3 >= 3 * 3
  VIA3InArray = VIA3 INTERACT VIA3Array
  EXT VIA3InArray < VIA3_S_2 ABUT < 90 REGION
}
VIA3.EN.1 { @ Enclosure by M3 >= ^VIA3_EN_1 um 
  ENC VIA3 M3 < VIA3_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}

VIA3.EN.2 { @ Enclosure by M3 [at least two opposite sides] >= ^VIA3_EN_2 um
  X = RECTANGLE ENCLOSURE VIA3 M3 ABUT < 90 GOOD VIA3_EN_1 VIA3_EN_2 OPPOSITE VIA3_EN_1 VIA3_EN_2 OPPOSITE
  Y = ENC [X] M3 < VIA3_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA3_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

// VIA3.R.1 is checked by VIA3.W.1
#IFNDEF LK
#IFDEF HALF_NODE
M3WideR2_1 = COPY M3Wide1.54
M4WideR2_2 = COPY M4Wide1.54
#ELSE
M3WideR2_1 = COPY M3Wide1.4
M4WideR2_2 = COPY M4Wide1.4
#ENDIF
VIA3.R.2_FSG { @ When M3 or M4 width > ^VIAx_R_2_FSG_W um, more than 1 VIA3 is required.
           @ if the metal has < 4 vias, vias spacing should be <= ^VIAx_R_2_FSG_S_1 um, 
  	   @ or if the metal has >=4 vias, at least 4 vias spacing should be <= ^VIAx_R_2_FSG_S_2 um
  M4OvpM3W = (M4 AND M3WideR2_1) OR (M3 AND M4WideR2_2)
  M3_has_wm_ovp  = METAL3i  INTERACT M4OvpM3W
  M4_has_wm_ovp = METAL4i INTERACT M4OvpM3W
  MOvp = M3_has_wm_ovp AND M4_has_wm_ovp 
  VIA_EXC = VIA3 NOT VIA_EXD
  M3M4Wide = M3WideR2_1 OR M4WideR2_2
  OvpOnM3M4W = MOvp NOT OUTSIDE M3M4Wide
  VIA_CheckM3 = VIA_EXC INTERACT OvpOnM3M4W
  
  Merge1OnM3M4W = SIZE VIA_CheckM3 BY (VIAx_R_2_FSG_S_1/2) INSIDE OF OvpOnM3M4W STEP (0.21*0.7)
  badRegion1  = Merge1OnM3M4W INTERACT VIA_CheckM3 < 2
  GoodRegion1 = Merge1OnM3M4W OUTSIDE badRegion1
  Merge2OnM3M4W = SIZE Merge1OnM3M4W BY (VIAx_R_2_FSG_S_2 - VIAx_R_2_FSG_S_1)/2 INSIDE OF OvpOnM3M4W STEP (0.21*0.7)
  badRegion2  = Merge2OnM3M4W INTERACT VIA_CheckM3 < 4
  GoodRegion2 = Merge2OnM3M4W OUTSIDE badRegion2
  GoodRegion = GoodRegion1 OR GoodRegion2
  GoodVIA = (VIA_CheckM3 INTERACT GoodRegion) NOT OUTSIDE M3M4Wide
  M3M4Check = (M3M4Wide AND OvpOnM3M4W) NOT INTERACT GoodVIA
  VIA_CheckM3 NOT OUTSIDE M3M4Check 
}
#ENDIF  // LK

//M4 CHECKS
//=========
M4_EDGE_45 = M4 ANGLE == 45
M4_EDGE_45L = LENGTH M4_EDGE_45 >= M4_W_2_L
M4.W.1 { @ Width >= ^M4_W_1 um
  INT M4 < M4_W_1 ABUT < 90 SINGULAR REGION
}
M4.W.2 { @ Width of 45 degree bent M4 (with length >= ^M4_W_2_L um) >= ^M4_W_2 um
  INT M4_EDGE_45L < M4_W_2 ABUT < 90 REGION
}
M4.S.1 { @ Space >= ^M4_S_1 um
  EXT M4 < M4_S_1 ABUT < 90 SINGULAR REGION
}
#IFDEF HALF_NODE
M4.S.2 { @ Space to wide M4 (both metal line width and length > 11 um) or wide M4 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M4 >= ^M4_S_2 um
  M4_S5.5 = SHRINK (SHRINK (SHRINK (SHRINK M4Wide7 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M4_G5.5 = GROW (GROW (GROW (GROW M4_S5.5 RIGHT BY 5.5) LEFT BY 5.5) TOP BY 5.5) BOTTOM BY 5.5
  M4_Wide = M4_G5.5 AND M4
  M4_Exp = SIZE M4_Wide BY M4_S_2_B INSIDE OF M4 STEP M4_S_1 * 0.7
  M4_Branch = M4_Exp NOT M4_Wide
  M4_Branch_edge = M4_Branch COIN INSIDE EDGE M4
  M4_Check = M4 AND (SIZE M4_Exp BY M4_S_2)
  M4_Branch_Check = M4 AND (EXPAND EDGE M4_Branch_edge OUTSIDE BY M4_S_2 CORNER FILL)
  M4_WideC = STAMP M4_Wide BY M4x
  M4_CheckC = STAMP M4_Check BY M4x
  M4_BranchC = STAMP M4_Branch BY M4x
  M4_Branch_CheckC = STAMP M4_Branch_Check BY M4x
  EXT M4_WideC M4_CheckC < M4_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M4_BranchC M4_Branch_CheckC < M4_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ELSE
M4.S.2 { @ Space to wide M4 (both metal line width and length > 10 um) or wide M4 branch 
         @ (a small piece of metal connected to a wide metal) 
	 @ within the <= 1 um range from the wide M4 >= ^M4_S_2 um
  M4_S5 = SHRINK (SHRINK (SHRINK (SHRINK M4Wide7 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M4_G5 = GROW (GROW (GROW (GROW M4_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  M4_Wide = M4_G5 AND M4
  M4_Exp = SIZE M4_Wide BY M4_S_2_B INSIDE OF M4 STEP M4_S_1 * 0.7
  M4_Branch = M4_Exp NOT M4_Wide
  M4_Branch_edge = M4_Branch COIN INSIDE EDGE M4
  M4_Check = M4 AND (SIZE M4_Exp BY M4_S_2)
  M4_Branch_Check = M4 AND (EXPAND EDGE M4_Branch_edge OUTSIDE BY M4_S_2 CORNER FILL)
  M4_WideC = STAMP M4_Wide BY M4x
  M4_CheckC = STAMP M4_Check BY M4x
  M4_BranchC = STAMP M4_Branch BY M4x
  M4_Branch_CheckC = STAMP M4_Branch_Check BY M4x
  EXT M4_WideC M4_CheckC < M4_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT M4_BranchC M4_Branch_CheckC < M4_S_2 ABUT >0 <89.5 NOT CONNECTED REGION
}
#ENDIF

#IFDEF HALF_NODE
M4WideS3 = COPY M4Wide0.43
#ELSE
M4WideS3 = COPY M4Wide0.4
#ENDIF
M4.S.3 { @ Space [for at least one metal line width >= ^M4_S_3_W um and
         @ the parallel metal run length >= ^M4_S_3_L um] >= ^M4_S_3 um
  X = EXT M4WideS3 M4 < M4_S_3 OPPOSITE REGION MEASURE ALL
  Y = ENCLOSE RECTANGLE X GRID M4_S_3_L
  WideEdge = Y COIN OUTSIDE EDGE M4WideS3
  PATH LENGTH WideEdge >= M4_S_3_L
}
M4.S.4 { @ Space to 45 degree bent M4 (with length >= ^M4_W_2_L um) >= ^M4_S_4 um
  X = EXPAND EDGE M4_EDGE_45L OUTSIDE BY M4_S_4
  X AND M4
}
M4.EN.1 { @ Enclosure of VIA3 >= ^M4_EN_1 um
  ENC VIA3 M4 < M4_EN_1 ABUT < 90 OUTSIDE ALSO SINGULAR REGION
}
M4.EN.2 { @ Enclosure of VIA3 [at least two opposite sides] >= ^M4_EN_2 um
  X = RECTANGLE ENCLOSURE VIA3 M4 ABUT < 90 GOOD M4_EN_1 M4_EN_2 OPPOSITE M4_EN_1 M4_EN_2 OPPOSITE
  Y = ENC [X] M4 < M4_EN_2 ABUT < 90 OPPOSITE
  Z = X TOUCH EDGE Y
  INT Z < VIA3_W_1 ABUT == 90 INTERSECTING ONLY   // adjacent narrow sides
}

M4.A.1 { @ Area >= ^M4_A_1 um2
  AREA M4 < M4_A_1
}

VARIABLE M4_A_2pre ((M4_A_2 + (M4_S_1 * M4_S_1 * 3.142))/(2 * M4_S_1))*((M4_A_2 + (M4_S_1 * M4_S_1 * 3.142))/(2 * M4_S_1))/3.141

M4.A.2 { @ Enclosed area >= ^M4_A_2 um2 
  M4HO = HOLES M4 INNER < M4_A_2pre
  M4HOC = M4HO NOT M4
  (AREA M4HOC < M4_A_2) NOT INSIDE SRAM_EXCLUDE
}

M4.S.5 { @ Space of two adjacent stacked metal (metal layers >= 3)
         @ [both length and width of (either A or B) >= ^M4_S_5_W um, and the projection length > ^M4_S_5_W um]
	 @ >= ^M4_S_5 um
  M4OverlapBig = (SIZE M4Overlap BY M4_S_5_W/2 UNDEROVER TRUNCATE M4_S_5_W/2) AND M4Overlap
  W = EXT M4OverlapBig M4Overlap < M4_S_5 OPPOSITE MEASURE ALL REGION
  X = W NOT INSIDE M3
  Y = X NOT INSIDE M4
  Y1 = Y NOT INSIDE M5
  ENCLOSE RECTANGLE Y1 GRID (M4_S_5_W + GRID)
}


//VIA4 CHECKS
//===========

VIA4.W.1 { @ Width (square) (maximum == minimum) == ^VIA4_W_1 um
  A = NOT RECTANGLE VIA4 == VIA4_W_1 BY == VIA4_W_1 ORTHOGONAL ONLY
  A NOT VIA_EXD
}
#IFDEF LmarkSealringCorner
VIA4.W.2 { @ Width of VIA4 bar. VIA4 bar is only allowed in seal ring and fuse protection ring.
            @ SEALRING layer (CAD layer: 162 for both seal-ring and fuse protection ring)
	    @ is a must if VIAx bar is used >= ^VIA4_W_2 um
