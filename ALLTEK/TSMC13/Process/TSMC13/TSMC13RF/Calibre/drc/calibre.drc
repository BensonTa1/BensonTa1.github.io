                         [ AREA(M6_AND_DM6EXCL)/AREA(CHIP_AND_DM6EXCL) ]
  F = AREA (ERR_WIN AND DM6EXCL) >= 10000			 
  DENSITY F M6_AND_DM6EXCL CHIP_AND_DM6EXCL < DM6_DN_2L WINDOW 200 STEP 100 BACKUP PRINT DM6_DN_2L.density 
                         [ !AREA(F) + AREA(M6_AND_DM6EXCL)/AREA(CHIP_AND_DM6EXCL) ]
}
DM6.DN.2H { @ M6 local density range within DM6EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um <= ^DM6_DN_2H
  ERR_WIN = DENSITY M6_AND_DM6EXCL CHIP_AND_DM6EXCL > DM6_DN_2H WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M6_AND_DM6EXCL)/AREA(CHIP_AND_DM6EXCL) ]
  F = AREA (ERR_WIN AND DM6EXCL) >= 10000			 
  DENSITY F M6_AND_DM6EXCL CHIP_AND_DM6EXCL > DM6_DN_2H WINDOW 200 STEP 100 BACKUP PRINT DM6_DN_2H.density 
                         [ !!AREA(F) * AREA(M6_AND_DM6EXCL)/AREA(CHIP_AND_DM6EXCL) ]
}
#ELSE

M6.DN.1L { @ {M6 OR DM6} local density range over 200um x 200um area stepping 100um >= ^M6_DN_1L 
  D0 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP  
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D = RECTANGLE D0 == 200
  ERR1 = ( D0 NOT D ) NOT M6_DEN_EXC
  F1 = AREA ERR1 >= 10000
  D1 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D2 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU20
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D3 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU30
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D4 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU40
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D5 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU50
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D6 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU60
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D7 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU70
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D8 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU80
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  D9 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
  ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
  F2 = AREA ( ERR2 NOT M6_DEN_EXC ) >= 10000
  F = F1 OR F2
  DENSITY F M6_NOT_EXC CHIP_NOT_M6_EXC < M6_DN_1L WINDOW 200 STEP 100 BACKUP PRINT M6_DN_1L.density 
          [  !AREA(F) + AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
}

M6.DN.1H { @ {M6 OR DM6} local density range over 200um x 200um area stepping 100um <= ^M6_DN_1H
    D0 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC > M6_DN_1H WINDOW 200 STEP 100 BACKUP   
          [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
    D = RECTANGLE D0 == 200
    ERR1 = ( D0 NOT D ) NOT M6_DEN_EXC
    F1 = AREA ERR1 >= 10000 
    D1 = DENSITY M6_NOT_EXC CHIP_NOT_M6_EXC > M6_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
            [ AREA(M6_NOT_EXC)/AREA(CHIP_NOT_M6_EXC) ]
