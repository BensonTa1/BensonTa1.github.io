  Bad_Branch = Check_Branch INTERACT VIA1 == 1
  M_Ovlp = ((M2Tree2_2 AND M1) INTERACT Bad_Branch) INTERACT VIA1 == 1
  (VIA1 INTERACT M_Ovlp) NOT VIA_EXD
}  


