//M7 SLOT CHECKS
//==================


M7EXD = (M7x NOT SLT_EXD) NOT WBDMY

M7InnerHole = HOLES M7EXD INNER
M7BigHole   = SIZE M7InnerHole BY -5 // Holes with width <= 10um will be filled back
M7Hole      = M7InnerHole OUTSIDE M7BigHole	
M7HoleSpace = M7Hole NOT M7EXD
FIM7c       = M7EXD OR M7HoleSpace
FIM7Y       = (SIZE(SIZE FIM7c BY 1.0 UNDEROVER) BY MS_R_1_W_s UNDEROVER) AND FIM7c
LM7X        = ENCLOSE RECTANGLE FIM7Y MS_R_1_W MS_R_1_L
M7HoleD     = M7HoleSpace AND LM7X

#IFDEF HALF_NODE
M7WideMS = COPY M7Wide7.7
#ELSE
M7WideMS = COPY M7Wide7
#ENDIF
MS.R.1.M7 { @ Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad areas are excluded.   
  M7WideEXD = M7WideMS NOT SLT_EXD
  X = (SIZE M7WideEXD BY MS_R_1_W_s UNDEROVER) AND M7WideEXD
  ENCLOSE RECTANGLE X MS_R_1_W MS_R_1_L
}

CONNECT M7HoleD LM7X

MS.DN.1.M7 { @ Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%  

  NET AREA RATIO LM7X M7HoleD < MS_DN_1
    [ AREA(M7HoleD) / AREA(LM7X) ] RDB M7Hole.density LM7X M7HoleD
}

DISCONNECT
// MS.R.2.M7 is not able to check



//M8 SLOT CHECKS
//==================


// Bonding pad, chip corner dummy pad, and inductor need not put slot
PAD_EXD8 = SIZE PAD_EXD BY 5 INSIDE OF M8x STEP 0.32 
SLT_EXD8 = ((SLT_EXD OR PAD_EXD8) OR WBDMY ) OR INDDMY // For top metal only
M8EXD = M8x NOT SLT_EXD8

M8InnerHole = HOLES M8EXD INNER
M8BigHole   = SIZE M8InnerHole BY -5 // Holes with width <= 10um will be filled back
M8Hole      = M8InnerHole OUTSIDE M8BigHole	
M8HoleSpace = M8Hole NOT M8EXD
FIM8c       = M8EXD OR M8HoleSpace
FIM8Y       = (SIZE(SIZE FIM8c BY 1.0 UNDEROVER) BY MS_R_1_W_s UNDEROVER) AND FIM8c
LM8X        = ENCLOSE RECTANGLE FIM8Y MS_R_1_W MS_R_1_L
M8HoleD     = M8HoleSpace AND LM8X

#IFDEF UTM
LUTM8_T = ENCLOSE RECTANGLE ((SIZE FIM8_T BY M8_DN_2_W/2-0.001 UNDEROVER) AND FIM8_T) M8_DN_2_W M8_DN_2_L
M8SLT_T2  = M8HO_T INSIDE LUTM8_T
CONNECT M8SLT_T2 LUTM8_T

UTM.DN.2 { @ Min. slot density for metal lines that need to apply slot  9%
   NET AREA RATIO LUTM8_T M8SLT_T2 < 0.09
   [
      AREA(M8SLT_T2) / AREA(LUTM8_T)
   ] RDB UTM8SLOT.density LUTM8_T M8SLT_T2
}

DISCONNECT

#ELSE   //UTM
#IFDEF HALF_NODE
M8WideMS = COPY M8Wide7.7
#ELSE
M8WideMS = COPY M8Wide7
#ENDIF
MS.R.1.M8 { @ Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad areas are excluded.   
  M8WideEXD = M8WideMS NOT SLT_EXD8
  X = (SIZE M8WideEXD BY MS_R_1_W_s UNDEROVER) AND M8WideEXD
  ENCLOSE RECTANGLE X MS_R_1_W MS_R_1_L
}

CONNECT M8HoleD LM8X

MS.DN.1.M8 { @ Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%  

  NET AREA RATIO LM8X M8HoleD < MS_DN_1
    [ AREA(M8HoleD) / AREA(LM8X) ] RDB M8Hole.density LM8X M8HoleD
}

DISCONNECT
#ENDIF   //UTM
// MS.R.2.M8 is not able to check



//MD SLOT CHECKS
//==================



#IFNDEF UTM
//MD SLOT CHECKS
//==============
// Bonding pad, chip corner dummy pad, and inductor need not put slot

MDEXD       = MDx NOT ((LMARK OR CSRDMY) OR UBM_EXDD )
MDInnerHole = HOLES MDEXD INNER
MDBigHole   = SIZE MDInnerHole BY -5  	// Holes with width less than 10um will be filled back
MDHole      = MDInnerHole OUTSIDE MDBigHole	
MDHoleSpace = MDHole NOT MDEXD
FIMDc       = MDEXD OR MDHoleSpace
FIMDY       = (SIZE (SIZE FIMDc BY 1.0 UNDEROVER) BY MS_R_1_W_s UNDEROVER) AND FIMDc  
LMDX        = ENCLOSE RECTANGLE FIMDY MS_R_1_W MS_R_1_L
MDHoleD     = MDHoleSpace AND LMDX

MS.R.1.MD { @ Metal slots are required for wide metal lines. Wide metal is defined as metal that is >= ^MS_R_1_W um in width and >= ^MS_R_1_W um in length. Only bonding/bump pad areas are excluded.   
  X = (SIZE (SIZE MDEXD BY 1.0 UNDEROVER) BY MS_R_1_W_s UNDEROVER) AND MDEXD
  ENCLOSE RECTANGLE X MS_R_1_W MS_R_1_L
}

CONNECT MDHoleD LMDX

MS.DN.1.MD { @ Metal hole density ( Maximum metal density 91%) for the wide metal. Metal holes with a width or length <= 10 um are ignored and treated as metal. in identifying wide metal (>= ^MS_R_1_W um x ^MS_R_1_L um). 9%  
  NET AREA RATIO LMDX MDHoleD < MS_DN_1
    [ AREA(MDHoleD) / AREA(LMDX) ] RDB MDHole.density LMDX MDHoleD 
}

DISCONNECT

// MS.R.2.MD is not able to check
#ENDIF





//MIM is MSRF rules


//CTM CHECKS
//==========
#IFDEF UTM
VCAP  = COPY VIA6
MCAP  = STAMP M7 BY M7x 
DMCAP = COPY DUM7
MBOT  = COPY M6
#ELSE  //UTM
VCAP  = COPY VIA7
MCAP  = STAMP M8 BY M8x
DMCAP = COPY DUM8 
MBOT  = COPY M7
#ENDIF  //UTM

VIA_CTM      = VCAP AND CTM
VIA_CBM      = (VCAP AND CBM) NOT CTM
VIA_CTMDMY   = VCAP AND CTMDMY
MCAP_CTMDMY  = MCAP AND CTMDMY
DMCAP_CTMDMY = DMCAP AND CTMDMY
MBOT_CTMDMY  = MBOT INTERACT CTMDMY

CTM.W.1 { @ Width(minimum) >= ^CTM_S_1 um. 
  INT CTM < CTM_W_1 ABUT <90 SINGULAR REGION
}

CTM.W.2 { @ Width(maximum for either length or width) >= ^CTM_W_2 um. 
  ENCLOSE RECTANGLE CTM GRID CTM_W_2+GRID ORTHOGONAL ONLY
}

CTM.S.1 { @ Space >= ^CTM_S_1 um. 
  EXT CTM < CTM_S_1 ABUT <90 SINGULAR REGION
}

CTM.EN.1 { @ Enclosure of Vcap >= ^CTM_EN_1 um.
  ENC VCAP CTM < CTM_EN_1 ABUT<90 OVERLAP SINGULAR REGION
}

CTM.EN.2 { @ Enclosure by CBM >= ^CTM_EN_2 um.
  ENC CTM CBM < CTM_EN_2 ABUT<90 OUTSIDE ALSO SINGULAR REGION
  CTM NOT CBM
}  

CTM.S.2 { @ CTM space to {Vcap outside CTM} >= ^CTM_S_2 um.
  EXT CTM VIA_CBM < CTM_S_2 ABUT<90 SINGULAR REGION
}

//CTM.R.1 is checked by CTM.EN.2

CTM.S.3 { @ {Vcap inside CTM} space to {Vcap inside CTM} >= ^CTM_S_3 um.
  EXT VIA_CTM < CTM_S_3 ABUT<90 SINGULAR REGION
}

//CTM.R.2 can not be checked by drc
//CTM.R.3 VIA dimension is checked by VIA7.W.1,thickness can not be checked by drc


//CBM CHECKS
//==========
CTMDMY_DN_S = AREA CTMDMY <= 40000
CTMDMY_DN_W = CTMDMY NOT CTMDMY_DN_S
CTMDMY_S = AREA CTMDMY <= CBM_S_1W
CTMDMY_W = CTMDMY NOT CTMDMY_S
CBM_S = CBM AND CTMDMY_S
CBM_W = CBM AND CTMDMY_W

CBM.W.1 { @ Width (minimum) >= ^CBM_W_1 um. 
  INT CBM < CBM_W_1 ABUT <90 SINGULAR REGION
}

CBM.W.2 { @ Width (maximum for either length or width) >= ^CBM_W_1 um. 
  ENCLOSE RECTANGLE CBM GRID CBM_W_2+GRID ORTHOGONAL ONLY
}

CBM.EN.1 { @ Enclosure of Vcap >= ^CBM_EN_1 um.
  ENC VIA_CBM CBM < CBM_EN_1 ABUT<90 OVERLAP SINGULAR REGION
}

CBM.EN.2 { @ One DRC checking layer (CTMDMY, GDS layer 148) is needed to specify the MiM capacitor region; special Mcap and Vcap design rules will be defined inside this area.
           @ CTMDMY is equal to CBM layer sizing up ^CBM_EN_2 um for each side.
  A = SIZE CBM BY CBM_EN_2
  A XOR CTMDMY
}

CBM.S.1 { @ 1. Space (For CTMDMY area <= ^CBM_S_1W m2) >= ^CBM_S_1A um,
          @ 2. Space (For CTMDMY area > ^CBM_S_1W m2) >= ^CBM_S_1B um
  EXT CBM_S < CBM_S_1A ABUT <90 SINGULAR REGION
  EXT CBM_W < CBM_S_1B ABUT <90 SINGULAR REGION
}
CBM.DN.1 { @ When CTMDMY area > 40,000 um2, {Mcap inside CTMDMY} density range over any 200 um x 200 um area (checked by stepping in 100 um increments). >= ^CBM_DN_1
           @ This rule is only applied to the overlapped area of checking window and CTMDMY >= ^CBM_DN_1A um2
  MCAP_W = MCAP AND CTMDMY_DN_W
  ERROR_WINDOW = DENSITY MCAP_W CTMDMY_DN_W < CBM_DN_1 WINDOW CBM_DN_1W STEP CBM_DN_1S BACKUP PRINT CBM.DN.1.density 
                 [ AREA(MCAP_W)/AREA(CTMDMY_DN_W) ]
  AREA (ERROR_WINDOW AND CTMDMY_DN_W) >= CBM_DN_1A			 
}

//CBM.DN.2 is checked by logic metal density check.

CBM.S.2 { @ {Vcap inside CBM} space to {Vcap inside CBM} >= ^CBM_S_2 um.
  EXT VIA_CBM < CBM_S_2 ABUT<90 SINGULAR REGION
}

CBM.W.3 { @ Width of {Mcap inside CTMDMY} >= ^CBM_W_3 um.
  A = MCAP INTERACT CTMDMY
  B = INT A < CBM_W_3 ABUT<90 SINGULAR REGION
  B AND CTMDMY
}

CBM.S.3 { @ Space of {Mcap inside CTMDMY} >= ^CBM_S_3 um.
  EXT MCAP_CTMDMY < CBM_S_3 ABUT<90 SINGULAR REGION
}

CBM.S.4 { @ Inside the CTMDMY region, Mcap space to wide Mcap (both Mcap line width and length > 10 um),
          @ or wide Mcap branch (a small piece of Mcap is connected to wide Mcap within 2.0 um range from the wide Mcap) >= ^CBM_S_4 um 
  MCAP_S5 = SHRINK (SHRINK (SHRINK (SHRINK MCAP_CTMDMY RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  MCAP_G5 = GROW (GROW (GROW (GROW MCAP_S5 RIGHT BY 5) LEFT BY 5) TOP BY 5) BOTTOM BY 5
  MCAP_Wide = MCAP_G5 AND MCAP
  MCAP_Exp = SIZE MCAP_Wide BY 2 INSIDE OF MCAP STEP 0.644
  MCAP_Branch = MCAP_Exp NOT MCAP_Wide
  MCAP_Branch_edge = MCAP_Branch COIN INSIDE EDGE MCAP
  MCAP_Check = MCAP AND (SIZE MCAP_Exp BY CBM_S_4)
  MCAP_Branch_Check = MCAP AND (EXPAND EDGE MCAP_Branch_edge OUTSIDE BY CBM_S_4 CORNER FILL)
  MCAP_WideC = STAMP MCAP_Wide BY MCAP
  MCAP_CheckC = STAMP MCAP_Check BY MCAP
  MCAP_BranchC = STAMP MCAP_Branch BY MCAP
  MCAP_Branch_CheckC = STAMP MCAP_Branch_Check BY MCAP
  EXT MCAP_WideC MCAP_CheckC < CBM_S_4 ABUT >0 <89.5 NOT CONNECTED REGION
  EXT MCAP_BranchC MCAP_Branch_CheckC < CBM_S_4 ABUT >0 <89.5 NOT CONNECTED REGION
}

CBM.EN.3 { @ {Vcap inside CTMDMY} Enclosure by Mcap >= ^CBM_EN_3 um
  A = VCAP INSIDE CTMDMY
  B = MCAP INTERACT A
  ENC A B < CBM_EN_3 ABUT<90 OUTSIDE ALSO SINGULAR REGION
}

CBM.R.1 { @ Single Vcap is not allowed on one CTM or CBM or Mcap or Mcap-1 inside CTMDMY.			
  CTM ENCLOSE VCAP == 1
  CBM ENCLOSE VIA_CBM == 1
  A = MBOT_CTMDMY ENCLOSE VCAP == 1
  VIA_CTMDMY AND A
  B = MCAP_CTMDMY ENCLOSE VCAP == 1
  VIA_CTMDMY AND B
}  
  
//CBM.R.2 is not necessary to check

CBM.R.3 { @ Mcap-1 under CBM region is not allowed
  MBOT AND CBM
}

CBM.S.5 { @ Space to Mcap-1 >= ^CBM_S_5 um.
  EXT MBOT CBM < CBM_S_5 ABUT<90 SINGULAR REGION
}
VARIABLE M1_DN_5 0.15

M1DN5_CBM_MERGE = SIZE (SIZE CBM BY 25) BY -25
M1DN5_CHECK_CBM = AREA M1DN5_CBM_MERGE >= 200 * 200

M1DN5_M1_CHECK = M1 AND M1DN5_CHECK_CBM
M1DN5_M2_CHECK = M2 AND M1DN5_CHECK_CBM
M1DN5_M3_CHECK = M3 AND M1DN5_CHECK_CBM
CONNECT M1DN5_CHECK_CBM M1DN5_M1_CHECK
CONNECT M1DN5_CHECK_CBM M1DN5_M2_CHECK
CONNECT M1DN5_CHECK_CBM M1DN5_M3_CHECK
    
M1.DN.5 { @ It is not allowed to have local density < ^M1_DN_5 of all 3 consecutive metal (M1,M2,M3) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um
    A = NET AREA RATIO M1DN5_M1_CHECK M1DN5_CHECK_CBM < M1_DN_5
        [AREA(M1DN5_M1_CHECK)/AREA(M1DN5_CHECK_CBM)]
        RDB M1.DN.5.M1.density
    B = NET AREA RATIO M1DN5_M2_CHECK M1DN5_CHECK_CBM < M1_DN_5
        [AREA(M1DN5_M2_CHECK)/AREA(M1DN5_CHECK_CBM)]
        RDB M1.DN.5.M2.density
    C = NET AREA RATIO M1DN5_M3_CHECK M1DN5_CHECK_CBM < M1_DN_5
        [AREA(M1DN5_M3_CHECK)/AREA(M1DN5_CHECK_CBM)]
        RDB M1.DN.5.M3.density
    (A AND B) AND C
}

VARIABLE M2_DN_5 0.15

M2DN5_CBM_MERGE = SIZE (SIZE CBM BY 25) BY -25
M2DN5_CHECK_CBM = AREA M2DN5_CBM_MERGE >= 200 * 200

M2DN5_M2_CHECK = M2 AND M2DN5_CHECK_CBM
M2DN5_M3_CHECK = M3 AND M2DN5_CHECK_CBM
M2DN5_M4_CHECK = M4 AND M2DN5_CHECK_CBM
CONNECT M2DN5_CHECK_CBM M2DN5_M2_CHECK
CONNECT M2DN5_CHECK_CBM M2DN5_M3_CHECK
CONNECT M2DN5_CHECK_CBM M2DN5_M4_CHECK
    
M2.DN.5 { @ It is not allowed to have local density < ^M2_DN_5 of all 3 consecutive metal (M2,M3,M4) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um
    A = NET AREA RATIO M2DN5_M2_CHECK M2DN5_CHECK_CBM < M2_DN_5
        [AREA(M2DN5_M2_CHECK)/AREA(M2DN5_CHECK_CBM)]
        RDB M2.DN.5.M2.density
    B = NET AREA RATIO M2DN5_M3_CHECK M2DN5_CHECK_CBM < M2_DN_5
        [AREA(M2DN5_M3_CHECK)/AREA(M2DN5_CHECK_CBM)]
        RDB M2.DN.5.M3.density
    C = NET AREA RATIO M2DN5_M4_CHECK M2DN5_CHECK_CBM < M2_DN_5
        [AREA(M2DN5_M4_CHECK)/AREA(M2DN5_CHECK_CBM)]
        RDB M2.DN.5.M4.density
    (A AND B) AND C
}

VARIABLE M3_DN_5 0.15

M3DN5_CBM_MERGE = SIZE (SIZE CBM BY 25) BY -25
M3DN5_CHECK_CBM = AREA M3DN5_CBM_MERGE >= 200 * 200

M3DN5_M3_CHECK = M3 AND M3DN5_CHECK_CBM
M3DN5_M4_CHECK = M4 AND M3DN5_CHECK_CBM
M3DN5_M5_CHECK = M5 AND M3DN5_CHECK_CBM
CONNECT M3DN5_CHECK_CBM M3DN5_M3_CHECK
CONNECT M3DN5_CHECK_CBM M3DN5_M4_CHECK
CONNECT M3DN5_CHECK_CBM M3DN5_M5_CHECK
    
M3.DN.5 { @ It is not allowed to have local density < ^M3_DN_5 of all 3 consecutive metal (M3,M4,M5) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um
    A = NET AREA RATIO M3DN5_M3_CHECK M3DN5_CHECK_CBM < M3_DN_5
        [AREA(M3DN5_M3_CHECK)/AREA(M3DN5_CHECK_CBM)]
        RDB M3.DN.5.M3.density
    B = NET AREA RATIO M3DN5_M4_CHECK M3DN5_CHECK_CBM < M3_DN_5
        [AREA(M3DN5_M4_CHECK)/AREA(M3DN5_CHECK_CBM)]
        RDB M3.DN.5.M4.density
    C = NET AREA RATIO M3DN5_M5_CHECK M3DN5_CHECK_CBM < M3_DN_5
        [AREA(M3DN5_M5_CHECK)/AREA(M3DN5_CHECK_CBM)]
        RDB M3.DN.5.M5.density
    (A AND B) AND C
}

VARIABLE M4_DN_5 0.15

M4DN5_CBM_MERGE = SIZE (SIZE CBM BY 25) BY -25
M4DN5_CHECK_CBM = AREA M4DN5_CBM_MERGE >= 200 * 200

M4DN5_M4_CHECK = M4 AND M4DN5_CHECK_CBM
M4DN5_M5_CHECK = M5 AND M4DN5_CHECK_CBM
M4DN5_M6_CHECK = M6 AND M4DN5_CHECK_CBM
CONNECT M4DN5_CHECK_CBM M4DN5_M4_CHECK
CONNECT M4DN5_CHECK_CBM M4DN5_M5_CHECK
CONNECT M4DN5_CHECK_CBM M4DN5_M6_CHECK
    
M4.DN.5 { @ It is not allowed to have local density < ^M4_DN_5 of all 3 consecutive metal (M4,M5,M6) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um
    A = NET AREA RATIO M4DN5_M4_CHECK M4DN5_CHECK_CBM < M4_DN_5
        [AREA(M4DN5_M4_CHECK)/AREA(M4DN5_CHECK_CBM)]
        RDB M4.DN.5.M4.density
    B = NET AREA RATIO M4DN5_M5_CHECK M4DN5_CHECK_CBM < M4_DN_5
        [AREA(M4DN5_M5_CHECK)/AREA(M4DN5_CHECK_CBM)]
        RDB M4.DN.5.M5.density
    C = NET AREA RATIO M4DN5_M6_CHECK M4DN5_CHECK_CBM < M4_DN_5
        [AREA(M4DN5_M6_CHECK)/AREA(M4DN5_CHECK_CBM)]
        RDB M4.DN.5.M6.density
    (A AND B) AND C
}

#IFNDEF  UTM 
VARIABLE M5_DN_5 0.15

M5DN5_CBM_MERGE = SIZE (SIZE CBM BY 25) BY -25
M5DN5_CHECK_CBM = AREA M5DN5_CBM_MERGE >= 200 * 200

M5DN5_M5_CHECK = M5 AND M5DN5_CHECK_CBM
M5DN5_M6_CHECK = M6 AND M5DN5_CHECK_CBM
M5DN5_M7_CHECK = M7 AND M5DN5_CHECK_CBM
CONNECT M5DN5_CHECK_CBM M5DN5_M5_CHECK
CONNECT M5DN5_CHECK_CBM M5DN5_M6_CHECK
CONNECT M5DN5_CHECK_CBM M5DN5_M7_CHECK
    
M5.DN.5 { @ It is not allowed to have local density < ^M5_DN_5 of all 3 consecutive metal (M5,M6,M7) under ((CBM SIZING 25) SIZING -25) whose size is >= 200um X 200um
    A = NET AREA RATIO M5DN5_M5_CHECK M5DN5_CHECK_CBM < M5_DN_5
        [AREA(M5DN5_M5_CHECK)/AREA(M5DN5_CHECK_CBM)]
        RDB M5.DN.5.M5.density
    B = NET AREA RATIO M5DN5_M6_CHECK M5DN5_CHECK_CBM < M5_DN_5
        [AREA(M5DN5_M6_CHECK)/AREA(M5DN5_CHECK_CBM)]
        RDB M5.DN.5.M6.density
    C = NET AREA RATIO M5DN5_M7_CHECK M5DN5_CHECK_CBM < M5_DN_5
        [AREA(M5DN5_M7_CHECK)/AREA(M5DN5_CHECK_CBM)]
        RDB M5.DN.5.M7.density
    (A AND B) AND C
}
#ENDIF



//DUMMY METAL CHECK ON MCAP.
//================================

DMCAP.W.1 { @ Width (minimum) >= ^DMCAP_W_1
  INT DMCAP_CTMDMY < DMCAP_W_1 ABUT < 90 SINGULAR REGION
}
DMCAP.S.1 { @ Space >= ^DMCAP_S_1
  EXT DMCAP_CTMDMY < DMCAP_S_1 ABUT < 90 SINGULAR REGION
}
DMCAP.S.2 { @ Space to MCAP [overlap is not allowed] >= ^DMCAP_S_2
  EXT MCAP DMCAP_CTMDMY < DMCAP_S_2 ABUT < 90 SINGULAR REGION
  MCAP AND DMCAP_CTMDMY
}
DMCAP.A.1 { @ Area (minimum) >= ^DMCAP_A_1
  AREA DMCAP_CTMDMY < DMCAP_A_1
}
DMCAP.A.2 { @ Area (maximum) <= ^DMCAP_A_2
  AREA DMCAP_CTMDMY > DMCAP_A_2
}


//METAL DENSITY RULES 
//===================


CHIPU10   = SIZE CHIP BY 10
CHIPU20   = SIZE CHIP BY 20
CHIPU30   = SIZE CHIP BY 30
CHIPU40   = SIZE CHIP BY 40
CHIPU50   = SIZE CHIP BY 50
CHIPU60   = SIZE CHIP BY 60
CHIPU70   = SIZE CHIP BY 70
CHIPU80   = SIZE CHIP BY 80
CHIPU90   = SIZE CHIP BY 90
M1_DEN_EXC = COPY METAL_DEN_EXC
M2_DEN_EXC = COPY METAL_DEN_EXC
M3_DEN_EXC = COPY METAL_DEN_EXC
M4_DEN_EXC = COPY METAL_DEN_EXC
M5_DEN_EXC = COPY METAL_DEN_EXC
#IFDEF UTM
M6_DEN_EXC = METAL_DEN_EXC OR CTMDMY
M7_DEN_EXC = COPY METAL_DEN_EXC 
#ELSE  //UTM
M6_DEN_EXC = COPY METAL_DEN_EXC 
M7_DEN_EXC = METAL_DEN_EXC OR CTMDMY
#ENDIF  //UTM
M1_NOT_EXC    = ALL_M1 NOT M1_DEN_EXC
CHIP_NOT_M1_EXC = CHIPx NOT M1_DEN_EXC

#IFDEF CHECK_DENSITY_IN_DMxEXCL_ONLY

CHIP_AND_DM1EXCL= DM1EXCL AND CHIP_NOT_M1_EXC
M1_AND_DM1EXCL  = ALL_M1 AND CHIP_AND_DM1EXCL

DM1.DN.2L { @ M1 local density range within DM1EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um >= ^DM1_DN_2L 
  ERR_WIN = DENSITY M1_AND_DM1EXCL CHIP_AND_DM1EXCL < DM1_DN_2L WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M1_AND_DM1EXCL)/AREA(CHIP_AND_DM1EXCL) ]
  F = AREA (ERR_WIN AND DM1EXCL) >= 10000			 
  DENSITY F M1_AND_DM1EXCL CHIP_AND_DM1EXCL < DM1_DN_2L WINDOW 200 STEP 100 BACKUP PRINT DM1_DN_2L.density 
                         [ !AREA(F) + AREA(M1_AND_DM1EXCL)/AREA(CHIP_AND_DM1EXCL) ]
}
DM1.DN.2H { @ M1 local density range within DM1EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um <= ^DM1_DN_2H
  ERR_WIN = DENSITY M1_AND_DM1EXCL CHIP_AND_DM1EXCL > DM1_DN_2H WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M1_AND_DM1EXCL)/AREA(CHIP_AND_DM1EXCL) ]
  F = AREA (ERR_WIN AND DM1EXCL) >= 10000			 
  DENSITY F M1_AND_DM1EXCL CHIP_AND_DM1EXCL > DM1_DN_2H WINDOW 200 STEP 100 BACKUP PRINT DM1_DN_2H.density 
                         [ !!AREA(F) * AREA(M1_AND_DM1EXCL)/AREA(CHIP_AND_DM1EXCL) ]
}
#ELSE

M1.DN.1L { @ {M1 OR DM1} local density range over 200um x 200um area stepping 100um >= ^M1_DN_1L 
  D0 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP  
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D = RECTANGLE D0 == 200
  ERR1 = ( D0 NOT D ) NOT M1_DEN_EXC
  F1 = AREA ERR1 >= 10000
  D1 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D2 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU20
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D3 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU30
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D4 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU40
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D5 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU50
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D6 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU60
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D7 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU70
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D8 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU80
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  D9 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
  ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
  F2 = AREA ( ERR2 NOT M1_DEN_EXC ) >= 10000
  F = F1 OR F2
  DENSITY F M1_NOT_EXC CHIP_NOT_M1_EXC < M1_DN_1L WINDOW 200 STEP 100 BACKUP PRINT M1_DN_1L.density 
          [  !AREA(F) + AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
}

M1.DN.1H { @ {M1 OR DM1} local density range over 200um x 200um area stepping 100um <= ^M1_DN_1H
    D0 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP   
          [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D = RECTANGLE D0 == 200
    ERR1 = ( D0 NOT D ) NOT M1_DEN_EXC
    F1 = AREA ERR1 >= 10000 
    D1 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D2 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU20
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D3 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU30
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D4 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU40
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D5 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU50
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D6 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU60
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D7 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU70
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D8 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU80
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    D9 = DENSITY M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
            [ AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC) ]
    ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
    F2 = AREA ( ERR2 NOT M1_DEN_EXC ) >= 10000
    F = F1 OR F2
    DENSITY F M1_NOT_EXC CHIP_NOT_M1_EXC > M1_DN_1H WINDOW 200 STEP 100 BACKUP PRINT M1_DN_1H.density 
          [ !!AREA(F) * (AREA(M1_NOT_EXC)/AREA(CHIP_NOT_M1_EXC)) ]
}
#ENDIF


M2_NOT_EXC    = ALL_M2 NOT M2_DEN_EXC
CHIP_NOT_M2_EXC = CHIPx NOT M2_DEN_EXC

#IFDEF CHECK_DENSITY_IN_DMxEXCL_ONLY

CHIP_AND_DM2EXCL= DM2EXCL AND CHIP_NOT_M2_EXC
M2_AND_DM2EXCL  = ALL_M2 AND CHIP_AND_DM2EXCL

DM2.DN.2L { @ M2 local density range within DM2EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um >= ^DM2_DN_2L 
  ERR_WIN = DENSITY M2_AND_DM2EXCL CHIP_AND_DM2EXCL < DM2_DN_2L WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M2_AND_DM2EXCL)/AREA(CHIP_AND_DM2EXCL) ]
  F = AREA (ERR_WIN AND DM2EXCL) >= 10000			 
  DENSITY F M2_AND_DM2EXCL CHIP_AND_DM2EXCL < DM2_DN_2L WINDOW 200 STEP 100 BACKUP PRINT DM2_DN_2L.density 
                         [ !AREA(F) + AREA(M2_AND_DM2EXCL)/AREA(CHIP_AND_DM2EXCL) ]
}
DM2.DN.2H { @ M2 local density range within DM2EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um <= ^DM2_DN_2H
  ERR_WIN = DENSITY M2_AND_DM2EXCL CHIP_AND_DM2EXCL > DM2_DN_2H WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M2_AND_DM2EXCL)/AREA(CHIP_AND_DM2EXCL) ]
  F = AREA (ERR_WIN AND DM2EXCL) >= 10000			 
  DENSITY F M2_AND_DM2EXCL CHIP_AND_DM2EXCL > DM2_DN_2H WINDOW 200 STEP 100 BACKUP PRINT DM2_DN_2H.density 
                         [ !!AREA(F) * AREA(M2_AND_DM2EXCL)/AREA(CHIP_AND_DM2EXCL) ]
}
#ELSE

M2.DN.1L { @ {M2 OR DM2} local density range over 200um x 200um area stepping 100um >= ^M2_DN_1L 
  D0 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP  
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D = RECTANGLE D0 == 200
  ERR1 = ( D0 NOT D ) NOT M2_DEN_EXC
  F1 = AREA ERR1 >= 10000
  D1 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D2 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU20
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D3 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU30
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D4 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU40
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D5 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU50
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D6 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU60
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D7 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU70
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D8 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU80
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  D9 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
  ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
  F2 = AREA ( ERR2 NOT M2_DEN_EXC ) >= 10000
  F = F1 OR F2
  DENSITY F M2_NOT_EXC CHIP_NOT_M2_EXC < M2_DN_1L WINDOW 200 STEP 100 BACKUP PRINT M2_DN_1L.density 
          [  !AREA(F) + AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
}

M2.DN.1H { @ {M2 OR DM2} local density range over 200um x 200um area stepping 100um <= ^M2_DN_1H
    D0 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP   
          [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D = RECTANGLE D0 == 200
    ERR1 = ( D0 NOT D ) NOT M2_DEN_EXC
    F1 = AREA ERR1 >= 10000 
    D1 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU10
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D2 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU20
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D3 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU30
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D4 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU40
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D5 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU50
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D6 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU60
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D7 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU70
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D8 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU80
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    D9 = DENSITY M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP INSIDE OF LAYER CHIPU90
            [ AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC) ]
    ERR2 = D INTERACT (((((((((D AND D1) AND D2) AND D3) AND D4) AND D5) AND D6) AND D7) AND D8) AND D9)
    F2 = AREA ( ERR2 NOT M2_DEN_EXC ) >= 10000
    F = F1 OR F2
    DENSITY F M2_NOT_EXC CHIP_NOT_M2_EXC > M2_DN_1H WINDOW 200 STEP 100 BACKUP PRINT M2_DN_1H.density 
          [ !!AREA(F) * (AREA(M2_NOT_EXC)/AREA(CHIP_NOT_M2_EXC)) ]
}
#ENDIF


M3_NOT_EXC    = ALL_M3 NOT M3_DEN_EXC
CHIP_NOT_M3_EXC = CHIPx NOT M3_DEN_EXC

#IFDEF CHECK_DENSITY_IN_DMxEXCL_ONLY

CHIP_AND_DM3EXCL= DM3EXCL AND CHIP_NOT_M3_EXC
M3_AND_DM3EXCL  = ALL_M3 AND CHIP_AND_DM3EXCL

DM3.DN.2L { @ M3 local density range within DM3EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um >= ^DM3_DN_2L 
  ERR_WIN = DENSITY M3_AND_DM3EXCL CHIP_AND_DM3EXCL < DM3_DN_2L WINDOW 200 STEP 100 BACKUP  
                         [ AREA(M3_AND_DM3EXCL)/AREA(CHIP_AND_DM3EXCL) ]
  F = AREA (ERR_WIN AND DM3EXCL) >= 10000			 
  DENSITY F M3_AND_DM3EXCL CHIP_AND_DM3EXCL < DM3_DN_2L WINDOW 200 STEP 100 BACKUP PRINT DM3_DN_2L.density 
                         [ !AREA(F) + AREA(M3_AND_DM3EXCL)/AREA(CHIP_AND_DM3EXCL) ]
}
DM3.DN.2H { @ M3 local density range within DM3EXCL(overlapped area >= 10000um2) over 200um x 200um area stepping 100um <= ^DM3_DN_2H
