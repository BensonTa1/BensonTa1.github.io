*     #########################################
*     #                                       #
*     #  0.18um RFCMOS pad_sh HSPICE MODEL    #
*     #                                       #  
*     #########################################
*
.subckt pad_rf 1 999 index=1 
***  index set from 1,2 3,4,5  ***
*******   Parameter cal   ********
.param indexa='6-index'
.param p_c1='(411.65-380.75*indexa+153.76*indexa*indexa-28.306*indexa*indexa*indexa+1.9421*indexa*indexa*indexa*indexa)*1e-15'
.param p_r1='65e-6*0.372*6.6711e-9/p_c1'
*index set from 1,2 3,4,5
* --------- Equivalent network -------------------
*
c 1 11 'p_c1* (1+dc_pad_rf)'
r 11 999 p_r1
*
.ends
