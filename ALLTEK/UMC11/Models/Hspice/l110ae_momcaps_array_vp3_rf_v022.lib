* Model: l110ae_momcaps_array_vp3_rf
* UMC RF vp3 array MOM capacitor
* Model coverage:
* nf: 10 - 40 (Even integer only)
* lf: (10 - 40) * 1e-06
* bm: 1 - 4
* ns: 3 - 6
* array: 1 - 4
* Frequency range: 1 MHz - 0.8 * resonance (maximum 16.0 GHz)
*
.lib tt 
.include './l110ae_momcaps_array_vp3_rf_v022.mdl'
.param
+d_cs3=1
*
+dcj_dionw_l110e_vp3       =   0                 
+dcjp_dionw_l110e_vp3      =   0
*
.endl tt
*
.lib ff
.include './l110ae_momcaps_array_vp3_rf_v022.mdl'
.param
+d_cs3=0.85
*                      
+dcj_dionw_l110e_vp3       =   -8.28e-006                 
+dcjp_dionw_l110e_vp3      =   -9.92e-011
*                      
.endl ff
*
.lib ss
.include './l110ae_momcaps_array_vp3_rf_v022.mdl'
.param
+d_cs3=1.15
*                      
+dcj_dionw_l110e_vp3       =   8.28e-006                 
+dcjp_dionw_l110e_vp3      =   9.92e-011
*                      
.endl ss
