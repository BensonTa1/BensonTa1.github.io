**********************************************************************
*            P+/Nwell Junction Varactor RF subcircuit model
*            UMC 0.11um RFCMOS process 
* 
*            2010/07/20 Ho Cheng Hu
* 
*            Model coverage:
*            1. P+ finger width (wp): 0.28um ~ 2um
*            2. P+ finger length (l): 0.5um ~ 18um
*            3. P+ finger number: 4 ~16 
*            4. Frequency range: 0.1 ~ 20.1GHz
*            5. Temperature Range: -55C to 125C
* 
*            Node definition:
*            1. pplus:  p+
*            2. nwell:  nwell
*            3. sub:  psub
**********************************************************************
* 
.subckt vardiop_rf pplus nwell sub
.param l=10u wp=1u nf=8 m=8
+ p_area='l*wp*nf' 	
+ p_peri='2*(l+wp)*nf'
+ nw_area='(nf*(wp+0.44u)+(nf+1)*0.3u+0.52u)*(l+1.34u)'
+ nw_peri='2*(nf*(wp+0.44u)+(nf+1)*0.3u+l+1.86u)'

.param re_unit='4.5e18*(8e-10*pow((wp*0.9),2)-1e-9*pow((wp*0.9),1)+1e-9)*(3e-11*(l*0.9)+4e-10)*(-1e-11*nf+6e-10)'
.param rsh_nw='1e3'
.param cf_m1='3.5e20*(-5e-11*(wp*0.9)+6e-11)*(-9e-13*(l*0.9)+7e-11)*(-2e-13*nf+6e-11)'
.param rsub_unit='6.31*pow(wp*0.9/l*0.9/nf,2)-0.1254*(wp*0.9/l*0.9/nf)+0.0014'
* 
* ----- Equivalent network ------------------
*
re 55 1 're_unit/(l*0.9*wp*0.9*nf)*(1+d_re_unit)'
cf 55 66 '2*cf_m1*l*0.9*nf*(1+d_cf_m1)'
dppnw 1 2 ppnw_dio area='p_area' pj='p_peri'
rb 2 66 'rsh_nw*0.11u/(l*0.9*nf)*(1+d_rsh_nw)'
dnwpsub 3 2 nwpsub_dio area='nw_area' pj='nw_peri'
rsub 3 sub 'rsub_unit/nw_peri'
l1 pplus 55 '1e-14*pwr(l*0.9*wp*0.9*nf,-0.290)'
l2 66 nwell '1e-14*pwr(l*0.9*wp*0.9*nf,-0.290)'
*
* -------------------------------------------
*
*----- diode models ------------
.model ppnw_dio d                                                                                           
+level    = 3                                     js       = 1.21e-07            jsw      = 1.08e-13        
+n        = 1.017                                 rs       = 0	                 bv       = 10.64            
+eg       = 1.16                                                                                            
+tref     = 25.0                                  xti      = 3.0                 tlevc	  = 1                
+cj       = '9.69e-004*(1+d_cjo_ppnw)'            mj       = 0.308               pb       = 0.687           
+cjsw     = '1.18e-010*(1+d_cjsw_ppnw)'           mjsw     = 0.1                 php      = 0.45            
+tpb      = 0.0017088                             tphp     = 0.0025864           cta      = 0.0010049       
+ctp      = 0.0005243                                                                                       
                                                                                                            
.model nwpsub_dio d                                                                                         
+level    = 3                                     js       = 2.05e-06            jsw      = 5.34e-11        
+n        = 1.0525                                rs       = 0            	     bv       = 9.662            
+eg       = 1.16                                                                                            
+tref     = 25.0                                  xti      = 5.4936              tlevc	  = 1                
+cj       = '0.0000828*(1+d_cjo_nwpsub)'          mj       = 0.474               pb       = 0.588           
+cjsw     = '9.92e-10*(1+d_cjsw_nwpsub)'          mjsw     = 0.27                php      = 0.62            
+tpb      = 0.0028                                tphp     = 0.001               cta      = 0.00332         
+ctp      = 0.001                                                                                           
**
.ends 
