.param igr= '2.1e-7*area/(l*0.9+1.2e-8)*exp(-vdr)*pwr(1/toxg,2.0)'
gigcd n2 n1 cur="igf*pwr((abs(v(n2,n1))+v(n2,n1))/2,vaf)-igr*pwr((abs(v(n2,n1))-v(n2,n1))/2,var)"
gigcs n2 n3 cur="igf*pwr((abs(v(n2,n3))+v(n2,n3))/2,vaf)-igr*pwr((abs(v(n2,n3))-v(n2,n3))/2,var)"
rdn n1 n11  'rsh*nrd'
rsn n3 n33  'rsh*nrs'
.ends
*
.endl igate




