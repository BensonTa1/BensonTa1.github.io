*
.lib igate
.subckt n_12_spl110e_ig n11 n2 n33 n4 w=1u l=1u nrd='hdif/w' nrs='hdif/w'
+  ad='2*hdif*w' as='2*hdif*w' pd='2*(2*hdif+w)' ps='2*(2*hdif+w)' dtemp=0 sa=2u sb=2u
*
mnig n1 n2 n3 n4 n_12_spl110e w=w l=l m=1 nrd=nrd nrs=nrs ad=ad as=as pd=pd ps=ps dtemp=dtemp sa=sa sb=sb
.param rsh='8.5'
.param hdif='1.25e-07'
.param tcig='1+1.55e-3*(temper+dtemp-25)'
.param area='w*0.9*(l*0.9+1.2e-8)*1e4*tcig'
.param toxg='(2.64e-09+dtox_n_12_spl110e)*1e2'
.param vdf0='3.11' vdfl='-0.3e-08' vdfw='3.5e-09'
.param vaf0='0.7' vafl='-0.8e-10' vafw='1.0e-10'
.param vdr0='5.78' vdrl='0e-07' vdrw='5.0e-09'
.param var0='0.60' varl='0e-07' varw='1.0e-10' 
.param vdf= '(vdf0+vdfl/(l*0.9+1.2e-8)+vdfw/(w*0.9))*2.6e7*toxg'
.param vaf= '(vaf0+vafl/(l*0.9+1.2e-8)+vafw/(w*0.9))*2.6e7*toxg'
.param vdr= '(vdr0+vdrl/(l*0.9+1.2e-8)+vdrw/(w*0.9))*2.6e7*toxg'
.param var= '(var0+varl/(l*0.9+1.2e-8)+varw/(w*0.9))*2.6e7*toxg'
.param igf= '2.1e-7*area*exp(-vdf)*pwr(1/toxg,2.0)'
.param igr= '2.1e-7*area/(l*0.9+1.2e-8)*exp(-vdr)*pwr(1/toxg,2.0)'
gigcd n2 n1 cur="igf*pwr((abs(v(n2,n1))+v(n2,n1))/2,vaf)-igr*pwr((abs(v(n2,n1))-v(n2,n1))/2,var)"
gigcs n2 n3 cur="igf*pwr((abs(v(n2,n3))+v(n2,n3))/2,vaf)-igr*pwr((abs(v(n2,n3))-v(n2,n3))/2,var)"
rdn n1 n11  'rsh*nrd'
rsn n3 n33  'rsh*nrs'
.ends
*
.subckt p_12_spl110e_ig p11 p2 p33 p4 w=1u l=1u nrd='hdif/w' nrs='hdif/w'
+  ad='2*hdif*w' as='2*hdif*w' pd='2*(2*hdif+w)' ps='2*(2*hdif+w)' dtemp=0 sa=2u sb=2u
*
mpig p1 p2 p3 p4 p_12_spl110e w=w l=l m=1 nrd=nrd nrs=nrs ad=ad as=as pd=pd ps=ps dtemp=dtemp sa=sa sb=sb
.param rsh='7.6'
.param hdif='1.25e-07'
.param tcig='1+2.25e-3*(temper+dtemp-25)'
.param area='w*0.9*(l*0.9+1.2e-8)*1e4*tcig'
.param toxg='(2.83e-09+dtox_p_12_spl110e)*1e2'
.param vdf0='3.22' vdfl='-7.00e-09' vdfw='-6.0e-8'
.param vaf0='0.6' vafl='-1.5e-08' vafw='-3.0e-8'
.param vdr0='5.50' vdrl='+1.50e-08' vdrw='-1.0e-07'
.param var0='0.35' varl='+1.50e-08' varw='4.0e-8' 
.param vdf= '(vdf0+vdfl/(l*0.9+1.2e-8)+vdfw/(w*0.9))*2.6e7*toxg'
.param vaf= '(vaf0+vafl/(l*0.9+1.2e-8)+vafw/(w*0.9))*2.6e7*toxg'
.param vdr= '(vdr0+vdrl/(l*0.9+1.2e-8)+vdrw/(w*0.9))*2.6e7*toxg'
.param var= '(var0+varl/(l*0.9+1.2e-8)+varw/(w*0.9))*2.6e7*toxg'
.param igf= '2.1e-7*area*exp(-vdf)*pwr(1/toxg,2.0)'
.param igr= '2.1e-7*area/(l*0.9+1.2e-8)*exp(-vdr)*pwr(1/toxg,2.0)'
gigcd p2 p1 cur="-igf*pwr((abs(v(p2,p1))-v(p2,p1))/2,vaf)+igr*pwr((abs(v(p2,p1))+v(p2,p1))/2,var)"
gigcs p2 p3 cur="-igf*pwr((abs(v(p2,p3))-v(p2,p3))/2,vaf)+igr*pwr((abs(v(p2,p3))+v(p2,p3))/2,var)"
rdp p1 p11  'rsh*nrd'
rsp p3 p33  'rsh*nrs'

.ends
