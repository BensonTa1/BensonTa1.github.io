********************************************************************************
* TYP: Typical capacitor
* MIN: Minimum capacitor
* MAX: Maximum capacitor
* DEVICE 1: pcap_12
********************************************************************************

.lib typ 
.param
*DEVICE 1
+  dtoxe_pcap_12       =   0.0000e+00 
+  dxl_pcap_12         =   0.0000e+00
+  dxw_pcap_12         =   0.0000e+00   
+  dcmina_pcap_12   =   0.0000e+00     
.include 'l110ae_pcap12_v012.mdl'
.endl typ 

.lib min 
.param
*DEVICE 1
+  dtoxe_pcap_12       =  6.0000e-11
+  dxl_pcap_12         =  -3.6e-02     
+  dxw_pcap_12         =  -2e-01  
+  dcmina_pcap_12   =  4.0
.include 'l110ae_pcap12_v012.mdl'
.endl min 

.lib max 
.param
*DEVICE 1
+  dtoxe_pcap_12       =  -6.000e-11
+  dxl_pcap_12         =  3.3e-02  
+  dxw_pcap_12         =  1.50e-01
+  dcmina_pcap_12   =  -3.0
.include 'l110ae_pcap12_v012.mdl'
.endl max 


