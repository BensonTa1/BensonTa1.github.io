* the written consent of the UMC ATD Modeling Division.
********************************************************************************
* Process:      UMC 0.11 um Logic and Mixed-Mode 1P8M Metal Metal Capacitor Al Advanced Enhancement Process
* Description:  1.2V NCAP
* Simulator:    HSPICE 
* Model Version:0.5p1
* Model features:
*     Global model:  Yes
*     Gate current model:  No
*     Substrate Current model: No
*     Flicker Noise: No
*     LOD model: No
*     RF model: No
*     Well proximity effect: No
*     Mis-matching: No
********************************************************************************
* Revision history:
* <Revision 1>
* Version : 0.5p1
* Date    : 2016/04/13
* Author  : Kelly pao
* Remark  : Revised the Igate parameter in spectre model cards.
********************************************************************************
* Application ranges:
* Geometry range:
*
* For Vcc=1.2 V NCAP:
* 0.15 um <= LF <= 2 um
* 2.5 um <= WF <= 10 um
* 2 <= Nf <= 8 
*
* Voltage range:
* For 1.2 V NCAP:
* -1.2V(*1.1) <= VGS <= 1.2V(*1.1) 
* VDS = VBS = 0V
*
* Temperature range: -50c ~ 125c ; nominal temperature=25c
***************************** start of model card ******************************

.subckt ncap_12 port1 port2 wf=1u lf=1u nf=2 nrd='hdif/(wf*0.9)' nrs='hdif/(wf*0.9)'
+  ad='2*hdif*(wf*0.9)' as='2*hdif*(wf*0.9)' pd='2*(2*hdif+(wf*0.9))' ps='2*(2*hdif+(wf*0.9))' dtemp=0 sa=2u sb=2u



.param toxc='2.83e-09+dtoxe_ncap_12'       
.param pva=0.24471966   
.param pvb='0.72116211+tpvb*(temp-25)'
.param pvc='0.66326301+tpvc*(temp-25)'
.param pvd=4.9124924  
.param pve=1.2121193
.param pvf=-1.2402805
.param pvg=0.099855236
.param pvh=-0.84471911
.param pvi=-0.49592303
.param pvj=-0.65302372
.param pvk=-0.25419574
.param tpvb=0.0002 tpvc=-5.279e-05 
.param temp='temper'
                

                
.param dcw='-0.01618+1e6*dxw_ncap_12' cww=0.1 cwl=-0.004271 cwwl=0.01599 
.param dcl='-0.02211+1e6*dxl_ncap_12' cll=-0.002303 clw=0.05 clwl=-0.003822

.param weff='(wf*0.9*1e6)+dcw+cww/(wf*0.9*1e6)+cwl/(lf*0.9*1e6+0.012)+cwwl/(wf*0.9*1e6)/(lf*0.9*1e6+0.012)'
.param leff='(lf*0.9*1e6+0.012)+dcl+cll/(lf*0.9*1e6+0.012)+clw/(wf*0.9*1e6)+clwl/(wf*0.9*1e6)/(lf*0.9*1e6+0.012)'         


.param cl3=9.594e-05 cl2=-0.0004231
.param cl1=-0.000206 cl0=0.001223
.param cw0=0 cwl0=0 

.param ccom='(((cl3*pow((lf*0.9*1e6+0.012),3)+cl2*pow((lf*0.9*1e6+0.012),2)+cl1*(lf*0.9*1e6+0.012)+cl0)*((wf*0.9*1e6)+dcw)+cw0/(wf*0.9*1e6))*(1+cwl0/((wf*0.9*1e6)*(lf*0.9*1e6+0.012))))'              

              
c1 port1 port2 '((pva+pvc*pow(v(port1, port2),1)+pve*pow(v(port1, port2),2)+pvg*pow(v(port1, port2),3)+pvi*pow(v(port1, port2),4)+pvk*pow(v(port1, port2),5))/(1+pvb*pow(v(port1, port2),1)+pvd*pow(v(port1, port2),2)+pvf*pow(v(port1, port2),3)+pvh*pow(v(port1, port2),4)+pvj*pow(v(port1, port2),5))*2.83e-09*weff*leff/toxc/4.5/1.812/4+ccom*2.83e-09/toxc/4)*nf*1e-12*(1+cmina*(cminb+atan((v(port1, port2)-cminc)/cmind)))'
.param cmina='0+dcmina_ncap_12' cminb=-1.409080588  cminc=-0.040071884  cmind=0.18900929


*Igate simulation
.param rsh='7.6'
.param hdif='1.25e-07'
.param tcig='1+2.25e-3*(temper+dtemp-25)'
.param area='wf*0.9*(lf*0.9+0.012u)*nf*1e4*tcig'
.param toxg='(2.83e-09+dtoxe_ncap_12)*1e2'
.param vdf0=2.8 vdfl=-1e-008 vdfw=1.7e-007  
.param vaf0=0.6 vafl=5e-009 vafw=1e-008  
.param vdr0=5.2 vdrl=4e-008 vdrw=-1.7e-007 
.param var0=0.2 varl=-0e-008 varw=8e-008
.param vdf= '(vdf0+vdfl/(lf*0.9+0.012u)+vdfw/(wf*0.9))*2.6e7*toxg'
.param vaf= '(vaf0+vafl/(lf*0.9+0.012u)+vafw/(wf*0.9))*2.6e7*toxg'
.param vdr= '(vdr0+vdrl/(lf*0.9+0.012u)+vdrw/(wf*0.9))*2.6e7*toxg'
.param var= '(var0+varl/(lf*0.9+0.012u)+varw/(wf*0.9))*2.6e7*toxg'
.param igf= '2.1e-7*area*exp(-vdf)*pwr(1/toxg,2.0)'
.param igr= '2.1e-7*area/(lf*0.9+0.012u)*exp(-vdr)*pwr(1/toxg,2.0)'
gigcd port1 port2 cur='igf*pwr((abs(v(port2,port1))-v(port2,port1))/2,vaf)-igr*pwr((abs(v(port2,port1))+v(port2,port1))/2,var)'
gigcs port1 port2 cur='igf*pwr((abs(v(port2,port1))-v(port2,port1))/2,vaf)-igr*pwr((abs(v(port2,port1))+v(port2,port1))/2,var)'





.ends ncap_12
