.param var0='0.60' varl='0e-07' varw='1.0e-10' 
.param vdf= '(vdf0+vdfl/(l*0.9+8e-9)+vdfw/(w*0.9))*2.6e7*toxg'
.param vaf= '(vaf0+vafl/(l*0.9+8e-9)+vafw/(w*0.9))*2.6e7*toxg'
