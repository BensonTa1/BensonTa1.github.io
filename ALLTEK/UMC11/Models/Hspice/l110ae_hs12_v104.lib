mnig n1 n2 n3 n4 n_12_hsl110e w=w l=l m=1 nrd=nrd nrs=nrs ad=ad as=as pd=pd ps=ps dtemp=dtemp sa=sa sb=sb
.param rsh='8.5'
.param hdif='1.25e-07'
.param tcig='1+1.55e-3*(temper+dtemp-25)'
.param area='w*0.9*(l*0.9+8e-9)*1e4*tcig'
.param toxg='(2.64e-09+dtox_n_12_hsl110e)*1e2'
.param vdf0='3.11' vdfl='-0.3e-08' vdfw='3.5e-09'
.param vaf0='0.7' vafl='-0.8e-10' vafw='1.0e-10'
