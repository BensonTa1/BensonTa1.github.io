***************************************************************************
*       L110AE RF Bonding Pad V.02p1
*       January  2010 by Ji Wei Hsu 
*
*      This model support
*         1. Metal layer option ( 1P8M) 
*         2. Metal thickness option (40.0K)
*         3. pad type  (50um BOAC  pad)
***************************************************************************  
*  Note : 1. One PORT MODEL for Pads      
*         2. Input parameters
*
*           (1) Metal layer option  
*            index_layer=8   (1P8M process ==> with Al,M8+sub(Ground))
*           (2) Top metal thickness
*            index_thick=1   (top metal thickness=40.0K)
*           (3) Pad type
*            index_pad=1      50 um BOAC pad(pad width=53um, pad length=80.2um)
*
*
*
.subckt pad_rf top sub
.param index_layer=8 index_thick=1 index_pad=1
+ cox811=3.02e-14 
+ csi811=2.92e-14  
+ rsi811=110.5  
+ il8='(1-sgn(abs(8-int(index_layer))))'
+ it1='(1-sgn(abs(1-int(index_thick))))'
+ ip1='(1-sgn(abs(1-int(index_pad))))'
+ i_cox811='il8*it1*ip1*cox811'
+ i_csi811='il8*it1*ip1*csi811'
+ i_rsi811='il8*it1*ip1*rsi811'
+ p_cox='i_cox811'
+ p_csi='i_csi811'
+ p_rsi='i_rsi811'
* --------- Equivalent network -------------------
*
cox top 11  'p_cox*(1+d_cpad)'
csi  11  sub 'p_csi'
rsi  11  sub 'p_rsi'
.ends
*
