********************************************************************************
* TYP: Typical capacitor
* MIN: Minimum capacitor
* MAX: Maximum capacitor
* DEVICE 1: pcap_33 
********************************************************************************

.lib typ 
.param
+  dtoxe_pcap_33        =   0.0000e+00 
+  dxl_pcap_33          =   0.0000e+00
+  dxw_pcap_33          =   0.0000e+00   
+  dcmin_pcap_33    =   0     
.include 'l110ae_pcap33_v012.mdl'
.endl typ 

.lib min 
.param
+  dtoxe_pcap_33       =  1.52e-10
+  dxl_pcap_33         =  -1.906e-8     
+  dxw_pcap_33         =  -3.813977e-7  
+  dcmin_pcap_33   =  24.6
.include 'l110ae_pcap33_v012.mdl'
.endl min 

.lib max 
.param
+  dtoxe_pcap_33       =  -1.52e-10       
+  dxl_pcap_33         =  1.408e-8       
+  dxw_pcap_33         =  4.37472e-7       
+  dcmin_pcap_33   =  -19.57       
.include 'l110ae_pcap33_v012.mdl'
.endl max 
