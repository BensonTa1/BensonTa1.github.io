+ cle=0.8918                xpart=1                   lwc=-2.901e-015
+ lwlc=3.798e-022           wlc=9.17e-017             wwc=-9.192e-013
+ wwlc=p_wwlc               llc=p_llc                 
+ vth0=p_vth0 + dvth0_p_33_l110aerf                   
+ pvth0=p_pvth0 + dpvth0_p_33_l110aerf                
+ lvth0=p_lvth0 + dlvth0_p_33_l110aerf                k1=0.921
+ k2=-0.01962               k3=1.126 + dk3_p_33_l110aerf
+ wk3=-1.09e-007            pk3=-2.4e-014             k3b=0.5428
