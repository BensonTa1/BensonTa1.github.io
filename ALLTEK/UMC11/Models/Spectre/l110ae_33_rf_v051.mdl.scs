+ lu0=-5.136e-010           ua=1.77e-009              ub=8.275e-019
+ uc=-2.347e-011            wuc=-1e-017               ngate=1.519e+020
+ xj=1.17e-007              w0=7.745e-008             prwg=0.2582
+ prwb=-0.1182              pprwb=-1.366e-015         wr=1.267
+ rdsw=618.1 + drdsw_p_33_l110aerf                    a0=p_a0
+ ags=p_ags                 lags=p_lags          pags=p_pags
+ a1=3.722e-005             a2=0.9                    la0=0
+ b0=2.832e-008             b1=9.996e-007             vsat=p_vsat
+ lvsat=p_lvsat             keta=-0.01525             lketa=-8.646e-009
+ pketa=-1.256e-016         dwg=-6.061e-008           dwb=-3.646e-009
+ alpha0=4.463e-006         beta0=29.6                pclm=1.933
+ pdiblc1=0.2938            pdiblc2=0.002229          pdiblcb=0
