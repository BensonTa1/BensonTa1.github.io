+ cgdl=p_cgdl * (1 + dcgdl_p_33_l110aerf)             
+ cgsl=p_cgdl * (1 + dcgsl_p_33_l110aerf)             ckappa=1
+ vfbcv=-1                  acde=1.049                moin=5.671
+ noff=2.21                 voffcv=-0.03762           lvoffcv=0
