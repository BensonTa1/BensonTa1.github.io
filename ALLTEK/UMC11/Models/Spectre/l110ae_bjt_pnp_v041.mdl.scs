//      0V <= VEC <= 3.3V   
//    -1uA <= IB  <= -5uA   
//    
//  ********************* Vertical PNP BJT With SAB  ***********************   
//   Device Name   (Base Area)  : Emitter Area(um^2)    
//  pnp_sv45x45_l110e (11.7*11.7) :   4.5*4.5   
//  pnp_sv90x90_l110e (16.2*16.2) :   9.0*9.0    
//  pnp_sv135x135_l110e (20.7*20.7) :  13.5*13.5    
