statistics {
    process {
        vary mc_rend_rnnpo_l110e dist=gauss std=sigma/3
        vary mc_rs_rnnpo_l110e dist=gauss std=sigma/3
        vary mc_dw_rnnpo_l110e dist=gauss std=sigma/3
        vary mc_rend_rnppo_l110e dist=gauss std=sigma/3
        vary mc_rs_rnppo_l110e dist=gauss std=sigma/3
        vary mc_dw_rnppo_l110e dist=gauss std=sigma/3
        vary mc_rend_rnnd_l110e dist=gauss std=sigma/3
        vary mc_rs_rnnd_l110e dist=gauss std=sigma/3
        vary mc_dw_rnnd_l110e dist=gauss std=sigma/3
        vary mc_rend_rnpd_l110e dist=gauss std=sigma/3
        vary mc_rs_rnpd_l110e dist=gauss std=sigma/3
        vary mc_dw_rnpd_l110e dist=gauss std=sigma/3
        vary mc_rend_rnhr1000_l110e dist=gauss std=sigma/3
        vary mc_rs_rnhr1000_l110e dist=gauss std=sigma/3
        vary mc_dw_rnhr1000_l110e dist=gauss std=sigma/3
        vary mc_rs_rsnd_mml110e dist=gauss std=sigma/3
        vary mc_rs_rspd_mml110e dist=gauss std=sigma/3
        vary mc_rs_rsnpo_mml110e dist=gauss std=sigma/3
        vary mc_rs_rsppo_mml110e dist=gauss std=sigma/3
        vary mc_rs_rnwell_mml110e dist=gauss std=sigma/3
