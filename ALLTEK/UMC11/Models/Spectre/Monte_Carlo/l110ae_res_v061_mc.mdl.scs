parameters vmax=i1*r

d1 ( sub n1 ) dionw_l110e area=(w+dw)*l/2 perim=(w+dw)+l m=1
rnwell_mml110e ( n1 n2 ) bsource r=(rs*l*0.9/(w*0.9+dw))*(1.0+(vc0+vc1*min(v(n1),v(n2))+vc2*pow(min(v(n1),v(n2)),2))*abs(v(n1,n2)))*tcoef*(1+pr_ma_snwell) bv_max=vmax m=1
d2 ( sub n2 ) dionw_l110e area=(w+dw)*l/2 perim=(w+dw)+l m=1

model dionw_l110e diode level = 3
+ hcomp=1.0000e+00 imax=1.00e+14
//**************************************************************
//*               GENERAL PARAMETERS 
//**************************************************************
+area    = 1.68e-007       perim      = 0.00469         tnom    = 25            
//**************************************************************
//*               DC PARAMETERS 
//**************************************************************
+is      = 2.05e-006       isw     = 5.34e-011       ik      = 17856           bv      = 9.662         
+ibv     = 5.952           ikr     = 595.2           n       = 1.0525          rs      = 3.0891e-007 
//**************************************************************
//*               CAPACITANCE PARAMETERS 
//**************************************************************
+cjo      = 8.28e-005  cjp     = 9.92e-010  vj      = 0.588           vjsw     = 0.62          
+mj      = 0.474           mjsw    = 0.27          
//**************************************************************
//*               NOISE PARAMETERS 
//**************************************************************
//**************************************************************
//*               TEMPERATURE PARAMETERS 
//**************************************************************
+tlev    = 1               tlevc   = 1               trs     = 0.00322         tbv1     = -0.000539     
+xti     = 5.4936          cta     = 0.00332         ctp     = 0.001           eg      = 1.16          
+pta     = 0.0028          ptp    = 0.001
ends rnwell_mml110e


//****************************************************************************************************************
//*             M1 RESISTOR SUBCIRCUIT NETLIST FOR TYPICAL CASE
//****************************************************************************************************************
inline subckt r_m1_l110e ( n1 n2 )
parameters w=1.44e-07  l=1.00e-05 mis_flag=1  mf=1
//.prot
parameters arsm1 = 0.000e+00
parameters dr_ma_sm1_xx = arsm1/sqrt(2*w*0.9*l*0.9*mf*1e12)
parameters pr_ma_sm1 = dr_ma_sm1_xx * mc_res_ma_sm1  * mis_flag
//.unprot
parameters rs=(170e-03+drs_rsm1_l110e)
parameters tc1= 3.203e-03  tc2=-4.119e-07 
parameters tcoef = 1.0+tc1*(temp-25.0)+tc2*pow((temp-25.0),2)

r_m1_l110e ( n1 n2 ) resistor r=(rs*(l*0.9)/(w*0.9))*tcoef*(1+pr_ma_sm1) m=1

ends r_m1_l110e

//****************************************************************************************************************
//*             1X RESISTOR SUBCIRCUIT NETLIST FOR TYPICAL CASE
//****************************************************************************************************************
inline subckt r_1x_l110e ( n1 n2 )
parameters w=1.8e-07  l=1.00e-05 mis_flag=1  mf=1
//.prot
parameters ars1x = 0.000e+00
parameters dr_ma_s1x_xx = ars1x/sqrt(2*w*0.9*l*0.9*mf*1e12)
parameters pr_ma_s1x = dr_ma_s1x_xx * mc_res_ma_s1x  * mis_flag
//.unprot
parameters rs=(130e-03+drs_rsm2_l110e)
parameters tc1= 3.304e-03  tc2=-4.983e-07 
parameters tcoef = 1.0+tc1*(temp-25.0)+tc2*pow((temp-25.0),2)

r_1x_l110e ( n1 n2 ) resistor r=(rs*(l*0.9)/(w*0.9))*tcoef*(1+pr_ma_s1x) m=1

ends r_1x_l110e

//****************************************************************************************************************
//*             2X AS TOP METAL WITH 8KA THICKNESS RESISTOR SUBCIRCUIT NETLIST FOR TYPICAL CASE
//****************************************************************************************************************
inline subckt r_2x_l110e ( n1 n2 )
parameters w=3.96e-07  l=1.00e-05 mis_flag=1  mf=1
//.prot
parameters ars2x = 0.000e+00
parameters dr_ma_s2x_xx = ars2x/sqrt(2*w*0.9*l*0.9*mf*1e12)
parameters pr_ma_s2x = dr_ma_s2x_xx * mc_res_ma_s2x  * mis_flag
//.unprot
parameters rs=(35e-03+drs_rsm6t_8k_l110e)
parameters tc1= 3.415e-03  tc2=-2.26e-07 
parameters tcoef = 1.0+tc1*(temp-25.0)+tc2*pow((temp-25.0),2)

r_2x_l110e ( n1 n2 ) resistor r=(rs*(l*0.9)/(w*0.9))*tcoef*(1+pr_ma_s2x) m=1

ends r_2x_l110e
