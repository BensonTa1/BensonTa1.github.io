//****************************************************************************************************************
//*             non-salicide n+poly resistor subcircuit netlist for typical case                                *
//****************************************************************************************************************
//*  process: 0.11 um logic and mixed-mode metal metal capacitor al enhancement process resistor model
//*  non-salicide n+poly resistor  is copied from l110eal_res_vt11
//* temperature range: -55c ~ 135c ; nominal temperature  =  25c.
//*
simulator lang=spectre insensitive=yes
inline subckt rnnpo_l110e ( n1 n2 well )
parameters w  =  1.00e-05  l  =  1.00e-05 mis_flag=1 mf=1
parameters arnnpo = 5.780e-02
parameters dr_ma_nnpo_xx = arnnpo/sqrt(2*w*0.9*l*0.9*mf*1e12)
parameters pr_ma_nnpo = dr_ma_nnpo_xx * mc_res_ma_nnpo  * mis_flag

parameters rend  =  1.5e-5+drend_rnnpo_l110e rs  =  113+drs_rnnpo_l110e dw  =  -7.05e-8+ddw_rnnpo_l110e
parameters vcr1  =  0   vcr2  =  -0.0258e-12  tc1  =  1.6e-4  tc2  =  2.81e-7  
parameters tcoef   =  1.0+tc1*(temp-25.0)+tc2*pow((temp-25.0),2)
+ca     =   1.1524e-04

parameters jmax=5.0e-4
parameters i1=jmax*w*1e6
parameters r=((2*rend/(w*0.9+dw))+(rs*l*0.9/(w*0.9+dw)))
parameters vmax=i1*r

c1 ( n1 well ) capacitor c=ca*(w*0.9+dw)*l*0.9/2 m=1
rnnpo_l110e ( n1 n2 ) res2 r=((2*rend/(w*0.9+dw))+(rs*l*0.9/(w*0.9+dw)))*((1.0+(vcr1*v(n1,n2)/(l*0.9)))+((vcr2*pow((v(n1,n2))/(l*0.9),2))))*tcoef*(1+pr_ma_nnpo) bv_max=vmax m=1
//****************************************************************************************************************
model res2 resistor 
+ w=w l=l 
+kf=1.37e-022   af=1.95000e+000 fexp=9.35e-001 wdexp=0.95500e+000 ldexp=1.0100e+000  

c2 ( n2 well ) capacitor c=ca*(w*0.9+dw)*l*0.9/2 m=1

ends rnnpo_l110e
