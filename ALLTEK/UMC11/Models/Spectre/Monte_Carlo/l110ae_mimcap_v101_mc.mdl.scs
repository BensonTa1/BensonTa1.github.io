//* Remark  : 1. This Monte Carlo model including both process and mis-matching characteristics is
//*              extracted from l110ae_mimcap_v021.mdl l110ae_mimcap_v021.lib 
//* <Revision 3>
//* Version : 0.3 p1
//* Date    : 2010 / 12 / 09
//* Author  : Hung Wei Liao
//* Remark  : 1. This Monte Carlo model including both process and mis-matching characteristics is 
//*              extracted from l110ae_mimcap_v031.mdl l110ae_mimcap_v031.lib 
//*           2. Add 1.5fF, 2.0fF MIM Monte Carlo Model 
//*  <Revision 4>   
//*  Version : 0.4 p1   
//*  Date  : 2012/09/28 
//*  Author  : Ji Wei Hsu   
//*  Remark  : 1. Modify 2.0fF MIM Monte Carlo Model 
//*            2. This Monte Carlo model including both process and mis-matching characteristics is
//*               extracted from l110ae_mimcap_v041.mdl l110ae_mimcap_v041.lib 
//*  <Revision 5>   
//*  Version : 0.5 p1   
//*  Date  : 2013/08/13 
//*  Author  : Ting Huei Wang   
//*  Remark  :1. Change 20f MIMCAP Model minimum size from 4.8*4.8(um2) to 3.4*3.4(um2) 
//*           2. This Monte Carlo model including both process and mis-matching characteristics is *              extracted from l110ae_mimcap_v051.mdl l110ae_mimcap_v051.lib.
//* <Revision 5>   
//* Version : 0.6 p1   
//* Date  : 2015/04/22 
//* Author  : Zung Jie Han   
//* Remark  : 1. Change 20f MIMCAP Model "cf" parameter from 4.96e-11 to 4.95e-11
//*           2. This Monte Carlo model including both process and mis-matching characteristics is
//*              extracted from l110ae_mimcap_v061.mdl l110ae_mimcap_v061.lib .
//* <Revision 6>   
//* Version : 1.0 p1   
//* Date  : 2016/06/15
//* Author  : Tzu Kang Hsiung  
//* Remark  : 1. Modify  15f and 10f MIMCAP Model based on new silicon data .
//*           2. Add trend chart of mapping data into the baseband document .
//*           3. Revise  the  verification  figure (with VC & with  TC)  of  2.0fF MIMCAP  in the baseband
//*              document .
//*           4. This Monte Carlo model including both process and mis-matching characteristics is extracted  
//*              from l110ae_mimcap_v101.mdl l110ae_mimcap_v101.lib  .
//*******************************************************************************
simulator lang=spectre insensitive=yes
inline subckt mimcaps_10f_mml110e ( n1 n2 )
parameters  l=10e-6 w=10e-6 mis_flag=1 mf=1
parameters amim = 0.723e-02
parameters dc_ma_mim_xx = amim/sqrt(2*w*l*0.81*mf*1e12)
parameters pc_ma_mim = dc_ma_mim_xx * mc_mimcap_10f_ma  * mis_flag
parameters dt=temp-25      
parameters ca=1.0e-3
parameters cf=4.63e-11
mimcaps_10f_mml110e ( n1 n2 ) bsource c=((l*0.9*w*0.9*ca)*(1+d_ca_mimcaps_10f_mml110e)+2*cf*(l*0.9+w*0.9))*(1+1.12e-5*dt+9.0e-9*dt*dt)*(1-2.81e-5*v(n1,n2)-2.17e-6*v(n1,n2)*v(n1,n2))*(1+pc_ma_mim) 


ends mimcaps_10f_mml110e
//*//
inline subckt mimcaps_15f_mml110e ( n1 n2 )
parameters  l=10e-6 w=10e-6 mis_flag=1 mf=1
parameters amim = 0.725e-02
parameters dc_ma_mim_xx = amim/sqrt(2*w*l*0.81*mf*1e12)
parameters pc_ma_mim = dc_ma_mim_xx * mc_mimcap_15f_ma  * mis_flag
parameters dt=temp-25      
parameters ca=1.5e-3
parameters cf=3.98e-11
mimcaps_15f_mml110e ( n1 n2 ) bsource c=((l*0.9*w*0.9*ca)*(1+d_ca_mimcaps_15f_mml110e)+2*cf*(l*0.9+w*0.9))*(1+1.58e-5*dt+2.90e-9*dt*dt)*(1-6.84e-6*v(n1,n2)+5.67e-6*v(n1,n2)*v(n1,n2))*(1+pc_ma_mim) 

ends mimcaps_15f_mml110e
//*//
inline subckt mimcaps_20f_mml110e ( n1 n2 )
parameters  l=10e-6 w=10e-6 mis_flag=1 mf=1
parameters amim = 0.683e-02
parameters dc_ma_mim_xx = amim/sqrt(2*w*l*0.81*mf*1e12)
parameters pc_ma_mim = dc_ma_mim_xx * mc_mimcap_20f_ma  * mis_flag
parameters dt=temp-25      
parameters ca=2e-3
parameters cf=4.95e-11
mimcaps_20f_mml110e ( n1 n2 ) bsource c=((l*0.9*w*0.9*ca)*(1+d_ca_mimcaps_20f_mml110e)+2*cf*(l*0.9+w*0.9))*(1+1.8e-5*dt-1.45e-9*dt*dt)*(1-8.97e-6*v(n1,n2)+1.42e-5*v(n1,n2)*v(n1,n2))*(1+pc_ma_mim) 


ends mimcaps_20f_mml110e


