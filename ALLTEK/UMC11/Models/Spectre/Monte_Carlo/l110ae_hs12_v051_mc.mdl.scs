simulator lang=spectre insensitive=yes
inline subckt n_12_hsl110e_ig ( n11 n2 n33 n4 )
parameters w=1u l=1u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ sa=0 sb=0 sd=0
+ a_unit=sd*w   p_unit=2*(sd+w)  a_sa_edge=sa*w   p_sa_edge=2*(sa+w)
+ a_sb_edge=sb*w   p_sb_edge=2*(sb+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_sb_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_sa_edge) + nf_even*(a_unit*(nf/2-1)+a_sa_edge+a_sb_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_sb_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_sa_edge) + nf_even*(p_unit*(nf/2-1)+p_sa_edge+p_sb_edge))/nf
//
//
parameters rsh=8.5 
parameters hdif=1.25e-07
parameters trise=0 
parameters nrd=hdif / w 
parameters nrs=hdif / w  
parameters tcig=1 + 1.55e-3 * (temp + dtemp - 25) 
parameters area=w * 0.9 * (l * 0.9 + 8e-9)  * 1e4 * tcig 
parameters toxg=(2.64e-09 + dtox_n_12_hsl110e) * 1e2 
parameters vdf0=3.11 
parameters vdfl= - 0.3e-08 
parameters vdfw=3.5e-09 
parameters vaf0=0.7 
parameters vafl= - 0.8e-10 
parameters vafw=1.0e-10 
parameters vdr0=5.78 
parameters vdrl=0e-07 
parameters vdrw=5.0e-09 
parameters var0=0.60 
parameters varl=0e-07 
parameters varw=1.0e-10 
parameters vdf=(vdf0 + vdfl / (l * 0.9 + 8e-9) + vdfw / (w * 0.9)) * 2.6e7 * toxg 
parameters vaf=(vaf0 + vafl / (l * 0.9 + 8e-9) + vafw / (w * 0.9)) * 2.6e7 * toxg 
parameters vdr=(vdr0 + vdrl / (l * 0.9 + 8e-9) + vdrw / (w * 0.9)) * 2.6e7 * toxg 
parameters var=(var0 + varl / (l * 0.9 + 8e-9) + varw / (w * 0.9)) * 2.6e7 * toxg 
parameters igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
parameters igr=2.1e-7 * area / (l * 0.9 + 8e-9) * exp( - vdr) * pow(1 / toxg,2.0)
gigcd ( n2 n1 ) bsource i =igf * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,vaf) - igr * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,var)
gigcs ( n2 n3 ) bsource i =igf * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,vaf) - igr * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,var)
rdn ( n1 n11 ) resistor r=rsh * nrd 
rsn ( n3 n33 ) resistor r=rsh * nrs 
 
//
parameters beta  = 1
parameters compl1	= 3.44883782328004
parameters compl2	= 1.99999999999924
parameters compl3	= 0.324834857587322
parameters compl4	= 1.66600046865662e-08
parameters compl5	= 1.35651442724096e-16
parameters l_factor_n=1/sqrt(2*w*0.9*(l*0.9+8e-9)*mf*1e+12)
parameters  b1_np_12_hsl110e = b1_np_12_hsl110e_xx
parameters  b2_np_12_hsl110e = b2_np_12_hsl110e_xx
parameters  b3_np_12_hsl110e = b3_np_12_hsl110e_xx
parameters  b4_np_12_hsl110e = b4_np_12_hsl110e_xx
parameters  b5_np_12_hsl110e = b5_np_12_hsl110e_xx
parameters  dtox_n_12_hsl110e_l = beta*(1.0809757592101e-33*b1_np_12_hsl110e*compl1+-6.93711342624174e-34*b2_np_12_hsl110e*compl2+-4.47849693957688e-33*b3_np_12_hsl110e*compl3+-1.51192406099359e-25*b4_np_12_hsl110e*compl4+1.02437255504402e-17*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dxl_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  du0_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dvth0_n_12_hsl110e_l = beta*(-2.48651360812604e-19*b1_np_12_hsl110e*compl1+2.35500000000089e-03*b2_np_12_hsl110e*compl2+-2.39218395149195e-20*b3_np_12_hsl110e*compl3+-1.82416235103312e-25*b4_np_12_hsl110e*compl4+1.63633624482066e-19*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  drdsw_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dxw_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dnlx_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dk3_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dpvth0_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dwwl_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dags_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dcgdo_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dcgso_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dcj_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dcjsw_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dcjswg_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dvsat_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dwags_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dpvsat_n_12_hsl110e_l = beta*(0*b1_np_12_hsl110e*compl1+0*b2_np_12_hsl110e*compl2+0*b3_np_12_hsl110e*compl3+0*b4_np_12_hsl110e*compl4+0*b5_np_12_hsl110e*compl5)* mis_flag*l_factor_n
parameters  dtox_n_12_hsl110e = (global_flag_n_12_hsl110e*dtox_n_12_hsl110e_g  + local_flag_n_12_hsl110e*dtox_n_12_hsl110e_l)*(1-total_flag_n_12_hsl110e)+ total_flag_n_12_hsl110e*dtox_n_12_hsl110e_t
