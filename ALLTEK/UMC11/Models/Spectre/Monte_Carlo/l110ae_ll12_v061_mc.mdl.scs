inline subckt n_12bpw_lll110e_ig ( n11 n2 n33 n4)
parameters w=1u l=1u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ sa=0 sb=0 sd=0
+ a_unit=sd*w   p_unit=2*(sd+w)  a_sa_edge=sa*w   p_sa_edge=2*(sa+w)
+ a_sb_edge=sb*w   p_sb_edge=2*(sb+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_sb_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_sa_edge) + nf_even*(a_unit*(nf/2-1)+a_sa_edge+a_sb_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_sb_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_sa_edge) + nf_even*(p_unit*(nf/2-1)+p_sa_edge+p_sb_edge))/nf
//
//
parameters rsh=8.5 
parameters hdif=1.25e-07
parameters trise=0 
parameters nrd=hdif / w 
parameters nrs=hdif / w  
parameters tcig=1+1.55e-3*(temp+dtemp-25)
parameters area=w*0.9*(l*0.9+12e-9)*1e4*tcig
parameters toxg=(2.64e-09+dtox_n_12_lll110e)*1e2
parameters vdf0=3.11 
parameters vdfl=-0.3e-08 
parameters vdfw=3.5e-09
parameters vaf0=0.7 
parameters vafl=-0.8e-10 
parameters vafw=1.0e-10
parameters vdr0=5.78 
parameters vdrl=0e-07 
parameters vdrw=5.0e-09
parameters var0=0.60 
parameters varl=0e-07 
parameters varw=1.0e-10
parameters vdf=(vdf0 + vdfl / (l*0.9+12e-9) + vdfw / (w * 0.9)) * 2.6e7 * toxg 
parameters vaf=(vaf0 + vafl / (l*0.9+12e-9) + vafw / (w * 0.9)) * 2.6e7 * toxg 
parameters vdr=(vdr0 + vdrl / (l*0.9+12e-9) + vdrw / (w * 0.9)) * 2.6e7 * toxg 
parameters var=(var0 + varl / (l*0.9+12e-9) + varw / (w * 0.9)) * 2.6e7 * toxg 
parameters igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
parameters igr=2.1e-7 * area / (l * 0.9 + 12e-9) * exp( - vdr) * pow(1 / toxg,2.0)
gigcd ( n2 n1 ) bsource i =igf * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,vaf) - igr * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,var)
gigcs ( n2 n3 ) bsource i =igf * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,vaf) - igr * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,var)
rdn ( n1 n11 ) resistor r=rsh * nrd 
rsn ( n3 n33 ) resistor r=rsh * nrs 

