library mylib 
 
section typ 
parameters dtoxe_pcap_12=0.0000e+00 
parameters dxl_pcap_12=0.0000e+00 
parameters dxw_pcap_12=0.0000e+00 
parameters dcmina_pcap_12=0.0000e+00 
