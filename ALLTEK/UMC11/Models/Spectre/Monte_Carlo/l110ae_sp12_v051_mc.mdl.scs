//
//
//
inline subckt p_12_spl110e_ig ( p11 p2 p33 p4 )
parameters w=1u l=1u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ sa=0 sb=0 sd=0
+ a_unit=sd*w   p_unit=2*(sd+w)  a_sa_edge=sa*w   p_sa_edge=2*(sa+w)
+ a_sb_edge=sb*w   p_sb_edge=2*(sb+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_sb_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_sa_edge) + nf_even*(a_unit*(nf/2-1)+a_sa_edge+a_sb_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_sb_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_sa_edge) + nf_even*(p_unit*(nf/2-1)+p_sa_edge+p_sb_edge))/nf
//
//
parameters rsh=7.6
parameters hdif=1.25e-07
parameters tcig=1 + 2.25e-3 * (temp + dtemp - 25)
parameters area=w * 0.9 * (l*0.9+1.2e-8) * 1e4 * tcig
parameters toxg=(2.83e-09 + dtox_p_12_spl110e) * 1e2
parameters vdf0=3.22
parameters vdfl= - 7.00e-09
parameters vdfw= - 6.0e-8
parameters vaf0=0.6
parameters vafl= - 1.5e-08
parameters vafw= - 3.0e-8
parameters vdr0=5.50
parameters vdrl= + 1.50e-08
parameters vdrw= - 1.0e-07
parameters var0=0.35
parameters varl= + 1.50e-08
parameters varw=4.0e-8
parameters vdf=(vdf0 + vdfl / (l*0.9+1.2e-8) + vdfw / (w * 0.9)) * 2.6e7 * toxg
parameters vaf=(vaf0 + vafl / (l*0.9+1.2e-8) + vafw / (w * 0.9)) * 2.6e7 * toxg
parameters vdr=(vdr0 + vdrl / (l*0.9+1.2e-8) + vdrw / (w * 0.9)) * 2.6e7 * toxg
parameters var=(var0 + varl / (l*0.9+1.2e-8) + varw / (w * 0.9)) * 2.6e7 * toxg
parameters igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0)
parameters igr=2.1e-7 * area / (l*0.9+1.2e-8) * exp( - vdr) * pow(1 / toxg,2.0) 
parameters nrd=hdif / (w * 0.9)
parameters nrs=hdif / (w * 0.9)
gigcd ( p2 p1 ) bsource i = - igf * pow((abs(v(p2,p1)) - v(p2,p1)) / 2,vaf) + igr 
+ * pow((abs(v(p2,p1)) + v(p2,p1)) / 2,var)
gigcs ( p2 p3 ) bsource i = - igf * pow((abs(v(p2,p3)) - v(p2,p3)) / 2,vaf) + igr 
+ * pow((abs(v(p2,p3)) + v(p2,p3)) / 2,var)
rdp ( p1 p11 ) resistor r=rsh * nrd
rsp ( p3 p33 ) resistor r=rsh * nrs
//
//
parameters beta  = 1.2
parameters compl1	= 4.46021732737144
parameters compl2	= 2.01772483445754
parameters compl3	= 0.187586298385582
parameters compl4	= 7.69841760266484e-03
parameters compl5	= 1.05903259440621e-13
