parameters  dtox_n_12_spl110e = (global_flag_n_12_spl110e*dtox_n_12_spl110e_g  + local_flag_n_12_spl110e*dtox_n_12_spl110e_l)*(1-total_flag_n_12_spl110e)+ total_flag_n_12_spl110e*dtox_n_12_spl110e_t
