simulator lang=spectre insensitive=yes
inline subckt n_12_spl110e_ig ( n11 n2 n33 n4 ) 
parameters w=1u l=1u
+ dtemp=0 nf=1 mf=1 mis_flag=1
+ nf_odd=nf-2*int(nf/2) nf_even=1-nf_odd
+ sa=0 sb=0 sd=0
+ a_unit=sd*w   p_unit=2*(sd+w)  a_sa_edge=sa*w   p_sa_edge=2*(sa+w)
+ a_sb_edge=sb*w   p_sb_edge=2*(sb+w)
+ ad=(nf_odd*(a_unit*((nf+1)/2-1)+a_sb_edge) + nf_even*(a_unit*nf/2))/nf
+ as=(nf_odd*(a_unit*((nf+1)/2-1)+a_sa_edge) + nf_even*(a_unit*(nf/2-1)+a_sa_edge+a_sb_edge))/nf
+ pd=(nf_odd*(p_unit*((nf+1)/2-1)+p_sb_edge) + nf_even*(p_unit*nf/2))/nf
+ ps=(nf_odd*(p_unit*((nf+1)/2-1)+p_sa_edge) + nf_even*(p_unit*(nf/2-1)+p_sa_edge+p_sb_edge))/nf
//
//
parameters rsh=8.5 
parameters hdif=1.25e-07 
parameters tcig=1 + 1.55e-3 * (temp + dtemp - 25) 
parameters area=w * 0.9 * (l*0.9+1.2e-8) * 1e4 * tcig 
parameters toxg=(2.64e-09 + dtox_n_12_spl110e) * 1e2 
parameters vdf0=3.11 
parameters vdfl= - 0.3e-08 
parameters vdfw=3.5e-09 
parameters vaf0=0.7
parameters vafl= - 0.8e-10
parameters vafw=1.0e-10
parameters vdr0=5.78
parameters vdrl=0e-07
parameters vdrw=5.0e-09
parameters var0=0.60 
parameters varl=0e-07
parameters varw=1.0e-10
parameters vdf=(vdf0 + vdfl / (l*0.9+1.2e-8) + vdfw / (w * 0.9)) * 2.6e7 * toxg 
parameters vaf=(vaf0 + vafl / (l*0.9+1.2e-8) + vafw / (w * 0.9)) * 2.6e7 * toxg
parameters vdr=(vdr0 + vdrl / (l*0.9+1.2e-8) + vdrw / (w * 0.9)) * 2.6e7 * toxg
parameters var=(var0 + varl / (l*0.9+1.2e-8) + varw / (w * 0.9)) * 2.6e7 * toxg
parameters igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
parameters igr=2.1e-7 * area / (l*0.9+1.2e-8) * exp( - vdr) * pow(1 / toxg,2.0) 
parameters nrd=hdif / (w * 0.9)
parameters nrs=hdif / (w * 0.9)
gigcd ( n2 n1 ) bsource i =igf * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,vaf) - igr * pow((abs(v(n2,n1)) - v(n2,n1)) / 2,var)
gigcs ( n2 n3 ) bsource i =igf * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,vaf) - igr * pow((abs(v(n2,n3)) - v(n2,n3)) / 2,var)
rdn ( n1 n11 ) resistor r=rsh * nrd 
rsn ( n3 n33 ) resistor r=rsh * nrs 

parameters beta  = 1.2
parameters compl1	= 4.46021732737144
parameters compl2	= 2.01772483445754
parameters compl3	= 0.187586298385582
parameters compl4	= 7.69841760266484e-03
parameters compl5	= 1.05903259440621e-13
parameters l_factor_n=1/sqrt(2*w*0.9*(l*0.9+1.2e-8)*mf*1e+12)
parameters  b1_np_12_spl110e = b1_np_12_spl110e_xx
parameters  b2_np_12_spl110e = b2_np_12_spl110e_xx
parameters  b3_np_12_spl110e = b3_np_12_spl110e_xx
parameters  b4_np_12_spl110e = b4_np_12_spl110e_xx
parameters  b5_np_12_spl110e = b5_np_12_spl110e_xx
parameters  dtox_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dxl_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  du0_n_12_spl110e_l = beta*(4.45072602452045e-05*b1_np_12_spl110e*compl1+-2.63228168099521e-05*b2_np_12_spl110e*compl2+-2.50187114102283e-05*b3_np_12_spl110e*compl3+2.35764753627289e-05*b4_np_12_spl110e*compl4+8.09125679883548e-05*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dvth0_n_12_spl110e_l = beta*(8.75346840504461e-04*b1_np_12_spl110e*compl1+-5.2565790942035e-04*b2_np_12_spl110e*compl2+-7.15978821845178e-04*b3_np_12_spl110e*compl3+-7.26990067423093e-04*b4_np_12_spl110e*compl4+-8.40759228267657e-04*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  drdsw_n_12_spl110e_l = beta*(0.239654478243412*b1_np_12_spl110e*compl1+-0.141738244361282*b2_np_12_spl110e*compl2+-0.134716138362736*b3_np_12_spl110e*compl3+0.126950251955676*b4_np_12_spl110e*compl4+-0.194712939105613*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dxw_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dnlx_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dk3_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dpvth0_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dwwl_n_12_spl110e_l = beta*(6.29944207949316e-25*b1_np_12_spl110e*compl1+-3.25159463007098e-25*b2_np_12_spl110e*compl2+1.25256015201394e-24*b3_np_12_spl110e*compl3+-1.45584923722313e-25*b4_np_12_spl110e*compl4+-2.86648274346994e-26*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dvsat_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dpvsat_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dags_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dwags_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dpags_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcj_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcjsw_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcjswg_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcgdo_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcgso_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
parameters  dcgdl_n_12_spl110e_l = beta*(0*b1_np_12_spl110e*compl1+0*b2_np_12_spl110e*compl2+0*b3_np_12_spl110e*compl3+0*b4_np_12_spl110e*compl4+0*b5_np_12_spl110e*compl5)* mis_flag*l_factor_n
