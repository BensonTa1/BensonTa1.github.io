* 
library mimcap
//
section tt
parameters drtop_mimcap_10=0
parameters drbot_mimcap_10=0
parameters dcj_mimcap_10=0
parameters dcjsw_mimcap_10=0
parameters dcox_mimcap_10=0
parameters dcj_dionw_l110e_mim_10=0
parameters dcjp_dionw_l110e_mim_10=0
include "l110ae_mimcaps_1f_rf_v022.mdl.scs"
endsection tt
//  *         
section ss
parameters drtop_mimcap_10=-0.3
parameters drbot_mimcap_10=-0.3
parameters dcj_mimcap_10=0.15
parameters dcjsw_mimcap_10=0.30
parameters dcox_mimcap_10=-0.15
parameters dcj_dionw_l110e_mim_10=8.28e-006
parameters dcjp_dionw_l110e_mim_10=9.92e-011
include "l110ae_mimcaps_1f_rf_v022.mdl.scs"
endsection ss
//  *  
section ff
parameters drtop_mimcap_10=0.3
parameters drbot_mimcap_10=0.3
parameters dcj_mimcap_10=-0.15
parameters dcjsw_mimcap_10=-0.30
parameters dcox_mimcap_10=0.15
parameters dcj_dionw_l110e_mim_10=-8.28e-006
parameters dcjp_dionw_l110e_mim_10=-9.92e-011
include "l110ae_mimcaps_1f_rf_v022.mdl.scs"
endsection ff
//  * 
endlibrary mimcap
