+ne      = 1.4471          br      = 1.9958          nr      = 1              var     = 24.728
+ikr     = 1.0045          nkf     = 1.0004          isc     = 2.5028e-017     nc      = 1.024
//**************************************************************
//*               tempATURE PARAMETERS
//**************************************************************
+xtb     = 0               xti     = 3.0042          eg      = 1.17            ctc     = 0.00085358
+cte     = 0.0009       tlev    = 0               tlevc   = 1               tvjc    = 0.001512
+tvje    = 0.001494       tnf1    = -8.6177e-005    tnr1    = -3.405e-005     tne1    = 1e-006
+tnc1    = -3.528e-008     tbf1    = 0.0056          tbr1    = 0.00032832      tikf1   = -0.004768
+trb1    = 0.0068405       trc1    = 0.00231         trm1    = 0               tnf2    = 2.5732e-007
+tnr2    = -9.0551e-008    tne2    = 5e-011          tnc2    = 0               tbf2    = 1.6118e-006
