//*           0V <= VCE <= 3.3V
//*           1uA <= IB  <= 5uA
//*
//*********************** Vertical NPN BJT With SAB    ***********************
//*    Device Name       (Base Area)    :   Emitter Area(um**2)  
//* npn_sv45x45_l110ae    (11.7*11.7)    :       4.5*4.5
//* npn_sv90x90_l110ae    (16.2*16.2)    :       9.0*9.0 
//* npn_sv135x135_l110ae  (20.7*20.7)    :      13.5*13.5  
//*
//*          
//* tempature range: -40c ~ 150c ; nominal tempature=25c.
//*
//*
//*****************************************************************
//*      Emitter Area=4.5X4.5 um**2  ,Base Area=11.7X11.7 um**2             *
//*****************************************************************
simulator lang=spectre insensitive=yes
model npn_sv45x45_l110ae bjt type=npn level = 1 
+ struct=vertical 
//**************************************************************
//*               GENERAL PARAMETERS
//**************************************************************
+tref    = 25
//**************************************************************
//*               CAPACITANCE PARAMETERS
//**************************************************************
+cjc     = 1.59710e-013*cjc_npn_sv4p5x4p5_l110ae     cje     = 1.51470e-018*cje_npn_sv4p5x4p5_l110ae       fc      = 0.5             mjc     = 0.3081
+mje     = 0.278        vjc     = 0.59388         vje     = 0.608
