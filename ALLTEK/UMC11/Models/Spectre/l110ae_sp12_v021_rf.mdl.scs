//  ******************************************************************************  
//   
//  Process:  0.11um Logic Standard Performance RF CMOS Process   
//  Device Type:  N- and P-FET     
//  Description:  1.2V MOS Transistor   
//  Model:    Subcircuit BSIM3.2.4 RF model(Spectre)   
//  Simulator:  Spectre    
//  Model Version:0.2 p1   
//  Model Features:   
//    Global model:  Yes   
//    Igate model:  Yes   
//    GIDL model: No   
//    Substrate current model: Yes   
//    Flicker noise: Yes   
//    LOD model: Yes   
//    RF model: Yes   
//    Well proximity effect: No   
//  ******************************************************************************  
//   
//  Revision History:   
//    
//  <Revision 1>   
//  Version : 0.2 phase 1   
//  Date  : 2011/February/11   
//  Author  : Chih-Yang Kao   
//  Remark  : Silicon-based model   
//      Two devices are included in this model file.   
//      (1) Pwell NMOS  : n_12_sprf   
//      (2) Nwell PMOS  : p_12_sprf
//      (3) Twell NMOS  : n_12bpw_sprf   
//  ******************************************************************************  
//   
//  1.2V SP pwell RF NMOS transistor   
//    
//  Geometry range:   
//  Finger width(wf) : 0.9um ~ 7.2um    
//  Finger length(lf): 0.12um ~ 0.36um    
//  Finger no.(nf) : 2 ~ 22    
//     
//  Voltage range:   
//  0V <= VGS <= 1.2V   
//  0V <= VDS <= 1.2V   
//    VBS  = 0V   
//    
//  Temperature range:   
//  -50c ~ 125c ; nominal temperature=25c.   
//    
//  Frequency range:   
//  Up to 20.1GHz   
//    
//  Node Definition:   
//  drain : drain    
//  gate  : gate   
//  source: source   
//  body  : body   
//    
//  ******************************************************************************  
//   
//  1.2V SP RF PMOS transistor   
//    
//  Geometry range:    
//  Finger width(wf) : 1.6um ~ 9.6um    
//  Finger length(lf): 0.12um ~ 0.36um    
//  Finger no.(nf) : 2 ~ 22    
//     
//  Voltage range:   
//  -1.2V <= VGS <= 0V   
//  -1.2V <= VDS <= 0V   
//     VBS  = 0V   
//    
//  Temperature range:   
//  -50c ~ 125c ; nominal temperature=25c.   
//    
//  Frequency range:   
//  Up to 20.1GHz   
//    
//  Node Definition:   
//  drain : drain    
//  gate  : gate   
//  source: source   
//  body  : body   
//  psub  : P-substrate(should be ground)   
// 
//******************************************************************************
//  1.2V SP twell RF NMOS transistor 
//  
// Geometry range: 
//   Finger width(wf) : 0.9um ~ 7.2um 
//   Finger length(lf): 0.12um ~ 0.36um 
//   Finger no.(nf)   : 2 ~ 22 
//   
//  Voltage range: 
//    0V <= VGS <= 1.2V 
//    0V <= VDS <= 1.2V 
//          VBS  = 0V 
//  
//  Temperature range: 
//    -50c ~ 125c ; nominal temperature=25c. 
//  
//  Frequency range: 
//    Up to 20.1GHz 
//  
//  Node Definition: 
//    drain : drain  
//    gate  : gate 
//    source: source 
//    body  : body 
//    nwell : nwell
//    psub  : psub
//   
//  *************************** Start of Model Card ******************************  
//   
//  ******************************************************************************  
//   
//*1.2V SP pwell RF NMOS transistor   
inline subckt n_12_sprf ( drain gate source body )  
parameters lf=0.12u       wf=1.8u                   nf=1 
+ sa=2.2u                 sb=2.2u                   dtemp=0 
+  rbb=8.824e3 rbo=24.74 rbn=126.1e-3 rbw=5.849e6 rbl=746.8e6 rsh=8.5 hdif=1.25e-07  
+ nf_odd=nf-2*int(nf 
+ /2) nf_even=1-nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 no_via=3  
+  sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_twell_w=2.24e-6 sp_twell_l=1.48e-6 sp_nwell_w=3.74e-6  
+  sp_nwell_l=2.98e-6 wg=(wf*0.9) lg=(lf*0.9+12e-9) p_area_s=nf_odd*(sp_edge  
+ *(wf)+sp_poly*(wf)*(nf-1)/2)+nf_even*(2*sp_edge*(wf)+sp_poly  
+ *(wf)*(nf/2-1)) p_area_d=nf_odd*(sp_edge*(wf)+sp_poly*(wf)*(nf  
+ -1)/2)+nf_even*(sp_poly*(wf)*nf/2) p_pj_s=nf_odd*(sp_edge*2+ 
+  (wf)+(nf-1)/2*sp_poly*2)+nf_even*(sp_edge*2*2+(wf)*2+(nf  
+ /2-1)*sp_poly*2) p_pj_d=nf_odd*(sp_edge*2+(wf)+(nf-1)/2*sp_poly  
+ *2)+nf_even*(nf/2*sp_poly*2) p_pj_sg=nf*(wf) p_pj_dg=nf*(wf) dev_l=(nf  
+ -1)*4e-007*0.9+nf*lg+1.88e-006*0.9 dev_w=wg+1.04e-006*0.9 dev_access=dev_l  
+ *dev_w/(16*(dev_l*dev_l+dev_w*dev_w)) rbulk=rbo*dev_access+rbw  
+ *wg+rbl*lg+rbn*nf cgn=0.2806 cgno=-4.4463 cgw=56.94e-6 cgww=1.134e-3  
+  cgo=-1.360 cgl=165.65 cgll=-191.07 cglll=71.507 cc=-1.854e-15 ccw=119.0e-3 ccwn=796.9e-3  
+  rn=130.0 rwl=50.94e-9 rlw=8.897e-3 rl=2.741e-12 rw=-289.3e3 cjn=0.0363853168 cjnn=-1.61872815  
+  cjnnn=29.5851674 cjno=-208 cjo=0.44 cjl=15.26616 cjll=-12.12553 cjw=-5.00e-01  
+  cjj=((2+cjl*lg*lg/1e-12+cjll*lg/1e-6)*(1.22+cjw/wg*1e-6)  
+ +cjo+(cjn*nf*nf*nf+cjnn*nf*nf+cjnnn*nf+cjno)*1e-3)*1e-3  
+  tcig=1+1.55e-3*(temp+dtemp-25) area=wg*(lg)*1e4*tcig*nf toxg=(2.64e-09  
+ +dtox_n_12_sprf)*1e2 vdf0=3.11 vdfl=-0.3e-08 vdfw=3.5e-09 vaf0=0.7 vafl=  
+ -0.8e-10 vafw=1.0e-10 vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 var0=0.60 varl=0e-07  
+  varw=1.0e-10 vdf=(vdf0+vdfl/(lg)+vdfw/(wg))*2.6e7*toxg vaf=(vaf0+ 
+  vafl/(lg)+vafw/(wg))*2.6e7*toxg vdr=(vdr0+vdrl/(lg)+vdrw/(wg))  
+ *2.6e7*toxg var=(var0+varl/(lg)+varw/(wg))*2.6e7*toxg igf=2.1e-7  
+ *area*exp(-vdf)*pow(1/toxg,2.0) igr=2.1e-7*area/(lg)*exp(-vdr)  
+ *pow(1/toxg,2.0)  
//     
n_12_sprf ( 10 20 30 40 ) nfet m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u 
//     
rgc ( gate 22 ) resistor r=(rn/nf ** 1+rw*wg)*(1+drgc_n_12_sprf) 
rgi ( 22 21 ) resistor r=(rwl*wg/(lg)+rl/lg/wg)*(1+drgi_n_12_sprf) 
rch ( 21 20 ) resistor r=rlw*lg/(wg)*(1+drch_n_12_sprf) isnoisy = 0
rdrain ( drain 10 ) resistor r=9.703*1e-6/(wg*nf) 
rsource ( source 30 ) resistor r=9.703*1e-6/(wg*nf) 
rsubd ( 40 45 ) resistor r=rbb*(0.4u*0.9+lg)/(wg*nf) 
rsubs ( 44 40 ) resistor r=rbb*(0.4u*0.9+lg)/(wg*nf) 
rsubbe ( 40 body ) resistor r=rbulk 
cgs_ext ( 22 30 ) capacitor c=((cgw*wg*wg*nf/1e-12+cgww*wg*nf/1e-6  
+ +cgl*lg*lg*lg/1e-18+cgll*lg*lg/1e-12+cglll*lg/1e-6+cgo  
+ +cgn*nf+cgno)*1e-15+cc*abs(v(drain,source))*lg/1e-6*(ccw*(wg  
+ *nf/1e-6) ** ccwn)*abs(v(gate,source)))*(1+dcgd_ext_n_12_sprf) 
cgd_ext ( 22 10 ) capacitor c=((cgw*wg*wg*nf/1e-12+cgww*wg*nf/1e-6  
+ +cgl*lg*lg*lg/1e-18+cgll*lg*lg/1e-12+cglll*lg/1e-6+cgo  
+ +cgn*nf+cgno)*1e-15+cc*abs(v(drain,source))*lg/1e-6*(ccw*(wg  
+ *nf/1e-6) ** ccwn)*abs(v(gate,source)))*(1+dcgd_ext_n_12_sprf) 
cds_ext ( 30 10 ) capacitor c=(1.734e-016*wg*nf*1e6+3.13e-008*(lg-0.1u))  
+ *(1+dcds_ext_n_12_sprf) 
djsb ( 44 30 ) sd_diode_core_nchpw m=1 area=p_area_s pj=p_pj_sg 
djsb_p ( 44 30 ) sdp_diode_core_nchpw m=1 area=1e-20 pj=p_pj_s 
djdb ( 45 10 ) sd_diode_core_nchpw m=1 area=p_area_d pj=p_pj_dg 
djdb_p ( 45 10 ) sdp_diode_core_nchpw m=1 area=1e-20 pj=p_pj_d 
  
//  *Igate model***   
gigcd ( 20 10 ) bsource i =igf*pow((abs(v(20,10))+v(20,10))/2,vaf)-igr* 
+  pow((abs(v(20,10))-v(20,10))/2,var) 
gigcs ( 20 30 ) bsource i =igf*pow((abs(v(20,30))+v(20,30))/2,vaf)-igr* 
+  pow((abs(v(20,30))-v(20,30))/2,var) 
//  ************************************************************************************************  
