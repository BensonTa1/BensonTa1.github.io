//*1.2V SP RF Triple well NMOS transistor  
inline subckt n_12bpw_sprf ( drain gate source body nwell psub ) 
parameters lf=0.12u       wf=1.8u                   nf=1 
+ sa=2.2u                 sb=2.2u                   dtemp=0 
+  rbb=8.824e3 rbo=24.74 rbn=126.1e-3 rbw=5.849e6 rbl=746.8e6 rsh=8.5 hdif=1.25e-07  
+ nf_odd=nf-2*int(nf 
+ /2) nf_even=1-nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 no_via=3  
+  sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_twell_w=2.24e-6 sp_twell_l=1.48e-6 sp_nwell_w=3.74e-6  
+  sp_nwell_l=2.98e-6 wg=(wf*0.9) lg=(lf*0.9+12e-9) p_area_s=nf_odd*(sp_edge  
+ *(wf)+sp_poly*(wf)*(nf-1)/2)+nf_even*(2*sp_edge*(wf)+sp_poly  
+ *(wf)*(nf/2-1)) p_area_d=nf_odd*(sp_edge*(wf)+sp_poly*(wf)*(nf  
+ -1)/2)+nf_even*(sp_poly*(wf)*nf/2) p_pj_s=nf_odd*(sp_edge*2+ 
+  (wf)+(nf-1)/2*sp_poly*2)+nf_even*(sp_edge*2*2+(wf)*2+(nf  
+ /2-1)*sp_poly*2) p_pj_d=nf_odd*(sp_edge*2+(wf)+(nf-1)/2*sp_poly  
+ *2)+nf_even*(nf/2*sp_poly*2) p_pj_sg=nf*(wf) p_pj_dg=nf*(wf) p_area_tw=((wf) + 2 * sp_twell_w) 
+ * (2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly + 2 * sp_twell_l) p_pj_tw=2 * ((wf) 
+ + 2 * sp_twell_w + 2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly + 2 * sp_twell_l) 
+ p_area_dnw=((wf) + 2 * sp_nwell_w) * (2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly 
+ + 2 * sp_nwell_l) p_pj_dnw=2 * ((wf) + 2 * sp_nwell_w + 2 * sp_edge + nf * (lf) + 
+ (nf - 1) * sp_poly + 2 * sp_nwell_l) dev_l=(2 * sp_edge + nf * lg + (nf - 1) * 
+ sp_poly + 2 * sp_twell_l) dev_w=wg + 2 * sp_twell_w dev_access=dev_l * dev_w / 
+ (16 * (dev_l * dev_l + dev_w * dev_w)) rbulk=rbo*dev_access+rbw  
+ *wg+rbl*lg+rbn*nf cgn=0.2806 cgno=-4.4463 cgw=56.94e-6 cgww=1.134e-3  
+  cgo=-1.360 cgl=165.65 cgll=-191.07 cglll=71.507 cc=-1.854e-15 ccw=119.0e-3 ccwn=796.9e-3  
+  rn=130.0 rwl=50.94e-9 rlw=8.897e-3 rl=2.741e-12 rw=-289.3e3 cjn=0.0363853168 cjnn=-1.61872815  
+  cjnnn=29.5851674 cjno=-208 cjo=0.44 cjl=15.26616 cjll=-12.12553 cjw=-5.00e-01  
+  cjj=((2+cjl*lg*lg/1e-12+cjll*lg/1e-6)*(1.22+cjw/wg*1e-6)  
+ +cjo+(cjn*nf*nf*nf+cjnn*nf*nf+cjnnn*nf+cjno)*1e-3)*1e-3  
+  tcig=1+1.55e-3*(temp+dtemp-25) area=wg*(lg)*1e4*tcig*nf toxg=(2.64e-09  
+ +dtox_n_12_sprf)*1e2 vdf0=3.11 vdfl=-0.3e-08 vdfw=3.5e-09 vaf0=0.7 vafl=  
+ -0.8e-10 vafw=1.0e-10 vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 var0=0.60 varl=0e-07  
+  varw=1.0e-10 vdf=(vdf0+vdfl/(lg)+vdfw/(wg))*2.6e7*toxg vaf=(vaf0+ 
+  vafl/(lg)+vafw/(wg))*2.6e7*toxg vdr=(vdr0+vdrl/(lg)+vdrw/(wg))  
+ *2.6e7*toxg var=(var0+varl/(lg)+varw/(wg))*2.6e7*toxg igf=2.1e-7  
+ *area*exp(-vdf)*pow(1/toxg,2.0) igr=2.1e-7*area/(lg)*exp(-vdr)  
+ *pow(1/toxg,2.0)  
//     
n_12bpw_sprf ( 10 20 30 40 ) n_12bpw m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u 
