+  ckappa=5.1000e-01         cgdl=5.8000e-11           cgsl=5.8000e-11 
+  vfbcv=-1.0000e+00         acde=2.8300e-01           moin=7.6250e+00 
+  noff=1.8440e+00           voffcv=-5.4040e-02        noia=5.0000e+19 
+  noib=2.3130e+05           noic=-1.4010e-12          em=4.9980e+06 
+  ef=9.1970e-01             xl=-6.0000e-09+dxl_n_12_sprf 
+  xw=1.4000e-08+dxw_n_12_sprf                       js=8.8100e-08 
+  jsw=9.6100e-14            cj=0.0000e+00             mj=2.5800e-01 
