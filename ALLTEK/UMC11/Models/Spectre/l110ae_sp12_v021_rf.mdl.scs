+  nj=1.0080e+00             llc=3.5030e-16            lwlc=-7.1720e-23 
+  lwc=4.9560e-15            wwlc=-7.5000e-22          ll=-5.1820e-16 
+  wl=-3.8340e-15            lln=1.0000e+00            wln=1.0000e+00 
