ends n_12_sprf 
//* 
//* 
//* 
//* 
//*1.2V SP RF PMOS transistor   
inline  subckt p_12_sprf ( drain gate source body psub )  
parameters lf=0.12u       wf=2.4u                   nf=16 
+ sa=2.2u                 sb=2.2u                   dtemp=0 
+rbb=3.000e3 rbo=1.000e3 rbn=0 rbw=-1.000e6 rbl=0 rsh=7.6 hdif=1.25e-07  
+ nf_odd=nf-2*int(nf 
+ /2) nf_even=1-nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 no_via=3  
+  sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_nwell_w=2.337e-6 sp_nwell_l=1.52e-6 wg=wf  
+ *0.9 lg=lf*0.9+12e-9 p_area_s=nf_odd*(sp_edge*(wf)+sp_poly*(wf)* 
+  (nf-1)/2)+nf_even*(2*sp_edge*(wf)+sp_poly*(wf)*(nf/2-1))  
+  p_area_d=nf_odd*(sp_edge*(wf)+sp_poly*(wf)*(nf-1)/2)+nf_even* 
+  (sp_poly*(wf)*nf/2) p_pj_s=nf_odd*(sp_edge*2+(wf)+(nf-1)/2* 
+  sp_poly*2)+nf_even*(sp_edge*2*2+(wf)*2+(nf/2-1)*sp_poly  
+ *2) p_pj_d=nf_odd*(sp_edge*2+(wf)+(nf-1)/2*sp_poly*2)+nf_even  
+ *(nf/2*sp_poly*2) p_pj_sg=nf*(wf) p_pj_dg=nf*(wf) p_area_nw=((wf)+ 
+  2*sp_nwell_w)*(2*sp_edge+nf*(lf+12e-9)+(nf-1)*sp_poly+2* 
+  sp_nwell_l) p_pj_nw=2*((wf)+2*sp_nwell_w+2*sp_edge+nf*(lf+12e-9)  
+ +(nf-1)*sp_poly+2*sp_nwell_l) dev_l=(nf-1)*0.4u*0.9+nf*lg+ 
+  1.88u*0.9 dev_w=wg+1.04u*0.9 dev_access=dev_l*dev_w/(16*(dev_l*dev_l  
+ +dev_w*dev_w)) rbulk=rbo*dev_access+rbw*wg+rbl*lg+rbn*nf cgw=5.000e-12  
+  cgww=3.837e-22 cgo=-7 cgl=288.35 cgll=-255.01 cglll=78.968 cx=3.970e-19 cn=2.147e-15  
+  cc=-6.902e-15 ccw=71.64e-3 ccwn=860.3e-3 rn=10.60 rwl=1.207 rlw=3.229e3 cjo=0.225  
+  cjl=1.2491 cjln=-0.2816 cjw=-0.45 cjj=(cjo+cjl*(lg/1e-6) ** cjln+cjw/ 
+  wg*1e-6)*1e-3 
+  tcig=1+2.25e-3*(temp+dtemp-25) area=wg*(lg)*1e4*tcig*nf toxg=(2.83e-09  
+ +dtox_p_12_sprf)*1e2 vdf0=3.22 vdfl=-7.00e-09 vdfw=-6.0e-8 vaf0=0.6 vafl=  
+ -1.5e-08 vafw=-3.0e-8 vdr0=5.50 vdrl=+1.50e-08 vdrw=-1.0e-07 var0=0.35  
+  varl=+1.50e-08 varw=4.0e-8 vdf=(vdf0+vdfl/(lg)+vdfw/(wg))*2.6e7* 
+  toxg vaf=(vaf0+vafl/(lg)+vafw/(wg))*2.6e7*toxg vdr=(vdr0+vdrl/ 
+  (lg)+vdrw/(wg))*2.6e7*toxg var=(var0+varl/(lg)+varw/(wg))*2.6e7  
+ *toxg igf=2.1e-7*area*exp(-vdf)*pow(1/toxg,2.0) igr=2.1e-7*area/ 
+  (lg)*exp(-vdr)*pow(1/toxg,2.0)  
//     
p_12_sprf ( 10 20 30 40 ) pfet m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u 
//     
rgc ( gate 22 ) resistor r=rn/nf*(1+drgc_p_12_sprf) 
rgi ( 22 21 ) resistor r=rwl*wg/(lg*nf)*(1+drgi_p_12_sprf) 
rch ( 21 20 ) resistor r=rlw*lg/(wg*nf)*(1+drch_p_12_sprf) isnoisy = 0 
rdrain ( drain 10 ) resistor r=6.383e-006/(wg*nf) 
