+  mjswg=7.8000e-01          pb=5.6000e-01             pbsw=5.4000e-01 
+  pbswg=6.0000e-01          tnom=2.5000e+01           kt1=-0.23698 
+  kt1l=-1.2088e-009         kt2=-4.0000e-02           ute=-0.85662 
+  ua1=4e-009                ub1=-5e-018               uc1=-2.9000e-11 
