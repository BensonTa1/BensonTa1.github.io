//*******************************************************************************
//  Process:      0.11um Logic High Speed RF CMOS Process 
//  Device Type:  N- and P-FET   
//  Description:  1.2V MOS Transistor 
//  Model:        Subcircuit BSIM3.2.4 RF model 
//  Simulator:    Spectre  
//  Model Version:0.3 p2
//  Model Features: 
//      Global model:  Yes 
//      Igate model:  Yes 
//      GIDL model: No 
//      Substrate current model: Yes 
//      Flicker noise: Yes 
//      LOD model: Yes 
//      RF model: Yes 
//      Well proximity effect: No 
//  ****************************************************************************** 
//
//  Revision History:
//  
//  <Revision 1>
//  Version : 0.1 phase 1
//  Date    : 2010/January/19
//  Author  : Yan Zung
//  Remark  : This is paper model(without silicon data). 
//            Two devices are included in this model file.
//           (1) Pwell NMOS      : n_12_hsrf
//           (2) PMOS            : p_12_hsrf
//
// <Revision 2>
// Version : 0.2 phase 1
// Date    : 2010/July/29
// Author  : Yan Zung
// Remark  : Silicon-based model
//           Two devices are included in this model file.
//           (1) Pwell NMOS      : n_12_hsrf
//           (2) Nwell PMOS      : p_12_hsrf
//
// <Revision 3>
// Version : 0.3 phase 1
// Date    : 2010/November/20
// Author  : Yan Zung
// Remark  : 1.Add the models of thermal noise and gate current.
//           2.Add the model of triple-well nmos transistor(copied from twin well nmos model).  
//           Three devices are included in this model file.
//           (1) Pwell NMOS      : n_12_hsrf
//           (2) Nwell PMOS      : p_12_hsrf
//           (2) Twell NMOS      : n_12bpw_hsrf
//
// <Revision 4>                            
// Version : 0.3 phase 5                   
// Date    : 2013/04/15               
// Author  : YZ Wang                      
// Remark  : 1. Modify the Verilog-A file.
//
//******************************************************************************
//  1.2V HS pwell RF NMOS transistor 
//  
// Geometry range: 
//   Finger width(wf) : 0.9um ~ 7.2um 
//   Finger length(lf): 0.12um ~ 0.36um 
//   Finger no.(nf)   : 2 ~ 22 
//   
//  Voltage range: 
//    0V <= VGS <= 1.2V 
//    0V <= VDS <= 1.2V 
//          VBS  = 0V 
//  
//  Temperature range: 
//    -50c ~ 125c ; nominal temperature=25c. 
//  
//  Frequency range: 
//    Up to 20.1GHz 
//  
//  Node Definition: 
//    drain : drain  
//    gate  : gate 
//    source: source 
//    body  : body 
//  
//  ****************************************************************************** 
//  1.2V HS RF PMOS transistor 
//  
//  Geometry range: 
//   Finger width(wf) : 1.6um ~ 9.6um 
//   Finger length(lf): 0.12um ~ 0.36um 
//   Finger no.(nf)   : 2 ~ 22  
//   
//  Voltage range: 
//    -1.2V <= VGS <= 0V 
//    -1.2V <= VDS <= 0V 
//             VBS  = 0V 
//  
//  Temperature range: 
//    -50c ~ 125c ; nominal temperature=25c. 
//  
//  Frequency range: 
//    Up to 20.1GHz 
//  
//  Node Definition: 
//    drain : drain  
//    gate  : gate 
//    source: source 
//    body  : body 
//    psub  : P-substrate(should be ground) 
// 
//******************************************************************************
//  1.2V HS twell RF NMOS transistor 
//  
// Geometry range: 
//   Finger width(wf) : 0.9um ~ 7.2um 
//   Finger length(lf): 0.12um ~ 0.36um 
//   Finger no.(nf)   : 2 ~ 22 
//   
//  Voltage range: 
//    0V <= VGS <= 1.2V 
//    0V <= VDS <= 1.2V 
//          VBS  = 0V 
//  
//  Temperature range: 
//    -50c ~ 125c ; nominal temperature=25c. 
//  
//  Frequency range: 
//    Up to 20.1GHz 
//  
//  Node Definition: 
//    drain : drain  
//    gate  : gate 
//    source: source 
//    body  : body 
//    nwell : nwell
//    psub  : psub
//
//  *************************** Start of Model Card ****************************** 
//  * 1.2V HS triple well RF NMOS transistor 
simulator lang=spectre insensitive=yes
//  ****************************************************************************** 
//  * 1.2V HS pwell RF NMOS transistor 
ahdl_include "l110ae_hs12_rf_s.va"
inline subckt n_12_hsrf ( drain gate source body ) 
parameters hfn_flag=hfnoise  rde=10e6 lf=0.12u wf=1.8u sa=2.2u sb=2.2u nf=16 nf_odd=nf - 2 * 
+ int(nf / 2) nf_even=1 - nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 
+ no_via=3 sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_twell_w=2.24e-6 sp_twell_l=1.48e-6 
+ sp_nwell_w=3.74e-6 sp_nwell_l=2.98e-6 wg=(wf * 0.9) lg=(lf * 0.9 + 8e-9) p_area_s=nf_odd * (sp_edge * 
+ (wf) + sp_poly * (wf) * (nf - 1) / 2) + nf_even * (2 * sp_edge * (wf) + sp_poly * (wf) 
+ * (nf / 2 - 1)) p_area_d=nf_odd * (sp_edge * (wf) + sp_poly * (wf) * (nf - 1) / 2) 
+ + nf_even * (sp_poly * (wf) * nf / 2) p_pj_s=nf_odd * (sp_edge * 2 + (wf) + (nf - 
+ 1) / 2 * sp_poly * 2) + nf_even * (sp_edge * 2 * 2 + (wf) * 2 + (nf / 2 - 1) * sp_poly 
+ * 2) p_pj_d=nf_odd * (sp_edge * 2 + (wf) + (nf - 1) / 2 * sp_poly * 2) + nf_even 
+ * (nf / 2 * sp_poly * 2) p_pj_sg=nf * (wf) p_pj_dg=nf * (wf) dev_l=(nf - 1) * 4e-007 
+ + nf * lg + 1.88e-006 dev_w=wg + 1.04e-006 dev_access=dev_l * dev_w / (16 * (dev_l 
+ * dev_l + dev_w * dev_w)) rbulk=85.46 * dev_access - 7992 * wg + 1.764e+004 * 
+ lg + 0.000503 * nf 
// 
//***Igate model***
+ rsh=8.5
+ dtemp=0 
+ tcig=1 + 1.55e-3 * (temp + dtemp - 25) 
+ area=wg * (lg) * 1e4 * tcig * nf
+ toxg=(2.64e-09 + dtox_n_12_hsrf) * 1e2 
+ vdf0=3.11 vdfl= - 0.3e-08 vdfw=3.5e-09 
+ vaf0=0.7 vafl= - 0.8e-10 vafw=1.0e-10 
+ vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 
+ var0=0.60 varl=0e-07 varw=1.0e-10 
+ vdf=(vdf0 + vdfl / (lg) + vdfw / (wg)) * 2.6e7 * toxg 
+ vaf=(vaf0 + vafl / (lg) + vafw / (wg)) * 2.6e7 * toxg 
+ vdr=(vdr0 + vdrl / (lg) + vdrw / (wg)) * 2.6e7 * toxg 
+ var=(var0 + varl / (lg) + varw / (wg)) * 2.6e7 * toxg 
+ igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
+ igr=2.1e-7 * area / (lg) * exp( - vdr) * pow(1 / toxg,2.0) 
// 
gigcd ( 20 10 ) bsource i =igf * pow((abs(v(20,10)) + v(20,10)) / 2,vaf) - igr * pow((abs(v(20,10)) - v(20,10)) / 2,var)
gigcs ( 20 30 ) bsource i =igf * pow((abs(v(20,30)) + v(20,30)) / 2,vaf) - igr * pow((abs(v(20,30)) - v(20,30)) / 2,var)
//**************************************************************************************************
//
n_12_hsrf ( 10 20 30 40 ) n_12_hsrf m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u
 
rgc ( gate 22 ) resistor r=40.36*1e-12/(lg*wg*nf) * (1+drgc_n_12_hsrf)
rgi ( 22 21 ) resistor r=3.809 * wg / (lg*nf) * (1+drgi_n_12_hsrf)
rch ( 21 20 ) resistor r=1000 * lg / (wg*nf) * (1+ drch_n_12_hsrf) isnoisy = 0
rdrain ( drain 10 ) resistor r=9.703 * 1e-6 / (wg * nf)
rsource ( source 30 ) resistor r=9.703 * 1e-6 / (wg * nf)
rsubd ( 40 45 ) resistor r=7821 * (0.4u + lg) / (wg * nf)
rsubs ( 44 40 ) resistor r=7821 * (0.4u + lg) / (wg * nf)
rsubbe ( 40 body ) resistor r=14.2 * rbulk
cgs_ext ( 22 30 ) capacitor c=(1.3e-10*wg*nf + 1.592e-16*1e-6/wg*nf+2e-28/(wg*lg*nf)) * (1+dcgd_ext_n_12_hsrf)
cgd_ext ( 22 10 ) capacitor c=(1.3e-10*wg*nf + 1.592e-16*1e-6/wg*nf+5e-4*wg*lg*nf) * (1+dcgd_ext_n_12_hsrf)
cds_ext ( 30 10 ) capacitor c=(1.734e-016*wg*nf*1e6 + 1.13e-008*(lg-0.1u)) * (1+dcds_ext_n_12_hsrf)
djsb ( 44 30 ) sd_diode_core_nchpw m=1 area=p_area_s perim=p_pj_sg
djsb_p ( 44 30 ) sdp_diode_core_nchpw m=1 area=1e-20 perim=p_pj_s
djdb ( 45 10 ) sd_diode_core_nchpw m=1 area=p_area_d perim=p_pj_dg
djdb_p ( 45 10 ) sdp_diode_core_nchpw m=1 area=1e-20 perim=p_pj_d 

//   ----- Enhanced Channel Noise -----
if (hfn_flag==1) {
ide  ( source  drain ) cccs probe=vde gain=1
recn ( ecn body drain gate source body ) rde_n_12_hsrf  lf=lg wf=wg nf=nf r=rde 
vde  ( ecn body ) vsource  dc=0
}
//  * core device model 
model n_12_hsrf bsim3v3 type=n  
+  version=3.24              lmin=1.2e-007             lmax=3.6e-007 
+  wmin=9e-007               wmax=7.2e-006             binunit=2 
+  mobmod=1                  capmod=3                  nqsmod=0 
+  tnom=25                    
+  tox=2.64e-009+dtox_n_12_hsrf                wint=-1.014e-08 
+  lint=1.079e-08            dlc=2.075e-08+ddlc_n_12_hsrf 
+  dwc=2.844e-08+ddwc_n_12_hsrf                hdif=1.25e-007 
+  ldif=9e-008               xl=-2.6e-008+dxl_n_12_hsrf+8e-9 
+  xw=1e-009+dxw_n_12_hsrf                     xj=1.07e-007 
+  ngate=3.253e+021          ll=0                      wl=-6.03e-15 
+  lln=1                     wln=1                     lw=2.584e-15 
+  ww=6.82e-15               lwn=1                     wwn=1 
+  lwl=-6.8e-22              wwl=0+dwwl_n_12_hsrf 
+  llc=5.826e-16             wlc=-4.5e-14              lwc=0 
+  wwc=3.171e-13             lwlc=-8.321e-23           wwlc=-1.726e-21 
+  xpart=0                   vth0=0.2885+dvth0_n_12_hsrf 
+  lvth0=1.456e-08           pvth0=1.398e-14+dpvth0_n_12_hsrf 
+  vfb=-0.9256               k1=0.3121                 k2=-0.0203 
+  k3=-69.67+dk3_n_12_hsrf                   wk3=-1.763e-05 
+  k3b=3.439                 nlx=5.4e-09+dnlx_n_12_hsrf 
+  w0=1.066e-06              dvt0=0.0284               ldvt0=2.971e-06 
+  dvt1=2.953                dvt2=0.1                  dvt0w=1.262 
+  dvt1w=8.562e+05           dvt2w=-0.06               nch=2.962e+017 
+  voff=-0.1167              lvoff=-3.41e-09           wvoff=-1.543e-08 
+  nfactor=0.5               cdsc=0.03002              cdscb=-0.001 
+  cdscd=0.0009              cit=2.5e-05               alpha0=6.66e-006 
+  alpha1=114.8              beta0=19.4                eta0=0.2 
+  leta0=-1.56e-09+dleta0_n_12_hsrf          peta0=2.21e-14 
+  etab=-0.1228              petab=7.17e-015           dsub=0.7996 
+  u0=0.03845+du0_n_12_hsrf                    lu0=4.091e-10 
+  ua=5e-11                  pua=-6.031e-23            ub=9.9e-19 
+  pub=3.1e-32               uc=8.1e-011               puc=-2e-024 
+  prwg=0.1089               prwb=0                    wr=0.7892 
+  rdsw=65.8+drdsw_n_12_hsrf                   lrdsw=3.068e-06 
+  prdsw=-132.5e-15          a0=0.1492                 ags=0.8 
+  wags=0                    a1=-0.2                   a2=1 
+  b0=3e-08                  b1=1e-08                  vsat=9.836e+04 
+  lvsat=0.001456            pvsat=1.5e-09+dpvsat_n_12_hsrf 
+  keta=0                    delta=0.03598             dwg=9.337e-10 
+  dwb=0                     pclm=0.1203               pdiblc1=1.8e-06 
+  pdiblc2=0.01524           pdiblcb=0.1               drout=0.84 
+  pvag=0                    pscbe1=7.13e+009          pscbe2=0.0025 
+  elm=5                     lags=1.5e-06              la0=0 
+  lcit=2.584e-10            pcit=0                    wvth0=0 
+  pvoff=0                   weta0=-2.5e-07            lub=0 
+  lua=6e-17                 lk3=-2.5e-6               wu0=-8e-9 
+  wvsat=-0.02               pags=0                    pa0=1e-14 
+  clc=1e-009                cle=0.6                   cgbo=1e-9 
+  cgso=1.805e-10+dcgso_n_12_hsrf               
+  cgdo=1.805e-10+dcgdo_n_12_hsrf              cgdl=4.02e-11 
+  cgsl=4.02e-11             cf=5e-12                  ckappa=0.6 
+  noff=2                    voffcv=-0.01              lvoffcv=-7e-9 
+  kt1=-0.2472               wkt1=7e-009               kt1l=1.137e-009 
+  wkt1l=-7e-016             kt2=-0.01126              wkt2=4e-009 
+  ute=-1.474                wute=5e-008               ua1=3.001e-009 
+  ub1=-3.824e-018           uc1=-1.792e-010           wuc1=4e-017 
+  prt=-114.6                at=72360                  wat=-0.001 
+  noia=8.759e+020           noib=146700               noic=-5.9e-013 
+  em=3433000                ef=0.9053                 noimod=2 
+  rsh=8.49                  js=8.81e-008              jsw=9.61e-014 
+  cj=0                      mj=0.258                  cjsw=0 
+  mjsw=0.13                 cjswg=0                   mjswg=0.78 
+  pb=0.56                   pbsw=0.54                 pbswg=0.6 
+  rd=0                      rdc=0                     rs=0 
+  rsc=0                     xti=3                     tpb=0.001632 
+  tpbsw=0.00031             tpbswg=0.00205            tcj=0.0009555 
+  tcjsw=0.0007325           tcjswg=0.0033             nj=1.008 
+  saref=2.2e-006            sbref=2.2e-006            wlod=0 
+  kvth0=3.25e-009           lkvth0=-2.71e-011         wkvth0=0 
+  pkvth0=0                  llodvth=1                 wlodvth=1 
+  stk2=0                    lodk2=1                   lodeta0=1 
+  ku0=-5.32e-008            lku0=9.257e-008           wku0=0 
+  pku0=0                    llodku0=1.12              wlodku0=1 
+  kvsat=1                   steta0=0                  tku0=0 
+  imax=0.1                  minr=0.01
//*N+/TW diode for 0.11um PMOS   
model sd_diode_core_nchpw diode  
+  hcomp=1.0000e+00          imax=1.00e+14             is=8.81e-08 
+  isw=9.61e-14              level=3                   n=1.008 
+  rs=0                      ik=5.28e+04               ikp=2.78e+03 
+  bv=13.36                  ibv=27.778                trs=4.95e-04 
+  eg=1.16                   tbv1=-6.84e-04            tnom=25.0 
+  xti=3.0                   area=3.60e-08             perim=7.60e-04 
+  tlev=1                    tlevc=1                    
+  cjo=0.00072+dcj_n_12_hsrf                   mj=0.258 
+  vj=0.56                   cjsw=1.06e-10+dcjsw_n_12_hsrf 
+  mjsw=0.13                 vjsw=0.54                 pta=0.001632 
+  ptp=0.00031               cta=0.0009555             ctp=0.00073248 
//* 
model sdp_diode_core_nchpw diode  
+  hcomp=1.0000e+00          imax=1.00e+14             tnom=25.0 
+  cjo=0                     level=3                    
+  cjsw=(0.5e-10*wf/lf+0.3e-10/lf*1e-6)*(1+dcjswg_n_12_hsrf) 
+  mjsw=0.78                 vjsw=0.6                  ctp=0.0033 
+  xti=3.0                   eg=1.16                   tlev=0 
+  tlevc=1                   
ends n_12_hsrf
 
//  1.2V HS RF PMOS transistor 
inline subckt p_12_hsrf ( drain gate source body psub ) 
parameters hfn_flag=hfnoise   rde=10e6 lf=0.12u wf=2.4u sa=2.2u sb=2.2u nf=16 nf_odd=nf - 2 * 
+ int(nf / 2) nf_even=1 - nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 
+ no_via=3 sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_nwell_w=2.337e-6 sp_nwell_l=1.52e-6 
+ wg=(wf * 0.9) lg=(lf * 0.9 + 8e-9) p_area_s=nf_odd * (sp_edge * (wf) + sp_poly * (wf) * (nf - 1) / 2) + nf_even 
+ * (2 * sp_edge * (wf) + sp_poly * (wf) * (nf / 2 - 1)) p_area_d=nf_odd * (sp_edge 
+ * (wf) + sp_poly * (wf) * (nf - 1) / 2) + nf_even * (sp_poly * (wf) * nf / 2) p_pj_s=nf_odd 
+ * (sp_edge * 2 + (wf) + (nf - 1) / 2 * sp_poly * 2) + nf_even * (sp_edge * 2 * 2 
+ + (wf) * 2 + (nf / 2 - 1) * sp_poly * 2) p_pj_d=nf_odd * (sp_edge * 2 + (wf) + (nf 
+ - 1) / 2 * sp_poly * 2) + nf_even * (nf / 2 * sp_poly * 2) p_pj_sg=nf * (wf) p_pj_dg=nf 
+ * (wf) p_area_nw=((wf) + 2 * sp_nwell_w) * (2 * sp_edge + nf * (lf + 8e-9) + (nf - 1) * sp_poly 
+ + 2 * sp_nwell_l) p_pj_nw=2 * ((wf) + 2 * sp_nwell_w + 2 * sp_edge + nf * (lf + 8e-9) + (nf 
+ - 1) * sp_poly + 2 * sp_nwell_l) dev_l=(nf - 1) * 0.4u + nf * lg + 1.88u dev_w=wg 
+ + 1.04u dev_access=dev_l * dev_w / (16 * (dev_l * dev_l + dev_w * dev_w)) rbulk=31.1 
+ * dev_access - 7992 * wg + 1.764e+004 * lg + 0.006852 * nf 
//
//***Igate model***
+ rsh=7.6 
+ dtemp=0 
+ tcig=1 + 2.25e-3 * (temp + dtemp - 25) 
+ area=wg * (lg)  * 1e4 * tcig * nf
+ toxg=(2.83e-09 + dtox_p_12_hsrf) * 1e2 
+ vdf0=3.22 vdfl= - 7.00e-09 vdfw= - 6.0e-8 
+ vaf0=0.6 vafl= - 1.5e-08 vafw= - 3.0e-8 
+ vdr0=5.50 vdrl= + 1.50e-08 vdrw= - 1.0e-07 
+ var0=0.35 varl= + 1.50e-08 varw=4.0e-8 
+ vdf=(vdf0 + vdfl / (lg) + vdfw / (wg)) * 2.6e7 * toxg 
+ vaf=(vaf0 + vafl / (lg) + vafw / (wg)) * 2.6e7 * toxg 
+ vdr=(vdr0 + vdrl / (lg) + vdrw / (wg)) * 2.6e7 * toxg 
+ var=(var0 + varl / (lg) + varw / (wg)) * 2.6e7 * toxg 
+ igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
+ igr=2.1e-7 * area / (lg) * exp( - vdr) *  pow(1 / toxg,2.0) 
// 
gigcd ( 20 10 ) bsource i = - igf * pow((abs(v(20,10)) - v(20,10)) / 2,vaf) + igr * pow((abs(v(20,10)) + v(20,10)) / 2,var)
gigcs ( 20 30 ) bsource i = - igf * pow((abs(v(20,30)) - v(20,30)) / 2,vaf) + igr * pow((abs(v(20,30)) + v(20,30)) / 2,var) 
//**************************************************************************************************
//  
p_12_hsrf ( 10 20 30 40 ) p_12_hsrf m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u
 
rgc ( gate 22 ) resistor r=80.2/nf*(1+4.6u/wg-0*1e-13/(lg*wg)) * (1+drgc_p_12_hsrf)
rgi ( 22 21 ) resistor r=1*wg/(lg*nf) * (1+drgi_p_12_hsrf)
rch ( 21 20 ) resistor r=0.1*(0.3*(lg*lg*nf*nf*1e12)-0.2*(lg*nf)*1e6+0.58) * (1+drch_p_12_hsrf)  isnoisy = 0
rdrain ( drain 10 ) resistor r=6.383e-006 / (wg * nf)
rsource ( source 30 ) resistor r=6.383e-006 / (wg * nf)
rsubd ( 40 45 ) resistor r=7821 * (0.7u + lg) / (wg * nf)
rsubs ( 44 40 ) resistor r=7821 * (0.7u + lg) / (wg * nf)
rsubbe ( 40 body ) resistor r=1.8 * rbulk
cgs_ext ( 22 30 ) capacitor c=(1.9e-10*0.010*wg*nf + 20*1.07e-17*1e-6/wg*nf) * (1+dcgd_ext_p_12_hsrf) 
cgd_ext ( 22 10 ) capacitor c=(1.9e-10*wg*nf - 1.07e-17*wg*nf/lg+ 2e-22/wg*nf) * (1+dcgd_ext_p_12_hsrf) 
cds_ext ( 30 10 ) capacitor c=1.043e-016*wg*nf*1e6 * (1+dcds_ext_p_12_hsrf )
djsb ( 30 44 ) sd_diode_core_pch m=1 area=p_area_s perim=p_pj_sg
djsb_p ( 30 44 ) sdp_diode_core_pch m=1 area=1e-20 perim=p_pj_s
djdb ( 10 45 ) sd_diode_core_pch m=1 area=p_area_d perim=p_pj_dg
djdb_p ( 10 45 ) sdp_diode_core_pch m=1 area=1e-20 perim=p_pj_d
dbsub ( 50 body ) nw_psub_diode area=p_area_nw perim=p_pj_nw
rbsub ( psub 50 ) resistor r=390 * dev_access
//   ----- Enhanced Channel Noise ----- 
if (hfn_flag==1) {
ide  ( source  drain ) cccs probe=vde gain=1
recn ( ecn body drain gate source body ) rde_p_12_hsrf  lf=lg wf=wg nf=nf r=rde
vde  ( ecn body ) vsource  dc=0
 }
//  * core device model 
model p_12_hsrf bsim3v3 type=p  
