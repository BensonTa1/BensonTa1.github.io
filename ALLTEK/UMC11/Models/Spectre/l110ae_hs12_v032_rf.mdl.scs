+  trs=3.22e-3   
ends p_12_hsrf

//  1.2V HS RF Triple well NMOS transistor
inline subckt n_12bpw_hsrf ( drain gate source body nwell psub ) 
parameters hfn_flag=hfnoise  rde=10e6 lf=0.12u wf=1.8u sa=2.2u sb=2.2u nf=16 nf_odd=nf - 2 * 
+ int(nf / 2) nf_even=1 - nf_odd sp_poly=0.40e-6 sp_edge=0.34e-6 xgw=0.18e-6 no_cnt=1 
+ no_via=3 sp_sub_w=1.7e-6 sp_sub_l=0.94e-6 sp_twell_w=2.24e-6 sp_twell_l=1.48e-6 
+ sp_nwell_w=3.74e-6 sp_nwell_l=2.98e-6 wg=(wf * 0.9) lg=(lf * 0.9 + 8e-9) p_area_s=nf_odd * (sp_edge * 
+ (wf) + sp_poly * (wf) * (nf - 1) / 2) + nf_even * (2 * sp_edge * (wf) + sp_poly * (wf) 
+ * (nf / 2 - 1)) p_area_d=nf_odd * (sp_edge * (wf) + sp_poly * (wf) * (nf - 1) / 2) 
+ + nf_even * (sp_poly * (wf) * nf / 2) p_pj_s=nf_odd * (sp_edge * 2 + (wf) + (nf - 
+ 1) / 2 * sp_poly * 2) + nf_even * (sp_edge * 2 * 2 + (wf) * 2 + (nf / 2 - 1) * sp_poly 
+ * 2) p_pj_d=nf_odd * (sp_edge * 2 + (wf) + (nf - 1) / 2 * sp_poly * 2) + nf_even 
+ * (nf / 2 * sp_poly * 2) p_pj_sg=nf * (wf) p_pj_dg=nf * (wf) p_area_tw=((wf) + 2 * sp_twell_w) 
+ * (2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly + 2 * sp_twell_l) p_pj_tw=2 * ((wf) 
+ + 2 * sp_twell_w + 2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly + 2 * sp_twell_l) 
+ p_area_dnw=((wf) + 2 * sp_nwell_w) * (2 * sp_edge + nf * (lf) + (nf - 1) * sp_poly 
+ + 2 * sp_nwell_l) p_pj_dnw=2 * ((wf) + 2 * sp_nwell_w + 2 * sp_edge + nf * (lf) + 
+ (nf - 1) * sp_poly + 2 * sp_nwell_l) dev_l=(2 * sp_edge + nf * lg + (nf - 1) * 
+ sp_poly + 2 * sp_twell_l) dev_w=wg + 2 * sp_twell_w dev_access=dev_l * dev_w / 
+ (16 * (dev_l * dev_l + dev_w * dev_w)) rbulk=85.46 * dev_access - 7992 * wg + 
+ 1.764e+004 * lg + 0.000503 * nf 
// 
//***Igate model***
+ rsh=8.5
+ dtemp=0 
+ tcig=1 + 1.55e-3 * (temp + dtemp - 25) 
+ area=wg * (lg) * 1e4 * tcig * nf
+ toxg=(2.64e-09 + dtox_n_12_hsrf) * 1e2 
+ vdf0=3.11 vdfl= - 0.3e-08 vdfw=3.5e-09 
+ vaf0=0.7 vafl= - 0.8e-10 vafw=1.0e-10 
+ vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 
+ var0=0.60 varl=0e-07 varw=1.0e-10 
+ vdf=(vdf0 + vdfl / (lg) + vdfw / (wg)) * 2.6e7 * toxg 
+ vaf=(vaf0 + vafl / (lg) + vafw / (wg)) * 2.6e7 * toxg 
+ vdr=(vdr0 + vdrl / (lg) + vdrw / (wg)) * 2.6e7 * toxg 
+ var=(var0 + varl / (lg) + varw / (wg)) * 2.6e7 * toxg 
+ igf=2.1e-7 * area * exp( - vdf) * pow(1 / toxg,2.0) 
+ igr=2.1e-7 * area / (lg) * exp( - vdr) * pow(1 / toxg,2.0) 
// 
gigcd ( 20 10 ) bsource i =igf * pow((abs(v(20,10)) + v(20,10)) / 2,vaf) - igr * pow((abs(v(20,10)) - v(20,10)) / 2,var)
gigcs ( 20 30 ) bsource i =igf * pow((abs(v(20,30)) + v(20,30)) / 2,vaf) - igr * pow((abs(v(20,30)) - v(20,30)) / 2,var)
//**************************************************************************************************
//
n_12bpw_hsrf ( 10 20 30 40 ) n_12bpw_hsrf m=nf l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=2.2u sb=2.2u
 
rgc ( gate 22 ) resistor r=40.36*1e-12/(lg*wg*nf) * (1+drgc_n_12_hsrf)
rgi ( 22 21 ) resistor r=3.809 * wg / (lg*nf) * (1+drgi_n_12_hsrf)
rch ( 21 20 ) resistor r=1000 * lg / (wg*nf) * (1+ drch_n_12_hsrf) isnoisy = 0
rdrain ( drain 10 ) resistor r=9.703 * 1e-6 / (wg * nf)
rsource ( source 30 ) resistor r=9.703 * 1e-6 / (wg * nf)
rsubd ( 40 45 ) resistor r=7821 * (0.4u + lg) / (wg * nf)
rsubs ( 44 40 ) resistor r=7821 * (0.4u + lg) / (wg * nf)
rsubbe ( 40 body ) resistor r=14.2 * rbulk
cgs_ext ( 22 30 ) capacitor c=(1.3e-10*wg*nf + 1.592e-16*1e-6/wg*nf+2e-28/(wg*lg*nf)) * (1+dcgd_ext_n_12_hsrf)
cgd_ext ( 22 10 ) capacitor c=(1.3e-10*wg*nf + 1.592e-16*1e-6/wg*nf+5e-4*wg*lg*nf) * (1+dcgd_ext_n_12_hsrf)
cds_ext ( 30 10 ) capacitor c=(1.734e-016*wg*nf*1e6 + 1.13e-008*(lg-0.1u)) * (1+dcds_ext_n_12_hsrf)
djsb ( 44 30 ) sd_diode_core_nch m=1 area=p_area_s perim=p_pj_sg
djsb_p ( 44 30 ) sdp_diode_core_nch m=1 area=1e-20 perim=p_pj_s
djdb ( 45 10 ) sd_diode_core_nch m=1 area=p_area_d perim=p_pj_dg
djdb_p ( 45 10 ) sdp_diode_core_nch m=1 area=1e-20 perim=p_pj_d
dnw ( body 50 ) dionw_l110e area=p_area_tw pj=p_pj_tw
rdnw ( 50 nwell ) resistor r=100 * dev_access
dnwp ( 60 50 ) dnw_psub area=p_area_dnw pj=p_pj_dnw
rpsub ( 60 psub ) resistor r=390 * dev_access 

//   ----- Enhanced Channel Noise -----
if (hfn_flag==1) {
ide  ( source  drain ) cccs probe=vde gain=1
recn ( ecn body drain gate source body ) rde_n_12bpw_hsrf  lf=lg wf=wg nf=nf r=rde 
vde  ( ecn body ) vsource  dc=0
}
