//*****************************************************
//*Subcircuit of the BSIM3 RF macro model*
//*for  0.11um RFCMOS process*
//*3.3V High Gain Triple Well RF n-type MOS*
//*transistors*
//**
//**Scaling Range(before 90% shrink):*
//**1. Finger width (wf): 3um ~ 12um*
//**2. Finger length (lf): 0.34um ~ 1um*
//**3. Finger No. (nf): 2 ~ 32*
//**Voltage range: upto 3.3V*
//**Temperature range:-50C ~ 125C*
//**Frequency range: upto 20.1GHz*
//***
//**Node Definitions:*
//**1--Drain*
//**2--gate*
//**3--source*
//**4--body*
//**5--nwell*
//**6--psub*
//***
//*****************************************************
//! Do not change anything between the SUBCKT and ENDS statement !
//
inline subckt n_33bpw_hgrf ( 1 2 3 4 5 6 )
parameters lf=0.34u
+ wf=12u
+ nf=16
+ mf=1
+ wg=wf*0.9 lg=lf*0.9+1.2e-8
+ lf_u=lf/1e-6
+ wf_u=wf/1e-6
+ nf_odd=nf-2*int(nf/2)
+ nf_even=1-nf_odd
+ lf_shrink=lf*0.9+0.012e-6
+ wf_shrink=wf*0.9
+ lf_shrink_u=lf_shrink/1e-6
+ wf_shrink_u=wf_shrink/1e-6
+ p_cjdb=0.001025
+ p_cjdbg=3.52e-010
+ p_cjdb_pb=0.7
+ p_cjdb_mj=0.25
+ rshg=12*(1+drshg_n_33_hgl110aerf)
+ rcnt=7*(1+drcnt_n_33_hgl110aerf)
+ rvia=1.2*(1+drvia_n_33_hgl110aerf)
+ sp_poly=0.44e-6
+ sp_edge=0.36e-6
+ xgw=0.22e-6
+ no_cnt=1
+ no_via=3
+ sp_sub_w=1.7e-6
+ sp_sub_l=0.94e-6
+ sp_twell_w=2.24e-6
+ sp_twell_l=1.48e-6
+ sp_nwell_w=3.74e-6
+ sp_nwell_l=2.98e-6
// *******************dnw_psub**********
+ p_area_tw=((wf)+2*sp_twell_w)*(2*sp_edge+nf*(lf)+(nf-1)*sp_poly+2*sp_twell_l)
+ p_pj_tw=2*((wf)+2*sp_twell_w+ 2*sp_edge+nf*(lf)+(nf-1)*sp_poly+2*sp_twell_l)
+ p_area_dnw=((wf)+2*sp_nwell_w)*(2*sp_edge+nf*(lf)+(nf-1)*sp_poly+2*sp_nwell_l)
+ p_pj_dnw=2*((wf)+2*sp_nwell_w+ 2*sp_edge+nf*(lf)+(nf-1)*sp_poly+2*sp_nwell_l)
+ dev_l = (2*sp_edge+nf*lg+(nf-1)*sp_poly+2*sp_twell_l)
+ dev_w = wg+2*sp_twell_w
+ dev_access = dev_l * dev_w/(16*(dev_l*dev_l+dev_w*dev_w))
+ a_rch=3.5
+ b_rch=7.441e-01
+ c_rch=9.373e+004
+ a_cgd_ext=3e-017*(1+dcgd_ext_n_33_hgl110aerf)
+ a_rdrain=4.317
+ a_cds=1.38e-2
+ b_cds=0.0002624
+ a_rsubd=10
+ b_rsubd=173.8
+ c_rsubd=1.315e-7
+ a_rsubb=39.91
+ b_rsubb=3210
+ c_rsubb=5300
+ a_cgb_ext=3.469e-016*(1+dcgb_ext_n_33_hgl110aerf)
+ p_area_s=nf_odd*(sp_edge*wf+sp_poly*wf*(nf-1)/2)+nf_even*(2*sp_edge*wf+sp_poly*wf*(nf/2-1))
+ p_area_d=nf_odd*(sp_edge*wf+sp_poly*wf*(nf-1)/2)+nf_even*(sp_poly*wf*nf/2)
+ p_pj_s=nf_odd*(sp_edge*2+wf+(nf-1)/2*sp_poly*2)+nf_even*(sp_edge*2*2+wf*2+(nf/2-1)*sp_poly*2)
+ p_pj_d=nf_odd*(sp_edge*2+wf+(nf-1)/2*sp_poly*2)+nf_even*(nf/2*sp_poly*2)
+ p_pj_sg=nf*wf
+ p_pj_dg=nf*wf
+ p_rgc=(xgw/lf_shrink*rshg+no_cnt*rcnt+no_via*rvia)/nf/2
+ p_rgi=rshg*wf_shrink/lf_shrink/12/nf
+ p_rch=a_rch+b_rch*(lf_shrink/wf_shrink/nf)+c_rch*(lf_shrink/wf_shrink/nf)*(lf_shrink/wf_shrink/nf)
+ p_cgd_ext=a_cgd_ext*wf_shrink_u*nf
+ p_cgs_ext=p_cgd_ext
+ p_cgb_ext=a_cgb_ext*wf_shrink_u
+ p_rdrain=a_rdrain/wf_shrink_u/nf
+ p_rsource=p_rdrain
+ cds_um=(a_cds+b_cds*(1/lf_shrink_u))*1e-15
+ p_cds=(cds_um+abs(cds_um))/2*wf_shrink_u*nf+1e-15
+ p_rsubd=a_rsubd+b_rsubd*(1/(nf*wf_shrink_u))+c_rsubd*(1/(nf*wf_shrink_u))*(1/(nf*wf_shrink_u))
+ p_rsubs=p_rsubd
+ rsub_w=(wf_shrink+2*sp_sub_w)/1e-6
+ rsub_l=(sp_edge*2+nf*lf_shrink+(nf-1)*sp_poly+2*sp_sub_l)/1e-6
+ p_rsubb=a_rsubb+b_rsubb*(1/(rsub_w*rsub_l))+c_rsubb*(1/(rsub_w*rsub_l))*(1/(rsub_w*rsub_l))
rgc ( 2 21 ) resistor r=p_rgc
rgi ( 21 22 ) resistor r=p_rgi
rch ( 22 20 ) resistor r=p_rch*(1+drch_n_33_hgl110aerf) noise=0
cgd_ext ( 21 10 ) capacitor c=p_cgd_ext
cgs_ext ( 21 30 ) capacitor c=p_cgs_ext
cgb_ext ( 20 40 ) capacitor c=p_cgb_ext
rdrain ( 1 10 ) resistor r=p_rdrain
rsource ( 3 30 ) resistor r=p_rsource
djdb ( 12 10 ) pwnmos_33_d area=p_area_d perim=p_pj_d
djdb_g ( 12 10 ) pwnmos_33_dg area=1e-18 perim=p_pj_dg
djsb ( 32 30 ) pwnmos_33_d area=p_area_s perim=p_pj_s
djsb_g ( 32 30 ) pwnmos_33_dg area=1e-18 perim=p_pj_sg
cds ( 30 10 ) capacitor c=p_cds*(1+dcds_ext_n_33_hgl110aerf)
rsubb ( 4 40 ) resistor r=p_rsubb
rsubd ( 40 12 ) resistor r=p_rsubd
rsubs ( 40 32 ) resistor r=p_rsubs
//*...................dnw_psub.................................*
dnw ( 4 50 ) dionw_l110e area=p_area_tw perim=p_pj_tw
rdnw ( 50 5 ) resistor r=100*dev_access
dnwp ( 60 50 ) dnw_psub area=p_area_dnw perim=p_pj_dnw
rpsub ( 60 6 ) resistor r=390*dev_access
//*------------------------------------------------------------*
