//*****************************************************
//*Subcircuit of the BSIM3 RF macro model*
//*for  0.11um RFCMOS process*
//*3.3V High Gain  RF p-type MOS transistors*
//**
//**Scaling Range:*
//**1. Finger width (wf): 2.5um ~ 15um*
//**2. Finger length (lf): 0.34um ~ 1um*
//**3. Finger No. (nf): 2 ~ 32*
//**Voltage range: upto 3.3V*
//**Temperature range:-50C ~ 125C*
//**Frequency range: upto 20.1GHz*
//***
//**Node Definitions:*
//**1--Drain*
//**2--gate*
//**3--source*
//**4--body*
//**5--p substrate (should be ground)*
//***
//*****************************************************
//******************************************************
inline subckt p_33_hgrf ( 1 2 3 4 5 )
parameters lf=0.34u
+ wf=10u
+ nf=16
+ mf=1
+ lf_u=lf/1e-6
+ wf_u=wf/1e-6
+ nf_odd=nf-2*int(nf/2)
+ nf_even=1-nf_odd
+ lf_shrink=lf*0.9+0.012e-6
+ wf_shrink=wf*0.9
+ lf_shrink_u=lf_shrink/1e-6
+ wf_shrink_u=wf_shrink/1e-6
+ rshg=10.33*(1+drshg_p_33_hgl110aerf)
+ rcnt=7*(1+drcnt_p_33_hgl110aerf)
+ rvia=1.2*(1+drvia_p_33_hgl110aerf)
+ sp_poly=0.44e-6
+ sp_edge=0.36e-6
+ xgw=1.04e-6
+ no_cnt=2
+ no_via=2
+ sp_sub_w=1.7e-6
+ sp_sub_l=0.94e-6
+ sp_twell_w=2.24e-6
+ sp_twell_l=1.48e-6
+ sp_nwell_w=1.9e-6
+ sp_nwell_l=2.34e-6
+ a_rch=2.731
+ b_rch=0.02587
+ c_rch=1.211e+005
+ a_cgd_ext=1.0e-18*(1+dcgd_ext_p_33_hgl110aerf)
+ a_cds=0.00067
+ b_cds=0.022
+ a_rsubd=3.936
+ b_rsubd=52.25
+ c_rsubd=5.294e+004
+ a_rsubb=30.37
+ b_rsubb=5000
+ c_rsubb=0.009439
+ a_cgb_ext=3.17e-016*(1+dcgb_ext_p_33_hgl110aerf)
+ p_cj=0.00148
+ p_mj=0.208
+ p_pb=0.698
+ p_area_s=nf_odd*(sp_edge*wf+sp_poly*wf*(nf-1)/2)+nf_even*(2*sp_edge*wf+sp_poly*wf*(nf/2-1))
+ p_area_d=nf_odd*(sp_edge*wf+sp_poly*wf*(nf-1)/2)+nf_even*(sp_poly*wf*nf/2)
+ p_pj_s=nf_odd*(sp_edge*2+wf+(nf-1)/2*sp_poly*2)+nf_even*(sp_edge*2*2+wf*2+(nf/2-1)*sp_poly*2)
+ p_pj_d=nf_odd*(sp_edge*2+wf+(nf-1)/2*sp_poly*2)+nf_even*(nf/2*sp_poly*2)
+ p_pj_sg=nf*wf
+ p_pj_dg=nf*wf
+ p_area_tw=(wf+2*sp_twell_w)*(2*sp_edge+nf*(lf+0.012e-6)+(nf-1)*sp_poly+2*sp_twell_l)
+ p_pj_tw=2*(wf+2*sp_twell_w+2*sp_edge+nf*(lf+0.012e-6)+(nf-1)*sp_poly+2*sp_twell_l)
+ p_area_dnw=(wf+2*sp_nwell_w)*(2*sp_edge+nf*(lf+0.012e-6)+(nf-1)*sp_poly+2*sp_nwell_l)
+ p_pj_dnw=2*(wf+2*sp_nwell_w+2*sp_edge+nf*(lf+0.012e-6)+(nf-1)*sp_poly+2*sp_nwell_l)
+ p_rgc=(xgw/lf_shrink*rshg+no_cnt*rcnt+no_via*rvia)/nf/2
+ p_rgi=rshg*wf_shrink/lf_shrink/12/nf
+ p_rch=a_rch+b_rch*(lf_shrink/wf_shrink/nf)+c_rch*(lf_shrink/wf_shrink/nf)*(lf_shrink/wf_shrink/nf)
+ p_cgd_ext=a_cgd_ext*wf_shrink_u*nf
+ p_cgs_ext=p_cgd_ext
+ p_cgb_ext=a_cgb_ext*wf_shrink_u
+ a_rdain0=0
+ a_rdrain=1
+ p_rdrain=a_rdain0+a_rdrain/wf_shrink_u/nf
+ p_rsource=p_rdrain
+ rdswnf=-1200/nf
+ cds_um=(a_cds+b_cds*(1/lf_shrink_u))*1e-15
+ p_cds=(cds_um+abs(cds_um))/2*wf_shrink_u*nf+0.01e-15
+ p_rsubd=(a_rsubd+b_rsubd*(1/(nf*wf_shrink_u))+c_rsubd*(1/(nf*wf_shrink_u))*(1/(nf*wf_shrink_u)))*2
+ p_rsubs=p_rsubd
+ rsub_w=(wf_shrink+2*sp_sub_w)/1e-6
+ rsub_l=(sp_edge*2+nf*lf_shrink+(nf-1)*sp_poly+2*sp_sub_l)/1e-6
+ p_rsubb=(a_rsubb+b_rsubb*(1/(rsub_w*rsub_l))+c_rsubb*(1/(rsub_w*rsub_l))*(1/(rsub_w*rsub_l)))*0.6
rgc ( 2 21 ) resistor r=p_rgc
rgi ( 21 22 ) resistor r=p_rgi
rch ( 22 20 ) resistor r=p_rch*(1+drch_p_33_hgl110aerf) noise=0
cgd_ext ( 21 10 ) capacitor c=p_cgd_ext
cgs_ext ( 21 30 ) capacitor c=p_cgs_ext
cgb_ext ( 20 40 ) capacitor c=p_cgb_ext
rdrain ( 1 10 ) resistor r=p_rdrain
rsource ( 3 30 ) resistor r=p_rsource
djdb ( 10 12 ) pmos_33_d area=p_area_d perim=p_pj_d
djdb_g ( 10 12 ) pmos_33_dg area=1e-18 perim=p_pj_dg
djsb ( 30 32 ) pmos_33_d area=p_area_s perim=p_pj_s
djsb_g ( 30 32 ) pmos_33_dg area=1e-18 perim=p_pj_sg
cds ( 30 10 ) capacitor c=p_cds*(1+dcds_ext_p_33_hgl110aerf)
rsubb ( 4 40 ) resistor r=p_rsubb
rsubd ( 40 12 ) resistor r=p_rsubd
rsubs ( 40 32 ) resistor r=p_rsubs
p_33_hgrf ( 10 20 30 40 ) p_33_hgrf_main l=lf w=wf ad=0 as=0 pd=0 ps=0 sa=0.36u sb=0.36u
+ m=nf
dnw ( 5 4 ) dio_nw_psub area=p_area_dnw perim=p_pj_dnw
model p_33_hgrf_main bsim3v3 type=p
//**************************************************************
//*     MODEL FLAG PARAMETERS 
//**************************************************************
+ version=3.24
