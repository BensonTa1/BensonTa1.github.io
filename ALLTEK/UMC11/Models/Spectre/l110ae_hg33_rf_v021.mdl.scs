//**************************************************************
//*     GENERAL MODEL PARAMETERS 
//**************************************************************
+ tnom=25                
+ tox=7.68e-009+dtox_p_33_hgl110aerf
+ toxm=7.68e-009
+ wint=4.483e-008
+ lint=4.381e-009        
+ dlc=7.534e-008+ddlc_p_33_hgl110aerf            
+ dwc=-1.386e-007+ddwc_p_33_hgl110aerf
+ hdif=1.34e-007
+ ldif=7.9e-008
+ xl=-9e-009+dxl_p_33_hgl110aerf+1.2e-008
+ xw=4.206e-009+dxw_p_33_hgl110aerf
+ xj=1.9e-007
