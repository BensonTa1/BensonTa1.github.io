parameters dxw_pcap_12=-2e-01 
parameters dcmina_pcap_12=4.0 
include "l110ae_pcap12_v012.mdl.scs" 
endsection min 
  
section max 
parameters dtoxe_pcap_12=-6.000e-11 
parameters dxl_pcap_12=3.3e-02 
parameters dxw_pcap_12=1.50e-01 
parameters dcmina_pcap_12=-3.0 
