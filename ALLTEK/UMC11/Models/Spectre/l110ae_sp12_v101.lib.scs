section igate
subckt n_12_spl110e_ig ( n11 n2 n33 n4 ) 
parameters w=1u l=1u rsh=8.5 hdif=1.25e-07 nrd=hdif / w nrs=hdif / w ad=2 * hdif * w as=2 * hdif 
+ * w pd=2 * (2 * hdif + w) ps=2 * (2 * hdif + w) trise=0 sa=2u sb=2u  
+ tcig=1 + 1.55e-3 * (temp + trise - 25) area=w * 0.9 * (l * 0.9 +1.2e-8) * 1e4 * 
+ tcig toxg=(2.64e-09 + dtox_n_12_spl110e) * 1e2 vdf0=3.11 vdfl= - 0.3e-08 vdfw=3.5e-09 
+ vaf0=0.7 vafl= - 0.8e-10 vafw=1.0e-10 vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 var0=0.60 
+ varl=0e-07 varw=1.0e-10 vdf=(vdf0 + vdfl / (l * 0.9+1.2e-8) + vdfw / (w * 0.9)) * 2.6e7 
+ * toxg vaf=(vaf0 + vafl / (l * 0.9+1.2e-8) + vafw / (w * 0.9)) * 2.6e7 * toxg vdr=(vdr0 
+ + vdrl / (l * 0.9+1.2e-8) + vdrw / (w * 0.9)) * 2.6e7 * toxg var=(var0 + varl / (l * 
+ 0.9+1.2e-8) + varw / (w * 0.9)) * 2.6e7 * toxg igf=2.1e-7 * area * exp( - vdf) * pow(1 
+ / toxg,2.0) igr=2.1e-7 * area / (l * 0.9+1.2e-8) * exp( - vdr) * pow(1 / toxg,2.0) 
// 
mnig ( n1 n2 n3 n4 ) n_12_spl110e trise=trise w=w l=l m=1 nrd=nrd nrs=nrs ad=ad 
+ as=as pd=pd ps=ps sa=sa sb=sb
gigcd ( n2 n1 ) bsource i =igf * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,vaf) - igr * 
+ pow((abs(v(n2,n1)) - v(n2,n1)) / 2,var)
gigcs ( n2 n3 ) bsource i =igf * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,vaf) - igr * 
+ pow((abs(v(n2,n3)) - v(n2,n3)) / 2,var)
rdn ( n1 n11 ) resistor r=rsh * nrd
rsn ( n3 n33 ) resistor r=rsh * nrs
ends n_12_spl110e_ig
// 
subckt p_12_spl110e_ig ( p11 p2 p33 p4 ) 
parameters w=1u l=1u rsh=7.6 hdif=1.25e-07 nrd=hdif / w nrs=hdif / w ad=2 * hdif * w as=2 * hdif 
+ * w pd=2 * (2 * hdif + w) ps=2 * (2 * hdif + w) trise=0 sa=2u sb=2u  
+ tcig=1 + 2.25e-3 * (temp + trise - 25) area=w * 0.9 * (l * 0.9 + 1.2e-8) * 1e4 * 
+ tcig toxg=(2.83e-09 + dtox_p_12_spl110e) * 1e2 vdf0=3.22 vdfl= - 7.00e-09 vdfw= 
+ - 6.0e-8 vaf0=0.6 vafl= - 1.5e-08 vafw= - 3.0e-8 vdr0=5.50 vdrl= + 1.50e-08 vdrw= 
+ - 1.0e-07 var0=0.35 varl= + 1.50e-08 varw=4.0e-8 vdf=(vdf0 + vdfl / (l * 0.9+1.2e-8) 
+ + vdfw / (w * 0.9)) * 2.6e7 * toxg vaf=(vaf0 + vafl / (l * 0.9+1.2e-8) + vafw / (w * 
+ 0.9)) * 2.6e7 * toxg vdr=(vdr0 + vdrl / (l * 0.9+1.2e-8) + vdrw / (w * 0.9)) * 2.6e7 
+ * toxg var=(var0 + varl / (l * 0.9+1.2e-8) + varw / (w * 0.9)) * 2.6e7 * toxg igf=2.1e-7 
+ * area * exp( - vdf) * pow(1 / toxg,2.0) igr=2.1e-7 * area / (l * 0.9+1.2e-8) * exp( - vdr) * 
+ pow(1 / toxg,2.0) 
// 
mpig ( p1 p2 p3 p4 ) p_12_spl110e trise=trise w=w l=l m=1 nrd=nrd nrs=nrs ad=ad 
+ as=as pd=pd ps=ps sa=sa sb=sb
gigcd ( p2 p1 ) bsource i = - igf * pow((abs(v(p2,p1)) - v(p2,p1)) / 2,vaf) + igr 
+ * pow((abs(v(p2,p1)) + v(p2,p1)) / 2,var)
gigcs ( p2 p3 ) bsource i = - igf * pow((abs(v(p2,p3)) - v(p2,p3)) / 2,vaf) + igr 
+ * pow((abs(v(p2,p3)) + v(p2,p3)) / 2,var)
rdp ( p1 p11 ) resistor r=rsh * nrd
rsp ( p3 p33 ) resistor r=rsh * nrs
 
ends p_12_spl110e_ig
//
subckt n_12bpw_spl110e_ig ( n11 n2 n33 n4 ) 
parameters w=1u l=1u rsh=8.5 hdif=1.25e-07 nrd=hdif / w nrs=hdif / w ad=2 * hdif * w as=2 * hdif 
+ * w pd=2 * (2 * hdif + w) ps=2 * (2 * hdif + w) trise=0 sa=2u sb=2u  
+ tcig=1 + 1.55e-3 * (temp + trise - 25) area=w * 0.9 * (l * 0.9 + 1.2e-8) * 1e4 * 
+ tcig toxg=(2.64e-09 + dtox_n_12_spl110e) * 1e2 vdf0=3.11 vdfl= - 0.3e-08 vdfw=3.5e-09 
+ vaf0=0.7 vafl= - 0.8e-10 vafw=1.0e-10 vdr0=5.78 vdrl=0e-07 vdrw=5.0e-09 var0=0.60 
+ varl=0e-07 varw=1.0e-10 vdf=(vdf0 + vdfl / (l * 0.9+1.2e-8) + vdfw / (w * 0.9)) * 2.6e7 
+ * toxg vaf=(vaf0 + vafl / (l * 0.9+1.2e-8) + vafw / (w * 0.9)) * 2.6e7 * toxg vdr=(vdr0 
+ + vdrl / (l * 0.9+1.2e-8) + vdrw / (w * 0.9)) * 2.6e7 * toxg var=(var0 + varl / (l * 
+ 0.9+1.2e-8) + varw / (w * 0.9)) * 2.6e7 * toxg igf=2.1e-7 * area * exp( - vdf) * pow(1 
+ / toxg,2.0) igr=2.1e-7 * area / (l * 0.9+1.2e-8) * exp( - vdr) * pow(1 / toxg,2.0) 
// 
mnig ( n1 n2 n3 n4 ) n_12bpw_spl110e trise=trise w=w l=l m=1 nrd=nrd nrs=nrs ad=ad 
+ as=as pd=pd ps=ps sa=sa sb=sb
gigcd ( n2 n1 ) bsource i =igf * pow((abs(v(n2,n1)) + v(n2,n1)) / 2,vaf) - igr * 
+ pow((abs(v(n2,n1)) - v(n2,n1)) / 2,var)
gigcs ( n2 n3 ) bsource i =igf * pow((abs(v(n2,n3)) + v(n2,n3)) / 2,vaf) - igr * 
+ pow((abs(v(n2,n3)) - v(n2,n3)) / 2,var)
rdn ( n1 n11 ) resistor r=rsh * nrd
rsn ( n3 n33 ) resistor r=rsh * nrs
ends n_12bpw_spl110e_ig
// 
endsection igate
 
 
