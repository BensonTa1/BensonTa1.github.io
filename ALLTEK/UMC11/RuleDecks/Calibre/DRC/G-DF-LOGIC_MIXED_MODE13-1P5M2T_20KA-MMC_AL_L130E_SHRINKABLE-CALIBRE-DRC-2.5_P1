// ================================
// ====== ILLEGAL DUMMY RULE ======
// ================================

GROUP ILLEGAL_DUMMY ILLEGAL_DUMMY_?

ILLEGAL_DUMMY_DIFF {@ DIFFUSION_CUSTOMER_DUMMY interact original DIFFUSION, POLY1 or CONTACT is NOT recommended
                    @ For details, please refer to relative DSM and command file for dummy
    DIFFDUMY INTERACT CONT
    DIFFDUMY INTERACT DIFF
    DIFFDUMY INTERACT PO1
}

ILLEGAL_DUMMY_PO1 {@ POLY1_CUSTOMER_DUMMY interact original DIFFUSION, POLY1 or CONTACT is NOT recommended
                   @ For details, please refer to relative DSM and command file for dummy
    PO1DUMY INTERACT CONT
    PO1DUMY INTERACT DIFF
    PO1DUMY INTERACT PO1
}

ILLEGAL_DUMMY_ME1 {@ METAL1_CUSTOMER_DUMMY interact original CONTACT, VI1 or METAL1 is NOT recommended
                   @ For details, please refer to relative DSM and command file for dummy
    M1DUMY INTERACT CONT
    M1DUMY INTERACT VI1
    M1DUMY INTERACT ME1
}

ILLEGAL_DUMMY_ME2 {@ METAL2_CUSTOMER_DUMMY interact original VI1, VI2 or METAL2 is NOT recommended
                   @ For details, please refer to relative DSM and command file for dummy
