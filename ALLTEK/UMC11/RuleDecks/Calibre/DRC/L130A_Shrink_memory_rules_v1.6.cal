SP_16.4B.1D.b {@ Minimum METAL1 enclosure of CONTACT at end-of-line or outer corner is 0.06 um when METAL1 width < 0.24um
               @ when CONTACT area 0.023 sq.um < x <= 0.0235 sq.um waive
    co_sm24 = CONT_SP_16_AREA_NORMAL INTERACT SM1_024
    E = RECTANGLE ENC co_sm24 ME1
    GOOD 0.00 0.06 OPPOSITE 0.00 0.06 OPPOSITE
    E AND SP_16
}

SP_16.4B.1E {@ Minimum area of METAL1 region 0.0929 sq.um
    E = AREA ME1_SP_16 < 0.0929
    E AND SP_16
}

SP_16.4B.2C.a {@ Minimum extension from METAL1(width<10um) to MVIA1 is 0um, no VI1 outside ME1
               @ when VI1 sizing -0.01um
    x = SIZE VI1_SP_16 BY -0.01
    E = NOT x ME1
    E AND SP_16
}

CHK_SP_16_ME1_A_0 = VERTEX ME1_SP_16 == 6
CHK_SP_16_ME1_A_1 = LENGTH CHK_SP_16_ME1_A_0 == 0.32
CHK_SP_16_ME1_A_2 = LENGTH CHK_SP_16_ME1_A_0 == 0.224
CHK_SP_16_ME1_A_3 = LENGTH CHK_SP_16_ME1_A_0 > 0.132 < 0.134
CHK_SP_16_ME1_A_4 = LENGTH CHK_SP_16_ME1_A_0 == 0.132
CHK_SP_16_ME1_A_5 = LENGTH CHK_SP_16_ME1_A_0 > 0.132 < 0.134
CHK_SP_16_ME1_A_6 = LENGTH CHK_SP_16_ME1_A_0 == 0.224
CHK_SP_16_ME1_A = (((((CHK_SP_16_ME1_A_0 WITH EDGE CHK_SP_16_ME1_A_1) WITH EDGE CHK_SP_16_ME1_A_2) WITH EDGE CHK_SP_16_ME1_A_3) WITH EDGE CHK_SP_16_ME1_A_4) WITH EDGE CHK_SP_16_ME1_A_5) WITH EDGE CHK_SP_16_ME1_A_6

CHK_SP_16_ME1_B_0 = VERTEX ME1_SP_16 == 6
CHK_SP_16_ME1_B_1 = LENGTH CHK_SP_16_ME1_B_0 == 0.324
CHK_SP_16_ME1_B_2 = LENGTH CHK_SP_16_ME1_B_0 == 0.256
CHK_SP_16_ME1_B_3 = LENGTH CHK_SP_16_ME1_B_0 > 0.119 < 0.121
CHK_SP_16_ME1_B_4 = LENGTH CHK_SP_16_ME1_B_0 == 0.154
CHK_SP_16_ME1_B_5 = LENGTH CHK_SP_16_ME1_B_0 > 0.119 < 0.121
CHK_SP_16_ME1_B_6 = LENGTH CHK_SP_16_ME1_B_0 == 0.256
CHK_SP_16_ME1_B = (((((CHK_SP_16_ME1_B_0 WITH EDGE CHK_SP_16_ME1_B_1) WITH EDGE CHK_SP_16_ME1_B_2) WITH EDGE CHK_SP_16_ME1_B_3) WITH EDGE CHK_SP_16_ME1_B_4) WITH EDGE CHK_SP_16_ME1_B_5) WITH EDGE CHK_SP_16_ME1_B_6

MEX1_16 = ME1_SP_16 NOT (CHK_SP_16_ME1_A OR CHK_SP_16_ME1_B)
MEX1P_16 = VERTEX MEX1_16 > 10
ME1_EDGE_16 = CONVEX EDGE MEX1P_16 ANGLE1 > 90 < 180 ANGLE2 > 90 < 180 WITH LENGTH >0.119 < 0.155

MEX1PX1_16 = EXTENTS (EXPAND EDGE ME1_EDGE_16 INSIDE BY 0.01 CORNER FILL)
MEX1PX_16 = MEX1_16 OR MEX1PX1_16
MEX2_16 = EXTENTS (CHK_SP_16_ME1_A OR CHK_SP_16_ME1_B)
MEX_16 = MEX1PX_16 OR MEX2_16

SP_16.4B.2C.c_d_e {@ METAL1 enclose MVIA1 at end-of-line or outer corner is 0.06 um
                   @ waive (GOOD 0.06 0.027 0.06 0.091)
                   @ waive (GOOD 0.06 0.062 0.081 0.062)
                   @ waive (GOOD 0.04 0.083 0.04 0.083)
                   @ waive (GOOD 0.04 0.236 0.04 0.236)
                   @ waive (GOOD 0.017 0.334 0.017 0.334)
                   @ waive (GOOD 0.04 0.321 0.04 0.321)
    x = ENC [VI1] ME1_SP_16 < 0.06 ABUT<90 OPPOSITE      // via edge with metal enc < 0.06
    y = INT x < 0.2 ABUT==90 INTERSECTING ONLY REGION    // 0.2 is MVIA1 size
    z = VI1 INTERACT y
    E = RECTANGLE ENC z MEX_16 ABUT SINGULAR OUTSIDE ALSO
        GOOD 0.06 0.027 0.06 0.091
        GOOD 0.06 0.062 0.081 0.062
        GOOD 0.04 0.083 0.04 0.083
        GOOD 0.04 0.236 0.04 0.236
        GOOD 0.017 0.334 0.017 0.334
        GOOD 0.04 0.321 0.04 0.321
    E AND SP_16
}

SP_16.4B.3B.a_ME2_1 {@ Minimum METAL2 to METAL2 spacing is 0.152 um
                     @ METAL2 corner to METAL2 corner
    E = EXT ME2 < 0.152 ABUT>0<90 SINGULAR REGION
    E AND SP_16
}

SP_16.4B.3B.a_ME2_2 {@ Minimum METAL2 to METAL2 spacing is 0.199 um
                     @ others
    E1 = EXT ME2 < 0.199 ABUT>0<90 SINGULAR NOT CORNER REGION EXCLUDE FALSE
    E1 AND SP_16
    E2 = EXT ME2 < 0.199 ABUT>0<90 SINGULAR CORNER TO EDGE REGION
    E2 AND SP_16
}

SP_16.4B.3D.b_c_ME2 {@ METAL2 enclose MVIA1 at end-of-line or outer corner is 0.026 um
    x = ENC [VI1_SP_16] ME2 < 0.026 ABUT<90 OPPOSITE   // via edge with metal enc < 0.026
    E = INT x < 0.2 ABUT==90 INTERSECTING ONLY REGION  // 0.2 is MVIA1 size
    E AND SP_16
}

SP_16.4B.4A_VI2 {@ Exact MVIA2 size is 0.20um
                 @ when MVIA2 area 0.04 sq.um < x <= 0.0405 sq.um waive
    E = NOT RECTANGLE VI2_SP_16_AREA_NORMAL == 0.20 BY == 0.20
    E AND SP_16
}

SP_16.4B.4C.c_d_e_VI2 {@ METAL2 enclose MVIA2 at end-of-line or outer corner is 0.06 um
                       @ waive (GOOD 0.034 0.363 0.034 0.066)
                       @ waive (GOOD 0.034 0.082 0.034 0.186)
                       @ waive (GOOD 0.034 0.159 0.034 0.159)
                       @ waive (GOOD 0.026 0.021 0.026 0.021)
                       @ waive (GOOD 0.04 0.247 0.04 0.321)
                       @ waive (GOOD 0.04 0.057 0.04 0.109)
                       @ waive (GOOD 0.04 0.236 0.04 0.236)
                       @ waive (GOOD 0.034 0.159 0.034 1.736)
    x = ENC [VI2] ME2_SP_16 < 0.06 ABUT<90 OPPOSITE     // via edge with metal enc < 0.06
    y = INT x < 0.2 ABUT==90 INTERSECTING ONLY REGION   // 0.2 is MVIA2 size
    z = VI2 INTERACT y
    E = RECTANGLE ENC z ME2_SP_16 ABUT SINGULAR OUTSIDE ALSO
        GOOD 0.034 0.363 0.034 0.066
        GOOD 0.034 0.082 0.034 0.186
        GOOD 0.034 0.159 0.034 0.159
        GOOD 0.026 0.021 0.026 0.021
        GOOD 0.04 0.247 0.04 0.321
        GOOD 0.04 0.057 0.04 0.109
        GOOD 0.04 0.236 0.04 0.236
        GOOD 0.034 0.159 0.034 1.736
    E AND SP_16
}

SP_16.4B.3D.b_c_ME3_1 {@ METAL3 enclose MVIA2 at end-of-line or outer corner is 0.04 um
                       @ When the common run length <= 0.28um
    x  = ENC [VI2_SP_16] ME3 < 0.04 ABUT<90 OPPOSITE PROJ <=0.28      // via edge with metal enc < 0.04
    E1 = INT x < 0.2 ABUT==90 INTERSECTING ONLY REGION                // 0.2 is MVIA2 size
    E1 AND SP_16
    y  = ENC [VI2_SP_16] ME3 < 0.04 ABUT<90 OPPOSITE NOT PROJ         // via edge with metal enc < 0.04
    E2 = INT y < 0.2 ABUT==90 INTERSECTING ONLY REGION                // 0.2 is MVIA2 size
    E2 AND SP_16
    z  = ENC [VI2_SP_16] ME3 < 0.04 ABUT<90 OPPOSITE CORNER TO CORNER // via edge with metal enc < 0.04
    E3 = INT z < 0.2 ABUT==90 INTERSECTING ONLY REGION                // 0.2 is MVIA2 size
    E3 AND SP_16
}

SP_16.4B.3D.b_c_ME3_2 {@ METAL3 enclose MVIA2 at end-of-line or outer corner is 0.06 um
                       @ others, (When the common run length > 0.28um)
    x = ENC [VI2_SP_16] ME3 < 0.06 ABUT<90 OPPOSITE PROJ > 0.28      // via edge with metal enc < 0.06
    E = INT x < 0.2 ABUT==90 INTERSECTING ONLY REGION                // 0.2 is MVIA2 size
    E AND SP_16
}

//=========================
// SP_18 SRAM (6TSRAM1.41LL)
//=========================

DIFF_SP_18  = DIFF INTERACT SP_18
NWEL_SP_18  = NWEL INTERACT SP_18
PO1_SP_18   = PO1  INTERACT SP_18
GATE_SP_18  = GATE AND SP_18
GATE_W_SP_18 = PO1_SP_18 COIN INSIDE EDGE GATE_SP_18
GATE_Wc_SP_18 = GATE_W_SP_18  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_SP_18 = GATE_W_SP_18 NOT INSIDE EDGE TG
ACTIVE_PS_SP_18 = DIFF_SP_18 OUTSIDE NWEL

PDIF1_SP_18 = PDIF1 AND SP_18
NDIF1_SP_18 = NDIF1 AND SP_18

PPLUS_SP_18  = PPLUS INTERACT SP_18
CONT_SP_18   = CONT INTERACT SP_18
POLCNT_SP_18 = POLCNT AND SP_18
DIFCNT_SP_18 = DIFCNT AND SP_18
ME1_SP_18  = ME1 INTERACT SP_18
VI1_SP_18  = VI1 INTERACT SP_18
ME2_SP_18  = ME2 INTERACT SP_18
VI2_SP_18  = VI2 INTERACT SP_18

CONT_SP_18_AREA = AREA CONT_SP_18 > 0.023 <= 0.0235
CONT_SP_18_AREA_NORMAL = CONT_SP_18 NOT CONT_SP_18_AREA

VI2_SP_18_AREA = AREA VI2_SP_18 > 0.04 <= 0.0405
VI2_SP_18_AREA_NORMAL = VI2_SP_18 NOT VI2_SP_18_AREA

