SP_16.4A.10B {@ Minimum N+ implant to N+ implant spacing is 0.18 um
    E = EXT NPLUS < 0.18 ABUT>0<90 SINGULAR REGION
    E AND SP_16
}

SP_16.4A.10C.a {@ Minimum N+ implant overhang of N+ DIFFUSION (inside P_WELL) is 0.144 um
    x = ENC ACTIVE_PS NPLUS < 0.144 ABUT<90 SINGULAR REGION
    y = ENC ACTIVE_TW NPLUS < 0.144 ABUT<90 SINGULAR REGION
    (x OR y) AND SP_16
}

SP_16.4A.10D.a {@ Minimum N+ implant to P+ DIFFUSION spacing (inside N_WELL) is 0.159 um
                @ (DIFFUSION overlap (N+ and P+) is not allowed)
    E = EXT NPLUS ACTIVE_NT < 0.159 ABUT<90 SINGULAR REGION
    E AND SP_16
}

SP_16.4A.11B_1 {@ Minimum P+ implant to P+ implant spacing is 0.125 um
                @ when the common run length <= 0.267 um (x <=0.267)
    E1 = EXT PPLUS < 0.125 ABUT>0<90 SINGULAR PROJ <=0.267 REGION
    E1 AND SP_16
    E2 = EXT PPLUS < 0.125 ABUT>0<90 SINGULAR NOT PROJ REGION
    E2 AND SP_16
    E3 = EXT PPLUS < 0.125 ABUT>0<90 SINGULAR CORNER TO CORNER REGION
    E3 AND SP_16
}

SP_16.4A.11B_2 {@ Minimum P+ implant to P+ implant spacing is 0.17 um
                @ when the common run length between 0.267 to 0.827 (0.267 < x <=0.827)
    E = EXT PPLUS < 0.17 ABUT>0<90 SINGULAR PROJ >0.267 <=0.827 REGION
    E AND SP_16
}

SP_16.4A.11B_3 {@ Minimum P+ implant to P+ implant spacing is 0.125 um
                @ when the common run length between 0.827 to 1.042 (0.827 < x <=1.042)
    E = EXT PPLUS < 0.125 ABUT>0<90 SINGULAR PROJ >0.827 <=1.042 REGION
    E AND SP_16
}

SP_16.4A.11B_4 {@ Minimum P+ implant to P+ implant spacing is 0.24 um
