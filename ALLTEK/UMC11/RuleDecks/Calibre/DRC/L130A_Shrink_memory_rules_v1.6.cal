SPS.4A.9F_8 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.025um when the common run length  between 0.165 to 0.19 (0.165< x <=0.19)
   E = EXT PO1_SPS DIFF < 0.025 PROJ > 0.165 <= 0.19 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_9 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.077um when the common run length  between 0.19 to 0.2 (0.19< x <=0.2)
   E = EXT PO1_SPS DIFF < 0.077 PROJ > 0.19 <= 0.2 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_10 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.025um when the common run length  between 0.2 to 0.355 (0.2< x <0.355)
   E = EXT PO1_SPS DIFF < 0.025 PROJ > 0.2 <= 0.355 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_11 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.1um when the common run length  between 0.355 to 0.48 (0.355< x <0.48)
   E = EXT PO1_SPS DIFF < 0.1 PROJ > 0.355 < 0.48 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_12 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.03um when the common run length  ==0.48
   E = EXT PO1_SPS DIFF < 0.03 PROJ == 0.48 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_13 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.1um when the common run length  >0.48
   E = EXT PO1_SPS DIFF < 0.1 PROJ > 0.48 SINGULAR REGION
   E AND SPS
}

SPS.4A.9G {@ Minimum PO1 endcap to RELATED DIFF spacing is 0.06um
   END_CAP =  INTPOL TOUCH GATE == 1
   x = EXT DIFF_SPS GATE < 0.06 PERP ONLY ABUT == 90 REGION
   x INTERACT END_CAP
}

    GATE_SPS_4 = AREA GATE_SPS == 0.0354
    GATE_SPS_5 = AREA GATE_SPS == 0.0198
    GATE_SPS_6 = OR GATE_SPS_4 GATE_SPS_5
    GATE_SPS_8 = AREA GATE_SPS == 0.0102
//    GATE_SPS_9 = GATE_SPS_8 INTERACT CONT

SPS.4A.9H.a__4A.9O_1 {@ Minimum PO1 gate to field edge spacing is 0.005um
   GATE_W_PL = PO1 COIN INSIDE EDGE PL_GATE_SPS
   E = ENC GATE_W_PL DIFF_SPS < 0.005 REGION
   E AND SPS
}
SPS.4A.9H.a__4A.9O_2 {@ Minimum PO1 gate to field edge spacing is 0.01um
   GATE_W_PD = PO1 COIN INSIDE EDGE PD_GATE_SPS
   E = ENC GATE_W_PD DIFF_SPS < 0.01 REGION
   E AND SPS
}
SPS.4A.9H.a__4A.9O_3 {@ Minimum PO1 gate to field edge spacing is 0.185um
   GATE_W_PG = PO1 COIN INSIDE EDGE PG_GATE_SPS
   E = ENC GATE_W_PG DIFF_SPS < 0.185 REGION
   E AND SPS
}
SPS.4A.9H.a__4A.9O_4 {@ Minimum PO1 gate to field edge spacing is 0.01um
                      @ when gate area = 0.0354 or 0.0198um2
//   GATE_W_4 = PO1 COIN INSIDE EDGE GATE_SPS_6
   E = ENC GATE_SPS_6 DIFF_SPS < 0.01 REGION
   E AND SPS
}
SPS.4A.9H.a__4A.9O_5 {@ Minimum PO1 gate to field edge spacing is 0.095um
                      @ when gate area with cont = 0.0031125 or 0.00765 um2
//   GATE_W_3 = PO1 COIN INSIDE EDGE ((GATE_SPS_1 OR GATE_SPS_2) INTERACT CONT)
   E = ENC GATE_SPS_3 DIFF_SPS < 0.095 REGION
   E AND SPS
}
SPS.4A.9H.a__4A.9O_6 {@ Minimum PO1 gate to field edge spacing is 0.06um for others
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_6
   GATE_W_O = PO1 COIN INSIDE EDGE GATE_O_SPS_A
   E = ENC GATE_W_O DIFF_SPS < 0.06 REGION
   E AND SPS
}

// SPS.4A.9J {@ Gate at 90 degree angle is not allowed.
//    Waive

SPS.4A.9N {@ Minimum PO1 bent gate on field region to DIffusion spacing = 0.09
   x = EXT GATE_W EXPO_E < 0.09 OBTUSE ONLY REGION
   x AND SPS
}

CONT_SPS_A = RECTANGLE CONT_SPS == 0.16 BY == 0.16
CONT_SPS_SINGLE = AREA CONT_SPS == 0.0255

SPS.4A.13A {@ Minimum and maximum width of a CONT region is 0.16um
            @ Waive Share CONT  : area is 0.0937 or 0.078475 or 0.086725
            @ Waive Single CONT : area is 0.0255
   X  = NOT RECTANGLE CONT_SPS == 0.16 BY == 0.16
   Y1 = AREA X == 0.0937
   Y2 = AREA X == 0.078475
   Y3 = AREA X == 0.086725
   Y4 = AREA X == 0.0255
   (((X NOT Y1) NOT Y2) NOT Y3) NOT Y4
}
SPS.4A.13B_1 {@ Minimum space between two CONT regions is 0.152um, when point to edge (By Pass Shared Cont)
              @ point to edge
   X = EXT CONT_SPS_A CONT < 0.152 ABUT>0<90 CORNER TO EDGE REGION
   Y = EXT CONT_SPS_SINGLE CONT < 0.152 ABUT>0<90 CORNER TO EDGE REGION
   (X OR Y) AND SPS
}
SPS.4A.13B_2 {@ Minimum space between two CONT regions is 0.10um, By Pass Shared Cont
   X = EXT CONT_SPS_A < 0.10 ABUT>0<90 SINGULAR REGION
   Y = EXT CONT_SPS_A CONT_SPS_SINGLE < 0.10 ABUT>0<90 SINGULAR REGION
   (X OR Y) AND SPS
}

SPS.4A.13C.a {@ Minimum DIFF CONT to Poly(1.2V) spacing is 0.025um, By Pass Shared Cont
   DIFCNT_SPS_A = (CONT_SPS_A OR CONT_SPS_SINGLE) INTERACT DIFF
   X = EXT DIFCNT_SPS_A GATE1_W < 0.025 ABUT>0<90 OPPOSITE REGION
   x AND SPS
}

SPS.4A.13D {@ when the poly cont area=0.0255 um2,the common rule length<=0.16, waive
            @ others is 0.12 um
   x = AREA POLCNT_SPS == 0.0255
   EXT x DIFF < 0.12 PROJ > 0.16 ABUT<90 SINGULAR REGION
   EXT (POLCNT_SPS NOT x) DIFF < 0.12 ABUT<90 SINGULAR REGION
}

SPS.4A.13E {@ Minimum PO1 overlap CONT is 0.06um, no floating conntact
            @ By pass (0.022 0.06 0.022 0.06)
    POLCNT_SPS_A = CONT_SPS_A INTERACT PO1
    X = ENC POLCNT_SPS_A PO1_SPS < 0.06 ABUT<90 SINGULAR OUTSIDE ALSO REGION
    X1 = CONT INTERACT X
    RECTANGLE ENC X1 PO1_SPS
    GOOD 0.022 0.06 OPPOSITE 0.022 0.06 OPPOSITE
}

SPS.4A.13FG {@ Minimum extension of an DIFF region beyond a CONT region is
             @ Size single size -0.015
             @ By pass (0.025 0.055 0.025 0.07 )
             @ By pass (0.02  0.065 0.011 0.075)
             @ By pass (0     0.025 0.011 0.03)
             @ By pass (0.035 0.05  0.035 0.05)
             @ By pass (0.02  0.075 0.011 0.065)
             @ By pass (0.025 0.075 0.025 0.075)
             @ By pass (0.075 0.075 0.075 0.075)

   CONT_SPS_SA = SIZE CONT_SPS_A BY -0.015
   RECTANGLE ENC CONT_SPS_SA DIFF_SPS
   GOOD 0.025 0.055 OPPOSITE 0.025 0.07  OPPOSITE
   GOOD 0.02  0.065 OPPOSITE 0.011 0.075 OPPOSITE
   GOOD 0     0.025 OPPOSITE 0.011 0.03  OPPOSITE
   GOOD 0.035 0.05  OPPOSITE 0.035 0.05  OPPOSITE
   GOOD 0.02  0.075 OPPOSITE 0.011 0.065 OPPOSITE
   GOOD 0.025 0.075 OPPOSITE 0.025 0.075 OPPOSITE
   GOOD 0.075 0.075 OPPOSITE 0.075 0.075 OPPOSITE
}

SPS.4A.13I {@ Poly contact on diffusion is not allowed.
  DIFFCNT_SPS_A = CONT_SPS_A INTERACT DIFF
   (GATE AND DIFFCNT_SPS_A) AND SPS
}

/////////////////////////////

//SPS.4B.1A {@ Minimum width of ME1 region is 0.16um
//    x = INT ME1 < 0.16 ABUT>0<90 SINGULAR REGION
//    ( ((x NOT SRAM) NOT LOGOMK) NOT DP4 ) AND SPS
//}// the same with main deck

//SPS.4B.1C {@ Minimum space between ME1 regions is 0.16um
//    x = EXT ME1 < 0.16 ABUT>0<90 REGION
//    ((x NOT SRAM) NOT LOGOMK ) AND SPS
//}// the same with main deck

SPS.4B.1D.a {@ Minimum ME1 overlap contac is 0 um,waive share cont
    x = CONT_SPS_A NOT ME1
    x AND SPS
}

SPS.4B.1D.b {@ ME1 enclose CONT at end-of-line or outer corner is 0.06,when ME1 width < 0.24
              @ waive share Cont
              @  cont (GOOD 0.01 0.015 OPPOSITE 0.04 0.165 OPPOSITE)
              @  cont (GOOD 0.00 0.06  OPPOSITE 0.00 0.06  OPPOSITE)
              @  cont (GOOD0.01 0.00  0.05  0.05)

    co_sm24 = CONT_SPS_A INTERACT SM1_024
    y = RECTANGLE ENC co_sm24 ME1
    GOOD 0.01 0.015 OPPOSITE 0.04 0.165 OPPOSITE
    GOOD 0.00 0.06  OPPOSITE 0.00 0.06  OPPOSITE
    GOOD 0.01 OPPOSITE 0.00  0.05  0.05
    y AND SPS
}

//SPS.4B.3C {@ Minimum space between two ME2 regions is 0.20um
//   X = EXT ME2 < 0.20 ABUT>0<90 REGION
//   ( X NOT LOGOMK ) AND SPS
//}// the same with main deck



//==========================
// SPLLS SRAM (6TSRAM1.85LL)
//==========================

DIFF_SPLLS  = DIFF INTERACT SPLLS
NWEL_SPLLS  = NWEL INTERACT SPLLS
PO1_SPLLS   = PO1  INTERACT SPLLS
GATE_SPLLS  = GATE AND SPLLS
GATE_W_SPLLS = PO1_SPLLS COIN INSIDE EDGE GATE_SPLLS
GATE_Wc_SPLLS = GATE_W_SPLLS  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_SPLLS = GATE_W_SPLLS NOT INSIDE EDGE TG
ACTIVE_PS_SPLLS = DIFF_SPLLS OUTSIDE NWEL

PDIF1_SPLLS = PDIF1 AND SPLLS
NDIF1_SPLLS = NDIF1 AND SPLLS

PPLUS_SPLLS  = PPLUS INTERACT SPLLS
CONT_SPLLS   = CONT INTERACT SPLLS
POLCNT_SPLLS = POLCNT AND SPLLS
DIFCNT_SPLLS = DIFCNT AND SPLLS
ME1_SPLLS  = ME1 INTERACT SPLLS


SPLLS.4A.1AB_1 {@ Minimum dimension of an DIFF is 0.125 when common run length <=0.055
   X = INT DIFF_SPLLS < 0.125 ABUT>0<90 SINGULAR PROJECTING <=0.055 REGION
   X AND SPLLS
}
SPLLS.4A.1AB_2 {@ Minimum dimension of an DIFF is 0.145 when common run length 0.055< x <=0.08
   X = INT DIFF_SPLLS < 0.145 ABUT>0<90 SINGULAR PROJECTING > 0.055 <= 0.08 REGION
   X AND SPLLS
}
SPLLS.4A.1AB_3 {@ Minimum dimension of an DIFF is 0.12 when common run length 0.08< x <=0.165
   X = INT DIFF_SPLLS < 0.12 ABUT>0<90 SINGULAR PROJECTING > 0.08 <= 0.165 REGION
   X AND SPLLS
}

SPLLS.4A.1AB_4 {@ Minimum dimension of an DIFF is 0.13 when common run length 0.165< x <=0.21
   X = INT DIFF_SPLLS < 0.13 ABUT>0<90 SINGULAR PROJECTING >0.165 <=0.21 REGION
   X AND SPLLS
}

SPLLS.4A.1AB_5 {@ Minimum dimension of an DIFF is 0.125 when common run length 0.21< x <=0.23
   X = INT DIFF_SPLLS < 0.125 ABUT>0<90 SINGULAR PROJECTING >0.21 <=0.23 REGION
   X AND SPLLS
}

SPLLS.4A.1AB_6 {@ Minimum dimension of an DIFF is 0.16 when common run length >0.23
   X = INT DIFF_SPLLS < 0.16 ABUT>0<90 SINGULAR PROJECTING >0.23 REGION
   X AND SPLLS
}



SPLLS.4A.1C.a1b1_1 {@ Minimum space between two DIFF regions is 0.08um when common run length <=0.02
   X = EXT DIFF_SPLLS < 0.08 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPLLS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y <=0.02)
   E AND SPLLS
}
SPLLS.4A.1C.a1b1_2 {@ Minimum space between two DIFF regions is 0.165um when common run length 0.02<X<=0.03
   X = EXT DIFF_SPLLS < 0.165 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPLLS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.02 <=0.03 )
   E AND SPLLS
}
SPLLS.4A.1C.a1b1_3 {@ Minimum space between two DIFF regions is 0.055um when common run length 0.03<X<=0.04
   X = EXT DIFF_SPLLS < 0.055 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPLLS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.03 <=0.04 )
   E AND SPLLS
}

SPLLS.4A.1C.a1b1_4 {@ Minimum space between two DIFF regions is 0.18um when common run length 0.04<X<=0.165
                    @ waive notch check
   X = EXT DIFF_SPLLS < 0.18 ABUT>0<90 SPACE PROJ >0.04<=0.165 REGION
   X AND SPLLS
}
SPLLS.4A.1C.a1b1_5 {@ Minimum space between two DIFF regions is 0.19um when common run length 0.165<X<=0.85
                    @ waive notch check
   X = EXT DIFF_SPLLS < 0.19 ABUT>0<90 SPACE PROJ >0.165<=0.85 REGION
   X AND SPLLS
}

SPLLS.4A.1C.a1b1_6 {@ Minimum space between two DIFF regions is 0.19um when common run length X =1.62
   X = EXT DIFF_SPLLS < 0.19 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPLLS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y == 1.62 )
   E AND SPLLS
}

SPLLS.4A.1C.a1b1_7 {@ Minimum space between two DIFF regions is 0.2um for others
   X = EXT DIFF_SPLLS < 0.2 ABUT>0<90 SINGULAR PROJ > 0.85 REGION
   Y = EXT DIFF_SPLLS < 0.2 ABUT>0<90 PROJ == 1.62 REGION
   (X NOT Y) AND SPLLS
}

SPLLS.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.25 um
   X = EXT NWEL_SPLLS NDIF1 < 0.25 ABUT<90 OVERLAP SINGULAR REGION
   X AND SPLLS
}
SPLLS.4A.1E {@ Minimum NWEL overlap N+ DIFF is 0.15um
   NTAP_SPLLS = NTAP INTERACT SPLLS
   X = ENC NTAP_SPLLS NWEL < 0.15 ABUT<90 SINGULAR OVERLAP REGION
   X AND SPLLS
}
SPLLS.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.25um
   X = ENC PDIF1 NWEL_SPLLS < 0.25 ABUT<90 SINGULAR OVERLAP REGION
   X AND SPLLS
}

//GATE1_VTNH = (GATE1 AND VTNH ) NOT PPLUS
//GATE_NOT_VTNH = GATE NOT GATE1_VTNH
//GATE1_VTPH = (GATE1 AND VTPH ) AND PPLUS
//GATE_NOT_VTPH = GATE NOT GATE1_VTPH

SPLLS.4A.4.3D {@ Minimum VTNH to unrelated Poly gate spacing is 0.25um
   X = EXT VTNH GATE_NOT_VTNH < 0.25 ABUT INSIDE ALSO REGION
   X AND SPLLS
}

SPLLS.4A.5.3D {@ Minimum VTPH to unrelated Poly gate spacing is 0.25um
   X = EXT VTPH GATE_NOT_VTPH < 0.25 ABUT INSIDE ALSO REGION
   X AND SPLLS
}

   PG_GATE_SPLLS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.185 BY == 0.13
   PD_GATE_SPLLS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.265 BY == 0.12
   PL_GATE_SPLLS = RECTANGLE ( GATE INTERACT PPLUS )  == 0.165 BY == 0.12
   GATE_O_SPLLS  = ((GATE NOT PD_GATE_SPLLS) NOT PG_GATE_SPLLS) NOT PL_GATE_SPLLS

SPLLS.4A.9AaBaC_1 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.09 um when PO1 interact PG_GATE
   X = INT (PO1 INTERACT PG_GATE_SPLLS) < 0.09 ABUT>0<90 SINGULAR REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_2 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.045um when common run length <= 0.01
   X = INT PO1_SPLLS < 0.045 ABUT>0<90 SINGULAR PROJECTING <= 0.01 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_3 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.08um when common run length 0.01 <x <= 0.025
   X = INT PO1_SPLLS < 0.08 ABUT>0<90 SINGULAR  PARALLEL ONLY PROJECTING >0.01 <=0.025 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_4 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.115um when common run length 0.025 <x <= 0.035
   X = INT PO1_SPLLS < 0.115 ABUT>0<90 SINGULAR  PARALLEL ONLY PROJECTING >0.025 <=0.035 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_5 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.045um when common run length 0.035 <x <=0.045
   X = INT PO1_SPLLS < 0.045 ABUT>0<90 SINGULAR  PROJECTING >0.035 <=0.045 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_6 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.09um when common run length 0.045 <x <=0.125
   X = INT PO1_SPLLS < 0.09 ABUT>0<90 SINGULAR  PROJECTING >0.045 <=0.125 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_7 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.095um when common run length 0.125 <x <=0.135
                   @ CORNER TO EDGE == 0.095 BYPASS
   X = INT PO1_SPLLS < 0.095 ABUT>0<90 SINGULAR  PROJECTING >0.125 <=0.135 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_8 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.115um when common run length 0.135 <x <=0.14
   X = INT PO1_SPLLS < 0.115 ABUT>0<90 SINGULAR  PROJECTING >0.135 <=0.14 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_9 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.095um when common run length 0.14 <x <=0.155
   X = INT PO1_SPLLS < 0.095 ABUT>0<90 SINGULAR  PROJECTING >0.14 <=0.155 REGION
   X AND SPLLS
}

SPLLS.4A.9AaBaC_10 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.105um when common run length 0.155 <x <=0.22
                    @ CORNER TO EDGE == 0.115 BYPASS, Parallel only
   X = INT PO1_SPLLS < 0.105 ABUT>0<90 SINGULAR  PROJECTING >0.155 <=0.22 PARALLEL ONLY REGION
   Y = X AND SPLLS
   Z1 = INT PO1_SPLLS < 0.115 ABUT>0<90 SINGULAR  CORNER TO EDGE REGION
   Z2 = Z1 INSIDE Y
   Y NOT Z2
}

SPLLS.4A.9AaBaC_11 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.12 when common run length >0.22
   X = INT PO1_SPLLS < 0.12 ABUT>0<90 SINGULAR PROJECTING >0.22 REGION
   X AND SPLLS
}



SPLLS.4A.9D.a1_4A.9D.c1_1 {@ Minimum PO1 spacing on DIFF regions without contact is 0.09 when common run length <=0.045
   E1 = EXT PO1 < 0.09 PROJ <= 0.045 ABUT>0<90 SINGULAR REGION
   E2 = EXT PO1 < 0.09 NOT PROJ ABUT>0<90 SINGULAR REGION
   E3 = EXT PO1 < 0.09 CORNER TO CORNER ABUT>0<90 SINGULAR REGION
   E1 AND SPLLS
   E2 AND SPLLS
   E3 AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_2 {@ Minimum PO1 spacing on DIFF regions without contact is 0.14um when common run length  0.045<X<=0.1
   E = EXT PO1 < 0.14 PROJ > 0.045 <= 0.1 ABUT>0<90 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_3 {@ Minimum PO1 spacing on DIFF regions without contact is 0.11um when common run length  0.1<X<=0.165
   E = EXT PO1 < 0.11 PROJ > 0.1 <= 0.165 ABUT>0<90 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_4 {@ Minimum PO1 spacing on DIFF regions without contact is 0.17um when common run length  0.165<X<=0.185
   E = EXT PO1 < 0.17 PROJ > 0.165 <= 0.185 ABUT>0<90 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_5 {@ Minimum PO1 spacing on DIFF regions without contact is 0.195um when common run length  0.185<X<=0.305
   E = EXT PO1 < 0.195 PROJ > 0.185 <= 0.305 ABUT>0<90 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_6 {@ Minimum PO1 spacing on DIFF regions without contact is 0.14um when common run length  X =0.33
   E = EXT PO1 < 0.14 PROJ == 0.33 ABUT>0<90 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9D.a1_4A.9D.c1_7 {@ Minimum PO1 spacing on DIFF regions without contact is 0.156um when common run length >0.305
   E1 = EXT PO1 < 0.156 PROJ > 0.305 < 0.33 ABUT>0<90 SINGULAR REGION
   E2 = EXT PO1 < 0.156 PROJ > 0.33 ABUT>0<90 SINGULAR REGION
   E1 AND SPLLS
   E2 AND SPLLS
}



SPLLS.4A.9D.b1 {@ Minimum PO1 spacing on DIFF regions with contact
                @ poly width <= 0.24um is 0.25um
   x = EXT GATE_Wc < 0.25 ABUT>0<90 REGION
   x AND SPLLS
}

SPLLS.4A.9E_1 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
   ENC PD_GATE_SPLLS PO1_SPLLS < 0.17 ABUT>0<90 REGION
}

SPLLS.4A.9E_2 {@ Minimum overlap of a PO1 region extended into field oxide is 0.085um
   ENC PG_GATE_SPLLS PO1_SPLLS < 0.085 ABUT>0<90 REGION
}

    GATE_SPLLS_1 = AREA GATE_SPLLS == 0.0033125
    GATE_SPLLS_2 = AREA GATE_SPLLS == 0.00765
    GATE_SPLLS_3 = (GATE_SPLLS_1 OR GATE_SPLLS_2) INTERACT CONT
    GATE_SPLLS_4 = AREA GATE_SPLLS == 0.0313
    GATE_SPLLS_5 = AREA GATE_SPLLS == 0.0075125
//    GATE_SPLLS_6 = AREA GATE_SPLLS == 0.00945
    GATE_SPLLS_7 = AREA GATE_SPLLS == 0.0102
    GATE_SPLLS_8 = GATE_SPLLS_5 OR GATE_SPLLS_7

SPLLS.4A.9E_3 {@ Minimum overlap of a PO1 region extended into field oxide is 0.045um
               @ GATE AREA with CONT =0.0031125 or 0.00765 um2
    ENC GATE_SPLLS_3 PO1_SPLLS < 0.045 ABUT>0<90 REGION
}

SPLLS.4A.9E_4 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17 um
               @ GATE AREA = 0.0313 um2
    ENC GATE_SPLLS_4 PO1_SPLLS < 0.17 ABUT>0<90 REGION
}

SPLLS.4A.9E_5 {@ Minimum overlap of a PO1 region extended into field oxide is 0.03 um
               @ GATE AREA = 0.0075125 um2
    ENC GATE_SPLLS_5 PO1_SPLLS < 0.03 ABUT>0<90 REGION
}

SPLLS.4A.9E_6 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
               @ When the common run length < 0.008
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 PROJ < 0.008 REGION
   X2 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 NOT PROJ REGION
   X3 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 CORNER TO CORNER REGION
   Y1 = LENGTH (X1 COIN OUTSIDE EDGE GATE_SPLLS_7) == 0.111
   Y2 = LENGTH (X2 COIN OUTSIDE EDGE GATE_SPLLS_7) == 0.111
   Y3 = LENGTH (X3 COIN OUTSIDE EDGE GATE_SPLLS_7) == 0.111
   (X1 NOT WITH EDGE Y1) AND SPLLS
   (X2 NOT WITH EDGE Y2) AND SPLLS
   (X3 NOT WITH EDGE Y3) AND SPLLS
}

SPLLS.4A.9E_7 {@ Minimum overlap of a PO1 region extended into field oxide is 0.05um
               @ When the common run length == 0.008
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.05 ABUT>0<90 PROJ == 0.008 REGION
   X1 AND SPLLS
}

SPLLS.4A.9E_8 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
               @ When the common run length > 0.008 < 0.085
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 PROJ > 0.008 < 0.085 REGION
   X1 AND SPLLS
}

SPLLS.4A.9E_9 {@ Minimum overlap of a PO1 region extended into field oxide is 0.162um
               @ When the common run length == 0.085
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.162 ABUT>0<90 PROJ == 0.085 REGION
   X1 AND SPLLS
}

SPLLS.4A.9E_10 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
               @ When the common run length > 0.085 < 0.12
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 PROJ > 0.085 < 0.12 REGION
   X1 AND SPLLS
}

SPLLS.4A.9E_11 {@ Minimum overlap of a PO1 region extended into field oxide is 0.035um
               @ When the common run length == 0.12
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.035 ABUT>0<90 PROJ == 0.12 REGION
   X1 AND SPLLS
}

SPLLS.4A.9E_12 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
               @ When the common run length > 0.12
   GATE_O_SPLLS_A = GATE_SPLLS NOT ( ( ( ( GATE_SPLLS_3 OR GATE_SPLLS_4 ) OR GATE_SPLLS_5 ) OR PD_GATE_SPLLS ) OR PG_GATE_SPLLS )
   X1 = ENC GATE_O_SPLLS_A PO1_SPLLS < 0.17 ABUT>0<90 PROJ > 0.12 REGION
   X1 AND SPLLS
}

SPLLS.4A.9F_1 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.06801um when corner to corner
   E = EXT PO1_SPLLS DIFF < 0.06801 CORNER TO CORNER SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_2 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.03um when the common run length between <=0
   E1 = EXT PO1_SPLLS DIFF < 0.03 PROJ <= 0 SINGULAR REGION
   E2 = EXT PO1_SPLLS DIFF < 0.03 NOT PROJ SINGULAR REGION
   E1 AND SPLLS
   E2 AND SPLLS
}

SPLLS.4A.9F_3 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.07um when the common run length between 0 to 0.02 (0< x <=0.02)
   E = EXT PO1_SPLLS DIFF < 0.07 PROJ > 0 <= 0.02 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_4 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.015um when the common run length  between 0.02 to 0.105 (0.02< x <0.105)
   E = EXT PO1_SPLLS DIFF < 0.015 PROJ > 0.02 <= 0.105 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_5 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.045um when the common run length  between 0.105 to 0.125 (0.105< x <=0.125)
   E = EXT PO1_SPLLS DIFF < 0.045 PROJ > 0.105 <= 0.125 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_6 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.035um when the common run length  between 0.125 to 0.145 (0.125< x <=0.145)
   E = EXT PO1_SPLLS DIFF < 0.035 PROJ > 0.125 <= 0.145 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_7 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.065um when the common run length  between 0.145 to 0.165 (0.145< x <=0.165)
   E = EXT PO1_SPLLS DIFF < 0.065 PROJ > 0.145 <= 0.165 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_8 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.025um when the common run length  between 0.165 to 0.19 (0.165< x <=0.19)
   E = EXT PO1_SPLLS DIFF < 0.025 PROJ > 0.165 <= 0.19 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_9 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.077um when the common run length  between 0.19 to 0.2 (0.19< x <=0.2)
   E = EXT PO1_SPLLS DIFF < 0.077 PROJ > 0.19 <= 0.2 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_10 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.025um when the common run length  between 0.2 to 0.355 (0.2< x <0.355)
   E = EXT PO1_SPLLS DIFF < 0.025 PROJ > 0.2 <= 0.355 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_11 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.1um when the common run length  between 0.355 to 0.48 (0.355< x <0.48)
   E = EXT PO1_SPLLS DIFF < 0.1 PROJ > 0.355 < 0.48 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_12 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.03um when the common run length  ==0.48
   E = EXT PO1_SPLLS DIFF < 0.03 PROJ == 0.48 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9F_13 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.1um when the common run length  >0.48
   E = EXT PO1_SPLLS DIFF < 0.1 PROJ > 0.48 SINGULAR REGION
   E AND SPLLS
}

SPLLS.4A.9G {@ Minimum PO1 endcap to RELATED DIFF spacing is 0.065um
   END_CAP =  INTPOL TOUCH GATE == 1
   x = EXT DIFF_SPLLS GATE < 0.065 PERP ONLY ABUT == 90 REGION
   x INTERACT END_CAP
}



//    GATE_SPLLS_4 = AREA GATE_SPLLS == 0.0313


SPLLS.4A.9H.a__4A.9O_1 {@ Minimum PO1 gate to field edge spacing is 0.01um
   GATE_W_PL = PO1 COIN INSIDE EDGE PL_GATE_SPLLS
   E = ENC GATE_W_PL DIFF_SPLLS < 0.01 REGION
   E AND SPLLS
}
SPLLS.4A.9H.a__4A.9O_2 {@ Minimum PO1 gate to field edge spacing is 0.015um

   GATE_W_PD = PO1 COIN INSIDE EDGE PD_GATE_SPLLS
   E = ENC GATE_W_PD DIFF_SPLLS < 0.015 REGION
   E AND SPLLS
}

SPLLS.4A.9H.a__4A.9O_3 {@ Minimum PO1 gate to field edge spacing is 0.01um
                        @ when gate area = 0.0313
   GATE_W_3 = GATE_SPLLS_4 COIN INSIDE EDGE GATE_SPLLS
   E = ENC GATE_W_3 DIFF_SPLLS < 0.01 REGION
   E AND SPLLS
}

SPLLS.4A.9H.a__4A.9O_4 {@ Minimum PO1 gate to field edge spacing is 0.01 um
                        @ when gate area with cont = 0.0033125 or 0.00765 um2
                        @ when gate area without cont = 0.00945 or 0.0102 um2
   GATE_W_4 = (GATE_SPLLS_3 OR GATE_SPLLS_8) COIN INSIDE EDGE GATE_SPLLS
   E = ENC GATE_W_4 DIFF_SPLLS < 0.01 REGION
   E AND SPLLS
}

SPLLS.4A.9H.a__4A.9O_5 {@ Minimum PO1 gate to field edge spacing is 0.2um
   X1 = GATE_SPLLS_8 OR ( PL_GATE_SPLLS OR ( PD_GATE_SPLLS OR ( GATE_SPLLS_4 OR GATE_SPLLS_3 ) ) )
   X2 = ( PO1 NOT X1 ) INTERACT SPLLS
   GATE_W_5 = X2 COIN INSIDE EDGE GATE_SPLLS
   E1 = ENC GATE_W_5 DIFF_SPLLS < 0.2 REGION
   E2 = ENC GATE_W_5 DIFF_SPLLS < 0.1 CORNER TO CORNER REGION
   (E1 NOT E2) AND SPLLS
}


// SPLLS.4A.9J {@ Gate at 90 degree angle is not allowed.
//    Waive

SPLLS.4A.9N {@ Minimum PO1 bent gate on field region to DIffusion spacing = 0.085
     x = EXT GATE_W EXPO_E < 0.085 OBTUSE ONLY REGION
     x AND SPLLS
}

CONT_SPLLS_A = RECTANGLE CONT_SPLLS == 0.16 BY == 0.16
CONT_SPLLS_SINGLE = AREA CONT_SPLLS == 0.0255

SPLLS.4A.13A {@ Minimum and maximum width of a CONT region is 0.16um,
              @ Waive Share CONT  : area is 0.0937 or 0.078475 or 0.086725
              @ Waive Single CONT : area is 0.0255
   x = (CONT_SPLLS NOT CONT_AREA) NOT CONT_SPLLS_SINGLE
   y = NOT RECTANGLE x == 0.16 BY == 0.16
   y AND SPLLS
}// commented by 8D/PEI

CONT_AREA_1 = AREA CONT_SPLLS == 0.0937
CONT_AREA_2 = AREA CONT_SPLLS == 0.078475
CONT_AREA_3 = AREA CONT_SPLLS == 0.086725
CONT_AREA_4 = AREA CONT_SPLLS == 0.0255

CONT_AREA = (CONT_AREA_1 OR CONT_AREA_2) OR CONT_AREA_3

SPLLS.4A.13B_1 {@ Minimum space between two CONT regions is 0.185um,
                @ when the area of CONT are 0.0937/0.078475/0.086725
  X = EXT CONT_AREA < 0.185 ABUT>0<90 SINGULAR REGION
  X AND SPLLS
}

SPLLS.4A.13B_2 {@ Minimum space between two CONT regions is 0.15um, By Pass Shared Cont
                @ CORNER to edge (By Pass Shared Cont)
  X = EXT CONT_SPLLS_A CONT < 0.15 ABUT>0<90 SINGULAR CORNER TO EDGE REGION
  Y = EXT CONT_SPLLS_SINGLE CONT < 0.15 ABUT>0<90 SINGULAR CORNER TO EDGE REGION
  (X OR Y) AND SPLLS
}

SPLLS.4A.13B_3 {@ Minimum space between two CONT regions is 0.1um
  X = EXT CONT_SPLLS_A < 0.1 ABUT>0<90 SINGULAR REGION
  Y = EXT CONT_SPLLS_SINGLE < 0.1 ABUT>0<90 SINGULAR REGION
  (X OR Y) AND SPLLS
}

SPLLS.4A.13C.a_1 {@ Minimum DIFF CONT to Poly(1.2V) spacing is 0.11um,
                  @ when the area of CONT are 0.0937/0.078475/0.086725
  DIFCNT_SPLLS_A = CONT_AREA INTERACT DIFF
  X = EXT DIFCNT_SPLLS_A GATE1_W < 0.11 ABUT>0<90 OPPOSITE REGION
  x AND SPLLS
}

SPLLS.4A.13C.a_2 {@ Minimum DIFF CONT to Poly(1.2V) spacing is 0.025um,
  DIFCNT_SPLLS_A = (CONT_SPLLS_A OR CONT_SPLLS_SINGLE) INTERACT DIFF
  X = EXT DIFCNT_SPLLS_A GATE1_W < 0.025 ABUT>0<90 OPPOSITE REGION
  x AND SPLLS
}

SPLLS.4A.13D {@ when the poly cont area=0.0255 um2,the common rule length<=0.16, waive
              @ others is 0.12 um
   x = AREA POLCNT_SPLLS == 0.0255
   EXT x DIFF < 0.12 PROJ > 0.16 ABUT<90 SINGULAR REGION
   EXT (POLCNT_SPLLS NOT x) DIFF < 0.12 ABUT<90 SINGULAR REGION
}

SPLLS.4A.13E {@ Minimum PO1 overlap CONT is 0.06um, no floating conntact
    POLCNT_SPLLS_A = CONT_SPLLS_A INTERACT PO1
    Y = RECTANGLE ENC POLCNT_SPLLS_A PO1_SPLLS
    GOOD 0.022 0.06 0.022 0.06
    Y AND SPLLS
}

SPLLS.4A.13FG {@ Minimum extension of an DIFF region beyond a CONT region is
               @ By pass (0.075 0.075 0.075 0.075)
   X1 = SIZE CONT_SPLLS_A BY -0.015
   Y = RECTANGLE ENC X1 DIFF_SPLLS
   GOOD 0.03 0.075 OPPOSITE 0.025 0.075 OPPOSITE
   GOOD 0.025 0.07 OPPOSITE 0.025 0.07 OPPOSITE
   GOOD 0.0 0.03 OPPOSITE 0.02 0.025 OPPOSITE
   GOOD 0.035 0.05 OPPOSITE 0.035 0.05 OPPOSITE
   GOOD 0.065 0.02 OPPOSITE 0.075 0.015 OPPOSITE
   GOOD 0.075 0.075 OPPOSITE 0.075 0.075 OPPOSITE
   Y AND SPLLS
}

SPLLS.4A.13I {@ Poly contact on diffusion is not allowed
              @ waive when the area of CONT are 0.0937/0.078475/0.086725 um2
   x = CONT_SPLLS NOT CONT_AREA
   (GATE AND x) AND SPLLS
} // commented by 8D/PEI

/////////////////////////////


SPLLS.4B.1D.a {@ Minimum ME1 overlap contac is 0 um,except the contact area is 0.0937, 0.078475 or 0.086725
  X1 = CONT_SPLLS NOT ME1
  (X1 NOT CONT_AREA) NOT CONT_AREA_4
}

SPLLS.4B.1D.b {@ ME1 enclose CONT at end-of-line or outer corner is 0.06,when ME1 width < 0.24
                @ cont (GOOD 0.00 0.06  OPPOSITE 0.00 0.06  OPPOSITE)
    co_sm24 = CONT_SPLLS_A INTERACT SM1_024
    y = RECTANGLE ENC co_sm24 ME1
    GOOD 0.04 0.06   0.01 0.005
    GOOD 0.01 0.00   0.05 0.05
    GOOD 0.00 0.06   0.00 0.06
    y AND SPLLS
}


//===========================
// DP4S SRAM (8TSRAM3.39HSSP)
//===========================

DIFF_DP4S  = DIFF INTERACT DP4S
NWEL_DP4S  = NWEL INTERACT DP4S
PO1_DP4S   = PO1  INTERACT DP4S
GATE_DP4S  = GATE AND DP4S
GATE_W_DP4S = PO1_DP4S COIN INSIDE EDGE GATE_DP4S
GATE_Wc_DP4S = GATE_W_DP4S  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_DP4S = GATE_W_DP4S NOT INSIDE EDGE TG
ACTIVE_PS_DP4S = DIFF_DP4S OUTSIDE NWEL

PDIF1_DP4S = PDIF1 AND DP4S
NDIF1_DP4S = NDIF1 AND DP4S

PPLUS_DP4S  = PPLUS INTERACT DP4S
CONT_DP4S   = CONT INTERACT DP4S
POLCNT_DP4S = POLCNT AND DP4S
DIFCNT_DP4S = DIFCNT AND DP4S
ME1_DP4S   = ME1 INTERACT DP4S

DP4S.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.2 um
   X = EXT NWEL_DP4S NDIF1 < 0.2 ABUT<90 OVERLAP SINGULAR REGION
   X AND DP4S
}

DP4S.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.2um
   X = ENC PDIF1 NWEL_DP4S < 0.2 ABUT<90 SINGULAR OVERLAP REGION
   X AND DP4S
}

//DP4S.4A.4.2D {@ Minimum VTN_SP to unrelated Poly gate spacing is 0.24um
//   X = EXT VTN_SP (GATE_NOT_VTN_SP INTERACT DP4S) < 0.24 ABUT INSIDE ALSO REGION
//   X AND DP4S
//}

//DP4S.4A.5.2D {@ Minimum VTP_SP to unrelated Poly gate spacing is 0.245um
//   X = EXT VTP_SP (GATE_NOT_VTP_SP INTERACT DP4S) < 0.245 ABUT INSIDE ALSO REGION
//   X AND DP4S
//}

//GATE1_VTNH = (GATE1 AND VTNH ) NOT PPLUS
//GATE_NOT_VTNH = GATE NOT GATE1_VTNH
//GATE1_VTPH = (GATE1 AND VTPH ) AND PPLUS
//GATE_NOT_VTPH = GATE NOT GATE1_VTPH


   PG_GATE_DP4S = RECTANGLE ( GATE INTERACT NPLUS )  == 0.18 BY == 0.155
   PD_GATE_DP4S = RECTANGLE ( GATE INTERACT NPLUS )  == 0.535 BY == 0.13
   PL_GATE_DP4S = RECTANGLE ( GATE INTERACT PPLUS )  == 0.17 BY == 0.13
   GATE_O_DP4S  = ((GATE NOT PD_GATE_DP4S) NOT PG_GATE_DP4S) NOT PL_GATE_DP4S



DP4S.4A.9AaBaC_1 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.095um when common run length <= 0.03
   X = INT PO1_DP4S < 0.095 ABUT>0<90 SINGULAR PROJECTING <= 0.03 REGION
   X AND DP4S
}

DP4S.4A.9AaBaC_2 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.12um when common run length x > 0.03
   X = INT PO1_DP4S < 0.12 ABUT>0<90 SINGULAR  PROJECTING >0.03 REGION
   X AND DP4S
}



DP4S.4A.9F_1 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.085um when common run length <=0.01um

  X1 = EXT PO1_DP4S DIFF < 0.085 ABUT>0<90 SINGULAR PROJECTING <= 0.01 REGION
  X1 AND DP4S
}

DP4S.4A.9F_2 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.07um when common run length 0.01< x <=0.015um
   X = EXT PO1_DP4S DIFF < 0.07 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.01 <=0.015 )
   E AND DP4S
}

DP4S.4A.9F_3 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.055um when common run length 0.015< x <=0.017um
   X = EXT PO1_DP4S DIFF < 0.055 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.015 <=0.017 )
   E AND DP4S
}

DP4S.4A.9F_4 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.01um when common run length 0.017< x <=0.02um
   X = EXT PO1_DP4S DIFF < 0.01 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.017 <=0.02 )
   E AND DP4S
}

DP4S.4A.9F_5 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.055um when common run length 0.02< x <=0.027um
   X = EXT PO1_DP4S DIFF < 0.055 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.02 <=0.027 )
   E AND DP4S
}

DP4S.4A.9F_6 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.07um when common run length 0.027< x <=0.038um
   X = EXT PO1_DP4S DIFF < 0.07 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.027 <=0.038 )
   E AND DP4S
}

DP4S.4A.9F_7 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.055um when common run length 0.038< x <=0.06um
   X = EXT PO1_DP4S DIFF < 0.055 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.038 <=0.06 )
   E AND DP4S
}

DP4S.4A.9F_8 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.09um when common run length 0.06< x <=0.18um
   X = EXT PO1_DP4S DIFF < 0.09 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.06 <=0.18 )
   E AND DP4S
}

DP4S.4A.9F_9 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.05um when common run length 0.18< x <=0.19um
   X = EXT PO1_DP4S DIFF < 0.05 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y > 0.18 <=0.19 )
   E AND DP4S
}

DP4S.4A.9F_10 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.08um when common run length  x = 0.535 um
   X = EXT PO1_DP4S DIFF < 0.08 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y == 0.535 )
   E AND DP4S
}

DP4S.4A.9F_11 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.1um for others
   X = EXT PO1_DP4S DIFF < 0.1 ABUT>0<90 OPPOSITE REGION
   Y = PO1_DP4S COIN OUTSIDE EDGE X
   E1 = X WITH EDGE (LENGTH Y >0.19)
   E2 = X WITH EDGE (LENGTH Y == 0.535)
   (E1 NOT E2) AND DP4S
}

DP4S.4A.9G {@ Minimum PO1 endcap to RELATED DIFF spacing is 0.07um
   END_CAP =  INTPOL TOUCH GATE == 1
   x = EXT DIFF_DP4S GATE < 0.07 PERP ONLY ABUT == 90 REGION
   x INTERACT END_CAP
}

DP4S.4A.9H.a__4A.9O_1 {@ Minimum PO1 gate to field edge spacing is 0.135um

   GATE_W_PD = PO1 COIN INSIDE EDGE PD_GATE_DP4S
   E = ENC GATE_W_PD DIFF_DP4S < 0.135 REGION
   E AND DP4S
}

DP4S.4A.9H.a__4A.9O_2 {@ Minimum PO1 gate to field edge spacing is 0.2um
   X2 = ( PO1 NOT PD_GATE_DP4S ) INTERACT DP4S
   GATE_W_5 = X2 COIN INSIDE EDGE GATE_DP4S
   E1 = ENC GATE_W_5 DIFF_DP4S < 0.2 REGION
   E1 AND DP4S
}


// DP4S.4A.9P {@ The POLY1 density 1mm X 1mm 500 um increments must > 15%
//    Waive



//CONT_DP4S_A = RECTANGLE CONT_DP4S == 0.16 BY == 0.16

//CONT_AREA_1 = AREA CONT_DP4S == 0.0937
