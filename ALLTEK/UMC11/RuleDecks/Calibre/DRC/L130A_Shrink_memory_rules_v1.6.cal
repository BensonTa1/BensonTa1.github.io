    E = EXT PPLUS < 0.24 ABUT>0<90 SINGULAR PROJ >1.042 REGION
    E AND SP_16
}

SP_16.4A.11C.a {@ Minimum P+ implant overhang of P+ DIFFUSION (inside N_WELL) is 0.159 um
    E = ENC ACTIVE_NT PPLUS < 0.159 ABUT<90 SINGULAR REGION
    E AND SP_16
}

SP_16.4A.11D.a {@ Minimum P+ implant to N+ DIFFUSION spacing (inside P_WELL) is 0.144 um
    x = EXT PPLUS ACTIVE_PS < 0.144 ABUT<90 SINGULAR REGION
    y = EXT PPLUS ACTIVE_TW < 0.144 ABUT<90 SINGULAR REGION
    (x OR y) AND SP_16
}

SP_16.4A.13A {@ Maximum and Minimum CONTACT size is 0.16 um x 0.16 um
              @ when CONTACT area 0.023 sq.um < x <= 0.0235 sq.um waive
    E = NOT RECTANGLE CONT_SP_16_AREA_NORMAL == 0.16 BY == 0.16
    E AND SP_16
}

SP_16.4A.13B_1 {@ Minimum CONTACT to CONTACT spacing is 0.15 um
                @ When the common run length <= 0.13 (x <= 0.13)
    E1 = EXT CONT < 0.15 ABUT>0<90 SINGULAR PROJ <=0.13 REGION
    E1 AND SP_16
    E2 = EXT CONT < 0.15 ABUT>0<90 SINGULAR NOT PROJ REGION
    E2 AND SP_16
    E3 = EXT CONT < 0.15 ABUT>0<90 SINGULAR CORNER TO CORNER REGION
    E3 AND SP_16
}

SP_16.4A.13B_2 {@ Minimum CONTACT to CONTACT spacing is 0.16 um
