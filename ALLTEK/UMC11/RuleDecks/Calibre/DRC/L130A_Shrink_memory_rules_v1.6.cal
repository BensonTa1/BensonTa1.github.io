    E = EXT CONT < 0.2 ABUT>0<90 SINGULAR PROJ >0.173 REGION
    E AND SP_16
}

SP_16.4A.13C.a {@ Minimum DIFFUSION CONTACT to POLY1 (1.2V) spacing is 0.069 um
                @ CONTACT over GATE is not allowed
    E = EXT GATE1_W DIFCNT < 0.069 ABUT<90 REGION
    E AND SP_16
}

SP_16.4A.13D {@ Minimum CONTACT to DIFFUSION spaceing is 0.088 um
    E = EXT POLCNT DIFF < 0.088 ABUT<90 SINGULAR REGION
    E AND SP_16
}

SP_16.4A.13E {@ Minimum POLY1 enclosure of CONTACT is 0.06 um, Floating CONTACT is not allowed
              @ waive (GOOD 0.029 0.024 0.029 0.024)
              @ waive (GOOD 0.025 0.035 0.052 0.029)
    x = ENC POLCNT_SP_16 PO1 < 0.06 ABUT<90 SINGULAR OUTSIDE ALSO REGION
    y = POLCNT_SP_16 INTERACT x
    E = RECTANGLE ENC y PO1 ABUT SINGULAR OUTSIDE ALSO
        GOOD 0.029 0.024 0.029 0.024
        GOOD 0.025 0.035 0.052 0.029
    E AND SP_16
}

SP_16.4A.13FG {@ Minimum P+ DIFFUSION enclosure of CONTACT is 0.06 um
               @ Minimum N+ DIFFUSION enclosure of CONTACT is 0.06 um
               @ waive (GOOD 0.029 0.018 0 0)
               @ waive (GOOD 0.035 0.012 0 0)
               @ waive (GOOD 0.024 0.023 0 0)
               @ waive (GOOD 0.014 0.025 0 0)
               @ waive (GOOD 0.01 0.01 0 0)
    x = ENC DIFCNT_SP_16 DIFF < 0.06 ABUT<90 SINGULAR OVERLAP REGION
    y = DIFCNT_SP_16 INTERACT x
    E = RECTANGLE ENC y DIFF ABUT SINGULAR
        GOOD 0.029 0.018 0 0
        GOOD 0.035 0.012 0 0
        GOOD 0.024 0.023 0 0
        GOOD 0.014 0.025 0 0
        GOOD 0.01 0.01 0 0
    E AND SP_16
}

