//L130-Shrink
GROUP SPS_SRAM   SPS.?
GROUP SPLLS_SRAM SPLLS.?
GROUP DP3S_SRAM  DP3S.?
GROUP DP4S_SRAM  DP4S.?
GROUP SP_4_SRAM  SP_4.?
GROUP SP_5_SRAM  SP_5.?
GROUP SP_18_SRAM  SP_18.?
GROUP SP_16_SRAM  SP_16.?

//==============================================
//==============================================
//L130-Shrink SRAM
//==============================================
//
OPC_BLOCK.C_CELL_BLOCK.1 {@ C_CELL_BLOCK layer must be covered by SRAM mark layers
   A = SIZE SPS BY 5.0
   (((((((C_CELL_BLOCK NOT A) NOT SPLLS ) NOT DP4S) NOT DP3S) NOT SP_4) NOT SP_5) NOT SP_18) NOT SP_16
}

//
//==========================
// SPS SRAM (6TSRAM1.85HSSP)
//==========================

DIFF_SPS  = DIFF INTERACT SPS
NWEL_SPS  = NWEL INTERACT SPS
PO1_SPS   = PO1  INTERACT SPS
GATE_SPS  = GATE AND SPS
GATE_W_SPS = PO1_SPS COIN INSIDE EDGE GATE_SPS
GATE_Wc_SPS = GATE_W_SPS  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_SPS = GATE_W_SPS NOT INSIDE EDGE TG
ACTIVE_PS_SPS = DIFF_SPS OUTSIDE NWEL

PDIF1_SPS = PDIF1 AND SPS
NDIF1_SPS = NDIF1 AND SPS

PPLUS_SPS  = PPLUS INTERACT SPS
CONT_SPS   = CONT INTERACT SPS
POLCNT_SPS = POLCNT AND SPS
DIFCNT_SPS = DIFCNT AND SPS
ME1_SPS  = ME1 INTERACT SPS

SPS.4A.1AB_1 {@ Minimum dimension of an DIFF is 0.125 when common run length <=0.055
   X = INT DIFF_SPS < 0.125 ABUT>0<90 SINGULAR PROJECTING <=0.055 REGION
   X AND SPS
}
SPS.4A.1AB_2 {@ Minimum dimension of an DIFF is 0.145 when common run length 0.055< x <=0.105
   X = INT DIFF_SPS < 0.145 ABUT>0<90 SINGULAR PROJECTING > 0.055 <= 0.105 REGION
   X AND SPS
}
SPS.4A.1AB_3 {@ Minimum dimension of an DIFF is 0.12 when common run length 0.105< x <=0.165
   X = INT DIFF_SPS < 0.12 ABUT>0<90 SINGULAR PROJECTING > 0.105 <= 0.165 REGION
   X AND SPS
}

SPS.4A.1AB_4 {@ Minimum dimension of an DIFF is 0.13 when common run length 0.165< x <=0.21
   X = INT DIFF_SPS < 0.13 ABUT>0<90 SINGULAR PROJECTING >0.165 <=0.21 REGION
   X AND SPS
}
SPS.4A.1AB_5 {@ Minimum dimension of an DIFF is 0.16 when common run length >0.21
   X = INT DIFF_SPS < 0.16 ABUT>0<90 SINGULAR PROJECTING >0.21 REGION
   X AND SPS
}

SPS.4A.1C.a1b1_1 {@ Minimum space between two DIFF regions is 0.08um when common run length <=0.02
   X = EXT DIFF_SPS < 0.08 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y <=0.02)
   E AND SPS
}
SPS.4A.1C.a1b1_2 {@ Minimum space between two DIFF regions is 0.165um when common run length 0.02<X<=0.03
   X = EXT DIFF_SPS < 0.165 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.02 <=0.03 )
   E AND SPS
}
SPS.4A.1C.a1b1_3 {@ Minimum space between two DIFF regions is 0.185um when common run length 0.03<X<=0.035
   X = EXT DIFF_SPS < 0.185 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.03 <=0.035 )
   E AND SPS
}
SPS.4A.1C.a1b1_4 {@ Minimum space between two DIFF regions is 0.055um when common run length 0.035<X<=0.04
   X = EXT DIFF_SPS < 0.055 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.035 <=0.04 )
   E AND SPS
}
SPS.4A.1C.a1b1_5 {@ Minimum space between two DIFF regions is 0.05um when common run length 0.004<X<=0.055
   X = EXT DIFF_SPS < 0.05 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.04 <=0.055 )
   E AND SPS
}
SPS.4A.1C.a1b1_6 {@ Minimum space between two DIFF regions is 0.18um when common run length 0.055<X<=0.165
                  @ waive notch check(0.065/0.08/0.165/0.055)

   X = EXT DIFF_SPS < 0.18 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   Z = X WITH EDGE (LENGTH Y >0.055 <=0.165 )
//   E AND SPS
   A = EXT DIFF_SPS == 0.065 ABUT>0<90 NOTCH REGION
   B = EXT DIFF_SPS == 0.08  ABUT>0<90 NOTCH REGION
   C = EXT DIFF_SPS == 0.165 ABUT>0<90 NOTCH REGION
   D = EXT DIFF_SPS == 0.055 ABUT>0<90 NOTCH REGION
   D1 = D INTERACT C
   E = (((A OR B) OR C) OR D1)  INTERACT Z
   (Z NOT E) AND SPS
}
SPS.4A.1C.a1b1_7 {@ Minimum space between two DIFF regions is 0.19um when common run length 0.165<X<=0.335
                  @ waive notch check(0.185/0.065)

   X = EXT DIFF_SPS < 0.19 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.165 <=0.335 )
   A = EXT DIFF_SPS == 0.185 ABUT>0<90 NOTCH REGION
   B = EXT DIFF_SPS == 0.065 ABUT>0<90 NOTCH REGION
   C = (A INTERACT B) OR (B INTERACT A)
   Z = C  INTERACT E
   (Z NOT E) AND SPS
}
SPS.4A.1C.a1b1_8 {@ Minimum space between two DIFF regions is 0.2um for others
   X = EXT DIFF_SPS < 0.2 ABUT>0<90 OPPOSITE REGION
   Y = DIFF_SPS COIN OUTSIDE EDGE X
   E = X WITH EDGE (LENGTH Y >0.335 )
   E AND SPS
}


SPS.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.245um
   X = EXT NWEL_SPS NDIF1 < 0.245 ABUT<90 OVERLAP SINGULAR REGION
   X AND SPS
}
SPS.4A.1E {@ Minimum NWEL overlap N+ DIFF is 0.15um
   NTAP_SPS = NTAP INTERACT SPS
   X = ENC NTAP_SPS NWEL < 0.15 ABUT<90 SINGULAR OVERLAP REGION
   X AND SPS
}
SPS.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.24um
   X = ENC PDIF1 NWEL_SPS < 0.24 ABUT<90 SINGULAR OVERLAP REGION
   X AND SPS
}

SPS.4A.4.2D {@ Minimum VTN_SP to unrelated Poly gate spacing is 0.24um
   X = EXT VTN_SP (GATE_NOT_VTN_SP INTERACT SPS) < 0.24 ABUT INSIDE ALSO REGION
   X AND SPS
}

SPS.4A.5.2D {@ Minimum VTP_SP to unrelated Poly gate spacing is 0.245um
   X = EXT VTP_SP (GATE_NOT_VTP_SP INTERACT SPS) < 0.245 ABUT INSIDE ALSO REGION
   X AND SPS
}

   PG_GATE_SPS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.18 BY == 0.15
   PD_GATE_SPS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.28 BY == 0.13
   PL_GATE_SPS = RECTANGLE ( GATE INTERACT PPLUS )  == 0.165 BY == 0.13
   GATE_O_SPS  = ((GATE NOT PD_GATE_SPS) NOT PG_GATE_SPS) NOT PL_GATE_SPS

SPS.4A.9AaBaC_1 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.09um when PO1 interact PG_GATE
   X = INT (PO1 INTERACT PG_GATE_SPS) < 0.09 ABUT>0<90 SINGULAR REGION
   X AND SPS
}
SPS.4A.9AaBaC_2 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.045um when common run length <= 0.01
   X = INT PO1_SPS < 0.045 ABUT>0<90 SINGULAR PROJECTING <= 0.01 REGION
   X AND SPS
}
SPS.4A.9AaBaC_3 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.08um when common run length 0.01 <x <= 0.025
   X = INT PO1_SPS < 0.08 ABUT>0<90 SINGULAR  PARALLEL ONLY PROJECTING >0.01 <=0.025 REGION
   X AND SPS
}
SPS.4A.9AaBaC_4 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.115um when common run length 0.025 <x <= 0.03
   X = INT PO1_SPS < 0.115 ABUT>0<90 SINGULAR  PARALLEL ONLY PROJECTING >0.025 <=0.03 REGION
   X AND SPS
}
SPS.4A.9AaBaC_5 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.045um when common run length 0.03 <x <=0.045
   X = INT PO1_SPS < 0.045 ABUT>0<90 SINGULAR  PROJECTING >0.03 <=0.045 REGION
   X AND SPS
}
SPS.4A.9AaBaC_6 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.09um when common run length 0.045 <x <=0.12
   X = INT PO1_SPS < 0.09 ABUT>0<90 SINGULAR  PROJECTING >0.045 <=0.12 REGION
   X AND SPS
}
SPS.4A.9AaBaC_7 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.095um when common run length 0.12 <x <=0.22
                 @ CORNER TO EDGE == 0.095 BYPASS
   X = INT PO1_SPS < 0.095 ABUT>0<90 SINGULAR  PROJECTING >0.12 <=0.22 PARALLEL ONLY REGION
   Y = X AND SPS
   Z1 = INT PO1_SPS < 0.095 ABUT>0<90 SINGULAR  CORNER TO EDGE REGION
   Z2 = Z1 INSIDE Y
   Y NOT Z2
}
SPS.4A.9AaBaC_8 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.105um when common run length 0.22 <x <=0.28
   X = INT PO1_SPS < 0.105 ABUT>0<90 SINGULAR  PROJECTING >0.22 <=0.28 REGION
   X AND SPS
}

SPS.4A.9AaBaC_9 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.12 when common run length >0.28
   X = INT PO1_SPS < 0.12 ABUT>0<90 SINGULAR PROJECTING >0.28 REGION
   X AND SPS
}

SPS.4A.9D.a1_4A.9D.c1_1 {@ Minimum PO1 spacing on DIFF regions without contact is 0.1 when common run length <=0.055
   E1 = EXT PO1 < 0.1 PROJ <= 0.055 ABUT>0<90 SINGULAR REGION
   E2 = EXT PO1 < 0.1 NOT PROJ ABUT>0<90 SINGULAR REGION
   E3 = EXT PO1 < 0.1 CORNER TO CORNER ABUT>0<90 SINGULAR REGION
   E1 AND SPS
   E2 AND SPS
   E3 AND SPS
}
SPS.4A.9D.a1_4A.9D.c1_2 {@ Minimum PO1 spacing on DIFF regions without contact is 0.148um when common run length  0.055<X<=0.09
   E = EXT PO1 < 0.148 PROJ > 0.055 <= 0.09 ABUT>0<90 SINGULAR REGION
   E AND SPS
}
SPS.4A.9D.a1_4A.9D.c1_3 {@ Minimum PO1 spacing on DIFF regions without contact is 0.11um when common run length >0.09
   E = EXT PO1 < 0.11 PROJ > 0.09 ABUT>0<90 SINGULAR REGION
   E AND SPS
}
SPS.4A.9D.b1 {@ Minimum PO1 spacing on DIFF regions with contact
              @ poly width > 0.24um is 0.24um
   x = EXT GATE_Wc < 0.24 ABUT>0<90 REGION
   x AND SPS
}

SPS.4A.9E_1 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
   ENC PD_GATE_SPS PO1_SPS < 0.17 ABUT>0<90 REGION
}
SPS.4A.9E_2 {@ Minimum overlap of a PO1 region extended into field oxide is 0.07um
   ENC PG_GATE_SPS PO1_SPS < 0.07 ABUT>0<90 REGION
}
SPS.4A.9E_3 {@ Minimum overlap of a PO1 region extended into field oxide is 0.18um
   ENC PL_GATE_SPS PO1_SPS < 0.18 ABUT>0<90 REGION
}

    GATE_SPS_1 = AREA GATE_SPS == 0.0031125
    GATE_SPS_2 = AREA GATE_SPS == 0.00765
    GATE_SPS_3 = (GATE_SPS_1 OR GATE_SPS_2) INTERACT CONT
    GATE_SPS_7 = AREA GATE_SPS == 0.0071125

SPS.4A.9E_4 {@ Minimum overlap of a PO1 region extended into field oxide is 0.045um
             @ GATE AREA with CONT =0.0031125 or 0.00765 or 0.0071125 um2
    ENC GATE_SPS_3 PO1_SPS < 0.045 ABUT>0<90 REGION
    ENC (GATE_SPS_7 INTERACT CONT) PO1_SPS < 0.045 ABUT>0<90 REGION
}
SPS.4A.9E_5 {@ Minimum overlap of a PO1 region extended into field oxide is 0.035um
             @ GATE AREA = 0.0071125 um2
    ENC GATE_SPS_7 PO1_SPS < 0.035 ABUT>0<90 REGION
}
SPS.4A.9E_6 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
             @ When the common run length < 0.085
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_7
   X1 = ENC GATE_O_SPS_A PO1_SPS < 0.17 ABUT>0<90 PROJ < 0.085 REGION
   X2 = ENC GATE_O_SPS_A PO1_SPS < 0.17 ABUT>0<90 NOT PROJ REGION
   X3 = ENC GATE_O_SPS_A PO1_SPS < 0.17 ABUT>0<90 CORNER TO CORNER REGION
   Y1 = LENGTH (X1 COIN OUTSIDE EDGE GATE_SPS_8) == 0.111
   Y2 = LENGTH (X2 COIN OUTSIDE EDGE GATE_SPS_8) == 0.111
   Y3 = LENGTH (X3 COIN OUTSIDE EDGE GATE_SPS_8) == 0.111
   (X1 NOT WITH EDGE Y1) AND SPS
   (X2 NOT WITH EDGE Y2) AND SPS
   (X3 NOT WITH EDGE Y3) AND SPS
}
SPS.4A.9E_7 {@ Minimum overlap of a PO1 region extended into field oxide is 0.164um
             @ When the common run length == 0.085
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_7
   X = ENC GATE_O_SPS_A PO1_SPS < 0.164 ABUT>0<90 PROJ == 0.085 REGION
   x AND SPS
}
SPS.4A.9E_8 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
             @ When the common run length > 0.085 < 0.12
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_7
   X = ENC GATE_O_SPS_A PO1_SPS < 0.17 ABUT>0<90 PROJ > 0.085 < 0.12 REGION
   x AND SPS
}
SPS.4A.9E_9 {@ Minimum overlap of a PO1 region extended into field oxide is 0.035um
             @ When the common run length == 0.12
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_7
   X = ENC GATE_O_SPS_A PO1_SPS < 0.035 ABUT>0<90 PROJ == 0.12 REGION
   x AND SPS
}
SPS.4A.9E_10 {@ Minimum overlap of a PO1 region extended into field oxide is 0.17um
              @ When the common run length > 0.12
   GATE_O_SPS_A = (GATE_O_SPS NOT GATE_SPS_3) NOT GATE_SPS_7
   X = ENC GATE_O_SPS_A PO1_SPS < 0.17 ABUT>0<90 PROJ > 0.12 REGION
   x AND SPS
}

SPS.4A.9F_1 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.06103um when corner to corner
   E = EXT PO1_SPS DIFF < 0.06103 CORNER TO CORNER SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_2 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.025um when the common run length between <=0
   E1 = EXT PO1_SPS DIFF < 0.025 PROJ <= 0 SINGULAR REGION
   E2 = EXT PO1_SPS DIFF < 0.025 NOT PROJ SINGULAR REGION
   E1 AND SPS
   E2 AND SPS
}

SPS.4A.9F_3 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.07um when the common run length between 0 to 0.02 (0< x <=0.02)
   E = EXT PO1_SPS DIFF < 0.07 PROJ > 0 <= 0.02 SINGULAR REGION
   E AND SPS
}

SPS.4A.9F_4 {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.015um when the common run length  between 0.02 to 0.105 (0.02< x <0.105)
   E = EXT PO1_SPS DIFF < 0.015 PROJ > 0.02 <= 0.105 SINGULAR REGION
