/////////////////////////////

SP_5.4B.1B.a {@ Minimum METAL1 to METAL1 spacing is 0.15 um
              @ where one METAL1 width < 2.0um
    E = EXT ME1 < 0.15 ABUT>0<90 SINGULAR REGION
    E AND SP_5
}

SP_5.4B.1D.b {@ Minimum METAL1 enclosure of CONTACT at end-of-line or outer corner is 0.01 um
              @ when METAL1 width < 0.24um
    co_sm24 = CONT INTERACT SM1_024
    E = RECTANGLE ENC co_sm24 ME1
    GOOD 0.00 0.01 OPPOSITE 0.00 0.01 OPPOSITE
    E AND SP_5
}

SP_5.4B.1E {@ Minimum area of METAL1 region 0.09744 sq.um
    E = AREA ME1 < 0.09744
    E AND SP_5
}

SP_5.4B.2B.a_b.VI1 {@ Minimum MVI1 to MVIA1 spacing is 0.187 um
    E = EXT VI1 < 0.187 ABUT>0<90 SINGULAR REGION
    E AND SP_5
}

//=========================
// SP_16 SRAM (6TSRAM1.41SP)
//=========================

DIFF_SP_16  = DIFF INTERACT SP_16
NWEL_SP_16  = NWEL INTERACT SP_16
PO1_SP_16   = PO1  INTERACT SP_16
GATE_SP_16  = GATE AND SP_16
GATE_W_SP_16 = PO1_SP_16 COIN INSIDE EDGE GATE_SP_16
GATE_Wc_SP_16 = GATE_W_SP_16  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_SP_16 = GATE_W_SP_16 NOT INSIDE EDGE TG
ACTIVE_PS_SP_16 = DIFF_SP_16 OUTSIDE NWEL

PDIF1_SP_16 = PDIF1 AND SP_16
NDIF1_SP_16 = NDIF1 AND SP_16

PPLUS_SP_16  = PPLUS INTERACT SP_16
CONT_SP_16   = CONT INTERACT SP_16
POLCNT_SP_16 = POLCNT AND SP_16
DIFCNT_SP_16 = DIFCNT AND SP_16
ME1_SP_16  = ME1 INTERACT SP_16
VI1_SP_16  = VI1 INTERACT SP_16
ME2_SP_16  = ME2 INTERACT SP_16
VI2_SP_16  = VI2 INTERACT SP_16

CONT_SP_16_AREA = AREA CONT_SP_16 > 0.023 <= 0.0235
CONT_SP_16_AREA_NORMAL = CONT_SP_16 NOT CONT_SP_16_AREA

VI2_SP_16_AREA = AREA VI2_SP_16 > 0.04 <= 0.0405
VI2_SP_16_AREA_NORMAL = VI2_SP_16 NOT VI2_SP_16_AREA

SP_16.4A.1A.a1b1__4A.1B_1 {@ Minimum DIFFUSION width for NMOS/PMOS is 0.16 um
                           @ Minimum DIFFUSION width for interconnect is 0.16 um
                           @ others, When the common run length (x <= 0.01)
    x1 = INT DIFF_SP_16 < 0.16 ABUT>0<90 SINGULAR PROJ <=0.01 REGION
    x1 AND SP_16
    x2 = INT DIFF_SP_16 < 0.16 ABUT>0<90 SINGULAR NOT PROJ REGION
    x2 AND SP_16
    x3 = INT DIFF_SP_16 < 0.16 ABUT>0<90 SINGULAR CORNER TO CORNER REGION
    x3 AND SP_16
}

SP_16.4A.1A.a1b1__4A.1B_2 {@ Minimum DIFFUSION width for NMOS/PMOS is 0.152 um
                           @ Minimum DIFFUSION width for interconnect is 0.152 um
                           @ When the common run length between 0.01 to 0.022 (0.01 < x <= 0.022)
    x = INT DIFF_SP_16 < 0.152 ABUT>0<90 SINGULAR PROJ >0.01 <=0.022 REGION
    x AND SP_16
}

SP_16.4A.1A.a1b1__4A.1B_3 {@ Minimum DIFFUSION width for NMOS/PMOS is 0.16 um
                           @ Minimum DIFFUSION width for interconnect is 0.16 um
                           @ others, When the common run length (x > 0.022)
    x = INT DIFF_SP_16 < 0.16 ABUT>0<90 SINGULAR PROJ >0.022 REGION
    x AND SP_16
}

SP_16.4A.1C.a1b1_1 {@ Minimum space between two DIFF regions is 0.2 um
                    @ others, When the common run length <= 0.191
    x1 = EXT DIFF_SP_16 < 0.2 ABUT>0<90 SINGULAR PROJ <=0.191 REGION
    x1 AND SP_16
    x2 = EXT DIFF_SP_16 < 0.2 ABUT>0<90 SINGULAR NOT PROJ REGION
    x2 AND SP_16
    x3 = EXT DIFF_SP_16 < 0.2 ABUT>0<90 SINGULAR CORNER TO CORNER REGION
    x3 AND SP_16
}

SP_16.4A.1C.a1b1_2 {@ Minimum space between two DIFF regions is 0.186 um
                    @ When the common run length between  0.191 to 1.1 (0.191 < x <= 1.1)
    x = EXT DIFF_SP_16 < 0.186 ABUT>0<90 SINGULAR PROJ >0.191 <=1.1 REGION
    x AND SP_16
}

SP_16.4A.1C.a1b1_3 {@ Minimum space between two DIFF regions is 0.2 um
                    @ others, When the common run length > 1.1
    x = EXT DIFF_SP_16 < 0.2 ABUT>0<90 SINGULAR PROJ >1.1 REGION
    x AND SP_16
}

SP_16.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.144 um
    x = EXT NWEL_SP_16 NDIF1 < 0.144 ABUT<90 OVERLAP SINGULAR REGION
    x AND SP_16
}

SP_16.4A.1F {@ Minimum NWEL to P+ DIFF is 0.136 um
    x = EXT NWEL_SP_16 PTAP < 0.136 ABUT<90 SINGULAR OVERLAP REGION
    x AND SP_16
}

SP_16.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.159 um
    x = ENC PDIF1 NWEL_SP_16 < 0.159 ABUT<90 SINGULAR OVERLAP REGION
    x AND SP_16
}

SP_16.4A.4.2C {@ Minimum VTN_SP enclosure of POLY1 gate (POLY1 on DIFFUSION)
               @ of the NMOS device is 0.144 um
    E = ENC GATE1_VTN_SP VTN_SP < 0.144 ABUT<90 REGION
    E AND SP_16

    (VTN_SP INTERACT SP_16) INSIDE EDGE GATE
}

SP_16.4A.4.2D {@ Minimum VTN_SP to unrelated POLY1 gate spacing is 0.159 um
    E = EXT VTN_SP GATE_NOT_VTN_SP < 0.159 ABUT INSIDE ALSO REGION
    E AND SP_16

    (VTN_SP INTERACT SP_16) INSIDE EDGE GATE
}

SP_16.4A.5.2C {@ Minimum VTP_SP enclosure of POLY1 gate (POLY1 on DIFFUSION)
               @ of the PMOS device is 0.159 um
    E = ENC GATE1_VTP_SP VTP_SP < 0.159 ABUT<90 REGION
    E AND SP_16

    (VTP_SP INTERACT SP_16) INSIDE EDGE GATE
}

SP_16.4A.5.2D {@ Minimum VTP_SP to unrelated POLY1 gate spacing is 0.144 um
    E = EXT VTP_SP GATE_NOT_VTP_SP < 0.144 ABUT INSIDE ALSO REGION
    E AND SP_16

    (VTP_SP INTERACT SP_16) INSIDE EDGE GATE
}

SP_16.4A.9AaBaC_1 {@ Minimum POLY1 width for 1.2V NMOS is 0.08 um
                   @ Minimum POLY1 width for 1.2V PMOS is 0.08 um
                   @ Minimum POLY1 width for interconnect is 0.08 um
                   @ When the common run length <= 0.027 (x <= 0.027)
    E1 = INT PO1_SP_16 < 0.08 ABUT>0<90 SINGULAR PROJ <=0.027 REGION
    E1 AND SP_16
    E2 = INT PO1_SP_16 < 0.08 ABUT>0<90 SINGULAR NOT PROJ REGION
    E2 AND SP_16
    E3 = INT PO1_SP_16 < 0.08 ABUT>0<90 SINGULAR CORNER TO CORNER REGION
    E3 AND SP_16
}

SP_16.4A.9AaBaC_2 {@ Minimum POLY1 width for 1.2V NMOS is 0.086 um
                   @ Minimum POLY1 width for 1.2V PMOS is 0.086 um
                   @ Minimum POLY1 width for interconnect is 0.086 um
                   @ When the common run length between 0.027 to 0.032 (0.027 < x <= 0.032)
    E = INT PO1_SP_16 < 0.086 ABUT>0<90 SINGULAR PROJ >0.027 <=0.032 REGION
    E AND SP_16
}

SP_16.4A.9AaBaC_3 {@ Minimum POLY1 width for 1.2V NMOS is 0.089 um
                   @ Minimum POLY1 width for 1.2V PMOS is 0.089 um
                   @ Minimum POLY1 width for interconnect is 0.089 um
                   @ When the common run length between 0.032 to 0.039 (0.032 < x <= 0.039)
    E = INT PO1_SP_16 < 0.089 ABUT>0<90 SINGULAR PROJ >0.032 <=0.039 REGION
