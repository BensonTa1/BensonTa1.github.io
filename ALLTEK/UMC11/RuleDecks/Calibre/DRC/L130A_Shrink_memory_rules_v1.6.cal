//CONT_AREA_3 = AREA CONT_DP4S == 0.086725

//CONT_AREA = (CONT_AREA_1 OR CONT_AREA_2) OR CONT_AREA_3


DP4S.4A.13C.a {@ Minimum DIFF CONT to Poly(1.2V) spacing is 0.085um,
  X = EXT DIFCNT_DP4S GATE1_W < 0.085 ABUT>0<90 OPPOSITE REGION
  x AND DP4S
}

DP4S.4A.13D {@ Minimum PO1 Contact to DIFF spaceing is 0.125um
   x = EXT POLCNT_DP4S DIFF < 0.125 ABUT<90 SINGULAR REGION
   x AND DP4S
}

DP4S.4A.13E {@ Minimum PO1 overlap CONT is 0.06um, no floating conntact
    POLCNT_DP4S = CONT_DP4S INTERACT PO1
    Y = RECTANGLE ENC POLCNT_DP4S PO1_DP4S
    GOOD 0.020 0.035 0.035 0.035
    GOOD 0.030 0.032 0.060 0.033
    GOOD 0.060 0.032 0.030 0.033
    //GOOD 0.000 0.032 0.030 0.033
    GOOD 0.060 0.030 0.060 0.030
    GOOD 0.023 0.035 0.032 0.035
    GOOD 0.028 0.032 0.060 0.032
    GOOD 0.040 0.030 0.040 0.030
    GOOD 0.029 0.032 0.060 0.032
    Y AND DP4S
}

DP4S.4A.13FG {@ Minimum extension of an DIFF region beyond a CONT region is
   Y = RECTANGLE ENC CONT_DP4S DIFF_DP4S
   GOOD 0.060 0.015 OPPOSITE 0.015 0.015 OPPOSITE
   GOOD 0.060 0.035 OPPOSITE 0.060 0.030 OPPOSITE
   GOOD 0.060 0.005 OPPOSITE 0.060 0.005 OPPOSITE
   GOOD 0.055 0.015 OPPOSITE 0.016 0.015 OPPOSITE
   GOOD 0.006 0.043 OPPOSITE 0.018 0.032 OPPOSITE
   GOOD 0.017 0.005 OPPOSITE 0.009 0.015 OPPOSITE
   GOOD 0.015 0.015 OPPOSITE 0.015 0.015 OPPOSITE
   Y AND DP4S
}

//DP4S.4A.13I {@ Poly contact on diffusion is not allowed.

/////////////////////////////


DP4S.4B.1D.b {@ ME1 enclose CONT at end-of-line or outer corner is 0.06,when ME1 width < 0.24
               @ cont (GOOD 0.00 0.06  OPPOSITE 0.00 0.06  OPPOSITE)
    co_sm24 = CONT_DP4S INTERACT SM1_024
    y = RECTANGLE ENC co_sm24 ME1
    GOOD 0.046 0.027   0.025 0.022
    GOOD 0.049 0.026   0.021 0.047
    GOOD 0.060 0.024   0.056 0.016
    GOOD 0.047 0.022   0.060 0.018
    GOOD 0.004 0.060   0.006 0.058
    GOOD 0.005 0.060   0.005 0.060
    GOOD 0.000 0.060   0.010 0.060
    GOOD 0.004 0.060   0.004 0.060
    y AND DP4S
}




//=========================
// DP3S SRAM (8TSRAM3.39LL)
//=========================

DIFF_DP3S  = DIFF INTERACT DP3S
NWEL_DP3S  = NWEL INTERACT DP3S
PO1_DP3S   = PO1  INTERACT DP3S
GATE_DP3S  = GATE AND DP3S
GATE_W_DP3S = PO1_DP3S COIN INSIDE EDGE GATE_DP3S
GATE_Wc_DP3S = GATE_W_DP3S  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_DP3S = GATE_W_DP3S NOT INSIDE EDGE TG
ACTIVE_PS_DP3S = DIFF_DP3S OUTSIDE NWEL

PDIF1_DP3S = PDIF1 AND DP3S
NDIF1_DP3S = NDIF1 AND DP3S

PPLUS_DP3S  = PPLUS INTERACT DP3S
CONT_DP3S   = CONT INTERACT DP3S
POLCNT_DP3S = POLCNT AND DP3S
DIFCNT_DP3S = DIFCNT AND DP3S
ME1_DP3S   = ME1 INTERACT DP3S

DP3S.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.2 um
   X = EXT NWEL_DP3S NDIF1 < 0.2 ABUT<90 SINGULAR OVERLAP REGION
   X AND DP3S
}

DP3S.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.194 um
   X = ENC PDIF1 NWEL_DP3S < 0.194 ABUT<90 SINGULAR OVERLAP REGION
   X AND DP3S
}

   PG_GATE_DP3S = RECTANGLE ( GATE INTERACT NPLUS )  == 0.18 BY == 0.165
   PD_GATE_DP3S = RECTANGLE ( GATE INTERACT NPLUS )  == 0.51 BY == 0.13
   PL_GATE_DP3S = RECTANGLE ( GATE INTERACT PPLUS )  == 0.165 BY == 0.12
   GATE_O_DP3S  = ((GATE NOT PD_GATE_DP3S) NOT PG_GATE_DP3S) NOT PL_GATE_DP3S


DP3S.4A.4.3D {@ Minimum VTNH to unrelated Poly gate spacing is 0.209 um
   X = EXT VTNH GATE_NOT_VTNH < 0.209 ABUT INSIDE ALSO REGION
   X AND DP3S
}

DP3S.4A.5.3D_1 {@ Minimum VTPH to unrelated Poly gate spacing is 0.2 um when gate = PD_GATE_DP3S
   X = EXT VTPH ( PD_GATE_DP3S AND GATE_NOT_VTPH ) < 0.2 ABUT INSIDE ALSO REGION
   X AND DP3S
}

DP3S.4A.5.3D_2 {@ Minimum VTPH to unrelated Poly gate spacing is 0.228 um when gate = PG_GATE_DP3S
   X = EXT VTPH ( PG_GATE_DP3S AND GATE_NOT_VTPH ) < 0.228 ABUT INSIDE ALSO REGION
   X AND DP3S
}


DP3S.4A.9AaBaC_1 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.105 um when common run length <= 0.011
   X = INT PO1_DP3S < 0.105 ABUT>0<90 SINGULAR PROJECTING <= 0.011 REGION
   X AND DP3S
}

DP3S.4A.9AaBaC_2 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.1 um when common run length > 0.011 <= 0.013
   X = INT PO1_DP3S < 0.1 ABUT>0<90 SINGULAR PROJECTING > 0.011 <= 0.013 REGION
   X AND DP3S
}

DP3S.4A.9AaBaC_3 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.098 um when common run length > 0.013 <= 0.036
   X = INT PO1_DP3S < 0.098 ABUT>0<90 SINGULAR PROJECTING > 0.013 <= 0.036 REGION
   X AND DP3S
}


DP3S.4A.9AaBaC_4 {@ Minimum PO1 width for 1.2V NMOS or PMOS or interconnect is 0.12um when common run length x > 0.036
   X = INT PO1_DP3S < 0.12 ABUT>0<90 SINGULAR  PROJECTING >0.036 REGION
   X AND DP3S
}


DP3S.4A.9D.c1_1 {@ Minimum PO1 spacing on DIFF regions without contact is 0.18 when common run length ==0.142
   E = EXT PO1 < 0.18 PROJ == 0.142 ABUT>0<90 SINGULAR REGION
   E AND DP3S
}

DP3S.4A.9D.c1_2 {@ Minimum PO1 spacing on DIFF regions without contact is 0.18 when common run length !=0.142
   E = EXT PO1 < 0.18 PROJ != 0.142 ABUT>0<90 SINGULAR REGION
   E AND DP3S
}


DP3S.4A.9F_1 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.012um when common run length x <=0.012um
   X1 = EXT PO1_DP3S DIFF < 0.012 ABUT>0<90 SINGULAR PROJECTING <= 0.012 REGION
   X1 AND DP3S
}

DP3S.4A.9F_2 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.085um when common run length 0.012 < x <= 0.021 um
   X1 = EXT PO1_DP3S DIFF < 0.085 ABUT>0<90 SINGULAR PROJECTING > 0.012 <= 0.021 REGION
   X1 AND DP3S
}


DP3S.4A.9F_3 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.06 um when common run length 0.021 < x <= 0.054 um

  X1 = EXT PO1_DP3S DIFF < 0.06 ABUT>0<90 SINGULAR PROJECTING > 0.021 <= 0.054 REGION
  X1 AND DP3S
}

DP3S.4A.9F_4 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.075 um when common run length  x = 0.175 um

  X1 = EXT PO1_DP3S DIFF < 0.075 ABUT>0<90 SINGULAR PROJECTING == 0.175 REGION
  X1 AND DP3S
}

DP3S.4A.9F_5 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.088 um when common run length  x = 0.185 um

  X1 = EXT PO1_DP3S DIFF < 0.088 ABUT>0<90 SINGULAR PROJECTING == 0.185 REGION
  X1 AND DP3S
}

DP3S.4A.9F_6 {@ Minimum spacing of DIFF to PO1 on field oxide is 0.1 um when common run length  x > 0.054 and not 0.175, 0.185 um
  X1 = EXT PO1_DP3S DIFF < 0.1 ABUT>0<90 SINGULAR PROJECTING > 0.054 REGION
  X2 = EXT PO1_DP3S DIFF < 0.1 ABUT>0<90 SINGULAR PROJECTING == 0.175 REGION
  X3 = EXT PO1_DP3S DIFF < 0.1 ABUT>0<90 SINGULAR PROJECTING == 0.185 REGION
  (( X1 NOT X2 ) NOT X3 ) AND DP3S
}


DP3S.4A.9H.a__4A.9O_1 {@ Minimum PO1 gate to field edge spacing is 0.14um when the common run length = 0.274
   E = ENC GATE_W DIFF_DP3S < 0.14 PROJECTING == 0.274 REGION
   E AND DP3S
}

DP3S.4A.9H.a__4A.9O_2 {@ Minimum PO1 gate to field edge spacing is 0.2um when the common run length != 0.274
   E = ENC GATE_W DIFF_DP3S < 0.2 PROJECTING != 0.274 REGION
   E AND DP3S
}


// DP3S.4A.9P {@ The POLY1 density 1mm X 1mm 500 um increments must > 15%
//    Waive


DP3S.4A.13C.a {@ Minimum DIFF CONT to Poly(1.2V) spacing is 0.084um,
  X = EXT DIFCNT_DP3S GATE1_W < 0.084 ABUT>0<90 OPPOSITE REGION
  x AND DP3S
}

DP3S.4A.13D {@ Minimum PO1 Contact to DIFF spaceing is 0.108um
   x = EXT POLCNT_DP3S DIFF < 0.108 ABUT<90 SINGULAR REGION
   x AND DP3S
}

DP3S.4A.13E {@ Minimum PO1 overlap CONT is 0.06um, no floating conntact
    POLCNT_DP3S = CONT_DP3S INTERACT PO1
    Y = RECTANGLE ENC POLCNT_DP3S PO1_DP3S
    GOOD 0.035 0.035 0.025 0.035
    GOOD 0.060 0.035 0.060 0.030
    GOOD 0.030 0.030 0.030 0.030
    GOOD 0.034 0.030 0.060 0.030
    GOOD 0.039 0.023 0.039 0.002
    GOOD 0.038 0.060 0.039 0.060
    GOOD 0.030 0.060 0.030 0.060
    GOOD 0.039 0.021 0.039 0.060
    GOOD 0.035 0.030 0.035 0.030
    GOOD 0.005 0.033 0.010 0.032
    GOOD 0.000 0.038 0.025 0.039
    GOOD 0.040 0.041 0.065 0.041
    Y AND DP3S
}

DP3S.4A.13FG {@ Minimum extension of an DIFF region beyond a CONT region is
   Y = RECTANGLE ENC CONT_DP3S DIFF_DP3S
   GOOD 0.018 0.060 OPPOSITE 0.017 0.060 OPPOSITE
   GOOD 0.010 0.060 OPPOSITE 0.010 0.060 OPPOSITE
   GOOD 0.060 0.060 OPPOSITE 0.060 0.055 OPPOSITE
   GOOD 0.018 0.055 OPPOSITE 0.017 0.060 OPPOSITE
   GOOD 0.010 0.055 OPPOSITE 0.010 0.060 OPPOSITE
   GOOD 0.017 0.060 OPPOSITE 0.003 0.060 OPPOSITE
   GOOD 0.002 0.060 OPPOSITE 0.003 0.060 OPPOSITE
   GOOD 0.017 0.060 OPPOSITE 0.003 0.026 OPPOSITE
   GOOD 0.013 0.060 OPPOSITE 0.007 0.025 OPPOSITE
   GOOD 0.010 0.060 OPPOSITE 0.010 0.060 OPPOSITE
   GOOD 0.002 0.060 OPPOSITE 0.003 0.055 OPPOSITE
   GOOD 0.016 0.060 OPPOSITE 0.004 0.060 OPPOSITE
   GOOD 0.012 0.060 OPPOSITE 0.008 0.050 OPPOSITE
   Y AND DP3S
}

//=========================
// SP_4 SRAM (6TSRAM1.64LL)
//=========================

DIFF_SP_4  = DIFF INTERACT SP_4
NWEL_SP_4  = NWEL INTERACT SP_4
PO1_SP_4   = PO1  INTERACT SP_4
GATE_SP_4  = GATE AND SP_4
GATE_W_SP_4 = PO1_SP_4 COIN INSIDE EDGE GATE_SP_4
GATE_Wc_SP_4 = GATE_W_SP_4  COIN OUTSIDE EDGE CO_SD  //With contact
GATE1_W_SP_4 = GATE_W_SP_4 NOT INSIDE EDGE TG
ACTIVE_PS_SP_4 = DIFF_SP_4 OUTSIDE NWEL

PDIF1_SP_4 = PDIF1 AND SP_4
NDIF1_SP_4 = NDIF1 AND SP_4

PPLUS_SP_4  = PPLUS INTERACT SP_4
CONT_SP_4   = CONT INTERACT SP_4
POLCNT_SP_4 = POLCNT AND SP_4
DIFCNT_SP_4 = DIFCNT AND SP_4
ME1_SP_4  = ME1 INTERACT SP_4


SP_4.4A.1C.a1b1 {@ Minimum space between two DIFF regions is 0.199 um
    x = EXT DIFF_SP_4 < 0.199 ABUT>0<90 SINGULAR REGION
    x AND SP_4
}

SP_4.4A.1D.a {@ Minimum NWEL to a N+ DIFF(1.2V) spacing is 0.169 um
    x = EXT NWEL_SP_4 NDIF1 < 0.169 ABUT<90 OVERLAP SINGULAR REGION
    x AND SP_4
}

SP_4.4A.1G.a {@ Minimum NWEL overlap P+ DIFF(1.2V) is 0.144 um
    x = ENC PDIF1 NWEL_SP_4 < 0.144 ABUT<90 SINGULAR OVERLAP REGION
    x AND SP_4
}

SP_4.4A.1H {@ Minimum DIFF/isolation area 0.1008 sq.um
    E = AREA DIFF_SP_4 < 0.1008
    E AND SP_4
}

//GATE1_VTNH = (GATE1 AND VTNH ) NOT PPLUS
//GATE_NOT_VTNH = GATE NOT GATE1_VTNH
//GATE1_VTPH = (GATE1 AND VTPH ) AND PPLUS
//GATE_NOT_VTPH = GATE NOT GATE1_VTPH

SP_4.4A.4.3D {@ Minimum VTNH to unrelated POLY1 gate spacing is 0.184 um
    E = EXT VTNH GATE_NOT_VTNH < 0.184 ABUT INSIDE ALSO REGION
    E AND SP_4
}

SP_4.4A.5.3D {@ Minimum VTPH to unrelated Poly gate spacing is 0.178 um
    E = EXT VTPH GATE_NOT_VTPH < 0.178 ABUT INSIDE ALSO REGION
    E AND SP_4
}

//   PG_GATE_SPLLS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.185 BY == 0.13
//   PD_GATE_SPLLS = RECTANGLE ( GATE INTERACT NPLUS )  == 0.265 BY == 0.12
//   PL_GATE_SPLLS = RECTANGLE ( GATE INTERACT PPLUS )  == 0.165 BY == 0.12
//   GATE_O_SPLLS  = ((GATE NOT PD_GATE_SPLLS) NOT PG_GATE_SPLLS) NOT PL_GATE_SPLLS

SP_4.4A.9AaBaC {@ Minimum POLY1 width for 1.2V NMOS is 0.106 um
                @ Minimum POLY1 width for 1.2V PMOS is 0.106 um
                @ Minimum POLY1 width for interconnect is 0.106 um
    E = INT PO1_SP_4 < 0.106 ABUT>0<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.9D.a1_4A.9D.c1 {@ Minimum POLY1 to POLY1 spacing on DIFFUSION regions is 0.118 um
                        @ (without CONTACT)
    E = EXT PO1_SP_4 < 0.118 ABUT>0<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.9E {@ Minimum POLY1 overhang of DIFFUSION is 0.177 um
    E = ENC DIFF PO1_SP_4 < 0.177 ABUT<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.9F {@ Minimum POLY1 on field region to DIFFUSION spacing is 0.02 um
    E = EXT PO1_SP_4 DIFF < 0.02 ABUT<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.9G {@ Minimum endcap POLY1 to related DIFFUSION spacing is 0.049 um
    END_CAP =  INTPOL TOUCH GATE == 1
    X = DIFF OUTSIDE EDGE GATE
    Y = GATE TOUCH EDGE END_CAP
    E = EXT Y X < 0.049 PERP ONLY ABUT == 90 REGION
    E AND SP_4
}

//    GATE_SPLLS_4 = AREA GATE_SPLLS == 0.0313

SP_4.4A.10D.a {@ Minimum N+ implant to P+ DIFFUSION spacing (inside N_WELL) is 0.144 um
               @ (DIFFUSION overlap (N+ and P+) is not allowed)
    E = EXT NPLUS ACTIVE_NT < 0.144 ABUT<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.11C.a {@ Minimum P+ implant overhang of P+ DIFFUSION (inside N_WELL) is 0.144 um
    E = ENC ACTIVE_NT PPLUS < 0.144 ABUT<90 SINGULAR REGION
    E AND SP_4
}

//CONT_SPLLS_A = RECTANGLE CONT_SPLLS == 0.16 BY == 0.16
//CONT_SPLLS_SINGLE = AREA CONT_SPLLS == 0.0255

SP_4.4A.13A {@ Maximum and Minimum CONTACT size is 0.16 um x 0.16 um
             @ Maximum and Minimum CONTACT size is 0.186 um x 0.138 um
             @ Maximum and Minimum CONTACT size is 0.156 um x 0.156 um
    x = NOT RECTANGLE CONT_SP_4 == 0.16 BY == 0.16
    y = NOT RECTANGLE x == 0.186 BY == 0.138
    E = NOT RECTANGLE y == 0.156 BY == 0.156
    E AND SP_4
}

//CONT_AREA_1 = AREA CONT_SPLLS == 0.0937
//CONT_AREA_2 = AREA CONT_SPLLS == 0.078475
//CONT_AREA_3 = AREA CONT_SPLLS == 0.086725
//CONT_AREA_4 = AREA CONT_SPLLS == 0.0255

//CONT_AREA = (CONT_AREA_1 OR CONT_AREA_2) OR CONT_AREA_3

SP_4.4A.13B {@ Minimum CONTACT to CONTACT spacing is 0.16 um
    E = EXT CONT_SP_4 < 0.16 ABUT>0<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.13C.a {@ Minimum DIFFUSION CONTACT to POLY1 (1.2V) spacing is 0.059 um
               @ CONTACT over GATE is not allowed
    E = EXT GATE1_W DIFCNT < 0.059 ABUT<90 REGION
    E AND SP_4
}

SP_4.4A.13D {@ Minimum POLY1 CONTACT to DIFFUSION spaceing is 0.064 um
    E = EXT POLCNT DIFF < 0.064 ABUT<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4A.13E {@ Minimum POLY1 enclosure of CONTACT is 0.016 um
             @ Floating CONTACT is not allowed
    E = ENC POLCNT PO1 < 0.016 ABUT<90 SINGULAR OUTSIDE ALSO REGION
    E AND SP_4
}

SP_4.4A.13FG {@ Minimum P+ DIFFUSION enclosure of CONTACT is 0.008 um
              @ Minimum N+ DIFFUSION enclosure of CONTACT is 0.008 um
    E = ENC DIFCNT DIFF < 0.008 ABUT<90 SINGULAR OVERLAP REGION
    E AND SP_4
}

/////////////////////////////

SP_4.4B.1B.a {@ Minimum METAL1 to METAL1 spacing is 0.15 um
              @ where one METAL1 width < 2.0um
    E = EXT ME1 < 0.15 ABUT>0<90 SINGULAR REGION
    E AND SP_4
}

SP_4.4B.1D.b {@ Minimum METAL1 enclosure of CONTACT at end-of-line or outer corner is 0.01 um
              @ when METAL1 width < 0.24um
    co_sm24 = CONT INTERACT SM1_024
    E = RECTANGLE ENC co_sm24 ME1
    GOOD 0.00 0.01 OPPOSITE 0.00 0.01 OPPOSITE
    E AND SP_4
}

SP_4.4B.1E {@ Minimum area of METAL1 region 0.09744 sq.um
    E = AREA ME1 < 0.09744
    E AND SP_4
}

SP_4.4B.2B.a_b.VI1 {@ Minimum MVI1 to MVIA1 spacing is 0.187 um
    E = EXT VI1 < 0.187 ABUT>0<90 SINGULAR REGION
    E AND SP_4
}

