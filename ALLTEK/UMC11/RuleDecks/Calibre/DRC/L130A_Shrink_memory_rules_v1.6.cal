    E2 = ENC DIFF PO1_SP_16 < 0.18 ABUT<90 SINGULAR NOT PROJ REGION
    E2 AND SP_16
    E3 = ENC DIFF PO1_SP_16 < 0.18 ABUT<90 SINGULAR CORNER TO CORNER REGION
