     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
}

ME5_CA_G = NET AREA RATIO ME5_WITHOUT_DIODE OVER GATE > 0
         [PERIMETER(ME5_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)] ACCUMULATE ME4_CA_G // GATE ME1 to ME5 ACCUMULATE

   
ANT.7.1.2B.ME5 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 45000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 100
               [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.2B.ME5.sum
   
     NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 100
           [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA  
     RDB ANT.7.1.2B.ME5.rdb BY LAYER ME5_WITH_DIODE GATE DIODE_ME5
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
}

ME5_CA = NET AREA RATIO ME5_WITH_DIODE OVER GATE DIODE_ME5 > 0
         [PERIMETER(ME5_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+ 400*AREA(DIODE_ME5)))] ACCUMULATE ME4_CA // GATE ME1 to ME5 ACCUMULATE

   
/////////////////////////
// VI5 Antenna check   //
/////////////////////////

f_VI5 = BULK AND VI5
CONNECT ME5 f_VI5

VI5_WITHOUT_DIODE = NET AREA RATIO f_VI5 DIODE_ME5 ==0	// VIA5 DO NOT CONNECT WITH DIODE
VI5_WITH_DIODE    = NET AREA RATIO f_VI5 DIODE_ME5 > 0  // VIA5 CONNECT WITH DIODE

ANT.7.1.1C.VI5 { @ Maximum ratio of VIA5 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.7.1.1C.VI5.sum
   
     NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.7.1.1C.VI5.rdb BY LAYER VI5_WITHOUT_DIODE GATE   
}

ANT.7.1.1I.VI5 { @ Maximum ratio of cumulative VIA5 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI4_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1I.VI5.sum
   
     NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI4_CA 
     RDB ANT.7.1.1I.VI5.rdb BY LAYER VI5_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
       NET AREA RATIO f_VI4 E_STAMP >0
       NET AREA RATIO f_VI5 E_STAMP >0
}

ANT.7.1.2A.VI5 { @ Maximum ratio of VIA5 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 >1
             [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))]  ACCUMULATE VI4_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.7.1.2A.VI5.sum
   
   NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 >1
         [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))]  ACCUMULATE VI4_CA_WD   
   RDB  ANT.7.1.2A.VI5.rdb  BY LAYER  VI5_WITH_DIODE  GATE DIODE_ME5 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
     NET AREA RATIO f_VI5 E_STAMP >0
}

//ANT.7.1.2.Note2.VI5 { @ Maximum ratio of VIA5 area (cumulative) to gate area is 1200 area.
//   E = NET AREA RATIO f_VI5 OVER GATE  > 1200 ACCUMULATE VI4_all_CA
//   COPY E  
//   NET AREA RATIO PRINT E  ANT.7.1.2.Note2.VI5.sum
//   
//   NET AREA RATIO f_VI5 OVER GATE > 1200 ACCUMULATE VI4_all_CA   
//   RDB ONLY ANT.7.1.2.Note2.VI5.rdb  BY LAYER  f_VI5  GATE  
//
//   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
//     NET AREA RATIO f_VI1 E_STAMP >0
//     NET AREA RATIO f_VI2 E_STAMP >0
//     NET AREA RATIO f_VI3 E_STAMP >0
//     NET AREA RATIO f_VI4 E_STAMP >0
//     NET AREA RATIO f_VI5 E_STAMP >0
//}

VI5_all_CA = NET AREA RATIO f_VI5 OVER GATE > 0 ACCUMULATE VI4_all_CA
VI5_CA = NET AREA RATIO VI5_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI4_CA // GATE VI1 to VI5 ACCUMULATE without diode
VI5_CA_WD = NET AREA RATIO VI5_WITH_DIODE OVER GATE DIODE_ME5 > 0
            [AREA(VI5_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME5)))] ACCUMULATE VI4_CA_WD // GATE VI1 to VI5 ACCUMULATE with diode
    
/////////////////////////
// ME6 Antenna check   //
/////////////////////////

  
CONNECT ME6 ME5 BY VI5
DIODE_ME6   = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME6 BY CONT


ME6_WITHOUT_DIODE    =  NET AREA RATIO ME6 DIODE_ME6 == 0 // ME6 DO NOT CONNECT WITH DIODE
ME6_WITH_DIODE       =  NET AREA RATIO ME6 DIODE_ME6 > 0   // ME6 CONNECT WITH DIODE

//ANT.7.1.3.ME6 { @ If the poly gate over diffusion area > 6400, the protection diode is must be.
//     X = NET AREA GATE > 6400
//     NET AREA RATIO X DIODE_ME6 == 0  // check the GATE is NOT connected with the protection diode by METAL
//}

ANT.7.1.1E.ME6 { @ Maximum ratio of Thin Metal6 sidewall area (each layer) to gate area is 2100.
                 @ Without protection diode
     E = NET AREA RATIO ME6_WITHOUT_DIODE GATE > 2100 ACCUMULATE
         [PERIMETER(ME6_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.7.1.1E.ME6.sum   
   
     NET AREA RATIO ME6_WITHOUT_DIODE GATE > 2100
     [PERIMETER(ME6_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)]
     RDB ANT.7.1.1E.ME6.rdb BY LAYER ME6_WITHOUT_DIODE GATE
}

ANT.7.1.1H.ME6 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 15000.
                 @ Without protection diode
     E = NET AREA RATIO ME6_WITHOUT_DIODE OVER GATE > 15000
               [PERIMETER(ME6_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)] ACCUMULATE ME5_CA_G
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1H.ME6.sum
   
     NET AREA RATIO ME6_WITHOUT_DIODE OVER GATE > 15000
           [PERIMETER(ME6_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)] ACCUMULATE ME5_CA_G
     RDB ANT.7.1.1H.ME6.rdb BY LAYER ME6_WITHOUT_DIODE GATE
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
}

ME6_CA_G = NET AREA RATIO ME6_WITHOUT_DIODE OVER GATE > 0
         [PERIMETER(ME6_WITHOUT_DIODE)*MET_IN_THIN/AREA(GATE)] ACCUMULATE ME5_CA_G // GATE ME1 to ME6 ACCUMULATE

   
ANT.7.1.2B.ME6 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 45000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 100
               [PERIMETER(ME6_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.2B.ME6.sum
   
     NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 100
           [PERIMETER(ME6_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA  
     RDB ANT.7.1.2B.ME6.rdb BY LAYER ME6_WITH_DIODE GATE DIODE_ME6
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
}

ME6_CA = NET AREA RATIO ME6_WITH_DIODE OVER GATE DIODE_ME6 > 0
         [PERIMETER(ME6_WITH_DIODE)*MET_IN_THIN*100 / (AREA(GATE)*(45000+ 400*AREA(DIODE_ME6)))] ACCUMULATE ME5_CA // GATE ME1 to ME6 ACCUMULATE

   
/////////////////////////
// VI6 Antenna check   //
/////////////////////////

f_VI6 = BULK AND VI6
CONNECT ME6 f_VI6

VI6_WITHOUT_DIODE = NET AREA RATIO f_VI6 DIODE_ME6 ==0	// VIA6 DO NOT CONNECT WITH DIODE
VI6_WITH_DIODE    = NET AREA RATIO f_VI6 DIODE_ME6 > 0  // VIA6 CONNECT WITH DIODE

ANT.7.1.1C.VI6 { @ Maximum ratio of VIA6 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI6_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.7.1.1C.VI6.sum
   
     NET AREA RATIO VI6_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.7.1.1C.VI6.rdb BY LAYER VI6_WITHOUT_DIODE GATE   
}

ANT.7.1.1I.VI6 { @ Maximum ratio of cumulative VIA6 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI6_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI5_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1I.VI6.sum
   
     NET AREA RATIO VI6_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI5_CA 
     RDB ANT.7.1.1I.VI6.rdb BY LAYER VI6_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
       NET AREA RATIO f_VI4 E_STAMP >0
       NET AREA RATIO f_VI5 E_STAMP >0
       NET AREA RATIO f_VI6 E_STAMP >0
}

ANT.7.1.2A.VI6 { @ Maximum ratio of VIA6 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI6_WITH_DIODE OVER GATE DIODE_ME6 >1
             [AREA(VI6_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME6)))]  ACCUMULATE VI5_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.7.1.2A.VI6.sum
   
   NET AREA RATIO VI6_WITH_DIODE OVER GATE DIODE_ME6 >1
         [AREA(VI6_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME6)))]  ACCUMULATE VI5_CA_WD   
   RDB  ANT.7.1.2A.VI6.rdb  BY LAYER  VI6_WITH_DIODE  GATE DIODE_ME6 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
     NET AREA RATIO f_VI5 E_STAMP >0
     NET AREA RATIO f_VI6 E_STAMP >0
}

//ANT.7.1.2.Note2.VI6 { @ Maximum ratio of VIA6 area (cumulative) to gate area is 1200 area.
//   E = NET AREA RATIO f_VI6 OVER GATE  > 1200 ACCUMULATE VI5_all_CA
//   COPY E  
//   NET AREA RATIO PRINT E  ANT.7.1.2.Note2.VI6.sum
//   
//   NET AREA RATIO f_VI6 OVER GATE > 1200 ACCUMULATE VI5_all_CA   
//   RDB ONLY ANT.7.1.2.Note2.VI6.rdb  BY LAYER  f_VI6  GATE  
//
//   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
//     NET AREA RATIO f_VI1 E_STAMP >0
//     NET AREA RATIO f_VI2 E_STAMP >0
//     NET AREA RATIO f_VI3 E_STAMP >0
//     NET AREA RATIO f_VI4 E_STAMP >0
//     NET AREA RATIO f_VI5 E_STAMP >0
//     NET AREA RATIO f_VI6 E_STAMP >0
//}

VI6_all_CA = NET AREA RATIO f_VI6 OVER GATE > 0 ACCUMULATE VI5_all_CA
VI6_CA = NET AREA RATIO VI6_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI5_CA // GATE VI1 to VI6 ACCUMULATE without diode
VI6_CA_WD = NET AREA RATIO VI6_WITH_DIODE OVER GATE DIODE_ME6 > 0
            [AREA(VI6_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME6)))] ACCUMULATE VI5_CA_WD // GATE VI1 to VI6 ACCUMULATE with diode
    
// Start the VI6 Ratio rule of MMC between ME6 and ME7

M67_MMC_ANT.7.2.1D_CBM_VI6{ @ Maximum Ratio of MVIA_6 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node; MMC between ME6 and ME7
MMC67_FLOAT_ME6 = NET AREA RATIO ME6 SUB == 0
MMC67_ON_FLOAT_ME6 = DFM PROPERTY MMC67_FLOAT_ME6 M67_MMC OVERLAP MULTI
                     [MMC_AREA = AREA(M67_MMC)] > 0
MMC67_VI6 = (NET AREA RATIO f_VI6 MMC67_FLOAT_ME6 > 0) NOT M67_MMC
MMC67_FLOAT_VI6 = DFM PROPERTY MMC67_FLOAT_ME6 MMC67_VI6 MMC67_ON_FLOAT_ME6 NODAL MULTI
                               [VI6_AREA = AREA(MMC67_VI6)] > 0
                               [MMC_AREA = PROPERTY(MMC67_ON_FLOAT_ME6,MMC_AREA)] > 0

  P = DFM PROPERTY MMC67_FLOAT_ME6 M67_MMC MMC67_FLOAT_VI6 OVERLAP MULTI
      [check = AREA(M67_MMC)] > 0
      [CBM_VI6_AREA = PROPERTY(MMC67_FLOAT_VI6,VI6_AREA)] > 0
      [MMC_AREA = PROPERTY(MMC67_FLOAT_VI6,MMC_AREA)] > 0
      [VI6_RATIO = PROPERTY(MMC67_FLOAT_VI6,VI6_AREA)/PROPERTY(MMC67_FLOAT_VI6,MMC_AREA)] > 20
  DFM COPY P
  DFM RDB P MMC67_CBM_VI6_balance.rdb
}
    
/////////////////////////
// ME7 Antenna check   //
/////////////////////////

  
CONNECT ME7 M67_MMC ME6 BY VI6
DIODE_ME7   = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME7 BY CONT


ME7_WITHOUT_DIODE    =  NET AREA RATIO ME7 DIODE_ME7 == 0 // ME7 DO NOT CONNECT WITH DIODE
ME7_WITH_DIODE       =  NET AREA RATIO ME7 DIODE_ME7 > 0   // ME7 CONNECT WITH DIODE

//ANT.7.1.3.ME7 { @ If the poly gate over diffusion area > 6400, the protection diode is must be.
//     X = NET AREA GATE > 6400
//     NET AREA RATIO X DIODE_ME7 == 0  // check the GATE is NOT connected with the protection diode by METAL
//}

ANT.7.1.1F.ME7 { @ Maximum ratio of First Thick (1T) Metal7 sidewall area (each layer) to gate area is 3600.
                 @ Without protection diode
     E = NET AREA RATIO ME7_WITHOUT_DIODE GATE > 3600 ACCUMULATE
         [PERIMETER(ME7_WITHOUT_DIODE)*MET_IN_THICK/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.7.1.1F.ME7.sum   
   
     NET AREA RATIO ME7_WITHOUT_DIODE GATE > 3600
     [PERIMETER(ME7_WITHOUT_DIODE)*MET_IN_THICK/AREA(GATE)]
     RDB ANT.7.1.1F.ME7.rdb BY LAYER ME7_WITHOUT_DIODE GATE
}

ANT.7.1.1H.ME7 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 15000.
                 @ Without protection diode
     E = NET AREA RATIO ME7_WITHOUT_DIODE OVER GATE > 15000
               [PERIMETER(ME7_WITHOUT_DIODE)*MET_IN_THICK/AREA(GATE)] ACCUMULATE ME6_CA_G
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1H.ME7.sum
   
     NET AREA RATIO ME7_WITHOUT_DIODE OVER GATE > 15000
           [PERIMETER(ME7_WITHOUT_DIODE)*MET_IN_THICK/AREA(GATE)] ACCUMULATE ME6_CA_G
     RDB ANT.7.1.1H.ME7.rdb BY LAYER ME7_WITHOUT_DIODE GATE
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
     NET AREA RATIO ME7 E_STAMP >0
}

ME7_CA_G = NET AREA RATIO ME7_WITHOUT_DIODE OVER GATE > 0
         [PERIMETER(ME7_WITHOUT_DIODE)*MET_IN_THICK/AREA(GATE)] ACCUMULATE ME6_CA_G // GATE ME1 to ME7 ACCUMULATE

   
ANT.7.1.2B.ME7 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 45000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME7_WITH_DIODE OVER GATE DIODE_ME7 > 100
               [PERIMETER(ME7_WITH_DIODE)*MET_IN_THICK*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME7)))] ACCUMULATE ME6_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.2B.ME7.sum
   
     NET AREA RATIO ME7_WITH_DIODE OVER GATE DIODE_ME7 > 100
           [PERIMETER(ME7_WITH_DIODE)*MET_IN_THICK*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME7)))] ACCUMULATE ME6_CA  
     RDB ANT.7.1.2B.ME7.rdb BY LAYER ME7_WITH_DIODE GATE DIODE_ME7  

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
     NET AREA RATIO ME7 E_STAMP >0
}

ME7_CA = NET AREA RATIO ME7_WITH_DIODE OVER GATE DIODE_ME7 > 0
         [PERIMETER(ME7_WITH_DIODE)*MET_IN_THICK*100 / (AREA(GATE)*(45000+ 400*AREA(DIODE_ME7)))] ACCUMULATE ME6_CA // GATE ME1 to ME7 ACCUMULATE
   
/////////////////////////
// VI7 Antenna check   //
/////////////////////////

f_VI7 = BULK AND VI7
CONNECT ME7 f_VI7

VI7_WITHOUT_DIODE = NET AREA RATIO f_VI7 DIODE_ME7 ==0	// VIA7 DO NOT CONNECT WITH DIODE
VI7_WITH_DIODE    = NET AREA RATIO f_VI7 DIODE_ME7 > 0  // VIA7 CONNECT WITH DIODE

ANT.7.1.1C.VI7 { @ Maximum ratio of VIA7 area (each layer) to gate area is 20.
                 @ Without protection diode
     E = NET AREA RATIO VI7_WITHOUT_DIODE OVER GATE > 20 ACCUMULATE    
     COPY E 
     NET AREA RATIO PRINT E ANT.7.1.1C.VI7.sum
   
     NET AREA RATIO VI7_WITHOUT_DIODE OVER GATE > 20 
     RDB ANT.7.1.1C.VI7.rdb BY LAYER VI7_WITHOUT_DIODE GATE   
}

ANT.7.1.1I.VI7 { @ Maximum ratio of cumulative VIA7 area to gate area is 30.
                 @ Without protection diode
     E = NET AREA RATIO VI7_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI6_CA  
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1I.VI7.sum
   
     NET AREA RATIO VI7_WITHOUT_DIODE OVER GATE > 30 ACCUMULATE VI6_CA 
     RDB ANT.7.1.1I.VI7.rdb BY LAYER VI7_WITHOUT_DIODE GATE

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
       NET AREA RATIO f_VI1 E_STAMP >0
       NET AREA RATIO f_VI2 E_STAMP >0
       NET AREA RATIO f_VI3 E_STAMP >0
       NET AREA RATIO f_VI4 E_STAMP >0
       NET AREA RATIO f_VI5 E_STAMP >0
       NET AREA RATIO f_VI6 E_STAMP >0
       NET AREA RATIO f_VI7 E_STAMP >0
}

ANT.7.1.2A.VI7 { @ Maximum ratio of VIA7 area (cumulative) to gate area is 160+36*diode area.
                 @ With protection diode
   E = NET AREA RATIO VI7_WITH_DIODE OVER GATE DIODE_ME7 >1
             [AREA(VI7_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME7)))]  ACCUMULATE VI6_CA_WD
   COPY E  
   NET AREA RATIO PRINT E  ANT.7.1.2A.VI7.sum
   
   NET AREA RATIO VI7_WITH_DIODE OVER GATE DIODE_ME7 >1
         [AREA(VI7_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME7)))]  ACCUMULATE VI6_CA_WD   
   RDB  ANT.7.1.2A.VI7.rdb  BY LAYER  VI7_WITH_DIODE  GATE DIODE_ME7 

   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO f_VI1 E_STAMP >0
     NET AREA RATIO f_VI2 E_STAMP >0
     NET AREA RATIO f_VI3 E_STAMP >0
     NET AREA RATIO f_VI4 E_STAMP >0
     NET AREA RATIO f_VI5 E_STAMP >0
     NET AREA RATIO f_VI6 E_STAMP >0
     NET AREA RATIO f_VI7 E_STAMP >0
}

//ANT.7.1.2.Note2.VI7 { @ Maximum ratio of VIA7 area (cumulative) to gate area is 1200 area.
//   E = NET AREA RATIO f_VI7 OVER GATE  > 1200 ACCUMULATE VI6_all_CA
//   COPY E  
//   NET AREA RATIO PRINT E  ANT.7.1.2.Note2.VI7.sum
//   
//   NET AREA RATIO f_VI7 OVER GATE > 1200 ACCUMULATE VI6_all_CA   
//   RDB ONLY ANT.7.1.2.Note2.VI7.rdb  BY LAYER  f_VI7  GATE  
//
//   E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
//     NET AREA RATIO f_VI1 E_STAMP >0
//     NET AREA RATIO f_VI2 E_STAMP >0
//     NET AREA RATIO f_VI3 E_STAMP >0
//     NET AREA RATIO f_VI4 E_STAMP >0
//     NET AREA RATIO f_VI5 E_STAMP >0
//     NET AREA RATIO f_VI6 E_STAMP >0
//     NET AREA RATIO f_VI7 E_STAMP >0
//}

VI7_all_CA = NET AREA RATIO f_VI7 OVER GATE > 0 ACCUMULATE VI6_all_CA
VI7_CA = NET AREA RATIO VI7_WITHOUT_DIODE OVER GATE > 0 ACCUMULATE VI6_CA // GATE VI1 to VI7 ACCUMULATE without diode
VI7_CA_WD = NET AREA RATIO VI7_WITH_DIODE OVER GATE DIODE_ME7 > 0
            [AREA(VI7_WITH_DIODE) / (AREA(GATE)*(160+36*AREA(DIODE_ME7)))] ACCUMULATE VI6_CA_WD // GATE VI1 to VI7 ACCUMULATE with diode
    
// Start the ME7 & VIA7 Ratio rule of MMC between ME6 and ME7 //

MMC67_FLOAT_CBM_7 = NET AREA RATIO ME6 SUB == 0
MMC67_FLOAT_CTM_7 = NET AREA RATIO M67_MMC SUB == 0
MMC67_GROUND_CBM_7 = NET AREA RATIO ME6 SUB > 0
MMC67_GROUND_CTM_7 = NET AREA RATIO M67_MMC SUB > 0

MMC67_BALANCE_CTM_7 = (MMC67_FLOAT_CTM_7 AND MMC67_FLOAT_CBM_7) OR (MMC67_GROUND_CTM_7 AND MMC67_GROUND_CBM_7)
MMC67_UNBALANCE_CTM_7 = MMC67_FLOAT_CTM_7 AND MMC67_GROUND_CBM_7
CONNECT MMC67_BALANCE_CTM_7 M67_MMC
CONNECT MMC67_UNBALANCE_CTM_7 M67_MMC

M67_MMC_ANT.7.2.1A_CTM_ME7{ @ Maximum Ratio of Metal_7 (M7 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO ME7 MMC67_BALANCE_CTM_7 > 6000
     [PERIMETER(ME7)*MET_IN_THICK/AREA(MMC67_BALANCE_CTM_7)]
     RDB MMC67_CTM_ME7_balance.rdb BY LAYER ME7 MMC67_BALANCE_CTM_7
}

M67_MMC_ANT.7.2.1C_CTM_ME7{ @ Maximum Ratio of Metal_7 (M7 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO ME7 MMC67_UNBALANCE_CTM_7 > 100
     [PERIMETER(ME7)*MET_IN_THICK/AREA(MMC67_UNBALANCE_CTM_7)]
     RDB MMC67_CTM_ME7_unbalance.rdb BY LAYER ME7 MMC67_UNBALANCE_CTM_7
}

M67_MMC_ANT.7.2.1D_CTM_VI7{ @ Maximum Ratio of MVIA_7 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO f_VI7 MMC67_BALANCE_CTM_7 > 20
     RDB MMC67_CTM_VI7_balance.rdb BY LAYER f_VI7 MMC67_BALANCE_CTM_7
}

M67_MMC_ANT.7.2.1F_CTM_VI7{ @ Maximum Ratio of MVIA_7 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO f_VI7 MMC67_UNBALANCE_CTM_7 > 10
     RDB MMC67_CTM_VI7_unbalance.rdb BY LAYER f_VI7 MMC67_UNBALANCE_CTM_7
}

MMC67_BALANCE_CBM_7 = (MMC67_FLOAT_CBM_7 INTERACT MMC67_FLOAT_CTM_7) OR (MMC67_GROUND_CBM_7 INTERACT MMC67_GROUND_CTM_7)
MMC67_UNBALANCE_CBM_7 = MMC67_FLOAT_CBM_7 INTERACT MMC67_GROUND_CTM_7
CONNECT MMC67_BALANCE_CBM_7 ME6
CONNECT MMC67_UNBALANCE_CBM_7 ME6

MMC67_BALANCE_ME7_7 = NET AREA RATIO ME7 MMC67_BALANCE_CBM_7 > 0
MMC67_UNBALANCE_ME7_7 = NET AREA RATIO ME7 MMC67_UNBALANCE_CBM_7 > 0
MMC67_BALANCE_VI7_7 = NET AREA RATIO f_VI7 MMC67_BALANCE_CBM_7 > 0
MMC67_UNBALANCE_VI7_7 = NET AREA RATIO f_VI7 MMC67_UNBALANCE_CBM_7 > 0

M67_MMC_ANT.7.2.1A_CBM_ME7{ @ Maximum Ratio of Metal_7 (M7 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_BALANCE_ME7_7 f_M67_MMC > 6000
     [PERIMETER(MMC67_BALANCE_ME7_7)*MET_IN_THICK/AREA(f_M67_MMC)]
     RDB MMC67_CBM_ME7_balance.rdb BY LAYER MMC67_BALANCE_ME7_7 f_M67_MMC
}

M67_MMC_ANT.7.2.1B_CBM_ME7{ @ Maximum Ratio of Metal_7 (M7 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_UNBALANCE_ME7_7 f_M67_MMC > 100
     [PERIMETER(MMC67_UNBALANCE_ME7_7)*MET_IN_THICK/AREA(f_M67_MMC)]
     RDB MMC67_CBM_ME7_unbalance.rdb BY LAYER MMC67_UNBALANCE_ME7_7 f_M67_MMC
}

M67_MMC_ANT.7.2.1D_CBM_VI7{ @ Maximum Ratio of MVIA_7 (or UTMV) area to the METAL_CAP area is 20
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_BALANCE_VI7_7 f_M67_MMC > 20
     RDB MMC67_CBM_VI7_balance.rdb BY LAYER MMC67_BALANCE_VI7_7 f_M67_MMC
}

M67_MMC_ANT.7.2.1E_CBM_VI7{ @ Maximum Ratio of MVIA_7 (or UTMV) area to the METAL_CAP area is 10
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_UNBALANCE_VI7_7 f_M67_MMC > 10
     RDB MMC67_CBM_VI7_unbalance.rdb BY LAYER MMC67_UNBALANCE_VI7_7 f_M67_MMC
}
    
/////////////////////////
// ME8 Antenna check   //
/////////////////////////

  
CONNECT ME8 ME7 BY VI7
DIODE_ME8   = NET AREA DIODE >= DIO_AREA
CONNECT ME1 DIODE_ME8 BY CONT


ME8_WITHOUT_DIODE    =  NET AREA RATIO ME8 DIODE_ME8 == 0 // ME8 DO NOT CONNECT WITH DIODE
ME8_WITH_DIODE       =  NET AREA RATIO ME8 DIODE_ME8 > 0   // ME8 CONNECT WITH DIODE

//ANT.7.1.3.ME8 { @ If the poly gate over diffusion area > 6400, the protection diode is must be.
//     X = NET AREA GATE > 6400
//     NET AREA RATIO X DIODE_ME8 == 0  // check the GATE is NOT connected with the protection diode by METAL
//}

ANT.7.1.1G.ME8 { @ Maximum ratio of Second Thick (2T) Metal sidewall area (each layer) to gate area is 3600.
                 @ Without protection diode
     E = NET AREA RATIO ME8_WITHOUT_DIODE GATE > 3600 ACCUMULATE
         [PERIMETER(ME8_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)]
     COPY E
     NET AREA RATIO PRINT E ANT.7.1.1G.ME8.sum   
   
     NET AREA RATIO ME8_WITHOUT_DIODE GATE > 3600
     [PERIMETER(ME8_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)]
     RDB ANT.7.1.1G.ME8.rdb BY LAYER ME8_WITHOUT_DIODE GATE
}

ANT.7.1.1H.ME8 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 15000.
                 @ Without protection diode
     E = NET AREA RATIO ME8_WITHOUT_DIODE OVER GATE > 15000
               [PERIMETER(ME8_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)] ACCUMULATE ME7_CA_G
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.1H.ME8.sum
   
     NET AREA RATIO ME8_WITHOUT_DIODE OVER GATE > 15000
           [PERIMETER(ME8_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)] ACCUMULATE ME7_CA_G
     RDB ANT.7.1.1H.ME8.rdb BY LAYER ME8_WITHOUT_DIODE GATE
 
     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
     NET AREA RATIO ME7 E_STAMP >0
     NET AREA RATIO ME8 E_STAMP >0
}

ME8_CA_G = NET AREA RATIO ME8_WITHOUT_DIODE OVER GATE > 0
         [PERIMETER(ME8_WITHOUT_DIODE)*MET_TOP_THICK/AREA(GATE)] ACCUMULATE ME7_CA_G // GATE ME1 to ME8 ACCUMULATE

   
ANT.7.1.2B.ME8 { @ Maximum ratio of Metal sidewall area (cumulative) to gate area is 45000+400*diode area.
                 @ With protection diode
     E = NET AREA RATIO ME8_WITH_DIODE OVER GATE DIODE_ME8 > 100
               [PERIMETER(ME8_WITH_DIODE)*MET_TOP_THICK*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME8)))] ACCUMULATE ME7_CA
     COPY E 
     NET AREA RATIO PRINT E  ANT.7.1.2B.ME8.sum
   
     NET AREA RATIO ME8_WITH_DIODE OVER GATE DIODE_ME8 > 100
           [PERIMETER(ME8_WITH_DIODE)*MET_TOP_THICK*100 / (AREA(GATE)*(45000+400*AREA(DIODE_ME8)))] ACCUMULATE ME7_CA  
     RDB ANT.7.1.2B.ME8.rdb BY LAYER ME8_WITH_DIODE GATE DIODE_ME8  

     E_STAMP = STAMP (E AND OUTPUT_MARKER) BY PO1
     NET AREA RATIO ME1 E_STAMP >0
     NET AREA RATIO ME2 E_STAMP >0
     NET AREA RATIO ME3 E_STAMP >0
     NET AREA RATIO ME4 E_STAMP >0
     NET AREA RATIO ME5 E_STAMP >0
     NET AREA RATIO ME6 E_STAMP >0
     NET AREA RATIO ME7 E_STAMP >0
     NET AREA RATIO ME8 E_STAMP >0
}

ME8_CA = NET AREA RATIO ME8_WITH_DIODE OVER GATE DIODE_ME8 > 0
         [PERIMETER(ME8_WITH_DIODE)*MET_TOP_THICK*100 / (AREA(GATE)*(45000+ 400*AREA(DIODE_ME8)))] ACCUMULATE ME7_CA // GATE ME1 to ME8 ACCUMULATE
   

// Start the ME8 Ratio rule of MMC between ME6 and ME7 //

MMC67_FLOAT_CBM_8 = NET AREA RATIO ME6 SUB == 0
MMC67_FLOAT_CTM_8 = NET AREA RATIO M67_MMC SUB == 0
MMC67_GROUND_CBM_8 = NET AREA RATIO ME6 SUB > 0
MMC67_GROUND_CTM_8 = NET AREA RATIO M67_MMC SUB > 0

MMC67_BALANCE_CTM_8 = (MMC67_FLOAT_CTM_8 AND MMC67_FLOAT_CBM_8) OR (MMC67_GROUND_CTM_8 AND MMC67_GROUND_CBM_8)
MMC67_UNBALANCE_CTM_8 = MMC67_FLOAT_CTM_8 AND MMC67_GROUND_CBM_8
CONNECT MMC67_BALANCE_CTM_8 M67_MMC
CONNECT MMC67_UNBALANCE_CTM_8 M67_MMC

M67_MMC_ANT.7.2.1A_CTM_ME8{ @ Maximum Ratio of Metal_8 (M8 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO ME8 MMC67_BALANCE_CTM_8 > 6000
     [PERIMETER(ME8)*MET_TOP_THICK/AREA(MMC67_BALANCE_CTM_8)]
     RDB MMC67_CTM_ME8_balance.rdb BY LAYER ME8 MMC67_BALANCE_CTM_8
}

M67_MMC_ANT.7.2.1C_CTM_ME8{ @ Maximum Ratio of Metal_8 (M8 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CBM is connected to DIFFUSION and CTM is floating
                            @ Antenna CTM node, MMC between ME6 and ME7
     NET AREA RATIO ME8 MMC67_UNBALANCE_CTM_8 > 100
     [PERIMETER(ME8)*MET_TOP_THICK/AREA(MMC67_UNBALANCE_CTM_8)]
     RDB MMC67_CTM_ME8_unbalance.rdb BY LAYER ME8 MMC67_UNBALANCE_CTM_8
}

MMC67_BALANCE_CBM_8 = (MMC67_FLOAT_CBM_8 INTERACT MMC67_FLOAT_CTM_8) OR (MMC67_GROUND_CBM_8 INTERACT MMC67_GROUND_CTM_8)
MMC67_UNBALANCE_CBM_8 = MMC67_FLOAT_CBM_8 INTERACT MMC67_GROUND_CTM_8
CONNECT MMC67_BALANCE_CBM_8 ME6
CONNECT MMC67_UNBALANCE_CBM_8 ME6

MMC67_BALANCE_ME8_8 = NET AREA RATIO ME8 MMC67_BALANCE_CBM_8 > 0
MMC67_UNBALANCE_ME8_8 = NET AREA RATIO ME8 MMC67_UNBALANCE_CBM_8 > 0

M67_MMC_ANT.7.2.1A_CBM_ME8{ @ Maximum Ratio of Metal_8 (M8 or UTM) sidewall area to the METAL_CAP area is 6000
                            @ for balance structure when both CTM and CBM are floating or grounded
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_BALANCE_ME8_8 f_M67_MMC > 6000
     [PERIMETER(MMC67_BALANCE_ME8_8)*MET_TOP_THICK/AREA(f_M67_MMC)]
     RDB MMC67_CBM_ME8_balance.rdb BY LAYER MMC67_BALANCE_ME8_8 f_M67_MMC
}

M67_MMC_ANT.7.2.1B_CBM_ME8{ @ Maximum Ratio of Metal_8 (M8 or UTM) sidewall area to the METAL_CAP area is 100
                            @ for unbalanced structure where CTM is connected to DIFFUSION and CBM is floating
                            @ Antenna CBM node, MMC between ME6 and ME7
     f_M67_MMC = STAMP M67_MMC BY ME6   
     NET AREA RATIO MMC67_UNBALANCE_ME8_8 f_M67_MMC > 100
     [PERIMETER(MMC67_UNBALANCE_ME8_8)*MET_TOP_THICK/AREA(f_M67_MMC)]
     RDB MMC67_CBM_ME8_unbalance.rdb BY LAYER MMC67_UNBALANCE_ME8_8 f_M67_MMC
}
    
//the end of deck
