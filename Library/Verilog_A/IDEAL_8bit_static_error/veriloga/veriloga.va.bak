// VerilogA for Verilog_A, IDEAL_8bit_static_error, veriloga

`include "constants.vams"
`include "disciplines.vams"

module IDEAL_8bit_static_error(CLKIN,DACIN,D0,D1,D2,D3,D4,D5,D6,D7,CODE_OUT,DNL,INL);
	electrical CLKIN,DACIN,D0,D1,D2,D3,D4,D5,D6,D7,CODE_OUT,DNL,INL;
	input CLKIN,DACIN,D0,D1,D2,D3,D4,D5,D6,D7;
	output CODE_OUT,DNL,INL;

	parameter real BIT=8;
	parameter real VREF=2;
	
	real VLSB=BIT/VREF;

	parameter real VTH=0.5;

	real DD0,DD1,DD2,DD3,DD4,DD5,DD6,DD7,DSUM;
	real sample_n,sample_n1=0;
	real INL_int,DNL_int;		//internal variable
	
	
	analog begin
		DD0 = (V(D0)>VTH) ? 1 : 0;
		DD1 = (V(D1)>VTH) ? 1 : 0;
		DD2 = (V(D2)>VTH) ? 1 : 0;
		DD3 = (V(D3)>VTH) ? 1 : 0;
		DD4 = (V(D4)>VTH) ? 1 : 0;
		DD5 = (V(D5)>VTH) ? 1 : 0;
		DD6 = (V(D6)>VTH) ? 1 : 0;
		DD7 = (V(D7)>VTH) ? 1 : 0;
		DSUM=DD0*1 + DD1*2 + DD2*4 + DD3*8 +DD4*16 + DD5*32 + DD6*64 + DD7*128;

		@(cross(V(CLKIN)-VTH,1))begin
			sample_n1=sample_n;
			sample_n=V(DACIN);
			DNL_int=(sample_n-sample_n1)/VLSB-1;
			
		end



		V(DNL)<+DNL_int;


	end

endmodule
